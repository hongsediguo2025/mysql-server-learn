--disable_query_log
--disable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_receiver_enable;
SELECT @@GLOBAL.preserve_trx_transfer_allowed_source_uuid;
SELECT @@GLOBAL.preserve_trx_transfer_target_server_uuid;
SELECT @@GLOBAL.preserve_trx_transfer_target_host;
SELECT @@GLOBAL.preserve_trx_transfer_target_port;
SELECT @@GLOBAL.preserve_trx_transfer_target_socket;
SELECT @@GLOBAL.preserve_trx_transfer_target_user;
SELECT @@GLOBAL.preserve_trx_transfer_credential_name;
SELECT @@GLOBAL.preserve_trx_transfer_artifact_mode;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_workers;
SELECT @@GLOBAL.preserve_trx_transfer_chunk_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_max_inflight_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_commit_timeout_ms;
--error ER_WRONG_ARGUMENTS
SET @@GLOBAL.preserve_trx_transfer_receiver_enable=ON;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_allowed_source_uuid='source-uuid';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_server_uuid='target-uuid';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_host='127.0.0.1';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_port=3307;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_socket='/tmp/mysql.sock';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_user='transfer_user';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_credential_name='transfer_credential';
--error ER_WRONG_ARGUMENTS
SET @@GLOBAL.preserve_trx_transfer_artifact_mode=STANDBY_TRANSFER_SAVE;
SET @@GLOBAL.preserve_trx_transfer_receiver_enable=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_artifact_mode=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_receiver_workers=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_chunk_bytes=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_max_inflight_bytes=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_commit_timeout_ms=DEFAULT;
--enable_result_log
--enable_query_log
--echo ok

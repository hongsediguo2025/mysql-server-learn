--disable_query_log
--disable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_receiver_enable;
SELECT @@GLOBAL.preserve_trx_transfer_allowed_source_uuid;
SELECT @@GLOBAL.preserve_trx_transfer_target_server_uuid;
SELECT @@GLOBAL.preserve_trx_transfer_target_host;
SELECT @@GLOBAL.preserve_trx_transfer_target_port;
SELECT @@GLOBAL.preserve_trx_transfer_target_socket;
SELECT @@GLOBAL.preserve_trx_transfer_target_user;
SELECT @@GLOBAL.preserve_trx_transfer_credential_name;
SELECT @@GLOBAL.preserve_trx_transfer_artifact_mode;
--enable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_receiver_workers;
--disable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_chunk_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_max_inflight_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_commit_timeout_ms;
--enable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_phase1_batch_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_phase1_batch_linger_ms;
SELECT COUNT(*) AS phase1_batch_status_count
FROM performance_schema.global_status
WHERE VARIABLE_NAME IN (
  'Preserve_trx_transfer_phase1_frame_count',
  'Preserve_trx_transfer_phase1_network_send_count',
  'Preserve_trx_transfer_phase1_batch_count',
  'Preserve_trx_transfer_phase1_batch_bytes_p50',
  'Preserve_trx_transfer_phase1_batch_bytes_p95',
  'Preserve_trx_transfer_phase1_batch_bytes_max',
  'Preserve_trx_transfer_phase1_batch_tokens_p50',
  'Preserve_trx_transfer_phase1_batch_tokens_p95',
  'Preserve_trx_transfer_phase1_batch_tokens_max',
  'Preserve_trx_transfer_phase1_record_batch_tokens_avg',
  'Preserve_trx_transfer_phase1_batch_linger_us_p95',
  'Preserve_trx_transfer_phase1_batch_linger_us_max',
  'Preserve_trx_transfer_phase1_oversize_token_count',
  'Preserve_trx_transfer_phase1_record_first_batch_send_us',
  'Preserve_trx_transfer_phase1_record_last_batch_send_us'
);
--disable_result_log
--error ER_WRONG_ARGUMENTS
SET @@GLOBAL.preserve_trx_transfer_receiver_enable=ON;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_allowed_source_uuid='source-uuid';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_server_uuid='target-uuid';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_host='127.0.0.1';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_port=3307;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_socket='/tmp/mysql.sock';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_target_user='transfer_user';
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@GLOBAL.preserve_trx_transfer_credential_name='transfer_credential';
--error ER_WRONG_ARGUMENTS
SET @@GLOBAL.preserve_trx_transfer_artifact_mode=STANDBY_TRANSFER_SAVE;
SET @@GLOBAL.preserve_trx_transfer_receiver_enable=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_artifact_mode=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_receiver_workers=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_chunk_bytes=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_chunk_bytes=1048577;
--enable_result_log
SHOW WARNINGS;
SELECT @@GLOBAL.preserve_trx_transfer_chunk_bytes;
--disable_result_log
SET @@GLOBAL.preserve_trx_transfer_max_inflight_bytes=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_commit_timeout_ms=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_phase1_batch_bytes=8388608;
SET @@GLOBAL.preserve_trx_transfer_phase1_batch_linger_ms=50;
--enable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_phase1_batch_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_phase1_batch_linger_ms;
--disable_result_log
SET @@GLOBAL.preserve_trx_transfer_phase1_batch_bytes=67108865;
SET @@GLOBAL.preserve_trx_transfer_phase1_batch_linger_ms=1001;
--enable_result_log
SELECT @@GLOBAL.preserve_trx_transfer_phase1_batch_bytes;
SELECT @@GLOBAL.preserve_trx_transfer_phase1_batch_linger_ms;
--disable_result_log
SET @@GLOBAL.preserve_trx_transfer_phase1_batch_bytes=DEFAULT;
SET @@GLOBAL.preserve_trx_transfer_phase1_batch_linger_ms=DEFAULT;
--enable_result_log
--enable_query_log
--echo ok

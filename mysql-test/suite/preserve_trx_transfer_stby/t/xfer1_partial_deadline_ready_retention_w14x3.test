--source include/have_debug.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X5-12a / W14x3 deadline partial selection keeps the READY subset alive.
# One receiver worker is delayed past the classification cutoff. Two siblings
# must retain their renewed prepared publications while the excluded token
# cancels, retries one injected staging cleanup failure, and retires every
# receiver byte/object. This is not the full four-reason W16 matrix.

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/xfer1-partial-deadline.secret
--write_file $credential_file
xfer1-partial-deadline-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@'127.0.0.1';
DROP USER IF EXISTS xfer1_partial_deadline_app@localhost;
DROP TABLE IF EXISTS xfer1_partial_deadline_audit;
DROP TABLE IF EXISTS xfer1_partial_deadline_accounts;
--enable_warnings
CREATE USER preserve_trx_ha_admin@'127.0.0.1'
  IDENTIFIED BY 'xfer1-partial-deadline-secret';
GRANT SHUTDOWN, PROCESS, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON performance_schema.*
  TO preserve_trx_ha_admin@'127.0.0.1';
CREATE USER xfer1_partial_deadline_app@localhost;
GRANT SELECT, INSERT, UPDATE ON test.*
  TO xfer1_partial_deadline_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_1 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer1_partial_deadline --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;

CREATE TABLE xfer1_partial_deadline_accounts(
  id INT PRIMARY KEY,
  balance INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer1_partial_deadline_audit(
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  owner_no INT NOT NULL,
  debit_id INT NOT NULL,
  credit_id INT NOT NULL,
  amount INT NOT NULL,
  KEY(owner_no)
) ENGINE=InnoDB;
INSERT INTO xfer1_partial_deadline_accounts
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('deadline-account-', n) FROM seq;

--connect(xfer1_deadline_admin,127.0.0.1,preserve_trx_ha_admin,xfer1-partial-deadline-secret,test,$SERVER_MYPORT_1,)
SET @active_epochs_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs');
SET @classified_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @ready_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME=
     'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @not_ready_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME=
     'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @prepared_registered_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens');
SET @prepared_ready_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens');
SET @failed_records_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens');
SET @inflight_bytes_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes');
SET @inflight_tokens_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens');
SET @staged_memory_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME=
     'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @cleanup_retries_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME=
     'Preserve_trx_transfer_receiver_cleanup_retry_completions');
SET GLOBAL debug=
  '+d,preserve_trx_receiver_delay_one_token_past_deadline,preserve_trx_receiver_fail_one_selection_cleanup';

--connect(xfer1_deadline_owner1,localhost,xfer1_partial_deadline_app,,test)
--let $owner1_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AS owner1_snapshot
  FROM xfer1_partial_deadline_accounts WHERE id=29;
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance-11, version=version+1 WHERE id=1;
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance+11, version=version+1 WHERE id=2;
INSERT INTO xfer1_partial_deadline_audit(owner_no,debit_id,credit_id,amount)
VALUES(1,1,2,11);

--connect(xfer1_deadline_owner2,localhost,xfer1_partial_deadline_app,,test)
--let $owner2_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AS owner2_snapshot
  FROM xfer1_partial_deadline_accounts WHERE id=30;
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance-13, version=version+1 WHERE id=3;
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance+13, version=version+1 WHERE id=4;
INSERT INTO xfer1_partial_deadline_audit(owner_no,debit_id,credit_id,amount)
VALUES(2,3,4,13);

--connect(xfer1_deadline_owner3,localhost,xfer1_partial_deadline_app,,test)
--let $owner3_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AS owner3_snapshot
  FROM xfer1_partial_deadline_accounts WHERE id=31;
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance-17, version=version+1 WHERE id=5;
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance+17, version=version+1 WHERE id=6;
INSERT INTO xfer1_partial_deadline_audit(owner_no,debit_id,credit_id,amount)
VALUES(3,5,6,17);

--connect(xfer1_deadline_outsider,localhost,root,,test)
UPDATE xfer1_partial_deadline_accounts
   SET balance=balance+3, version=version+1 WHERE id=32;
SELECT COUNT(*)=32 AS thirty_two_accounts,
       SUM(balance)=32003 AS only_outsider_change_committed,
       SUM(version)=1 AS owner_versions_hidden,
       MAX(CASE WHEN id IN (1,2,3,4,5,6) THEN version END)=0
         AS all_owner_updates_hidden
  FROM xfer1_partial_deadline_accounts;
SELECT COUNT(*)=0 AS all_owner_audit_hidden
  FROM xfer1_partial_deadline_audit;

--connection default
--replace_result $owner1_id OWNER1_ID $owner2_id OWNER2_ID $owner3_id OWNER3_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection xfer1_deadline_admin
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_epochs_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before+3 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@ready_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@not_ready_before+1
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@staged_memory_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_retry_completions')=@cleanup_retries_before+1
--source include/wait_condition.inc
SET GLOBAL debug=
  '-d,preserve_trx_receiver_delay_one_token_past_deadline,preserve_trx_receiver_fail_one_selection_cleanup';

SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         = @active_epochs_before+1 AS one_classified_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
         = @classified_before+3 AS three_classified_tokens,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
         = @ready_before+2 AS two_ready_tokens,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
         = @not_ready_before+1 AS one_deadline_token;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         = @prepared_registered_before+2 AS only_ready_subset_registered,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         = @prepared_ready_before+2 AS ready_subset_survives_old_cutoff,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
         = @failed_records_before+1 AS deadline_token_terminal,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         = @inflight_bytes_before AS staging_bytes_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         = @inflight_tokens_before AS no_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_staged_memory_bytes')
         = @staged_memory_before AS staged_memory_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_cleanup_retry_completions')
         = @cleanup_retries_before+1 AS cleanup_retry_completed;
SELECT VARIABLE_VALUE='receiver_selection_failed:3'
         AS deadline_cleanup_reason_is_exact
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';

--connection xfer1_deadline_owner1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer1_deadline_owner2
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer1_deadline_owner3
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection xfer1_deadline_admin
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer1_deadline_cleanup,localhost,root,,test)
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
SELECT COUNT(*)=32 AS thirty_two_accounts,
       SUM(balance)=32003 AS outsider_change_durable,
       SUM(version)=1 AS every_owner_update_rolled_back,
       MAX(CASE WHEN id=32 THEN balance END)=1003 AS outsider_row_kept
  FROM xfer1_partial_deadline_accounts;
SELECT COUNT(*)=0 AS every_owner_audit_rolled_back
  FROM xfer1_partial_deadline_audit;
DROP TABLE xfer1_partial_deadline_audit;
DROP TABLE xfer1_partial_deadline_accounts;
DROP USER xfer1_partial_deadline_app@localhost;
DROP USER preserve_trx_ha_admin@'127.0.0.1';
--remove_file $credential_file
--enable_query_log

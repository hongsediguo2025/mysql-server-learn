# X1-03 / X1-04 / X1-05 / W01 / O01 / O02 / T1
# The endpoint is configured, but its credential file is successively missing,
# insecure, empty, and oversized. Every failure must occur before TCP connect
# and before receiver frame admission, without replacing the original owner.
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/xfer2-credential-file-missing.secret
--error 1
--file_exists $credential_file

--connect(xfer2_missing_receiver,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_missing_receiver@localhost;
DROP TABLE IF EXISTS xfer2_missing_receiver_native;
--enable_warnings
CREATE USER preserve_trx_missing_receiver@localhost
  IDENTIFIED BY 'credential-that-is-never-read';
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_missing_receiver@localhost;
GRANT SELECT ON performance_schema.*
  TO preserve_trx_missing_receiver@localhost;
CREATE TABLE xfer2_missing_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_missing_receiver_native VALUES(1,20),(2,30);

SET @receiver_admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames');
SET @receiver_active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs');
SET @receiver_inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens');
SET @receiver_inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes');
SET @receiver_staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @receiver_terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @receiver_prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens');
--let $receiver_connection= xfer2_missing_receiver
--source suite/preserve_trx_transfer_stby/include/capture_receiver_admission_extras.inc

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_missing_source_ha@localhost;
DROP USER IF EXISTS xfer2_missing_app@localhost;
DROP TABLE IF EXISTS xfer2_missing_audit;
DROP TABLE IF EXISTS xfer2_missing_accounts;
--enable_warnings
CREATE USER preserve_trx_missing_source_ha@localhost
  IDENTIFIED BY 'xfer2-missing-source-ha-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN, PROCESS,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_missing_source_ha@localhost;
GRANT SELECT ON performance_schema.*
  TO preserve_trx_missing_source_ha@localhost;
CREATE USER xfer2_missing_app@localhost;
GRANT SELECT, INSERT, UPDATE, DELETE ON test.*
  TO xfer2_missing_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_missing_receiver --rds-preserve-trx-transfer-credential-name=xfer2_credential_file_missing --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=

CREATE TABLE xfer2_missing_accounts(
  id INT PRIMARY KEY,
  balance INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_missing_audit(
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  account_id INT NOT NULL,
  delta INT NOT NULL,
  KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_missing_accounts
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n,1000,0,CONCAT('missing-',n) FROM seq;

--connect(xfer2_missing_source_ha,localhost,preserve_trx_missing_source_ha,xfer2-missing-source-ha-secret,test)
--connect(xfer2_missing_owner,localhost,xfer2_missing_app,,test)
--let $owner_connection_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1000 AND version=0 AS owner_rr_initial
  FROM xfer2_missing_accounts WHERE id=32;
--disable_query_log

--connect(xfer2_missing_outsider,localhost,root,,test)
UPDATE xfer2_missing_accounts
   SET balance=balance+9,version=version+1 WHERE id=32;

--connection xfer2_missing_owner
--enable_query_log
SELECT balance=1000 AND version=0 AS owner_rr_repeatable
  FROM xfer2_missing_accounts WHERE id=32;
--disable_query_log
UPDATE xfer2_missing_accounts
   SET balance=balance-5,version=version+1 WHERE id=2;
UPDATE xfer2_missing_accounts
   SET balance=balance+2,version=version+1 WHERE id=5;
UPDATE xfer2_missing_accounts
   SET balance=balance+3,version=version+1 WHERE id=9;
INSERT INTO xfer2_missing_audit(account_id,delta) VALUES(2,-5),(5,2),(9,3);

--connection xfer2_missing_outsider
--enable_query_log
SELECT COUNT(*)=32 AS outsider_row_count,
       SUM(balance)=32009 AS outsider_sees_background_only,
       SUM(version)=1 AS outsider_hides_owner_versions,
       SUM(id IN (2,5,9) AND version<>0)=0 AS owner_rows_not_dirty
  FROM xfer2_missing_accounts;
SELECT COUNT(*)=0 AS owner_audit_not_dirty FROM xfer2_missing_audit;
--disable_query_log

--connect(xfer2_missing_waiter,localhost,root,,test)
SET SESSION innodb_lock_wait_timeout=3600;
--let $waiter_connection_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
--send UPDATE xfer2_missing_accounts SET balance=balance+10,version=version+1 WHERE id=2

--connection default
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
--replace_result $waiter_connection_id WAITER_ID
--enable_query_log
--eval SELECT COUNT(*)=1 AS waiter_blocked_before_credential_matrix FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--disable_query_log

--connection default
--enable_query_log
--echo credential_variant=missing
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--replace_result $waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_missing_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--disable_query_log
--connection xfer2_missing_owner
--enable_query_log
SELECT SUM(id=2 AND balance=995 AND version=1)=1
         AND SUM(id=5 AND balance=1002 AND version=1)=1
         AND SUM(id=9 AND balance=1003 AND version=1)=1
         AND MAX(CASE WHEN id=32 THEN balance END)=1000
         AS owner_state_after_missing_credential
  FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
--disable_query_log

# A group/world-readable regular file must be rejected before its contents are
# used. Fail hard if the fixture mode is not the intended 0644.
--write_file $credential_file
xfer2-insecure-credential-secret
EOF
--exec chmod 644 $credential_file
--let _INPUT_FILE_ = $credential_file
--source include/get_file_permissions.inc
--source $MYSQL_TMP_DIR/permissions.inc
--remove_file $MYSQL_TMP_DIR/permissions.inc
if ($FILE_PERMISSIONS != 644)
{
  --die insecure credential fixture is not mode 0644
}
--let _INPUT_FILE_ =
--connection default
--enable_query_log
--echo credential_variant=insecure_mode
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--replace_result $waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_insecure_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--disable_query_log
--connection xfer2_missing_owner
--enable_query_log
SELECT SUM(id=2 AND balance=995 AND version=1)=1
         AND SUM(id=5 AND balance=1002 AND version=1)=1
         AND SUM(id=9 AND balance=1003 AND version=1)=1
         AND MAX(CASE WHEN id=32 THEN balance END)=1000
         AS owner_state_after_insecure_credential
  FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
--disable_query_log

# An empty but otherwise secure regular file must fail the size/content gate.
--let CREDENTIAL_FILE_PATH = $credential_file
--perl
use strict;
my $path = $ENV{'CREDENTIAL_FILE_PATH'};
open(my $out, '>:raw', $path) or die "cannot truncate $path: $!";
close($out) or die "cannot close $path: $!";
chmod(0600, $path) or die "cannot chmod $path: $!";
die "credential fixture is not empty" unless -z $path;
EOF
--connection default
--enable_query_log
--echo credential_variant=empty
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--replace_result $waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_empty_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--disable_query_log
--connection xfer2_missing_owner
--enable_query_log
SELECT SUM(id=2 AND balance=995 AND version=1)=1
         AND SUM(id=5 AND balance=1002 AND version=1)=1
         AND SUM(id=9 AND balance=1003 AND version=1)=1
         AND MAX(CASE WHEN id=32 THEN balance END)=1000
         AS owner_state_after_empty_credential
  FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
--disable_query_log

# The reader's hard maximum is 4096 bytes. A 4097-byte secure file must be
# rejected without allocating or publishing receiver transfer state.
--perl
use strict;
my $path = $ENV{'CREDENTIAL_FILE_PATH'};
open(my $out, '>:raw', $path) or die "cannot write $path: $!";
print {$out} "xfer2-oversized-credential-secret\n", ('x' x 4063)
  or die "cannot fill $path: $!";
close($out) or die "cannot close $path: $!";
chmod(0600, $path) or die "cannot chmod $path: $!";
die "credential fixture is not 4097 bytes" unless -s $path == 4097;
EOF
--let CREDENTIAL_FILE_PATH =
--connection default
--enable_query_log
--echo credential_variant=oversized
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--replace_result $waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_oversized_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--disable_query_log
--connection xfer2_missing_owner
--enable_query_log
SELECT SUM(id=2 AND balance=995 AND version=1)=1
         AND SUM(id=5 AND balance=1002 AND version=1)=1
         AND SUM(id=9 AND balance=1003 AND version=1)=1
         AND MAX(CASE WHEN id=32 THEN balance END)=1000
         AS owner_state_after_oversized_credential
  FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
--disable_query_log
--remove_file $credential_file
--error 1
--file_exists $credential_file

--connection xfer2_missing_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         =@receiver_admitted_before AS no_frame_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@receiver_active_before AS no_receiver_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@receiver_inflight_tokens_before AS no_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         =@receiver_inflight_bytes_before AS no_inflight_byte,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@receiver_staged_before AS no_staged_memory;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@receiver_terminal_before AS no_terminal_fact,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@receiver_prepared_before AS no_prepared_entry;
--let $receiver_connection= xfer2_missing_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_admission_extras_unchanged.inc
--source suite/preserve_trx_transfer_stby/include/assert_receiver_quiescent.inc
START TRANSACTION;
UPDATE xfer2_missing_receiver_native SET v=v+id;
COMMIT;
SELECT SUM(v)=53 AS receiver_native_dml_works
  FROM xfer2_missing_receiver_native;
--disable_query_log

--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection xfer2_missing_owner
--enable_query_log
--replace_result $owner_connection_id OWNER_ID
SELECT CONNECTION_ID() AS same_owner_connection_after_missing_secret;
SELECT balance=1000 AND version=0 AS owner_rr_survives_missing_secret
  FROM xfer2_missing_accounts WHERE id=32;
SELECT SUM(id=2 AND balance=995 AND version=1)=1
         AND SUM(id=5 AND balance=1002 AND version=1)=1
         AND SUM(id=9 AND balance=1003 AND version=1)=1
         AS owner_updates_survive_drain_failure
  FROM xfer2_missing_accounts WHERE id IN (2,5,9);
SELECT COUNT(*)=3 AND SUM(delta)=0
         AS owner_audit_survives_drain_failure
  FROM xfer2_missing_audit;
--disable_query_log

--connection xfer2_missing_outsider
--enable_query_log
SELECT SUM(id IN (2,5,9) AND version<>0)=0
         AS owner_changes_still_isolated_after_drain_failure
  FROM xfer2_missing_accounts;
SELECT COUNT(*)=0 AS owner_audit_still_isolated_after_drain_failure
  FROM xfer2_missing_audit;
--disable_query_log

--connection xfer2_missing_owner
--enable_query_log
UPDATE xfer2_missing_accounts SET pad=CONCAT(pad,'-continued') WHERE id=9;
SELECT ROW_COUNT()=1 AS owner_can_continue_dml;
ROLLBACK;
--disable_query_log

--connection xfer2_missing_waiter
--reap

--connection xfer2_missing_outsider
--enable_query_log
SELECT COUNT(*)=32 AS final_row_count,
       SUM(balance)=32019 AS outsider_and_waiter_balance_once,
       SUM(version)=2 AS outsider_and_waiter_versions_once,
       SUM(id IN (2,32) AND version>0)=2 AS exact_changed_rows,
       SUM(id IN (5,9) AND version<>0)=0 AS owner_updates_rolled_back,
       MAX(CASE WHEN id=2 THEN balance END)=1010
         AND MAX(CASE WHEN id=2 THEN version END)=1
         AS waiter_update_persisted_once,
       MAX(CASE WHEN id=9 THEN pad END)='missing-9'
         AS continued_owner_dml_rolled_back
  FROM xfer2_missing_accounts;
SELECT COUNT(*)=0 AS owner_audit_rolled_back FROM xfer2_missing_audit;
CHECK TABLE xfer2_missing_accounts,xfer2_missing_audit;
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

# All four local file validation failures must occur before mysql_real_connect.
--let $assert_text= invalid credential files stayed on the pre-TCP path
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: standby transfer client connect failed
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= every invalid credential used the frame-sink failure stage
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: drain participant observation stage=standby_transfer_frame_sink_failed index=0
--let $assert_count_condition= == 4
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= insecure credential content is absent from source error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= xfer2-insecure-credential-secret
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= oversized credential content is absent from source error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= xfer2-oversized-credential-secret
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_count_condition=

--connection xfer2_missing_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer2_missing_cleanup,localhost,root,,test)
--enable_query_log
SELECT SUM(balance)=32019 AND SUM(version)=2
         AS source_restart_keeps_outsider_and_waiter
  FROM xfer2_missing_accounts;
SELECT COUNT(*)=0 AS source_restart_keeps_owner_rollback
  FROM xfer2_missing_audit;
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
DROP TABLE xfer2_missing_audit;
DROP TABLE xfer2_missing_accounts;
DROP USER xfer2_missing_app@localhost;
DROP USER preserve_trx_missing_source_ha@localhost;

--connection xfer2_missing_receiver
DROP TABLE xfer2_missing_receiver_native;
DROP USER preserve_trx_missing_receiver@localhost;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--exec echo "restart:" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc

--connection xfer2_missing_cleanup
--disconnect xfer2_missing_waiter
--disconnect xfer2_missing_outsider
--disconnect xfer2_missing_owner
--disconnect xfer2_missing_source_ha
--enable_query_log

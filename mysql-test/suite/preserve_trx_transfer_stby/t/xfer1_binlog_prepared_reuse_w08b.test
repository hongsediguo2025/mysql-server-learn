--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X5-09 / W08B / O01 / T1 / I07 / I08 / I10 / I14 / I15.
#
# Preserve a logged RR transaction whose 512 KiB LONGBLOB update spills the
# binlog cache out of the small in-memory path.  T1 is deliberately self-loop:
# source and receiver share the physical InnoDB identity, so READY cannot be
# rejected first by an unrelated cross-datadir record-lock proof.
#
# Pause after the Phase1 external objects have crossed the wire, wait until the
# authenticated binlog seed has built a native prepared handle, and only then
# make every later native binlog open fail.  Final READY is therefore possible
# only if final binding consumes the already prepared matching handle exactly
# once; a cold rebuild reaches the injected failure and makes the test RED.

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/xfer1-x509.secret
--write_file $credential_file
xfer1-x509-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@'127.0.0.1';
DROP USER IF EXISTS xfer1_x509_app@localhost;
DROP TABLE IF EXISTS xfer1_x509_audit;
DROP TABLE IF EXISTS xfer1_x509_blob;
DROP TABLE IF EXISTS xfer1_x509_accounts;
--enable_warnings
CREATE USER preserve_trx_ha_admin@'127.0.0.1'
  IDENTIFIED BY 'xfer1-x509-secret';
GRANT SHUTDOWN, PROCESS, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON performance_schema.*
  TO preserve_trx_ha_admin@'127.0.0.1';
CREATE USER xfer1_x509_app@localhost;
GRANT SELECT, INSERT, UPDATE ON test.* TO xfer1_x509_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_1 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer1_x509 --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=120000;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=120000;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;

CREATE TABLE xfer1_x509_accounts(
  id INT PRIMARY KEY,
  balance INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer1_x509_audit(
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  account_id INT NOT NULL,
  delta INT NOT NULL,
  KEY(account_id)
) ENGINE=InnoDB;
CREATE TABLE xfer1_x509_blob(
  id INT PRIMARY KEY,
  payload LONGBLOB NOT NULL,
  version INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer1_x509_accounts
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('x509-account-', n) FROM seq;
INSERT INTO xfer1_x509_blob VALUES(1,REPEAT('a',512*1024),0);
UPDATE xfer1_x509_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;

--enable_query_log
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
         AS deterministic_committed_background
  FROM xfer1_x509_accounts;
SELECT OCTET_LENGTH(payload)=512*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',512*1024),256)
         AND version=0 AS initial_blob_exact
  FROM xfer1_x509_blob WHERE id=1;
--disable_query_log

--connect(xfer1_x509_admin,127.0.0.1,preserve_trx_ha_admin,xfer1-x509-secret,test,$SERVER_MYPORT_1,)
SET @x509_online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @x509_active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @x509_terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @x509_classified_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @x509_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @x509_not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @x509_bind_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_epoch_ready_bind_attempts');
SET @x509_prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @x509_prepared_pending_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @x509_prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @x509_ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @x509_memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');
SET @x509_object_prewarm_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_object_prewarm_count');
SET @x509_binlog_prewarm_end_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_recv_binlog_obj_prewarm_last_end_us');
SET @x509_native_open_failed_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_resource_admission_open_failed_count');

--connect(xfer1_x509_owner,localhost,xfer1_x509_app,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1001 AND version=1 AS owner_rr_background_visible
  FROM xfer1_x509_accounts WHERE id=32;
--disable_query_log
UPDATE xfer1_x509_accounts
   SET balance=balance-31,version=version+1 WHERE id=3;
UPDATE xfer1_x509_accounts
   SET balance=balance+31,version=version+1 WHERE id=7;
INSERT INTO xfer1_x509_audit(account_id,delta) VALUES(3,-31),(7,31);
UPDATE xfer1_x509_blob
   SET payload=REPEAT('b',512*1024),version=version+1 WHERE id=1;
--enable_query_log
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS owner_balance_conserved
  FROM xfer1_x509_accounts WHERE id IN (3,7);
SELECT COUNT(*)=2 AND SUM(delta)=0 AS owner_audit_balanced
  FROM xfer1_x509_audit WHERE account_id IN (3,7);
SELECT OCTET_LENGTH(payload)=512*1024
         AND SHA2(payload,256)=SHA2(REPEAT('b',512*1024),256)
         AND version=1 AS owner_binlog_payload_exact
  FROM xfer1_x509_blob WHERE id=1;
--disable_query_log

# O01: the logged owner changes remain private before DRAIN.
--connect(xfer1_x509_outsider,localhost,root,,test)
--enable_query_log
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
         AS outsider_sees_only_background
  FROM xfer1_x509_accounts;
SELECT COUNT(*)=0 AS outsider_hides_owner_audit FROM xfer1_x509_audit;
SELECT OCTET_LENGTH(payload)=512*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',512*1024),256)
         AND version=0 AS outsider_sees_original_blob
  FROM xfer1_x509_blob WHERE id=1;
--disable_query_log

--connect(xfer1_x509_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_batch_after_targets_quiesced_before_attach SIGNAL xfer1_x509_seed_sent WAIT_FOR xfer1_x509_final_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer1_x509_admin
SET DEBUG_SYNC='now WAIT_FOR xfer1_x509_seed_sent TIMEOUT 120';

# Phase1 is blocked before final metadata.  The receiver-side object worker must
# already have finished the authenticated seed and retained its native handle.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@x509_online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_recv_binlog_obj_prewarm_last_end_us')>@x509_binlog_prewarm_end_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_object_prewarm_count')>@x509_object_prewarm_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')>@x509_memory_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_recv_binlog_obj_prewarm_last_end_us')
       >@x509_binlog_prewarm_end_before AS binlog_seed_built_before_final,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
       >@x509_memory_before AS seed_retains_native_resources,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
         AS seed_worker_drained;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
       =@x509_active_before AS no_terminal_epoch_before_final,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@x509_classified_before AS no_classification_before_final,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
       =@x509_prepared_before AS no_final_prepared_entry_before_bind;
--disable_query_log

# Every later native binlog-handle open now fails.  READY below can only come
# from consuming the exact handle built above; a final cold rebuild is fatal.
SET GLOBAL debug='+d,preserve_trx_fail_native_binlog_prepare_open';
SET DEBUG_SYNC='now SIGNAL xfer1_x509_final_continue';

--connection xfer1_x509_drain
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--enable_query_log
--reap
--disable_query_log

--connection xfer1_x509_admin
SET DEBUG_SYNC='RESET';
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@x509_active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@x509_terminal_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@x509_classified_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@x509_ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@x509_not_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_epoch_ready_bind_attempts')=@x509_bind_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@x509_prepared_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens')=@x509_prepared_pending_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=@x509_prepared_ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
SET GLOBAL debug='-d,preserve_trx_fail_native_binlog_prepare_open';

--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
       =@x509_ready_before+1 AS prepared_binlog_handle_reused,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
       =@x509_not_ready_before AS cold_rebuild_failure_not_reached,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_epoch_ready_bind_attempts')
       =@x509_bind_before+1 AS final_fact_bound_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_resource_admission_open_failed_count')
       =@x509_native_open_failed_before AS no_native_open_after_seed;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
       =@x509_prepared_before+1 AS one_prepared_entry,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens')
       =@x509_prepared_pending_before AS no_pending_prepared_entry,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
       =@x509_prepared_ready_before+1 AS prepared_entry_ready,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
       >@x509_ready_cache_before AS ready_cache_retained;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
         AS no_active_worker,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
         AS no_queued_bytes;
--disable_query_log

--connection xfer1_x509_owner
--enable_query_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--disable_query_log

--connection xfer1_x509_admin
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer1_x509_cleanup,localhost,root,,test)
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
--enable_query_log
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
         AS only_committed_background_survives
  FROM xfer1_x509_accounts;
SELECT MAX(CASE WHEN id=3 THEN balance END)=1000 AS debit_rolled_back,
       MAX(CASE WHEN id=7 THEN balance END)=1000 AS credit_rolled_back,
       MAX(CASE WHEN id=32 THEN balance END)=1001 AS background_kept
  FROM xfer1_x509_accounts;
SELECT COUNT(*)=0 AS owner_audit_rolled_back FROM xfer1_x509_audit;
SELECT OCTET_LENGTH(payload)=512*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',512*1024),256)
         AND version=0 AS owner_blob_rolled_back
  FROM xfer1_x509_blob WHERE id=1;
DROP TABLE xfer1_x509_audit;
DROP TABLE xfer1_x509_blob;
DROP TABLE xfer1_x509_accounts;
DROP USER xfer1_x509_app@localhost;
DROP USER preserve_trx_ha_admin@'127.0.0.1';
--remove_file $credential_file
--enable_query_log

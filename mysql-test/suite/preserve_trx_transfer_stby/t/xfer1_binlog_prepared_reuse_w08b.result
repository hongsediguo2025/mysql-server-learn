SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
AS only_committed_background_survives
FROM xfer1_x509_accounts;
only_committed_background_survives
1
SELECT MAX(CASE WHEN id=3 THEN balance END)=1000 AS debit_rolled_back,
MAX(CASE WHEN id=7 THEN balance END)=1000 AS credit_rolled_back,
MAX(CASE WHEN id=32 THEN balance END)=1001 AS background_kept
FROM xfer1_x509_accounts;
debit_rolled_back	credit_rolled_back	background_kept
1	1	1
SELECT COUNT(*)=0 AS owner_audit_rolled_back FROM xfer1_x509_audit;
owner_audit_rolled_back
1
SELECT OCTET_LENGTH(payload)=512*1024
AND SHA2(payload,256)=SHA2(REPEAT('a',512*1024),256)
AND version=0 AS owner_blob_rolled_back
FROM xfer1_x509_blob WHERE id=1;
owner_blob_rolled_back

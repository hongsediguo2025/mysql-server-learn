CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
CALL mtr.add_suppression(".*Got an error reading communication packets.*");
SELECT @@GLOBAL.log_bin=1 AND @@GLOBAL.gtid_mode='ON'
         AS w08b_log_bin_and_gtid_on;
w08b_log_bin_and_gtid_on
1
CREATE TABLE xfer2_phase1_blob(
id INT PRIMARY KEY,
payload LONGBLOB NOT NULL,
version INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_phase1_blob
VALUES(1,REPEAT('a',6*1024*1024),0);
SELECT OCTET_LENGTH(payload)=6*1024*1024 AS w08b_seed_length,
SHA2(payload,256)=SHA2(REPEAT('a',6*1024*1024),256)
AS w08b_seed_digest
FROM xfer2_phase1_blob WHERE id=1;
w08b_seed_length	w08b_seed_digest
1	1
DROP TABLE IF EXISTS xfer2_phase1_receiver_native;
CREATE TABLE xfer2_phase1_receiver_native(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_phase1_receiver_native VALUES(1,100),(2,200);

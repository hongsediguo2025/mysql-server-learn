--source include/have_debug.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X5-12b / W14x2: a selected failed token reaches CLEANUP_TAINTED after
# five real staging-cleanup failures, then recovers online through the bounded
# low-frequency retry path. One READY sibling remains intact throughout.

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/xfer1-cleanup-tainted.secret
--write_file $credential_file
xfer1-cleanup-tainted-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@'127.0.0.1';
DROP USER IF EXISTS xfer1_cleanup_tainted_app@localhost;
DROP TABLE IF EXISTS xfer1_cleanup_tainted_audit;
DROP TABLE IF EXISTS xfer1_cleanup_tainted_accounts;
--enable_warnings
CREATE USER preserve_trx_ha_admin@'127.0.0.1'
  IDENTIFIED BY 'xfer1-cleanup-tainted-secret';
GRANT SHUTDOWN, PROCESS, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON performance_schema.*
  TO preserve_trx_ha_admin@'127.0.0.1';
CREATE USER xfer1_cleanup_tainted_app@localhost;
GRANT SELECT, INSERT, UPDATE ON test.*
  TO xfer1_cleanup_tainted_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_1 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer1_cleanup_tainted --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;

CREATE TABLE xfer1_cleanup_tainted_accounts(
  id INT PRIMARY KEY,
  balance INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer1_cleanup_tainted_audit(
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  owner_no INT NOT NULL,
  debit_id INT NOT NULL,
  credit_id INT NOT NULL,
  amount INT NOT NULL,
  KEY(owner_no)
) ENGINE=InnoDB;
INSERT INTO xfer1_cleanup_tainted_accounts
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('tainted-account-', n) FROM seq;

--connect(xfer1_tainted_admin,127.0.0.1,preserve_trx_ha_admin,xfer1-cleanup-tainted-secret,test,$SERVER_MYPORT_1,)
SET @active_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs');
SET @classified_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @ready_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @not_ready_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @prepared_ready_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens');
SET @tainted_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions');
SET @cleanup_completed_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_retry_completions');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_memory_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes');

--connect(xfer1_tainted_owner1,localhost,xfer1_cleanup_tainted_app,,test)
--let $owner1_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AS owner1_snapshot
  FROM xfer1_cleanup_tainted_accounts WHERE id=29;
UPDATE xfer1_cleanup_tainted_accounts
   SET balance=balance-11, version=version+1 WHERE id=1;
UPDATE xfer1_cleanup_tainted_accounts
   SET balance=balance+11, version=version+1 WHERE id=2;
INSERT INTO xfer1_cleanup_tainted_audit(owner_no,debit_id,credit_id,amount)
VALUES(1,1,2,11);

--connect(xfer1_tainted_owner2,localhost,xfer1_cleanup_tainted_app,,test)
--let $owner2_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AS owner2_snapshot
  FROM xfer1_cleanup_tainted_accounts WHERE id=30;
UPDATE xfer1_cleanup_tainted_accounts
   SET balance=balance-13, version=version+1 WHERE id=3;
UPDATE xfer1_cleanup_tainted_accounts
   SET balance=balance+13, version=version+1 WHERE id=4;
INSERT INTO xfer1_cleanup_tainted_audit(owner_no,debit_id,credit_id,amount)
VALUES(2,3,4,13);

--connect(xfer1_tainted_outsider,localhost,root,,test)
UPDATE xfer1_cleanup_tainted_accounts
   SET balance=balance+5, version=version+1 WHERE id=32;
SELECT COUNT(*)=32 AS thirty_two_accounts,
       SUM(balance)=32005 AS only_outsider_balance_committed,
       SUM(version)=1 AS owner_versions_hidden,
       MAX(CASE WHEN id IN (1,2,3,4) THEN version END)=0
         AS owner_updates_hidden
  FROM xfer1_cleanup_tainted_accounts;
SELECT COUNT(*)=0 AS owner_audit_hidden
  FROM xfer1_cleanup_tainted_audit;

--connection default
--replace_result $owner1_id OWNER1_ID $owner2_id OWNER2_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection xfer1_tainted_admin
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@not_ready_before+1
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')=@tainted_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')>=5
--source include/wait_condition.inc

SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')
         = @tainted_before+1 AS cleanup_reached_tainted_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         = 1 AS one_cleanup_debt,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         > 0 AS cleanup_debt_retains_budget,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_oldest_age_us')
         > 0 AS cleanup_debt_has_age,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')
         >= 5 AS five_cleanup_attempts_recorded;

--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_retry_completions')=@cleanup_completed_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@staged_memory_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc

SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_retry_completions')
         = @cleanup_completed_before+1 AS tainted_cleanup_recovered_online,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         = 0 AS no_cleanup_debt,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         = 0 AS no_cleanup_debt_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         = @prepared_ready_before+1 AS ready_sibling_survives,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         = @active_before+1 AS classified_epoch_remains_owned;

--connection xfer1_tainted_owner1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer1_tainted_owner2
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection xfer1_tainted_admin
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer1_tainted_cleanup,localhost,root,,test)
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
SELECT COUNT(*)=32 AS thirty_two_accounts,
       SUM(balance)=32005 AS outsider_balance_durable,
       SUM(version)=1 AS every_owner_update_rolled_back,
       MAX(CASE WHEN id=32 THEN balance END)=1005 AS outsider_row_kept
  FROM xfer1_cleanup_tainted_accounts;
SELECT COUNT(*)=0 AS every_owner_audit_rolled_back
  FROM xfer1_cleanup_tainted_audit;
DROP TABLE xfer1_cleanup_tainted_audit;
DROP TABLE xfer1_cleanup_tainted_accounts;
DROP USER xfer1_cleanup_tainted_app@localhost;
DROP USER preserve_trx_ha_admin@'127.0.0.1';
--remove_file $credential_file
--enable_query_log

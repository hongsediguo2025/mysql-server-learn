--source include/have_debug.inc
--source include/not_windows.inc
--source include/force_restart.inc

# F1b (transient leg): a staging load IO error must stay retryable and never
# poison the epoch.  Owner1-3 run independent W04 transactions reaching one
# real STANDBY_TRANSFER_SAVE epoch.  A persistent debug fault makes every
# staging load return IO_ERROR.  Each token burns its bounded retry budget
# (no terminal classification, no failure record, no epoch poison while
# transiently failing); once the budget is spent the tokens wait for the
# receiver prewarm deadline and are partitioned as PREWARM_DEADLINE(3).
# GREEN contract: no classification while the transient fault is armed,
# then deadline classification with all three tokens in the failure
# partition and selection published.  On old code the first IO_ERROR
# escalates to epoch global failure and the deadline classification never
# publishes.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;
SET GLOBAL debug='+d,preserve_trx_receiver_fail_staging_load_io_error';
--disable_warnings
DROP TABLE IF EXISTS xfer2_sio_receiver_native;
--enable_warnings
CREATE TABLE xfer2_sio_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_sio_receiver_native VALUES(1,10),(2,20);

SET @slc_online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @slc_active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @slc_terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @slc_tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @slc_classified_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @slc_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @slc_not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @slc_failed_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_failed_tokens');
SET @slc_saved_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_saved_online_tokens');
SET @slc_seal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_seal_prewarm_tokens');
SET @slc_seal_success_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_seal_prewarm_success_tokens');
SET @slc_seal_not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_seal_prewarm_not_ready_tokens');
SET @slc_inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @slc_inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @slc_staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @slc_debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @slc_debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @slc_prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @slc_prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');

# Durable source background state outside all three W04 transactions.
--connection default
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;

--connect(xfer2_sio_owner1,localhost,xfer2_w01_app,,test)
--let $slc_owner1_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE xfer2_w01_accounts
   SET balance=balance-17,version=version+1 WHERE id=1;
UPDATE xfer2_w01_accounts
   SET balance=balance+17,version=version+1 WHERE id=2;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(1,-17),(2,17);
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS owner1_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (1,2);

--connect(xfer2_sio_owner2,localhost,xfer2_w01_app,,test)
--let $slc_owner2_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE xfer2_w01_accounts
   SET balance=balance-23,version=version+1 WHERE id=3;
UPDATE xfer2_w01_accounts
   SET balance=balance+23,version=version+1 WHERE id=4;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(3,-23),(4,23);
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS owner2_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (3,4);

--connect(xfer2_sio_owner3,localhost,xfer2_w01_app,,test)
--let $slc_owner3_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE xfer2_w01_accounts
   SET balance=balance-31,version=version+1 WHERE id=5;
UPDATE xfer2_w01_accounts
   SET balance=balance+31,version=version+1 WHERE id=6;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(5,-31),(6,31);
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS owner3_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (5,6);

--connect(xfer2_sio_drain,localhost,root,,test)
--replace_result $slc_owner1_id OWNER1_ID $slc_owner2_id OWNER2_ID $slc_owner3_id OWNER3_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

# Terminal admission completes while the prewarm queue is paused.  No token
# may be classified before the queue is released.
--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@slc_online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@slc_active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@slc_terminal_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@slc_tombstones_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@slc_classified_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@slc_classified_before AS no_premature_classification;

# Unrelated receiver-native work commits while the epoch is admitted.
START TRANSACTION;
UPDATE xfer2_sio_receiver_native SET v=v+id;
INSERT INTO xfer2_sio_receiver_native VALUES(3,30);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_native_commit_while_queued
  FROM xfer2_sio_receiver_native;

SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
# Every staging load fails with transient IO_ERROR; each token retries within
# its bounded budget (each failed attempt notes a not-ready seal outcome).
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_not_ready_tokens')>=@slc_seal_not_ready_before+6
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

# While the transient fault is armed: no terminal classification, no failure
# record, no cleanup debt, and the epoch is not poisoned (it still
# classifies at the prewarm deadline below).
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@slc_classified_before AS no_classification_while_transient_fault,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
       =@slc_failed_before AS no_failure_recorded_while_transient_fault,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
       =@slc_debt_tokens_before AS no_cleanup_debt_while_transient_fault;

# Keep the fault armed past the receiver prewarm deadline (10s constant):
# all three tokens exhaust their retry budgets and are partitioned as
# PREWARM_DEADLINE(3) when the reaper classifies the epoch at the deadline.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@slc_classified_before+3 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@slc_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@slc_not_ready_before+3
--let $wait_timeout= 60
--source include/wait_condition_or_abort.inc
SET GLOBAL debug='-d,preserve_trx_receiver_fail_staging_load_io_error';
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@slc_classified_before+3 AS exactly_three_classified,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
       =@slc_ready_before AS zero_ready_tokens,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
       =@slc_not_ready_before+3 AS exactly_three_deadline_failed_tokens;
SELECT VARIABLE_VALUE='receiver_selection_failed:3'
         AS prewarm_deadline_reason_is_exact
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
       =@slc_saved_before AS no_token_saved_online,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
       =@slc_prepared_before AS no_token_prepared,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
       =@slc_prepared_ready_before AS no_token_prepared_ready;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
       =@slc_inflight_tokens_before AS failed_token_inflight_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
       =@slc_inflight_bytes_before AS failed_token_bytes_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
       =@slc_staged_before AS failed_token_staging_released;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
       =@slc_debt_tokens_before AS no_cleanup_debt_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
       =@slc_debt_bytes_before AS no_cleanup_debt_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
       AS no_active_worker;
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_native_commit_still_exact
  FROM xfer2_sio_receiver_native;

--connection xfer2_source_ha
SELECT COUNT(*)=3 AS exactly_three_preserved_owners,
       SUM(HAS_READ_VIEW='YES')=3 AS every_owner_keeps_rr_view
  FROM performance_schema.preserved_transactions;

--connection xfer2_sio_owner1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer2_sio_owner2
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer2_sio_owner3
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--disconnect xfer2_sio_owner1
--disconnect xfer2_sio_owner2
--disconnect xfer2_sio_owner3
--disconnect xfer2_sio_drain

# Shared teardown restarts the source and proves that all three private W04
# transactions roll back while the committed source background row survives.
# It then restarts the receiver and proves every process-local transfer object
# from both the failed token and READY subset is gone.
--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

--connection xfer2_receiver
SELECT COUNT(*)=3 AND SUM(v)=63
         AS receiver_native_commit_survives_restart
  FROM xfer2_sio_receiver_native;
DROP TABLE xfer2_sio_receiver_native;

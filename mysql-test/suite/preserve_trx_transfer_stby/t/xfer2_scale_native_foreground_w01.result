SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
=@scale_online_before+1 AS one_open_epoch_while_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
=@scale_admitted_before+2 AS two_declared_tokens_while_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
=@scale_active_before AS no_accepted_epoch_while_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
=@scale_prepared_registered_before AS no_prepared_state_while_paused;
one_open_epoch_while_paused	two_declared_tokens_while_paused	no_accepted_epoch_while_paused	no_prepared_state_while_paused

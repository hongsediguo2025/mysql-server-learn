CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
SELECT balance=1000 AND version=0 AS owner_rr_initial
FROM xfer2_w01_accounts WHERE id=32;
owner_rr_initial
1
SELECT balance=1000 AND version=0 AS owner_rr_stays_old
FROM xfer2_w01_accounts WHERE id=32;
owner_rr_stays_old
1
SELECT COUNT(*)=3 AND SUM(balance)=3000 AND SUM(version)=3
AS owner_w01_three_updates
FROM xfer2_w01_accounts WHERE id IN (3,11,27);
owner_w01_three_updates
1
SELECT COUNT(*)=1 AND SUM(delta)=0 AS owner_w01_one_audit
FROM xfer2_w01_audit;
owner_w01_one_audit
1
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
AS observer_sees_background_only,
SUM(id IN (3,11,27) AND version<>0)=0
AS observer_hides_owner_updates
FROM xfer2_w01_accounts;
observer_sees_background_only	observer_hides_owner_updates
1	1
SELECT COUNT(*)=0 AS observer_hides_owner_audit FROM xfer2_w01_audit;
observer_hides_owner_audit
1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
=@scale_online_before+1 AS one_open_epoch_while_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
=@scale_admitted_before+1 AS one_declared_token_while_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
=@scale_active_before AS no_accepted_epoch_while_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
=@scale_prepared_registered_before AS no_prepared_state_while_paused;
one_open_epoch_while_paused	one_declared_token_while_paused	no_accepted_epoch_while_paused	no_prepared_state_while_paused
1	1	1	1

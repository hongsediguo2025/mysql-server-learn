WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<4096
)
SELECT n,MOD(n,13),CONCAT('bk-',LPAD(n,5,'0')),n,
REPEAT(CHAR(65+MOD(n,26)),1536)
FROM seq;

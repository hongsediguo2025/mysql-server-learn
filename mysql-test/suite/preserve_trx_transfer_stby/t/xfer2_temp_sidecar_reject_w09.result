CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
SELECT COUNT(*)=24 AS owner_permanent_row_count,
SUM(v)=3670 AS owner_permanent_sum,
SUM(state='owner-update')=2 AS owner_two_permanent_updates,
SUM(id=3)=0 AS owner_permanent_delete_once,
SUM(id=40 AND state='owner-insert')=1
AS owner_permanent_insert_once
FROM xfer2_x909_permanent;
owner_permanent_row_count	owner_permanent_sum	owner_two_permanent_updates	owner_permanent_delete_once	owner_permanent_insert_once
1	1	1	1	1

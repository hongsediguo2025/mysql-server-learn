SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
=@x310_active_before AS no_terminal_epoch_before_final_fact,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
=@x310_classified_before AS no_classification_while_worker_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_epoch_ready_bind_attempts')
=@x310_bind_before AS no_bind_attempt_while_worker_paused,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
AS strict_prewarm_is_really_queued;
no_terminal_epoch_before_final_fact	no_classification_while_worker_paused	no_bind_attempt_while_worker_paused	strict_prewarm_is_really_queued

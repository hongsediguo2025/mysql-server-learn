!include ../my.cnf

[mysqld.1]
log-bin=preserve-trx-x409-partial-object-bin
binlog-format=ROW
gtid-mode=ON
enforce-gtid-consistency=ON
max_allowed_packet=67108864
rds-preserve-trx-transfer-runtime-profile=BUSINESS_FIRST

[mysqld.2]
skip-log-bin
max_allowed_packet=67108864
rds-preserve-trx-transfer-runtime-profile=BUSINESS_FIRST
debug=d,preserve_trx_transfer_receiver_after_frame_apply_before_ack,preserve_trx_transfer_receiver_disconnect_nonfinal_object_batch_once,syncpoint_xfer2_nonfinal_apply_before_ack_fault

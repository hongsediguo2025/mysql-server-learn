CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
DROP TABLE IF EXISTS xfer2_x11_indexed;
CREATE TABLE xfer2_x11_indexed(
id INT PRIMARY KEY,
business_key VARCHAR(32) NOT NULL,
bucket INT NOT NULL,
score INT NOT NULL,
pad VARCHAR(512) NOT NULL,
UNIQUE KEY uk_business(business_key),
KEY idx_bucket(bucket,id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x11_indexed
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<192
)
SELECT n, CONCAT('biz-',LPAD(n,4,'0')), MOD(n,8), n*10,
REPEAT(CHAR(65+MOD(n,26)),400)
FROM seq;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X7-05 / W14 / O01 / T1 debug-contract
# Pause after the independent receiver has acknowledged COMMIT_EPOCH but before
# the source final-ACK arbiter runs. RESET is already too late because receiver
# ownership crossed the COMMIT send barrier; the original source THD must stay
# fenced before, during, and after the rejected RESET.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--connection xfer2_receiver
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @terminal_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @terminal_duplicates_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_duplicates');
SET @terminal_conflicts_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_conflicts');
SET @tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @final_spool_ack_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_final_spool_ack_monotonic_us');

--connection xfer2_source_ha
SET @reset_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_wins');
SET @reset_too_late_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_too_late');

--connect(xfer2_post_commit_owner,localhost,xfer2_w01_app,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1000 AND version=0 AS owner_rr_initial
  FROM xfer2_w01_accounts WHERE id=32;
--disable_query_log
UPDATE xfer2_w01_accounts
   SET balance=balance-23,version=version+1 WHERE id=3;
UPDATE xfer2_w01_accounts
   SET balance=balance+13,version=version+1 WHERE id=3;
UPDATE xfer2_w01_accounts
   SET balance=balance+10,version=version+1 WHERE id=3;
INSERT INTO xfer2_w01_audit(account_id,delta) VALUES(3,0);

--connect(xfer2_post_commit_outsider,localhost,root,,test)
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;

--connection xfer2_post_commit_owner
--enable_query_log
SELECT balance=1000 AND version=0 AS owner_rr_stays_old
  FROM xfer2_w01_accounts WHERE id=32;
SELECT balance=1000 AND version=3 AS owner_sees_three_updates
  FROM xfer2_w01_accounts WHERE id=3;
SELECT COUNT(*)=1 AND SUM(delta)=0 AS owner_sees_audit
  FROM xfer2_w01_audit;
--disable_query_log

--connection xfer2_post_commit_outsider
--enable_query_log
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
--disable_query_log

--connect(xfer2_post_commit_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_commit_ack_before_final_ack SIGNAL xfer2_post_commit_acked WAIT_FOR xfer2_post_commit_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_post_commit_acked TIMEOUT 60';

# The ACK cannot exist until receiver COMMIT admission and the terminal CAS are
# complete. These are receiver facts, not source-side timing inferences.
--connection xfer2_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@active_before+1 AS receiver_accepted_one_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         >@admitted_before AS receiver_admitted_commit_flow,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_wins_before+1 AS commit_terminal_cas_won_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         =@tombstones_before+1 AS one_commit_terminal_tombstone;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_cas_duplicates')
         =@terminal_duplicates_before AS no_terminal_duplicate,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_cas_conflicts')
         =@terminal_conflicts_before AS no_terminal_conflict,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_final_spool_ack_monotonic_us')
         >@final_spool_ack_before AS receiver_sent_commit_ack;
SET @admitted_at_commit_ack=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
--disable_query_log

# Source has crossed the COMMIT send ownership barrier, but the final-ACK
# arbiter is still paused. This is HANDOFF_PENDING, not COMMITTED_HANDOFF.
--connection xfer2_source_ha
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_source_handoff_pending_epochs')=1
         AS one_handoff_pending_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_source_commit_unknown_epochs')=0
         AS no_commit_unknown_epoch;
--disable_query_log

--connection xfer2_post_commit_owner
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connect(xfer2_post_commit_reset,localhost,preserve_trx_ha_admin,xfer2-smoke-w01-secret,test)
--enable_query_log
--error ER_PRESERVE_TRX_RESET_TOO_LATE
RESET DRAIN;

--connection xfer2_source_ha
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')
         =@reset_wins_before AS reset_did_not_win,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late')
         =@reset_too_late_before+1 AS reset_was_too_late_once;
--disable_query_log

--connection xfer2_post_commit_owner
--error ER_PRESERVE_TRX_SESSION_DRAINED
UPDATE xfer2_w01_accounts SET balance=balance WHERE id=3;

# The rejected RESET is source-local and must not emit a receiver frame or
# perturb the already committed receiver terminal fact.
--connection xfer2_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         =@admitted_at_commit_ack AS reset_sent_no_receiver_frame,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@active_before+1 AS reset_kept_committed_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_wins_before+1 AS reset_kept_terminal_cas,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         =@tombstones_before+1 AS reset_kept_terminal_tombstone;
--disable_query_log

--connection xfer2_source_ha
SET DEBUG_SYNC='now SIGNAL xfer2_post_commit_release';

--connection xfer2_post_commit_drain
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--reap

--connection xfer2_source_ha
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_source_handoff_pending_epochs')=0
         AS no_handoff_pending_after_final_ack,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_source_commit_unknown_epochs')=0
         AS no_commit_unknown_after_final_ack;
--disable_query_log

--connection xfer2_post_commit_reset
--enable_query_log
--error ER_PRESERVE_TRX_RESET_TOO_LATE
RESET DRAIN;

--connection xfer2_source_ha
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')
         =@reset_wins_before AS no_reset_winner,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late')
         =@reset_too_late_before+2 AS two_too_late_resets;
--disable_query_log

--connection xfer2_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         =@admitted_at_commit_ack AS both_resets_sent_no_receiver_frame,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_wins_before+1 AS final_terminal_cas_stable,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_cas_duplicates')
         =@terminal_duplicates_before AS final_no_terminal_duplicate,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_cas_conflicts')
         =@terminal_conflicts_before AS final_no_terminal_conflict;
--disable_query_log

--connection xfer2_post_commit_owner
--enable_query_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--error ER_PRESERVE_TRX_SESSION_DRAINED
ROLLBACK;
--disable_query_log

--connection xfer2_post_commit_outsider
--enable_query_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--disable_query_log

--disconnect xfer2_post_commit_owner
--disconnect xfer2_post_commit_outsider
--disconnect xfer2_post_commit_drain
--disconnect xfer2_post_commit_reset

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

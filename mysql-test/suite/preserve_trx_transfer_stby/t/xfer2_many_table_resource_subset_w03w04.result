UNION ALL SELECT score,version FROM xfer2_x1204_t4
UNION ALL SELECT score,version FROM xfer2_x1204_t5
UNION ALL SELECT score,version FROM xfer2_x1204_t6
) AS all_rows;
many_table_final_committed_state_exact
1
SELECT SUM(cnt)=48 AND SUM(score_sum)=17330 AND SUM(version_sum)=1
AS many_table_secondary_state_exact
FROM (
SELECT COUNT(*) cnt,SUM(score) score_sum,SUM(version) version_sum
FROM xfer2_x1204_t1 FORCE INDEX(idx_bucket) WHERE bucket=0
UNION ALL SELECT COUNT(*),SUM(score),SUM(version)
FROM xfer2_x1204_t2 FORCE INDEX(idx_bucket) WHERE bucket=0
UNION ALL SELECT COUNT(*),SUM(score),SUM(version)
FROM xfer2_x1204_t3 FORCE INDEX(idx_bucket) WHERE bucket=0
UNION ALL SELECT COUNT(*),SUM(score),SUM(version)
FROM xfer2_x1204_t4 FORCE INDEX(idx_bucket) WHERE bucket=0
UNION ALL SELECT COUNT(*),SUM(score),SUM(version)
FROM xfer2_x1204_t5 FORCE INDEX(idx_bucket) WHERE bucket=0
UNION ALL SELECT COUNT(*),SUM(score),SUM(version)
FROM xfer2_x1204_t6 FORCE INDEX(idx_bucket) WHERE bucket=0
) AS bucket_zero;
many_table_secondary_state_exact
1

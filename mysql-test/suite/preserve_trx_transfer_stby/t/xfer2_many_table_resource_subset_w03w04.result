CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x1204_t1(
id INT PRIMARY KEY,
business_key VARCHAR(40) NOT NULL,
bucket INT NOT NULL,
score INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(512) NOT NULL,
UNIQUE KEY uk_business(business_key),
KEY idx_bucket(bucket,id)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x1204_t2 LIKE xfer2_x1204_t1;
CREATE TABLE xfer2_x1204_t3 LIKE xfer2_x1204_t1;
CREATE TABLE xfer2_x1204_t4 LIKE xfer2_x1204_t1;
CREATE TABLE xfer2_x1204_t5 LIKE xfer2_x1204_t1;
CREATE TABLE xfer2_x1204_t6 LIKE xfer2_x1204_t1;

SET DEBUG_SYNC=
'preserve_trx_transfer_after_open_epoch_ack_before_first_frame SIGNAL xfer2_x701_open WAIT_FOR xfer2_x701_release';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC='now WAIT_FOR xfer2_x701_open TIMEOUT 60';
SELECT COUNT(*)>=1 AS authenticated_open_transport_exists
FROM performance_schema.threads
WHERE PROCESSLIST_USER='preserve_trx_ha_admin'
   AND PROCESSLIST_COMMAND='Sleep';
authenticated_open_transport_exists
1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
=@online_before+1 AS exactly_one_open_epoch,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
=@admitted_before AS no_first_sequence_frame,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
=@admitted_bytes_before AS no_first_sequence_bytes;
exactly_one_open_epoch	no_first_sequence_frame	no_first_sequence_bytes
1	1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
=@active_before AS no_terminal_epoch,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
=@inflight_tokens_before AS no_declared_token,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
=@staged_before AS no_staged_payload;
no_terminal_epoch	no_declared_token	no_staged_payload

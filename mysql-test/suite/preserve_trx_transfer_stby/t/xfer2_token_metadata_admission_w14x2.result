1	1
SHUTDOWN;
SELECT SUM(balance)=32009 AS restart_keeps_committed_balance,
SUM(version)=5 AS restart_keeps_exact_versions,
MAX(CASE WHEN id=3 THEN pad END)='account-3-committed'

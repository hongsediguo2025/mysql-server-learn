UPDATE xfer2_w01_accounts
SET pad=CONCAT(pad,'-rolled-back'), version=version+1 WHERE id=4;
SELECT ROW_COUNT()=1 AS owner2_continues_after_rejection;
owner2_continues_after_rejection
1
ROLLBACK;
SELECT COUNT(*)=32 AS thirty_two_accounts,
SUM(balance)=32009 AS committed_balance_conserved,
SUM(version)=5 AS outsider_plus_owner1_versions,
MAX(CASE WHEN id=3 THEN version END)=4 AS owner1_updates_committed,
MAX(CASE WHEN id=4 THEN version END)=0 AS owner2_updates_rolled_back,
MAX(CASE WHEN id=32 THEN balance END)=1009 AS outsider_row_committed
FROM xfer2_w01_accounts;

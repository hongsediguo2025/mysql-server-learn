CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
SELECT @@GLOBAL.rds_preserve_trx_transfer_max_inflight_bytes>1024
AS source_not_using_receiver_limit;
source_not_using_receiver_limit
1
SELECT @@GLOBAL.rds_preserve_trx_transfer_max_inflight_bytes=2048
AS receiver_byte_accounting_window,
@@GLOBAL.rds_preserve_trx_transfer_prewarm_paused=0
AS receiver_prewarm_not_paused;
receiver_byte_accounting_window	receiver_prewarm_not_paused
1	1

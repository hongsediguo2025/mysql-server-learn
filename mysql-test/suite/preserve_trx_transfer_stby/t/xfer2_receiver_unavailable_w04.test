# X0-06 / W04 / O01 / O02 / O09 / O10 / T1
# The configured receiver is stopped before DRAIN. Connection failure must not
# detach, commit, or roll back the source InnoDB transaction.
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/xfer2-receiver-unavailable.secret
--write_file $credential_file
xfer2-receiver-unavailable-secret
EOF
--exec chmod 600 $credential_file

--connect(xfer2_unavailable_receiver,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_unavail_recv@localhost;
DROP TABLE IF EXISTS xfer2_unavailable_receiver_native;
--enable_warnings
CREATE USER preserve_trx_unavail_recv@localhost
  IDENTIFIED BY 'xfer2-receiver-unavailable-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_unavail_recv@localhost;
GRANT SELECT ON performance_schema.*
  TO preserve_trx_unavail_recv@localhost;
CREATE TABLE xfer2_unavailable_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_unavailable_receiver_native VALUES(1,10),(2,20);

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS xfer2_unavailable_app@localhost;
DROP TABLE IF EXISTS xfer2_unavailable_ledger;
DROP TABLE IF EXISTS xfer2_unavailable_accounts;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'xfer2-unavailable-source-ha-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN, PROCESS,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER xfer2_unavailable_app@localhost;
GRANT SELECT, INSERT, UPDATE, DELETE ON test.*
  TO xfer2_unavailable_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_unavail_recv --rds-preserve-trx-transfer-credential-name=xfer2_receiver_unavailable --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=

CALL mtr.add_suppression(
  "PRESERVE: standby transfer client connect failed errno=2003");
CALL mtr.add_suppression(
  "PRESERVE: standby transfer OPEN_EPOCH failed status=3");

CREATE TABLE xfer2_unavailable_accounts(
  id INT PRIMARY KEY,
  balance INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_unavailable_ledger(
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  transfer_id INT NOT NULL,
  account_id INT NOT NULL,
  delta INT NOT NULL,
  KEY(transfer_id),
  KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_unavailable_accounts
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n,1000,0,CONCAT('unavailable-',n) FROM seq;

--connect(xfer2_unavailable_source_ha,localhost,preserve_trx_ha_admin,xfer2-unavailable-source-ha-secret,test)
--let $reset_wins_before= query_get_value(SELECT VARIABLE_VALUE+0 AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins',value,1)
--let $reset_too_late_before= query_get_value(SELECT VARIABLE_VALUE+0 AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late',value,1)
--connect(xfer2_unavailable_owner,localhost,xfer2_unavailable_app,,test)
--let $owner_connection_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1000 AND version=0 AS owner_rr_initial
  FROM xfer2_unavailable_accounts WHERE id=30;
--disable_query_log

--connect(xfer2_unavailable_outsider,localhost,root,,test)
UPDATE xfer2_unavailable_accounts
   SET balance=balance+5,version=version+1 WHERE id=30;

--connection xfer2_unavailable_owner
--enable_query_log
SELECT balance=1000 AND version=0 AS owner_rr_repeatable
  FROM xfer2_unavailable_accounts WHERE id=30;
--disable_query_log
UPDATE xfer2_unavailable_accounts
   SET balance=balance-40,version=version+1 WHERE id=1;
UPDATE xfer2_unavailable_accounts
   SET balance=balance+40,version=version+1 WHERE id=2;
UPDATE xfer2_unavailable_accounts
   SET pad=CONCAT(pad,'-owner'),version=version+1 WHERE id=6;
INSERT INTO xfer2_unavailable_ledger(transfer_id,account_id,delta)
VALUES(6001,1,-40),(6001,2,40);

--connection xfer2_unavailable_outsider
--enable_query_log
SELECT COUNT(*)=32 AS outsider_row_count,
       SUM(balance)=32005 AS outsider_sees_background_only,
       SUM(version)=1 AS outsider_hides_owner_versions,
       SUM(id IN (1,2,6) AND version<>0)=0 AS owner_rows_not_dirty
  FROM xfer2_unavailable_accounts;
SELECT COUNT(*)=0 AS owner_ledger_not_dirty
  FROM xfer2_unavailable_ledger;
--disable_query_log

--connect(xfer2_unavailable_waiter,localhost,root,,test)
SET SESSION innodb_lock_wait_timeout=60;
--let $waiter_connection_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
--send UPDATE xfer2_unavailable_accounts SET balance=balance+7,version=version+1 WHERE id=1

--connection default
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc

# The outage is established after all source background state exists and before
# the first transfer command is sent.
--connection xfer2_unavailable_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_empty.inc
--source suite/preserve_trx_transfer_stby/include/assert_receiver_never_admitted.inc
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--shutdown_server
--source include/wait_until_disconnected.inc

--connection default
--replace_result $waiter_connection_id WAITER_ID
--enable_query_log
--eval SELECT COUNT(*)=1 AS waiter_blocked_before_drain FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--replace_result $waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_receiver_outage FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$waiter_connection_id
--disable_query_log

# Use RESET as an intentional fail-fast NO_ACTIVE probe while the original
# owner transaction and waiter are still live and the receiver is still down.
# A leaked active attempt would be mutated and increment reset_wins, making the
# following assertion fail; this is not a read-only manager-state query.
--connection xfer2_unavailable_source_ha
--enable_query_log
RESET DRAIN;
--eval SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')=$reset_wins_before AS reset_did_not_win_after_receiver_outage,(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late')=$reset_too_late_before AS reset_not_too_late_after_receiver_outage
--disable_query_log

--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection xfer2_unavailable_owner
--replace_result $owner_connection_id OWNER_ID
--enable_query_log
SELECT CONNECTION_ID() AS same_owner_connection_after_receiver_outage;
SELECT balance=1000 AND version=0 AS owner_rr_survives_receiver_outage
  FROM xfer2_unavailable_accounts WHERE id=30;
SELECT SUM(id=1 AND balance=960 AND version=1)=1
         AND SUM(id=2 AND balance=1040 AND version=1)=1
         AND SUM(id=6 AND version=1 AND pad='unavailable-6-owner')=1
         AS owner_writes_survive_receiver_outage
  FROM xfer2_unavailable_accounts WHERE id IN (1,2,6);
SELECT COUNT(*)=2 AND SUM(delta)=0 AS owner_ledger_survives_receiver_outage
  FROM xfer2_unavailable_ledger WHERE transfer_id=6001;
UPDATE xfer2_unavailable_accounts
   SET pad=CONCAT(pad,'-continued') WHERE id=2;
SELECT ROW_COUNT()=1 AS owner_can_continue_dml;
--disable_query_log

--connection xfer2_unavailable_outsider
--enable_query_log
SELECT SUM(id IN (1,2,6) AND version<>0)=0
         AS owner_changes_still_isolated_after_receiver_outage
  FROM xfer2_unavailable_accounts;
SELECT COUNT(*)=0 AS owner_ledger_still_isolated_after_receiver_outage
  FROM xfer2_unavailable_ledger;
--disable_query_log

--connection xfer2_unavailable_owner
COMMIT;

--connection xfer2_unavailable_waiter
--reap

--connection xfer2_unavailable_outsider
--enable_query_log
SELECT COUNT(*)=32 AS final_row_count,
       SUM(balance)=32012 AS final_balance_once,
       SUM(version)=5 AS final_version_once,
       SUM(id IN (1,2,6,30) AND version>0)=4 AS exact_changed_rows,
       MAX(CASE WHEN id=1 THEN balance END)=967 AS waiter_ran_once,
       MAX(CASE WHEN id=2 THEN pad END)='unavailable-2-continued'
         AS continued_owner_dml_persisted
  FROM xfer2_unavailable_accounts;
SELECT COUNT(*)=2 AND SUM(delta)=0 AS balanced_ledger_once
  FROM xfer2_unavailable_ledger WHERE transfer_id=6001;
CHECK TABLE xfer2_unavailable_accounts,xfer2_unavailable_ledger;
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

# Only after source ownership and data resolution are complete may a new
# receiver generation start. It must be empty, while unrelated native InnoDB
# data survives the outage and restart.
--connection xfer2_unavailable_receiver
--exec echo "restart:" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
--source suite/preserve_trx_transfer_stby/include/assert_receiver_never_admitted.inc
--connect(xfer2_unavailable_credential_check,127.0.0.1,preserve_trx_unavail_recv,xfer2-receiver-unavailable-secret,performance_schema,$SERVER_MYPORT_2,)
--connection xfer2_unavailable_credential_check
--enable_query_log
SELECT 1 AS configured_receiver_credential_works_after_restart;
--disable_query_log
--disconnect xfer2_unavailable_credential_check
--connection xfer2_unavailable_receiver
--enable_query_log
SELECT COUNT(*)=2 AND SUM(v)=30 AS receiver_native_data_survives_restart
  FROM xfer2_unavailable_receiver_native;
START TRANSACTION;
UPDATE xfer2_unavailable_receiver_native SET v=v+1;
INSERT INTO xfer2_unavailable_receiver_native VALUES(3,30);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=62 AS receiver_native_dml_works_after_restart
  FROM xfer2_unavailable_receiver_native;
--disable_query_log

--let $assert_text= stopped receiver caused a transport connect failure
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: standby transfer client connect failed errno=2003
--let $assert_count_condition= == 1
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= outage failed at OPEN before any command send
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: drain participant observation stage=standby_transfer_open_epoch_failed
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= outage did not reach the receiver command path
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: standby transfer client send failed
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= outage credential is absent from source error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= xfer2-receiver-unavailable-secret
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= outage credential is absent from receiver error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select= xfer2-receiver-unavailable-secret
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_count_condition=

--connection xfer2_unavailable_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer2_unavailable_cleanup,localhost,root,,test)
--enable_query_log
SELECT SUM(balance)=32012 AND SUM(version)=5
         AS source_restart_keeps_final_data
  FROM xfer2_unavailable_accounts;
SELECT COUNT(*)=2 AND SUM(delta)=0
         AS source_restart_keeps_balanced_ledger
  FROM xfer2_unavailable_ledger;
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
DROP TABLE xfer2_unavailable_ledger;
DROP TABLE xfer2_unavailable_accounts;
DROP USER xfer2_unavailable_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;

--connection xfer2_unavailable_receiver
DROP TABLE xfer2_unavailable_receiver_native;
DROP USER preserve_trx_unavail_recv@localhost;

--connection xfer2_unavailable_cleanup
--remove_file $credential_file
--disconnect xfer2_unavailable_waiter
--disconnect xfer2_unavailable_outsider
--disconnect xfer2_unavailable_owner
--disconnect xfer2_unavailable_source_ha
--enable_query_log

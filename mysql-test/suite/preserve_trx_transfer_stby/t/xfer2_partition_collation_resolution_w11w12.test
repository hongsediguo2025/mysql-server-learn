--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X9-11 / W11 / W12 / O01 / O09 / O10 / T1 debug-contract /
# I02 / I05 / I06 / I10.
#
# One real two-mysqld transfer carries a transaction that modifies two physical
# partitions plus UTF8MB4/collation, binary-key, NULL-index, and numeric-boundary
# rows.  Pause after every final-token payload is ACKed but before receiver
# COMMIT_EPOCH ownership CAS.  RESET must restore the original source owner,
# retire receiver staging without READY publication, and preserve exact access
# through full scans, partition pruning, secondary indexes, and boundary keys.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--disable_query_log

--connection default
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x911_partitioned;
DROP TABLE IF EXISTS xfer2_x911_boundary;
--enable_warnings
CREATE TABLE xfer2_x911_partitioned(
  tenant_id INT NOT NULL,
  id INT NOT NULL,
  score BIGINT NOT NULL,
  group_name VARCHAR(24) NOT NULL,
  tag VARCHAR(32) NOT NULL,
  PRIMARY KEY(tenant_id,id),
  KEY k_group_score(group_name,score)
) ENGINE=InnoDB
PARTITION BY RANGE(tenant_id) (
  PARTITION p_low VALUES LESS THAN (50),
  PARTITION p_high VALUES LESS THAN (MAXVALUE)
);
INSERT INTO xfer2_x911_partitioned
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<24
)
SELECT 10,n,100+n,IF(MOD(n,2)=0,'low-even','low-odd'),'seed'
  FROM seq
UNION ALL
SELECT 70,n,700+n,IF(MOD(n,2)=0,'high-even','high-odd'),'seed'
  FROM seq;

CREATE TABLE xfer2_x911_boundary(
  id INT PRIMARY KEY,
  ci_key VARCHAR(32) CHARACTER SET utf8mb4
    COLLATE utf8mb4_0900_ai_ci NOT NULL,
  bin_key VARBINARY(8) NOT NULL,
  nullable_key INT NULL,
  signed_edge BIGINT NOT NULL,
  unsigned_edge BIGINT UNSIGNED NOT NULL,
  decimal_edge DECIMAL(20,4) NOT NULL,
  state VARCHAR(32) NOT NULL,
  UNIQUE KEY uk_bin(bin_key),
  KEY k_ci(ci_key),
  KEY k_nullable(nullable_key)
) ENGINE=InnoDB;
INSERT INTO xfer2_x911_boundary VALUES
 (1,'Alpha',UNHEX('0001'),NULL,0,0,0.0000,'base'),
 (2,'bravo',UNHEX('0002'),2,-1,1,-1.2500,'base'),
 (3,'CAFÉ',UNHEX('00FF'),NULL,9223372036854775807,
    18446744073709551615,9999999999999999.9999,'base'),
 (4,'你好',UNHEX('7F00'),4,-9223372036854775808,42,
    -9999999999999999.9999,'base'),
 (5,'😀',UNHEX('FF00'),NULL,5,5,5.5000,'base'),
 (6,'Delta',UNHEX('0100'),6,6,6,6.6000,'base'),
 (7,'echo',UNHEX('0101'),NULL,7,7,7.7000,'base'),
 (8,'Foxtrot',UNHEX('0102'),8,8,8,8.8000,'base'),
 (9,'golf',UNHEX('0103'),NULL,9,9,9.9000,'base'),
 (10,'hotel',UNHEX('0104'),10,10,10,10.1000,'base'),
 (11,'india',UNHEX('0105'),NULL,11,11,11.1100,'base'),
 (12,'juliet',UNHEX('0106'),12,12,12,12.1200,'base');

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
--disable_warnings
DROP USER IF EXISTS xfer2_x911_receiver_app@localhost;
DROP TABLE IF EXISTS xfer2_x911_receiver_native;
--enable_warnings
CREATE USER xfer2_x911_receiver_app@localhost;
CREATE TABLE xfer2_x911_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x911_receiver_native
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<16
)
SELECT n,n*3 FROM seq;
GRANT SELECT,INSERT,UPDATE,DELETE ON test.xfer2_x911_receiver_native
  TO xfer2_x911_receiver_app@localhost;


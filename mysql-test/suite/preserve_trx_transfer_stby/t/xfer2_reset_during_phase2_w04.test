# X7-03 / X9-02 / W02 + W04 / O01 / O09 / O10 / T1 debug-contract / I02 / I10
# Pause after source targets are quiesced and BATCH_DRAINING is visible, but
# before final catchup, final metadata, or COMMIT_EPOCH. The original owner must
# first observe the 4020 command fence; RESET then restores that same THD and
# removes every receiver Phase1 resource without publishing terminal ownership.
# The restored transaction continues a foreign-key order/inventory workload,
# then rolls back without exposing a half order or a partial inventory delta.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--connection default
--disable_warnings
DROP TABLE IF EXISTS xfer2_x902_order_items,xfer2_x902_orders,
                     xfer2_x902_inventory;
--enable_warnings
CREATE TABLE xfer2_x902_inventory(
  sku_id INT PRIMARY KEY,
  stock INT NOT NULL,
  allocated INT NOT NULL DEFAULT 0,
  version INT NOT NULL DEFAULT 0,
  KEY k_stock(stock)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x902_orders(
  order_id BIGINT PRIMARY KEY,
  customer_id INT NOT NULL,
  status VARCHAR(16) NOT NULL,
  total INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  KEY k_status(status,order_id)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x902_order_items(
  order_id BIGINT NOT NULL,
  line_no INT NOT NULL,
  sku_id INT NOT NULL,
  qty INT NOT NULL,
  unit_price INT NOT NULL,
  status VARCHAR(16) NOT NULL,
  PRIMARY KEY(order_id,line_no),
  KEY k_status(status,order_id),
  KEY k_sku(sku_id),
  CONSTRAINT fk_x902_item_order FOREIGN KEY(order_id)
    REFERENCES xfer2_x902_orders(order_id),
  CONSTRAINT fk_x902_item_inventory FOREIGN KEY(sku_id)
    REFERENCES xfer2_x902_inventory(sku_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x902_inventory(sku_id,stock,allocated,version)
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<24
)
SELECT n,100,0,0 FROM seq;
SELECT COUNT(*)=24 AND MIN(stock)=100 AND MAX(stock)=100
         AND SUM(allocated<>0 OR version<>0)=0
         AS w02_inventory_seed_exact
  FROM xfer2_x902_inventory;
SELECT (SELECT COUNT(*) FROM xfer2_x902_orders)=0
         AND (SELECT COUNT(*) FROM xfer2_x902_order_items)=0
         AS w02_order_seed_empty;

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
--disable_warnings
DROP TABLE IF EXISTS xfer2_phase2_reset_receiver_native;
--enable_warnings
CREATE TABLE xfer2_phase2_reset_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  UNIQUE KEY uk_v(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_phase2_reset_receiver_native VALUES(1,10),(2,20);

SET @online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @admitted_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_bytes');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @saved_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_saved_online_tokens');
SET @terminal_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @terminal_tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @cleanup_debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @cleanup_debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @cleanup_tainted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_tainted_transitions');
SET @prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @prepared_pending_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');

--connection xfer2_source_ha
SET @reset_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_wins');
SET @reset_too_late_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_too_late');
SET @handoff_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_source_handoff_pending_epochs');
SET @unknown_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_source_commit_unknown_epochs');
SET @preserved_before=(SELECT COUNT(*)
  FROM performance_schema.preserved_transactions);

# W04 plus W02 in one real old-ReadView transaction. W02 inserts an order and
# three items, allocates only the two non-pending lines, deletes the pending
# line, and derives the order total from the surviving FK-bound item set.
--connect(xfer2_phase2_reset_owner,localhost,xfer2_w01_app,,test)
--let $owner_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS owner_rr_initial
  FROM xfer2_w01_accounts WHERE id=32;

--connect(xfer2_phase2_reset_outsider,localhost,root,,test)
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;
SELECT ROW_COUNT()=1 AS outsider_committed_once;

--connection xfer2_phase2_reset_owner
SELECT balance=1000 AND version=0 AS owner_rr_stays_old
  FROM xfer2_w01_accounts WHERE id=32;
UPDATE xfer2_w01_accounts
   SET balance=balance-25,version=version+1 WHERE id=3;
UPDATE xfer2_w01_accounts
   SET balance=balance+25,version=version+1 WHERE id=7;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(3,-25),(7,25);
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS owner_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (3,7);
SELECT MAX(CASE WHEN id=3 THEN balance END)=975
         AND MAX(CASE WHEN id=7 THEN balance END)=1025
         AS owner_w04_exact_effects
  FROM xfer2_w01_accounts WHERE id IN (3,7);
SELECT COUNT(*)=2 AND SUM(delta)=0
         AND SUM(account_id=3 AND delta=-25)=1
         AND SUM(account_id=7 AND delta=25)=1
         AS owner_w04_balanced_ledger
  FROM xfer2_w01_audit;
INSERT INTO xfer2_x902_orders(order_id,customer_id,status,total,version)
VALUES(9001,77,'BUILDING',0,0);
INSERT INTO xfer2_x902_order_items
  (order_id,line_no,sku_id,qty,unit_price,status)
VALUES(9001,1,3,2,40,'ALLOCATED'),
      (9001,2,7,3,25,'ALLOCATED'),
      (9001,3,11,1,60,'PENDING');
UPDATE xfer2_x902_inventory i
  JOIN xfer2_x902_order_items oi ON oi.sku_id=i.sku_id
   SET i.stock=i.stock-oi.qty,
       i.allocated=i.allocated+oi.qty,
       i.version=i.version+1
 WHERE oi.order_id=9001 AND oi.status='ALLOCATED';
SELECT ROW_COUNT()=2 AS owner_w02_allocated_two_inventory_rows;
DELETE FROM xfer2_x902_order_items
 WHERE order_id=9001 AND status='PENDING';
SELECT ROW_COUNT()=1 AS owner_w02_deleted_one_pending_item;
UPDATE xfer2_x902_orders
   SET status='READY',
       total=(SELECT SUM(qty*unit_price)
                FROM xfer2_x902_order_items
               WHERE order_id=9001),
       version=version+1
 WHERE order_id=9001;
SELECT ROW_COUNT()=1 AS owner_w02_finalized_one_order;
SET @x902_owner_before_reset_ok=
  (SELECT COUNT(*)=1 AND SUM(total)=155 AND SUM(version)=1
          AND SUM(status='READY')=1 FROM xfer2_x902_orders)
  AND
  (SELECT COUNT(*)=2 AND SUM(qty)=5 AND SUM(qty*unit_price)=155
          AND SUM(status='ALLOCATED')=2
     FROM xfer2_x902_order_items)
  AND
  (SELECT COUNT(*)=24 AND SUM(stock)=2395 AND SUM(allocated)=5
          AND SUM(version)=2 FROM xfer2_x902_inventory)
  AND
  (SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
          AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
          AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
     FROM xfer2_x902_inventory)
  AND
  (SELECT COUNT(*)=0
     FROM xfer2_x902_order_items oi
     LEFT JOIN xfer2_x902_orders o ON o.order_id=oi.order_id
     LEFT JOIN xfer2_x902_inventory i ON i.sku_id=oi.sku_id
    WHERE o.order_id IS NULL OR i.sku_id IS NULL);
--let $x902_owner_before_reset_ok= query_get_value(SELECT @x902_owner_before_reset_ok AS ok,ok,1)
if ($x902_owner_before_reset_ok != 1)
{
  --die X9-02 owner W02 model is not exact before Phase2 RESET
}
SELECT COUNT(*)=1 AND SUM(total)=155 AND SUM(version)=1
         AS owner_w02_order_exact_before_reset
  FROM xfer2_x902_orders;
SELECT COUNT(*)=2 AND SUM(qty)=5 AND SUM(qty*unit_price)=155
         AS owner_w02_items_exact_before_reset
  FROM xfer2_x902_order_items;
SELECT COUNT(*)=24 AND SUM(stock)=2395 AND SUM(allocated)=5
         AND SUM(version)=2 AS owner_w02_inventory_exact_before_reset
  FROM xfer2_x902_inventory;
SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
         AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
         AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
         AS owner_w02_inventory_rows_exact_before_reset
  FROM xfer2_x902_inventory;

--connection xfer2_phase2_reset_outsider
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
         AS outsider_hides_owner_changes
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS outsider_hides_owner_ledger
  FROM xfer2_w01_audit;
SELECT (SELECT COUNT(*) FROM xfer2_x902_orders)=0
         AND (SELECT COUNT(*) FROM xfer2_x902_order_items)=0
         AS outsider_hides_owner_w02_order;
SELECT COUNT(*)=24 AND SUM(stock)=2400 AND SUM(allocated)=0
         AND SUM(version)=0 AS outsider_hides_owner_w02_inventory
  FROM xfer2_x902_inventory;

--connect(xfer2_phase2_reset_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_batch_after_targets_quiesced_before_attach SIGNAL xfer2_phase2_reset_quiesced WAIT_FOR xfer2_phase2_reset_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_phase2_reset_quiesced TIMEOUT 60';

# This distinguishes X7-03 from the Phase1 case: BATCH_DRAINING has installed
# the ordinary command fence, but the source still owns the transaction.
--connection xfer2_phase2_reset_owner
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT total FROM xfer2_x902_orders WHERE order_id=9001;

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')>@admitted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')>@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')>@inflight_bytes_before
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
         = @online_before+1 AS one_live_precommit_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         = @active_before AS no_terminal_epoch_before_reset,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         > @admitted_before AS phase1_frames_reached_receiver,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
         > @admitted_bytes_before AS phase1_bytes_reached_receiver;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         > @inflight_tokens_before AS precommit_candidates_accounted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         > @inflight_bytes_before AS precommit_bytes_accounted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
         = @saved_before AS no_saved_token_before_reset;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         = @prepared_before AS no_final_prepared_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         = @prepared_ready_before AS no_final_ready_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
         = @ready_cache_before AS no_final_ready_cache,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         = @terminal_wins_before AS no_terminal_cas_before_reset;

# Unrelated receiver-native work commits while the source owner is fenced.
START TRANSACTION;
UPDATE xfer2_phase2_reset_receiver_native SET v=v+id;
INSERT INTO xfer2_phase2_reset_receiver_native VALUES(3,33);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=66 AS receiver_native_commit_during_phase2
  FROM xfer2_phase2_reset_receiver_native;

--connect(xfer2_phase2_reset_control,localhost,preserve_trx_ha_admin,xfer2-smoke-w01-secret,test)
--send RESET DRAIN

--connection xfer2_source_ha
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL xfer2_phase2_reset_release';

--connection xfer2_phase2_reset_control
--reap

--connection xfer2_phase2_reset_drain
--error ER_PRESERVE_TRX_DRAIN_RESET
--reap
SET DEBUG_SYNC='RESET';

--connection xfer2_source_ha
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')
         = @reset_wins_before+1 AS phase2_reset_won_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late')
         = @reset_too_late_before AS reset_before_commit_was_not_too_late;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_source_handoff_pending_epochs')
         = @handoff_before AS no_handoff_pending,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')
         = @unknown_before AS no_commit_unknown;
SELECT COUNT(*)=@preserved_before AS no_detached_source_token
  FROM performance_schema.preserved_transactions;

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@prepared_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')=@ready_cache_before
--let $wait_timeout= 20
--source include/wait_condition_or_abort.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         = @inflight_tokens_before AS reset_released_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         = @inflight_bytes_before AS reset_released_inflight_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         = @staged_before AS reset_released_staged_payload,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         = @memory_before AS reset_released_preserve_memory;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         = @active_before AS no_committed_receiver_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
         = @saved_before AS no_saved_receiver_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         = @terminal_wins_before AS reset_created_no_terminal_cas,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         = @terminal_tombstones_before AS reset_created_no_tombstone;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         = @cleanup_debt_tokens_before AS no_cleanup_debt_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         = @cleanup_debt_bytes_before AS no_cleanup_debt_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
           'Preserve_trx_transfer_receiver_cleanup_tainted_transitions')
         = @cleanup_tainted_before AS no_cleanup_taint;

# Drain any prewarm work queued before RESET observed the cancellation. Stale
# jobs must not recreate the ABORTED token or publish READY state.
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 20
--source include/wait_condition_or_abort.inc
--let $receiver_connection= xfer2_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_quiescent.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         = @inflight_tokens_before AS stale_job_did_not_restore_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         = @prepared_before AS stale_job_did_not_restore_prepared,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         = @prepared_ready_before AS stale_job_did_not_restore_ready,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
         = @ready_cache_before AS stale_job_did_not_restore_ready_cache;
SELECT COUNT(*)=3 AND SUM(v)=66
         AS reset_did_not_touch_receiver_native_commit
  FROM xfer2_phase2_reset_receiver_native;

# The command fence is reversible only because RESET won before COMMIT. The
# same source session and transaction resume with their old ReadView and DML.
--connection xfer2_phase2_reset_owner
--replace_result $owner_id OWNER_ID
--eval SELECT CONNECTION_ID()=$owner_id AS original_owner_connection_restored
SELECT balance=1000 AND version=0 AS owner_rr_survives_reset
  FROM xfer2_w01_accounts WHERE id=32;
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS owner_w04_survives_reset
  FROM xfer2_w01_accounts WHERE id IN (3,7);
SELECT COUNT(*)=2 AND SUM(delta)=0 AS owner_ledger_survives_reset
  FROM xfer2_w01_audit;
SET @x902_owner_after_reset_ok=
  (SELECT COUNT(*)=1 AND SUM(total)=155 AND SUM(version)=1
          AND SUM(status='READY')=1 FROM xfer2_x902_orders)
  AND
  (SELECT COUNT(*)=2 AND SUM(qty)=5 AND SUM(qty*unit_price)=155
          AND SUM(status='ALLOCATED')=2
     FROM xfer2_x902_order_items)
  AND
  (SELECT COUNT(*)=24 AND SUM(stock)=2395 AND SUM(allocated)=5
          AND SUM(version)=2 FROM xfer2_x902_inventory)
  AND
  (SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
          AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
          AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
     FROM xfer2_x902_inventory)
  AND
  (SELECT COUNT(*)=0
     FROM xfer2_x902_order_items oi
     LEFT JOIN xfer2_x902_orders o ON o.order_id=oi.order_id
     LEFT JOIN xfer2_x902_inventory i ON i.sku_id=oi.sku_id
    WHERE o.order_id IS NULL OR i.sku_id IS NULL);
--let $x902_owner_after_reset_ok= query_get_value(SELECT @x902_owner_after_reset_ok AS ok,ok,1)
if ($x902_owner_after_reset_ok != 1)
{
  --die X9-02 RESET did not restore the exact W02 transaction model
}
SELECT COUNT(*)=1 AND SUM(total)=155 AND SUM(version)=1
         AS owner_w02_order_survives_reset
  FROM xfer2_x902_orders;
SELECT COUNT(*)=2 AND SUM(qty*unit_price)=155
         AS owner_w02_items_survive_reset
  FROM xfer2_x902_order_items;
SELECT COUNT(*)=24 AND SUM(stock)=2395 AND SUM(allocated)=5
         AND SUM(version)=2 AS owner_w02_inventory_survives_reset
  FROM xfer2_x902_inventory;
SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
         AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
         AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
         AS owner_w02_inventory_rows_survive_reset
  FROM xfer2_x902_inventory;
UPDATE xfer2_w01_accounts
   SET pad=CONCAT(pad,'-after-phase2-reset') WHERE id=7;
SELECT ROW_COUNT()=1 AS owner_can_continue_after_reset;
INSERT INTO xfer2_x902_order_items
  (order_id,line_no,sku_id,qty,unit_price,status)
VALUES(9001,4,13,4,10,'ALLOCATED');
UPDATE xfer2_x902_inventory
   SET stock=stock-4,allocated=allocated+4,version=version+1
 WHERE sku_id=13;
SELECT ROW_COUNT()=1 AS owner_w02_continued_inventory_once;
UPDATE xfer2_x902_orders
   SET total=total+40,version=version+1
 WHERE order_id=9001;
SELECT ROW_COUNT()=1 AS owner_w02_continued_order_once;
SET @x902_owner_continued_ok=
  (SELECT COUNT(*)=1 AND SUM(total)=195 AND SUM(version)=2
          AND SUM(status='READY')=1 FROM xfer2_x902_orders)
  AND
  (SELECT COUNT(*)=3 AND SUM(qty)=9 AND SUM(qty*unit_price)=195
          AND SUM(status='ALLOCATED')=3
     FROM xfer2_x902_order_items)
  AND
  (SELECT COUNT(*)=24 AND SUM(stock)=2391 AND SUM(allocated)=9
          AND SUM(version)=3 FROM xfer2_x902_inventory)
  AND
  (SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
          AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
          AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
          AND SUM(sku_id=13 AND stock=96 AND allocated=4 AND version=1)=1
     FROM xfer2_x902_inventory)
  AND
  (SELECT COUNT(*)=0
     FROM xfer2_x902_order_items oi
     LEFT JOIN xfer2_x902_orders o ON o.order_id=oi.order_id
     LEFT JOIN xfer2_x902_inventory i ON i.sku_id=oi.sku_id
    WHERE o.order_id IS NULL OR i.sku_id IS NULL);
--let $x902_owner_continued_ok= query_get_value(SELECT @x902_owner_continued_ok AS ok,ok,1)
if ($x902_owner_continued_ok != 1)
{
  --die X9-02 restored owner could not continue W02 atomically
}
SELECT COUNT(*)=1 AND SUM(total)=195 AND SUM(version)=2
         AS owner_w02_order_continued_once
  FROM xfer2_x902_orders;
SELECT COUNT(*)=3 AND SUM(qty)=9 AND SUM(qty*unit_price)=195
         AS owner_w02_items_continued_once
  FROM xfer2_x902_order_items;
SELECT COUNT(*)=24 AND SUM(stock)=2391 AND SUM(allocated)=9
         AND SUM(version)=3 AS owner_w02_inventory_continued_once
  FROM xfer2_x902_inventory;
SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
         AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
         AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
         AND SUM(sku_id=13 AND stock=96 AND allocated=4 AND version=1)=1
         AS owner_w02_inventory_rows_continued_once
  FROM xfer2_x902_inventory;
ROLLBACK;

--connection xfer2_phase2_reset_outsider
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
CHECK TABLE xfer2_w01_accounts,xfer2_w01_audit;
SET @x902_after_rollback_ok=
  (SELECT COUNT(*)=0 FROM xfer2_x902_orders)
  AND (SELECT COUNT(*)=0 FROM xfer2_x902_order_items)
  AND
  (SELECT COUNT(*)=24 AND MIN(stock)=100 AND MAX(stock)=100
          AND SUM(allocated<>0 OR version<>0)=0
     FROM xfer2_x902_inventory);
--let $x902_after_rollback_ok= query_get_value(SELECT @x902_after_rollback_ok AS ok,ok,1)
if ($x902_after_rollback_ok != 1)
{
  --die X9-02 rollback exposed a partial order or inventory delta
}
SELECT (SELECT COUNT(*) FROM xfer2_x902_orders)=0
         AND (SELECT COUNT(*) FROM xfer2_x902_order_items)=0
         AS owner_w02_order_and_items_rolled_back;
SELECT COUNT(*)=24 AND MIN(stock)=100 AND MAX(stock)=100
         AND SUM(allocated<>0 OR version<>0)=0
         AS owner_w02_inventory_rolled_back
  FROM xfer2_x902_inventory;
CHECK TABLE xfer2_x902_inventory,xfer2_x902_orders,
            xfer2_x902_order_items;
DROP TABLE xfer2_x902_order_items,xfer2_x902_orders,
           xfer2_x902_inventory;

--connection xfer2_receiver
SELECT COUNT(*)=3 AND SUM(v)=66 AS receiver_native_final
  FROM xfer2_phase2_reset_receiver_native;
DROP TABLE xfer2_phase2_reset_receiver_native;

--disconnect xfer2_phase2_reset_outsider
--disconnect xfer2_phase2_reset_owner
--disconnect xfer2_phase2_reset_drain
--disconnect xfer2_phase2_reset_control

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

# Source created five business tables while the receiver created one native
# table. Consume the opposite table/index shapes, then compare one probe so the
# next MTR on this worker starts from aligned InnoDB dictionary allocators.
--connection xfer2_cleanup
--disable_query_log
CREATE TABLE xfer2_x902_source_counter_fill(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  UNIQUE KEY uk_v(v)
) ENGINE=InnoDB;
DROP TABLE xfer2_x902_source_counter_fill;
CREATE TABLE xfer2_x902_counter_probe(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
SET @x902_source_post_fingerprint=(
  SELECT CONCAT_WS(':',t.TABLE_ID,MIN(i.INDEX_ID),MAX(i.INDEX_ID),
                   MIN(i.SPACE),MAX(i.SPACE))
    FROM information_schema.innodb_tables t
    JOIN information_schema.innodb_indexes i ON i.TABLE_ID=t.TABLE_ID
   WHERE t.NAME='test/xfer2_x902_counter_probe'
   GROUP BY t.TABLE_ID);
--let $x902_source_post_fingerprint= query_get_value(SELECT @x902_source_post_fingerprint AS v,v,1)

--connection xfer2_receiver
CREATE TABLE xfer2_x902_receiver_counter_fill_1(
  id INT PRIMARY KEY
) ENGINE=InnoDB;
CREATE TABLE xfer2_x902_receiver_counter_fill_2(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x902_receiver_counter_fill_3(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x902_receiver_counter_fill_4(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x902_receiver_counter_fill_5(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  w INT NOT NULL,
  KEY(v),
  KEY(w)
) ENGINE=InnoDB;
DROP TABLE xfer2_x902_receiver_counter_fill_1,
           xfer2_x902_receiver_counter_fill_2,
           xfer2_x902_receiver_counter_fill_3,
           xfer2_x902_receiver_counter_fill_4,
           xfer2_x902_receiver_counter_fill_5;
CREATE TABLE xfer2_x902_counter_probe(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
--eval SET @x902_post_test_dict_identity_matches=(SELECT CONCAT_WS(':',t.TABLE_ID,MIN(i.INDEX_ID),MAX(i.INDEX_ID),MIN(i.SPACE),MAX(i.SPACE)) FROM information_schema.innodb_tables t JOIN information_schema.innodb_indexes i ON i.TABLE_ID=t.TABLE_ID WHERE t.NAME='test/xfer2_x902_counter_probe' GROUP BY t.TABLE_ID)='$x902_source_post_fingerprint'
--let $x902_post_test_dict_identity_matches= query_get_value(SELECT @x902_post_test_dict_identity_matches AS ok,ok,1)
if ($x902_post_test_dict_identity_matches != 1)
{
  --die X9-02 test cleanup left source and receiver dictionary counters misaligned
}
--enable_query_log
SELECT @x902_post_test_dict_identity_matches=1
         AS post_test_dictionary_counters_remain_aligned;
--disable_query_log
DROP TABLE xfer2_x902_counter_probe;
--connection xfer2_cleanup
DROP TABLE xfer2_x902_counter_probe;
--enable_query_log

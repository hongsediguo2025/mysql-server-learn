--source include/have_debug.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X4-07 / W03 / O01 / O09 / O10 / T1 / I02 / I09 / I10 / I14.
# Hold cleanup failure for one receiver-selected W03 token until its real debt
# and byte budget are observable.  After releasing the injection, the receiver
# reaper must clear that exact debt online and leave the token permanently
# not-ready without entering CLEANUP_TAINTED.
# Receiver-native commits remain independent before and after an O10 restart.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

# W03 source data spans primary, nonunique-secondary, and unique-key paths.
--connection default
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS xfer2_x407_items;
--enable_warnings
CREATE TABLE xfer2_x407_items(
  id INT PRIMARY KEY,
  business_key VARCHAR(32) NOT NULL,
  bucket INT NOT NULL,
  score INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  pad VARCHAR(512) NOT NULL,
  UNIQUE KEY uk_business(business_key),
  KEY idx_bucket(bucket,id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x407_items
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<128
)
SELECT n,CONCAT('biz-',LPAD(n,4,'0')),MOD(n,8),n*10,0,
       REPEAT(CHAR(65+MOD(n,26)),400)
  FROM seq;
--enable_query_log

--connect(xfer2_x407_owner,localhost,xfer2_w01_app,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT id=128 AND score=1280 AND version=0
         AS owner_old_view_established
  FROM xfer2_x407_items FORCE INDEX(PRIMARY) WHERE id=128;

--connect(xfer2_x407_outsider,localhost,root,,test)
UPDATE xfer2_x407_items
   SET score=score+70,version=version+1 WHERE id=128;
SELECT ROW_COUNT()=1 AS outsider_commit_applied;

--connection xfer2_x407_owner
SELECT id=128 AND score=1280 AND version=0 AS owner_retains_old_view
  FROM xfer2_x407_items FORCE INDEX(PRIMARY) WHERE id=128;
UPDATE xfer2_x407_items
   SET business_key='biz-1007',bucket=70,score=score+7,version=version+1
 WHERE id=7;
SELECT ROW_COUNT()=1 AS first_cross_index_update_applied;
UPDATE xfer2_x407_items
   SET business_key='biz-1064',bucket=71,score=score+64,version=version+1
 WHERE id=64;
SELECT ROW_COUNT()=1 AS second_cross_index_update_applied;
INSERT INTO xfer2_x407_items
  VALUES(193,'biz-0193',72,1930,1,REPEAT('Z',400));
SELECT ROW_COUNT()=1 AS new_unique_key_inserted;
DELETE FROM xfer2_x407_items WHERE id=31;
SELECT ROW_COUNT()=1 AS old_unique_key_deleted;
SELECT COUNT(*)=128 AND SUM(score)=84251 AND SUM(version)=3
         AS owner_w03_view_and_writes_exact
  FROM xfer2_x407_items FORCE INDEX(PRIMARY);
SELECT GROUP_CONCAT(id ORDER BY id)='7,64,193'
         AS owner_secondary_keys_exact
  FROM xfer2_x407_items FORCE INDEX(idx_bucket)
 WHERE bucket IN (70,71,72);
SELECT COUNT(*)=3 AS owner_unique_keys_exact
  FROM xfer2_x407_items FORCE INDEX(uk_business)
 WHERE business_key IN ('biz-1007','biz-1064','biz-0193');

--connection xfer2_x407_outsider
SELECT COUNT(*)=128 AND SUM(score)=82630 AND SUM(version)=1
         AS outsider_sees_only_committed_w03_state
  FROM xfer2_x407_items FORCE INDEX(PRIMARY);
SELECT COUNT(*)=0 AS owner_new_unique_keys_hidden
  FROM xfer2_x407_items FORCE INDEX(uk_business)
 WHERE business_key IN ('biz-1007','biz-1064','biz-0193');
SELECT COUNT(*)=1 AS owner_deleted_row_still_visible
  FROM xfer2_x407_items FORCE INDEX(PRIMARY) WHERE id=31;

# Durable native source work supplies the shared teardown baseline.
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;

# Capture receiver baselines and hold post-selection cleanup failure long
# enough to observe the process-local debt before releasing it.
--connection xfer2_receiver
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS xfer2_x407_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x407_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  pad VARCHAR(128) NOT NULL,
  KEY idx_v(v,id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x407_receiver_native VALUES
  (1,40,REPEAT('A',96)),(2,50,REPEAT('B',96));
--let $receiver_uuid_before= query_get_value(SELECT @@GLOBAL.server_uuid AS value,value,1)
--let $receiver_generation_before= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_process_generation',value,1)
SET @x407_active_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs');
SET @x407_terminal_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @x407_tombstones_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @x407_classified_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @x407_ready_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @x407_not_ready_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @x407_failed_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens');
SET @x407_inflight_tokens_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens');
SET @x407_inflight_bytes_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes');
SET @x407_staged_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @x407_prepared_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens');
SET @x407_pending_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @x407_prepared_ready_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens');
SET @x407_ready_cache_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes');
SET @x407_memory_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes');
SET @x407_debt_tokens_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @x407_debt_bytes_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @x407_debt_attempts_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts');
SET @x407_tainted_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions');
SET GLOBAL debug='+d,preserve_trx_receiver_fail_cleanup_until_tainted';
--enable_query_log

--connection default
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

# First prove the failed token owns an actual cleanup debt.  Without the fast
# retry hook, the test has several one-second reaper passes before the fifth
# failure could taint it.
--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@x407_active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@x407_terminal_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@x407_tombstones_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@x407_classified_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@x407_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@x407_not_ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@x407_failed_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@x407_debt_tokens_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')>@x407_debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')>@x407_debt_attempts_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')<5 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')=@x407_tainted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x407_inflight_tokens_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')>@x407_inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@x407_staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         =@x407_debt_tokens_before+1 AS cleanup_debt_observed,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         >@x407_debt_bytes_before AS cleanup_byte_budget_observed,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')
         >@x407_debt_attempts_before AS cleanup_attempt_observed,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')
         <5 AS cleanup_not_yet_tainted;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@x407_inflight_tokens_before+1 AS debt_owns_inflight_token_budget,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         >@x407_inflight_bytes_before AS debt_owns_inflight_byte_budget,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@x407_staged_before AS failed_token_releases_staged_memory,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')
         =@x407_tainted_before AS cleanup_not_tainted;
SET GLOBAL debug='-d,preserve_trx_receiver_fail_cleanup_until_tainted';

# The next selected-token reaper pass can now finish cleanup.  This path calls
# complete_cleanup_pending() directly; the narrower retry_cleanup_debt_once()
# completion counter is intentionally not used as a generic success signal.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@x407_failed_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@x407_debt_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=@x407_debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')=@x407_debt_attempts_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')=@x407_tainted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x407_inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@x407_inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@x407_staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@x407_prepared_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens')=@x407_pending_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=@x407_prepared_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')=@x407_ready_cache_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')=@x407_memory_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
--let $receiver_connection= xfer2_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_quiescent.inc

SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
         =@x407_classified_before+1 AS w03_token_classified_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
         =@x407_ready_before AS failed_token_never_ready,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
         =@x407_not_ready_before+1 AS failed_token_not_ready_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
         =@x407_failed_before+1 AS failed_token_terminal_once;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         =@x407_debt_tokens_before AS cleanup_debt_resolved_online,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         =@x407_debt_bytes_before AS cleanup_byte_budget_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_max_attempts')
         =@x407_debt_attempts_before AS cleanup_attempt_state_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')
         =@x407_tainted_before AS cleanup_never_tainted;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@x407_inflight_tokens_before AS no_inflight_token_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         =@x407_inflight_bytes_before AS no_inflight_byte_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@x407_staged_before AS no_staged_memory_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         =@x407_memory_before AS no_preserve_memory_residue;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@x407_prepared_before AS no_prepared_token_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens')
         =@x407_pending_before AS no_prewarm_pending_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         =@x407_prepared_ready_before AS no_prepared_ready_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
         =@x407_ready_cache_before AS no_ready_cache_residue;
SELECT VARIABLE_VALUE='receiver_selection_failed:3'
         AS cleanup_terminal_reason_is_exact
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';

# Ordinary receiver work remains writable after online cleanup recovery.
START TRANSACTION;
UPDATE xfer2_x407_receiver_native SET v=v+id WHERE id IN (1,2);
INSERT INTO xfer2_x407_receiver_native VALUES(3,60,REPEAT('C',96));
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=153 AS native_commit_visible_after_cleanup_retry
  FROM xfer2_x407_receiver_native;
SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id)='1:41,2:52,3:60'
         AS native_rows_exact_after_cleanup_retry
  FROM xfer2_x407_receiver_native FORCE INDEX(PRIMARY);

--connection xfer2_x407_owner
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

# O10: a fresh receiver generation must not replay the failed token or its
# already-resolved cleanup debt.
--connection xfer2_receiver
--exec echo "restart:" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--let $receiver_generation_after= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_process_generation',value,1)
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
--disable_query_log
--eval SELECT @@GLOBAL.server_uuid='$receiver_uuid_before' AS receiver_datadir_identity_stable
--eval SELECT $receiver_generation_before<>0 AND $receiver_generation_after<>0 AND $receiver_generation_before<>$receiver_generation_after AS receiver_process_generation_changed
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=0
         AS no_cleanup_debt_replayed,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=0
         AS old_failed_token_cleared,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')=0
         AS no_taint_replayed;
SELECT COUNT(*)=3 AND SUM(v)=153 AS native_commit_survives_receiver_restart
  FROM xfer2_x407_receiver_native;
SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id)='1:41,2:52,3:60'
         AS native_rows_exact_after_receiver_restart
  FROM xfer2_x407_receiver_native FORCE INDEX(idx_v);

--connection xfer2_x407_owner
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--disconnect xfer2_x407_outsider
--disconnect xfer2_x407_owner

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

--connection xfer2_cleanup
SELECT COUNT(*)=128 AND SUM(score)=82630 AND SUM(version)=1
         AS source_w03_final_committed_state_exact
  FROM xfer2_x407_items FORCE INDEX(PRIMARY);
SELECT COUNT(*)=16 AND SUM(score)=10950 AND SUM(version)=1
         AS source_w03_secondary_state_exact
  FROM xfer2_x407_items FORCE INDEX(idx_bucket) WHERE bucket=0;
SELECT id=64 AND bucket=0 AND score=640 AND version=0
         AS source_w03_unique_state_restored
  FROM xfer2_x407_items FORCE INDEX(uk_business)
 WHERE business_key='biz-0064';
SELECT COUNT(*)=0 AS source_owner_new_keys_rolled_back
  FROM xfer2_x407_items FORCE INDEX(uk_business)
 WHERE business_key IN ('biz-1007','biz-1064','biz-0193');
SELECT (SELECT COUNT(*) FROM xfer2_x407_items WHERE id=31)=1
         AND (SELECT COUNT(*) FROM xfer2_x407_items WHERE id=193)=0
         AS source_delete_and_insert_rolled_back;
CHECK TABLE xfer2_x407_items;
DROP TABLE xfer2_x407_items;

--connection xfer2_receiver
SELECT COUNT(*)=3 AND SUM(v)=153 AS native_commit_survives_full_teardown_restart
  FROM xfer2_x407_receiver_native;
SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id)='1:41,2:52,3:60'
         AS native_rows_exact_after_full_teardown
  FROM xfer2_x407_receiver_native FORCE INDEX(PRIMARY);
CHECK TABLE xfer2_x407_receiver_native;
DROP TABLE xfer2_x407_receiver_native;

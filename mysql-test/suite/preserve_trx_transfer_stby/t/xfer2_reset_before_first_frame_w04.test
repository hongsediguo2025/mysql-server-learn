# X7-01 / X10-01 / X10-09 increment / W04 / O01 / O02 / O09 / T1 /
# I02 / I10
#
# Pause after the authenticated OPEN_EPOCH ACK but before the first
# sequence-tracked frame, then issue RESET DRAIN. The kernel correctly stops
# before DECLARE_TOKEN, restores the source once, and leaves every payload,
# prepared, and memory surface empty. RESET must convert the authenticated
# OPEN-only context into one bounded NOT_COMMITTED terminal tombstone, rather
# than leave an unowned online entry that only receiver restart can remove.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x701_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x701_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x701_receiver_native VALUES(1,10),(2,20);

SET @online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @admitted_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_bytes');
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');

--connection xfer2_source_ha
SET @reset_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_wins');
SET @reset_too_late_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_too_late');

# Reuse the receiver-generation helper only for its rich W04/RR/O01/O02 source
# background. The transfer fault itself remains the OPEN-to-first-frame RESET.
--let $rg_control_connection= xfer2_source_ha
--let $rg_owner_connection= xfer2_x701_owner
--let $rg_outsider_connection= xfer2_x701_outsider
--let $rg_waiter_connection= xfer2_x701_waiter
--let $rg_outsider_id= 32
--let $rg_outsider_delta= 1
--let $rg_expected_committed_balance= 32001
--let $rg_expected_committed_versions= 1
--source suite/preserve_trx_transfer_stby/include/run_receiver_generation_w01.inc

--connect(xfer2_x701_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_open_epoch_ack_before_first_frame SIGNAL xfer2_x701_open WAIT_FOR xfer2_x701_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_x701_open TIMEOUT 60';

# Fail hard unless OPEN_EPOCH reached the independent receiver and no
# sequence-tracked DECLARE/BEGIN/object frame has yet been admitted.
--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')=@admitted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
SELECT COUNT(*)>=1 AS authenticated_open_transport_exists
  FROM performance_schema.threads
 WHERE PROCESSLIST_USER='preserve_trx_ha_admin'
   AND PROCESSLIST_COMMAND='Sleep';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
       =@online_before+1 AS exactly_one_open_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
       =@admitted_before AS no_first_sequence_frame,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
       =@admitted_bytes_before AS no_first_sequence_bytes;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
       =@active_before AS no_terminal_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
       =@inflight_tokens_before AS no_declared_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
       =@staged_before AS no_staged_payload;

# O09: unrelated receiver-native work commits while the OPEN-only transfer
# context exists. RESET cleanup must not own this transaction.
START TRANSACTION;
UPDATE xfer2_x701_receiver_native SET v=v+id;
INSERT INTO xfer2_x701_receiver_native VALUES(3,30);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_native_commit_during_open_pause
  FROM xfer2_x701_receiver_native;

--connect(xfer2_x701_reset,localhost,preserve_trx_ha_admin,xfer2-smoke-w01-secret,test)
--send RESET DRAIN

--connection xfer2_source_ha
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
SET DEBUG_SYNC='now SIGNAL xfer2_x701_release';

--connection xfer2_x701_reset
--reap

--connection xfer2_x701_drain
--error ER_PRESERVE_TRX_DRAIN_RESET
--reap
SET DEBUG_SYNC='RESET';

--connection xfer2_source_ha
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')
       =@reset_wins_before+1 AS reset_won_before_first_frame,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late')
       =@reset_too_late_before AS reset_not_too_late;
--eval SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_handoff_pending_epochs')=$rg_handoff_before AS no_handoff_pending,(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')=$rg_unknown_before AS no_commit_unknown
--eval SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_epochs')=$rg_quarantine_epochs_before AS no_quarantine_epoch,(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_tokens')=$rg_quarantine_tokens_before AS no_quarantine_token
--eval SELECT COUNT(*)=$rg_preserved_before AS no_detached_source_token FROM performance_schema.preserved_transactions

# No DECLARE/ABORT sequence frame crosses the named boundary. The OPEN-only
# context must instead become an authenticated, retention-bounded terminal
# tombstone without inventing a token or payload lifecycle.
--connection xfer2_receiver
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
       =@admitted_before AS reset_sent_no_sequence_frame,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
       =@online_before+1 AS bounded_terminal_context_retained;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
       =@inflight_tokens_before AS no_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
       =@inflight_bytes_before AS no_inflight_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
       =@staged_before AS no_staged_memory,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
       =@memory_before AS no_preserve_memory;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
       =@prepared_before AS no_prepared_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
       =@ready_before AS no_ready_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
       =@ready_cache_before AS no_ready_cache;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
       =@terminal_before+1 AS open_only_abandon_cas_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')
       =@tombstones_before+1 AS open_only_terminal_tombstone_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
       =@debt_tokens_before AS no_cleanup_debt_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
       =@debt_bytes_before AS no_cleanup_debt_bytes;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--let $receiver_connection= xfer2_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_quiescent.inc
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_native_commit_survives_reset
  FROM xfer2_x701_receiver_native;

# I02: RESET returns only after the original owner is runnable with the same RR
# view, writes, and locks. The blocked waiter cannot proceed until application
# rollback, then executes exactly once.
--connection xfer2_x701_owner
--replace_result $rg_owner_connection_id OWNER_ID
--eval SELECT CONNECTION_ID()=$rg_owner_connection_id AS original_owner_connection_restored
SELECT balance=1000 AND version=0 AS owner_rr_view_restored
  FROM xfer2_w01_accounts WHERE id=32;
SELECT SUM(balance)=3000 AND SUM(version)=3 AS owner_w04_writes_restored
  FROM xfer2_w01_accounts WHERE id IN (3,7,11);
SELECT COUNT(*)=1 AND SUM(delta)=0 AS owner_audit_restored
  FROM xfer2_w01_audit WHERE account_id=3;
UPDATE xfer2_w01_accounts SET pad=CONCAT(pad,'-after-x701-reset') WHERE id=11;
SELECT ROW_COUNT()=1 AS owner_can_continue_after_reset;

--connection xfer2_source_ha
--replace_result $rg_waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_reset FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$rg_waiter_connection_id

--connection xfer2_x701_owner
ROLLBACK;

--connection xfer2_x701_waiter
--reap

--connection xfer2_x701_outsider
SELECT COUNT(*)=32 AS final_row_count,
       SUM(balance)=32007 AS outsider_and_waiter_committed_once,
       SUM(version)=2 AS two_committed_versions,
       MAX(CASE WHEN id=3 THEN balance END)=1006 AS waiter_ran_once,
       MAX(CASE WHEN id=11 THEN version END)=0 AS owner_writes_rolled_back
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS owner_audit_rolled_back FROM xfer2_w01_audit;
CHECK TABLE xfer2_w01_accounts,xfer2_w01_audit;

# Normalize the waiter row while retaining the shared O01 id=32 commit.
UPDATE xfer2_w01_accounts
   SET balance=1000,version=0,pad=CONCAT('account-',id) WHERE id=3;
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection xfer2_receiver
DROP TABLE xfer2_x701_receiver_native;

--disconnect xfer2_x701_waiter
--disconnect xfer2_x701_outsider
--disconnect xfer2_x701_owner
--disconnect xfer2_x701_drain
--disconnect xfer2_x701_reset

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

# A process restart clears the bounded non-durable terminal context. The
# registry GUnit separately advances the retention clock and proves online
# retirement without a restart.
--connection xfer2_receiver
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=0
AS receiver_restart_retires_open_only_tombstone;

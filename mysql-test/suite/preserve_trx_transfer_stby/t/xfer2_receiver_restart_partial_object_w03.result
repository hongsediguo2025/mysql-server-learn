CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
CALL mtr.add_suppression("PRESERVE: standby transfer client send failed errno=.*");
CALL mtr.add_suppression(".*Got an error reading communication packets.*");
CALL mtr.add_suppression(
"PRESERVE: standby transfer source epoch abort failed status=(3|9)");
CALL mtr.add_suppression(
"PRESERVE: RESET receiver epoch cleanup deferred status=");
CREATE TABLE xfer2_x409_items(
id INT PRIMARY KEY,
bucket_id INT NOT NULL,
business_key VARCHAR(32) NOT NULL,
amount INT NOT NULL,
version INT NOT NULL DEFAULT 0,
payload LONGBLOB NOT NULL,
UNIQUE KEY uk_business(business_key),
KEY k_bucket_amount(bucket_id,amount)
) ENGINE=InnoDB;
INSERT INTO xfer2_x409_items
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<64
)
SELECT n,MOD(n,8),CONCAT('biz-',LPAD(n,4,'0')),n*10,0,
REPEAT(CHAR(65+MOD(n,26)),64)
FROM seq;
UPDATE xfer2_w01_accounts
SET balance=balance+1,version=version+1 WHERE id=32;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
DROP TABLE IF EXISTS xfer2_x409_receiver_native;
CREATE TABLE xfer2_x409_receiver_native(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x409_receiver_native VALUES(1,10),(2,20);

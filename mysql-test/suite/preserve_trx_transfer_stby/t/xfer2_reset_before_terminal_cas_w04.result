SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS owner_rr_initial
FROM xfer2_w01_accounts WHERE id=32;
owner_rr_initial
1
UPDATE xfer2_w01_accounts
SET balance=balance+1,version=version+1 WHERE id=32;
SELECT ROW_COUNT()=1 AS outsider_committed_once;
outsider_committed_once
1
SELECT balance=1000 AND version=0 AS owner_rr_stays_old
FROM xfer2_w01_accounts WHERE id=32;
owner_rr_stays_old
1
UPDATE xfer2_w01_accounts
SET balance=balance-55,version=version+1 WHERE id=5;
UPDATE xfer2_w01_accounts
SET balance=balance+55,version=version+1 WHERE id=9;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(5,-55),(9,55);
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
AS owner_w04_balance_conserved
FROM xfer2_w01_accounts WHERE id IN (5,9);
owner_w04_balance_conserved
1
SELECT MAX(CASE WHEN id=5 THEN balance END)=945
AND MAX(CASE WHEN id=9 THEN balance END)=1055
AS owner_w04_exact_effects
FROM xfer2_w01_accounts WHERE id IN (5,9);
owner_w04_exact_effects
1
SELECT COUNT(*)=2 AND SUM(delta)=0 AS owner_w04_balanced_ledger
FROM xfer2_w01_audit;
owner_w04_balanced_ledger
1
START TRANSACTION;
SAVEPOINT s1;
UPDATE xfer2_x907_savepoint
SET v=v+100,state='s1-update' WHERE id=1;
INSERT INTO xfer2_x907_savepoint VALUES(50,50,50,'s1-insert');
SAVEPOINT s2;
UPDATE xfer2_x907_savepoint
SET v=v+200,state='s2-rolled-back' WHERE id=2;
DELETE FROM xfer2_x907_savepoint WHERE id=3;
INSERT INTO xfer2_x907_savepoint VALUES(51,51,51,'s2-rolled-back');
ROLLBACK TO SAVEPOINT s2;
RELEASE SAVEPOINT s2;
UPDATE xfer2_x907_savepoint
SET v=v+400,state='post-s2' WHERE id=4;
SELECT COUNT(*)=33 AS owner_w07_exact_row_count,
SUM(v)=1078 AS owner_w07_exact_value_sum,
SUM(id=1 AND seq_no=1 AND v=101 AND state='s1-update')=1
AS owner_s1_update_once,
SUM(id=2 AND seq_no=2 AND v=2 AND state='base')=1
AS owner_s2_update_absent,
SUM(id=3 AND seq_no=3 AND v=3 AND state='base')=1
AS owner_s2_delete_absent,
SUM(id=4 AND seq_no=4 AND v=404 AND state='post-s2')=1
AS owner_post_s2_update_once,
SUM(id=50 AND seq_no=50 AND v=50 AND state='s1-insert')=1
AS owner_s1_insert_once,
SUM(id=51)=0 AS owner_s2_insert_absent,
SUM(state='s2-rolled-back')=0 AS owner_no_s2_state
FROM xfer2_x907_savepoint;
owner_w07_exact_row_count	owner_w07_exact_value_sum	owner_s1_update_once	owner_s2_update_absent	owner_s2_delete_absent	owner_post_s2_update_once	owner_s1_insert_once	owner_s2_insert_absent	owner_no_s2_state
1	1	1	1	1	1	1	1	1

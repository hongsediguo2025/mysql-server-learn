SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_expired_epochs')
=@x1205_expired_before+1 AS control_epoch_expired_once,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_terminal_tombstone_expiries')
=@x1205_expiries_before+1 AS control_tombstone_expired_once,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_terminal_status_not_found')
=@x1205_not_found_before+1 AS authenticated_query_not_found_once;

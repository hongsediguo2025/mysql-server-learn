--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X7-04 / X9-07 / X10-02 increments /
# W03(RR) + W04 + W07 / O01 / O03 / O09 / O10 /
# T1 debug-contract / I02 / I05 / I06 / I10.
# Pause after every final-token payload is ACKed but immediately before the
# receiver COMMIT_EPOCH ownership CAS.  RESET must win the source race, send
# authenticated NOT_COMMITTED cleanup with one terminal CAS winner and one
# exact idempotent ABANDON duplicate, restore all original THDs, and leave no
# receiver token resources or false READY publication.  The W03/RR owner holds
# a real nonunique-index next-key range while an insert waits inside its gap;
# RESET must not release that waiter before the original owner rolls back.
# The W07 owner keeps S1 live, rolls back S2, and updates another row after S2;
# after RESET only that source owner may commit the exact retained state once.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--connection default
--disable_warnings
DROP TABLE IF EXISTS xfer2_x907_savepoint;
DROP TABLE IF EXISTS xfer2_x1002_gap;
--enable_warnings
CREATE TABLE xfer2_x907_savepoint(
  id INT PRIMARY KEY,
  seq_no INT NOT NULL,
  v INT NOT NULL,
  state VARCHAR(24) NOT NULL,
  UNIQUE KEY uk_seq(seq_no),
  KEY k_state(state)
) ENGINE=InnoDB;
INSERT INTO xfer2_x907_savepoint
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n,n,n,'base' FROM seq;
CREATE TABLE xfer2_x1002_gap(
  id INT PRIMARY KEY,
  k INT NOT NULL,
  amount INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  note VARCHAR(32) NOT NULL,
  UNIQUE KEY uk_note(note),
  KEY k_range(k,id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1002_gap
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<64
)
SELECT n,n*10,n*100,0,CONCAT('note-',LPAD(n,4,'0')) FROM seq;
--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x704_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x704_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x704_receiver_native VALUES(1,10),(2,20);


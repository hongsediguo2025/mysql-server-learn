WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active';
no_active_receiver_worker
1
SELECT VARIABLE_VALUE=0 AS no_receiver_queue
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes';
no_receiver_queue
1
START TRANSACTION;
UPDATE xfer2_wrong_receiver_native SET v=v+2 WHERE id IN (1,2);
COMMIT;
SELECT SUM(v)=94 AS receiver_native_dml_works
FROM xfer2_wrong_receiver_native;
receiver_native_dml_works
1
SELECT CONNECTION_ID() AS same_owner_connection_after_auth_failure;
same_owner_connection_after_auth_failure
OWNER_ID

SELECT SUM(id=4 AND balance=992 AND version=1)=1
AND SUM(id=8 AND balance=1003 AND version=1)=1
AND SUM(id=12 AND balance=1005 AND version=1)=1
AS owner_updates_survive_auth_failure
FROM xfer2_wrong_accounts WHERE id IN (4,8,12);
owner_updates_survive_auth_failure

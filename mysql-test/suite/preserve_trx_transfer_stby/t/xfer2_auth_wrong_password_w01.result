CALL mtr.add_suppression(
"PRESERVE: standby transfer client connect failed errno=1045");
CALL mtr.add_suppression(
"PRESERVE: standby transfer OPEN_EPOCH failed status=3");
CREATE TABLE xfer2_wrong_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_wrong_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_wrong_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n,1000,0,CONCAT('wrong-',n) FROM seq;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS owner_rr_initial
FROM xfer2_wrong_accounts WHERE id=31;
owner_rr_initial
1
SELECT balance=1000 AND version=0 AS owner_rr_repeatable
FROM xfer2_wrong_accounts WHERE id=31;
owner_rr_repeatable
1
SELECT COUNT(*)=32 AS outsider_row_count,
SUM(balance)=32006 AS outsider_sees_background_only,
SUM(version)=1 AS outsider_hides_owner_versions,
SUM(id IN (4,8,12) AND version<>0)=0 AS owner_rows_not_dirty
FROM xfer2_wrong_accounts;
outsider_row_count	outsider_sees_background_only	outsider_hides_owner_versions	owner_rows_not_dirty
1	1	1	1
SELECT COUNT(*)=0 AS owner_audit_not_dirty FROM xfer2_wrong_audit;
owner_audit_not_dirty
1
SELECT COUNT(*)=1 AS waiter_blocked_before_auth_failure FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_blocked_before_auth_failure
1
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*)=1 AS waiter_still_blocked_after_auth_failure FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_still_blocked_after_auth_failure
1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
=@receiver_admitted_before AS no_frame_admitted,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
=@receiver_active_before AS no_receiver_epoch,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
=@receiver_inflight_tokens_before AS no_inflight_token,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
=@receiver_inflight_bytes_before AS no_inflight_byte,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
=@receiver_staged_before AS no_staged_memory;
no_frame_admitted	no_receiver_epoch	no_inflight_token	no_inflight_byte	no_staged_memory
1	1	1	1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
=@receiver_terminal_before AS no_terminal_fact,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
=@receiver_prepared_before AS no_prepared_entry;
no_terminal_fact	no_prepared_entry
1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
=@receiver_extra_admitted_bytes_before AS no_admitted_byte,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_cleanup_debt_tokens')
=@receiver_extra_cleanup_debt_tokens_before AS no_cleanup_debt,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
=@receiver_extra_cleanup_debt_bytes_before AS no_cleanup_debt_byte,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_terminal_status_tombstones')
=@receiver_extra_tombstones_before AS no_terminal_tombstone,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_promotion_prepared_prewarm_pending_tokens')
=@receiver_extra_prepared_pending_before AS no_prepared_pending,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
=@receiver_extra_prepared_ready_before AS no_prepared_ready,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
=@receiver_extra_ready_cache_before AS no_ready_cache,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
=@receiver_extra_memory_before AS no_preserve_memory;
no_admitted_byte	no_cleanup_debt	no_cleanup_debt_byte	no_terminal_tombstone	no_prepared_pending	no_prepared_ready	no_ready_cache	no_preserve_memory
1	1	1	1	1	1	1	1

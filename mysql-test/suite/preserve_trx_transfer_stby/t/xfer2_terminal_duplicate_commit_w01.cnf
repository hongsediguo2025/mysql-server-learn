!include ../my.cnf

[mysqld.1]
skip-log-bin
rds-preserve-trx-transfer-runtime-profile=BUSINESS_FIRST
max_allowed_packet=67108864
# Debug-contract: hide only the first successful COMMIT_EPOCH ACK from the
# source so its normal
# uncertain-send path replays the exact encoded operation/frame once.
debug=d,preserve_trx_transfer_drop_commit_ack_once

[mysqld.2]
skip-log-bin
max_allowed_packet=67108864

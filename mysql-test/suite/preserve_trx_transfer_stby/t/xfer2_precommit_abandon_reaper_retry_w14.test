--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X6-05 / X7-04a / W14 / O01 / T1 debug-contract
# A true two-mysqld RESET wins after final metadata is accepted locally but
# before COMMIT admission. The receiver already owns real staged payload.
# Foreground ABANDON cleanup is deferred. The source retries the byte-identical
# authenticated ABANDON, then the online reaper re-enters the same operation
# and retires staging without a receiver restart. Both duplicate paths must be
# idempotent: one terminal winner, one tombstone and no terminal conflict.
# This is distinct from X5-12b selected-token cleanup debt and X12-07's
# DECLARE_TOKEN rejection before payload staging.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

CALL mtr.add_suppression(
  "PRESERVE: RESET receiver epoch cleanup deferred status=");

--connection xfer2_receiver
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @cleanup_debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @cleanup_debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @prepared_registered_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @prepared_pending_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');
SET @terminal_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @terminal_duplicates_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_duplicates');
SET @terminal_conflicts_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_conflicts');
SET @terminal_tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @abandon_deferred_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_recv_precommit_abandon_cleanup_deferred');
SET @reaper_attempts_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_recv_precommit_abandon_reaper_attempts');
SET @reaper_completions_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_recv_precommit_abandon_reaper_completions');

--connect(xfer2_abandon_owner,localhost,xfer2_w01_app,,test)
--let $owner_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS owner_rr_initial
  FROM xfer2_w01_accounts WHERE id=32;
UPDATE xfer2_w01_accounts
   SET balance=balance-17, version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_debit;
UPDATE xfer2_w01_accounts
   SET balance=balance+9, version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_partial_credit;
UPDATE xfer2_w01_accounts
   SET balance=balance+8, version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_balance_restored;
INSERT INTO xfer2_w01_audit(account_id,delta) VALUES(3,0);
SELECT ROW_COUNT()=1 AS owner_audit_inserted;

--connect(xfer2_abandon_outsider,localhost,root,,test)
UPDATE xfer2_w01_accounts
   SET balance=balance+1, version=version+1 WHERE id=32;
SELECT ROW_COUNT()=1 AS outsider_commit;

--connection xfer2_abandon_owner
SELECT balance=1000 AND version=0 AS owner_rr_stays_old
  FROM xfer2_w01_accounts WHERE id=32;
SELECT balance=1000 AND version=3 AS owner_sees_three_updates
  FROM xfer2_w01_accounts WHERE id=3;

--connection xfer2_abandon_outsider
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc

--connect(xfer2_abandon_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_after_final_metadata_accepted_local SIGNAL xfer2_abandon_final_local WAIT_FOR xfer2_abandon_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_abandon_final_local TIMEOUT 60';

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')>@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')>@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')>@staged_memory_before
--source include/wait_condition.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         = @active_before AS no_commit_admission_at_pause,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         > @inflight_tokens_before AS staged_token_is_accounted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         > @inflight_bytes_before AS staged_bytes_are_accounted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         > @staged_memory_before AS real_payload_is_staged;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         = @terminal_wins_before AS no_terminal_cas_before_reset,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         = @terminal_tombstones_before AS no_tombstone_before_reset;
--connect(xfer2_abandon_reset,localhost,preserve_trx_ha_admin,xfer2-smoke-w01-secret,test)
--send RESET DRAIN

--connection xfer2_source_ha
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL xfer2_abandon_release';

--connection xfer2_abandon_reset
--reap

--connection xfer2_abandon_drain
--error 4021
--reap
SET DEBUG_SYNC='RESET';

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_recv_precommit_abandon_cleanup_deferred')>@abandon_deferred_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_recv_precommit_abandon_reaper_attempts')>@reaper_attempts_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_recv_precommit_abandon_reaper_completions')=@reaper_completions_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@staged_memory_before
--source include/wait_condition.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_recv_precommit_abandon_cleanup_deferred')
         > @abandon_deferred_before AS foreground_cleanup_was_deferred,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_recv_precommit_abandon_reaper_attempts')
         > @reaper_attempts_before AS reaper_claimed_abandoning_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_recv_precommit_abandon_reaper_completions')
         = @reaper_completions_before+1 AS reaper_completed_cleanup_once;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         = @terminal_wins_before+1 AS abandon_terminal_cas_won_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_cas_duplicates')
         = @terminal_duplicates_before+2
         AS exact_sender_retry_and_reaper_reentry,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_cas_conflicts')
         = @terminal_conflicts_before AS duplicate_abandon_is_not_conflict,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         = @terminal_tombstones_before+1 AS one_bounded_terminal_tombstone,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         = @active_before AS no_committed_receiver_epoch;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         = @inflight_tokens_before AS no_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         = @inflight_bytes_before AS no_inflight_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         = @staged_memory_before AS no_staged_payload,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         = @cleanup_debt_tokens_before AS no_cleanup_debt_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         = @cleanup_debt_bytes_before AS no_cleanup_debt_bytes;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         = @prepared_registered_before AS no_prepared_registration,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_promotion_prepared_prewarm_pending_tokens')
         = @prepared_pending_before AS no_prepared_pending,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         = @prepared_ready_before AS no_prepared_ready,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
         = @ready_cache_before AS no_ready_cache,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         = @memory_before AS preserve_memory_returns_to_baseline;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
         AS no_active_receiver_worker,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
         AS no_queued_receiver_bytes;

--connection xfer2_abandon_owner
--replace_result $owner_id OWNER_ID
--eval SELECT CONNECTION_ID()=$owner_id AS original_owner_restored
SELECT balance=1000 AND version=3 AS owner_writes_survive_reset
  FROM xfer2_w01_accounts WHERE id=3;
UPDATE xfer2_w01_accounts
   SET pad=CONCAT(pad,'-after-reset'), version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_can_continue_after_reset;
ROLLBACK;

--connection xfer2_abandon_outsider
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc

--disconnect xfer2_abandon_owner
--disconnect xfer2_abandon_outsider
--disconnect xfer2_abandon_drain
--disconnect xfer2_abandon_reset

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

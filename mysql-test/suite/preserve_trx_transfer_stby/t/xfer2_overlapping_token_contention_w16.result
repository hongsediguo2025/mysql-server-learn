DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC='now WAIT_FOR xfer2_x1008_before_cas TIMEOUT 120';
SELECT COUNT(*)=@x1008_preserved_before+3 AS three_survivors_detached,
SUM(MOD_TABLES_COUNT>=1)=3 AS every_survivor_has_data,
SUM(SAVEPOINT_COUNT)=1 AS one_savepoint_survivor,
SUM(SESSION_SQL_LOG_BIN='OFF')=2 AS two_no_bin_survivors,
SUM(BINLOG_STATE='LOGGED_WITH_CACHE')=1 AS one_w08b_cache_survivor
FROM performance_schema.preserved_transactions;

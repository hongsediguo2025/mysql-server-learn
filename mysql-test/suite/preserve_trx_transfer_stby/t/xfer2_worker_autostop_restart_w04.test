--source include/have_debug.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X5-03 / X5-05 / X5-07 / W04x3 / O01 / O09 / T1 two-mysqld / I07 / I10.
#
# Complete one real standby-transfer epoch, wait until the receiver prewarm
# pool has no active or idle workers, then submit a second independent epoch
# while prewarm is paused.  The second enqueue must recreate the worker pool.
# Its first strict-prewarm attempt is retryable, so the same token must requeue,
# become READY before the deadline, and auto-stop again without duplicate
# classification, permanent failure, residue, or damage to receiver-native
# data.  This is the independent-receiver T1 increment for the existing X5-03
# branch.  A third source generation then injects an epoch-global prewarm
# failure: it must publish no new classification or READY token and must not
# disturb the two retained READY epochs.  These are augment-existing runtime
# increments, not separate base-ID closures or physical-promotion claims.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x507_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x507_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x507_receiver_native VALUES(1,10),(2,20);

SET @online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @expired_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_expired_epochs');
SET @terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @classified_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @failed_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_failed_tokens');
SET @saved_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_saved_online_tokens');
SET @seal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_seal_prewarm_tokens');
SET @seal_success_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_seal_prewarm_success_tokens');
SET @seal_not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_seal_prewarm_not_ready_tokens');
SET @prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');

# One committed source-side background change is the durable reference state
# across both source restarts.  Neither W04 owner may leak into it.
--connection default
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;

--connect(xfer2_x507_owner1,localhost,xfer2_w01_app,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1001 AND version=1 AS first_owner_rr_initial
  FROM xfer2_w01_accounts WHERE id=32;
--disable_query_log
UPDATE xfer2_w01_accounts
   SET balance=balance-41,version=version+1 WHERE id=1;
UPDATE xfer2_w01_accounts
   SET balance=balance+41,version=version+1 WHERE id=2;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(1,-41),(2,41);
--enable_query_log
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS first_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (1,2);
SELECT COUNT(*)=2 AND SUM(delta)=0
         AND SUM(account_id=1 AND delta=-41)=1
         AND SUM(account_id=2 AND delta=41)=1
         AS first_w04_ledger_exact
  FROM xfer2_w01_audit;
--disable_query_log

# O01: an independent source view sees only the committed background row.
--connect(xfer2_x507_observer1,localhost,root,,test)
--enable_query_log
SELECT COUNT(*)=32 AS first_observer_row_count,
       SUM(balance)=32001 AS first_observer_only_background,
       SUM(version)=1 AS first_owner_changes_hidden
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS first_owner_ledger_hidden
  FROM xfer2_w01_audit;
--disable_query_log

--connect(xfer2_x507_drain1,localhost,root,,test)
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--enable_query_log
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log

# First prove the initial pool actually exists: terminal admission is complete,
# but paused workers retain a nonempty queue and cannot classify the token.
--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@terminal_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')>0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')>0
       AS first_worker_pool_started,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
       AS first_epoch_waiting_in_queue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@classified_before AS no_premature_first_classification;
--disable_query_log
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;

# The first token reaches READY, all queued work drains, and the proven-live
# pool retires even though the accepted receiver epoch remains live.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@terminal_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@tombstones_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@not_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@saved_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@prepared_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
       =@active_before+1 AS first_epoch_retained,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
       AS first_workers_inactive,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
       AS first_worker_pool_stopped;
SELECT COUNT(*)=2 AND SUM(v)=30 AS receiver_native_initial
  FROM xfer2_x507_receiver_native;
--disable_query_log

--connection xfer2_x507_owner1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

# Restart only the source.  Receiver process state and the first accepted epoch
# remain intact; source recovery rolls back the first detached owner.
--connection xfer2_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer2_smoke_w01 --rds-preserve-trx-transfer-credential-secret-file=$credential_file" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer2_x507_source_check,localhost,root,,test)
--enable_query_log
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
--disable_query_log

# Keep the second generation's prewarm job queued so the restarted worker pool
# is directly observable before it consumes the new token.
--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;

--connect(xfer2_x507_owner2,localhost,xfer2_w01_app,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1001 AND version=1 AS second_owner_rr_initial
  FROM xfer2_w01_accounts WHERE id=32;
--disable_query_log
UPDATE xfer2_w01_accounts
   SET balance=balance-53,version=version+1 WHERE id=3;
UPDATE xfer2_w01_accounts
   SET balance=balance+53,version=version+1 WHERE id=4;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(3,-53),(4,53);
--enable_query_log
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS second_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (3,4);
SELECT COUNT(*)=2 AND SUM(delta)=0
         AND SUM(account_id=3 AND delta=-53)=1
         AND SUM(account_id=4 AND delta=53)=1
         AS second_w04_ledger_exact
  FROM xfer2_w01_audit;
--disable_query_log

--connect(xfer2_x507_observer2,localhost,root,,test)
--enable_query_log
SELECT COUNT(*)=32 AS second_observer_row_count,
       SUM(balance)=32001 AS second_observer_only_background,
       SUM(version)=1 AS second_owner_changes_hidden
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS second_owner_ledger_hidden
  FROM xfer2_w01_audit;
--disable_query_log

--connect(xfer2_x507_drain2,localhost,root,,test)
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--enable_query_log
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@terminal_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@tombstones_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')>0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')>0
       AS worker_pool_restarted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
       AS second_epoch_waiting_in_queue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@classified_before+1 AS no_premature_second_classification;

# O09: receiver-native work commits while the second transfer is accepted but
# its prewarm queue is intentionally paused.
START TRANSACTION;
UPDATE xfer2_x507_receiver_native SET v=v+id;
INSERT INTO xfer2_x507_receiver_native VALUES(3,30);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_native_commit_while_paused
  FROM xfer2_x507_receiver_native;
--disable_query_log

# Inject exactly one retryable strict-prewarm result into the second epoch.
# The receiver must requeue the same token and finish it before the deadline.
SET GLOBAL debug='+d,preserve_trx_receiver_retry_one_token_prewarm';
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@ready_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@not_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@failed_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@saved_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_tokens')=@seal_before+3 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_success_tokens')=@seal_success_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_not_ready_tokens')=@seal_not_ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@prepared_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@debt_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=@debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
SET GLOBAL debug='-d,preserve_trx_receiver_retry_one_token_prewarm';

--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
       =@active_before+2 AS two_epochs_retained,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@classified_before+2 AS two_tokens_classified_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
       =@ready_before+2 AS two_tokens_ready_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
       =@not_ready_before AS no_not_ready_token;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_tokens')
       =@seal_before+3 AS first_success_plus_retry_plus_second_success,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_seal_prewarm_success_tokens')
       =@seal_success_before+2 AS both_epochs_finish_strict_prewarm,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_seal_prewarm_not_ready_tokens')
       =@seal_not_ready_before+1 AS exactly_one_retryable_attempt;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
       AS second_workers_inactive,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
       AS second_worker_pool_restopped,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
       AS second_queue_drained;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
       =@inflight_tokens_before AS no_inflight_token_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
       =@inflight_bytes_before AS no_inflight_byte_residue,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
       =@debt_tokens_before AS no_cleanup_debt_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
       =@debt_bytes_before AS no_cleanup_debt_bytes;
--disable_query_log

--let $assert_text= second epoch records exactly one retryable requeue
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select= PRESERVE: receiver staged-token prewarm deferred .*outcome=RETRYABLE_NOT_READY.*stage=DEBUG_RETRYABLE_NOT_READY.*retry_attempt=0
--let $assert_count_condition= == 1
--source include/assert_grep.inc
--let $assert_count_condition=

--connection xfer2_x507_owner2
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

# Restart the source again so the epoch-global fault is exercised by a fresh
# source generation while both successful receiver epochs remain retained.
--connection xfer2_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer2_smoke_w01 --rds-preserve-trx-transfer-credential-secret-file=$credential_file" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer2_x505_source_check,localhost,root,,test)
--enable_query_log
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
--disable_query_log

# The fault fires in the real receiver worker before strict prewarm records a
# token result.  Unlike X5-02's token-local failure, this epoch must not publish
# a partial selection or change either retained READY epoch.
--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL debug='+d,preserve_trx_receiver_fail_epoch_prewarm';

--connect(xfer2_x505_owner3,localhost,xfer2_w01_app,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--enable_query_log
SELECT balance=1001 AND version=1 AS third_owner_rr_initial
  FROM xfer2_w01_accounts WHERE id=32;
--disable_query_log
UPDATE xfer2_w01_accounts
   SET balance=balance-67,version=version+1 WHERE id=5;
UPDATE xfer2_w01_accounts
   SET balance=balance+67,version=version+1 WHERE id=6;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(5,-67),(6,67);
--enable_query_log
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS third_w04_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (5,6);
SELECT COUNT(*)=2 AND SUM(delta)=0
         AND SUM(account_id=5 AND delta=-67)=1
         AND SUM(account_id=6 AND delta=67)=1
         AS third_w04_ledger_exact
  FROM xfer2_w01_audit;
--disable_query_log

--connect(xfer2_x505_observer3,localhost,root,,test)
--enable_query_log
SELECT COUNT(*)=32 AS third_observer_row_count,
       SUM(balance)=32001 AS third_observer_only_background,
       SUM(version)=1 AS third_owner_changes_hidden
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS third_owner_ledger_hidden
  FROM xfer2_w01_audit;
--disable_query_log

--connect(xfer2_x505_drain3,localhost,root,,test)
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--enable_query_log
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log

--connection xfer2_receiver
SET GLOBAL debug='-d,preserve_trx_receiver_fail_epoch_prewarm';

# A post-COMMIT global failure owns its staging until the fixed prewarm
# deadline.  The real receiver reaper must then expire only this third epoch,
# remove its registry/staging state, and leave both older READY epochs intact.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_expired_epochs')=@expired_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@classified_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@ready_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@not_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@failed_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@saved_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@prepared_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@debt_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=@debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
         -@online_before AS online_epoch_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         -@active_before AS active_epoch_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         -@terminal_before AS terminal_cas_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         -@tombstones_before AS tombstone_delta_after_global_failure;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_expired_epochs')
         -@expired_before AS exactly_one_global_failure_epoch_expired;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
         -@classified_before AS classified_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
         -@ready_before AS ready_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
         -@not_ready_before AS not_ready_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
         -@failed_before AS failed_record_delta_after_global_failure;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_saved_online_tokens')
         -@saved_before AS saved_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_promotion_prepared_registered_tokens')
         -@prepared_before AS prepared_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_tokens')
         -@seal_before AS seal_attempt_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_seal_prewarm_success_tokens')
         -@seal_success_before AS seal_success_delta_after_global_failure,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_seal_prewarm_not_ready_tokens')
         -@seal_not_ready_before AS seal_not_ready_delta_after_global_failure;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@inflight_tokens_before AS global_failure_releases_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         =@inflight_bytes_before AS global_failure_releases_inflight_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@staged_before AS global_failure_releases_staged_memory,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         =@debt_tokens_before AS global_failure_adds_no_cleanup_debt,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         =@debt_bytes_before AS global_failure_adds_no_cleanup_debt_bytes;
SELECT COUNT(*)=3 AND SUM(v)=63
         AS receiver_native_data_survives_global_failure
  FROM xfer2_x507_receiver_native;
--disable_query_log

--connection xfer2_source_ha
--enable_query_log
SELECT COUNT(*)=1 AS exactly_one_third_generation_owner,
       SUM(MOD_TABLES_COUNT=2)=1 AS third_owner_has_w04_double_entry,
       SUM(HAS_READ_VIEW='YES')=1 AS third_owner_keeps_rr_view
  FROM performance_schema.preserved_transactions;
--disable_query_log

--connection xfer2_x505_owner3
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

# Shared teardown restarts both servers, proves all three private W04 epochs
# rolled back on their source generations, and checks that receiver process
# state is empty after restart.
--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

--connection xfer2_receiver
--enable_query_log
SELECT COUNT(*)=3 AND SUM(v)=63
         AS receiver_native_commit_survives_restart
  FROM xfer2_x507_receiver_native;
DROP TABLE xfer2_x507_receiver_native;
--enable_query_log

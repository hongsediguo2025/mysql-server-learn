CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
CALL mtr.add_suppression(
"PRESERVE: standby transfer source epoch commit failed status=");
CALL mtr.add_suppression(
"PRESERVE: receiver epoch cleanup after unsent commit deferred to receiver "
  "reaper");
SET GLOBAL debug='+d,preserve_trx_transfer_fail_final_metadata_deterministic';
UPDATE xfer2_w01_accounts
SET balance=balance+1,version=version+1 WHERE id=32;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE xfer2_w01_accounts
SET balance=balance-17,version=version+1 WHERE id=1;
UPDATE xfer2_w01_accounts
SET balance=balance+17,version=version+1 WHERE id=2;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(1,-17),(2,17);
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
AS owner1_w04_balance_conserved
FROM xfer2_w01_accounts WHERE id IN (1,2);
owner1_w04_balance_conserved
1
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE xfer2_w01_accounts
SET balance=balance-23,version=version+1 WHERE id=3;
UPDATE xfer2_w01_accounts
SET balance=balance+23,version=version+1 WHERE id=4;
INSERT INTO xfer2_w01_audit(account_id,delta)
VALUES(3,-23),(4,23);

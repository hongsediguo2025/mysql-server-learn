--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X3-09 / W01 / O01 / O02 / O09 / T1 debug-contract / I02 / I13 / I14
# Pause mysqld.2 after every selected source target is quiesced, non-target
# declarations are retired, and final catchup is complete, but before final
# metadata.  The
# real transfer operation deadline must return a bounded pre-COMMIT uncertainty:
# no terminal CAS or handoff, and the original source owner stays fenced until
# explicit RESET restores it.  Receiver process-local precommit residue is
# retired only by restart; unrelated receiver-native committed data survives.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc
CALL mtr.add_suppression(
  "PRESERVE: standby transfer source entered PRECOMMIT_ACK_UNCERTAIN");
CALL mtr.add_suppression("Got timeout reading communication packets");

--disable_query_log

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
--let $x309_receiver_pid_file= query_get_value(SELECT @@GLOBAL.pid_file AS value,value,1)
--disable_warnings
DROP TABLE IF EXISTS xfer2_x309_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x309_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x309_receiver_native
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<64
)
SELECT n,1000+n FROM seq;

SET @online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @admitted_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_bytes');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @saved_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_saved_online_tokens');
SET @terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');

--connection xfer2_source_ha
--let $x309_old_phase1_timeout= query_get_value(SELECT @@GLOBAL.rds_preserve_trx_drain_phase1_timeout_ms AS value,value,1)
--let $x309_old_phase2_timeout= query_get_value(SELECT @@GLOBAL.rds_preserve_trx_drain_phase2_timeout_ms AS value,value,1)
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=500;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=500;

--let $rg_control_connection= xfer2_source_ha
--let $rg_owner_connection= xfer2_x309_owner
--let $rg_outsider_connection= xfer2_x309_outsider
--let $rg_waiter_connection= xfer2_x309_waiter
--let $rg_outsider_id= 32
--let $rg_outsider_delta= 1
--let $rg_expected_committed_balance= 32001
--let $rg_expected_committed_versions= 1
--source suite/preserve_trx_transfer_stby/include/run_receiver_generation_w01.inc

--connect(xfer2_x309_drain,localhost,root,,test)
SET @x309_started=NOW(6);
SET DEBUG_SYNC=
  'preserve_trx_batch_after_final_transfer_catchup SIGNAL xfer2_x309_phase1_complete WAIT_FOR xfer2_x309_deadline_expired TIMEOUT 60';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_x309_phase1_complete TIMEOUT 30';
--let $x309_sync_warning_count= query_get_value("SELECT @@warning_count AS value",value,1)
if ($x309_sync_warning_count != 0)
{
  --die X3-09 phase boundary synchronization timed out
}

# BATCH_DRAINING has installed the ordinary source command fence, but ownership
# has not crossed a terminal boundary.
--connection xfer2_x309_owner
--enable_query_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT balance FROM xfer2_w01_accounts WHERE id=3;
--disable_query_log

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')>@admitted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')>@admitted_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')>@inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')>@inflight_bytes_before
--let $wait_timeout= 20
--source include/wait_condition_or_abort.inc
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
         =@online_before+1 AS one_phase1_epoch_before_timeout,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@active_before AS no_terminal_epoch_before_timeout;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         >@admitted_before AS phase1_frames_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
         >@admitted_bytes_before AS phase1_bytes_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         >@inflight_tokens_before AS phase1_token_reserved;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@prepared_before AS no_final_prepared_before_timeout,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         =@prepared_ready_before AS no_final_ready_before_timeout,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_before AS no_terminal_cas_before_timeout;

# O09: 64-row receiver-native work commits while Phase1 state is present.
START TRANSACTION;
UPDATE xfer2_x309_receiver_native SET v=v+id;
INSERT INTO xfer2_x309_receiver_native VALUES(65,2065);
COMMIT;
SELECT COUNT(*)=65 AND SUM(v)=70225
         AS receiver_native_commit_during_timeout_pause
  FROM xfer2_x309_receiver_native;
SET @admitted_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @online_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @inflight_tokens_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @prepared_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @memory_at_phase1=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');
--disable_query_log

# Stop the receiver process only after Phase1 evidence and native COMMIT are
# visible.  A detached watchdog resumes the same pid after 40 seconds even if
# a later assertion aborts the mysqltest script.
--exec perl $MYSQL_TEST_DIR/suite/preserve_trx_transfer_stby/include/x309_pause_receiver_with_watchdog.pl $x309_receiver_pid_file 40
--connection xfer2_source_ha
SET DEBUG_SYNC='now SIGNAL xfer2_x309_deadline_expired';

--connection xfer2_x309_drain
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
SET DEBUG_SYNC='RESET';
--enable_query_log
SELECT TIMESTAMPDIFF(MICROSECOND,@x309_started,NOW(6))
         BETWEEN 25000000 AND 45000000 AS final_metadata_timeout_is_bounded;
--disable_query_log

--connection xfer2_source_ha
--eval SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=$x309_old_phase1_timeout
--eval SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=$x309_old_phase2_timeout
--eval SET @x309_handoff_before=$rg_handoff_before,@x309_unknown_before=$rg_unknown_before,@x309_quarantine_epochs_before=$rg_quarantine_epochs_before,@x309_quarantine_tokens_before=$rg_quarantine_tokens_before,@x309_preserved_before=$rg_preserved_before
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_source_handoff_pending_epochs')
         =@x309_handoff_before AS no_handoff_pending,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_source_commit_unknown_epochs')
         =@x309_unknown_before AS no_commit_unknown_before_terminal_boundary;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_epochs')
         =@x309_quarantine_epochs_before AS no_commit_quarantine_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_tokens')
         =@x309_quarantine_tokens_before AS no_commit_quarantine_token;
--replace_result $rg_waiter_connection_id WAITER_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_timeout FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$rg_waiter_connection_id
SELECT COUNT(*)=@x309_preserved_before+1 AS one_fenced_source_token
  FROM performance_schema.preserved_transactions;
--disable_query_log

# No terminal ownership fact exists, but the timeout result is uncertain.  The
# ordinary owner remains fenced until the explicit source restore operation.
--connection xfer2_x309_owner
--enable_query_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT balance FROM xfer2_w01_accounts WHERE id=3;
--disable_query_log

# The watchdog resumes mysqld.2 after the transport deadline.  Its queued frame
# may be admitted after the source has timed out, but it must not publish a
# prepared/READY token or admit COMMIT_EPOCH.
--connection xfer2_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
         =@online_at_phase1 AS receiver_epoch_unchanged_after_timeout,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@active_before AS no_committed_receiver_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
         =@saved_before AS no_saved_receiver_token;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         >@admitted_at_phase1 AS late_final_metadata_frame_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@prepared_at_phase1 AS no_final_metadata_prepared_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         =@prepared_ready_before AS no_ready_precommit_token;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_before AS timeout_created_no_terminal_cas,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_terminal_status_tombstones')
         =@tombstones_before AS timeout_created_no_tombstone,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@inflight_tokens_at_phase1 AS phase1_inflight_token_unchanged;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         >@inflight_bytes_at_phase1 AS final_metadata_bytes_retained,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         >@staged_at_phase1 AS final_metadata_staging_retained,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         =@memory_at_phase1 AS phase1_preserve_memory_unchanged;
SELECT COUNT(*)=65 AND SUM(v)=70225
         AS receiver_native_commit_survives_process_pause
  FROM xfer2_x309_receiver_native;
--disable_query_log
SET @admitted_after_timeout=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @inflight_tokens_after_timeout=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_after_timeout=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_after_timeout=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @prepared_after_timeout=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @memory_after_timeout=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');

# I02: RESET is the explicit pre-COMMIT restore operation.  It must not invent
# a receiver terminal fact or mutate the receiver's process-local residue.
--connect(xfer2_x309_reset,localhost,preserve_trx_ha_admin,xfer2-smoke-w01-secret,test)
RESET DRAIN;

--connection xfer2_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         =@admitted_after_timeout AS reset_sent_no_receiver_frame,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@active_before AS reset_sent_no_commit_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_before AS reset_sent_no_terminal_cas;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@inflight_tokens_after_timeout AS reset_kept_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         =@inflight_bytes_after_timeout AS reset_kept_inflight_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@staged_after_timeout AS reset_kept_staged_payload;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@prepared_after_timeout AS reset_kept_prepared_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         =@memory_after_timeout AS reset_kept_preserve_memory;
--disable_query_log

# The same owner regains its old ReadView, writes, and record lock.  Explicit
# ROLLBACK releases the waiter exactly once.
--connection xfer2_x309_owner
--replace_result $rg_owner_connection_id OWNER_ID
--enable_query_log
--eval SELECT CONNECTION_ID()=$rg_owner_connection_id AS original_owner_connection_restored
SELECT balance=1000 AND version=0 AS owner_rr_survives_timeout
  FROM xfer2_w01_accounts WHERE id=32;
SELECT SUM(balance)=3000 AND SUM(version)=3
         AS owner_writes_survive_timeout
  FROM xfer2_w01_accounts WHERE id IN (3,7,11);
SELECT COUNT(*)=1 AND SUM(delta)=0 AS owner_audit_survives_timeout
  FROM xfer2_w01_audit WHERE account_id=3;
UPDATE xfer2_w01_accounts
   SET pad=CONCAT(pad,'-after-x309-timeout') WHERE id=11;
SELECT ROW_COUNT()=1 AS owner_can_continue_after_timeout;
ROLLBACK;
--disable_query_log

--connection xfer2_x309_waiter
--reap

--connection xfer2_x309_outsider
--enable_query_log
SELECT COUNT(*)=32 AND SUM(balance)=32007 AND SUM(version)=2
         AS source_commits_only_outsider_and_waiter
  FROM xfer2_w01_accounts;
SELECT MAX(CASE WHEN id=3 THEN balance END)=1006
         AND MAX(CASE WHEN id=32 THEN balance END)=1001
         AS source_exact_committed_rows
  FROM xfer2_w01_accounts WHERE id IN (3,32);
SELECT COUNT(*)=0 AS owner_audit_rolled_back FROM xfer2_w01_audit;
--disable_query_log

--connection xfer2_source_ha
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--disconnect xfer2_x309_owner
--disconnect xfer2_x309_outsider
--disconnect xfer2_x309_waiter
--disconnect xfer2_x309_drain
--disconnect xfer2_x309_reset

# Restart both processes to prove the final native state and leave the harness
# with no process-local transfer residue.
--connection xfer2_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(xfer2_x309_cleanup,localhost,root,,test)
--enable_query_log
SELECT COUNT(*)=32 AND SUM(balance)=32007 AND SUM(version)=2
         AS source_native_state_survives_restart
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS no_owner_audit_after_restart FROM xfer2_w01_audit;
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
DROP TABLE xfer2_w01_audit;
DROP TABLE xfer2_w01_accounts;
DROP USER xfer2_w01_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
DROP USER preserve_trx_ha_admin@localhost;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--exec echo "restart:" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
--enable_query_log
SELECT COUNT(*)=65 AND SUM(v)=70225
         AS receiver_native_state_survives_restart
  FROM xfer2_x309_receiver_native;
--disable_query_log
DROP TABLE xfer2_x309_receiver_native;

--connection xfer2_x309_cleanup
--remove_file $credential_file
--error 1
--file_exists $credential_file

--enable_query_log

SET @x902_owner_continued_ok=
(SELECT COUNT(*)=1 AND SUM(total)=195 AND SUM(version)=2
AND SUM(status='READY')=1 FROM xfer2_x902_orders)
AND
(SELECT COUNT(*)=3 AND SUM(qty)=9 AND SUM(qty*unit_price)=195
AND SUM(status='ALLOCATED')=3
FROM xfer2_x902_order_items)
AND
(SELECT COUNT(*)=24 AND SUM(stock)=2391 AND SUM(allocated)=9
AND SUM(version)=3 FROM xfer2_x902_inventory)
AND
(SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
AND SUM(sku_id=13 AND stock=96 AND allocated=4 AND version=1)=1
FROM xfer2_x902_inventory)
AND
(SELECT COUNT(*)=0
FROM xfer2_x902_order_items oi
LEFT JOIN xfer2_x902_orders o ON o.order_id=oi.order_id
LEFT JOIN xfer2_x902_inventory i ON i.sku_id=oi.sku_id
WHERE o.order_id IS NULL OR i.sku_id IS NULL);
SELECT COUNT(*)=1 AND SUM(total)=195 AND SUM(version)=2
AS owner_w02_order_continued_once
FROM xfer2_x902_orders;
owner_w02_order_continued_once
1
SELECT COUNT(*)=3 AND SUM(qty)=9 AND SUM(qty*unit_price)=195
AS owner_w02_items_continued_once
FROM xfer2_x902_order_items;
owner_w02_items_continued_once
1
SELECT COUNT(*)=24 AND SUM(stock)=2391 AND SUM(allocated)=9
AND SUM(version)=3 AS owner_w02_inventory_continued_once
FROM xfer2_x902_inventory;
owner_w02_inventory_continued_once
1
SELECT SUM(sku_id=3 AND stock=98 AND allocated=2 AND version=1)=1
AND SUM(sku_id=7 AND stock=97 AND allocated=3 AND version=1)=1
AND SUM(sku_id=11 AND stock=100 AND allocated=0 AND version=0)=1
AND SUM(sku_id=13 AND stock=96 AND allocated=4 AND version=1)=1
AS owner_w02_inventory_rows_continued_once
FROM xfer2_x902_inventory;
owner_w02_inventory_rows_continued_once
1
ROLLBACK;
SELECT COUNT(*)=32 AS thirty_two_accounts,
SUM(balance)=32001 AS committed_background_balance,
SUM(version)=1 AS one_committed_background_version,
MAX(CASE WHEN id=32 THEN balance END)=1001 AS background_update_visible,
MAX(CASE WHEN id=3 THEN version END)=0 AS owner_updates_hidden
FROM xfer2_w01_accounts;
thirty_two_accounts	committed_background_balance	one_committed_background_version	background_update_visible	owner_updates_hidden
1	1	1	1	1
SELECT COUNT(*)=0 AS no_committed_audit FROM xfer2_w01_audit;
no_committed_audit
1
CHECK TABLE xfer2_w01_accounts,xfer2_w01_audit;
Table	Op	Msg_type	Msg_text
test.xfer2_w01_accounts	check	status	OK
test.xfer2_w01_audit	check	status	OK
SET @x902_after_rollback_ok=
(SELECT COUNT(*)=0 FROM xfer2_x902_orders)
AND (SELECT COUNT(*)=0 FROM xfer2_x902_order_items)
AND
(SELECT COUNT(*)=24 AND MIN(stock)=100 AND MAX(stock)=100
AND SUM(allocated<>0 OR version<>0)=0
FROM xfer2_x902_inventory);
SELECT (SELECT COUNT(*) FROM xfer2_x902_orders)=0
AND (SELECT COUNT(*) FROM xfer2_x902_order_items)=0
AS owner_w02_order_and_items_rolled_back;
owner_w02_order_and_items_rolled_back
1
SELECT COUNT(*)=24 AND MIN(stock)=100 AND MAX(stock)=100
AND SUM(allocated<>0 OR version<>0)=0
AS owner_w02_inventory_rolled_back
FROM xfer2_x902_inventory;
owner_w02_inventory_rolled_back
1
CHECK TABLE xfer2_x902_inventory,xfer2_x902_orders,
xfer2_x902_order_items;
Table	Op	Msg_type	Msg_text
test.xfer2_x902_inventory	check	status	OK
test.xfer2_x902_orders	check	status	OK
test.xfer2_x902_order_items	check	status	OK
DROP TABLE xfer2_x902_order_items,xfer2_x902_orders,
xfer2_x902_inventory;

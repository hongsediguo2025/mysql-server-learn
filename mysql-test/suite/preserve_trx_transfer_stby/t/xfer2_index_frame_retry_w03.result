CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
CALL mtr.add_suppression(".*Got an error reading communication packets.*");
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=120000;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=120000;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;
SELECT @@GLOBAL.rds_preserve_trx_transfer_runtime_profile='BUSINESS_FIRST'
         AS source_business_first_profile,
@@GLOBAL.rds_preserve_trx_transfer_max_inflight_bytes=64*1024*1024
AS source_inflight_budget;
source_business_first_profile	source_inflight_budget
1	1
SET SESSION cte_max_recursion_depth=3000;
DROP TABLE IF EXISTS xfer2_x903_indexed;
DROP TABLE IF EXISTS xfer2_x903_source_native;
CREATE TABLE xfer2_x903_indexed(
id INT PRIMARY KEY,
business_key VARCHAR(32) NOT NULL,
bucket INT NOT NULL,
score BIGINT NOT NULL,
payload VARBINARY(1536) NOT NULL,
UNIQUE KEY uk_business(business_key),
KEY idx_bucket_score(bucket,score,id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x903_indexed
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<2048
)
SELECT n,CONCAT('biz-',LPAD(n,5,'0')),MOD(n,17),n*10,
REPEAT(CHAR(65+MOD(n,26)),512)
FROM seq;
CREATE TABLE xfer2_x903_source_native(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_x903_source_native VALUES(1,100),(2,200);
START TRANSACTION;
UPDATE xfer2_x903_source_native SET v=v+id;
INSERT INTO xfer2_x903_source_native VALUES(3,300);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=603 AS source_native_commit_before_retry
FROM xfer2_x903_source_native;
source_native_commit_before_retry
1
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SELECT @@GLOBAL.rds_preserve_trx_transfer_runtime_profile='BUSINESS_FIRST'
         AS receiver_business_first_profile,
@@GLOBAL.rds_preserve_trx_transfer_max_inflight_bytes=64*1024*1024
AS receiver_inflight_budget;
receiver_business_first_profile	receiver_inflight_budget
1	1
DROP TABLE IF EXISTS xfer2_x903_receiver_native;
CREATE TABLE xfer2_x903_receiver_native(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;

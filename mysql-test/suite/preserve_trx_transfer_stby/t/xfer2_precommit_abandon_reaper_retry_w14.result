'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @abandon_deferred_before=(SELECT VARIABLE_VALUE+0
FROM performance_schema.global_status WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_precommit_abandon_cleanup_deferred');
SET @reaper_attempts_before=(SELECT VARIABLE_VALUE+0
FROM performance_schema.global_status WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_precommit_abandon_reaper_attempts');
SET @reaper_completions_before=(SELECT VARIABLE_VALUE+0
FROM performance_schema.global_status WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_precommit_abandon_reaper_completions');
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS owner_rr_initial
FROM xfer2_w01_accounts WHERE id=32;
owner_rr_initial
1
UPDATE xfer2_w01_accounts
SET balance=balance-17, version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_debit;
owner_debit
1
UPDATE xfer2_w01_accounts
SET balance=balance+9, version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_partial_credit;
owner_partial_credit
1
UPDATE xfer2_w01_accounts
SET balance=balance+8, version=version+1 WHERE id=3;
SELECT ROW_COUNT()=1 AS owner_balance_restored;
owner_balance_restored
1
INSERT INTO xfer2_w01_audit(account_id,delta) VALUES(3,0);
SELECT ROW_COUNT()=1 AS owner_audit_inserted;
owner_audit_inserted
1
UPDATE xfer2_w01_accounts
SET balance=balance+1, version=version+1 WHERE id=32;
SELECT ROW_COUNT()=1 AS outsider_commit;
outsider_commit
1
SELECT balance=1000 AND version=0 AS owner_rr_stays_old
FROM xfer2_w01_accounts WHERE id=32;
owner_rr_stays_old
1
SELECT balance=1000 AND version=3 AS owner_sees_three_updates
FROM xfer2_w01_accounts WHERE id=3;
owner_sees_three_updates
1
SELECT COUNT(*)=32 AS thirty_two_accounts,
SUM(balance)=32001 AS committed_background_balance,
SUM(version)=1 AS one_committed_background_version,
MAX(CASE WHEN id=32 THEN balance END)=1001 AS background_update_visible,
MAX(CASE WHEN id=3 THEN version END)=0 AS owner_updates_hidden
FROM xfer2_w01_accounts;
thirty_two_accounts	committed_background_balance	one_committed_background_version	background_update_visible	owner_updates_hidden
1	1	1	1	1
SELECT COUNT(*)=0 AS no_committed_audit FROM xfer2_w01_audit;
no_committed_audit
1
SET DEBUG_SYNC=
'preserve_trx_after_final_metadata_accepted_local SIGNAL xfer2_abandon_final_local WAIT_FOR xfer2_abandon_release';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC='now WAIT_FOR xfer2_abandon_final_local TIMEOUT 60';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
= @active_before AS no_commit_admission_at_pause,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
> @inflight_tokens_before AS staged_token_is_accounted,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
> @inflight_bytes_before AS staged_bytes_are_accounted,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
> @staged_memory_before AS real_payload_is_staged;
no_commit_admission_at_pause	staged_token_is_accounted	staged_bytes_are_accounted	real_payload_is_staged
1	1	1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
= @terminal_wins_before AS no_terminal_cas_before_reset,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_terminal_status_tombstones')
= @terminal_tombstones_before AS no_tombstone_before_reset;
no_terminal_cas_before_reset	no_tombstone_before_reset
1	1
RESET DRAIN;
SET DEBUG_SYNC='now SIGNAL xfer2_abandon_release';
ERROR HY000: DRAIN TRANSACTIONS PRESERVE was reset before ownership became irreversible
SET DEBUG_SYNC='RESET';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_precommit_abandon_cleanup_deferred')
> @abandon_deferred_before AS foreground_cleanup_was_deferred,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_precommit_abandon_reaper_attempts')
> @reaper_attempts_before AS reaper_claimed_abandoning_epoch,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_recv_precommit_abandon_reaper_completions')
= @reaper_completions_before+1 AS reaper_completed_cleanup_once;
foreground_cleanup_was_deferred	reaper_claimed_abandoning_epoch	reaper_completed_cleanup_once
1	1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
= @terminal_wins_before+1 AS abandon_terminal_cas_won_once,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_terminal_cas_duplicates')
= @terminal_duplicates_before+2
AS exact_sender_retry_and_reaper_reentry,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_terminal_cas_conflicts')
= @terminal_conflicts_before AS duplicate_abandon_is_not_conflict,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_terminal_status_tombstones')
= @terminal_tombstones_before+1 AS one_bounded_terminal_tombstone,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
= @active_before AS no_committed_receiver_epoch;
abandon_terminal_cas_won_once	exact_sender_retry_and_reaper_reentry	duplicate_abandon_is_not_conflict	one_bounded_terminal_tombstone	no_committed_receiver_epoch
1	1	1	1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status

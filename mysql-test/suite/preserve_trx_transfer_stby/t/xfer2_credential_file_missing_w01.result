credential_variant=oversized
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*)=1 AS waiter_still_blocked_after_oversized_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_still_blocked_after_oversized_credential
1
SELECT SUM(id=2 AND balance=995 AND version=1)=1
AND SUM(id=5 AND balance=1002 AND version=1)=1
AND SUM(id=9 AND balance=1003 AND version=1)=1
AND MAX(CASE WHEN id=32 THEN balance END)=1000
AS owner_state_after_oversized_credential
FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
owner_state_after_oversized_credential
1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
=@receiver_admitted_before AS no_frame_admitted,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
=@receiver_active_before AS no_receiver_epoch,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
=@receiver_inflight_tokens_before AS no_inflight_token,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
=@receiver_inflight_bytes_before AS no_inflight_byte,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
=@receiver_staged_before AS no_staged_memory;
no_frame_admitted	no_receiver_epoch	no_inflight_token	no_inflight_byte	no_staged_memory
1	1	1	1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
=@receiver_terminal_before AS no_terminal_fact,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
=@receiver_prepared_before AS no_prepared_entry;
no_terminal_fact	no_prepared_entry
1	1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
=@receiver_extra_admitted_bytes_before AS no_admitted_byte,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_cleanup_debt_tokens')
=@receiver_extra_cleanup_debt_tokens_before AS no_cleanup_debt,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
=@receiver_extra_cleanup_debt_bytes_before AS no_cleanup_debt_byte,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_terminal_status_tombstones')
=@receiver_extra_tombstones_before AS no_terminal_tombstone,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_promotion_prepared_prewarm_pending_tokens')
=@receiver_extra_prepared_pending_before AS no_prepared_pending,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
=@receiver_extra_prepared_ready_before AS no_prepared_ready,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
=@receiver_extra_ready_cache_before AS no_ready_cache,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
=@receiver_extra_memory_before AS no_preserve_memory;
no_admitted_byte	no_cleanup_debt	no_cleanup_debt_byte	no_terminal_tombstone	no_prepared_pending	no_prepared_ready	no_ready_cache	no_preserve_memory
1	1	1	1	1	1	1	1
SELECT VARIABLE_VALUE=0 AS no_active_receiver_worker
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active';
no_active_receiver_worker
1
SELECT VARIABLE_VALUE=0 AS no_receiver_queue
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes';
no_receiver_queue
1
START TRANSACTION;
UPDATE xfer2_missing_receiver_native SET v=v+id;
COMMIT;
SELECT SUM(v)=53 AS receiver_native_dml_works
FROM xfer2_missing_receiver_native;
receiver_native_dml_works
1
SELECT CONNECTION_ID() AS same_owner_connection_after_missing_secret;
same_owner_connection_after_missing_secret
OWNER_ID
SELECT balance=1000 AND version=0 AS owner_rr_survives_missing_secret
FROM xfer2_missing_accounts WHERE id=32;
owner_rr_survives_missing_secret
1
SELECT SUM(id=2 AND balance=995 AND version=1)=1
AND SUM(id=5 AND balance=1002 AND version=1)=1
AND SUM(id=9 AND balance=1003 AND version=1)=1
AS owner_updates_survive_drain_failure
FROM xfer2_missing_accounts WHERE id IN (2,5,9);
owner_updates_survive_drain_failure
1
SELECT COUNT(*)=3 AND SUM(delta)=0
AS owner_audit_survives_drain_failure
FROM xfer2_missing_audit;
owner_audit_survives_drain_failure
1
SELECT SUM(id IN (2,5,9) AND version<>0)=0
AS owner_changes_still_isolated_after_drain_failure
FROM xfer2_missing_accounts;
owner_changes_still_isolated_after_drain_failure
1
SELECT COUNT(*)=0 AS owner_audit_still_isolated_after_drain_failure
FROM xfer2_missing_audit;
owner_audit_still_isolated_after_drain_failure
1
UPDATE xfer2_missing_accounts SET pad=CONCAT(pad,'-continued') WHERE id=9;
SELECT ROW_COUNT()=1 AS owner_can_continue_dml;
owner_can_continue_dml
1
ROLLBACK;
SELECT COUNT(*)=32 AS final_row_count,
SUM(balance)=32019 AS outsider_and_waiter_balance_once,
SUM(version)=2 AS outsider_and_waiter_versions_once,
SUM(id IN (2,32) AND version>0)=2 AS exact_changed_rows,
SUM(id IN (5,9) AND version<>0)=0 AS owner_updates_rolled_back,
MAX(CASE WHEN id=2 THEN balance END)=1010
AND MAX(CASE WHEN id=2 THEN version END)=1
AS waiter_update_persisted_once,
MAX(CASE WHEN id=9 THEN pad END)='missing-9'
         AS continued_owner_dml_rolled_back
FROM xfer2_missing_accounts;
final_row_count	outsider_and_waiter_balance_once	outsider_and_waiter_versions_once	exact_changed_rows	owner_updates_rolled_back	waiter_update_persisted_once	continued_owner_dml_rolled_back
1	1	1	1	1	1	1
SELECT COUNT(*)=0 AS owner_audit_rolled_back FROM xfer2_missing_audit;
owner_audit_rolled_back
1
CHECK TABLE xfer2_missing_accounts,xfer2_missing_audit;
Table	Op	Msg_type	Msg_text
test.xfer2_missing_accounts	check	status	OK
test.xfer2_missing_audit	check	status	OK
include/assert_grep.inc [invalid credential files stayed on the pre-TCP path]
include/assert_grep.inc [every invalid credential used the frame-sink failure stage]
include/assert_grep.inc [insecure credential content is absent from source error log]
include/assert_grep.inc [oversized credential content is absent from source error log]
SELECT SUM(balance)=32019 AND SUM(version)=2
AS source_restart_keeps_outsider_and_waiter
FROM xfer2_missing_accounts;
source_restart_keeps_outsider_and_waiter
1
SELECT COUNT(*)=0 AS source_restart_keeps_owner_rollback
FROM xfer2_missing_audit;
source_restart_keeps_owner_rollback
1
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=0
AS no_receiver_epoch_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=0
AS no_inflight_token_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=0
AS no_inflight_byte_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_transfer_receiver_staged_memory_bytes')=0
AS no_staged_memory_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=0
AS no_prepared_entry_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME=
'Preserve_trx_promotion_prepared_prewarm_pending_tokens')=0
AS no_prewarm_pending_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=0
AS no_prepared_ready_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')=0
AS no_ready_cache_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')=0
AS no_preserve_memory_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
AS no_active_worker_after_restart,
(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
AS no_queued_byte_after_restart;

CREATE TABLE xfer2_missing_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_missing_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_missing_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n,1000,0,CONCAT('missing-',n) FROM seq;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS owner_rr_initial
FROM xfer2_missing_accounts WHERE id=32;
owner_rr_initial
1
SELECT balance=1000 AND version=0 AS owner_rr_repeatable
FROM xfer2_missing_accounts WHERE id=32;
owner_rr_repeatable
1
SELECT COUNT(*)=32 AS outsider_row_count,
SUM(balance)=32009 AS outsider_sees_background_only,
SUM(version)=1 AS outsider_hides_owner_versions,
SUM(id IN (2,5,9) AND version<>0)=0 AS owner_rows_not_dirty
FROM xfer2_missing_accounts;
outsider_row_count	outsider_sees_background_only	outsider_hides_owner_versions	owner_rows_not_dirty
1	1	1	1
SELECT COUNT(*)=0 AS owner_audit_not_dirty FROM xfer2_missing_audit;
owner_audit_not_dirty
1
SELECT COUNT(*)=1 AS waiter_blocked_before_credential_matrix FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_blocked_before_credential_matrix
1
credential_variant=missing
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*)=1 AS waiter_still_blocked_after_missing_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_still_blocked_after_missing_credential
1
SELECT SUM(id=2 AND balance=995 AND version=1)=1
AND SUM(id=5 AND balance=1002 AND version=1)=1
AND SUM(id=9 AND balance=1003 AND version=1)=1
AND MAX(CASE WHEN id=32 THEN balance END)=1000
AS owner_state_after_missing_credential
FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
owner_state_after_missing_credential
1
credential_variant=insecure_mode
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*)=1 AS waiter_still_blocked_after_insecure_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_still_blocked_after_insecure_credential
1
SELECT SUM(id=2 AND balance=995 AND version=1)=1
AND SUM(id=5 AND balance=1002 AND version=1)=1
AND SUM(id=9 AND balance=1003 AND version=1)=1
AND MAX(CASE WHEN id=32 THEN balance END)=1000
AS owner_state_after_insecure_credential
FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
owner_state_after_insecure_credential
1
credential_variant=empty
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*)=1 AS waiter_still_blocked_after_empty_credential FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=WAITER_ID;
waiter_still_blocked_after_empty_credential
1
SELECT SUM(id=2 AND balance=995 AND version=1)=1
AND SUM(id=5 AND balance=1002 AND version=1)=1
AND SUM(id=9 AND balance=1003 AND version=1)=1
AND MAX(CASE WHEN id=32 THEN balance END)=1000
AS owner_state_after_empty_credential
FROM xfer2_missing_accounts WHERE id IN (2,5,9,32);
owner_state_after_empty_credential

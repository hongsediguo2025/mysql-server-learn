START TRANSACTION;
UPDATE xfer2_auth_receiver_native SET v=v+1 WHERE id=1;
COMMIT;
SELECT v=11 AS receiver_native_dml_works
FROM xfer2_auth_receiver_native WHERE id=1;
receiver_native_dml_works
1
SELECT CONNECTION_ID() AS same_owner_connection_after_rejection;
same_owner_connection_after_rejection
OWNER_ID
SELECT balance=1000 AND version=0 AS owner_rr_survives_rejection
FROM xfer2_auth_accounts WHERE id=32;
owner_rr_survives_rejection
1
UPDATE xfer2_auth_accounts SET pad=CONCAT(pad,'-continued') WHERE id=11;
SELECT ROW_COUNT()=1 AS owner_can_continue_dml;
owner_can_continue_dml
1
COMMIT;
SELECT COUNT(*)=32 AS final_row_count,
SUM(balance)=32011 AS final_balance_once,
SUM(version)=5 AS final_version_once,
SUM(id IN (3,7,11,32) AND version>0)=4 AS exact_changed_rows,
MAX(CASE WHEN id=3 THEN version END)=2 AS waiter_ran_once,
MAX(CASE WHEN id=11 THEN pad END)='account-11-continued'
         AS continued_owner_dml_persisted
FROM xfer2_auth_accounts;
final_row_count	final_balance_once	final_version_once	exact_changed_rows	waiter_ran_once	continued_owner_dml_persisted
1	1	1	1	1	1
SELECT COUNT(*)=1 AND SUM(delta)=0 AS one_owner_audit
FROM xfer2_auth_audit;
one_owner_audit
1

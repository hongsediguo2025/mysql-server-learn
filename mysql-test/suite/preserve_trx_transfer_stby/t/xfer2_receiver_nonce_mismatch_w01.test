# X1-09 / W01 / O01 / O02 / T1 debug-contract
# Pause the DRAIN owner after OPEN_EPOCH has returned its process-bound ACK but
# before DECLARE_TOKEN/any next frame. Restart mysqld.2, then release the old
# source session. Its old TCP connection and old-nonce frame must fail closed;
# the new receiver generation must never publish the old epoch READY (I09).
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc
CALL mtr.add_suppression(".*Got an error reading communication packets.*");
CALL mtr.add_suppression(
  "PRESERVE: standby transfer client send failed errno=");
CALL mtr.add_suppression(
  "PRESERVE: standby transfer source epoch abort failed status=9");

--connection xfer2_receiver
--disable_warnings
DROP TABLE IF EXISTS xfer2_nonce_receiver_native;
--enable_warnings
CREATE TABLE xfer2_nonce_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO xfer2_nonce_receiver_native VALUES(1,40),(2,60);

SET @admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @admitted_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_bytes');
SET @active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @pending_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');
--let $receiver_uuid_before= query_get_value(SELECT @@GLOBAL.server_uuid AS value,value,1)

# RED projection contract: receiver_boot_incarnation() is not exposed directly.
# Project only a nonzero uint64 fingerprint; never expose the raw boot nonce.
--let $receiver_generation_before= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_process_generation',value,1)

--let $rg_control_connection= xfer2_source_ha
--let $rg_owner_connection= xfer2_nonce_owner
--let $rg_outsider_connection= xfer2_nonce_outsider
--let $rg_waiter_connection= xfer2_nonce_waiter
--let $rg_outsider_id= 32
--let $rg_outsider_delta= 1
--let $rg_expected_committed_balance= 32001
--let $rg_expected_committed_versions= 1
--source suite/preserve_trx_transfer_stby/include/run_receiver_generation_w01.inc

# RED control contract: the production source currently has no DEBUG_SYNC at
# this exact boundary. Add only the narrow hook below in sql/preserve_trx.cc,
# immediately after source_epoch_session->open_epoch() returns OK and before
# set_phase1_metrics_enabled()/DECLARE_TOKEN. Do not move this to pre-OPEN or
# post-DECLARE, either of which would test a different generation race.
--connect(xfer2_nonce_drain,localhost,root,,test)
SET @nonce_drain_started=NOW(6);
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_open_epoch_ack_before_first_frame SIGNAL xfer2_nonce_open_acked WAIT_FOR xfer2_nonce_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_nonce_open_acked TIMEOUT 60';

# DEBUG_SYNC timeout is only a warning. Make this an explicit fail-hard phase
# boundary so an absent or misplaced hook cannot let a completed DRAIN green.
--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')=@admitted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@active_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@prepared_before
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc

# OPEN has completed on a real authenticated TCP session. No sequence-tracked
# frame may have reached admission, staging, prepared state, READY cache, debt,
# worker, or queue at this boundary.
--connection xfer2_receiver
--enable_query_log
SELECT COUNT(*)>=1 AS authenticated_open_transport_exists
  FROM performance_schema.threads
 WHERE PROCESSLIST_USER='preserve_trx_ha_admin'
   AND PROCESSLIST_COMMAND='Sleep';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
         =@admitted_before AS no_post_open_frame_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
         =@admitted_bytes_before AS no_post_open_byte_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@active_before AS no_committed_epoch_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
         =@terminal_before AS no_terminal_cas_after_open;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@inflight_tokens_before AS no_inflight_token_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
         =@inflight_bytes_before AS no_inflight_byte_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@staged_before AS no_staged_memory_after_open;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@prepared_before AS no_prepared_token_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_promotion_prepared_prewarm_pending_tokens')
         =@pending_before AS no_prewarm_pending_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         =@prepared_ready_before AS no_prepared_ready_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
         =@ready_cache_before AS no_ready_cache_after_open;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
          'Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         =@debt_tokens_before AS no_cleanup_debt_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         =@debt_bytes_before AS no_cleanup_debt_bytes_after_open,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         =@memory_before AS no_preserve_memory_after_open;
--disable_query_log
--let $receiver_connection= xfer2_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_quiescent.inc

# RED status contract: active_epochs counts terminal accepted epochs and cannot
# prove an OPEN-only context. A dedicated online-epoch projection must report 1.
--enable_query_log
SELECT COUNT(*)=1 AND COALESCE(MAX(VARIABLE_VALUE+0),-1)=1
         AS exactly_one_open_epoch_before_restart
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs';
--disable_query_log
--let $receiver_generation_at_open= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_process_generation',value,1)

# Restart while the source retains the old ACK nonce and before it stamps/sends
# DECLARE_TOKEN. The receiver user and native table persist in the same datadir,
# but all process-local transfer state must start empty in the new generation.
--exec echo "restart:" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--let $receiver_generation_after= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_process_generation',value,1)
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
--source suite/preserve_trx_transfer_stby/include/assert_receiver_never_admitted.inc
--disable_query_log
--eval SELECT @@GLOBAL.server_uuid='$receiver_uuid_before' AS same_receiver_datadir_new_process
--enable_query_log
SELECT COUNT(*)=2 AND SUM(v)=100 AS receiver_native_data_survives_restart
  FROM xfer2_nonce_receiver_native;
START TRANSACTION;
UPDATE xfer2_nonce_receiver_native SET v=v+id;
INSERT INTO xfer2_nonce_receiver_native VALUES(3,30);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=133 AS receiver_native_dml_works_new_generation
  FROM xfer2_nonce_receiver_native;
--disable_query_log

# Release the source. A reused connection fails or a fresh session connects to
# the new process, but either route carries the nonce cached by the old OPEN.
# The old epoch/frame must be rejected before sequence admission or staging.
--connection xfer2_source_ha
SET DEBUG_SYNC='now SIGNAL xfer2_nonce_release';

--connection xfer2_nonce_drain
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
SET DEBUG_SYNC='RESET';
--enable_query_log
SELECT TIMESTAMPDIFF(MICROSECOND,@nonce_drain_started,NOW(6))
         BETWEEN 0 AND 120000000 AS nonce_mismatch_failure_bounded;
--disable_query_log

--connection xfer2_receiver
--let $receiver_connection= xfer2_receiver
--source suite/preserve_trx_transfer_stby/include/assert_receiver_quiescent.inc
--source suite/preserve_trx_transfer_stby/include/assert_receiver_restart_clean.inc
--source suite/preserve_trx_transfer_stby/include/assert_receiver_never_admitted.inc
--enable_query_log
SELECT COUNT(*)=3 AND SUM(v)=133
         AS rejected_old_frame_did_not_damage_receiver_native_data
  FROM xfer2_nonce_receiver_native;
--disable_query_log

# The safe projection proves process-generation change without exposing the raw
# nonce; the receiver also records the exact pre-admission rejection reason.
--disable_query_log
--eval SELECT $receiver_generation_before<>0 AS boot_generation_projected,$receiver_generation_at_open<>0 AS open_generation_projected,$receiver_generation_before=$receiver_generation_at_open AS open_ack_bound_to_old_generation,$receiver_generation_after<>0 AS new_generation_projected,$receiver_generation_at_open<>$receiver_generation_after AS receiver_process_generation_changed
--enable_query_log
SELECT COUNT(*)=1 AND COALESCE(MAX(VARIABLE_VALUE+0),0)>=1
         AS old_nonce_frame_rejected
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_nonce_mismatch_rejects';
SELECT COUNT(*)=1 AND MAX(VARIABLE_VALUE)='receiver_process_nonce_mismatch'
         AS exact_identity_reject_reason
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_last_identity_reject_reason';
SELECT COUNT(*)=1 AND COALESCE(MAX(VARIABLE_VALUE+0),-1)=0
         AS new_generation_has_no_old_online_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs';
--disable_query_log

--connection xfer2_source_ha
--replace_result $rg_waiter_connection_id WAITER_ID
--enable_query_log
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_nonce_mismatch FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON t.THREAD_ID=w.REQUESTING_THREAD_ID WHERE t.PROCESSLIST_ID=$rg_waiter_connection_id
--eval SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_frame_count')=$rg_phase1_frames_before AS no_old_nonce_phase1_frame_succeeded,(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_network_send_count')=$rg_phase1_sends_before AS no_old_nonce_phase1_send_succeeded
--eval SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_handoff_pending_epochs')=$rg_handoff_before AS no_handoff_pending_before_commit_boundary,(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')=$rg_unknown_before AS no_commit_unknown_before_commit_boundary
--eval SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_epochs')=$rg_quarantine_epochs_before AS no_quarantine_epoch_before_commit_boundary,(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_tokens')=$rg_quarantine_tokens_before AS no_quarantine_token_before_commit_boundary
--eval SELECT COUNT(*)=$rg_preserved_before AS nonce_mismatch_added_no_preserved_token FROM performance_schema.preserved_transactions
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection xfer2_nonce_owner
--replace_result $rg_owner_connection_id OWNER_ID
--enable_query_log
SELECT CONNECTION_ID() AS same_owner_connection_after_nonce_mismatch;
SELECT balance=1000 AND version=0 AS owner_rr_survives_nonce_mismatch
  FROM xfer2_w01_accounts WHERE id=32;
SELECT SUM(balance)=3000 AND SUM(version)=3
         AS owner_writes_survive_nonce_mismatch
  FROM xfer2_w01_accounts WHERE id IN (3,7,11);
SELECT COUNT(*)=1 AND SUM(delta)=0 AS owner_audit_survives_nonce_mismatch
  FROM xfer2_w01_audit WHERE account_id=3;
UPDATE xfer2_w01_accounts
   SET pad=CONCAT(pad,'-after-nonce') WHERE id=11;
SELECT ROW_COUNT()=1 AS owner_can_continue_dml_after_nonce_mismatch;
--disable_query_log

--connection xfer2_nonce_outsider
--enable_query_log
SELECT SUM(id IN (3,7,11) AND version<>0)=0
         AS owner_changes_remain_isolated_after_nonce_mismatch
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS owner_audit_remains_isolated_after_nonce_mismatch
  FROM xfer2_w01_audit;
--disable_query_log

--connection xfer2_nonce_owner
COMMIT;

--connection xfer2_nonce_waiter
--reap

--connection xfer2_nonce_outsider
--enable_query_log
SELECT COUNT(*)=32 AS final_row_count,
       SUM(balance)=32007 AS final_balance_exactly_once,
       SUM(version)=5 AS final_versions_exactly_once,
       SUM(id IN (3,7,11,32) AND version>0)=4 AS exact_committed_rows,
       MAX(CASE WHEN id=3 THEN balance END)=989 AS waiter_ran_once,
       MAX(CASE WHEN id=11 THEN pad END)='account-11-after-nonce'
         AS continued_owner_dml_committed
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=1 AND SUM(account_id=3)=1 AS one_audit_committed
  FROM xfer2_w01_audit;
CHECK TABLE xfer2_w01_accounts,xfer2_w01_audit;
--disable_query_log

# Normalize the committed owner/waiter rows while retaining the required O01
# outsider commit at id=32 for the shared teardown baseline.
UPDATE xfer2_w01_accounts
   SET balance=1000,version=0,pad=CONCAT('account-',id)
 WHERE id IN (3,7,11);
DELETE FROM xfer2_w01_audit WHERE account_id=3;
--enable_query_log
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
--disable_query_log
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection xfer2_receiver
DROP TABLE xfer2_nonce_receiver_native;
--disconnect xfer2_nonce_waiter
--disconnect xfer2_nonce_outsider
--disconnect xfer2_nonce_owner
--disconnect xfer2_nonce_drain

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

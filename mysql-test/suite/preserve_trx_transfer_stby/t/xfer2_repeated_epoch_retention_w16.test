--disconnect xfer2_x1205_w01_1
--disconnect xfer2_x1205_w05_1
--disconnect xfer2_x1205_w07_1
--disconnect xfer2_x1205_w08_1
--disconnect xfer2_x1205_observer1
--disconnect xfer2_x1205_drain1

# A source-only restart rolls back Epoch B while retaining its receiver epoch,
# terminal tombstone and READY subset in the same receiver process.
--connection xfer2_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer2_smoke_w01 --rds-preserve-trx-transfer-credential-secret-file=$credential_file" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
SET GLOBAL debug='-d,preserve_trx_transfer_drop_commit_ack_twice,preserve_trx_transfer_requery_commit_status_after_debug_sync';

--connect(xfer2_x1205_source_check2,localhost,root,,test)
--enable_query_log
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
SELECT COUNT(*)=0 AS first_w16_inserts_rolled_back
  FROM xfer2_x1205_insert;
SELECT COUNT(*)=8 AND SUM(v)=36 AND SUM(state<>'base')=0
         AS first_w16_savepoint_changes_rolled_back
  FROM xfer2_x1205_savepoint;
SELECT marker=0 AND OCTET_LENGTH(payload)=256*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',256*1024),256)
         AS first_w16_blob_change_rolled_back
  FROM xfer2_x1205_blob WHERE id=1;
--disable_query_log
--disconnect xfer2_x1205_source_check2

--connection xfer2_receiver
--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@x1205_active_before+1
         AS first_epoch_survives_source_restart,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
         =@x1205_failed_before+3
         AS first_failed_subset_remains_receiver_bound,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
         =@x1205_saved_before+1
         AS first_ready_sibling_remains_saved;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
         =@x1205_inflight_tokens_before
         AS first_failed_subset_has_no_inflight_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
         =@x1205_staged_before
         AS first_failed_subset_staging_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         =@x1205_debt_tokens_before
         AS first_failed_subset_has_no_cleanup_debt;
--disable_query_log
START TRANSACTION;
UPDATE xfer2_x1205_receiver_native SET v=v+2 WHERE id=1;
COMMIT;

# Epoch C: the same logical keys on a new source generation must form a new
# receiver epoch and exactly reproduce Epoch B's partition without stale frame,
# lease or terminal reuse.
--let $x1205_epoch_no= 2
--source suite/preserve_trx_transfer_stby/include/x1205_open_w16_epoch.inc

--connect(xfer2_x1205_observer2,localhost,root,,test)
--let $x1205_observer_ok= query_get_value("SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1 AS ok FROM xfer2_w01_accounts",ok,1)
if ($x1205_observer_ok != 1)
{
  --die X12-05 second W16 owner leaked before DRAIN
}

--connect(xfer2_x1205_drain2,localhost,root,,test)
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--enable_query_log
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@x1205_online_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@x1205_active_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@x1205_wins_before+3 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@x1205_tombstones_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@x1205_classified_before+9 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@x1205_ready_before+1+2*@x1205_w16_ready_delta AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@x1205_not_ready_before+2*@x1205_w16_not_ready_delta AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@x1205_saved_before+2*@x1205_w16_ready_delta AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@x1205_prepared_before+2*@x1205_w16_ready_delta AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=@x1205_prepared_ready_before+2*@x1205_w16_ready_delta AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x1205_inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@x1205_inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@x1205_staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@x1205_debt_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=@x1205_debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 60
--source include/wait_condition_or_abort.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@x1205_failed_before+6
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
         =@x1205_ready_before+1+2*@x1205_w16_ready_delta
         AS second_w16_ready_partition_repeated,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
         =@x1205_not_ready_before+2*@x1205_w16_not_ready_delta
         AS second_w16_not_ready_partition_repeated,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@x1205_active_before+2 AS exactly_two_w16_epochs_retained;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
         =@x1205_failed_before+2*@x1205_w16_not_ready_delta
         AS second_failed_partition_receiver_bound;
--replace_result $x1205_w08_id W08_TOKEN
--eval SELECT VARIABLE_VALUE+0=$x1205_w08_id AS second_last_failed_token_is_w08b FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_token'
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_sequence_already_applied')
         =@x1205_sequence_after_expiry AS no_cross_epoch_sequence_reuse,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_terminal_cas_duplicates')
         =@x1205_duplicates_before+1 AS no_w16_terminal_duplicate,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_terminal_cas_conflicts')
         =@x1205_conflicts_before AS no_cross_epoch_terminal_conflict;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_cleanup_debt_tokens')
         =@x1205_debt_tokens_before AS no_cleanup_debt_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_cleanup_debt_bytes')
         =@x1205_debt_bytes_before AS no_cleanup_debt_byte,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_receiver_cleanup_tainted_transitions')
         =@x1205_tainted_before AS no_cleanup_taint;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
         AS second_workers_inactive,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
         AS second_worker_pool_auto_stopped,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
         AS second_queue_drained;
SELECT v=13 AS receiver_native_commits_survive_source_generations
  FROM xfer2_x1205_receiver_native WHERE id=1;
--disable_query_log

--connection xfer2_source_ha
--enable_query_log
SELECT COUNT(*)=4 AS second_exactly_four_preserved,
       SUM(MOD_TABLES_COUNT>=1)=4 AS second_every_token_modified,
       SUM(SESSION_SQL_LOG_BIN='OFF')=3 AS second_three_nobin_tokens,
       SUM(WROTE_TO_CACHE='YES')=1 AS second_one_logged_token,
       SUM(SAVEPOINT_COUNT)=1 AS second_one_live_savepoint,
       SUM(BINLOG_CACHE_SIZE>@@GLOBAL.binlog_cache_size)=1
         AS second_one_spilled_cache
  FROM performance_schema.preserved_transactions;
--disable_query_log


# Shared teardown restarts both servers.  Source recovery must roll back Epoch C
# while preserving the committed background row; receiver restart must clear
# the two retained W16 epochs without losing receiver-native commits.
--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

--connection xfer2_cleanup
--enable_query_log
SELECT COUNT(*)=0 AS second_w16_inserts_rolled_back
  FROM xfer2_x1205_insert;
SELECT COUNT(*)=8 AND SUM(v)=36 AND SUM(state<>'base')=0
         AS second_w16_savepoint_changes_rolled_back
  FROM xfer2_x1205_savepoint;
SELECT marker=0 AND OCTET_LENGTH(payload)=256*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',256*1024),256)
         AS second_w16_blob_change_rolled_back
  FROM xfer2_x1205_blob WHERE id=1;
CHECK TABLE xfer2_x1205_insert,xfer2_x1205_savepoint,xfer2_x1205_blob;
DROP TABLE xfer2_x1205_insert;
DROP TABLE xfer2_x1205_savepoint;
DROP TABLE xfer2_x1205_blob;
--disable_query_log

--connection xfer2_receiver
--enable_query_log
SELECT v=13 AS receiver_native_commits_survive_receiver_restart
  FROM xfer2_x1205_receiver_native WHERE id=1;
DROP TABLE xfer2_x1205_receiver_native;
--disable_query_log

--enable_query_log

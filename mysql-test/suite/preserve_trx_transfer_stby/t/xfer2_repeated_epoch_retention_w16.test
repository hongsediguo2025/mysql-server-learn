--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X12-05 / X9-06 post-COMMIT increment / W16x2 + W04 control /
# O01 / O09 / T1 / I02 / I05 / I06 / I07 / I10 / I11.
#
# Keep one receiver process alive across three independent source generations.
# Epoch A is a single W04 control on the authenticated COMMITTED-status retry
# path.  A receiver-only future clock expires its READY lease and terminal
# tombstone, and every current resource gauge must return to its baseline.
# Epochs B and C then execute the same four-branch W16 workload (W01, W05, W07,
# W08B) against the same logical keys.  Both epochs must reach the same exact
# READY/NOT_READY partition, restart the auto-stopped prewarm pool, avoid stale
# sequence/terminal identity reuse, and create no cleanup debt.  The terminal
# fault is deliberately isolated in Epoch A: coupling it to the W16 epoch would
# consume the fixed prewarm deadline and test deadline expiry, not retention.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

CALL mtr.add_suppression(
  "PRESERVE: standby transfer source entered COMMIT_UNKNOWN");

--disable_query_log

--connection default
--disable_warnings
DROP TABLE IF EXISTS xfer2_x1205_insert;
DROP TABLE IF EXISTS xfer2_x1205_savepoint;
DROP TABLE IF EXISTS xfer2_x1205_blob;
--enable_warnings
CREATE TABLE xfer2_x1205_insert(
  id INT PRIMARY KEY,
  seq_no INT NOT NULL,
  v INT NOT NULL,
  payload VARBINARY(256) NOT NULL,
  UNIQUE KEY uk_seq(seq_no),
  KEY k_v(v)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x1205_savepoint(
  id INT PRIMARY KEY,
  seq_no INT NOT NULL,
  v INT NOT NULL,
  state VARCHAR(24) NOT NULL,
  UNIQUE KEY uk_seq(seq_no),
  KEY k_v(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1205_savepoint
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<8
)
SELECT n,n,n,'base' FROM seq;
CREATE TABLE xfer2_x1205_blob(
  id INT PRIMARY KEY,
  payload LONGBLOB NOT NULL,
  marker INT NOT NULL,
  KEY k_marker(marker)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1205_blob VALUES(1,REPEAT('a',256*1024),0);

# W01/W05/W07 explicitly exercise no-bin branches; only W08B carries a logged
# cache across each mixed epoch.  The background update is the durable source
# reference state across all three source restarts.
GRANT SESSION_VARIABLES_ADMIN ON *.* TO xfer2_w01_app@localhost;
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x1205_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x1205_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1205_receiver_native VALUES(1,10);

# Receiver baselines separate cumulative history from current retained state.
SET @x1205_online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @x1205_active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @x1205_expired_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_expired_epochs');
SET @x1205_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @x1205_duplicates_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_duplicates');
SET @x1205_conflicts_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_conflicts');
SET @x1205_tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @x1205_expiries_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_recv_terminal_tombstone_expiries');
SET @x1205_not_found_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_recv_terminal_status_not_found');
SET @x1205_classified_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @x1205_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @x1205_not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @x1205_failed_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_failed_tokens');
SET @x1205_saved_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_saved_online_tokens');
SET @x1205_sequence_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_sequence_already_applied');
SET @x1205_inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @x1205_inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @x1205_staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @x1205_debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @x1205_debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @x1205_tainted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_tainted_transitions');
SET @x1205_prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @x1205_prepared_pending_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @x1205_prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @x1205_ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @x1205_memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');

# Epoch A: one small W04 READY token follows the normal double-ACK-loss and
# authenticated status-query path.  It is kept separate from W16 so the fixed
# prewarm deadline remains a property of the control token, not of four mixed
# payloads queued behind the fault recovery.
--connection xfer2_source_ha
--let $x1205_old_phase2_timeout= query_get_value(SELECT @@GLOBAL.rds_preserve_trx_drain_phase2_timeout_ms AS v,v,1)
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=5000;

--connect(xfer2_x1205_control_owner,localhost,xfer2_w01_app,,test)
SET SESSION sql_log_bin=0;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
--let $x1205_control_ok= query_get_value("SELECT balance=1000 AND version=0 AS ok FROM xfer2_w01_accounts WHERE id=31",ok,1)
if ($x1205_control_ok != 1)
{
  --die X12-05 expiry-control ReadView baseline is not exact
}
UPDATE xfer2_w01_accounts
   SET balance=balance-19,version=version+1 WHERE id=4;
UPDATE xfer2_w01_accounts
   SET balance=balance+19,version=version+1 WHERE id=5;
INSERT INTO xfer2_w01_audit(account_id,delta) VALUES(4,-19),(5,19);
--let $x1205_control_ok= query_get_value("SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2 AS ok FROM xfer2_w01_accounts WHERE id IN (4,5)",ok,1)
if ($x1205_control_ok != 1)
{
  --die X12-05 expiry-control workload is not exact
}

--connect(xfer2_x1205_control_observer,localhost,root,,test)
--let $x1205_observer_ok= query_get_value("SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1 AS ok FROM xfer2_w01_accounts",ok,1)
if ($x1205_observer_ok != 1)
{
  --die X12-05 expiry-control owner leaked before DRAIN
}

--connect(xfer2_x1205_control_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_committed_status_query SIGNAL xfer2_x1205_status_live WAIT_FOR xfer2_x1205_status_expired TIMEOUT 120';
--send DRAIN TRANSACTIONS PRESERVE

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@x1205_wins_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_duplicates')=@x1205_duplicates_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_conflicts')=@x1205_conflicts_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@x1205_tombstones_before+1
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_x1205_status_live TIMEOUT 30';
--let $x1205_sync_warning_count= query_get_value("SELECT @@warning_count AS c",c,1)
if ($x1205_sync_warning_count != 0)
{
  --die X12-05 authenticated pre-expiry COMMITTED query was not observed
}

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@x1205_active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@x1205_classified_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')=@x1205_ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')=@x1205_not_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@x1205_saved_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@x1205_prepared_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=@x1205_prepared_ready_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

# O09: unrelated receiver-native work commits while the terminal result and
# READY publication are live, and must survive all later source generations.
START TRANSACTION;
UPDATE xfer2_x1205_receiver_native SET v=v+1 WHERE id=1;
COMMIT;

--connection xfer2_source_ha
SET DEBUG_SYNC='now SIGNAL xfer2_x1205_status_expired';

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_recv_terminal_tombstone_expiries')=@x1205_expiries_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_recv_terminal_status_not_found')=@x1205_not_found_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@x1205_tombstones_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@x1205_active_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_expired_epochs')=@x1205_expired_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@x1205_saved_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@x1205_failed_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x1205_inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@x1205_inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@x1205_staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@x1205_debt_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=@x1205_debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_tainted_transitions')=@x1205_tainted_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@x1205_prepared_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens')=@x1205_prepared_pending_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=@x1205_prepared_ready_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')=@x1205_ready_cache_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')=@x1205_memory_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
# Worker retirement is asynchronous to epoch erasure.  Keep it a distinct
# assertion so resource cleanup and pool auto-stop failures stay diagnosable.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--let $wait_timeout= 60
--source include/wait_condition_or_abort.inc
SET @x1205_sequence_after_expiry=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_sequence_already_applied');

--enable_query_log
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_expired_epochs')
         =@x1205_expired_before+1 AS control_epoch_expired_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_recv_terminal_tombstone_expiries')
         =@x1205_expiries_before+1 AS control_tombstone_expired_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME=
         'Preserve_trx_transfer_recv_terminal_status_not_found')
         =@x1205_not_found_before+1 AS authenticated_query_not_found_once;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
         =@x1205_active_before AS expired_epoch_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         =@x1205_prepared_before AS expired_prepared_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
         =@x1205_ready_cache_before AS expired_ready_cache_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
         =@x1205_memory_before AS expired_memory_released;
SELECT v=11 AS receiver_native_commit_during_expiry
  FROM xfer2_x1205_receiver_native WHERE id=1;
--disable_query_log

--connection xfer2_x1205_control_drain
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--connection xfer2_source_ha
--eval SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=$x1205_old_phase2_timeout
--disconnect xfer2_x1205_control_owner
--disconnect xfer2_x1205_control_observer
--disconnect xfer2_x1205_control_drain

# Restart only the source.  The receiver retains its cumulative expiry history
# but no current control-epoch resources.  Disable the one-shot fault hooks in
# the new source and the still-live receiver before the normal W16 epochs.
--connection xfer2_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=xfer2_smoke_w01 --rds-preserve-trx-transfer-credential-secret-file=$credential_file" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
SET GLOBAL debug='-d,preserve_trx_transfer_drop_commit_ack_twice,preserve_trx_transfer_requery_commit_status_after_debug_sync';

--connection xfer2_receiver
SET GLOBAL debug='-d,preserve_trx_receiver_expire_terminal_before_second_status_query';
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;

--connect(xfer2_x1205_source_check1,localhost,root,,test)
--enable_query_log
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
SELECT COUNT(*)=0 AS control_epoch_left_no_audit_rows
  FROM xfer2_w01_audit;
SELECT COUNT(*)=0 AS control_epoch_left_no_insert_rows
  FROM xfer2_x1205_insert;
SELECT COUNT(*)=8 AND SUM(v)=36 AND SUM(state<>'base')=0
         AS control_epoch_left_savepoint_seed
  FROM xfer2_x1205_savepoint;
SELECT marker=0 AND OCTET_LENGTH(payload)=256*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',256*1024),256)
         AS control_epoch_left_blob_seed
  FROM xfer2_x1205_blob WHERE id=1;
--disable_query_log
--disconnect xfer2_x1205_source_check1

# Epoch B: first normal W16 generation.
--let $x1205_epoch_no= 1
--source suite/preserve_trx_transfer_stby/include/x1205_open_w16_epoch.inc

--connect(xfer2_x1205_observer1,localhost,root,,test)
--enable_query_log
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
         AS first_w16_observer_hides_w01
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS first_w16_observer_hides_w05
  FROM xfer2_x1205_insert;
SELECT COUNT(*)=8 AND SUM(v)=36 AND SUM(state<>'base')=0
         AS first_w16_observer_hides_w07
  FROM xfer2_x1205_savepoint;
SELECT marker=0 AND OCTET_LENGTH(payload)=256*1024
         AND SHA2(payload,256)=SHA2(REPEAT('a',256*1024),256)
         AS first_w16_observer_hides_w08b
  FROM xfer2_x1205_blob WHERE id=1;
--disable_query_log

--connect(xfer2_x1205_drain1,localhost,root,,test)
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--enable_query_log
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log

--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@x1205_online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@x1205_active_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')=@x1205_wins_before+2 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')=@x1205_tombstones_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=@x1205_classified_before+5 AND ((SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')-@x1205_ready_before-1)+((SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')-@x1205_not_ready_before)=4 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x1205_inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@x1205_inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@x1205_staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')=@x1205_debt_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')=@x1205_debt_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 60
--source include/wait_condition_or_abort.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')=@x1205_failed_before+3 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')=@x1205_saved_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')=@x1205_prepared_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')=@x1205_prepared_ready_before+1
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
SET @x1205_w16_ready_delta=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
  -@x1205_ready_before-1;
SET @x1205_w16_not_ready_delta=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
  -@x1205_not_ready_before;

--enable_query_log
SELECT @x1205_w16_ready_delta=1 AS first_w16_has_one_ready_sibling,
       @x1205_w16_not_ready_delta=3 AS first_w16_has_three_failed_tokens,
       @x1205_w16_ready_delta+@x1205_w16_not_ready_delta=4
         AS first_w16_partition_exact;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
         -@x1205_failed_before=@x1205_w16_not_ready_delta
         AS first_failed_records_match_not_ready_subset;
--replace_result $x1205_w08_id W08_TOKEN
--eval SELECT VARIABLE_VALUE+0=$x1205_w08_id AS first_last_failed_token_is_w08b FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_token'
SELECT VARIABLE_VALUE='receiver_selection_failed:3'
         AS first_failure_reason_is_prewarm_deadline
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
         -@x1205_saved_before=@x1205_w16_ready_delta
         AS first_saved_subset_exact,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
         -@x1205_prepared_before=@x1205_w16_ready_delta
         AS first_prepared_subset_exact,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
         -@x1205_prepared_ready_before=@x1205_w16_ready_delta
         AS first_prepared_ready_subset_exact;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
         AS first_workers_inactive,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
         AS first_worker_pool_auto_stopped,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
         AS first_queue_drained;
--disable_query_log

--connection xfer2_source_ha
--enable_query_log
SELECT COUNT(*)=4 AS first_exactly_four_preserved,
       SUM(MOD_TABLES_COUNT>=1)=4 AS first_every_token_modified,
       SUM(SESSION_SQL_LOG_BIN='OFF')=3 AS first_three_nobin_tokens,
       SUM(WROTE_TO_CACHE='YES')=1 AS first_one_logged_token,
       SUM(SAVEPOINT_COUNT)=1 AS first_one_live_savepoint,
       SUM(BINLOG_CACHE_SIZE>@@GLOBAL.binlog_cache_size)=1
         AS first_one_spilled_cache
  FROM performance_schema.preserved_transactions;
--disable_query_log

--connection xfer2_x1205_w01_1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer2_x1205_w05_1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer2_x1205_w07_1
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection xfer2_x1205_w08_1
--error ER_PRESERVE_TRX_SESSION_DRAINED

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

# X10-08 / W16 + O01 / O07 / O09 / O10 / T1 debug-contract /
# I02 / I05 / I06 / I10 / I11.
#
# Four real source transactions execute W01, W05, W07, and W08B.  The W01
# owner also holds one record in a separate contention table.  After the W05
# owner has completed its deterministic insert/update/delete model, its next
# command waits for that same record.  DRAIN must not deadlock the epoch: the
# fixed closing deadline excludes only the waiting W05 token and carries the
# other three tokens to the pre-CAS boundary.  RESET then restores those three
# owners and retires every receiver resource.  The W05 waiter must remain
# blocked until the original W01 owner explicitly rolls back, then execute and
# commit exactly once.  Source and receiver restarts prove the final outcome.

--source suite/preserve_trx_transfer_stby/include/w01_setup.inc

--disable_query_log
--connection default
GRANT SESSION_VARIABLES_ADMIN ON *.* TO xfer2_w01_app@localhost;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x1008_contend;
DROP TABLE IF EXISTS xfer2_x1008_insert;
DROP TABLE IF EXISTS xfer2_x1008_savepoint;
DROP TABLE IF EXISTS xfer2_x1008_blob;
--enable_warnings
CREATE TABLE xfer2_x1008_contend(
  id INT PRIMARY KEY,
  bucket INT NOT NULL,
  value_sum INT NOT NULL,
  version INT NOT NULL DEFAULT 0,
  marker VARCHAR(24) NOT NULL DEFAULT 'base',
  KEY k_bucket(bucket,id),
  KEY k_value(value_sum,id)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1008_contend
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n,MOD(n,4),1000+n,0,'base' FROM seq;
CREATE TABLE xfer2_x1008_insert(
  id INT PRIMARY KEY,
  seq_no INT NOT NULL,
  v INT NOT NULL,
  payload VARBINARY(128) NOT NULL,
  UNIQUE KEY uk_seq(seq_no),
  KEY k_v(v)
) ENGINE=InnoDB;
CREATE TABLE xfer2_x1008_savepoint(
  id INT PRIMARY KEY,
  seq_no INT NOT NULL,
  v INT NOT NULL,
  state VARCHAR(24) NOT NULL,
  UNIQUE KEY uk_seq(seq_no),
  KEY k_state(state)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1008_savepoint
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<16
)
SELECT n,n,n,'base' FROM seq;
CREATE TABLE xfer2_x1008_blob(
  id INT PRIMARY KEY,
  payload LONGBLOB NOT NULL,
  marker INT NOT NULL,
  KEY k_marker(marker)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1008_blob VALUES(1,REPEAT('a',256*1024),0);
--connection xfer2_source_ha
--let $x1008_old_phase2_timeout= query_get_value(SELECT @@GLOBAL.rds_preserve_trx_drain_phase2_timeout_ms AS v,v,1)
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=5000;
SET @x1008_reset_wins_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_wins');
SET @x1008_reset_too_late_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_reset_drain_too_late');
SET @x1008_handoff_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_source_handoff_pending_epochs');
SET @x1008_unknown_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_source_commit_unknown_epochs');
SET @x1008_quarantine_epochs_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_quarantine_epochs');
SET @x1008_quarantine_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_quarantine_tokens');
SET @x1008_preserved_before=(SELECT COUNT(*)
  FROM performance_schema.preserved_transactions);

--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
--disable_warnings
DROP TABLE IF EXISTS xfer2_x1008_receiver_native;
--enable_warnings
CREATE TABLE xfer2_x1008_receiver_native(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY k_v(v)
) ENGINE=InnoDB;
INSERT INTO xfer2_x1008_receiver_native VALUES(1,10),(2,20);
SET @x1008_online_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_online_epochs');
SET @x1008_active_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_active_epochs');
SET @x1008_admitted_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_frames');
SET @x1008_admitted_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_admitted_bytes');
SET @x1008_inflight_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_tokens');
SET @x1008_inflight_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_inflight_bytes');
SET @x1008_staged_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_staged_memory_bytes');
SET @x1008_failed_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_failed_tokens');
SET @x1008_saved_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_saved_online_tokens');
SET @x1008_terminal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_wins');
SET @x1008_duplicates_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_duplicates');
SET @x1008_conflicts_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_cas_conflicts');
SET @x1008_tombstones_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_terminal_status_tombstones');
SET @x1008_classified_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_tokens');
SET @x1008_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens');
SET @x1008_not_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens');
SET @x1008_debt_tokens_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_tokens');
SET @x1008_debt_bytes_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_cleanup_debt_bytes');
SET @x1008_prepared_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_registered_tokens');
SET @x1008_prepared_pending_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_prewarm_pending_tokens');
SET @x1008_prepared_ready_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_prepared_ready_tokens');
SET @x1008_ready_cache_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_promotion_ready_cache_bytes');
SET @x1008_memory_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_memory_current_bytes');
SET @x1008_last_seal_before=(SELECT VARIABLE_VALUE+0
  FROM performance_schema.global_status WHERE VARIABLE_NAME=
  'Preserve_trx_transfer_receiver_last_object_seal_monotonic_us');
--enable_query_log

# W01 owns the deliberately overlapping record and a balanced account model.
--connect(xfer2_x1008_w01,localhost,xfer2_w01_app,,test)
--let $x1008_w01_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION sql_log_bin=0;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT balance=1000 AND version=0 AS w01_old_rr_view
  FROM xfer2_w01_accounts WHERE id=32;
--connect(xfer2_x1008_background,localhost,root,,test)
UPDATE xfer2_w01_accounts
   SET balance=balance+1,version=version+1 WHERE id=32;
--disconnect xfer2_x1008_background
--connection xfer2_x1008_w01
SELECT balance=1000 AND version=0 AS w01_rr_view_stays_old
  FROM xfer2_w01_accounts WHERE id=32;
UPDATE xfer2_w01_accounts
   SET balance=balance-17,version=version+1 WHERE id=1;
UPDATE xfer2_w01_accounts
   SET balance=balance+17,version=version+1 WHERE id=2;
INSERT INTO xfer2_w01_audit(account_id,delta) VALUES(1,-17),(2,17);
UPDATE xfer2_x1008_contend
   SET value_sum=value_sum-100,version=version+1,marker='held-by-w01'
 WHERE id=10;
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS w01_balance_conserved
  FROM xfer2_w01_accounts WHERE id IN (1,2);
SELECT value_sum=910 AND version=1 AND marker='held-by-w01'
         AS w01_holds_overlap_record
  FROM xfer2_x1008_contend WHERE id=10;

# W05 completes a substantial independent model, holds id=20, then waits on
# W01's id=10.  Only the last already-running command crosses the deadline.
--connect(xfer2_x1008_w05,localhost,xfer2_w01_app,,test)
--let $x1008_w05_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION sql_log_bin=0;
SET SESSION innodb_lock_wait_timeout=3600;
START TRANSACTION;
INSERT INTO xfer2_x1008_insert
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<64
)
SELECT n,n,n*10,REPEAT(CHAR(64+MOD(n,26)),128) FROM seq;
UPDATE xfer2_x1008_insert SET v=v+1000 WHERE MOD(id,4)=0;
DELETE FROM xfer2_x1008_insert WHERE MOD(id,8)=0;
UPDATE xfer2_x1008_contend
   SET value_sum=value_sum+200,version=version+1,marker='w05-disjoint'
 WHERE id=20;
SELECT COUNT(*)=56 AND SUM(id)=1792 AND SUM(v)=25920
         AND SUM(OCTET_LENGTH(payload))=7168 AS w05_model_exact
  FROM xfer2_x1008_insert;
SELECT value_sum=1220 AND version=1 AND marker='w05-disjoint'
         AS w05_disjoint_lock_exact
  FROM xfer2_x1008_contend WHERE id=20;
--send UPDATE xfer2_x1008_contend SET value_sum=value_sum+300,version=version+1,marker='w05-won' WHERE id=10

--connection xfer2_source_ha
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.data_lock_waits w JOIN performance_schema.threads r ON r.THREAD_ID=w.REQUESTING_THREAD_ID JOIN performance_schema.threads b ON b.THREAD_ID=w.BLOCKING_THREAD_ID WHERE r.PROCESSLIST_ID=$x1008_w05_id AND b.PROCESSLIST_ID=$x1008_w01_id
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
--replace_result $x1008_w05_id W05_ID $x1008_w01_id W01_ID
--eval SELECT COUNT(*)=1 AS exact_target_to_target_wait FROM performance_schema.data_lock_waits w JOIN performance_schema.threads r ON r.THREAD_ID=w.REQUESTING_THREAD_ID JOIN performance_schema.threads b ON b.THREAD_ID=w.BLOCKING_THREAD_ID WHERE r.PROCESSLIST_ID=$x1008_w05_id AND b.PROCESSLIST_ID=$x1008_w01_id

# W07 keeps S1 and post-S2 changes, while every S2 change stays absent.
--connect(xfer2_x1008_w07,localhost,xfer2_w01_app,,test)
--let $x1008_w07_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
SET SESSION sql_log_bin=0;
START TRANSACTION;
SAVEPOINT s1;
UPDATE xfer2_x1008_savepoint SET v=v+100,state='s1-update' WHERE id=1;
INSERT INTO xfer2_x1008_savepoint VALUES(50,50,50,'s1-insert');
SAVEPOINT s2;
UPDATE xfer2_x1008_savepoint SET v=v+200,state='s2-rolled-back' WHERE id=2;
DELETE FROM xfer2_x1008_savepoint WHERE id=3;
INSERT INTO xfer2_x1008_savepoint VALUES(51,51,51,'s2-rolled-back');
ROLLBACK TO SAVEPOINT s2;
RELEASE SAVEPOINT s2;
UPDATE xfer2_x1008_savepoint SET v=v+400,state='post-s2' WHERE id=4;
SELECT COUNT(*)=17 AND SUM(v)=686
       AND SUM(id=1 AND v=101 AND state='s1-update')=1
       AND SUM(id=2 AND v=2 AND state='base')=1
       AND SUM(id=3 AND v=3 AND state='base')=1
       AND SUM(id=4 AND v=404 AND state='post-s2')=1
       AND SUM(id=50 AND v=50 AND state='s1-insert')=1
       AND SUM(id=51)=0 AS w07_model_exact
  FROM xfer2_x1008_savepoint;

# W08B is the sole logged owner and forces a nonempty binlog cache.
--connect(xfer2_x1008_w08,localhost,xfer2_w01_app,,test)
--let $x1008_w08_id= query_get_value(SELECT CONNECTION_ID() AS id,id,1)
START TRANSACTION;
UPDATE xfer2_x1008_blob
   SET payload=REPEAT('D',512*1024),marker=8 WHERE id=1;
SELECT OCTET_LENGTH(payload)=512*1024
       AND SHA2(payload,256)=SHA2(REPEAT('D',512*1024),256)
       AND marker=8 AS w08b_payload_exact
  FROM xfer2_x1008_blob WHERE id=1;

# O01: no source observer sees any of the four owner transactions.
--connect(xfer2_x1008_observer,localhost,root,,test)
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
         AS only_source_background_visible
  FROM xfer2_w01_accounts;
SELECT COUNT(*)=0 AS no_owner_audit_visible FROM xfer2_w01_audit;
SELECT COUNT(*)=32 AND SUM(value_sum)=32528 AND SUM(version)=0
         AND SUM(marker='base')=32 AS contention_baseline_hidden
  FROM xfer2_x1008_contend;
SELECT COUNT(*)=0 AS w05_rows_hidden FROM xfer2_x1008_insert;
SELECT COUNT(*)=16 AND SUM(v)=136 AND SUM(state='base')=16
         AS w07_rows_hidden
  FROM xfer2_x1008_savepoint;
SELECT OCTET_LENGTH(payload)=256*1024 AND marker=0
         AS w08b_update_hidden
  FROM xfer2_x1008_blob WHERE id=1;
--disconnect xfer2_x1008_observer

--connect(xfer2_x1008_drain,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_transfer_before_commit_send_ownership_cas SIGNAL xfer2_x1008_before_cas WAIT_FOR xfer2_x1008_release TIMEOUT 120';
--send DRAIN TRANSACTIONS PRESERVE

# Observe the real receiver leases before consuming the source DEBUG_SYNC
# signal.  This guarantees the HA control session was not executing during the
# Phase1 target scan and therefore cannot become a provisional token itself.
--connection xfer2_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')=@x1008_online_before+1 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x1008_inflight_tokens_before+3 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_object_seal_monotonic_us')>@x1008_last_seal_before
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc

--connection xfer2_source_ha
SET DEBUG_SYNC='now WAIT_FOR xfer2_x1008_before_cas TIMEOUT 120';
# Closing metrics are published only when the DRAIN command leaves its
# pre-CAS pause.  The detached survivor set and live wait edge are the direct
# evidence available at this boundary; exact timeout metrics are checked after
# RESET has completed the command.
SELECT COUNT(*)=@x1008_preserved_before+3 AS three_survivors_detached,
       SUM(MOD_TABLES_COUNT>=1)=3 AS every_survivor_has_data,
       SUM(SAVEPOINT_COUNT)=1 AS one_savepoint_survivor,
       SUM(SESSION_SQL_LOG_BIN='OFF')=2 AS two_no_bin_survivors,
       SUM(BINLOG_STATE='LOGGED_WITH_CACHE')=1 AS one_w08b_cache_survivor
  FROM performance_schema.preserved_transactions;
--replace_result $x1008_w05_id W05_ID $x1008_w01_id W01_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_at_pre_cas FROM performance_schema.data_lock_waits w JOIN performance_schema.threads r ON r.THREAD_ID=w.REQUESTING_THREAD_ID JOIN performance_schema.threads b ON b.THREAD_ID=w.BLOCKING_THREAD_ID WHERE r.PROCESSLIST_ID=$x1008_w05_id AND b.PROCESSLIST_ID=$x1008_w01_id

# Receiver sees a real precommit epoch with only the three surviving token
# reservations.  The waiting W05 command was Phase1-declared, then removed
# from the survivor set; its exact terminal reason is asserted below.
--connection xfer2_receiver
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
       =@x1008_online_before+1 AS one_precommit_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
       =@x1008_active_before AS no_terminal_epoch;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
       =@x1008_inflight_tokens_before+3 AS only_three_token_leases_remain,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
       =@x1008_failed_before+1 AS one_precommit_failed_record,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')>0
         AS survivor_prewarm_is_queued;
--replace_result $x1008_w05_id W05_ID
--eval SELECT VARIABLE_VALUE+0=$x1008_w05_id AS precommit_failed_token_is_w05 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_token'
SELECT VARIABLE_VALUE IN ('closing_command_timeout','source_phase1_target_removed')
         AS precommit_failure_reason_is_known
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';
SELECT VARIABLE_VALUE AS precommit_failure_reason
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_frames')
       >@x1008_admitted_before AS real_frames_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_admitted_bytes')
       >@x1008_admitted_bytes_before AS real_bytes_admitted,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
       =@x1008_terminal_before AS no_terminal_cas_before_reset;

# O09: independent receiver-native data commits while transfer work is queued.
START TRANSACTION;
UPDATE xfer2_x1008_receiver_native SET v=v+id;
INSERT INTO xfer2_x1008_receiver_native VALUES(3,30);
COMMIT;
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_native_commit_during_contention
  FROM xfer2_x1008_receiver_native;

--connect(xfer2_x1008_reset,localhost,preserve_trx_ha_admin,xfer2-smoke-w01-secret,test)
--send RESET DRAIN

--connection xfer2_source_ha
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--let $wait_timeout= 10
--source include/wait_condition_or_abort.inc
SET DEBUG_SYNC='now SIGNAL xfer2_x1008_release';

--connection xfer2_x1008_reset
--reap

--connection xfer2_x1008_drain
--error ER_PRESERVE_TRX_DRAIN_RESET
--reap
SET DEBUG_SYNC='RESET';

--connection xfer2_source_ha
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')
       =@x1008_reset_wins_before+1 AS reset_won_before_terminal_cas,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_reset_drain_too_late')
       =@x1008_reset_too_late_before AS reset_not_too_late;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_source_handoff_pending_epochs')
       =@x1008_handoff_before AS no_handoff_pending,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')
       =@x1008_unknown_before AS no_commit_unknown,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_epochs')
       =@x1008_quarantine_epochs_before AS no_quarantine_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_quarantine_tokens')
       =@x1008_quarantine_tokens_before AS no_quarantine_token;
SELECT COUNT(*)=@x1008_preserved_before AS reset_restored_all_survivors
  FROM performance_schema.preserved_transactions;
SELECT VARIABLE_VALUE+0=1 AS one_closing_command_timed_out
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_command_timed_out_count';
--replace_result $x1008_w05_id W05_ID $x1008_w01_id W01_ID
--eval SELECT COUNT(*)=1 AS waiter_still_blocked_after_reset FROM performance_schema.data_lock_waits w JOIN performance_schema.threads r ON r.THREAD_ID=w.REQUESTING_THREAD_ID JOIN performance_schema.threads b ON b.THREAD_ID=w.BLOCKING_THREAD_ID WHERE r.PROCESSLIST_ID=$x1008_w05_id AND b.PROCESSLIST_ID=$x1008_w01_id

# RESET releases every receiver resource without classifying a token.  The
# clean ABANDON erases the removed W05 record and all three survivor records;
# only the last-failure diagnostic value remains process-local until restart.
--connection xfer2_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')=@x1008_inflight_tokens_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')=@x1008_inflight_bytes_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')=@x1008_staged_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--let $wait_timeout= 30
--source include/wait_condition_or_abort.inc
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_wins')
       =@x1008_terminal_before+1 AS abandon_cas_won_once,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_duplicates')
       =@x1008_duplicates_before+1 AS one_idempotent_abandon_duplicate,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_cas_conflicts')
       =@x1008_conflicts_before AS no_terminal_conflict,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_terminal_status_tombstones')
       =@x1008_tombstones_before+1 AS one_not_committed_tombstone;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_online_epochs')
       =@x1008_online_before+1 AS one_tombstone_epoch_retained,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')
       =@x1008_active_before AS no_accepted_epoch,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_failed_tokens')
       =@x1008_failed_before AS clean_abandon_erased_failed_records,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_saved_online_tokens')
       =@x1008_saved_before AS no_saved_token;
--replace_result $x1008_w05_id W05_ID
--eval SELECT VARIABLE_VALUE+0=$x1008_w05_id AS post_reset_last_failed_token_is_w05 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_token'
SELECT VARIABLE_VALUE AS post_reset_last_failure_reason
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_last_failed_reason';
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')
       =@x1008_classified_before AS no_classified_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens')
       =@x1008_ready_before AS no_ready_token,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens')
       =@x1008_not_ready_before AS no_not_ready_publication;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens')
       =@x1008_inflight_tokens_before AS inflight_tokens_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_bytes')
       =@x1008_inflight_bytes_before AS inflight_bytes_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_staged_memory_bytes')
       =@x1008_staged_before AS staged_memory_released,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_memory_current_bytes')
       =@x1008_memory_before AS preserve_memory_released;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_registered_tokens')
       =@x1008_prepared_before AS no_prepared_registration,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_prewarm_pending_tokens')
       =@x1008_prepared_pending_before AS no_prepared_pending,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens')
       =@x1008_prepared_ready_before AS no_prepared_ready,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_promotion_ready_cache_bytes')
       =@x1008_ready_cache_before AS no_ready_cache;
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_tokens')
       =@x1008_debt_tokens_before AS no_cleanup_debt_tokens,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_cleanup_debt_bytes')
       =@x1008_debt_bytes_before AS no_cleanup_debt_bytes,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
         AS no_receiver_worker,
       (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
         WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
         AS no_receiver_queue;
SELECT COUNT(*)=3 AND SUM(v)=63 AS reset_kept_receiver_native_commit
  FROM xfer2_x1008_receiver_native;

# The restored W01 owner is still the sole legal lock owner.  Its explicit
# rollback, not RESET itself, releases W05's old command.
--connection xfer2_x1008_w01
--replace_result $x1008_w01_id W01_ID
--eval SELECT CONNECTION_ID()=$x1008_w01_id AS original_w01_owner_restored
SELECT COUNT(*)=2 AND SUM(balance)=2000 AND SUM(version)=2
         AS restored_w01_balance_exact
  FROM xfer2_w01_accounts WHERE id IN (1,2);
SELECT value_sum=910 AND version=1 AND marker='held-by-w01'
         AS restored_w01_overlap_lock_exact
  FROM xfer2_x1008_contend WHERE id=10;
ROLLBACK;

--connection xfer2_x1008_w05
--reap
--replace_result $x1008_w05_id W05_ID
--eval SELECT CONNECTION_ID()=$x1008_w05_id AS original_w05_waiter_continues
SELECT COUNT(*)=56 AND SUM(id)=1792 AND SUM(v)=25920
         AND SUM(OCTET_LENGTH(payload))=7168 AS restored_w05_model_exact
  FROM xfer2_x1008_insert;
SELECT value_sum=1310 AND version=1 AND marker='w05-won'
         AS overlap_update_executed_once
  FROM xfer2_x1008_contend WHERE id=10;
UPDATE xfer2_x1008_contend
   SET value_sum=value_sum+20,marker='w05-final' WHERE id=20;
COMMIT;

--connection xfer2_source_ha
--replace_result $x1008_w05_id W05_ID
--eval SELECT COUNT(*)=0 AS target_wait_released_after_original_rollback FROM performance_schema.data_lock_waits w JOIN performance_schema.threads r ON r.THREAD_ID=w.REQUESTING_THREAD_ID WHERE r.PROCESSLIST_ID=$x1008_w05_id

# A disjoint restored sibling can commit, while the logged W08B sibling can
# still inspect its exact cache-backed value and explicitly roll back.
--connection xfer2_x1008_w07
--replace_result $x1008_w07_id W07_ID
--eval SELECT CONNECTION_ID()=$x1008_w07_id AS original_w07_owner_restored
SELECT COUNT(*)=17 AND SUM(v)=686
       AND SUM(id=1 AND v=101 AND state='s1-update')=1
       AND SUM(id=4 AND v=404 AND state='post-s2')=1
       AND SUM(id=50 AND v=50 AND state='s1-insert')=1
       AND SUM(id=51)=0 AND SUM(state='s2-rolled-back')=0
         AS restored_w07_model_exact
  FROM xfer2_x1008_savepoint;
COMMIT;

--connection xfer2_x1008_w08
--replace_result $x1008_w08_id W08_ID
--eval SELECT CONNECTION_ID()=$x1008_w08_id AS original_w08b_owner_restored
SELECT OCTET_LENGTH(payload)=512*1024
       AND SHA2(payload,256)=SHA2(REPEAT('D',512*1024),256)
       AND marker=8 AS restored_w08b_payload_exact
  FROM xfer2_x1008_blob WHERE id=1;
ROLLBACK;

--connect(xfer2_x1008_final_observer,localhost,root,,test)
--source suite/preserve_trx_transfer_stby/include/assert_w01_baseline.inc
SELECT COUNT(*)=32 AND SUM(value_sum)=33048 AND SUM(version)=2
       AND SUM(marker='base')=30
       AND SUM(id=10 AND value_sum=1310 AND version=1 AND marker='w05-won')=1
       AND SUM(id=20 AND value_sum=1240 AND version=1 AND marker='w05-final')=1
         AS final_contention_state_exact
  FROM xfer2_x1008_contend;
SELECT COUNT(*)=56 AND SUM(id)=1792 AND SUM(v)=25920
       AND SUM(OCTET_LENGTH(payload))=7168 AS final_w05_rows_once
  FROM xfer2_x1008_insert;
SELECT COUNT(*)=8 AS final_w05_deleted_keys_absent
  FROM (
    SELECT 8 AS id UNION ALL SELECT 16 UNION ALL SELECT 24 UNION ALL SELECT 32
    UNION ALL SELECT 40 UNION ALL SELECT 48 UNION ALL SELECT 56 UNION ALL SELECT 64
  ) d
 WHERE NOT EXISTS(SELECT 1 FROM xfer2_x1008_insert i WHERE i.id=d.id);
SELECT COUNT(*)=17 AND SUM(v)=686 AND SUM(state='base')=14
       AND SUM(state='s1-update')=1 AND SUM(state='s1-insert')=1
       AND SUM(state='post-s2')=1 AND SUM(state='s2-rolled-back')=0
         AS final_w07_rows_once
  FROM xfer2_x1008_savepoint;
SELECT OCTET_LENGTH(payload)=256*1024
       AND SHA2(payload,256)=SHA2(REPEAT('a',256*1024),256)
       AND marker=0 AS final_w08b_rollback_exact
  FROM xfer2_x1008_blob WHERE id=1;
CHECK TABLE xfer2_x1008_contend,xfer2_x1008_insert,
            xfer2_x1008_savepoint,xfer2_x1008_blob;

--connection xfer2_source_ha
--eval SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=$x1008_old_phase2_timeout

--disconnect xfer2_x1008_w01
--disconnect xfer2_x1008_w05
--disconnect xfer2_x1008_w07
--disconnect xfer2_x1008_w08
--disconnect xfer2_x1008_final_observer
--disconnect xfer2_x1008_drain
--disconnect xfer2_x1008_reset

--source suite/preserve_trx_transfer_stby/include/w01_teardown.inc

# Source restart keeps only W05/W07's legal commits; W01/W08B remain rolled
# back.  Receiver restart keeps its independent native transaction.
--connection xfer2_cleanup
SELECT COUNT(*)=32 AND SUM(value_sum)=33048 AND SUM(version)=2
       AND SUM(marker='base')=30 AS restarted_contention_state_exact
  FROM xfer2_x1008_contend;
SELECT COUNT(*)=56 AND SUM(id)=1792 AND SUM(v)=25920
       AND SUM(OCTET_LENGTH(payload))=7168 AS restarted_w05_rows_once
  FROM xfer2_x1008_insert;
SELECT COUNT(*)=17 AND SUM(v)=686 AND SUM(state='base')=14
       AND SUM(state='s2-rolled-back')=0 AS restarted_w07_rows_once
  FROM xfer2_x1008_savepoint;
SELECT OCTET_LENGTH(payload)=256*1024
       AND SHA2(payload,256)=SHA2(REPEAT('a',256*1024),256)
       AND marker=0 AS restarted_w08b_rollback_exact
  FROM xfer2_x1008_blob WHERE id=1;
CHECK TABLE xfer2_x1008_contend,xfer2_x1008_insert,
            xfer2_x1008_savepoint,xfer2_x1008_blob;
DROP TABLE xfer2_x1008_insert;
DROP TABLE xfer2_x1008_savepoint;
DROP TABLE xfer2_x1008_blob;
DROP TABLE xfer2_x1008_contend;

--connection xfer2_receiver
SELECT COUNT(*)=3 AND SUM(v)=63 AS receiver_restart_keeps_native_commit
  FROM xfer2_x1008_receiver_native;
DROP TABLE xfer2_x1008_receiver_native;

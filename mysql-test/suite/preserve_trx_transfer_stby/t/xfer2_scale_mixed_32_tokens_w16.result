CALL mtr.add_suppression(
"PRESERVE: rolled back prepared transaction without snapshot during recovery");
CREATE TABLE xfer2_w01_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL DEFAULT 0,
pad VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
CREATE TABLE xfer2_w01_audit(
id BIGINT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL,
KEY(account_id)
) ENGINE=InnoDB;
INSERT INTO xfer2_w01_accounts
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<32
)
SELECT n, 1000, 0, CONCAT('account-', n) FROM seq;
SELECT COUNT(*)=32 AND SUM(balance)=32001 AND SUM(version)=1
AS observer_sees_only_committed_w01,
SUM(id<=24 AND version<>0)=0 AS observer_hides_all_w01_owners
FROM xfer2_w01_accounts;
observer_sees_only_committed_w01	observer_hides_all_w01_owners
1	1
SELECT COUNT(*)=0 AS observer_hides_all_w05_owners
FROM xfer2_x1201_insert;
observer_hides_all_w05_owners
1
SELECT COUNT(*)=64 AND SUM(v)=288 AND SUM(seq_no>=50)=0
AS observer_hides_all_w07_owners
FROM xfer2_x1201_savepoint;
observer_hides_all_w07_owners
1
SELECT COUNT(*)=8 AND SUM(marker)=0
AND SUM(OCTET_LENGTH(payload)=2*1024*1024)=8
AND SUM(SHA2(payload,256)=SHA2(REPEAT('a',2*1024*1024),256))=8
AS observer_hides_all_w08b_owners
FROM xfer2_x1201_blob;
observer_hides_all_w08b_owners
1

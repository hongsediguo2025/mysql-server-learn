--source suite/preserve_trx/include/phase2_multistatement_setup.inc

# Apply the runtime pause before sending any transfer work. The startup option
# alone does not invoke the update hook that controls receiver workers.
--connection multi_receiver
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;

--connect(multi_blocker,localhost,phase2_multi_app,,test)
--let $blocker_id= `SELECT CONNECTION_ID()`
SET SESSION transaction_isolation='REPEATABLE-READ';
START TRANSACTION;
# An uncommitted DELETE makes the INSERT wait, but permits it to succeed once
# this blocker commits. An UPDATE here would instead produce duplicate key.
DELETE FROM t_phase2_multi WHERE id=4;

--connect(multi_business,localhost,phase2_multi_app,,test)
--disable_reconnect
--let $business_id= `SELECT CONNECTION_ID()`
SET SESSION transaction_isolation='REPEATABLE-READ';
SET DEBUG_SYNC='lock_wait_will_wait SIGNAL begin_insert_lock_wait';
--send START TRANSACTION; INSERT INTO t_phase2_multi VALUES(4,44,REPEAT('n',512))

--connection default
SET DEBUG_SYNC='now WAIT_FOR begin_insert_lock_wait TIMEOUT 5';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die INSERT did not enter a real InnoDB lock wait
}
--let $lock_edge= `SELECT COUNT(*)>0 FROM performance_schema.data_lock_waits w JOIN performance_schema.threads r ON r.THREAD_ID=w.REQUESTING_THREAD_ID JOIN performance_schema.threads b ON b.THREAD_ID=w.BLOCKING_THREAD_ID WHERE r.PROCESSLIST_ID=$business_id AND b.PROCESSLIST_ID=$blocker_id`
if (!$lock_edge)
{
  --die INSERT lock wait does not point to the DELETE transaction
}
SET DEBUG_SYNC='phase2_sched_after_innodb_support_registered SIGNAL begin_insert_support';
--send DRAIN TRANSACTIONS PRESERVE

--connection multi_ha
SET DEBUG_SYNC='now WAIT_FOR begin_insert_support TIMEOUT 10';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die dependency scheduler did not prove the INSERT blocker
}
--connection multi_blocker
COMMIT;
--connection multi_business
--enable_result_log
--enable_info
--reap
--disable_info
--disable_result_log
--connection default
--reap

--connection multi_business
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection multi_ha
--let $data_ok= `SELECT COUNT(*)=0 FROM t_phase2_multi WHERE id=4`
if (!$data_ok)
{
  --die blocker DELETE was not committed or waiter INSERT was committed
}
--let $still_connected= `SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_ID=$business_id`
if (!$still_connected)
{
  --die INSERT waiter connection was lost during DRAIN
}
--connection multi_receiver
# Prewarm is paused in this two-datadir fixture. Verify the accepted epoch,
# not SAVED_ONLINE/READY, which require receiver prewarm completion.
--let $accepted= `SELECT VARIABLE_VALUE=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs'`
if (!$accepted)
{
  --die receiver did not accept the transferred epoch
}
# Before prewarm the one final token remains RECEIVING. ABORTED phase1
# candidates are legitimately excluded from the accepted epoch/token count.
--let $one_pending_token= `SELECT VARIABLE_VALUE=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens'`
if (!$one_pending_token)
{
  --die receiver did not retain exactly one final staged transaction
}
--source suite/preserve_trx/include/phase2_multistatement_cleanup.inc
--enable_result_log
--echo single_com_query_insert_waiter_released_and_preserved

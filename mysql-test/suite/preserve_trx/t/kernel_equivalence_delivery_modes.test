--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_kernel_equiv;
DROP TABLE IF EXISTS t_kernel_equiv_observed;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_warmcopy_min_open_ms= `SELECT @@GLOBAL.preserve_trx_warmcopy_min_open_ms`
--let $old_preserve_trx_single_phase_max_binlog_cache_bytes= `SELECT @@GLOBAL.preserve_trx_single_phase_max_binlog_cache_bytes`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=1048576;

CREATE TABLE t_kernel_equiv(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  payload VARBINARY(256)
) ENGINE=InnoDB;
CREATE TABLE t_kernel_equiv_observed(
  entry VARCHAR(32) PRIMARY KEY,
  binlog_state VARCHAR(32) NOT NULL,
  wrote_to_cache VARCHAR(3) NOT NULL,
  cache_positive INT NOT NULL,
  session_sql_log_bin VARCHAR(3) NOT NULL,
  global_log_bin VARCHAR(3) NOT NULL,
  isolation_name VARCHAR(32) NOT NULL,
  mod_tables_count BIGINT UNSIGNED NOT NULL,
  savepoint_count BIGINT UNSIGNED NOT NULL,
  warmcopy_state VARCHAR(32) NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_kernel_equiv VALUES
  (1,10,REPEAT('a',64)),
  (2,20,REPEAT('b',64)),
  (3,30,REPEAT('c',64));
RESET MASTER;

SET @kernel_equiv_var='single';
START TRANSACTION;
UPDATE t_kernel_equiv SET v=101, payload=REPEAT('x',64) WHERE id=1;
SAVEPOINT s_kernel;
INSERT INTO t_kernel_equiv VALUES(101,1001,REPEAT('s',64));

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300 WITH USER VARS;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

INSERT INTO t_kernel_equiv_observed
SELECT 'single', BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE > 0,
       SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN, ISOLATION, MOD_TABLES_COUNT,
       SAVEPOINT_COUNT, BINLOG_WARMCOPY_STATE
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS single_preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc
--connect(kernel_equiv_resume_single, localhost, root,,test)
--connection kernel_equiv_resume_single
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT @kernel_equiv_var AS resumed_var;
ROLLBACK TO SAVEPOINT s_kernel;
UPDATE t_kernel_equiv SET v=v+1 WHERE id=1;
COMMIT;
--disconnect kernel_equiv_resume_single

--connection default
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=1048576;

--connect(kernel_equiv_single_phase_app, localhost, root,,test)
SET @kernel_equiv_var='batch_single_phase';
START TRANSACTION;
UPDATE t_kernel_equiv SET v=201, payload=REPEAT('y',64) WHERE id=2;
SAVEPOINT s_kernel;
INSERT INTO t_kernel_equiv VALUES(102,1002,REPEAT('p',64));

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

INSERT INTO t_kernel_equiv_observed
SELECT 'batch_single_phase', BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0, SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN, ISOLATION,
       MOD_TABLES_COUNT, SAVEPOINT_COUNT, BINLOG_WARMCOPY_STATE
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS batch_single_phase_preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc
--connect(kernel_equiv_resume_single_phase, localhost, root,,test)
--connection kernel_equiv_resume_single_phase
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT @kernel_equiv_var AS resumed_var;
ROLLBACK TO SAVEPOINT s_kernel;
UPDATE t_kernel_equiv SET v=v+1 WHERE id=2;
COMMIT;
--disconnect kernel_equiv_resume_single_phase

--connection default
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=0;

--connect(kernel_equiv_two_phase_app, localhost, root,,test)
SET @kernel_equiv_var='batch_two_phase';
START TRANSACTION;
UPDATE t_kernel_equiv SET v=301, payload=REPEAT('z',64) WHERE id=3;
SAVEPOINT s_kernel;
INSERT INTO t_kernel_equiv VALUES(103,1003,REPEAT('w',64));

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

INSERT INTO t_kernel_equiv_observed
SELECT 'batch_two_phase', BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0, SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN, ISOLATION,
       MOD_TABLES_COUNT, SAVEPOINT_COUNT, BINLOG_WARMCOPY_STATE
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS batch_two_phase_preserved_count
  FROM performance_schema.preserved_transactions;
SELECT warmcopy_state AS batch_two_phase_warmcopy_state
  FROM t_kernel_equiv_observed
 WHERE entry = 'batch_two_phase';
--source suite/preserve_trx/include/get_preserved_token.inc
--connect(kernel_equiv_resume_two_phase, localhost, root,,test)
--connection kernel_equiv_resume_two_phase
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT @kernel_equiv_var AS resumed_var;
ROLLBACK TO SAVEPOINT s_kernel;
UPDATE t_kernel_equiv SET v=v+1 WHERE id=3;
COMMIT;
--disconnect kernel_equiv_resume_two_phase

--connection default
SELECT entry, binlog_state, wrote_to_cache, cache_positive,
       session_sql_log_bin, global_log_bin, isolation_name,
       mod_tables_count, savepoint_count, warmcopy_state
  FROM t_kernel_equiv_observed
 ORDER BY entry;
SELECT COUNT(DISTINCT CONCAT_WS('|', session_sql_log_bin, global_log_bin,
                                isolation_name, mod_tables_count,
                                savepoint_count))
       AS semantic_shape_count
  FROM t_kernel_equiv_observed;
SELECT id, v, OCTET_LENGTH(payload) AS payload_len
  FROM t_kernel_equiv
 ORDER BY id;
SELECT COUNT(*) AS preserved_count_after_all_resumes
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_kernel_equiv_observed;
DROP TABLE t_kernel_equiv;
--disable_query_log
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=$old_preserve_trx_single_phase_max_binlog_cache_bytes
--eval SET GLOBAL preserve_trx_warmcopy_min_open_ms=$old_preserve_trx_warmcopy_min_open_ms
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log

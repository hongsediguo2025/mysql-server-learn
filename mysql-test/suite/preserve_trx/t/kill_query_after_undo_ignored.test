--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_kill_query_after_undo;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_kill_query_after_undo(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_kill_query_after_undo VALUES(1,10);

--connect(preserve_kill_query_after_undo,localhost,root,,test)
--connection preserve_kill_query_after_undo
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET SESSION debug="+d,preserve_trx_fail_before_snapshot_fsync";
SET DEBUG_SYNC =
  'preserve_trx_after_undo_prepared SIGNAL after_undo WAIT_FOR continue_after_undo';
START TRANSACTION;
UPDATE t_preserve_kill_query_after_undo SET b=12 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR after_undo TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL QUERY $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_after_undo';

--connection preserve_kill_query_after_undo
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
SET DEBUG_SYNC = 'RESET';
--disconnect preserve_kill_query_after_undo

--connection default
SELECT * FROM t_preserve_kill_query_after_undo WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_kill_query_after_undo;
SET GLOBAL preserve_trx_enable=ON;

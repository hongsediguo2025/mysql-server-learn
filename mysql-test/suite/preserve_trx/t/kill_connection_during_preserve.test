--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_kill_connection;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_kill_connection(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_kill_connection VALUES(1,10);

--connect(preserve_kill_connection,localhost,root,,test)
--connection preserve_kill_connection
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_lock_materialization SIGNAL before_durable_conn WAIT_FOR continue_preserve_conn';
START TRANSACTION;
UPDATE t_preserve_kill_connection SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR before_durable_conn TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL CONNECTION $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_preserve_conn';

--connection preserve_kill_connection
--error 2013
--reap
--disconnect preserve_kill_connection

--connection default
SELECT * FROM t_preserve_kill_connection WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--let $MYSQLD_DATADIR= `SELECT @@datadir`
--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* token delivery cleanup failed.*");
CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files");
--enable_query_log

--connect(preserve_kill_connection_token,localhost,root,,test)
--connection preserve_kill_connection_token
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET SESSION debug="+d,preserve_trx_fail_delete_snapshot_files";
SET DEBUG_SYNC =
  'preserve_trx_before_token_delivery SIGNAL before_token_delivery WAIT_FOR continue_token_delivery';
START TRANSACTION;
UPDATE t_preserve_kill_connection SET b=12 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR before_token_delivery TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL CONNECTION $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_token_delivery';

--connection preserve_kill_connection_token
--error 2013
--reap
--disconnect preserve_kill_connection_token

--connection default
SELECT * FROM t_preserve_kill_connection WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= token delivery cleanup failed
--let $grep_output= count
--source include/grep_pattern.inc

--let $grep_pattern= recovery cleanup failed: failed to delete snapshot files
--let $grep_output= count
--source include/grep_pattern.inc

--exec sh -c 'test -d "$MYSQLD_DATADIR/preserve" && find "$MYSQLD_DATADIR/preserve" -name "*.bin" -print -quit | grep -q .'
--exec sh -c 'test ! -d "$MYSQLD_DATADIR/preserve" || ! find "$MYSQLD_DATADIR/preserve" \( -name "*.bin.tmp" -o -name "*.binlog_cache" -o -name "*.binlog_cache.tmp" \) -print -quit | grep -q .'
--remove_files_wildcard $MYSQLD_DATADIR/preserve *.bin
--remove_files_wildcard $MYSQLD_DATADIR/preserve *.bin.tmp
--remove_files_wildcard $MYSQLD_DATADIR/preserve *.binlog_cache
--remove_files_wildcard $MYSQLD_DATADIR/preserve *.binlog_cache.tmp

DROP TABLE t_preserve_kill_connection;
SET GLOBAL preserve_trx_enable=ON;

[mysqld.1]
server_id=1
default_authentication_plugin=mysql_native_password
rds-preserve-trx-enable=ON
rds-preserve-trx-temp-id-namespace=ON

[mysqld.2]
server_id=2
default_authentication_plugin=mysql_native_password
rds-preserve-trx-enable=ON
rds-preserve-trx-temp-id-namespace=ON
rds-preserve-trx-standby-phase2-scheduler-mode=DEPENDENCY_CONVERGENCE_V1
rds-preserve-trx-phase1-capture-mode=BOUNDED_PIPELINE_V1

[ENV]
SERVER_MYPORT_2=@mysqld.2.port

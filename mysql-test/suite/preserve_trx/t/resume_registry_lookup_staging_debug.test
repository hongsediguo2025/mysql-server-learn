--source include/have_debug.inc

--disable_warnings
DROP USER IF EXISTS preserve_resume_lookup@localhost;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SET SESSION debug='+d,preserve_trx_inject_observable_record';
SELECT COUNT(*) AS injected
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-observable-token';
SET SESSION debug='-d,preserve_trx_inject_observable_record';

CREATE USER preserve_resume_lookup@localhost;
GRANT RESUME_ANY_PRESERVED_TRANSACTION ON *.* TO preserve_resume_lookup@localhost;

--connect(preserve_resume_lookup_con, localhost, preserve_resume_lookup,,test)
--error ER_PRESERVE_TRX_UNSUPPORTED
RESUME PRESERVED TRANSACTION 'debug-observable-token';
--error ER_PRESERVE_TRX_NOT_FOUND
RESUME PRESERVED TRANSACTION 'missing-debug-token';
--disconnect preserve_resume_lookup_con
--connection default

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-observable-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP USER preserve_resume_lookup@localhost;
SET GLOBAL preserve_trx_enable=OFF;

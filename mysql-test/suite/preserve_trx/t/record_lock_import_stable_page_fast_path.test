--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_record_lock_import_fast_path;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_record_lock_import_fast_path(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(64)
) ENGINE=InnoDB;

INSERT INTO t_record_lock_import_fast_path
  VALUES(1,10,REPEAT('a',32));

--connect(record_fast_app,localhost,root,,test)
--connection record_fast_app
START TRANSACTION;
--disable_query_log
--disable_result_log
SELECT id FROM t_record_lock_import_fast_path WHERE id=1 FOR UPDATE;
--enable_result_log
--enable_query_log
UPDATE t_record_lock_import_fast_path
  SET v=11, pad=REPEAT('b',32)
  WHERE id=1;
SET DEBUG_SYNC =
  'preserve_trx_after_begin_before_command_read SIGNAL record_fast_idle WAIT_FOR record_fast_continue';

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR record_fast_idle TIMEOUT 10';

--connect(record_fast_owner,localhost,root,,test)
--connection record_fast_owner
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now SIGNAL record_fast_continue';

--connection record_fast_owner
--reap
--disconnect record_fast_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10 --debug=d,preserve_trx_corrupt_import_record_lock_identity,preserve_trx_corrupt_import_record_lock_page_lsn" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
--disconnect record_fast_app

--connection default
SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;

SELECT id, v, pad = REPEAT('b',32) AS pad_ok
  FROM t_record_lock_import_fast_path
  ORDER BY id;

DROP TABLE t_record_lock_import_fast_path;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

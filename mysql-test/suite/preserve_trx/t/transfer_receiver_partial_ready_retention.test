# A deadline selection must retain its READY subset, even when an unselected
# token already has a prepared entry but has not published its token result.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc
--disable_query_log
--disable_result_log

--let $credential_file= $MYSQL_TMP_DIR/partial-ready-retention.secret
--write_file $credential_file
partial-ready-retention-secret
EOF
--exec chmod 600 $credential_file
CREATE USER preserve_trx_ha_admin@localhost IDENTIFIED BY 'partial-ready-retention-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN, PRESERVE_TRX_TRANSFER_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER partial_ready_app@localhost;
GRANT SELECT, UPDATE ON test.* TO partial_ready_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=partial_ready_retention --rds-preserve-trx-transfer-credential-secret-file=$credential_file --log-error-verbosity=3
--source include/restart_mysqld.inc
--let $restart_parameters=
--disable_query_log
--disable_result_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc
CALL mtr.add_suppression('PRESERVE: rolled back prepared transaction without snapshot during recovery');
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;
CREATE TABLE t_partial_ready_retention(id INT PRIMARY KEY, v INT, payload VARBINARY(4096)) ENGINE=InnoDB;
INSERT INTO t_partial_ready_retention VALUES(1,10,REPEAT('a',4096)),(2,20,REPEAT('b',4096));
--connect(retention_ha,localhost,preserve_trx_ha_admin,partial-ready-retention-secret,test)
--connect(retention_app1,localhost,partial_ready_app,,test)
--let $app1= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_partial_ready_retention SET v=11,payload=REPEAT('c',4096) WHERE id=1;
--connect(retention_app2,localhost,partial_ready_app,,test)
--let $app2= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_partial_ready_retention SET v=21,payload=REPEAT('d',4096) WHERE id=2;

--connection default
--enable_result_log
--eval SELECT MOD($app1,2)<>MOD($app2,2) AS one_held_one_running
--disable_result_log
SET GLOBAL debug='+d,preserve_trx_receiver_hold_even_token_result,preserve_trx_receiver_partial_expiry_probe';
DRAIN TRANSACTIONS PRESERVE;

--connection retention_ha
SET DEBUG_SYNC='now WAIT_FOR receiver_result_held TIMEOUT 30';
--let $wait_condition= SELECT VARIABLE_VALUE=2 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens'
--source include/wait_condition.inc
--enable_result_log
SELECT VARIABLE_VALUE=2 AS both_resources_prepared_before_deadline FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens';
--disable_result_log
--let $wait_condition= SELECT VARIABLE_VALUE=2 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens'
--source include/wait_condition.inc
--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= PRESERVE: partial selection prepared expiry pass completed
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--enable_result_log
SELECT VARIABLE_VALUE=1 AS selected_ready_token FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens';
SELECT VARIABLE_VALUE=1 AS deadline_failed_token FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens';
SELECT VARIABLE_VALUE=1 AS selected_ready_resources_retained FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens';
--disable_result_log
SET DEBUG_SYNC='now SIGNAL receiver_result_continue';
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc
--enable_result_log
SELECT VARIABLE_VALUE=1 AS late_result_does_not_change_selection FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens';
SELECT VARIABLE_VALUE=1 AS selected_resources_still_retained FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_promotion_prepared_ready_tokens';
--disable_result_log
SET GLOBAL debug='-d,preserve_trx_receiver_hold_even_token_result,preserve_trx_receiver_partial_expiry_probe';
SET DEBUG_SYNC='RESET';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--connect(retention_cleanup,localhost,root,,test)
--disable_query_log
--disable_result_log
DROP TABLE t_partial_ready_retention;
DROP USER partial_ready_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file
--enable_query_log
--enable_result_log

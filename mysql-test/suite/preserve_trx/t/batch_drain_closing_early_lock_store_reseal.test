--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/closing_early_lock_reseal.secret
--write_file $credential_file
closing-early-lock-reseal-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS closing_early_lock_reseal_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'closing-early-lock-reseal-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER closing_early_lock_reseal_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_early_lock_reseal_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-standby-phase2-scheduler-mode=DEPENDENCY_CONVERGENCE_V1 --rds-preserve-trx-phase1-capture-mode=BOUNDED_PIPELINE_V1 --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=closing_early_lock_reseal --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--source suite/preserve_trx/include/assert_standby_transfer_source.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

--let $old_closing_timeout= `SELECT @@GLOBAL.rds_preserve_trx_drain_phase2_timeout_ms`
--let $old_prewarm_paused= `SELECT @@GLOBAL.rds_preserve_trx_transfer_prewarm_paused`

SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=60000;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;

SET @lock_reseal_valid_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_lock_warmcopy_sealed_valid');
SET @lock_reseal_fallback_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_lock_warmcopy_live_fallback');

CREATE TABLE t_closing_early_lock_reseal(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_early_lock_reseal VALUES (1,10),(2,20);

--connect(closing_early_lock_reseal_ha,localhost,preserve_trx_ha_admin,closing-early-lock-reseal-secret,test)
--connect(closing_early_lock_reseal_app,localhost,closing_early_lock_reseal_app,,test)
START TRANSACTION;
UPDATE t_closing_early_lock_reseal SET v=v+1 WHERE id=1;

--connect(closing_early_lock_reseal_owner,localhost,root,,test)
SET DEBUG_SYNC =
  'preserve_trx_transfer_after_phase1_binlog_stream SIGNAL early_lock_phase1_sent WAIT_FOR early_lock_phase1_continue';
SET DEBUG_SYNC =
  'preserve_trx_batch_after_one_target_preserved SIGNAL early_lock_target_staged WAIT_FOR early_lock_target_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connection closing_early_lock_reseal_ha
SET DEBUG_SYNC='now WAIT_FOR early_lock_phase1_sent TIMEOUT 30';

# Mutate the record-lock set only after the Phase1 record blob has been built
# and sent. Bounded final reconciliation must refresh the exact store before
# binding the candidate, without re-exporting the native lock list.
--connection closing_early_lock_reseal_app
UPDATE t_closing_early_lock_reseal SET v=v+2 WHERE id=2;

--connection closing_early_lock_reseal_ha
SET DEBUG_SYNC='now SIGNAL early_lock_phase1_continue';
SET DEBUG_SYNC='now WAIT_FOR early_lock_target_staged TIMEOUT 30';

--connect(closing_early_lock_reseal_reset,localhost,preserve_trx_ha_admin,closing-early-lock-reseal-secret,test)
--send RESET DRAIN

--connection closing_early_lock_reseal_ha
SET DEBUG_SYNC='now SIGNAL early_lock_target_continue';

--connection closing_early_lock_reseal_owner
--error 4021
--reap

--connection closing_early_lock_reseal_reset
--reap

--connection default
SELECT
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_lock_warmcopy_sealed_valid')
     > @lock_reseal_valid_before AS final_store_candidate_valid,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_lock_warmcopy_live_fallback')
     = @lock_reseal_fallback_before AS live_lock_list_fallback_avoided,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_early_staged_tokens')=1
     AS early_token_staged;

--let $assert_text= bounded final reconciliation used the exact dirty store
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after= CURRENT_TEST: preserve_trx.batch_drain_closing_early_lock_store_reseal
--let $assert_select= PRESERVE_PHASE1_OWNER_V1 event=FINAL_RECORD_RECONCILE_COMPLETE targets=1 captured=0 store_refresh_targets=1 store_refreshed=1 store_fallback_invalid=0 store_fallback_coordinate=0 store_fallback_unavailable=0 deferred=0 exact=1 invalidated=0 failed=0
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_only_after=

--connection closing_early_lock_reseal_app
COMMIT;

--connection default
SELECT COUNT(*) AS preserved_count_after_reset
  FROM performance_schema.preserved_transactions;
SELECT id, v FROM t_closing_early_lock_reseal ORDER BY id;

--disconnect closing_early_lock_reseal_reset
--disconnect closing_early_lock_reseal_owner
--disconnect closing_early_lock_reseal_app
--disconnect closing_early_lock_reseal_ha

--connection default
DROP TABLE t_closing_early_lock_reseal;
DROP USER closing_early_lock_reseal_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file
SET DEBUG_SYNC='RESET';
--disable_result_log
--eval SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=$old_closing_timeout
--eval SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=$old_prewarm_paused
--enable_result_log

# The restored source still holds DRAIN's purge stop until process retirement.
--connection default
--disable_query_log
--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE
--source suite/preserve_trx/include/standby_source_sigkill_restart.inc
--let $restart_parameters=
--enable_query_log

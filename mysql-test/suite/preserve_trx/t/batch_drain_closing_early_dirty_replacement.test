# Dirty classification is injected only at the existing fast-scan boundary.
# The transfer and RESET paths below still use real mysqld connections.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/closing_early_dirty.secret
--write_file $credential_file
closing-early-dirty-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS closing_early_dirty_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'closing-early-dirty-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER closing_early_dirty_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_early_dirty_app@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-receiver-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$MASTER_MYSOCK --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=closing_early_dirty --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

SET GLOBAL preserve_trx_batch_max_transactions=1;
SET GLOBAL preserve_trx_drain_command_timeout_fail_batch=ON;
SET GLOBAL preserve_trx_drain_closing_command_timeout_ms=60000;
SET GLOBAL preserve_trx_transfer_prewarm_paused=ON;

CREATE TABLE t_closing_early_dirty(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_early_dirty VALUES (1,10);

--connect(closing_early_dirty_ha,localhost,preserve_trx_ha_admin,closing-early-dirty-secret,test)
--connect(closing_early_dirty_app,localhost,closing_early_dirty_app,,test)
--connect(closing_early_dirty_owner,localhost,root,,test)

# A forced coordinate drift must finish a higher-generation replacement. RESET
# then restores the detached source transaction before returning OK.
--connection closing_early_dirty_app
START TRANSACTION;
UPDATE t_closing_early_dirty SET v=v+1 WHERE id=1;

--connection closing_early_dirty_ha
SET GLOBAL debug='+d,preserve_trx_early_force_one_coordinate_drift';

--connection closing_early_dirty_owner
SET DEBUG_SYNC=
  'preserve_trx_early_after_dirty_replacement SIGNAL early_dirty_replaced WAIT_FOR early_dirty_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection closing_early_dirty_ha
SET DEBUG_SYNC='now WAIT_FOR early_dirty_replaced TIMEOUT 30';
--connect(closing_early_dirty_reset,localhost,preserve_trx_ha_admin,closing-early-dirty-secret,test)
--send RESET DRAIN

--connection closing_early_dirty_ha
SET DEBUG_SYNC='now SIGNAL early_dirty_continue';

--connection closing_early_dirty_owner
--error 4021
--reap

--connection closing_early_dirty_reset
--reap

--connection closing_early_dirty_ha
SET GLOBAL debug='-d,preserve_trx_early_force_one_coordinate_drift';

--enable_query_log
SELECT
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_lock_warmcopy_sealed_valid')>=1
    AS early_prebuilt_sealed,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_early_staged_tokens')=1
    AS replacement_staged_one,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_final_dirty_tokens')=1
    AS replacement_dirty_one,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_final_replacement_tokens')=1
    AS replacement_sent_one,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_final_validation_rejects')=0
    AS replacement_no_reject;
--disable_query_log

--connection closing_early_dirty_app
UPDATE t_closing_early_dirty SET v=v+10 WHERE id=1;
COMMIT;

--connection default
--enable_query_log
SELECT v AS value_after_replacement_reset FROM t_closing_early_dirty;
--disable_query_log

# A mutation observed by the second scan must fail closed before COMMIT_EPOCH
# and restore the source transaction to its original THD.
--connection closing_early_dirty_app
START TRANSACTION;
UPDATE t_closing_early_dirty SET v=v+1 WHERE id=1;

--connection closing_early_dirty_ha
SET GLOBAL debug='+d,preserve_trx_early_force_final_fence_change';

--connection closing_early_dirty_owner
SET DEBUG_SYNC='RESET';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

--connection closing_early_dirty_ha
SET GLOBAL debug='-d,preserve_trx_early_force_final_fence_change';
--enable_query_log
SELECT
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_early_staged_tokens')=1
    AS reject_staged_one,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_final_replacement_tokens')=0
    AS reject_no_replacement,
  (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_final_validation_rejects')=1
    AS reject_count_one;
--disable_query_log

--connection closing_early_dirty_app
UPDATE t_closing_early_dirty SET v=v+100 WHERE id=1;
COMMIT;

--connection default
--enable_query_log
SELECT v AS value_after_final_scan_reject FROM t_closing_early_dirty;
--disable_query_log

--disconnect closing_early_dirty_app
--disconnect closing_early_dirty_reset
--disconnect closing_early_dirty_owner
--disconnect closing_early_dirty_ha

--connection default
DROP TABLE t_closing_early_dirty;
DROP USER closing_early_dirty_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file

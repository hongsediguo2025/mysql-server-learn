--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_gtid_reacquire;
DROP TABLE IF EXISTS t_gtid_reacquire_conflict;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SET SESSION sql_log_bin=0;
CREATE TABLE t_gtid_reacquire(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t_gtid_reacquire_conflict(a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t_gtid_reacquire VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;

--let MYSQLD_DATADIR= `SELECT @@datadir`
--let $server_uuid= `SELECT @@GLOBAL.SERVER_UUID`
--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
UPDATE t_gtid_reacquire SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
INSERT INTO t_gtid_reacquire_conflict VALUES(7);
COMMIT;
SET GTID_NEXT=AUTOMATIC;

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT * FROM t_gtid_reacquire WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @bins = grep { /\.bin$/ || /\.binlog_cache$/ } readdir($dh);
closedir($dh);
die "expected no preserved snapshot files in $dir, found " . scalar(@bins) . "\n"
  unless scalar(@bins) == 0;
EOF

SET SESSION sql_log_bin=0;
DROP TABLE t_gtid_reacquire, t_gtid_reacquire_conflict;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

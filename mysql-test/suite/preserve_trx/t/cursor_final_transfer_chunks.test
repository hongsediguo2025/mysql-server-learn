--source include/have_debug.inc
--source include/have_log_bin.inc
--disable_query_log
# The relay deliberately drops a successful nonzero-offset CHUNK ACK.
CALL mtr.add_suppression('MY-001158 - Got an error reading communication packets');
--enable_query_log
--let $contract_final_sparse= 1
--let $receiver_namespace= 1
--let $contract_temporary= undo
--let $contract_loopback= 1
--let $contract_engine= temp-only
--let $contract_resume= success
--let $contract_undo_owner_case= result-final-chunk
--source suite/preserve_trx/include/temp_id_contract_source.inc

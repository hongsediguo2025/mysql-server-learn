--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_logged_empty_gtid_next;
DROP DATABASE IF EXISTS preserve_trx_ignored;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL rds_preserve_trx_enable=ON;

SET SESSION sql_log_bin=0;
CREATE DATABASE preserve_trx_ignored;
CREATE TABLE t_logged_empty_gtid_next(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE preserve_trx_ignored.gtid_seed(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_logged_empty_gtid_next VALUES(1,10);
INSERT INTO preserve_trx_ignored.gtid_seed VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;

--let $server_uuid= `SELECT @@GLOBAL.SERVER_UUID`
--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:41'
START TRANSACTION;
UPDATE preserve_trx_ignored.gtid_seed SET b=11 WHERE a=1;

--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

SELECT * FROM preserve_trx_ignored.gtid_seed WHERE a=1;

--perl
use strict;
use warnings;
use File::Spec;
require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite', 'preserve_trx',
                            'include', 'preserve_snapshot_files.pl');

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my @bins = PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
die "expected no preserved snapshots in $dir, found " . scalar(@bins) . "\n"
  unless scalar(@bins) == 0;
EOF

ROLLBACK;
SET GTID_NEXT=AUTOMATIC;

SELECT @@SESSION.GTID_NEXT;

SET SESSION sql_log_bin=0;
DROP TABLE t_logged_empty_gtid_next;
DROP DATABASE preserve_trx_ignored;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_predicate_page_drift_anchor;
DROP TABLE IF EXISTS t_predicate_page_drift;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: failed to restore durable transaction semantics");
--enable_query_log

CREATE TABLE t_predicate_page_drift_anchor(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
CREATE TABLE t_predicate_page_drift(
  id INT PRIMARY KEY,
  pos POINT NOT NULL SRID 0,
  SPATIAL KEY(pos)
) ENGINE=InnoDB;
INSERT INTO t_predicate_page_drift_anchor VALUES(1,0);
INSERT INTO t_predicate_page_drift VALUES
  (1, ST_GeomFromText('POINT(1 1)')),
  (2, ST_GeomFromText('POINT(10 10)'));

SET @g = ST_GeomFromText('POLYGON((0 0,0 5,5 5,5 0,0 0))');
START TRANSACTION;
UPDATE t_predicate_page_drift_anchor SET v=1 WHERE id=1;
SELECT COUNT(*) AS locked_rows
  FROM t_predicate_page_drift FORCE INDEX(pos)
  WHERE MBRWithin(pos, @g) FOR UPDATE;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --debug=d,preserve_trx_corrupt_import_predicate_page_identity
--source include/start_mysqld.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: failed to restore durable transaction semantics
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT COUNT(*) AS recovered_tokens
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_predicate_page_drift_anchor ORDER BY id;
SELECT id, ST_AsText(pos) AS pos
  FROM t_predicate_page_drift ORDER BY id;

DROP TABLE t_predicate_page_drift;
DROP TABLE t_predicate_page_drift_anchor;
SET GLOBAL preserve_trx_enable=ON;

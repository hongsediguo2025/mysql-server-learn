--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log

--let $initial_log_bin= query_get_value(SELECT @@GLOBAL.log_bin AS value, value, 1)

--let $credential_file= $MYSQL_TMP_DIR/closing-timeout-exclusion.secret
--write_file $credential_file
closing-timeout-exclusion-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS closing_exclusion_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'closing-timeout-exclusion-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER closing_exclusion_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_exclusion_app@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO closing_exclusion_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=closing_timeout_exclusion --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=200;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=100;

--connect(closing_exclusion_ha,localhost,preserve_trx_ha_admin,closing-timeout-exclusion-secret,test)

--disable_warnings
DROP TABLE IF EXISTS t_closing_timeout_exclusion;
--enable_warnings
CREATE TABLE t_closing_timeout_exclusion(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_timeout_exclusion VALUES(1,10),(2,20),(3,30);

--connect(closing_exclusion_survivor,localhost,closing_exclusion_app,,test)
--let $survivor_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_closing_timeout_exclusion SET v=11 WHERE id=1;

--connect(closing_exclusion_timeout,localhost,closing_exclusion_app,,test)
--let $excluded_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_closing_timeout_exclusion SET v=21 WHERE id=2;
SET DEBUG_SYNC=
  'before_execute_sql_command SIGNAL closing_exclusion_command_running WAIT_FOR closing_exclusion_command_continue';
--send SELECT 2 AS excluded_old_command

--connect(closing_exclusion_race,localhost,closing_exclusion_app,,test)
--let $race_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_closing_timeout_exclusion SET v=31 WHERE id=3;
SET DEBUG_SYNC=
  'before_execute_sql_command SIGNAL closing_exclusion_race_running WAIT_FOR closing_exclusion_race_continue';
SET DEBUG_SYNC=
  'preserve_trx_closing_command_blocked_before_response SIGNAL closing_exclusion_race_rejected WAIT_FOR closing_exclusion_race_reject_continue';
--send SELECT 3 AS deadline_race_old_command

--connection default
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_command_running TIMEOUT 10';
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_race_running TIMEOUT 10';
--sleep 0.2

--connection default
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL closing_exclusion_policy_frozen WAIT_FOR closing_exclusion_policy_continue';
SET DEBUG_SYNC=
  'preserve_trx_early_timeout_before_recheck SIGNAL closing_exclusion_timeout_recheck WAIT_FOR closing_exclusion_timeout_recheck_continue';
SET DEBUG_SYNC=
  'preserve_trx_early_timeout_after_exclusion SIGNAL closing_exclusion_timeout_classified WAIT_FOR closing_exclusion_timeout_classified_continue';
SET DEBUG_SYNC=
  'preserve_trx_drain_after_shutdown_handoff SIGNAL closing_exclusion_handoff WAIT_FOR closing_exclusion_shutdown';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection closing_exclusion_ha
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_policy_frozen TIMEOUT 30';
# The running attempt must keep its pipeline snapshot even if a later
# administrative SET changes the global before the deadline is evaluated.
SET DEBUG_SYNC='now SIGNAL closing_exclusion_policy_continue';
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_timeout_recheck TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL closing_exclusion_race_continue';

--connection closing_exclusion_race
--disable_result_log
--reap
--enable_result_log
--send SELECT 33 AS rejected_after_quiesce

--connection closing_exclusion_ha
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_race_rejected TIMEOUT 10';
SET DEBUG_SYNC='now SIGNAL closing_exclusion_timeout_recheck_continue';
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_timeout_classified TIMEOUT 30';
# A QUIESCED transaction returning 4020 is still a survivor. Only the old
# command that remains PENDING_QUIESCE may be excluded at the deadline. The
# final structured result below proves the exact survivor/exclusion roles.
SET DEBUG_SYNC='now SIGNAL closing_exclusion_race_reject_continue';
# V1 releases the deferred 4020 after authoritative target classification.
SET DEBUG_SYNC='now SIGNAL closing_exclusion_timeout_classified_continue';

--connection closing_exclusion_race
--error ER_PRESERVE_TRX_SESSION_DRAINED
--reap

--connection closing_exclusion_ha
SET DEBUG_SYNC='now WAIT_FOR closing_exclusion_handoff TIMEOUT 60';

# FINAL_ACK already transferred ownership. The strict v1 receiver is
# process-local and may keep this payload entirely in memory, so validate the
# authoritative registry rather than assuming a carrier filename.
SELECT VARIABLE_VALUE=1 AS one_accepted_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';
SELECT VARIABLE_VALUE=2 AS two_survivors_receiving
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens';
SELECT VARIABLE_VALUE AS closing_inflight_commands
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_inflight_commands';
SELECT VARIABLE_VALUE AS closing_completed_before_deadline
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_completed_before_deadline';
SELECT VARIABLE_VALUE AS closing_excluded_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_excluded_tokens';
--replace_result $excluded_id EXCLUDED_ID
SELECT VARIABLE_VALUE AS closing_last_excluded_token
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_last_excluded_token';
SELECT VARIABLE_VALUE > 0 AS transfer_tail_measured
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_phase2_transfer_tail_us';
SELECT VARIABLE_VALUE > 0 AS closing_to_final_ack_measured
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_to_final_ack_us';

SET DEBUG_SYNC='now SIGNAL closing_exclusion_command_continue';
--connection closing_exclusion_timeout
--reap

--connection closing_exclusion_ha
SET DEBUG_SYNC='now SIGNAL closing_exclusion_shutdown';

--connection default
--replace_result $survivor_id SURVIVOR_ID $race_id RACE_ID $excluded_id EXCLUDED_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--reap

--connection closing_exclusion_ha
SHUTDOWN;

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

--eval SELECT @@GLOBAL.log_bin=$initial_log_bin AS binlog_mode_restored

DROP TABLE t_closing_timeout_exclusion;
DROP USER preserve_trx_ha_admin@localhost;
DROP USER closing_exclusion_app@localhost;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=30000;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=600000;
SET DEBUG_SYNC='RESET';
--remove_file $credential_file

--enable_query_log

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_no_binlog;
--enable_warnings

--let $old_rds_preserve_trx_enable= `SELECT @@GLOBAL.rds_preserve_trx_enable`

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_lock_warmcopy_no_binlog(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_no_binlog VALUES(1,10,REPEAT('a',32));

--connect(lock_wc_no_binlog_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_no_binlog SET v=11, pad=REPEAT('b',32)
  WHERE id=1;

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= lock warmcopy success is logged without binlog
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=warmcopy_success.*reason=ok
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
SELECT COUNT(*) AS preserved_count_no_binlog
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(lock_wc_no_binlog_resume, localhost, root,,test)
--connection lock_wc_no_binlog_resume
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
--disconnect lock_wc_no_binlog_resume

--connection default
SELECT COUNT(*) AS preserved_count_no_binlog_after_resume
  FROM performance_schema.preserved_transactions;
SELECT id, v, pad = REPEAT('b',32) AS pad_ok
  FROM t_lock_warmcopy_no_binlog
  ORDER BY id;

DROP TABLE t_lock_warmcopy_no_binlog;
--disable_query_log
--eval SET GLOBAL rds_preserve_trx_enable=$old_rds_preserve_trx_enable
--enable_query_log

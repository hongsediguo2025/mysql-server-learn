--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/closing-early-empty.secret
--write_file $credential_file
closing-early-empty-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS closing_early_empty_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'closing-early-empty-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER closing_early_empty_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_early_empty_app@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$MASTER_MYSOCK --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=closing_early_empty --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_batch_max_transactions=3;
SET GLOBAL preserve_trx_drain_phase2_timeout_ms=60000;
SET GLOBAL preserve_trx_transfer_prewarm_paused=ON;

CREATE TABLE t_closing_early_empty(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_early_empty VALUES(1,10),(2,20);

--connect(closing_early_empty_ha,localhost,preserve_trx_ha_admin,closing-early-empty-secret,test)

--connect(closing_early_empty_survivor,localhost,closing_early_empty_app,,test)
--let $survivor_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_closing_early_empty SET v=11 WHERE id=1;

# This SQL transaction has no redo/no-redo rseg update. Strict transfer must
# not manufacture a PREPARED transaction or publish it as a survivor.
--connect(closing_early_empty_no_token,localhost,closing_early_empty_app,,test)
START TRANSACTION;

# This transaction has an InnoDB trx_t and a record lock, but still has no
# redo/no-redo rseg update. It is not a strict-transfer survivor either.
--connect(closing_early_read_only,localhost,closing_early_empty_app,,test)
START TRANSACTION;
SELECT v INTO @locked_v FROM t_closing_early_empty WHERE id=2 FOR UPDATE;

--connect(closing_early_empty_owner,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_drain_after_shutdown_handoff SIGNAL closing_early_empty_handoff WAIT_FOR closing_early_empty_shutdown';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection closing_early_empty_ha
SET DEBUG_SYNC='now WAIT_FOR closing_early_empty_handoff TIMEOUT 60';
SELECT VARIABLE_VALUE=1 AS one_accepted_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';
SELECT VARIABLE_VALUE=1 AS one_survivor_receiving
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens';
SET DEBUG_SYNC='now SIGNAL closing_early_empty_shutdown';

--connection closing_early_empty_owner
--replace_result $survivor_id SURVIVOR_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--reap

--connection closing_early_empty_ha
SHUTDOWN;

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

DROP TABLE t_closing_early_empty;
DROP USER closing_early_empty_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC='RESET';
--remove_file $credential_file

--enable_query_log

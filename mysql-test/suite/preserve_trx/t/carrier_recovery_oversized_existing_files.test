--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_carrier_oversized_read;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .* failed: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction '.*' resume forced rollback: corrupt durable transaction snapshot");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_carrier_oversized_read(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_carrier_oversized_read VALUES(1,10),(2,20),(3,30);

--echo # oversized snapshot file
START TRANSACTION;
UPDATE t_carrier_oversized_read SET v=11 WHERE id=1;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx/include/get_preserved_token.inc
SET GLOBAL preserve_trx_max_snapshot_bytes=1;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_CORRUPT_SNAPSHOT
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET GLOBAL preserve_trx_max_snapshot_bytes=1073741824;

--echo # oversized binlog cache sidecar
START TRANSACTION;
UPDATE t_carrier_oversized_read SET v=21 WHERE id=2;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx/include/get_preserved_token.inc
--let _COR_TOKEN= $preserved_token
--perl
use strict;
use warnings;
use File::Spec;
my $token = $ENV{'_COR_TOKEN'} or die "missing token";
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
open(my $fh, '>', File::Spec->catfile($dir, "$token.binlog_cache"))
  or die "cannot write oversized binlog cache sidecar: $!";
binmode($fh);
print {$fh} 'C' x 64;
close($fh) or die "cannot close oversized sidecar: $!";
EOF
SET GLOBAL preserve_trx_max_binlog_cache_bytes=1;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_CORRUPT_SNAPSHOT
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET GLOBAL preserve_trx_max_binlog_cache_bytes=1073741824;

--echo # oversized generic blob sidecar
START TRANSACTION;
UPDATE t_carrier_oversized_read SET v=31 WHERE id=3;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx/include/get_preserved_token.inc
--let _COR_TOKEN= $preserved_token
--perl
use strict;
use warnings;
use File::Spec;
my $token = $ENV{'_COR_TOKEN'} or die "missing token";
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
open(my $fh, '>', File::Spec->catfile($dir, "$token.blob.extra"))
  or die "cannot write oversized generic sidecar: $!";
binmode($fh);
print {$fh} 'G' x 64;
close($fh) or die "cannot close oversized sidecar: $!";
EOF
SET GLOBAL preserve_trx_max_binlog_cache_bytes=1;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_CORRUPT_SNAPSHOT
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET GLOBAL preserve_trx_max_binlog_cache_bytes=1073741824;

SELECT * FROM t_carrier_oversized_read ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_carrier_oversized_read;
SET GLOBAL preserve_trx_enable=ON;

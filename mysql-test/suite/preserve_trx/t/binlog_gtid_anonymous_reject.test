--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_gtid_anonymous_reject;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_gtid_anonymous_reject(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_gtid_anonymous_reject VALUES(1,10);

SET GTID_NEXT='ANONYMOUS';
START TRANSACTION;
UPDATE t_gtid_anonymous_reject SET b=11 WHERE a=1;

--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;

SELECT * FROM t_gtid_anonymous_reject WHERE a=1;

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @bins = grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected no preserved snapshots in $dir, found " . scalar(@bins) . "\n"
  unless scalar(@bins) == 0;
EOF

ROLLBACK;
SET GTID_NEXT=DEFAULT;
SELECT @@SESSION.GTID_NEXT;

DROP TABLE t_gtid_anonymous_reject;
SET GLOBAL preserve_trx_enable=ON;

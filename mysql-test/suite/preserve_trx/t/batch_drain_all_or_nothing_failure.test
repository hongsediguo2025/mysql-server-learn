--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_all_or_nothing;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_all_or_nothing(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_all_or_nothing_a,localhost,root,,test)
--connection batch_all_or_nothing_a
START TRANSACTION;
INSERT INTO t_batch_all_or_nothing VALUES(1,10);

--connect(batch_all_or_nothing_b,localhost,root,,test)
--connection batch_all_or_nothing_b
START TRANSACTION;
INSERT INTO t_batch_all_or_nothing VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target";

--connection batch_all_or_nothing_a
COMMIT;
--disconnect batch_all_or_nothing_a

--connection batch_all_or_nothing_b
ROLLBACK;
--disconnect batch_all_or_nothing_b

--connection default
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT * FROM t_batch_all_or_nothing ORDER BY id;

DROP TABLE t_batch_all_or_nothing;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/standby-transfer-gtid-on.secret
--write_file $credential_file
standby-transfer-gtid-on-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@'127.0.0.1';
DROP USER IF EXISTS standby_transfer_gtid_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@'127.0.0.1'
  IDENTIFIED BY 'standby-transfer-gtid-on-secret';
GRANT SHUTDOWN, PROCESS, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON performance_schema.*
  TO preserve_trx_ha_admin@'127.0.0.1';
CREATE USER standby_transfer_gtid_app@localhost;
GRANT SELECT, UPDATE ON test.* TO standby_transfer_gtid_app@localhost;
GRANT SESSION_VARIABLES_ADMIN ON *.* TO standby_transfer_gtid_app@localhost;

# TCP loopback intentionally validates the source -> receiver wire path while
# keeping physical pages identical. Real two-process physical handoff is
# covered by the transfer pressure harness, not claimed by this MTR.
--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-host=127.0.0.1 --preserve-trx-transfer-target-port=$SERVER_MYPORT_1 --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=standby_transfer_gtid_on --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=30000;
SET GLOBAL preserve_trx_transfer_receiver_ready_timeout_ms=120000;

--connect(standby_transfer_gtid_ha,127.0.0.1,preserve_trx_ha_admin,standby-transfer-gtid-on-secret,test,$SERVER_MYPORT_1,)

--connection default
--disable_warnings
DROP TABLE IF EXISTS t_standby_transfer_gtid_on;
--enable_warnings
CREATE TABLE t_standby_transfer_gtid_on(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_standby_transfer_gtid_on VALUES(1,10),(2,20);

--connect(standby_transfer_gtid_logged,localhost,standby_transfer_gtid_app,,test)
--let $logged_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_standby_transfer_gtid_on SET v=11 WHERE id=1;

--connect(standby_transfer_gtid_nocache,localhost,standby_transfer_gtid_app,,test)
--let $nocache_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
SET SESSION sql_log_bin=0;
START TRANSACTION;
UPDATE t_standby_transfer_gtid_on SET v=21 WHERE id=2;

--connection default
--replace_result $logged_id LOGGED_ID $nocache_id NOCACHE_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

--connection standby_transfer_gtid_ha
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=2
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc

SELECT VARIABLE_VALUE=2 AS two_classified_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens';
SELECT VARIABLE_VALUE=2 AS two_ready_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens';
SELECT VARIABLE_VALUE=0 AS no_not_ready_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens';
SELECT VARIABLE_VALUE=1 AS one_accepted_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

--connect(standby_transfer_gtid_cleanup,localhost,root,,test)
DROP TABLE t_standby_transfer_gtid_on;
DROP USER standby_transfer_gtid_app@localhost;
DROP USER preserve_trx_ha_admin@'127.0.0.1';
--remove_file $credential_file

--enable_query_log

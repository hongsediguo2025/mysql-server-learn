# Verify RESET restores source ownership after failures that occur only after
# an early token has detached and staged receiver objects. DRAIN itself must
# leave the source transaction fenced.
--source include/have_debug.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/closing_early_failure.secret
--write_file $credential_file
closing-early-failure-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS closing_early_failure_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'closing-early-failure-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER closing_early_failure_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_early_failure_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=closing_early_failure --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

--disable_result_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc
--enable_result_log

SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=60000;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;

CREATE TABLE t_closing_early_failure(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_early_failure VALUES (1,10);

--connect(closing_early_failure_ha,localhost,preserve_trx_ha_admin,closing-early-failure-secret,test)
--connect(closing_early_failure_app,localhost,closing_early_failure_app,,test)
--let $app_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
--connect(closing_early_failure_owner,localhost,root,,test)

# Final metadata failure occurs after external objects were staged. The source
# transaction must be reattached to the same application THD.
--connection closing_early_failure_app
START TRANSACTION;
UPDATE t_closing_early_failure SET v=v+1 WHERE id=1;

--connection closing_early_failure_ha
SET GLOBAL debug='+d,preserve_trx_early_fail_candidate_finalize';

--connection closing_early_failure_owner
--replace_result $app_id APP_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection closing_early_failure_ha
SET GLOBAL debug='-d,preserve_trx_early_fail_candidate_finalize';

--connection closing_early_failure_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection closing_early_failure_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
UPDATE t_closing_early_failure SET v=v+10 WHERE id=1;

# The source stays fenced after the ownership boundary; verify the failed
# transaction was not applied twice only after a clean restart.
--disconnect closing_early_failure_app
--disconnect closing_early_failure_owner
--connection closing_early_failure_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --skip-log-bin --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=closing_early_failure --rds-preserve-trx-transfer-credential-secret-file=$credential_file" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--connect(closing_early_failure_check1,localhost,root,,test)
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc
--enable_query_log
SELECT v AS value_after_finalize_failure FROM t_closing_early_failure;
--disable_query_log

# A record-lock candidate has already been replaced when this injection stops
# its retransmission. Epoch ABORT and source restoration remain all-or-nothing.
--disconnect closing_early_failure_ha
--connect(closing_early_failure_ha,localhost,preserve_trx_ha_admin,closing-early-failure-secret,test)
--connect(closing_early_failure_app,localhost,closing_early_failure_app,,test)
START TRANSACTION;
UPDATE t_closing_early_failure SET v=v+1 WHERE id=1;

--connection closing_early_failure_ha
SET GLOBAL debug='+d,preserve_trx_early_force_one_coordinate_drift,preserve_trx_early_fail_replacement_stage';
--connect(closing_early_failure_owner,localhost,root,,test)

--connection closing_early_failure_app
--let $app_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
--connection closing_early_failure_owner
--replace_result $app_id APP_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection closing_early_failure_ha
SET GLOBAL debug='-d,preserve_trx_early_force_one_coordinate_drift,preserve_trx_early_fail_replacement_stage';

--connection closing_early_failure_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection closing_early_failure_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
UPDATE t_closing_early_failure SET v=v+100 WHERE id=1;

--disconnect closing_early_failure_app
--disconnect closing_early_failure_owner
--connection closing_early_failure_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--connect(closing_early_failure_check2,localhost,root,,test)
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc
--enable_query_log
SELECT v AS value_after_replacement_failure FROM t_closing_early_failure;
--disable_query_log

--connection closing_early_failure_check2
--disable_query_log
--disable_result_log
DROP TABLE t_closing_early_failure;
DROP USER closing_early_failure_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file
--enable_result_log
--enable_query_log

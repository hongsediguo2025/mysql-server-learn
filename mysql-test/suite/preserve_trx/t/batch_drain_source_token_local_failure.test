--source include/have_debug.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/source-token-local-failure.secret
--write_file $credential_file
source-token-local-failure-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS source_token_local_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'source-token-local-failure-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER source_token_local_app@localhost;
GRANT SELECT, UPDATE ON test.* TO source_token_local_app@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$MASTER_MYSOCK --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=source_token_local_failure --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL preserve_trx_batch_max_transactions=3;
SET GLOBAL preserve_trx_transfer_pipeline_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_transfer_prewarm_paused=ON;

CREATE TABLE t_source_token_local_failure(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_source_token_local_failure VALUES(1,10),(2,20),(3,30);

--connect(source_token_local_ha,localhost,preserve_trx_ha_admin,source-token-local-failure-secret,test)
--connect(source_token_local_app1,localhost,source_token_local_app,,test)
--let $app1_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_source_token_local_failure SET v=11 WHERE id=1;

--connect(source_token_local_app2,localhost,source_token_local_app,,test)
--let $app2_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_source_token_local_failure SET v=21 WHERE id=2;

--connect(source_token_local_app3,localhost,source_token_local_app,,test)
--let $app3_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_source_token_local_failure SET v=31 WHERE id=3;

--connection source_token_local_ha
SET GLOBAL debug='+d,preserve_trx_early_fail_candidate_finalize';

--connection default
--replace_result $app1_id APP1_ID $app2_id APP2_ID $app3_id APP3_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection source_token_local_ha
SET GLOBAL debug='-d,preserve_trx_early_fail_candidate_finalize';
SELECT VARIABLE_VALUE=1 AS one_accepted_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';
SELECT VARIABLE_VALUE=2 AS two_source_survivors
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens';

RESET DRAIN;

--connection source_token_local_app1
UPDATE t_source_token_local_failure SET v=v+100 WHERE id=1;
COMMIT;
--eval SELECT CONNECTION_ID()=$app1_id AS app1_same_connection

--connection source_token_local_app2
UPDATE t_source_token_local_failure SET v=v+100 WHERE id=2;
COMMIT;
--eval SELECT CONNECTION_ID()=$app2_id AS app2_same_connection

--connection source_token_local_app3
UPDATE t_source_token_local_failure SET v=v+100 WHERE id=3;
COMMIT;
--eval SELECT CONNECTION_ID()=$app3_id AS app3_same_connection

--connection source_token_local_ha
SELECT v FROM t_source_token_local_failure ORDER BY id;
SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

--connect(source_token_local_cleanup,localhost,root,,test)
DROP TABLE t_source_token_local_failure;
DROP USER source_token_local_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file

--enable_query_log

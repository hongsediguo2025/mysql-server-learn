--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;

CREATE TEMPORARY TABLE tmp_preserve_undo_extend(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  payload LONGBLOB NOT NULL,
  KEY(v)
) ENGINE=InnoDB;

--disable_query_log
--let $row= 1
while ($row <= 200)
{
  --eval INSERT INTO tmp_preserve_undo_extend VALUES($row, $row, REPEAT('a', 8192))
  --inc $row
}
--enable_query_log

START TRANSACTION;
UPDATE tmp_preserve_undo_extend
   SET v = v + 1000, payload = REPEAT('b', 8192)
 WHERE id BETWEEN 1 AND 10;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

--disable_query_log
--let $row= 11
while ($row <= 200)
{
  --eval UPDATE tmp_preserve_undo_extend SET v = v + 2000, payload = REPEAT('c', 8192) WHERE id = $row
  --inc $row
}
--enable_query_log

COMMIT;
SELECT COUNT(*) AS row_count,
       SUM(v) AS v_sum,
       SUM(LENGTH(payload)) AS payload_bytes
  FROM tmp_preserve_undo_extend;

DROP TEMPORARY TABLE tmp_preserve_undo_extend;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

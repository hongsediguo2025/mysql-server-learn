--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_kill_query;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_kill_query(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_kill_query VALUES(1,10);

--connect(preserve_kill_query,localhost,root,,test)
--connection preserve_kill_query
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_lock_materialization SIGNAL before_durable WAIT_FOR continue_preserve';
START TRANSACTION;
UPDATE t_preserve_kill_query SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR before_durable TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL QUERY $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_preserve';

--connection preserve_kill_query
--error ER_QUERY_INTERRUPTED
--reap
SET DEBUG_SYNC = 'RESET';
SELECT * FROM t_preserve_kill_query WHERE a=1;
ROLLBACK;
--disconnect preserve_kill_query

--connection default
SELECT * FROM t_preserve_kill_query WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_kill_query;
SET GLOBAL preserve_trx_enable=ON;

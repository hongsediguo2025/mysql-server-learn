--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

--connect(temp_rename_target, localhost, root,,test)
--connection temp_rename_target
CREATE TEMPORARY TABLE tmp_preserve_rename(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_preserve_rename VALUES(1, 10);

--connect(temp_rename_owner, localhost, root,,test)
--connection temp_rename_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_open SIGNAL temp_rename_warmcopy_open WAIT_FOR temp_rename_continue_warmcopy';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR temp_rename_warmcopy_open TIMEOUT 10';

--connection temp_rename_target
ALTER TABLE tmp_preserve_rename RENAME TO tmp_preserve_renamed;
START TRANSACTION;
INSERT INTO tmp_preserve_renamed VALUES(2, 20);

--connection default
SET DEBUG_SYNC = 'now SIGNAL temp_rename_continue_warmcopy';

--connection temp_rename_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect temp_rename_owner

--connection default
--remove_file $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection temp_rename_target
--error ER_NO_SUCH_TABLE
SELECT * FROM tmp_preserve_rename;
SELECT * FROM tmp_preserve_renamed ORDER BY id;
COMMIT;
DROP TEMPORARY TABLE tmp_preserve_renamed;
--disconnect temp_rename_target
--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET DEBUG_SYNC = 'RESET';

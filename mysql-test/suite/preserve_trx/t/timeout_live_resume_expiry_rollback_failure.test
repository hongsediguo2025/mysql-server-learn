--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction '.*' resume forced rollback: recovery timeout expired");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_timeout_resume_rollback_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET SESSION preserve_trx_min_timeout=1;
SET SESSION preserve_trx_default_timeout=1;
SET SESSION preserve_trx_max_timeout=86400;

CREATE TABLE t_timeout_resume_rollback_failure(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_timeout_resume_rollback_failure VALUES(1,10);

START TRANSACTION;
UPDATE t_timeout_resume_rollback_failure SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_one_second_timeout= 1
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--sleep 2

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-grace-seconds=30 --debug=d,preserve_trx_expired_reaper_skip" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--sleep 31

SET SESSION debug="+d,preserve_trx_fail_resume_timeout_rollback";
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug="-d,preserve_trx_fail_resume_timeout_rollback";

SELECT STATE,
       LAST_ERROR = 'recovery timeout expired; resume timeout rollback failure'
         AS last_error_preserved,
       LAST_ERROR_AT IS NOT NULL AS last_error_at_set
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT COUNT(*) AS preserved_count_after_retry_cleanup
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_timeout_resume_rollback_failure ORDER BY a;

DROP TABLE t_timeout_resume_rollback_failure;
SET GLOBAL preserve_trx_enable=ON;

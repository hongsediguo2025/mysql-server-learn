--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP USER IF EXISTS preserve_resume_cross_owner@localhost;
DROP TABLE IF EXISTS t_resume_session_child;
DROP TABLE IF EXISTS t_resume_session_parent;
DROP TABLE IF EXISTS t_resume_session_autoinc;
DROP TABLE IF EXISTS t_resume_session_seed;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_resume_session_parent(
  id INT PRIMARY KEY
) ENGINE=InnoDB;
CREATE TABLE t_resume_session_child(
  id INT PRIMARY KEY,
  parent_id INT,
  CONSTRAINT fk_resume_session_parent FOREIGN KEY(parent_id)
    REFERENCES t_resume_session_parent(id)
) ENGINE=InnoDB;
CREATE TABLE t_resume_session_autoinc(
  id INT AUTO_INCREMENT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
CREATE TABLE t_resume_session_seed(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_resume_session_seed VALUES(1,10);

CREATE USER preserve_resume_cross_owner@localhost;
GRANT RESUME_ANY_PRESERVED_TRANSACTION ON *.* TO
  preserve_resume_cross_owner@localhost;
GRANT SELECT, INSERT, UPDATE, DELETE ON test.* TO
  preserve_resume_cross_owner@localhost;

--connect(session_target,localhost,root,,test)
SET SESSION sql_log_bin=0;
SET SESSION autocommit=0;
SET SESSION foreign_key_checks=0;
SET SESSION unique_checks=0;
SET SESSION auto_increment_increment=7;
SET SESSION auto_increment_offset=3;
START TRANSACTION;
UPDATE t_resume_session_seed SET v=11 WHERE id=1;

--connection default

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source include/wait_until_disconnected.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --log-bin=preserve-trx-session-continuation-bin --server-id=1 --binlog-format=ROW" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(cross_owner,localhost,preserve_resume_cross_owner,,test)
--replace_result $preserved_token TOKEN
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect cross_owner
--connection default

SET SESSION binlog_format=STATEMENT;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION binlog_format=ROW;

SET SESSION session_track_transaction_info=STATE;
--enable_session_track_info
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.autocommit AS restored_autocommit,
       @@session.foreign_key_checks AS restored_foreign_key_checks,
       @@session.unique_checks AS restored_unique_checks,
       @@session.auto_increment_increment AS restored_auto_increment_increment,
       @@session.auto_increment_offset AS restored_auto_increment_offset;
INSERT INTO t_resume_session_child VALUES(1,999);
INSERT INTO t_resume_session_autoinc(v) VALUES(10);
SELECT LAST_INSERT_ID() AS resumed_auto_increment_id;
ROLLBACK;
--disable_session_track_info

SELECT * FROM t_resume_session_seed;
SELECT COUNT(*) AS child_rows_after_rollback FROM t_resume_session_child;
SELECT COUNT(*) AS autoinc_rows_after_rollback FROM t_resume_session_autoinc;

SET SESSION autocommit=1;
SET SESSION sql_log_bin=1;
DROP USER preserve_resume_cross_owner@localhost;
DROP TABLE t_resume_session_child;
DROP TABLE t_resume_session_parent;
DROP TABLE t_resume_session_autoinc;
DROP TABLE t_resume_session_seed;

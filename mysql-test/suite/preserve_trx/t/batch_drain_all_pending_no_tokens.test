--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_all_pending_no_tokens;
--disable_query_log
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_query_log
--enable_warnings

--disable_query_log
CREATE USER preserve_trx_ha_admin@localhost;
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_all_pending_no_tokens(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_all_pending_no_tokens VALUES(1,10),(2,20);

--connect(batch_no_token_a,localhost,root,,test)
--connection batch_no_token_a
SET DEBUG_SYNC =
  'before_execute_sql_command SIGNAL batch_no_token_a_ready WAIT_FOR continue_batch_no_token_a';
--send UPDATE t_batch_all_pending_no_tokens SET v=11 WHERE id=1

--connect(batch_no_token_b,localhost,root,,test)
--connection batch_no_token_b
SET DEBUG_SYNC =
  'before_execute_sql_command SIGNAL batch_no_token_b_ready WAIT_FOR continue_batch_no_token_b';
--send UPDATE t_batch_all_pending_no_tokens SET v=21 WHERE id=2

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR batch_no_token_a_ready TIMEOUT 10';
SET DEBUG_SYNC = 'now WAIT_FOR batch_no_token_b_ready TIMEOUT 10';

--connect(batch_no_token_control,localhost,preserve_trx_ha_admin,,test)

--connect(batch_no_token_owner,localhost,root,,test)
--connection batch_no_token_owner
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection batch_no_token_control
SET DEBUG_SYNC = 'now SIGNAL continue_batch_no_token_a';
SET DEBUG_SYNC = 'now SIGNAL continue_batch_no_token_b';

--connection batch_no_token_a
--reap
--disconnect batch_no_token_a

--connection batch_no_token_b
--reap
--disconnect batch_no_token_b

--connection batch_no_token_owner
--reap
--disconnect batch_no_token_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_batch_all_pending_no_tokens ORDER BY id;

DROP TABLE t_batch_all_pending_no_tokens;
--disable_query_log
DROP USER preserve_trx_ha_admin@localhost;
--enable_query_log
SET GLOBAL preserve_trx_enable=ON;

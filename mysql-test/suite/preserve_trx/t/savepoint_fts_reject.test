--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_savepoint_fts_reject;
DROP TABLE IF EXISTS t_savepoint_fts_before_engine;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_savepoint_fts_reject(
  id INT PRIMARY KEY AUTO_INCREMENT,
  body TEXT,
  FULLTEXT KEY body_ft(body)
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO t_savepoint_fts_reject(body) VALUES('before savepoint');
SAVEPOINT fts_s1;
INSERT INTO t_savepoint_fts_reject(body) VALUES('after savepoint');

--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

ROLLBACK;
SELECT COUNT(*) AS row_count FROM t_savepoint_fts_reject;

CREATE TABLE t_savepoint_fts_before_engine(
  id INT PRIMARY KEY AUTO_INCREMENT,
  body TEXT,
  FULLTEXT KEY body_ft(body)
) ENGINE=InnoDB;

START TRANSACTION;
SAVEPOINT fts_before_engine;
INSERT INTO t_savepoint_fts_before_engine(body) VALUES('after savepoint');

--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

ROLLBACK;
SELECT COUNT(*) AS row_count FROM t_savepoint_fts_before_engine;

DROP TABLE t_savepoint_fts_reject;
DROP TABLE t_savepoint_fts_before_engine;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_missing_prebuilt;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;

CREATE TABLE t_warmcopy_missing_prebuilt(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_warmcopy_missing_prebuilt VALUES(1,10);

--connect(warmcopy_missing_owner, localhost, root,,test)
--connection warmcopy_missing_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_missing_hwm WAIT_FOR warmcopy_missing_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_missing_hwm TIMEOUT 10';
--connect(warmcopy_missing_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_missing_prebuilt SET v=11 WHERE id=1;
--connection default
SET DEBUG_SYNC = 'now SIGNAL warmcopy_missing_continue';

--connection warmcopy_missing_owner
--reap
--disconnect warmcopy_missing_owner
--remove_file $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--let $token= `SELECT TOKEN FROM performance_schema.preserved_transactions`

--connect(warmcopy_missing_resume, localhost, root,,test)
--connection warmcopy_missing_resume
--replace_result $token TOKEN
--eval RESUME PRESERVED TRANSACTION '$token'
COMMIT;
--disconnect warmcopy_missing_resume

--connection default
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_warmcopy_missing_prebuilt;
SELECT COALESCE((SELECT CAST(VARIABLE_VALUE AS SIGNED)
                   FROM performance_schema.global_status
                  WHERE VARIABLE_NAME =
                        'Preserve_trx_warmcopy_provider_full_copy_to_count'),
                -1) AS full_copy_to_count;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_missing_prebuilt;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET DEBUG_SYNC = 'RESET';

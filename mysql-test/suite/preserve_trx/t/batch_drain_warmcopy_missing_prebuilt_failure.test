--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

# Lint-only source-shape preflight. Runtime evidence in this file comes from
# the DRAIN/RESUME, P_S, status-variable, and residue assertions below.
--perl
use strict;
use warnings;
use File::Spec;

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));
my $path = File::Spec->catfile($source_root, 'sql', 'preserve_trx.cc');
open(my $fh, '<', $path) or die "cannot open $path: $!";
my $src = do { local $/; <$fh> };
close($fh);

$src =~ /bool preserve_trx_kernel_preserve_attached_transaction\s*\(.*?^}/ms
  or die "could not find preserve_trx_kernel_preserve_attached_transaction\n";
my $body = $&;
die "warm-copy provider must fail closed when a logged target has no prebuilt blob\n"
  unless $body =~ /binlog_blob_provider\s*!=\s*nullptr/s &&
         $body =~ /!\s*binlog_blob_provider->has_blob_for_thd\s*\(\s*thd\s*\)/s &&
         $body =~ /return preserve_trx_reject_unsupported\s*\(\s*\)/s;
EOF

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_missing_prebuilt;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;

CREATE TABLE t_warmcopy_missing_prebuilt(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_warmcopy_missing_prebuilt VALUES(1,10);

--connect(warmcopy_missing_owner, localhost, root,,test)
--connection warmcopy_missing_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_missing_hwm WAIT_FOR warmcopy_missing_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_missing_hwm TIMEOUT 10';
--connect(warmcopy_missing_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_missing_prebuilt SET v=11 WHERE id=1;
--connection default
SET DEBUG_SYNC = 'now SIGNAL warmcopy_missing_continue';

--connection warmcopy_missing_owner
--reap
--disconnect warmcopy_missing_owner
--remove_file $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--let $token= `SELECT TOKEN FROM performance_schema.preserved_transactions`

--connect(warmcopy_missing_resume, localhost, root,,test)
--connection warmcopy_missing_resume
--replace_result $token TOKEN
--eval RESUME PRESERVED TRANSACTION '$token'
COMMIT;
--disconnect warmcopy_missing_resume

--connection default
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_warmcopy_missing_prebuilt;
SELECT COALESCE((SELECT CAST(VARIABLE_VALUE AS SIGNED)
                   FROM performance_schema.global_status
                  WHERE VARIABLE_NAME =
                        'Preserve_trx_warmcopy_provider_full_copy_to_count'),
                -1) AS full_copy_to_count;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_missing_prebuilt;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET DEBUG_SYNC = 'RESET';

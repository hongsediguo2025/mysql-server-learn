--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_force_recovery_taint_fail;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Found 1 prepared XA transactions");
CALL mtr.add_suppression("Skip updating information_schema metadata in InnoDB read-only mode");
CALL mtr.add_suppression("Skip re-populating collations and character sets tables in InnoDB read-only mode");
CALL mtr.add_suppression("PRESERVE: failed to mark preserved transaction snapshot tainted during startup Resurrection Index preamble");
CALL mtr.add_suppression("Assertion failure: ha_innodb.cc:.*ib::fatal triggered");
CALL mtr.add_suppression("\\[FATAL\\] Error in DDL Log recovery during Post-Recovery processing");
CALL mtr.add_suppression("Assertion failure: ut0ut.cc:.*");
CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
CALL mtr.add_suppression("PRESERVE: rolled back prepared transaction without snapshot during recovery");
CALL mtr.add_suppression("Plugin initialization aborted at srv0start.cc.* with error Generic error");
CALL mtr.add_suppression("Failed to initialize DD Storage Engine");
CALL mtr.add_suppression("Data Dictionary initialization failed");
CALL mtr.add_suppression("Aborting");
--enable_query_log

CREATE TABLE t_force_recovery_taint_fail(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_force_recovery_taint_fail VALUES(1,10);

START TRANSACTION;
UPDATE t_force_recovery_taint_fail SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc
--perl
use strict;
use warnings;
use File::Spec;
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @entries = readdir($dh);
closedir($dh);
my @caches = grep { /\.binlog_cache$/ } @entries;
die "expected one preserved binlog cache in $dir, found " . scalar(@caches) . "\n"
  unless scalar(@caches) == 1;
EOF

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= --rds-preserve-trx-enable=ON --innodb-force-recovery=1 --debug=d,preserve_trx_fail_write_tainted_marker
--source include/start_mysqld_expecting_crash.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= PRESERVE: failed to mark preserved transaction snapshot tainted during startup Resurrection Index preamble
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/wait_for_expected_crash.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc
--perl
use strict;
use warnings;
use File::Spec;
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @entries = readdir($dh);
closedir($dh);
my @caches = grep { /\.binlog_cache$/ } @entries;
die "expected one retained binlog cache after taint marker failure in $dir, found " .
    scalar(@caches) . "\n"
  unless scalar(@caches) == 1;
EOF

--source suite/preserve_trx/include/ha_crash_abandon_preserve_artifacts.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_failed_taint
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_force_recovery_taint_fail ORDER BY a;
SELECT COUNT(*) AS preserved_count_after_resume_commit
  FROM performance_schema.preserved_transactions;

DROP TABLE t_force_recovery_taint_fail;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/big_test.inc
--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--perl
use strict;
use warnings;
use File::Spec;

my $vardir = $ENV{'MYSQLTEST_VARDIR'} or die "MYSQLTEST_VARDIR is not set";
my $setup_file = File::Spec->catfile($vardir, 'tmp',
                                     'batch_long_boundary_setup.inc');
my $apps_file = File::Spec->catfile($vardir, 'tmp',
                                    'batch_long_boundary_apps.inc');
my $finish_file = File::Spec->catfile($vardir, 'tmp',
                                      'batch_long_boundary_finish.inc');
my $disconnect_file = File::Spec->catfile($vardir, 'tmp',
                                          'batch_long_boundary_disconnect.inc');
my $cleanup_file = File::Spec->catfile($vardir, 'tmp',
                                       'batch_long_boundary_cleanup.inc');

open(my $setup, '>', $setup_file)
  or die "cannot open $setup_file for write: $!";
open(my $apps, '>', $apps_file)
  or die "cannot open $apps_file for write: $!";
open(my $finish, '>', $finish_file)
  or die "cannot open $finish_file for write: $!";
open(my $disconnect, '>', $disconnect_file)
  or die "cannot open $disconnect_file for write: $!";
open(my $cleanup, '>', $cleanup_file)
  or die "cannot open $cleanup_file for write: $!";

print $cleanup "DROP TABLE IF EXISTS t_batch_boundary_extra;\n";
print $cleanup "DROP TABLE IF EXISTS t_batch_boundary_base;\n";
print $cleanup "DROP TABLE IF EXISTS t_batch_boundary_control;\n";

print $setup "CREATE TABLE t_batch_boundary_control(" .
             "sid INT PRIMARY KEY, " .
             "case_id INT NOT NULL, " .
             "group_id INT NOT NULL, " .
             "end_action ENUM('COMMIT','ROLLBACK') NOT NULL" .
             ") ENGINE=InnoDB;\n";
print $setup "CREATE TABLE t_batch_boundary_base(" .
             "sid INT PRIMARY KEY, " .
             "group_id INT NOT NULL, " .
             "v INT NOT NULL, " .
             "marker VARCHAR(64) NOT NULL, " .
             "heartbeat INT NOT NULL DEFAULT 0, " .
             "KEY idx_group_v(group_id, v)" .
             ") ENGINE=InnoDB;\n";
print $setup "CREATE TABLE t_batch_boundary_extra(" .
             "sid INT NOT NULL, " .
             "k INT NOT NULL, " .
             "v INT NOT NULL, " .
             "note VARCHAR(64) NOT NULL, " .
             "PRIMARY KEY(sid, k), " .
             "KEY idx_note(note)" .
             ") ENGINE=InnoDB;\n";

for my $sid (1 .. 100) {
  my $case_id = (($sid - 1) % 20) + 1;
  my $group_id = $sid <= 40 ? 1 : $sid <= 60 ? 2 : $sid <= 75 ? 3 :
                 $sid <= 90 ? 4 : 5;
  my $end_action = ($group_id == 2 || $group_id == 4) ? 'ROLLBACK' : 'COMMIT';
  print $setup "INSERT INTO t_batch_boundary_control " .
               "VALUES($sid,$case_id,$group_id,'$end_action');\n";
  print $setup "INSERT INTO t_batch_boundary_base " .
               "VALUES($sid,$group_id,$sid * 10,'seed',0);\n";
  for my $k (1 .. 4) {
    print $setup "INSERT INTO t_batch_boundary_extra " .
                 "VALUES($sid,$k,$sid * 100 + $k,'seed');\n";
  }
}

sub emit_measured {
  my ($fh, $sql) = @_;
  print $fh "SET \@batch_boundary_stmt_start = NOW(6);\n";
  print $fh "$sql;\n";
  print $fh "SET \@batch_boundary_stmt_us = " .
            "TIMESTAMPDIFF(MICROSECOND, \@batch_boundary_stmt_start, NOW(6));\n";
  print $fh "SET \@batch_boundary_max_stmt_us = " .
            "GREATEST(\@batch_boundary_max_stmt_us, \@batch_boundary_stmt_us);\n";
  print $fh "SET \@batch_boundary_sql_count = \@batch_boundary_sql_count + 1;\n";
}

for my $sid (1 .. 100) {
  my $case_id = (($sid - 1) % 20) + 1;
  my $group_id = $sid <= 40 ? 1 : $sid <= 60 ? 2 : $sid <= 75 ? 3 :
                 $sid <= 90 ? 4 : 5;
  my $name = sprintf("batch_boundary_app_%03d", $sid);
  print $apps "--connect($name,localhost,root,,test)\n";
  print $apps "--connection $name\n";
  print $apps "SET \@batch_boundary_sid = $sid;\n";
  print $apps "SET \@batch_boundary_case_id = $case_id;\n";
  print $apps "SET \@batch_boundary_sql_count = 0;\n";
  print $apps "SET \@batch_boundary_max_stmt_us = 0;\n";
  print $apps "START TRANSACTION;\n";
  emit_measured($apps, "UPDATE t_batch_boundary_base SET heartbeat = heartbeat + 1 WHERE sid = $sid");

  if ($group_id == 1) {
    emit_measured($apps, "UPDATE t_batch_boundary_base SET v = v + $case_id, marker = CONCAT('commit-dml-', $case_id) WHERE sid = $sid");
    emit_measured($apps, "INSERT INTO t_batch_boundary_extra VALUES($sid,10,$sid + $case_id,'commit-extra')");
  } elsif ($group_id == 2) {
    emit_measured($apps, "SAVEPOINT boundary_sp");
    emit_measured($apps, "UPDATE t_batch_boundary_base SET v = v + 2000 + $case_id, marker = CONCAT('rollback-savepoint-', $case_id) WHERE sid = $sid");
    emit_measured($apps, "UPDATE t_batch_boundary_extra SET note = 'rollback-extra' WHERE sid = $sid AND k = 2");
  } elsif ($group_id == 3) {
    emit_measured($apps, "SELECT SUM(v) INTO \@batch_boundary_seen FROM t_batch_boundary_extra WHERE sid = $sid");
    emit_measured($apps, "UPDATE t_batch_boundary_base SET v = v + \@batch_boundary_seen, marker = 'commit-readview' WHERE sid = $sid");
  } elsif ($group_id == 4) {
    emit_measured($apps, "INSERT INTO t_batch_boundary_extra VALUES($sid,20,$sid + 20,'rollback-insert')");
    emit_measured($apps, "UPDATE t_batch_boundary_base SET v = v + 4000, marker = 'rollback-insert' WHERE sid = $sid");
  } else {
    emit_measured($apps, "SELECT v INTO \@batch_boundary_locked FROM t_batch_boundary_base WHERE sid = $sid FOR UPDATE");
    emit_measured($apps, "UPDATE t_batch_boundary_base SET v = \@batch_boundary_locked + 5000 + $case_id, marker = 'commit-locking' WHERE sid = $sid");
  }

  print $finish "--connection $name\n";
  if ($group_id == 2 || $group_id == 4) {
    print $finish "ROLLBACK;\n";
  } else {
    print $finish "COMMIT;\n";
  }

  print $disconnect "--disconnect $name\n";
}
EOF

--let $batch_boundary_setup_file= $MYSQLTEST_VARDIR/tmp/batch_long_boundary_setup.inc
--let $batch_boundary_apps_file= $MYSQLTEST_VARDIR/tmp/batch_long_boundary_apps.inc
--let $batch_boundary_finish_file= $MYSQLTEST_VARDIR/tmp/batch_long_boundary_finish.inc
--let $batch_boundary_disconnect_file= $MYSQLTEST_VARDIR/tmp/batch_long_boundary_disconnect.inc
--let $batch_boundary_cleanup_file= $MYSQLTEST_VARDIR/tmp/batch_long_boundary_cleanup.inc

--disable_query_log
--disable_result_log
--source $batch_boundary_cleanup_file
--source $batch_boundary_setup_file
--source $batch_boundary_apps_file
--enable_result_log
--enable_query_log

--connection default
--let MYSQLD_DATADIR= `SELECT @@datadir`
--let $old_batch_max= `SELECT @@GLOBAL.preserve_trx_batch_max_transactions`
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_batch_max_transactions=99;
SELECT @@global.preserve_trx_batch_max_transactions AS batch_target_limit_probe;
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count_after_target_limit_probe
  FROM performance_schema.preserved_transactions;
SET GLOBAL preserve_trx_batch_max_transactions=256;
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target";

SELECT 1 AS shutdown_not_triggered_on_failure;
SELECT COUNT(*) AS preserved_count_after_cleanup
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/batch_drain_100_long_assert_clean.inc
SELECT 1 AS diagnostic_state_or_files_match_expectation;

--disable_query_log
--disable_result_log
--source $batch_boundary_finish_file
--source $batch_boundary_disconnect_file
--enable_result_log
--enable_query_log

--connection default
SELECT COUNT(*) AS session_count
  FROM t_batch_boundary_control;
SELECT group_id, end_action, COUNT(*) AS session_count
  FROM t_batch_boundary_control
 GROUP BY group_id, end_action
 ORDER BY group_id;
SELECT COUNT(*) AS committed_target_rows
  FROM t_batch_boundary_base
 WHERE (group_id IN (1,3,5) AND marker <> 'seed');
SELECT COUNT(*) AS rolled_back_target_rows
  FROM t_batch_boundary_base
 WHERE (group_id IN (2,4) AND marker = 'seed' AND v = sid * 10);
SELECT COUNT(*) AS committed_extra_rows
  FROM t_batch_boundary_extra
 WHERE note IN ('commit-extra');
SELECT COUNT(*) AS rolled_back_extra_rows
  FROM t_batch_boundary_extra
 WHERE note IN ('rollback-extra', 'rollback-insert');
SELECT COUNT(*) = 0 AS preserved_count_final
  FROM performance_schema.preserved_transactions;

SET GLOBAL preserve_trx_enable=ON;
--disable_query_log
--eval SET GLOBAL preserve_trx_batch_max_transactions=$old_batch_max
--enable_query_log
--disable_query_log
--disable_result_log
--source $batch_boundary_cleanup_file
--remove_file $batch_boundary_setup_file
--remove_file $batch_boundary_apps_file
--remove_file $batch_boundary_finish_file
--remove_file $batch_boundary_disconnect_file
--remove_file $batch_boundary_cleanup_file
--enable_result_log
--enable_query_log

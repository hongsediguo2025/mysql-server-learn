--source include/have_debug.inc

SET GLOBAL preserve_trx_enable=ON;

--connect(preserve_delivery_con, localhost, root,,test)
SET SESSION debug='+d,preserve_trx_debug_pending_token_delivery_no_shutdown,preserve_trx_skip_dispatch_finalize_statement_response';
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--disconnect preserve_delivery_con
--connection default

SELECT TOKEN, STATE
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-delivery-token';

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-delivery-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

SET GLOBAL preserve_trx_enable=ON;

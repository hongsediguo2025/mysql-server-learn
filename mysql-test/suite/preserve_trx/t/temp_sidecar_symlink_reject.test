--source include/not_windows.inc
--source include/force_restart.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery failed: preserved temporary table .* sidecar read failed");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved temporary table .* sidecar read failed");
CALL mtr.add_suppression("Preserved transaction .* recovery failed: preserved temporary table .* sidecar digest mismatch");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved temporary table .* sidecar digest mismatch");
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

--echo # image sidecar symlink is rejected
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source include/wait_until_disconnected.inc

--let TEMP_SNAPSHOT_TOKEN= temp_sidecar_image_symlink
--let TEMP_SNAPSHOT_SPACE_ID= 4243767321
--let TEMP_SNAPSHOT_INCLUDE_UNDO= 0
--source suite/preserve_trx/include/write_temp_table_preserved_snapshot.inc

--perl
use strict;
use warnings;
use File::Spec;

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
my $image = File::Spec->catfile(
  $preserve_dir, 'temp_sidecar_image_symlink.tempts.4243767321.image');
my $real = File::Spec->catfile($preserve_dir, 'temp-sidecar-image-real');
rename($image, $real) or die "cannot rename image sidecar: $!";
symlink($real, $image) or die "cannot create image sidecar symlink: $!";
print "temp image sidecar symlink installed\n";
EOF

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=OFF" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: preserved temporary table image sidecar digest mismatch
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_image_symlink
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--echo # undo sidecar symlink is rejected
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source include/wait_until_disconnected.inc

--let TEMP_SNAPSHOT_TOKEN= temp_sidecar_undo_symlink
--let TEMP_SNAPSHOT_SPACE_ID= 4243767322
--let TEMP_SNAPSHOT_INCLUDE_UNDO= 1
--source suite/preserve_trx/include/write_temp_table_preserved_snapshot.inc

--perl
use strict;
use warnings;
use File::Spec;

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
my $undo = File::Spec->catfile(
  $preserve_dir, 'temp_sidecar_undo_symlink.tempts.4243767322.undo');
my $real = File::Spec->catfile($preserve_dir, 'temp-sidecar-undo-real');
rename($undo, $real) or die "cannot rename undo sidecar: $!";
symlink($real, $undo) or die "cannot create undo sidecar symlink: $!";
print "temp undo sidecar symlink installed\n";
EOF

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=OFF" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: preserved temporary table undo sidecar digest mismatch
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_undo_symlink
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

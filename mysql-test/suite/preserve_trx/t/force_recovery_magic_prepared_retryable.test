--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_force_recovery_magic_retry;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Skip updating information_schema metadata in InnoDB read-only mode");
CALL mtr.add_suppression("Skip re-populating collations and character sets tables in InnoDB read-only mode");
CALL mtr.add_suppression("Found 1 prepared XA transactions");
CALL mtr.add_suppression("PRESERVE: preserved transaction recovery is not supported while innodb_force_recovery is enabled; snapshot and binlog-cache files are retained and marked tainted");
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: preserved transaction snapshot tainted");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_force_recovery_magic_retry(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_force_recovery_magic_retry VALUES(1,10);

START TRANSACTION;
UPDATE t_force_recovery_magic_retry SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --innodb-force-recovery=1" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.innodb_force_recovery AS force_recovery_after_restart;
SELECT COUNT(*) AS preserved_count_during_force_recovery
  FROM performance_schema.preserved_transactions;
--let MYSQLD_DATADIR= `SELECT @@datadir`
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $force_recovery_token_inc= $MYSQLTEST_VARDIR/tmp/force_recovery_magic_token.inc
--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @snapshots = sort grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected one preserved snapshot in $dir, found " . scalar(@snapshots) . "\n"
  unless scalar(@snapshots) == 1;
my $token = $snapshots[0];
$token =~ s/\.bin$//;
my $include_path = File::Spec->catfile($ENV{'MYSQLTEST_VARDIR'}, 'tmp',
                                       'force_recovery_magic_token.inc');
open(my $out, '>', $include_path)
  or die "cannot write $include_path: $!";
print $out "--let \$preserved_token= $token\n";
close($out);
EOF
--source $force_recovery_token_inc
--remove_file $force_recovery_token_inc
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $restart_parameters= restart: --preserve-trx-enable=ON --innodb-force-recovery=0
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT @@global.innodb_force_recovery AS force_recovery_after_normal_restart;
SELECT COUNT(*) AS preserved_count_after_normal_restart
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_force_recovery_magic_retry ORDER BY a;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_force_recovery_magic_retry;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_activate_cache_crash;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
--enable_query_log

SET SESSION sql_log_bin=0;
CREATE TABLE t_resume_activate_cache_crash(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_resume_activate_cache_crash VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;

--let $server_uuid= `SELECT @@GLOBAL.SERVER_UUID`
--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
INSERT INTO t_resume_activate_cache_crash VALUES(2,11);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--file_exists $PRESERVED_SNAPSHOT_FILE
--file_exists $PRESERVED_BINLOG_CACHE_FILE

SET SESSION debug="+d,preserve_trx_crash_after_resume_activate_before_snapshot_delete";
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

--replace_result $preserved_token TOKEN
--error 2013
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--error 1
--file_exists $PRESERVED_SNAPSHOT_FILE
--error 1
--file_exists $PRESERVED_BINLOG_CACHE_FILE

SELECT GTID_SUBSET(CONCAT(@@GLOBAL.SERVER_UUID, ':7'), @@GLOBAL.GTID_EXECUTED)
  AS explicit_gtid_not_committed;
SELECT * FROM t_resume_activate_cache_crash ORDER BY a;

SET SESSION sql_log_bin=0;
DROP TABLE t_resume_activate_cache_crash;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

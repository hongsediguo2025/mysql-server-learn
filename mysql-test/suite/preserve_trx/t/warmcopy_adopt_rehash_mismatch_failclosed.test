--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_adopt_rehash;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;

CREATE TABLE t_warmcopy_adopt_rehash(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_warmcopy_adopt_rehash VALUES(1,10);

--connect(warmcopy_adopt_rehash_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_adopt_rehash SET v=11 WHERE id=1;

--connect(warmcopy_adopt_rehash_owner, localhost, root,,test)
SET SESSION debug="+d,preserve_trx_corrupt_warmcopy_blob_after_descriptor";
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection warmcopy_adopt_rehash_owner
--reap
--disconnect warmcopy_adopt_rehash_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_text= corrupt warmcopy adopt is rejected during recovery
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot
--let $assert_count= 1
--source include/assert_grep.inc

SELECT COUNT(*) AS preserved_count_after_corrupt_warmcopy_adopt
  FROM performance_schema.preserved_transactions;

--connection default
SELECT * FROM t_warmcopy_adopt_rehash ORDER BY id;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_adopt_rehash;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET DEBUG_SYNC = 'RESET';

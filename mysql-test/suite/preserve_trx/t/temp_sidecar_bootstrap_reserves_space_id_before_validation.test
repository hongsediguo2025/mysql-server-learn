--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("TEMP_SIDECAR_RESERVED_BEFORE_VALIDATION");
CALL mtr.add_suppression("TEMP_SIDECAR_CORRUPT_DEFERRED");
CALL mtr.add_suppression("Preserved transaction .* recovery failed: preserved temporary table image sidecar digest mismatch");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved temporary table image sidecar digest mismatch");
--enable_query_log

SET GLOBAL rds_preserve_trx_enable=ON;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source include/wait_until_disconnected.inc

--let TEMP_SNAPSHOT_TOKEN= temp_sidecar_reserve_before_validate
--let TEMP_SNAPSHOT_SPACE_ID= 4243767323
--let TEMP_SNAPSHOT_CORRUPT_IMAGE= 1
--let TEMP_SNAPSHOT_INCLUDE_UNDO= 0
--source suite/preserve_trx/include/write_temp_table_preserved_snapshot.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON --debug=d,preserve_trx_trace_temp_sidecar_reserved_before_validate" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= TEMP_SIDECAR_RESERVED_BEFORE_VALIDATION token='.*' reason=reserved source space ids before sidecar digest validation
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= TEMP_SIDECAR_CORRUPT_DEFERRED token='.*' reason=preserved temporary table image sidecar digest mismatch
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_obs_a;
DROP TABLE IF EXISTS t_preserve_obs_b;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_obs_a(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t_preserve_obs_b(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_obs_a VALUES(1,10);
INSERT INTO t_preserve_obs_b VALUES(1,20);

START TRANSACTION;
UPDATE t_preserve_obs_a SET b=11 WHERE a=1;
UPDATE t_preserve_obs_b SET b=21 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN,
       CREATED_AT IS NOT NULL AS created_present,
       EXPIRES_AT IS NOT NULL AS expires_present,
       AGE_SECONDS >= 0 AS age_nonnegative,
       MOD_TABLES_COUNT
  FROM performance_schema.preserved_transactions;

--replace_column 1 TOKEN 5 CREATED_AT 6 EXPIRES_AT 8 AGE_SECONDS
SHOW PRESERVED TRANSACTIONS;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

DROP TABLE t_preserve_obs_a;
DROP TABLE t_preserve_obs_b;
SET GLOBAL preserve_trx_enable=ON;

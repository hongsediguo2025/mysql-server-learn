--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_transfer_mdl_binlog;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_resume_transfer_mdl_binlog(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_resume_transfer_mdl_binlog VALUES(1,10),(2,20);
RESET MASTER;

START TRANSACTION;
UPDATE t_resume_transfer_mdl_binlog SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION debug="+d,preserve_trx_fail_resume_transfer_mdl";

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SET SESSION debug="-d,preserve_trx_fail_resume_transfer_mdl";

--replace_result $preserved_token TOKEN
SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions;

START TRANSACTION;
UPDATE t_resume_transfer_mdl_binlog SET b=12 WHERE a=2;
COMMIT;
SELECT * FROM t_resume_transfer_mdl_binlog ORDER BY a;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/resume_transfer_mdl_binlog_cleanup.mysqlbinlog
--let $assert_text= New transaction remains in binlog after transfer-MDL resume cleanup
--let $assert_file= $MYSQLTEST_VARDIR/tmp/resume_transfer_mdl_binlog_cleanup.mysqlbinlog
--let $assert_select= @2=12
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= Failed transfer-MDL resume transaction is discarded from imported binlog cache
--let $assert_file= $MYSQLTEST_VARDIR/tmp/resume_transfer_mdl_binlog_cleanup.mysqlbinlog
--let $assert_select= @2=11
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/resume_transfer_mdl_binlog_cleanup.mysqlbinlog

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

DROP TABLE t_resume_transfer_mdl_binlog;
SET GLOBAL preserve_trx_enable=ON;

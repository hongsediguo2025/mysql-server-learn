--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_current_durable;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_current_durable(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_current_durable_app,localhost,root,,test)
--connection batch_current_durable_app
START TRANSACTION;
INSERT INTO t_batch_current_durable VALUES(1,10);

--connection default
SET SESSION debug="+d,preserve_trx_fail_after_undo_prepared";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_after_undo_prepared";

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_current_durable_app
COMMIT;
--disconnect batch_current_durable_app

--connection default
SELECT * FROM t_batch_current_durable ORDER BY id;

DROP TABLE t_batch_current_durable;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_startup_resurrection_index;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_startup_resurrection_index(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_startup_resurrection_index VALUES(1,10),(2,20);

START TRANSACTION;
--disable_query_log
SELECT v INTO @startup_resurrection_read_view
  FROM t_startup_resurrection_index WHERE id=1;
--enable_query_log
UPDATE t_startup_resurrection_index SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin --debug=d,preserve_trx_fail_xid_lookup_claim" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_candidates')=1
    AS index_candidates,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_hits')=1
    AS index_hits,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_fallbacks')=0
    AS no_fallback,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_anchor_checks')>=1
    AS anchors_checked,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_pages')=0
    AS no_undo_body_pages,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_records')=0
    AS no_undo_body_records;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

START TRANSACTION;
UPDATE t_startup_resurrection_index SET v=21 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin --debug=d,preserve_trx_startup_force_resurrection_anchor_mismatch" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_candidates')=1
    AS index_candidates,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_hits')=0
    AS no_index_hit,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_fallbacks')=1
    AS one_fallback,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_pages')>0
    AS fallback_read_undo_pages,
  (SELECT VARIABLE_VALUE FROM performance_schema.global_status
     WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_records')>0
    AS fallback_read_undo_records;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_startup_resurrection_index ORDER BY id;
DROP TABLE t_startup_resurrection_index;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_no_readview_then_first_read;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_no_readview_then_first_read(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_no_readview_then_first_read VALUES(1,10),(2,20);

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_no_readview_then_first_read SET v=21 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT ISOLATION, HAS_READ_VIEW, RV_LOW_LIMIT_NO
  FROM performance_schema.preserved_transactions;

--connect(no_rv_writer_before, localhost, root,,test)
UPDATE t_no_readview_then_first_read SET v=11 WHERE id=1;
--disconnect no_rv_writer_before
--source include/wait_until_disconnected.inc

--connection default
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT v AS first_read_after_resume
  FROM t_no_readview_then_first_read
 WHERE id=1;

--connect(no_rv_writer_after, localhost, root,,test)
UPDATE t_no_readview_then_first_read SET v=12 WHERE id=1;
--disconnect no_rv_writer_after
--source include/wait_until_disconnected.inc

--connection default
SELECT v AS second_read_same_view
  FROM t_no_readview_then_first_read
 WHERE id=1;
SELECT v AS own_write_seen
  FROM t_no_readview_then_first_read
 WHERE id=2;

ROLLBACK;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SELECT * FROM t_no_readview_then_first_read ORDER BY id;

DROP TABLE t_no_readview_then_first_read;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_enable_off_drain;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_preserve_enable_off_drain(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_enable_off_drain VALUES(1,10),(2,20);

--connect(enable_off_target,localhost,root,,test)
--connection enable_off_target
START TRANSACTION;
UPDATE t_preserve_enable_off_drain SET v=11 WHERE id=1;

--connect(enable_off_owner,localhost,root,,test)
--connection enable_off_owner
SET DEBUG_SYNC =
  'preserve_trx_batch_after_one_target_preserved SIGNAL enable_off_draining WAIT_FOR continue_enable_off_draining';
--send DRAIN TRANSACTIONS PRESERVE

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.preserved_transactions WHERE STATE = 'DRAINING'
--source include/wait_condition.inc
SELECT COUNT(*) AS draining_rows
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'DRAINING';

--error ER_WRONG_ARGUMENTS
SET GLOBAL rds_preserve_trx_enable=OFF;
SELECT @@global.rds_preserve_trx_enable AS preserve_enable_still_on;

--connection enable_off_target
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_enable_off_draining';

--connection enable_off_owner
--reap
--disconnect enable_off_owner

--connection enable_off_target
--disconnect enable_off_target

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

DROP TABLE t_preserve_enable_off_drain;
SET GLOBAL rds_preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

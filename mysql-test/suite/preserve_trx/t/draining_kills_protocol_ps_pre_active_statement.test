--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_drain_protocol_ps;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_drain_mode=HARD;

CREATE TABLE t_preserve_drain_protocol_ps(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_drain_protocol_ps VALUES(1,10),(2,20);

--let $protocol_ps_writer_input= $MYSQLTEST_VARDIR/tmp/drain_protocol_ps_writer.test
--let $protocol_ps_writer_output= $MYSQLTEST_VARDIR/tmp/drain_protocol_ps_writer.out
--write_file $protocol_ps_writer_input
SET DEBUG_SYNC =
  'after_protocol_ps_inflight_mark SIGNAL protocol_ps_after_gate WAIT_FOR continue_protocol_ps';
--error 2013,ER_QUERY_INTERRUPTED
UPDATE t_preserve_drain_protocol_ps SET b=21 WHERE a=2;
--echo protocol_ps_writer_done
EOF
--exec echo "protocol_ps_writer_start" > $protocol_ps_writer_output
--exec_in_background $MYSQL_TEST --ps-protocol < $protocol_ps_writer_input >> $protocol_ps_writer_output 2>&1

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR protocol_ps_after_gate TIMEOUT 10';

--connect(drain_protocol_ps_preserve,localhost,root,,test)
--connection drain_protocol_ps_preserve
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_lock_materialization SIGNAL protocol_ps_preserve_ready WAIT_FOR continue_protocol_ps_preserve';
START TRANSACTION;
UPDATE t_preserve_drain_protocol_ps SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR protocol_ps_preserve_ready TIMEOUT 10';
--replace_result $preserve_conn_id PRESERVE_ID
--eval KILL QUERY $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_protocol_ps_preserve';

--connection drain_protocol_ps_preserve
--error ER_QUERY_INTERRUPTED
--reap
SET DEBUG_SYNC = 'RESET';
ROLLBACK;
--disconnect drain_protocol_ps_preserve

--connection default
SET DEBUG_SYNC = 'now SIGNAL continue_protocol_ps';

--let $grep_file= $protocol_ps_writer_output
--let $grep_pattern= protocol_ps_writer_done
--let $wait_timeout= 10
--source include/wait_for_pattern_in_file.inc
--let $wait_timeout= 0

--connection default
SELECT * FROM t_preserve_drain_protocol_ps ORDER BY a;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_drain_protocol_ps;
SET GLOBAL preserve_trx_enable=ON;
--remove_file $protocol_ps_writer_input
--remove_file $protocol_ps_writer_output

--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP USER IF EXISTS preserve_key_reader@localhost;
DROP TABLE IF EXISTS t_key_rotation_hmac;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`
--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery deferred cleanup: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .* failed: token not found");
--enable_query_log

CREATE USER preserve_key_reader@localhost;
GRANT RESUME_ANY_PRESERVED_TRANSACTION ON *.* TO preserve_key_reader@localhost;

SET GLOBAL preserve_trx_enable=ON;

--error ER_PARSE_ERROR
ALTER PRESERVE KEY ROTATE;

CREATE TABLE t_key_rotation_hmac(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_key_rotation_hmac VALUES(1,10);

START TRANSACTION;
UPDATE t_key_rotation_hmac SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--perl
use strict;
use warnings;
use Digest::SHA qw(sha256);
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
my $key_backup = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp', 'key_rotation_original.key');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @snapshots = grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected exactly one old-key snapshot before key replacement\n"
  unless @snapshots == 1;
my $token = $snapshots[0];
$token =~ s/\.bin\z//;
my $token_inc = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp', 'key_rotation_old_token.inc');
open(my $token_inc_fh, '>', $token_inc)
  or die "cannot write $token_inc: $!";
print {$token_inc_fh} "--let \$old_key_token= $token\n";
close($token_inc_fh);

open(my $key_in, '<', $key) or die "cannot read original key: $!";
binmode($key_in);
open(my $key_backup_fh, '>', $key_backup)
  or die "cannot write original key backup: $!";
binmode($key_backup_fh);
print {$key_backup_fh} do { local $/; <$key_in> };
close($key_backup_fh);
close($key_in);
chmod(0600, $key_backup) or die "cannot chmod original key backup: $!";

sub write_bound_preserve_key {
  my ($path, $hmac_key) = @_;
  die "bad replacement HMAC key length" unless length($hmac_key) == 32;
  my $auto_cnf = File::Spec->catfile($ENV{'MYSQLD_DATADIR'}, 'auto.cnf');
  open(my $ah, '<', $auto_cnf) or die "cannot read $auto_cnf: $!";
  my $auto_cnf_text = do { local $/; <$ah> };
  close($ah);
  $auto_cnf_text =~ /^server-uuid=([0-9a-fA-F-]{36})$/m
    or die "server-uuid not found in $auto_cnf";
  my $server_uuid = lc($1);
  my $normalized_preserve_dir = $dir;
  $normalized_preserve_dir .= '/'
    unless $normalized_preserve_dir =~ m{/$};
  my $payload =
    "MSPKEY1\0" .
    pack('v', 1) .
    $server_uuid .
    sha256($normalized_preserve_dir) .
    $hmac_key;
  open(my $key_fh, '>:raw', $path)
    or die "cannot replace key before restart: $!";
  print {$key_fh} $payload;
  close($key_fh);
  chmod(0600, $path) or die "cannot chmod replacement key: $!";
}

write_bound_preserve_key($key, 'R' x 32);
print "key replaced before restart\n";
EOF

--echo # restart: --preserve-trx-enable=ON --skip-log-bin
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
my $key_backup = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp', 'key_rotation_original.key');
unlink($key) or die "cannot remove replacement key before restore: $!";
rename($key_backup, $key) or die "cannot restore original key: $!";
chmod(0600, $key) or die "cannot chmod restored key: $!";
print "old_key_restored_after_failclosed\n1\n";
EOF

SELECT COUNT(*) AS preserved_after_key_restore
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_key_rotation_hmac ORDER BY a;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_key_rotation_hmac;

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
my $snapshot = File::Spec->catfile($dir, 'msp_key_rotation_token.bin');

open(my $key_fh, '>', $key) or die "cannot rotate key: $!";
binmode($key_fh);
print {$key_fh} ('K' x 32);
close($key_fh);
print "key replaced\n";

open(my $snapshot_fh, '>', $snapshot) or die "cannot create snapshot stub: $!";
binmode($snapshot_fh);
print {$snapshot_fh} "MSP_PRES";
print {$snapshot_fh} ("\0" x 128);
close($snapshot_fh);
print "snapshot stub exists\n" if -s $snapshot;
EOF

--connect(preserve_key_reader_con, localhost, preserve_key_reader,,test)
--error ER_PRESERVE_TRX_CORRUPT_SNAPSHOT
RESUME PRESERVED TRANSACTION 'msp_key_rotation_token';
--disconnect preserve_key_reader_con
--connection default

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $snapshot = File::Spec->catfile($dir, 'msp_key_rotation_token.bin');
die "corrupt snapshot was not cleaned" if -e $snapshot;
print "snapshot cleaned after corrupt resume\n";
EOF

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
open(my $key_fh, '>', $key) or die "cannot corrupt key: $!";
binmode($key_fh);
print {$key_fh} 'short';
close($key_fh);
print "key malformed\n";
EOF

--let $error_log= $MYSQLTEST_VARDIR/log/preserve_trx_key_rotation_malformed.err
--perl
use strict;
use warnings;
my $path = $ENV{'error_log'} || '';
unlink $path if $path ne '';
EOF

--error 1
--exec $MYSQLD_CMD --validate-config --preserve-trx-enable=ON --log-error=$error_log > $error_log 2>&1

--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= preserve_trx_enable=ON requires valid snapshot support
--source include/search_pattern.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
unlink($key) or die "cannot remove malformed key: $!";
EOF

DROP USER preserve_key_reader@localhost;
--remove_file $error_log

--let $restart_parameters= restart: --preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

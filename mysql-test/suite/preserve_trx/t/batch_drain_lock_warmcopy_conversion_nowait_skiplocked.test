--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost;
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_conversion_nowait;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_fallback= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_lock_warmcopy_conversion_nowait(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_conversion_nowait VALUES(1,10),(3,30);

--connect(lock_wc_conversion_nowait_ha,localhost,preserve_trx_ha_admin,,test)

--connect(lock_wc_conversion_nowait_app, localhost, root,,test)
START TRANSACTION;
INSERT INTO t_lock_warmcopy_conversion_nowait VALUES(2,20);

--connection default
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL lock_wc_conversion_nowait_closing WAIT_FOR lock_wc_conversion_nowait_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection lock_wc_conversion_nowait_ha
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_conversion_nowait_closing TIMEOUT 10';
SELECT 'conversion_command_barrier_observed' AS barrier_case;

--connect(lock_wc_conversion_skiplocked_reader, localhost, root,,test)
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT COUNT(*) AS skip_locked_rows
  FROM t_lock_warmcopy_conversion_nowait
  WHERE id=2
  FOR UPDATE SKIP LOCKED;

--connect(lock_wc_conversion_nowait_reader, localhost, root,,test)
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT id
  FROM t_lock_warmcopy_conversion_nowait
  WHERE id=2
  FOR UPDATE NOWAIT;

--connection lock_wc_conversion_nowait_ha
SET DEBUG_SYNC = 'now SIGNAL lock_wc_conversion_nowait_continue';

--connection default
--reap

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= lock warmcopy succeeds after conversion command barrier
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=warmcopy_success.*reason=ok
--let $assert_count_condition= >= 1
--source include/assert_grep.inc

SELECT COUNT(*) AS preserved_count_after_conversion_command_barrier
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc

--connection lock_wc_conversion_skiplocked_reader
--disconnect lock_wc_conversion_skiplocked_reader

--connection lock_wc_conversion_nowait_reader
--disconnect lock_wc_conversion_nowait_reader

--connect(lock_wc_conversion_nowait_resume, localhost, root,,test)
--connection lock_wc_conversion_nowait_resume
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--disconnect lock_wc_conversion_nowait_resume

--connection default
SELECT id, v FROM t_lock_warmcopy_conversion_nowait ORDER BY id;
DROP TABLE t_lock_warmcopy_conversion_nowait;
SET DEBUG_SYNC = 'RESET';

--disable_query_log
DROP USER preserve_trx_ha_admin@localhost;
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=$old_preserve_trx_lock_warmcopy_fallback
--eval SET GLOBAL preserve_trx_lock_warmcopy_enable=$old_preserve_trx_lock_warmcopy_enable
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log

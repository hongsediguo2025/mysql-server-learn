--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_record_lock_export_identity_drift;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("PRESERVE rejected.*record_lock_identity_drift");
--enable_query_log

CREATE TABLE t_record_lock_export_identity_drift(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_record_lock_export_identity_drift VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_record_lock_export_identity_drift SET v=11 WHERE id=1;
SELECT * FROM t_record_lock_export_identity_drift WHERE id=2 FOR SHARE;

SET SESSION debug='+d,preserve_trx_simulate_export_record_lock_identity_drift';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_simulate_export_record_lock_identity_drift';

SELECT * FROM t_record_lock_export_identity_drift ORDER BY id;
COMMIT;
SELECT * FROM t_record_lock_export_identity_drift ORDER BY id;

--let $assert_text= Record-lock export drift reason is logged
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE rejected.*record_lock_identity_drift
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

--source suite/preserve_trx/include/assert_no_preserve_residue.inc
DROP TABLE t_record_lock_export_identity_drift;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_row_pending_flush;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_row_pending_flush(a INT PRIMARY KEY, b VARCHAR(128)) ENGINE=InnoDB;
INSERT INTO t_row_pending_flush VALUES
  (1,'before'), (2,'before'), (3,'before'), (4,'before'), (5,'before'),
  (6,'before'), (7,'before'), (8,'before'), (9,'before'), (10,'before');

START TRANSACTION;
UPDATE t_row_pending_flush SET b=CONCAT('after-', a);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
  FROM performance_schema.preserved_transactions;

--file_exists $PRESERVED_BINLOG_CACHE_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT COUNT(*) AS rows_after_commit
  FROM t_row_pending_flush WHERE b = CONCAT('after-', a);

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/row_pending_flush.mysqlbinlog
--let $assert_text= Pending row update is flushed into exported LOGGED_WITH_CACHE payload
--let $assert_file= $MYSQLTEST_VARDIR/tmp/row_pending_flush.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_row_pending_flush`
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/row_pending_flush.mysqlbinlog

DROP TABLE t_row_pending_flush;
SET GLOBAL preserve_trx_enable=ON;

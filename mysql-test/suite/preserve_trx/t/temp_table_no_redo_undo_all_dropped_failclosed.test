--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_no_redo_drop_all_base;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_no_redo_drop_all_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

CREATE TEMPORARY TABLE tmp_temp_no_redo_drop_all_single(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_temp_no_redo_drop_all_single VALUES(1, 100);
UPDATE tmp_temp_no_redo_drop_all_single SET v = 101 WHERE id = 1;
DROP TEMPORARY TABLE tmp_temp_no_redo_drop_all_single;
INSERT INTO t_temp_no_redo_drop_all_base VALUES(1, 10);
--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT COUNT(*) AS preserved_count_after_single_reject
  FROM performance_schema.preserved_transactions;
INSERT INTO t_temp_no_redo_drop_all_base VALUES(2, 20);
COMMIT;

--connect(temp_drop_all_batch_app,localhost,root,,test)
--connection temp_drop_all_batch_app
CREATE TEMPORARY TABLE tmp_temp_no_redo_drop_all_batch(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_temp_no_redo_drop_all_batch VALUES(1, 300);
UPDATE tmp_temp_no_redo_drop_all_batch SET v = 301 WHERE id = 1;
DROP TEMPORARY TABLE tmp_temp_no_redo_drop_all_batch;
INSERT INTO t_temp_no_redo_drop_all_base VALUES(3, 30);

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SELECT COUNT(*) AS preserved_count_after_batch_reject
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection temp_drop_all_batch_app
INSERT INTO t_temp_no_redo_drop_all_base VALUES(4, 40);
COMMIT;
--disconnect temp_drop_all_batch_app

--connection default
SELECT * FROM t_temp_no_redo_drop_all_base ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_temp_no_redo_drop_all_base;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

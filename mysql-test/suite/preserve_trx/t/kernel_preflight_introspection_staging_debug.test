--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_kernel_preflight;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_kernel_preflight(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_kernel_preflight VALUES (1, 10);

START TRANSACTION;
SELECT v FROM t_kernel_preflight WHERE id = 1;
UPDATE t_kernel_preflight SET v = v + 1 WHERE id = 1;

SET SESSION debug='+d,preserve_trx_debug_kernel_preflight_observable';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION;
SET SESSION debug='-d,preserve_trx_debug_kernel_preflight_observable';

SELECT TOKEN, STATE, MOD_TABLES_COUNT, HAS_READ_VIEW, LAST_ERROR
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-kernel-preflight-token';

ROLLBACK;

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-kernel-preflight-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP TABLE t_kernel_preflight;
SET GLOBAL preserve_trx_enable=OFF;

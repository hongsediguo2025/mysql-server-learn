--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_timeout_snapshot_timestamp;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET SESSION preserve_trx_min_timeout=1;
SET SESSION preserve_trx_default_timeout=1;
SET SESSION preserve_trx_max_timeout=86400;

CREATE TABLE t_timeout_snapshot_timestamp(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_timeout_snapshot_timestamp VALUES(1,10);

--connect(preserve_timestamp,localhost,root,,test)
--connection preserve_timestamp
SET SESSION preserve_trx_min_timeout=1;
SET SESSION preserve_trx_default_timeout=1;
SET SESSION preserve_trx_max_timeout=86400;
SET DEBUG_SYNC =
  'preserve_trx_before_snapshot_timestamp SIGNAL before_snapshot_timestamp WAIT_FOR continue_snapshot_timestamp';
START TRANSACTION;
UPDATE t_timeout_snapshot_timestamp SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR before_snapshot_timestamp TIMEOUT 3';
--sleep 2
--exec perl -MTime::HiRes=time -e 'printf "%s %.6f\n", "--let " . chr(36) . "marker_epoch=", time' > $MYSQLTEST_VARDIR/tmp/timeout_snapshot_timestamp_marker.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_snapshot_timestamp';

--connection preserve_timestamp
--reap
--source include/wait_until_disconnected.inc

--connection default
--sleep 2
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source $MYSQLTEST_VARDIR/tmp/timeout_snapshot_timestamp_marker.inc
--disable_query_log
--eval SET @marker_epoch = $marker_epoch
--enable_query_log
SELECT p.CREATED_AT >= FROM_UNIXTIME(@marker_epoch) AS created_after_marker,
       TIMESTAMPDIFF(SECOND, p.CREATED_AT, p.EXPIRES_AT) AS timeout_seconds
  FROM performance_schema.preserved_transactions p;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

DROP TABLE t_timeout_snapshot_timestamp;
SET GLOBAL preserve_trx_enable=ON;

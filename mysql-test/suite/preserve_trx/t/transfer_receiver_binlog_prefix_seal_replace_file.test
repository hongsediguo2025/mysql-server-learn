--let $prefix_replace= 0
--let $prefix_fail= 0
--let $prefix_resize= 0
--let $prefix_copy_fault= 0
--let $prefix_rebuild= 0
--let $prefix_inflight= 0
--let $prefix_seal_mutation= 1
--let $prefix_seal_failure= 0
--source suite/preserve_trx/include/receiver_binlog_prefix_prewarm.inc

--perl
open my $fh, '<', "$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err" or die $!;
my @seals;
while (<$fh>) {
  if (/^CURRENT_TEST:/) { @seals = (); next; }
  push @seals, [$1, $2, $3]
    if /binlog prefix seal prefix_bytes=(\d+) read_bytes=(\d+) total_bytes=(\d+)/;
}
die "missing baseline and replacement verification" unless @seals >= 2;
my ($prefix, $read, $total) = @{$seals[-1]};
die "replacement reused an old checkpoint"
  unless $prefix == 0 && $read == $total && $total > $seals[0][2];
print "replaced_file_forces_full_verification\n1\n";
EOF

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_single_prepare_cleanup;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_single_prepare_cleanup(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_single_prepare_cleanup VALUES(1,10);

START TRANSACTION;
UPDATE t_single_prepare_cleanup SET v=11 WHERE id=1;
SET SESSION debug="+d,pfx_prepare_low";
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="-d,pfx_prepare_low";
SELECT * FROM t_single_prepare_cleanup WHERE id=1;
COMMIT;
SELECT * FROM t_single_prepare_cleanup WHERE id=1;
SELECT COUNT(*) AS preserved_count_after_ha_prepare_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

START TRANSACTION;
UPDATE t_single_prepare_cleanup SET v=12 WHERE id=1;
SET SESSION debug="+d,pfx_temp_prepare";
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="-d,pfx_temp_prepare";
SELECT * FROM t_single_prepare_cleanup WHERE id=1;
COMMIT;
SELECT * FROM t_single_prepare_cleanup WHERE id=1;
SELECT COUNT(*) AS preserved_count_after_temp_prepare_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_single_prepare_cleanup;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_default_on_base;
--enable_warnings

SELECT @@global.rds_preserve_trx_temp_table_enable AS temp_table_gate_default;
SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_temp_default_on_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_default_on_base VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_temp_default_on(
  id INT PRIMARY KEY,
  v INT,
  UNIQUE KEY uq_v(v)
) ENGINE=InnoDB;
INSERT INTO tmp_temp_default_on VALUES(1, 100), (2, 200);

START TRANSACTION;
UPDATE t_temp_default_on_base SET v = 11 WHERE id = 1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.rds_preserve_trx_temp_table_enable AS temp_table_gate_after_restart;
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_temp_default_on ORDER BY id;
--error ER_DUP_ENTRY
INSERT INTO tmp_temp_default_on VALUES(3, 100);
COMMIT;
SELECT * FROM t_temp_default_on_base ORDER BY id;

DROP TEMPORARY TABLE tmp_temp_default_on;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_temp_default_on_base;
SET GLOBAL rds_preserve_trx_enable=ON;

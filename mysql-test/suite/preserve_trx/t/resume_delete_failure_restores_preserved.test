--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_delete_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* snapshot cleanup failed after resume; transaction remains attached");
--enable_query_log

CREATE TABLE t_resume_delete_failure(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_resume_delete_failure VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_resume_delete_failure WHERE a=1 FOR UPDATE;
UPDATE t_resume_delete_failure SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let $PRESERVED_TAINTED_FILE= `SELECT CONCAT(@@global.preserve_trx_dir, '$preserved_token', '.tainted')`

SET SESSION debug="+d,preserve_trx_fail_delete_snapshot_files";

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SET SESSION debug="-d,preserve_trx_fail_delete_snapshot_files";

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* snapshot cleanup failed after resume; transaction remains attached
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_SNAPSHOT_FILE
--file_exists $PRESERVED_TAINTED_FILE

--let _TAINTED_FILE= $PRESERVED_TAINTED_FILE
--perl
use strict;
use warnings;
my $path = $ENV{'_TAINTED_FILE'} or die "missing tainted file path";
open(my $fh, '<', $path) or die "cannot open tainted marker $path: $!";
my $content = do { local $/; <$fh> };
close($fh);
die "unexpected tainted marker reason: $content"
  unless $content =~ /resume_cleanup_failure/;
EOF
--let _TAINTED_FILE=

COMMIT;
SELECT * FROM t_resume_delete_failure ORDER BY a;

DROP TABLE t_resume_delete_failure;
SET GLOBAL preserve_trx_enable=ON;

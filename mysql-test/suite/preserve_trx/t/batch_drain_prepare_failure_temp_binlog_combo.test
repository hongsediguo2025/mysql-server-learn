--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_prepare_temp_binlog;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_batch_prepare_temp_binlog(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

RESET MASTER;

--connect(batch_prepare_combo_app,localhost,root,,test)
--connection batch_prepare_combo_app
CREATE TEMPORARY TABLE tmp_batch_prepare_combo(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_batch_prepare_combo VALUES(1,100);
START TRANSACTION;
INSERT INTO t_batch_prepare_temp_binlog VALUES(1,10);

--connection default
SET SESSION debug="+d,pfx_prepare_low";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH USER VARS;
SET SESSION debug="-d,pfx_prepare_low";

SELECT COUNT(*) AS preserved_count_after_ha_prepare_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection batch_prepare_combo_app
SELECT COUNT(*) AS tmp_rows_after_ha_prepare_failure,
       SUM(v) AS tmp_sum_after_ha_prepare_failure
  FROM tmp_batch_prepare_combo;
INSERT INTO t_batch_prepare_temp_binlog VALUES(2,20);
COMMIT;

INSERT INTO tmp_batch_prepare_combo VALUES(2,200);
START TRANSACTION;
INSERT INTO t_batch_prepare_temp_binlog VALUES(3,30);

--connection default
SET SESSION debug="+d,pfx_temp_prepare";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH USER VARS;
SET SESSION debug="-d,pfx_temp_prepare";

SELECT COUNT(*) AS preserved_count_after_temp_prepare_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection batch_prepare_combo_app
SELECT COUNT(*) AS tmp_rows_after_temp_prepare_failure,
       SUM(v) AS tmp_sum_after_temp_prepare_failure
  FROM tmp_batch_prepare_combo;
INSERT INTO t_batch_prepare_temp_binlog VALUES(4,40);
COMMIT;
DROP TEMPORARY TABLE tmp_batch_prepare_combo;
--disconnect batch_prepare_combo_app

--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SELECT * FROM t_batch_prepare_temp_binlog ORDER BY id;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/batch_prepare_temp_binlog.mysqlbinlog
--let $assert_text= first restored batch transaction committed once
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_prepare_temp_binlog.mysqlbinlog
--let $assert_select= @1=1
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= first restored batch transaction post-failure row committed once
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_prepare_temp_binlog.mysqlbinlog
--let $assert_select= @1=2
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= second restored batch transaction committed once
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_prepare_temp_binlog.mysqlbinlog
--let $assert_select= @1=3
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= second restored batch transaction post-failure row committed once
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_prepare_temp_binlog.mysqlbinlog
--let $assert_select= @1=4
--let $assert_count= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/batch_prepare_temp_binlog.mysqlbinlog

DROP TABLE t_batch_prepare_temp_binlog;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

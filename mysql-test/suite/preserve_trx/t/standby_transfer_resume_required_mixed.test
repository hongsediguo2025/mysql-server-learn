--source include/have_debug.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--disable_result_log

--let $credential_file= $MYSQL_TMP_DIR/resume-required-mixed.secret
--write_file $credential_file
resume-required-mixed-secret
EOF
--exec chmod 600 $credential_file

--connect(mixed_receiver_root,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-required-mixed-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN,
      RESUME_ANY_PRESERVED_TRANSACTION,
      PROCESS, SYSTEM_VARIABLES_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
--connect(mixed_receiver_resume,127.0.0.1,preserve_trx_ha_admin,resume-required-mixed-secret,test,$SERVER_MYPORT_2,)

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS resume_required_mixed_app@localhost;
DROP TABLE IF EXISTS t_resume_required_mixed;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-required-mixed-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN, PROCESS ON *.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER resume_required_mixed_app@localhost;
GRANT SELECT, UPDATE ON test.* TO resume_required_mixed_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=resume_required_mixed --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--source include/restart_mysqld.inc
--let $restart_parameters=
--disable_query_log
--disable_result_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

CREATE TABLE t_resume_required_mixed(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_resume_required_mixed VALUES(1,10),(2,20),(3,30);

--connect(mixed_source_ha,localhost,preserve_trx_ha_admin,resume-required-mixed-secret,test)
--connect(mixed_source_app1,localhost,resume_required_mixed_app,,test)
--let $app1_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_resume_required_mixed SET v=11 WHERE id=1;

--connect(mixed_source_app2,localhost,resume_required_mixed_app,,test)
--let $app2_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_resume_required_mixed SET v=21 WHERE id=2;

--connect(mixed_source_app3,localhost,resume_required_mixed_app,,test)
--let $app3_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_resume_required_mixed SET v=31 WHERE id=3;

--connect(mixed_source_idle,localhost,resume_required_mixed_app,,test)
--let $idle_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)

# One token fails before transfer finalization. The other two are finalized and
# authenticated by COMMIT_EPOCH. None of the three transaction IDs enters S.
--connection mixed_source_ha
SET GLOBAL debug='+d,preserve_trx_early_fail_candidate_finalize';
SET GLOBAL debug='+d,preserve_trx_transfer_drop_commit_ack_twice';
--connection default
DRAIN TRANSACTIONS PRESERVE;
--connection mixed_source_ha
SET GLOBAL debug='-d,preserve_trx_early_fail_candidate_finalize';
SET GLOBAL debug='-d,preserve_trx_transfer_drop_commit_ack_twice';

# The MTR instances have independent datadirs, so neither transferred
# transaction can acquire the physical dictionary lease required for READY.
# Both must take the real NOT_READY path; the session-only ID remains usable.
--connection mixed_receiver_resume
--let $prewarm_total_before= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens', value, 1)
--let $prewarm_not_ready_before= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens', value, 1)
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=$prewarm_total_before+2
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc
--let $prewarm_not_ready_after= query_get_value(SELECT VARIABLE_VALUE AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens', value, 1)
--let $assert_text= mixed receiver prewarm has exactly two not-ready tokens
--let $assert_cond= $prewarm_not_ready_after = $prewarm_not_ready_before + 2
--source include/assert.inc

--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$app1_id'
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$app2_id'
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$app3_id'
--eval RESUME PRESERVED TRANSACTION '$idle_id'
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$idle_id'

# A canonical numeric ID absent from both S and the current epoch records fails.
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
RESUME PRESERVED TRANSACTION '184467';

# Non-canonical values cannot bypass an active connection-ID handoff.
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
RESUME PRESERVED TRANSACTION '01';
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
RESUME PRESERVED TRANSACTION 'not-a-connection-id';

--connection mixed_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--disable_result_log

--connect(mixed_source_cleanup,localhost,root,,test)
DROP TABLE t_resume_required_mixed;
DROP USER resume_required_mixed_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;

--connection mixed_receiver_root
DROP USER preserve_trx_ha_admin@localhost;

--connection mixed_source_cleanup
--remove_file $credential_file
--enable_result_log
SELECT 'ok' AS resume_required_mixed;
--enable_query_log

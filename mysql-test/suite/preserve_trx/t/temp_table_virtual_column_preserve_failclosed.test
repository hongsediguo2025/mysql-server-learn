--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_virtual_base;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_temp_virtual_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_virtual_base VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_temp_virtual(
  id INT PRIMARY KEY,
  v INT,
  g INT GENERATED ALWAYS AS (v + 1) VIRTUAL
) ENGINE=InnoDB;
INSERT INTO tmp_temp_virtual(id, v) VALUES(1, 100);

START TRANSACTION;
UPDATE t_temp_virtual_base SET v = 11 WHERE id = 1;
--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
COMMIT;
SELECT * FROM t_temp_virtual_base ORDER BY id;

DROP TEMPORARY TABLE tmp_temp_virtual;
DROP TABLE t_temp_virtual_base;
SET GLOBAL rds_preserve_trx_enable=ON;

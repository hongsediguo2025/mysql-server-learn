--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_global_off_to_on;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* rejected because snapshot binlog_state=GLOBAL_OFF_NO_CACHE requires log_bin=OFF");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: binlog mode mismatch");
--enable_query_log

CREATE TABLE t_global_off_to_on(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_global_off_to_on VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_global_off_to_on WHERE a=1 FOR UPDATE;
UPDATE t_global_off_to_on SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --log-bin=$MYSQLTEST_VARDIR/log/preserve_trx_on-bin
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--source include/start_mysqld.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* rejected because snapshot binlog_state=GLOBAL_OFF_NO_CACHE requires log_bin=OFF
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT * FROM t_global_off_to_on WHERE a=1;

--let $restart_parameters= restart: --preserve-trx-enable=ON --skip-log-bin
--source include/restart_mysqld.inc

DROP TABLE t_global_off_to_on;
SET GLOBAL preserve_trx_enable=ON;

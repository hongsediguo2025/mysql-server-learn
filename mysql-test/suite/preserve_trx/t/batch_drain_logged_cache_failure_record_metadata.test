--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files before reattach");
CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed after target preserve error");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted");

--disable_warnings
DROP TABLE IF EXISTS t_batch_logged_cache_failure_record;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_batch_logged_cache_failure_record(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_logged_cache_failure_record VALUES(1,10);

--connect(batch_logged_cache_failure_app,localhost,root,,test)
--connection batch_logged_cache_failure_app
START TRANSACTION;
UPDATE t_batch_logged_cache_failure_record SET v=11 WHERE id=1;

--connection default
SET SESSION debug="+d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_reattach_original_thd";
--error ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_reattach_original_thd";

SELECT COUNT(*) AS preserved_count_after_failure
  FROM performance_schema.preserved_transactions;

--perl
use strict;
use warnings;
use File::Spec;
require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite', 'preserve_trx',
                            'include', 'preserve_snapshot_files.pl');

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my @snapshots = PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
my @files = PreserveSnapshotFiles::preserve_all_files($dir);
my @caches = grep { /\.binlog_cache$/ } @files;
my @tainted = grep { /\.tainted$/ } @files;
die "expected one retained snapshot, found " . scalar(@snapshots) . "\n"
  unless @snapshots == 1;
die "expected one retained binlog cache, found " . scalar(@caches) . "\n"
  unless @caches == 1;
die "expected one tainted marker, found " . scalar(@tainted) . "\n"
  unless @tainted == 1;
EOF

--connection batch_logged_cache_failure_app
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--disconnect batch_logged_cache_failure_app

--connection default
--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_restart
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_batch_logged_cache_failure_record ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_batch_logged_cache_failure_record;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files before reattach");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed after target preserve error");

--disable_warnings
DROP TABLE IF EXISTS t_batch_logged_cache_failure_record;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_logged_cache_failure_record(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_logged_cache_failure_record VALUES(1,10);

--connect(batch_logged_cache_failure_app,localhost,root,,test)
--connection batch_logged_cache_failure_app
START TRANSACTION;
UPDATE t_batch_logged_cache_failure_record SET v=11 WHERE id=1;

--connection default
SET SESSION debug="+d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_reattach_original_thd";
--error ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_reattach_original_thd";

SELECT COUNT(*) AS preserved_count_after_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE,
       SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN
  FROM performance_schema.preserved_transactions;

--let $expect_bin= 1
--let $expect_binlog_cache= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

--connection batch_logged_cache_failure_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--disconnect batch_logged_cache_failure_app

--connection default
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_batch_logged_cache_failure_record ORDER BY id;

DROP TABLE t_batch_logged_cache_failure_record;
SET GLOBAL preserve_trx_enable=ON;

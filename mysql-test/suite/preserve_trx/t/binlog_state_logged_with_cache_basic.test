--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_logged_cache;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_logged_cache(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_logged_cache VALUES(1,10);

START TRANSACTION;
UPDATE t_logged_cache SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE,
       SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN
  FROM performance_schema.preserved_transactions;

--file_exists $PRESERVED_BINLOG_CACHE_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.sql_log_bin AS session_sql_log_bin_after_resume;
COMMIT;
SELECT * FROM t_logged_cache WHERE a=1;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/logged_cache.mysqlbinlog
--let $assert_text= Preserved LOGGED_WITH_CACHE update is written on final COMMIT
--let $assert_file= $MYSQLTEST_VARDIR/tmp/logged_cache.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_logged_cache`
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/logged_cache.mysqlbinlog

DROP TABLE t_logged_cache;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TEMPORARY TABLE tmp_preserve_mixed(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;

CREATE TABLE t_preserve_mixed(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO tmp_preserve_mixed VALUES(1, 10);
START TRANSACTION;
UPDATE tmp_preserve_mixed SET v = 11 WHERE id = 1;
INSERT INTO t_preserve_mixed VALUES(1, 100);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
UPDATE t_preserve_mixed SET v = 101 WHERE id = 1;
INSERT INTO t_preserve_mixed VALUES(2, 200);
COMMIT;
SELECT * FROM tmp_preserve_mixed ORDER BY id;
SELECT * FROM t_preserve_mixed ORDER BY id;

DROP TABLE t_preserve_mixed;
DROP TEMPORARY TABLE tmp_preserve_mixed;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to fsync preserved transaction directory after unlink");
CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");

--disable_warnings
DROP TABLE IF EXISTS t_batch_reattach_cleanup_delete;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_reattach_cleanup_delete(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_cleanup_after_unlink_a,localhost,root,,test)
--connection batch_cleanup_after_unlink_a
START TRANSACTION;
INSERT INTO t_batch_reattach_cleanup_delete VALUES(1,10);

--connect(batch_cleanup_after_unlink_b,localhost,root,,test)
--connection batch_cleanup_after_unlink_b
START TRANSACTION;
INSERT INTO t_batch_reattach_cleanup_delete VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_delete_snapshot_after_unlink";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_delete_snapshot_after_unlink";

SELECT 1 AS server_alive_after_unlink_cleanup_failure;
SELECT COUNT(*) AS preserved_count_after_unlink
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_cleanup_after_unlink_a
COMMIT;
--disconnect batch_cleanup_after_unlink_a

--connection batch_cleanup_after_unlink_b
ROLLBACK;
--disconnect batch_cleanup_after_unlink_b

--connection default
SELECT * FROM t_batch_reattach_cleanup_delete ORDER BY id;

--connect(batch_cleanup_before_unlink_a,localhost,root,,test)
--connection batch_cleanup_before_unlink_a
START TRANSACTION;
INSERT INTO t_batch_reattach_cleanup_delete VALUES(3,30);

--connect(batch_cleanup_before_unlink_b,localhost,root,,test)
--connection batch_cleanup_before_unlink_b
START TRANSACTION;
INSERT INTO t_batch_reattach_cleanup_delete VALUES(4,40);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_delete_snapshot_files";
--error ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_delete_snapshot_files";

SELECT COUNT(*) AS preserved_count_before_unlink
  FROM performance_schema.preserved_transactions;

--connection batch_cleanup_before_unlink_b
ROLLBACK;
--disconnect batch_cleanup_before_unlink_b

--connection batch_cleanup_before_unlink_a
SELECT 1;
COMMIT;
--disconnect batch_cleanup_before_unlink_a

--connection default
--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_before_unlink_restart
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT * FROM t_batch_reattach_cleanup_delete ORDER BY id;

DROP TABLE t_batch_reattach_cleanup_delete;
SET GLOBAL preserve_trx_enable=ON;

--let $old_preserve_trx_enable= `SELECT @@global.preserve_trx_enable`
--let $old_log_output= `SELECT @@global.log_output`
--let $old_general_log= `SELECT @@global.general_log`
--let $old_log_raw= `SELECT @@global.log_raw`
--let $old_slow_query_log= `SELECT @@global.slow_query_log`
--let $old_long_query_time= `SELECT @@global.long_query_time`
--let $old_log_slow_admin_statements= `SELECT @@global.log_slow_admin_statements`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL log_output='TABLE';
SET GLOBAL general_log=ON;
SET GLOBAL log_raw=ON;
SET GLOBAL slow_query_log=ON;
SET GLOBAL long_query_time=0;
SET SESSION long_query_time=0;
SET GLOBAL log_slow_admin_statements=ON;
TRUNCATE TABLE mysql.general_log;
TRUNCATE TABLE mysql.slow_log;

SET @redaction_matrix_token=CONCAT('msp_matrix_redaction_', 'abcd');
SET @redaction_matrix_redacted=CONCAT('****', RIGHT(@redaction_matrix_token, 4));

--disable_query_log
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .* failed: token not found");
--enable_query_log

--disable_query_log
--error ER_PRESERVE_TRX_NOT_FOUND
RESUME PRESERVED TRANSACTION 'msp_matrix_redaction_abcd';
--enable_query_log

SELECT COUNT(*) AS raw_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE CONCAT('%', @redaction_matrix_token, '%');
SELECT COUNT(*) > 0 AS redacted_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE '%RESUME PRESERVED TRANSACTION%'
   AND argument LIKE CONCAT('%', @redaction_matrix_redacted, '%');

SELECT COUNT(*) AS raw_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE CONCAT('%', @redaction_matrix_token, '%');
SELECT COUNT(*) > 0 AS redacted_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE '%RESUME PRESERVED TRANSACTION%'
   AND sql_text LIKE CONCAT('%', @redaction_matrix_redacted, '%');

SET @redaction_comment_token=CONCAT('msp_matrix_comment_', 'wxyz');
SET @redaction_comment_redacted=CONCAT('****', RIGHT(@redaction_comment_token, 4));

--disable_query_log
--error ER_PRESERVE_TRX_NOT_FOUND
RESUME/**/PRESERVED/*!99999 ignored */TRANSACTION 'msp_matrix_comment_wxyz';
--enable_query_log

SELECT COUNT(*) AS raw_comment_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE CONCAT('%', @redaction_comment_token, '%');
SELECT COUNT(*) > 0 AS redacted_comment_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE '%RESUME%'
   AND argument LIKE CONCAT('%', @redaction_comment_redacted, '%');

SELECT COUNT(*) AS raw_comment_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE CONCAT('%', @redaction_comment_token, '%');
SELECT COUNT(*) > 0 AS redacted_comment_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE '%RESUME%'
   AND sql_text LIKE CONCAT('%', @redaction_comment_redacted, '%');

SET @redaction_line_token=CONCAT('msp_matrix_line_', 'lmno');
SET @redaction_line_redacted=CONCAT('****', RIGHT(@redaction_line_token, 4));

--disable_query_log
--error ER_PRESERVE_TRX_NOT_FOUND
RESUME -- line comment before PRESERVED
PRESERVED # hash comment before TRANSACTION
TRANSACTION 'msp_matrix_line_lmno';
--enable_query_log

SELECT COUNT(*) AS raw_line_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE CONCAT('%', @redaction_line_token, '%');
SELECT COUNT(*) > 0 AS redacted_line_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE '%RESUME%'
   AND argument LIKE CONCAT('%', @redaction_line_redacted, '%');

SELECT COUNT(*) AS raw_line_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE CONCAT('%', @redaction_line_token, '%');
SELECT COUNT(*) > 0 AS redacted_line_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE '%RESUME%'
   AND sql_text LIKE CONCAT('%', @redaction_line_redacted, '%');

SET @redaction_version_token=CONCAT('msp_matrix_version_', 'v123');
SET @redaction_version_redacted=CONCAT('****', RIGHT(@redaction_version_token, 4));

--disable_query_log
--error ER_PRESERVE_TRX_NOT_FOUND
RESUME /*!80000 PRESERVED */ /*!80000 TRANSACTION */ 'msp_matrix_version_v123';
--enable_query_log

SELECT COUNT(*) AS raw_version_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE CONCAT('%', @redaction_version_token, '%');
SELECT COUNT(*) > 0 AS redacted_version_token_in_general_log
  FROM mysql.general_log
 WHERE argument LIKE '%RESUME%'
   AND argument LIKE CONCAT('%', @redaction_version_redacted, '%');

SELECT COUNT(*) AS raw_version_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE CONCAT('%', @redaction_version_token, '%');
SELECT COUNT(*) > 0 AS redacted_version_token_in_slow_log
  FROM mysql.slow_log
 WHERE sql_text LIKE '%RESUME%'
   AND sql_text LIKE CONCAT('%', @redaction_version_redacted, '%');

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= RESUME PRESERVED TRANSACTION '\\*\\*\\*\\*abcd
--let $grep_output= count
--source include/grep_pattern.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= msp_matrix_redaction_abcd
--let $grep_output= count
--replace_result msp_matrix_redaction_abcd TOKEN
--source include/grep_pattern.inc

SET GLOBAL general_log=OFF;
SET GLOBAL slow_query_log=OFF;
TRUNCATE TABLE mysql.general_log;
TRUNCATE TABLE mysql.slow_log;
--eval SET GLOBAL log_raw=$old_log_raw
--eval SET GLOBAL long_query_time=$old_long_query_time
--eval SET GLOBAL log_slow_admin_statements=$old_log_slow_admin_statements
--eval SET GLOBAL log_output='$old_log_output'
--eval SET GLOBAL general_log=$old_general_log
--eval SET GLOBAL slow_query_log=$old_slow_query_log
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable

--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_drain_kill_owner;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_drain_mode=HARD;

CREATE TABLE t_preserve_drain_kill_owner(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_drain_kill_owner VALUES(1,10),(2,20);

--connect(drain_kill_owner_blocker,localhost,root,,test)
--connection drain_kill_owner_blocker
START TRANSACTION;
UPDATE t_preserve_drain_kill_owner SET b=21 WHERE a=2;

--connect(drain_kill_owner_preserve,localhost,root,,test)
--connection drain_kill_owner_preserve
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_drain_before_kill_active SIGNAL before_drain_kill WAIT_FOR continue_drain_kill';
START TRANSACTION;
UPDATE t_preserve_drain_kill_owner SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR before_drain_kill TIMEOUT 10';
--replace_result $preserve_conn_id PRESERVE_ID
--eval KILL QUERY $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_drain_kill';

--connection drain_kill_owner_preserve
--error ER_QUERY_INTERRUPTED
--reap
SET DEBUG_SYNC = 'RESET';
ROLLBACK;
--disconnect drain_kill_owner_preserve

--connection drain_kill_owner_blocker
SELECT * FROM t_preserve_drain_kill_owner WHERE a=2;
ROLLBACK;
--disconnect drain_kill_owner_blocker

--connection default
SELECT * FROM t_preserve_drain_kill_owner ORDER BY a;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_drain_kill_owner;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_timeout;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_close_timeout_ms=1;

CREATE TABLE t_warmcopy_timeout(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_timeout VALUES(1,10);

--connect(warmcopy_timeout_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_timeout SET v=11 WHERE id=1;
SET DEBUG_SYNC =
  'before_execute_sql_command SIGNAL warmcopy_timeout_blocked WAIT_FOR warmcopy_timeout_continue';
--send UPDATE t_warmcopy_timeout SET v=12 WHERE id=1

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_timeout_blocked TIMEOUT 10';

--connect(warmcopy_timeout_owner, localhost, root,,test)
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
--sleep 1
SET DEBUG_SYNC = 'now SIGNAL warmcopy_timeout_continue';

--connection warmcopy_timeout_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect warmcopy_timeout_owner
--remove_file $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

--connection default
--connection warmcopy_timeout_app
--reap
COMMIT;
--disconnect warmcopy_timeout_app

--connection default
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_warmcopy_timeout;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_timeout;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_close_timeout_ms=30000;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET DEBUG_SYNC = 'RESET';

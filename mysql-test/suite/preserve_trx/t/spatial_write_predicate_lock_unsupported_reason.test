--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_spatial_write_predicate_anchor;
DROP TABLE IF EXISTS t_spatial_write_predicate;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("PRESERVE rejected.*unsupported_spatial_write_predicate_lock");
--enable_query_log

CREATE TABLE t_spatial_write_predicate_anchor(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
CREATE TABLE t_spatial_write_predicate(
  id INT PRIMARY KEY,
  pos POINT NOT NULL SRID 0,
  v INT NOT NULL DEFAULT 0,
  SPATIAL KEY(pos)
) ENGINE=InnoDB;
INSERT INTO t_spatial_write_predicate_anchor VALUES(1,0);
INSERT INTO t_spatial_write_predicate VALUES
  (1, ST_GeomFromText('POINT(1 1)'), 10),
  (2, ST_GeomFromText('POINT(10 10)'), 20);
SET @g = ST_GeomFromText('POLYGON((0 0,0 5,5 5,5 0,0 0))');

START TRANSACTION;
UPDATE t_spatial_write_predicate_anchor SET v=1 WHERE id=1;
UPDATE t_spatial_write_predicate FORCE INDEX(pos)
   SET v = v + 1
 WHERE MBRWithin(pos, @g);

--connect(spatial_predicate_control,localhost,root,,test)
SET SESSION debug='+d,preserve_trx_simulate_unsupported_spatial_write_predicate_lock';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_simulate_unsupported_spatial_write_predicate_lock';
--disconnect spatial_predicate_control
--connection default

SELECT * FROM t_spatial_write_predicate_anchor ORDER BY id;
SELECT id, ST_AsText(pos) AS pos, v
  FROM t_spatial_write_predicate ORDER BY id;
COMMIT;
SELECT * FROM t_spatial_write_predicate_anchor ORDER BY id;
SELECT id, ST_AsText(pos) AS pos, v
  FROM t_spatial_write_predicate ORDER BY id;

--let $assert_text= Spatial write predicate unsupported reason is logged
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE rejected.*unsupported_spatial_write_predicate_lock
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

--source suite/preserve_trx/include/assert_no_preserve_residue.inc
DROP TABLE t_spatial_write_predicate;
DROP TABLE t_spatial_write_predicate_anchor;
SET GLOBAL preserve_trx_enable=ON;

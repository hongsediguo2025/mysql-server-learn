--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_active_transaction_retryable;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_resume_active_transaction_retryable(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_resume_active_transaction_retryable VALUES(1,10);

START TRANSACTION;
UPDATE t_resume_active_transaction_retryable SET v=20 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

START TRANSACTION;
SELECT 1 AS active_transaction_marker;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_INVALID_STATE
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

--replace_result $preserved_token TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_SNAPSHOT_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_resume_active_transaction_retryable ORDER BY id;

DROP TABLE t_resume_active_transaction_retryable;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TEMPORARY TABLE tmp_preserve_delete_commit(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_delete_commit VALUES(1, 10), (2, 20), (3, 30);

START TRANSACTION;
DELETE FROM tmp_preserve_delete_commit WHERE id = 2;
UPDATE tmp_preserve_delete_commit SET v = 31 WHERE id = 3;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_preserve_delete_commit ORDER BY id;
COMMIT;
SELECT * FROM tmp_preserve_delete_commit ORDER BY id;

DROP TEMPORARY TABLE tmp_preserve_delete_commit;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

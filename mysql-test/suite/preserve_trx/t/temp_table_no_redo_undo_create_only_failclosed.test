--source include/not_log_bin.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_no_redo_create_anchor(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_no_redo_create_anchor VALUES(1, 10);

START TRANSACTION;
UPDATE t_temp_no_redo_create_anchor SET v=11 WHERE id=1;
CREATE TEMPORARY TABLE tmp_temp_no_redo_create_only(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

UPDATE t_temp_no_redo_create_anchor SET v=12 WHERE id=1;
COMMIT;
SELECT * FROM t_temp_no_redo_create_anchor ORDER BY id;

DROP TEMPORARY TABLE tmp_temp_no_redo_create_only;
DROP TABLE t_temp_no_redo_create_anchor;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

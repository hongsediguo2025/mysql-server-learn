--source include/not_windows.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL rds_preserve_trx_enable=ON;

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');

die "preserve dir missing: $dir" unless -d $dir;
print "preserve dir exists\n";

die "obsolete preserve key exists: $key" if -e $key || -l $key;
print "no preserve key\n";

opendir(my $dh, $dir) or die "cannot open preserve dir: $!";
my @tmp = grep { /\.tmp$/ } readdir($dh);
closedir($dh);
die "leftover temp files: @tmp" if @tmp;
print "no preserve temp files\n";
EOF

SET GLOBAL rds_preserve_trx_enable=ON;

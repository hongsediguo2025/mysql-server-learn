--source include/not_windows.inc
--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_temp_activate_crash_base;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: failed to restore durable transaction semantics: record locks: record_lock_identity_record_image_not_found");
--enable_query_log

CREATE TABLE t_preserve_temp_activate_crash_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_temp_activate_crash_base VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_preserve_temp_activate_crash(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_temp_activate_crash VALUES(1, 100);

START TRANSACTION;
UPDATE t_preserve_temp_activate_crash_base SET v = 11 WHERE id = 1;
UPDATE tmp_preserve_temp_activate_crash SET v = 101 WHERE id = 1;
INSERT INTO tmp_preserve_temp_activate_crash VALUES(2, 200);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let PRESERVE_TRX_DIR= `SELECT @@global.preserve_trx_dir`
--let $expect_bin= 1
--let $expect_temp_sidecar_count= 2
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

SET SESSION debug="+d,preserve_trx_crash_after_resume_activate_before_snapshot_delete";
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

--replace_result $preserved_token TOKEN
--error 2013
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

--source include/wait_until_disconnected.inc

--source suite/preserve_trx/include/ha_crash_abandon_preserve_artifacts.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_preserve_temp_activate_crash_base ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_preserve_temp_activate_crash_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recovery_stale_tmp_sidecars;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recovery_stale_tmp_sidecars(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_recovery_stale_tmp_sidecars VALUES(1, 10);

START TRANSACTION;
SELECT * FROM t_recovery_stale_tmp_sidecars WHERE a=1 FOR UPDATE;
UPDATE t_recovery_stale_tmp_sidecars SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let MYSQLD_DATADIR= `SELECT @@datadir`

--copy_file $PRESERVED_SNAPSHOT_FILE $PRESERVED_SNAPSHOT_FILE.tmp
--exec printf stale > "$PRESERVED_BINLOG_CACHE_FILE.tmp"
--exec printf stale > "$MYSQLD_DATADIR/preserve/$preserved_token.tainted.tmp"
--exec printf stale > "$MYSQLD_DATADIR/preserve/$preserved_token.blob.extra.tmp"
--exec printf stale > "$MYSQLD_DATADIR/preserve/$preserved_token.tempts.77.image.tmp"
--let $expect_bin= 1
--let $expect_bin_tmp= 1
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--source suite/preserve_trx/include/get_preserved_token.inc
--file_exists $PRESERVED_SNAPSHOT_FILE
--exec test ! -e "$PRESERVED_SNAPSHOT_FILE.tmp"
--exec test ! -e "$PRESERVED_BINLOG_CACHE_FILE.tmp"
--exec test ! -e "$MYSQLD_DATADIR/preserve/$preserved_token.tainted.tmp"
--exec test ! -e "$MYSQLD_DATADIR/preserve/$preserved_token.blob.extra.tmp"
--exec test ! -e "$MYSQLD_DATADIR/preserve/$preserved_token.tempts.77.image.tmp"

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT * FROM t_recovery_stale_tmp_sidecars ORDER BY a;

DROP TABLE t_recovery_stale_tmp_sidecars;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_active_second;
--disable_query_log
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_query_log
--enable_warnings

--disable_query_log
CREATE USER preserve_trx_ha_admin@localhost;
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_active_second(
  a INT PRIMARY KEY,
  b INT,
  resumed_by INT DEFAULT NULL
) ENGINE=InnoDB;
INSERT INTO t_batch_active_second VALUES(1,10,NULL),(2,20,NULL);

--connect(batch_idle_app,localhost,root,,test)
--connection batch_idle_app
START TRANSACTION;
UPDATE t_batch_active_second SET b=11 WHERE a=1;

--connect(batch_active_app,localhost,root,,test)
--connection batch_active_app
START TRANSACTION;
SET DEBUG_SYNC =
  'before_execute_sql_command SIGNAL batch_second_active WAIT_FOR continue_batch_second';
--send UPDATE t_batch_active_second SET b=21 WHERE a=2

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR batch_second_active TIMEOUT 10';

--connect(batch_active_control,localhost,preserve_trx_ha_admin,,test)

--connect(batch_active_owner,localhost,root,,test)
--connection batch_active_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL batch_second_drain_closing WAIT_FOR continue_batch_second_drain';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection batch_active_control
SET DEBUG_SYNC = 'now WAIT_FOR batch_second_drain_closing TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL continue_batch_second';
SET DEBUG_SYNC = 'now SIGNAL continue_batch_second_drain';

--connection batch_active_app
--reap

--connection batch_active_owner
--reap
--disconnect batch_active_owner
--disconnect batch_active_app

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

CREATE TEMPORARY TABLE t_batch_active_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
  FROM performance_schema.preserved_transactions;

SELECT COUNT(*) AS token_count
  FROM t_batch_active_tokens;

--let $token1= `SELECT TOKEN FROM t_batch_active_tokens WHERE rn = 1`
--let $token2= `SELECT TOKEN FROM t_batch_active_tokens WHERE rn = 2`

--disable_query_log
--disable_result_log
--connect(batch_active_resume1,localhost,root,,test)
--connection batch_active_resume1
--eval RESUME PRESERVED TRANSACTION '$token1'
SET @resume_id = NULL;
SELECT a INTO @resume_id
  FROM t_batch_active_second
  WHERE b IN (11,21)
  LIMIT 1;
UPDATE t_batch_active_second
  SET b=b+100, resumed_by=1
  WHERE a=@resume_id;
COMMIT;

--connect(batch_active_resume2,localhost,root,,test)
--connection batch_active_resume2
--eval RESUME PRESERVED TRANSACTION '$token2'
SET @resume_id = NULL;
SELECT a INTO @resume_id
  FROM t_batch_active_second
  WHERE b IN (11,21)
  LIMIT 1;
UPDATE t_batch_active_second
  SET b=b+100, resumed_by=2
  WHERE a=@resume_id;
COMMIT;

--disconnect batch_active_resume1
--disconnect batch_active_resume2
--connection default
--enable_result_log
--enable_query_log

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;

SELECT COUNT(*) AS row_count,
       SUM(b=111 AND resumed_by IS NOT NULL) AS idle_resumed,
       SUM(b=121 AND resumed_by IS NOT NULL) AS inflight_resumed,
       COUNT(DISTINCT resumed_by) AS resume_sessions
  FROM t_batch_active_second;

DROP TABLE t_batch_active_second;
--disable_query_log
DROP USER preserve_trx_ha_admin@localhost;
--enable_query_log
SET GLOBAL preserve_trx_enable=ON;

--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_warnings
DROP TABLE IF EXISTS t_temp_streaming_budget_base;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=OFF;
SET GLOBAL preserve_trx_memory_budget_bytes=524288;
SET GLOBAL preserve_trx_memory_per_token_bytes=524288;
SET GLOBAL preserve_trx_spill_chunk_bytes=16384;

CREATE TABLE t_temp_streaming_budget_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_streaming_budget_base VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_temp_streaming_budget(
  id INT PRIMARY KEY,
  v INT,
  KEY idx_v(v)
) ENGINE=InnoDB;

--disable_query_log
--let $row_id= 1
while ($row_id <= 16384)
{
  --eval INSERT INTO tmp_temp_streaming_budget VALUES($row_id, $row_id * 10)
  --inc $row_id
}
--enable_query_log

SET GLOBAL preserve_trx_temp_table_enable=ON;

START TRANSACTION;
UPDATE t_temp_streaming_budget_base SET v = 11 WHERE id = 1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--perl
use strict;
use warnings;
use File::Spec;

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');
my @images = grep { /\.tempts\.\d+\.image$/ }
  PreserveSnapshotFiles::preserve_all_files($preserve_dir);
die "expected one sealed temp image, found: @images" unless @images == 1;
my $image_path = $images[0];
my $image_bytes = -s $image_path;
die "sealed temp image does not exceed the 512KiB memory budget: $image_bytes"
  unless defined($image_bytes) && $image_bytes > 524288;
print "sealed temp image exceeds memory budget\n";
EOF

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --preserve-trx-memory-budget-bytes=524288 --preserve-trx-memory-per-token-bytes=524288 --preserve-trx-spill-chunk-bytes=16384 --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT COUNT(*) AS temp_rows_after_resume FROM tmp_temp_streaming_budget;
SELECT SUM(id) AS temp_id_sum_after_resume FROM tmp_temp_streaming_budget;
COMMIT;
SELECT * FROM t_temp_streaming_budget_base ORDER BY id;

DROP TEMPORARY TABLE tmp_temp_streaming_budget;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_temp_streaming_budget_base;
SET GLOBAL preserve_trx_enable=ON;

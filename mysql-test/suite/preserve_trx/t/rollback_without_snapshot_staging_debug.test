--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_rollback_without_snapshot;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_rollback_without_snapshot(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_rollback_without_snapshot VALUES (1, 10);

START TRANSACTION;
UPDATE t_rollback_without_snapshot SET v = 11 WHERE id = 1;

SET SESSION debug='+d,preserve_trx_debug_rollback_without_snapshot_observable';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION;
SET SESSION debug='-d,preserve_trx_debug_rollback_without_snapshot_observable';

SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-rollback-without-snapshot-token';

SELECT LAST_ERROR REGEXP
       'rollback without snapshot: xid_ok=1 prepare_ok=1 detach_ok=1 rolled_back=1 rollback_without_snapshot_ok=1 cleanup_by_token_ok=1'
       AS rollback_without_snapshot_ok
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-rollback-without-snapshot-token';

SELECT * FROM t_rollback_without_snapshot;

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-rollback-without-snapshot-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP TABLE t_rollback_without_snapshot;
SET GLOBAL preserve_trx_enable=ON;

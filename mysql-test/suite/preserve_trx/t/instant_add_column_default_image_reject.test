--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_instant_default_image;
DROP TABLE IF EXISTS t_instant_default_marker;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--disable_query_log
CALL mtr.add_suppression("PRESERVE rejected.*record_lock_identity_build_failed");
CALL mtr.add_suppression("Preserve record lock identity rebuild failed: reason=record_image_failed");
--enable_query_log

CREATE TABLE t_instant_default_image(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
CREATE TABLE t_instant_default_marker(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_instant_default_image VALUES(1,10);
INSERT INTO t_instant_default_marker VALUES(1,1);

ALTER TABLE t_instant_default_image
  ADD COLUMN c INT NOT NULL DEFAULT 7,
  ALGORITHM=INSTANT;

START TRANSACTION;
UPDATE t_instant_default_marker SET v=2 WHERE id=1;
SELECT id, v, c FROM t_instant_default_image WHERE id=1 FOR UPDATE;
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
COMMIT;

SELECT id, v FROM t_instant_default_marker;
SELECT id, v, c FROM t_instant_default_image;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_instant_default_image;
DROP TABLE t_instant_default_marker;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_instant_default_image;
DROP TABLE IF EXISTS t_instant_default_marker;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_instant_default_image(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
CREATE TABLE t_instant_default_marker(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_instant_default_image VALUES(1,10);
INSERT INTO t_instant_default_marker VALUES(1,1);

ALTER TABLE t_instant_default_image
  ADD COLUMN c INT NOT NULL DEFAULT 7,
  ALGORITHM=INSTANT;

START TRANSACTION;
UPDATE t_instant_default_marker SET v=2 WHERE id=1;
SELECT id, v, c FROM t_instant_default_image WHERE id=1 FOR UPDATE;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT id, v FROM t_instant_default_marker;
SELECT id, v, c FROM t_instant_default_image;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_instant_default_image;
DROP TABLE t_instant_default_marker;
SET GLOBAL preserve_trx_enable=ON;

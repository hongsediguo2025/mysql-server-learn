--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_import_register_crash;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
CALL mtr.add_suppression("PRESERVE: rolled back prepared transaction without snapshot during recovery");
--enable_query_log

CREATE TABLE t_recover_import_register_crash(
  a INT PRIMARY KEY,
  b INT
) ENGINE=InnoDB;
INSERT INTO t_recover_import_register_crash VALUES(1,10),(2,20);

START TRANSACTION;
SELECT * FROM t_recover_import_register_crash WHERE a=1 FOR UPDATE;
UPDATE t_recover_import_register_crash SET b=21 WHERE a=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= --preserve-trx-enable=ON --debug=d,preserve_trx_crash_after_recover_import_before_register
--source include/start_mysqld_expecting_crash.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction recovery reached post-import pre-register crash point
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/wait_for_expected_crash.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--source suite/preserve_trx/include/ha_crash_abandon_preserve_artifacts.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS recovered_count
  FROM performance_schema.preserved_transactions;

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_recover_import_register_crash ORDER BY a;

DROP TABLE t_recover_import_register_crash;
SET GLOBAL preserve_trx_enable=ON;

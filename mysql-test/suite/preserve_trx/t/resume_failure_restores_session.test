--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_resume_failure(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_resume_failure VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_resume_failure WHERE a=1 FOR UPDATE;
UPDATE t_resume_failure SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION sql_log_bin=0;
SET @@session.last_insert_id=987;
SELECT @@session.sql_log_bin AS sql_log_bin_before_failed_resume;
SELECT LAST_INSERT_ID() AS last_insert_id_before_failed_resume;
SET SESSION debug="+d,preserve_trx_fail_resume_before_attach";

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SET SESSION debug="-d,preserve_trx_fail_resume_before_attach";
SELECT @@session.sql_log_bin AS sql_log_bin_after_failed_resume;
SELECT LAST_INSERT_ID() AS last_insert_id_after_failed_resume;
SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_SNAPSHOT_FILE

SET SESSION sql_log_bin=1;
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT * FROM t_resume_failure ORDER BY a;

DROP TABLE t_resume_failure;
SET GLOBAL preserve_trx_enable=ON;

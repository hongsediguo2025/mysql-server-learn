--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_record_lock_import_conflict;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: failed to restore durable transaction semantics");
--enable_query_log

CREATE TABLE t_record_lock_import_conflict(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_record_lock_import_conflict VALUES(1,10),(2,20),(3,30);

--connect(lock_conflict_a,localhost,root,,test)
--connection lock_conflict_a
START TRANSACTION;
UPDATE t_record_lock_import_conflict SET v=21 WHERE id=2;
SELECT * FROM t_record_lock_import_conflict WHERE id=1 FOR SHARE;

--connect(lock_conflict_b,localhost,root,,test)
--connection lock_conflict_b
START TRANSACTION;
UPDATE t_record_lock_import_conflict SET v=31 WHERE id=3;
SELECT * FROM t_record_lock_import_conflict WHERE id=1 FOR SHARE;

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--perl
use strict;
use warnings;
use Compress::Zlib qw(crc32);
use Digest::SHA qw(sha256);
use File::Spec;

require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
my @bin_paths = PreserveSnapshotFiles::preserve_snapshot_bin_files($preserve_dir);
die "expected two preserved snapshots, found " . scalar(@bin_paths)
  unless @bin_paths == 2;

sub read_le16_at { return unpack('v', substr($_[0], $_[1], 2)); }
sub read_le32_at { return unpack('V', substr($_[0], $_[1], 4)); }
sub read_le64_at { return unpack('Q<', substr($_[0], $_[1], 8)); }
sub write_le32_at { substr($_[0], $_[1], 4) = pack('V', $_[2]); }
sub write_le64_at { substr($_[0], $_[1], 8) = pack('Q<', $_[2]); }
sub le32 { return pack('V', $_[0]); }

my $LOCK_MODE_MASK = 0x0f;
my $LOCK_S = 2;
my $LOCK_X = 3;

sub mutate_record_payload {
  my ($value_ref) = @_;
  my $off = 0;
  return 0 if length($$value_ref) < 4;
  my $count = read_le32_at($$value_ref, $off); $off += 4;
  for (my $i = 0; $i < $count; ++$i) {
    return 0 if $off + 56 > length($$value_ref);
    $off += 8 + 8 + 4 + 4;
    my $type_mode_off = $off;
    my $type_mode = read_le32_at($$value_ref, $type_mode_off);
    $off += 4;
    $off += 4 + 8 + 4;
    my $heap_offsets_len = read_le32_at($$value_ref, $off); $off += 4;
    my $record_images_len = read_le32_at($$value_ref, $off); $off += 4;
    my $bitmap_len = read_le32_at($$value_ref, $off); $off += 4;
    die "bad record-lock entry" if $off + $heap_offsets_len +
                                  $record_images_len + $bitmap_len >
                                  length($$value_ref);
    if (($type_mode & $LOCK_MODE_MASK) == $LOCK_S) {
      my $new_type_mode = ($type_mode & ~$LOCK_MODE_MASK) | $LOCK_X;
      write_le32_at($$value_ref, $type_mode_off, $new_type_mode);
      return 1;
    }
    $off += $heap_offsets_len + $record_images_len + $bitmap_len;
  }
  return 0;
}

sub refresh_snapshot_crc {
  my ($snapshot_ref) = @_;
  substr($$snapshot_ref, 516, 4) = "\0" x 4;
  substr($$snapshot_ref, 516, 4) = le32(crc32($$snapshot_ref));
}

sub update_record_blob_descriptor {
  my ($snapshot_ref, $header_len, $payload_len, $digest, $size) = @_;
  my $payload = substr($$snapshot_ref, $header_len, $payload_len);
  my $pos = 0;
  while ($pos < length($payload)) {
    die "bad tlv boundary" if $pos + 6 > length($payload);
    my $tag = read_le16_at($payload, $pos);
    my $len = read_le32_at($payload, $pos + 2);
    my $value_pos = $pos + 6;
    die "bad tlv length" if $value_pos + $len > length($payload);
    if ($tag == 0x81) {
      my $value = substr($payload, $value_pos, $len);
      die "bad external descriptor header" if length($value) < 4;
      my $count = read_le32_at($value, 0);
      my $off = 4;
      for (my $i = 0; $i < $count; ++$i) {
        die "bad external descriptor name" if $off + 2 > length($value);
        my $name_len = read_le16_at($value, $off); $off += 2;
        die "bad external descriptor name length"
          if $off + $name_len + 40 > length($value);
        my $name = substr($value, $off, $name_len); $off += $name_len;
        if ($name eq 'record_locks') {
          write_le64_at($value, $off, $size);
          substr($value, $off + 8, 32) = $digest;
          substr($payload, $value_pos, $len) = $value;
          substr($$snapshot_ref, $header_len, $payload_len) = $payload;
          return 1;
        }
        $off += 40;
      }
    }
    $pos = $value_pos + $len;
  }
  return 0;
}

my $mutated = 0;
for my $bin_path (@bin_paths) {
  my (undef, undef, $bin_name) = File::Spec->splitpath($bin_path);
  my ($volume, $dir) = File::Spec->splitpath($bin_path);
  my $snapshot_dir = File::Spec->catpath($volume, $dir, '');
  my $token = $bin_name;
  $token =~ s/\.bin\z//;
  open(my $fh, '<:raw', $bin_path) or die "cannot read $bin_path: $!";
  my $snapshot = do { local $/; <$fh> };
  close($fh);

  die "bad preserve magic in $bin_name"
    unless substr($snapshot, 0, 8) eq 'PTRXSNP1';
  my $header_len = read_le16_at($snapshot, 10);
  my $payload_len = read_le64_at($snapshot, 48);

  my $record_blob_path =
      File::Spec->catfile($snapshot_dir, $token . ".blob.record_locks");
  if (-f $record_blob_path) {
    open(my $bfh, '<:raw', $record_blob_path)
      or die "cannot read $record_blob_path: $!";
    my $record_blob = do { local $/; <$bfh> };
    close($bfh);
    if (mutate_record_payload(\$record_blob)) {
      my $digest = sha256($record_blob);
      die "could not update record lock blob descriptor"
        unless update_record_blob_descriptor(\$snapshot, $header_len,
                                             $payload_len, $digest,
                                             length($record_blob));
      refresh_snapshot_crc(\$snapshot);
      open(my $bout, '>:raw', $record_blob_path)
        or die "cannot rewrite $record_blob_path: $!";
      print {$bout} $record_blob;
      close($bout);
      open(my $out, '>:raw', $bin_path) or die "cannot rewrite $bin_path: $!";
      print {$out} $snapshot;
      close($out);
      PreserveSnapshotFiles::refresh_resurrection_index_snapshot_digest(
        $bin_path);
      $mutated = 1;
      last;
    }
  }

  my $payload = substr($snapshot, $header_len, $payload_len);

  my $pos = 0;
  while ($pos < length($payload)) {
    die "bad tlv boundary" if $pos + 6 > length($payload);
    my $tag = read_le16_at($payload, $pos);
    my $len = read_le32_at($payload, $pos + 2);
    my $value_pos = $pos + 6;
    die "bad tlv length" if $value_pos + $len > length($payload);
    if ($tag == 0x30) {
      my $value = substr($payload, $value_pos, $len);
      if (mutate_record_payload(\$value)) {
        substr($payload, $value_pos, $len) = $value;
        substr($snapshot, $header_len, $payload_len) = $payload;
        refresh_snapshot_crc(\$snapshot);
        open(my $out, '>:raw', $bin_path) or die "cannot rewrite $bin_path: $!";
        print {$out} $snapshot;
        close($out);
        PreserveSnapshotFiles::refresh_resurrection_index_snapshot_digest(
          $bin_path);
        $mutated = 1;
        last;
      }
    }
    last if $mutated;
    $pos = $value_pos + $len;
  }
  last if $mutated;
}
die "did not find a shared record lock to mutate" unless $mutated;
EOF

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: failed to restore durable transaction semantics
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_conflict
  FROM performance_schema.preserved_transactions;

CREATE TEMPORARY TABLE t_record_lock_import_conflict_tokens AS
SELECT TOKEN FROM performance_schema.preserved_transactions ORDER BY TOKEN;

--let $remaining_token= `SELECT TOKEN FROM t_record_lock_import_conflict_tokens LIMIT 1`
--replace_result $remaining_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$remaining_token'
COMMIT;

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS row_count,
       SUM((id = 2 AND v = 21) OR (id = 3 AND v = 31)) AS committed_updates,
       SUM((id = 2 AND v = 20) OR (id = 3 AND v = 30)) AS rolled_back_updates
  FROM t_record_lock_import_conflict;

--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_record_lock_import_conflict;
SET GLOBAL preserve_trx_enable=ON;

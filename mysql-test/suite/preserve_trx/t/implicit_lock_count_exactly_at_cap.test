--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_implicit_lock_count_cap;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let $saved_preserve_trx_max_lock_count= `SELECT @@GLOBAL.preserve_trx_max_lock_count`

CREATE TABLE t_implicit_lock_count_cap(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_implicit_lock_count_cap VALUES(1,0),(2,0);

SET GLOBAL preserve_trx_max_lock_count=2;
START TRANSACTION;
UPDATE t_implicit_lock_count_cap SET v=v+10 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-max-lock-count=2" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT LOCKS_COUNT AS preserved_locks_count
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

START TRANSACTION;
UPDATE t_implicit_lock_count_cap SET v=v+10;
--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT SUM(v) AS visible_before_rollback
  FROM t_implicit_lock_count_cap;
ROLLBACK;
SELECT SUM(v) AS visible_after_rollback
  FROM t_implicit_lock_count_cap;

--eval SET GLOBAL preserve_trx_max_lock_count=$saved_preserve_trx_max_lock_count
DROP TABLE t_implicit_lock_count_cap;
SET GLOBAL preserve_trx_enable=ON;

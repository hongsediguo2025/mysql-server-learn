--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;

CREATE TEMPORARY TABLE tmp_preserve_temp_read_only(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

SET SESSION transaction_read_only=ON;
START TRANSACTION;
INSERT INTO tmp_preserve_temp_read_only VALUES(1, 10), (2, 20);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SET SESSION transaction_read_only=OFF;
SELECT @@session.transaction_read_only AS session_read_only_before_resume;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.transaction_read_only AS session_read_only_after_resume;

INSERT INTO tmp_preserve_temp_read_only VALUES(3, 30);
COMMIT;
SELECT @@session.transaction_read_only AS session_read_only_after_commit;

SET SESSION transaction_read_only=OFF;
SELECT COUNT(*) AS row_count, SUM(v) AS v_sum
  FROM tmp_preserve_temp_read_only;

DROP TEMPORARY TABLE tmp_preserve_temp_read_only;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_single;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_single(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;

--connect(batch_app, localhost, root,,test)
START TRANSACTION;
INSERT INTO t_batch_single VALUES(1, 10);

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE, GLOBAL_LOG_BIN
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

UPDATE t_batch_single SET v = v + 1 WHERE id = 1;
COMMIT;
SELECT * FROM t_batch_single;

DROP TABLE t_batch_single;
SET GLOBAL preserve_trx_enable=ON;

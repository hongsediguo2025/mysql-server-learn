--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_multiple;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_multiple(
  a INT PRIMARY KEY,
  b INT,
  resumed_by INT DEFAULT NULL
) ENGINE=InnoDB;

--connect(batch_app1,localhost,root,,test)
--connection batch_app1
START TRANSACTION;
INSERT INTO t_batch_multiple VALUES(1,10,NULL);

--connect(batch_app2,localhost,root,,test)
--connection batch_app2
START TRANSACTION;
INSERT INTO t_batch_multiple VALUES(2,20,NULL);

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

CREATE TEMPORARY TABLE t_batch_multiple_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
  FROM performance_schema.preserved_transactions;

SELECT COUNT(*) AS token_count
  FROM t_batch_multiple_tokens;

--let $token1= `SELECT TOKEN FROM t_batch_multiple_tokens WHERE rn = 1`
--let $token2= `SELECT TOKEN FROM t_batch_multiple_tokens WHERE rn = 2`

--disable_query_log
--disable_result_log
--connect(batch_resume1,localhost,root,,test)
--connection batch_resume1
--eval RESUME PRESERVED TRANSACTION '$token1'
SET @resume_id = NULL;
SELECT a INTO @resume_id
  FROM t_batch_multiple
  WHERE resumed_by IS NULL
  LIMIT 1;
UPDATE t_batch_multiple
  SET b = b + 100, resumed_by = 1
  WHERE a = @resume_id;
COMMIT;

--connect(batch_resume2,localhost,root,,test)
--connection batch_resume2
--eval RESUME PRESERVED TRANSACTION '$token2'
SET @resume_id = NULL;
SELECT a INTO @resume_id
  FROM t_batch_multiple
  WHERE resumed_by IS NULL
  LIMIT 1;
UPDATE t_batch_multiple
  SET b = b + 100, resumed_by = 2
  WHERE a = @resume_id;
COMMIT;

--disconnect batch_resume1
--disconnect batch_resume2
--connection default
--enable_result_log
--enable_query_log

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;

SELECT COUNT(*) AS row_count,
       COUNT(DISTINCT a) AS distinct_keys,
       SUM(resumed_by IS NOT NULL) AS resumed_rows,
       SUM(b >= 100) AS bumped_rows
  FROM t_batch_multiple;

DROP TABLE t_batch_multiple;
SET GLOBAL preserve_trx_enable=ON;

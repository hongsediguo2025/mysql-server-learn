--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_idle_boundary;
DROP USER IF EXISTS batch_idle_boundary_app@localhost;
--disable_query_log
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
CREATE USER preserve_trx_ha_admin@localhost;
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
--enable_query_log
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_idle_boundary(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE USER batch_idle_boundary_app@localhost;
GRANT SELECT, INSERT ON test.* TO batch_idle_boundary_app@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO batch_idle_boundary_app@localhost;

--connect(batch_idle_boundary_ha,localhost,preserve_trx_ha_admin,,test)

--connect(batch_idle_boundary_app,localhost,batch_idle_boundary_app,,test)
--connection batch_idle_boundary_app
START TRANSACTION;
INSERT INTO t_batch_idle_boundary VALUES(1,10);
SET DEBUG_SYNC =
  'preserve_trx_after_begin_before_command_read SIGNAL idle_target_before_read WAIT_FOR continue_idle_target_read';

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR idle_target_before_read TIMEOUT 10';

--connection default
SET DEBUG_SYNC =
  'preserve_trx_batch_after_targets_quiesced_before_attach SIGNAL idle_target_quiesced WAIT_FOR continue_idle_target_attach';
SET DEBUG_SYNC =
  'preserve_trx_batch_after_one_target_preserved SIGNAL idle_target_preserved WAIT_FOR continue_idle_target_preserved';
--send DRAIN TRANSACTIONS PRESERVE

--connection batch_idle_boundary_ha
--disable_warnings
SET DEBUG_SYNC = 'now WAIT_FOR idle_target_quiesced TIMEOUT 2';
--enable_warnings
SELECT COUNT(*) AS preserved_count_before_attach
  FROM performance_schema.preserved_transactions;

--connection batch_idle_boundary_app
--send SELECT 1

--connection batch_idle_boundary_ha
SET DEBUG_SYNC = 'now SIGNAL continue_idle_target_read';
SET DEBUG_SYNC = 'now SIGNAL continue_idle_target_attach';
SET DEBUG_SYNC = 'now WAIT_FOR idle_target_preserved TIMEOUT 10';

--connection batch_idle_boundary_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
--reap
--disconnect batch_idle_boundary_app

--connection batch_idle_boundary_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_idle_target_preserved';

--connection default
--reap

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_batch_idle_boundary;

DROP USER batch_idle_boundary_app@localhost;
--disable_query_log
DROP USER preserve_trx_ha_admin@localhost;
--enable_query_log
DROP TABLE t_batch_idle_boundary;
SET GLOBAL preserve_trx_enable=ON;

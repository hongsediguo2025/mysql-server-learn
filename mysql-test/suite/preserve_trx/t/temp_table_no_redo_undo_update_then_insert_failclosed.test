--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TEMPORARY TABLE tmp_preserve_update_insert(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;

CREATE TABLE t_preserve_update_insert(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO tmp_preserve_update_insert VALUES(1, 10);
START TRANSACTION;
UPDATE tmp_preserve_update_insert SET v = 11 WHERE id = 1;
INSERT INTO t_preserve_update_insert VALUES(1, 100);

--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

INSERT INTO tmp_preserve_update_insert VALUES(2, 20);
COMMIT;
SELECT * FROM tmp_preserve_update_insert ORDER BY id;
SELECT * FROM t_preserve_update_insert ORDER BY id;

DROP TABLE t_preserve_update_insert;
DROP TEMPORARY TABLE tmp_preserve_update_insert;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

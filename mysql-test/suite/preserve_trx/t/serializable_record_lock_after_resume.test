--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_serializable_record_lock_after_resume;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_serializable_record_lock_after_resume(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_serializable_record_lock_after_resume VALUES
  (10,10),(20,20),(30,30);

SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
START TRANSACTION;
UPDATE t_serializable_record_lock_after_resume SET v=31 WHERE id=30;
SELECT * FROM t_serializable_record_lock_after_resume
 WHERE id >= 10 AND id <= 20;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT ISOLATION, LOCKS_COUNT >= 1 AS has_preserved_locks
  FROM performance_schema.preserved_transactions;

--connect(serializable_writer, localhost, root,,test)
SET SESSION innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_serializable_record_lock_after_resume SET v=21 WHERE id=20;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t_serializable_record_lock_after_resume VALUES(15,15);

--connection default
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection serializable_writer
UPDATE t_serializable_record_lock_after_resume SET v=21 WHERE id=20;
INSERT INTO t_serializable_record_lock_after_resume VALUES(15,15);
--disconnect serializable_writer

--connection default
SELECT * FROM t_serializable_record_lock_after_resume ORDER BY id;

DROP TABLE t_serializable_record_lock_after_resume;
SET GLOBAL preserve_trx_enable=ON;

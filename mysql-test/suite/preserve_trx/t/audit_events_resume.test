--source include/no_ps_protocol.inc
--source include/have_null_audit_plugin.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_audit_resume;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_preserve_audit_resume(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_audit_resume VALUES(1,10);

START TRANSACTION;
UPDATE t_preserve_audit_resume SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--replace_regex /\.dll/.so/
eval INSTALL PLUGIN null_audit SONAME '$AUDIT_NULL';

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval SET @preserved_token='$preserved_token'
SET @redacted_preserved_token=CONCAT('****', RIGHT(@preserved_token, 4));
SET @expected_resume_audit=CONCAT(
  'MYSQL_AUDIT_MESSAGE_INTERNAL;component="mysqld" producer="preserve_trx" ',
  'message="preserved_transaction" key[0]="action" value[0]="resume" ',
  'key[1]="token" value[1]="', @redacted_preserved_token, '" ',
  'key[2]="result" value[2]="success";;');

SET @@null_audit_event_order_check_exact=0;
SET @@null_audit_event_order_check=@expected_resume_audit;
SET @@null_audit_event_record_def='MYSQL_AUDIT_MESSAGE_INTERNAL;MYSQL_AUDIT_QUERY_STATUS_END';

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT @@null_audit_event_order_check;
SELECT @@null_audit_event_record LIKE CONCAT('%', @preserved_token, '%')
       AS raw_token_in_audit_record;
SELECT @@null_audit_event_record LIKE CONCAT('%', @redacted_preserved_token, '%')
       AS redacted_token_in_audit_record;
COMMIT;

SELECT * FROM t_preserve_audit_resume ORDER BY a;

UNINSTALL PLUGIN null_audit;
DROP TABLE t_preserve_audit_resume;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_no_fallback;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_fallback= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_lock_warmcopy_no_fallback(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_no_fallback VALUES(1,10,REPEAT('a',32));

--connect(lock_wc_no_fallback_app, localhost, root,,test)
START TRANSACTION;
--disable_query_log
--disable_result_log
SELECT id FROM t_lock_warmcopy_no_fallback WHERE id=1 FOR UPDATE;
--enable_result_log
--enable_query_log
UPDATE t_lock_warmcopy_no_fallback
  SET v=11, pad=REPEAT('b',32)
  WHERE id=1;
--disable_query_log
--send SET DEBUG_SYNC = 'now SIGNAL lock_wc_no_fallback_target_waiting WAIT_FOR lock_wc_no_fallback_target_continue'
--enable_query_log

--connection default
--disable_query_log
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_no_fallback_target_waiting TIMEOUT 10';
--enable_query_log

--connect(lock_wc_no_fallback_owner, localhost, root,,test)
--connection lock_wc_no_fallback_owner
SET SESSION debug='+d,preserve_trx_lock_warmcopy_validate_canonical_equivalence,preserve_trx_lock_warmcopy_corrupt_record_payload_for_equivalence_test';
--disable_query_log
SET DEBUG_SYNC =
  'preserve_trx_lock_warmcopy_after_active_record_scan SIGNAL lock_wc_no_fallback_active_scan_done WAIT_FOR lock_wc_no_fallback_active_scan_continue';
--enable_query_log
--send DRAIN TRANSACTIONS PRESERVE

--connection default
--disable_query_log
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_no_fallback_active_scan_done TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL lock_wc_no_fallback_target_continue';
--enable_query_log

--connection lock_wc_no_fallback_app
--reap

--connection default
--disable_query_log
SET DEBUG_SYNC = 'now SIGNAL lock_wc_no_fallback_active_scan_continue';
--enable_query_log

--connection lock_wc_no_fallback_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect lock_wc_no_fallback_owner

--connection default
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= lock warmcopy no fallback strict reject is logged
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=strict_reject.*reason=canonical_equivalence_failed
--let $assert_count_condition= >= 1
--source include/assert_grep.inc

SELECT COUNT(*) AS preserved_count_after_no_fallback_reject
  FROM performance_schema.preserved_transactions;
SELECT VARIABLE_NAME, CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS positive
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME IN (
    'Preserve_trx_lock_warmcopy_canonical_mismatch',
    'Preserve_trx_lock_warmcopy_strict_reject')
  ORDER BY VARIABLE_NAME;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_validate_canonical_equivalence,preserve_trx_lock_warmcopy_corrupt_record_payload_for_equivalence_test';

--connection lock_wc_no_fallback_app
ROLLBACK;
--disconnect lock_wc_no_fallback_app

--connection default
SELECT id, v, pad=REPEAT('a',32) AS pad_ok
  FROM t_lock_warmcopy_no_fallback
  ORDER BY id;
DROP TABLE t_lock_warmcopy_no_fallback;

--disable_query_log
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=$old_preserve_trx_lock_warmcopy_fallback
--eval SET GLOBAL preserve_trx_lock_warmcopy_enable=$old_preserve_trx_lock_warmcopy_enable
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log
--disable_query_log
SET DEBUG_SYNC = 'RESET';
--enable_query_log

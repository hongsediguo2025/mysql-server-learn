--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/force_restart.inc

--let $pfs_table= performance_schema.binary_log_transaction_compression_stats

--disable_warnings
DROP TABLE IF EXISTS t_binlog_compress_resume;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_binlog_compress_resume(
  id INT PRIMARY KEY,
  payload TEXT
) ENGINE=InnoDB;
INSERT INTO t_binlog_compress_resume VALUES(1, REPEAT('a', 1000));

--eval TRUNCATE $pfs_table

SET SESSION binlog_transaction_compression=ON;
SET SESSION binlog_transaction_compression_level_zstd=10;
START TRANSACTION;
UPDATE t_binlog_compress_resume
   SET payload=REPEAT('b', 1000)
 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
  FROM performance_schema.preserved_transactions;

--eval TRUNCATE $pfs_table

SET SESSION binlog_transaction_compression=OFF;
SET SESSION binlog_transaction_compression_level_zstd=1;
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT @@session.binlog_transaction_compression AS compression_after_resume;
SELECT @@session.binlog_transaction_compression_level_zstd AS compression_level_after_resume;
COMMIT;

SELECT COALESCE(SUM(transaction_counter), 0) AS zstd_compressed_transactions
  FROM performance_schema.binary_log_transaction_compression_stats
 WHERE log_type='BINARY' AND compression_type='ZSTD';
SELECT COALESCE(SUM(transaction_counter), 0) AS none_compressed_transactions
  FROM performance_schema.binary_log_transaction_compression_stats
 WHERE log_type='BINARY' AND compression_type='NONE';

SELECT id, LENGTH(payload) AS payload_length,
       SUBSTR(payload, 1, 1) AS payload_prefix
  FROM t_binlog_compress_resume;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open -vv $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/binlog_compression_state_resume.mysqlbinlog
--let $assert_text= Preserved LOGGED_WITH_CACHE transaction keeps preserved compression state after RESUME
--let $assert_file= $MYSQLTEST_VARDIR/tmp/binlog_compression_state_resume.mysqlbinlog
--let $assert_select= ^#.*payload_size=.*compression_type=ZSTD.*uncompressed_size=.*
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/binlog_compression_state_resume.mysqlbinlog

DROP TABLE t_binlog_compress_resume;
SET GLOBAL rds_preserve_trx_enable=ON;

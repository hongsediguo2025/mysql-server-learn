--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--disable_result_log

--let $credential_file= $MYSQL_TMP_DIR/resume-required-final-snapshot.secret
--write_file $credential_file
resume-required-final-snapshot-secret
EOF
--exec chmod 600 $credential_file

--connect(final_snapshot_receiver_admin,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-required-final-snapshot-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN,
      RESUME_ANY_PRESERVED_TRANSACTION,
      PROCESS ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
--connect(final_snapshot_receiver_resume,127.0.0.1,preserve_trx_ha_admin,resume-required-final-snapshot-secret,test,$SERVER_MYPORT_2,)

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS rr_final_app@localhost;
DROP TABLE IF EXISTS t_resume_required_final_snapshot;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-required-final-snapshot-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN, PROCESS ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER rr_final_app@localhost;
GRANT SELECT, UPDATE ON test.* TO rr_final_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=resume_required_final_snapshot --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--source include/restart_mysqld.inc
--let $restart_parameters=
--disable_query_log
--disable_result_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

CREATE TABLE t_resume_required_final_snapshot(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_resume_required_final_snapshot VALUES(1,10);

--connect(final_snapshot_source_ha,localhost,preserve_trx_ha_admin,resume-required-final-snapshot-secret,test)
--connect(final_snapshot_source_txn,localhost,rr_final_app,,test)
START TRANSACTION;
UPDATE t_resume_required_final_snapshot SET v=11 WHERE id=1;

--connect(final_snapshot_source_idle,localhost,rr_final_app,,test)
--let $departed_idle_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)

--connect(final_snapshot_drain_owner,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_drain_before_transfer_commit_reset_check SIGNAL final_snapshot_reached WAIT_FOR final_snapshot_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connection final_snapshot_source_ha
SET DEBUG_SYNC='now WAIT_FOR final_snapshot_reached TIMEOUT 30';
--disconnect final_snapshot_source_idle
--let $wait_condition= SELECT COUNT(*)=0 FROM performance_schema.threads WHERE PROCESSLIST_ID=$departed_idle_id
--source include/wait_condition.inc
--let $assert_text= departed source THD is gone before the final snapshot
--let $assert_cond= `SELECT COUNT(*) = 0 FROM performance_schema.threads WHERE PROCESSLIST_ID=$departed_idle_id`
--source include/assert.inc
SET DEBUG_SYNC='now SIGNAL final_snapshot_continue';

--connection final_snapshot_drain_owner
--reap

# The connection disappeared before the final S snapshot and must not authorize
# a session-only RESUME on the receiver.
--connection final_snapshot_receiver_resume
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$departed_idle_id'

--connection final_snapshot_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--disable_result_log

--connect(final_snapshot_source_cleanup,localhost,root,,test)
--enable_result_log
SELECT id, v FROM t_resume_required_final_snapshot ORDER BY id;
--disable_result_log
DROP TABLE t_resume_required_final_snapshot;
DROP USER rr_final_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
SET DEBUG_SYNC='RESET';

--connection final_snapshot_receiver_admin
DROP USER preserve_trx_ha_admin@localhost;

--connection final_snapshot_source_cleanup
--remove_file $credential_file
--enable_result_log
SELECT 'ok' AS resume_required_final_snapshot;
--enable_query_log

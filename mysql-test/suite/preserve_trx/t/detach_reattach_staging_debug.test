--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_detach_reattach;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_detach_reattach(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_detach_reattach VALUES (1, 10);

START TRANSACTION;
UPDATE t_detach_reattach SET v = 11 WHERE id = 1;

SET SESSION debug='+d,preserve_trx_debug_detach_reattach_observable';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION;
SET SESSION debug='-d,preserve_trx_debug_detach_reattach_observable';

SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-detach-reattach-token';

SELECT LAST_ERROR REGEXP
       'detach reattach: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 attach_ok=1 detach_resumed_ok=1 reattach_ok=1 activate_ok=1 rollback_ok=1'
       AS detach_reattach_ok
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-detach-reattach-token';

COMMIT;
SELECT * FROM t_detach_reattach;

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-detach-reattach-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP TABLE t_detach_reattach;
SET GLOBAL preserve_trx_enable=ON;

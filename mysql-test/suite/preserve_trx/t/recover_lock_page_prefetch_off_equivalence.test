--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_lock_page_prefetch_off;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recover_lock_page_prefetch_off(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_recover_lock_page_prefetch_off VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recover_lock_page_prefetch_off WHERE a=1 FOR UPDATE;
UPDATE t_recover_lock_page_prefetch_off SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recover-lock-page-prefetch=OFF" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.preserve_trx_recover_lock_page_prefetch AS prefetch_enabled;

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_recover_lock_page_prefetch_off ORDER BY a;

DROP TABLE t_recover_lock_page_prefetch_off;

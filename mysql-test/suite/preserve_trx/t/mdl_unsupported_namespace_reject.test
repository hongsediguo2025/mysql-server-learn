--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_mdl_unsupported_namespace;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_mdl_unsupported_namespace(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;

LOCK INSTANCE FOR BACKUP;
START TRANSACTION;
INSERT INTO t_mdl_unsupported_namespace VALUES(1,10);
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
ROLLBACK;
UNLOCK INSTANCE;

DROP TABLE t_mdl_unsupported_namespace;
SET GLOBAL preserve_trx_enable=ON;

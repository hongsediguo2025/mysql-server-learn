--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TEMPORARY TABLE tmp_preserve_commit(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_preserve_commit VALUES(1, 10), (2, 20);
UPDATE tmp_preserve_commit SET v = v + 1 WHERE id = 1;

--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SELECT COUNT(*) AS temp_rows, SUM(v) AS temp_sum FROM tmp_preserve_commit;
INSERT INTO tmp_preserve_commit VALUES(3, 30);
COMMIT;
START TRANSACTION;
INSERT INTO tmp_preserve_commit VALUES(4, 40);
COMMIT;
SELECT * FROM tmp_preserve_commit ORDER BY id;

DROP TEMPORARY TABLE tmp_preserve_commit;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

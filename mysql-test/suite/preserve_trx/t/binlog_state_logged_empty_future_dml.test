--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_logged_empty;
DROP DATABASE IF EXISTS preserve_trx_ignored;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE DATABASE preserve_trx_ignored;
CREATE TABLE t_logged_empty(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE preserve_trx_ignored.seed(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_logged_empty VALUES(1,10);
INSERT INTO preserve_trx_ignored.seed VALUES(1,10);

START TRANSACTION;
UPDATE preserve_trx_ignored.seed SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT @@global.log_bin AS log_bin_after_restart;

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE,
       SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN
  FROM performance_schema.preserved_transactions;

--error 1
--file_exists $PRESERVED_BINLOG_CACHE_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.sql_log_bin AS session_sql_log_bin_after_resume;
SELECT * FROM preserve_trx_ignored.seed WHERE a=1;
UPDATE t_logged_empty SET b=11 WHERE a=1;
COMMIT;
SELECT * FROM t_logged_empty WHERE a=1;
SELECT * FROM preserve_trx_ignored.seed WHERE a=1;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/logged_empty.mysqlbinlog
--let $assert_text= Future DML is written to the binlog after LOGGED_EMPTY resume
--let $assert_file= $MYSQLTEST_VARDIR/tmp/logged_empty.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_logged_empty`
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/logged_empty.mysqlbinlog

DROP TABLE t_logged_empty;
DROP DATABASE preserve_trx_ignored;
SET GLOBAL preserve_trx_enable=ON;

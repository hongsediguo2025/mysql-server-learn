--disable_warnings
DROP TABLE IF EXISTS t_batch_temp_explicit_off_late_preserve;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=OFF;

CREATE TABLE t_batch_temp_explicit_off_late_preserve(
  sid INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

--connect(batch_temp_explicit_off_app1,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_batch_temp_explicit_off_late_preserve(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_batch_temp_explicit_off_late_preserve VALUES(1, 100);
UPDATE tmp_batch_temp_explicit_off_late_preserve SET v = 101 WHERE id = 1;
DROP TEMPORARY TABLE tmp_batch_temp_explicit_off_late_preserve;
INSERT INTO t_batch_temp_explicit_off_late_preserve VALUES(1, 10);

--connect(batch_temp_explicit_off_app2,localhost,root,,test)
START TRANSACTION;
INSERT INTO t_batch_temp_explicit_off_late_preserve VALUES(2, 20);

--connection default
SET GLOBAL rds_preserve_trx_temp_table_enable=OFF;
--let $wait_condition= SELECT COUNT(*) = 2 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection batch_temp_explicit_off_app1
INSERT INTO t_batch_temp_explicit_off_late_preserve VALUES(3, 30);
COMMIT;
--disconnect batch_temp_explicit_off_app1

--connection batch_temp_explicit_off_app2
INSERT INTO t_batch_temp_explicit_off_late_preserve VALUES(4, 40);
COMMIT;
--disconnect batch_temp_explicit_off_app2

--connection default
SELECT * FROM t_batch_temp_explicit_off_late_preserve ORDER BY sid;

DROP TABLE t_batch_temp_explicit_off_late_preserve;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: recovery max count exceeded");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_recovery_max_count;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recovery_max_count(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recovery_max_count VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recovery_max_count WHERE a=1 FOR UPDATE;
UPDATE t_recovery_max_count SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=2" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--replace_column 1 TOKEN
SELECT TOKEN, RECOVERED_COUNT AS recovered_count_after_first_restart
  FROM performance_schema.preserved_transactions;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=2
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: recovery max count exceeded
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_recovery_max_count ORDER BY a;

DROP TABLE t_recovery_max_count;
SET GLOBAL preserve_trx_enable=ON;

--let $restart_parameters= restart: --preserve-trx-enable=OFF --skip-log-bin
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

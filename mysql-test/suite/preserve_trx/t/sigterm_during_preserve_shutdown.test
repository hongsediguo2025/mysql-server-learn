--perl
use strict;
use warnings;
use File::Spec;

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));

my $header_path = File::Spec->catfile($source_root, 'sql', 'preserve_trx.h');
open(my $header_fh, '<', $header_path)
  or die "cannot open $header_path: $!";
my $header = do { local $/; <$header_fh> };
close($header_fh);

die "preserve shutdown merge helper must be declared\n"
  unless $header =~ /bool\s+preserved_trx_shutdown_requested\s*\(\s*\)/s;

my $mysqld_path = File::Spec->catfile($source_root, 'sql', 'mysqld.cc');
open(my $mysqld_fh, '<', $mysqld_path)
  or die "cannot open $mysqld_path: $!";
my $mysqld = do { local $/; <$mysqld_fh> };
close($mysqld_fh);

die "signal SIGTERM path must consult preserve shutdown state before closing connections\n"
  unless $mysqld =~
         /case\s+SIGTERM\s*:.*?preserved_trx_shutdown_requested\s*\(\s*\).*?close_connections\s*\(\s*\)/s;
EOF

--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_sigterm_finalize;
--enable_warnings

--let $MYSQL_PIDFILE= `SELECT @@pid_file`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_sigterm_finalize(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_sigterm_finalize VALUES(1,10);

--connect(preserve_sigterm_owner,localhost,root,,test)
--connection preserve_sigterm_owner
SET DEBUG_SYNC =
  'preserve_trx_finalize_token_delivery SIGNAL token_finalize_pending WAIT_FOR continue_token_finalize';
START TRANSACTION;
UPDATE t_preserve_sigterm_finalize SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR token_finalize_pending TIMEOUT 10';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--exec kill -TERM `cat $MYSQL_PIDFILE`
--sleep 1
SELECT 1 AS server_alive_after_deferred_sigterm;
SET DEBUG_SYNC = 'now SIGNAL continue_token_finalize';

--connection preserve_sigterm_owner
--reap
--disconnect preserve_sigterm_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_preserve_sigterm_finalize ORDER BY a;

DROP TABLE t_preserve_sigterm_finalize;

--disable_warnings
DROP TABLE IF EXISTS t_preserve_sigterm_rollback;
--enable_warnings

CREATE TABLE t_preserve_sigterm_rollback(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_sigterm_rollback VALUES(1,10);

--connect(preserve_sigterm_rollback_owner,localhost,root,,test)
--connection preserve_sigterm_rollback_owner
--let $preserve_sigterm_rollback_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_token_delivery_pending SIGNAL sigterm_rollback_pending WAIT_FOR continue_sigterm_rollback_pending';
START TRANSACTION;
UPDATE t_preserve_sigterm_rollback SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR sigterm_rollback_pending TIMEOUT 10';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--exec kill -TERM `cat $MYSQL_PIDFILE`
--sleep 1
SELECT 1 AS server_alive_after_deferred_sigterm_rollback;
--replace_result $preserve_sigterm_rollback_conn_id CONN_ID
--eval KILL CONNECTION $preserve_sigterm_rollback_conn_id
--disable_query_log
--disable_result_log
# The signal may be accepted before or after the killed connection tears down
# this controlling session; both success and CR_SERVER_LOST are valid while
# waking the deferred SIGTERM path.
--error 0,2013
SET DEBUG_SYNC = 'now SIGNAL continue_sigterm_rollback_pending';
--enable_result_log
--enable_query_log

--connection preserve_sigterm_rollback_owner
--error 2013
--reap
--disconnect preserve_sigterm_rollback_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_deferred_sigterm_rollback
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_preserve_sigterm_rollback ORDER BY a;

DROP TABLE t_preserve_sigterm_rollback;
SET GLOBAL preserve_trx_enable=ON;

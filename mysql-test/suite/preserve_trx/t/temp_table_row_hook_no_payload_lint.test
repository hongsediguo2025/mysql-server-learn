--echo # Lint-only source-shape guard for user temporary-table row hooks.
--echo # Runtime support is based on physical page capture plus no-redo undo
--echo # sidecars; SQL row hooks must only mark that temp DML happened.
--perl
use strict;
use warnings;
use File::Spec;

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));
my $handler_path = File::Spec->catfile($source_root, 'sql', 'handler.cc');

open(my $fh, '<', $handler_path) or die "cannot open $handler_path: $!";
my $handler = do { local $/; <$fh> };
close($fh);

sub function_body {
  my ($name) = @_;
  $handler =~ /(int\s+handler::$name\s*\([^)]*\)\s*\{[\s\S]*?\n\})\n\n/s
    or die "could not isolate handler::$name\n";
  return $1;
}

my $write_body = function_body('ha_write_row');
my $update_body = function_body('ha_update_row');
my $delete_body = function_body('ha_delete_row');

die "ha_write_row must not pass row bytes into temp-table preserve hook\n"
  unless $write_body =~
         /preserve_trx_temp_table_note_row_write\s*\(\s*ha_thd\(\)\s*,\s*table\s*,\s*nullptr\s*,\s*0\s*\)/s;

die "ha_update_row must not allocate or assemble a temp-table row payload\n"
  if $update_body =~ /std::string\s+payload|payload\.reserve|payload\.append/s;
die "ha_update_row must not pass row bytes into temp-table preserve hook\n"
  unless $update_body =~
         /preserve_trx_temp_table_note_row_update\s*\(\s*ha_thd\(\)\s*,\s*table\s*,\s*nullptr\s*,\s*0\s*\)/s;

die "ha_delete_row must not pass row bytes into temp-table preserve hook\n"
  unless $delete_body =~
         /preserve_trx_temp_table_note_row_delete\s*\(\s*ha_thd\(\)\s*,\s*table\s*,\s*nullptr\s*,\s*0\s*\)/s;
EOF

SELECT 'ok' AS temp_table_row_hook_no_payload_lint;

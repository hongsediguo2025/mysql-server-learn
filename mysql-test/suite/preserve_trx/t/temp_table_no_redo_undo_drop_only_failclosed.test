--source include/not_log_bin.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_no_redo_drop_anchor(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_no_redo_drop_anchor VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_temp_no_redo_drop_only(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
UPDATE t_temp_no_redo_drop_anchor SET v=11 WHERE id=1;
DROP TEMPORARY TABLE tmp_temp_no_redo_drop_only;

--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

UPDATE t_temp_no_redo_drop_anchor SET v=12 WHERE id=1;
COMMIT;
SELECT * FROM t_temp_no_redo_drop_anchor ORDER BY id;

DROP TABLE t_temp_no_redo_drop_anchor;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

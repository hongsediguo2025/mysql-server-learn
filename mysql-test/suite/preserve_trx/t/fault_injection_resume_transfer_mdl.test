--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_fault_resume_mdl;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_fault_resume_mdl(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_fault_resume_mdl VALUES(1,10);

START TRANSACTION;
UPDATE t_fault_resume_mdl SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION debug="+d,preserve_trx_fail_resume_transfer_mdl";
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug="-d,preserve_trx_fail_resume_transfer_mdl";

--replace_result $preserved_token TOKEN
SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_SNAPSHOT_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_fault_resume_mdl ORDER BY a;

DROP TABLE t_fault_resume_mdl;
SET GLOBAL preserve_trx_enable=ON;

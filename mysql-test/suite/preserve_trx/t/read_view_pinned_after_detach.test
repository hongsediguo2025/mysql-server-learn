--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_read_view_pin;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_read_view_pin(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_read_view_pin VALUES(1,10),(2,20);

--connect(read_view_pin_app,localhost,root,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT * FROM t_read_view_pin WHERE a=1;
UPDATE t_read_view_pin SET b=21 WHERE a=2;

--connection default
SET SESSION debug="+d,preserve_trx_assert_read_view_pinned_after_detach";

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= PRESERVE: read view pinned after detach;
--source include/search_pattern.inc

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT * FROM t_read_view_pin ORDER BY a;

DROP TABLE t_read_view_pin;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_dirty_cache;
DROP TABLE IF EXISTS t_dirty_cache_myisam;
DROP DATABASE IF EXISTS preserve_trx_ignored;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_dirty_cache(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_dirty_cache VALUES(1,10);
CREATE TABLE t_dirty_cache_myisam(a INT PRIMARY KEY, b INT) ENGINE=MyISAM;

START TRANSACTION;
UPDATE t_dirty_cache SET b=11 WHERE a=1;
INSERT INTO t_dirty_cache_myisam VALUES(1,11);

--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;

SELECT * FROM t_dirty_cache WHERE a=1;

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @bins = grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected no preserved snapshots in $dir, found " . scalar(@bins) . "\n"
  unless scalar(@bins) == 0;
EOF

ROLLBACK;
SELECT * FROM t_dirty_cache WHERE a=1;

DROP TABLE t_dirty_cache, t_dirty_cache_myisam;

CREATE DATABASE preserve_trx_ignored;
CREATE TABLE preserve_trx_ignored.gtid_seed(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO preserve_trx_ignored.gtid_seed VALUES(1,10);

SET GTID_NEXT='ANONYMOUS';
START TRANSACTION;
UPDATE preserve_trx_ignored.gtid_seed SET b=11 WHERE a=1;

--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;

SELECT * FROM preserve_trx_ignored.gtid_seed WHERE a=1;
ROLLBACK;
SET GTID_NEXT=DEFAULT;
SELECT @@SESSION.GTID_NEXT;

DROP DATABASE preserve_trx_ignored;
SET GLOBAL preserve_trx_enable=ON;

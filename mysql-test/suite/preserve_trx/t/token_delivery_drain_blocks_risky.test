--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_token_drain;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_token_drain(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_token_drain VALUES(1,10),(2,20),(3,30),(4,40);

--connect(preserve_owner,localhost,root,,test)
--connection preserve_owner
SET DEBUG_SYNC =
  'preserve_trx_finalize_token_delivery SIGNAL token_finalize_pending WAIT_FOR continue_token_finalize';
START TRANSACTION;
UPDATE t_preserve_token_drain SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR token_finalize_pending TIMEOUT 10';
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(token_drain_blocker,localhost,root,,test)
--connection token_drain_blocker
--error ER_PRESERVE_TRX_UNSUPPORTED
UPDATE t_preserve_token_drain SET b=21 WHERE a=2;

SET @token_drain_sql =
  'UPDATE t_preserve_token_drain SET b=31 WHERE a=3';
PREPARE token_drain_stmt FROM @token_drain_sql;
--error ER_PRESERVE_TRX_UNSUPPORTED
EXECUTE token_drain_stmt;
DEALLOCATE PREPARE token_drain_stmt;

--error ER_PRESERVE_TRX_UNSUPPORTED
SELECT * FROM t_preserve_token_drain WHERE a=4 FOR UPDATE;

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect token_drain_blocker

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_token_finalize';

--connection preserve_owner
--reap
--disconnect preserve_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_preserve_token_drain ORDER BY a;

DROP TABLE t_preserve_token_drain;
SET GLOBAL preserve_trx_enable=ON;

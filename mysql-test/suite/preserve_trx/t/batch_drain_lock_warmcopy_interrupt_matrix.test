--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_interrupt;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_fallback= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_lock_warmcopy_interrupt(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_interrupt VALUES(1,10),(2,20);

--connect(lock_wc_interrupt_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_interrupt SET v=11 WHERE id=1;

--connect(lock_wc_interrupt_drain, localhost, root,,test)
--connection lock_wc_interrupt_drain
--let $drain_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL lock_wc_interrupt_closing WAIT_FOR lock_wc_interrupt_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_interrupt_closing TIMEOUT 10';
--replace_result $drain_conn_id DRAIN_CONN_ID
--eval KILL QUERY $drain_conn_id
SET DEBUG_SYNC = 'now SIGNAL lock_wc_interrupt_continue';

--connection lock_wc_interrupt_drain
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect lock_wc_interrupt_drain

--connection default
SELECT COUNT(*) AS preserved_count_after_kill_query
  FROM performance_schema.preserved_transactions;

--connection lock_wc_interrupt_app
ROLLBACK;
--disconnect lock_wc_interrupt_app

--connection default
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;
UPDATE t_lock_warmcopy_interrupt SET v=21 WHERE id=2;
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;

--connect(lock_wc_interrupt_app_conn, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_interrupt SET v=12 WHERE id=1;

--connect(lock_wc_interrupt_drain_conn, localhost, root,,test)
--connection lock_wc_interrupt_drain_conn
--let $drain_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL lock_wc_interrupt_conn_closing WAIT_FOR lock_wc_interrupt_conn_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_interrupt_conn_closing TIMEOUT 10';
--replace_result $drain_conn_id DRAIN_CONN_ID
--eval KILL CONNECTION $drain_conn_id
SET DEBUG_SYNC = 'now SIGNAL lock_wc_interrupt_conn_continue';

--connection lock_wc_interrupt_drain_conn
--error 2013
--reap
--disconnect lock_wc_interrupt_drain_conn

--connection default
SELECT COUNT(*) AS preserved_count_after_kill_connection
  FROM performance_schema.preserved_transactions;

--connection lock_wc_interrupt_app_conn
ROLLBACK;
--disconnect lock_wc_interrupt_app_conn

--connection default
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;

--connect(lock_wc_interrupt_target_app, localhost, root,,test)
--connection lock_wc_interrupt_target_app
--let $target_conn_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
UPDATE t_lock_warmcopy_interrupt SET v=13 WHERE id=1;

--connect(lock_wc_interrupt_target_drain, localhost, root,,test)
--connection lock_wc_interrupt_target_drain
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL lock_wc_interrupt_target_closing WAIT_FOR lock_wc_interrupt_target_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_interrupt_target_closing TIMEOUT 10';
--replace_result $target_conn_id TARGET_CONN_ID
--eval KILL CONNECTION $target_conn_id
SET DEBUG_SYNC = 'now SIGNAL lock_wc_interrupt_target_continue';

--connection lock_wc_interrupt_target_app
--error 2006
SELECT 1;
--disconnect lock_wc_interrupt_target_app

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_target_disconnect
  FROM performance_schema.preserved_transactions;
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;
UPDATE t_lock_warmcopy_interrupt SET v=22 WHERE id=2;
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;

--connection lock_wc_interrupt_target_drain
--reap
--disconnect lock_wc_interrupt_target_drain

--connection default
--let $MYSQL_PIDFILE= `SELECT @@pid_file`

--connect(lock_wc_interrupt_sigterm_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_interrupt SET v=14 WHERE id=1;

--connect(lock_wc_interrupt_sigterm_drain, localhost, root,,test)
--connection lock_wc_interrupt_sigterm_drain
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL lock_wc_interrupt_sigterm_closing WAIT_FOR lock_wc_interrupt_sigterm_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_interrupt_sigterm_closing TIMEOUT 10';
--exec kill -TERM `cat $MYSQL_PIDFILE`
--sleep 1
--error 1053,2006,2013
SELECT 1 AS server_alive_after_lock_warmcopy_sigterm;

--connection lock_wc_interrupt_sigterm_drain
--reap
--disconnect lock_wc_interrupt_sigterm_drain

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_sigterm
  FROM performance_schema.preserved_transactions;

--connection default
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;
UPDATE t_lock_warmcopy_interrupt SET v=23 WHERE id=2;
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;

--connect(lock_wc_interrupt_wait_owner, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_interrupt SET v=15 WHERE id=1;

--connect(lock_wc_interrupt_wait_blocked, localhost, root,,test)
--connection lock_wc_interrupt_wait_blocked
--let $wait_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC = 'lock_wait_will_wait SIGNAL lock_wc_interrupt_waiting';
--send UPDATE t_lock_warmcopy_interrupt SET v=16 WHERE id=1

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_interrupt_waiting TIMEOUT 10';

--connect(lock_wc_interrupt_wait_drain, localhost, root,,test)
--connection lock_wc_interrupt_wait_drain
--let $drain_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL lock_wc_interrupt_wait_closing WAIT_FOR lock_wc_interrupt_wait_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_interrupt_wait_closing TIMEOUT 10';
--replace_result $wait_conn_id WAIT_CONN_ID
--eval KILL QUERY $wait_conn_id

--connection lock_wc_interrupt_wait_blocked
--error ER_QUERY_INTERRUPTED
--reap
ROLLBACK;
--disconnect lock_wc_interrupt_wait_blocked

--connection default
--replace_result $drain_conn_id DRAIN_CONN_ID
--eval KILL QUERY $drain_conn_id
SET DEBUG_SYNC = 'now SIGNAL lock_wc_interrupt_wait_continue';

--connection lock_wc_interrupt_wait_drain
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect lock_wc_interrupt_wait_drain

--connection default
SELECT COUNT(*) AS preserved_count_after_lock_wait_interrupt
  FROM performance_schema.preserved_transactions;

--connection lock_wc_interrupt_wait_owner
ROLLBACK;
--disconnect lock_wc_interrupt_wait_owner

--connection default
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;
UPDATE t_lock_warmcopy_interrupt SET v=24 WHERE id=2;
SELECT id, v FROM t_lock_warmcopy_interrupt ORDER BY id;

DROP TABLE t_lock_warmcopy_interrupt;
SET DEBUG_SYNC = 'RESET';

--disable_query_log
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=$old_preserve_trx_lock_warmcopy_fallback
--eval SET GLOBAL preserve_trx_lock_warmcopy_enable=$old_preserve_trx_lock_warmcopy_enable
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log

--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_fault_binlog_cache;
--enable_warnings

--let $MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;
SET @saved_preserve_trx_warmcopy_enable=@@GLOBAL.preserve_trx_warmcopy_enable;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;

CREATE TABLE t_preserve_fault_binlog_cache(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_fault_binlog_cache VALUES(1,10);
RESET MASTER;

SET SESSION debug="+d,preserve_trx_fail_before_binlog_cache_payload_rename,preserve_trx_assert_original_binlog_cache_clean_after_detach";
START TRANSACTION;
UPDATE t_preserve_fault_binlog_cache SET b=11 WHERE a=1;
--connect(binlog_cache_rename_control,localhost,root,,test)
--connection binlog_cache_rename_control
--disable_query_log
SET SESSION debug="+d,preserve_trx_fail_before_binlog_cache_payload_rename,preserve_trx_assert_original_binlog_cache_clean_after_detach";
--enable_query_log
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log
SET SESSION debug="-d,preserve_trx_fail_before_binlog_cache_payload_rename,preserve_trx_assert_original_binlog_cache_clean_after_detach";
--enable_query_log
--disconnect binlog_cache_rename_control
--connection default
SET SESSION debug="-d,preserve_trx_fail_before_binlog_cache_payload_rename,preserve_trx_assert_original_binlog_cache_clean_after_detach";

SELECT * FROM t_preserve_fault_binlog_cache WHERE a=1;
ROLLBACK;
SELECT * FROM t_preserve_fault_binlog_cache WHERE a=1;
START TRANSACTION;
UPDATE t_preserve_fault_binlog_cache SET b=12 WHERE a=1;
COMMIT;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_preserve_fault_binlog_cache WHERE a=1;
--exec sh -c 'test ! -d "$MYSQLD_DATADIR/preserve" || ! find "$MYSQLD_DATADIR/preserve" \( -name "*.bin" -o -name "*.bin.tmp" -o -name "*.binlog_cache" -o -name "*.binlog_cache.tmp" \) -print -quit | grep -q .'

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog
--let $assert_text= New transaction remains in binlog after detach failure cleanup
--let $assert_file= $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog
--let $assert_select= @2=12
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= Rolled back detached transaction is discarded from binlog cache
--let $assert_file= $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog
--let $assert_select= @2=11
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog

SET SESSION debug="+d,preserve_trx_fail_binlog_cache_directory_fsync,preserve_trx_assert_original_binlog_cache_clean_after_detach";
START TRANSACTION;
UPDATE t_preserve_fault_binlog_cache SET b=13 WHERE a=1;
--connect(binlog_cache_fsync_control,localhost,root,,test)
--connection binlog_cache_fsync_control
--disable_query_log
SET SESSION debug="+d,preserve_trx_fail_binlog_cache_directory_fsync,preserve_trx_assert_original_binlog_cache_clean_after_detach";
--enable_query_log
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--disable_query_log
SET SESSION debug="-d,preserve_trx_fail_binlog_cache_directory_fsync,preserve_trx_assert_original_binlog_cache_clean_after_detach";
--enable_query_log
--disconnect binlog_cache_fsync_control
--connection default
SET SESSION debug="-d,preserve_trx_fail_binlog_cache_directory_fsync,preserve_trx_assert_original_binlog_cache_clean_after_detach";

SELECT * FROM t_preserve_fault_binlog_cache WHERE a=1;
ROLLBACK;
SELECT * FROM t_preserve_fault_binlog_cache WHERE a=1;
START TRANSACTION;
UPDATE t_preserve_fault_binlog_cache SET b=14 WHERE a=1;
COMMIT;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_preserve_fault_binlog_cache WHERE a=1;
--exec sh -c 'test ! -d "$MYSQLD_DATADIR/preserve" || ! find "$MYSQLD_DATADIR/preserve" \( -name "*.bin" -o -name "*.bin.tmp" -o -name "*.binlog_cache" -o -name "*.binlog_cache.tmp" \) -print -quit | grep -q .'

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog
--let $assert_text= New transaction remains in binlog after binlog cache directory fsync failure cleanup
--let $assert_file= $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog
--let $assert_select= @2=14
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= Rolled back detached transaction is discarded after binlog cache directory fsync failure
--let $assert_file= $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog
--let $assert_select= @2=13
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/fault_binlog_cache_cleanup.mysqlbinlog

DROP TABLE t_preserve_fault_binlog_cache;
SET GLOBAL preserve_trx_warmcopy_enable=@saved_preserve_trx_warmcopy_enable;
SET GLOBAL preserve_trx_enable=ON;

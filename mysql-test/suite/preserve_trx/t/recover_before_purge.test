--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_before_purge;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_recover_before_purge(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_before_purge VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recover_before_purge WHERE a=1 FOR UPDATE;
UPDATE t_recover_before_purge SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --debug=d,preserve_trx_assert_recovered_before_purge" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= PRESERVE: preserved transaction recovery begin;
--source include/search_pattern.inc
let SEARCH_PATTERN= PRESERVE: preserved transaction recovery end .*elapsed_us=[0-9]+;
--source include/search_pattern.inc
let SEARCH_PATTERN= PRESERVE: preserved transaction recovery end .*phase_list_us=[0-9]+ .*phase_snapshot_recover_us=[0-9]+ .*phase_snapshot_load_us=[0-9]+ .*phase_snapshot_validate_us=[0-9]+ .*phase_snapshot_kernel_us=[0-9]+ .*phase_snapshot_claim_us=[0-9]+ .*phase_snapshot_read_view_us=[0-9]+ .*phase_snapshot_table_locks_us=[0-9]+ .*phase_snapshot_record_locks_us=[0-9]+ .*phase_snapshot_record_lock_entries=[1-9][0-9]* .*phase_snapshot_record_lock_stable_page_hits=[0-9]+ .*phase_snapshot_record_lock_image_resolves=[0-9]+ .*phase_snapshot_record_lock_bitmap_pages=[1-9][0-9]* .*phase_snapshot_record_lock_bitmap_bits=[1-9][0-9]* .*phase_snapshot_record_lock_page_get_us=[0-9]+ .*phase_snapshot_record_lock_page_get_count=[1-9][0-9]* .*phase_snapshot_record_lock_table_open_us=[0-9]+ .*phase_snapshot_record_lock_prefetch_pages=[0-9]+ .*phase_snapshot_record_lock_prefetch_bytes=[0-9]+ .*phase_snapshot_predicate_locks_us=[0-9]+ .*phase_snapshot_mdl_us=[0-9]+ .*phase_snapshot_register_us=[0-9]+;
--source include/search_pattern.inc
let SEARCH_PATTERN= PRESERVE: recovery completed before purge thread start;
--source include/search_pattern.inc

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--error 1
--file_exists $PRESERVED_SNAPSHOT_FILE

COMMIT;
SELECT * FROM t_recover_before_purge ORDER BY a;

DROP TABLE t_recover_before_purge;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction '.*' expired-token reaper forced rollback: recovery timeout expired");
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: preserved transaction snapshot tainted");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_expired_reaper_cleanup_failure;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_expired_reaper_cleanup_failure(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_expired_reaper_cleanup_failure VALUES(1,10);

START TRANSACTION;
UPDATE t_expired_reaper_cleanup_failure SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_one_second_retention= 1
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--sleep 2

--exec echo "restart: --rds-preserve-trx-enable=ON  --debug=d,preserve_trx_fail_expired_reaper_cleanup" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--sleep 121

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* expired-token reaper forced rollback: recovery timeout expired
--let $wait_timeout= 45
--source include/wait_for_pattern_in_file.inc

--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions;

--let $expired_cleanup_token= `SELECT TOKEN FROM performance_schema.preserved_transactions LIMIT 1`
--let _EXPIRED_CLEANUP_TOKEN= $expired_cleanup_token
--perl
use strict;
use warnings;
use File::Spec;

require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');

my $token = $ENV{'_EXPIRED_CLEANUP_TOKEN'} or die "missing token";
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my @snapshots = grep { /\Q$token\E\.bin\z/ }
  PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
die "missing retained snapshot"
  unless @snapshots == 1;
die "missing tainted marker after expired reaper cleanup failure"
  unless -f File::Spec->catfile($dir, "$token.tainted");
EOF
--let _EXPIRED_CLEANUP_TOKEN=

SELECT * FROM t_expired_reaper_cleanup_failure ORDER BY a;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted
--let $wait_timeout= 45
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_tainted_cleanup
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_expired_reaper_cleanup_failure ORDER BY a;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_expired_reaper_cleanup_failure;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_savepoint_mdl_anchor;
DROP TABLE IF EXISTS t_savepoint_mdl_after;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_savepoint_mdl_anchor(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE t_savepoint_mdl_after(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_savepoint_mdl_anchor VALUES(1,10);
INSERT INTO t_savepoint_mdl_after VALUES(1,20);

START TRANSACTION;
UPDATE t_savepoint_mdl_anchor SET v=11 WHERE id=1;
SELECT * FROM t_savepoint_mdl_anchor ORDER BY id;
SAVEPOINT before_after_mdl;
SELECT * FROM t_savepoint_mdl_after ORDER BY id;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(savepoint_mdl_ddl, localhost, root,,test)
--connection savepoint_mdl_ddl
SET lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
ALTER TABLE t_savepoint_mdl_after ADD COLUMN ddl_marker INT;

--connection default
--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK TO SAVEPOINT before_after_mdl;

--connection savepoint_mdl_ddl
--error ER_LOCK_WAIT_TIMEOUT
ALTER TABLE t_savepoint_mdl_after ADD COLUMN ddl_marker INT;

--connection default
COMMIT;

--connection savepoint_mdl_ddl
ALTER TABLE t_savepoint_mdl_after ADD COLUMN ddl_marker INT;
--disconnect savepoint_mdl_ddl
--source include/wait_until_disconnected.inc

--connection default
SELECT * FROM t_savepoint_mdl_after ORDER BY id;

DROP TABLE t_savepoint_mdl_after;
DROP TABLE t_savepoint_mdl_anchor;
SET GLOBAL preserve_trx_enable=ON;

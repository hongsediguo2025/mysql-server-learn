--source include/have_debug.inc

--disable_warnings
DROP USER IF EXISTS preserve_pfs_none@localhost;
DROP USER IF EXISTS preserve_pfs_resume_any@localhost;
DROP USER IF EXISTS preserve_pfs_process@localhost;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SET SESSION debug='+d,preserve_trx_inject_observable_record';
SELECT TOKEN AS root_token
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-observable-token';
SET SESSION debug='-d,preserve_trx_inject_observable_record';

CREATE USER preserve_pfs_none@localhost;
CREATE USER preserve_pfs_resume_any@localhost;
CREATE USER preserve_pfs_process@localhost;
GRANT SELECT ON performance_schema.* TO preserve_pfs_none@localhost;
GRANT SELECT ON performance_schema.* TO preserve_pfs_resume_any@localhost;
GRANT SELECT ON performance_schema.* TO preserve_pfs_process@localhost;
GRANT RESUME_ANY_PRESERVED_TRANSACTION ON *.* TO
  preserve_pfs_resume_any@localhost;
GRANT PROCESS ON *.* TO preserve_pfs_process@localhost;

--connect(pfs_none_con, localhost, preserve_pfs_none,,test)
SELECT COUNT(*) AS visible_without_privilege
  FROM performance_schema.preserved_transactions;
--disconnect pfs_none_con

--connect(pfs_resume_any_con, localhost, preserve_pfs_resume_any,,test)
SELECT TOKEN AS resume_any_token
  FROM performance_schema.preserved_transactions;
--disconnect pfs_resume_any_con

--connect(pfs_process_con, localhost, preserve_pfs_process,,test)
SELECT TOKEN AS process_token
  FROM performance_schema.preserved_transactions;
--disconnect pfs_process_con

--connection default
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-observable-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP USER preserve_pfs_none@localhost;
DROP USER preserve_pfs_resume_any@localhost;
DROP USER preserve_pfs_process@localhost;
SET GLOBAL preserve_trx_enable=ON;

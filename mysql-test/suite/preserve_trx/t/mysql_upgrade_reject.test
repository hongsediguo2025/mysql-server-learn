--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_upgrade_context;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_upgrade_context(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_upgrade_context VALUES(1,10), (2,20);

START TRANSACTION;
UPDATE t_preserve_upgrade_context SET b=11 WHERE a=1;
--connect(mysql_upgrade_drain_control,localhost,root,,test)
SET SESSION debug='+d,preserve_trx_simulate_server_upgrade_context';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_simulate_server_upgrade_context';
--disconnect mysql_upgrade_drain_control
--connection default
UPDATE t_preserve_upgrade_context SET b=12 WHERE a=1;
COMMIT;

SET SESSION debug='+d,preserve_trx_simulate_server_upgrade_context';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_simulate_server_upgrade_context';

SELECT * FROM t_preserve_upgrade_context ORDER BY a;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_upgrade_context;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_batch_temp_first_dml_base(
  sid INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

--connect(batch_temp_first_app1,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_batch_temp_first_001(
  id INT PRIMARY KEY,
  sid INT NOT NULL,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
SET @batch_temp_sid = 1;
START TRANSACTION;
INSERT INTO tmp_batch_temp_first_001 VALUES(1, 1, 10);
UPDATE tmp_batch_temp_first_001 SET v = 11 WHERE id = 1;
INSERT INTO t_batch_temp_first_dml_base VALUES(1, 101);

--connect(batch_temp_first_app2,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_batch_temp_first_002(
  id INT PRIMARY KEY,
  sid INT NOT NULL,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
SET @batch_temp_sid = 2;
START TRANSACTION;
INSERT INTO t_batch_temp_first_dml_base VALUES(2, 202);

--connection default
--let $wait_condition= SELECT COUNT(*) = 2 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--connection batch_temp_first_app1
SELECT COUNT(*), SUM(v) FROM tmp_batch_temp_first_001;
COMMIT;
--disconnect batch_temp_first_app1

--connection batch_temp_first_app2
COMMIT;
--disconnect batch_temp_first_app2

--connection default
SELECT COUNT(*) AS base_rows, SUM(v) AS base_sum
  FROM t_batch_temp_first_dml_base;

DROP TABLE t_batch_temp_first_dml_base;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

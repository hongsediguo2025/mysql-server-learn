--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_force_recovery_cache;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Found 1 prepared XA transactions");
CALL mtr.add_suppression("Skip updating information_schema metadata in InnoDB read-only mode");
CALL mtr.add_suppression("Skip re-populating collations and character sets tables in InnoDB read-only mode");
CALL mtr.add_suppression("PRESERVE: preserved transaction recovery is not supported while innodb_force_recovery is enabled; snapshot and binlog-cache files are retained and marked tainted");
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: preserved transaction snapshot tainted");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_force_recovery_cache(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_force_recovery_cache VALUES(1,10);

START TRANSACTION;
UPDATE t_force_recovery_cache SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --innodb-force-recovery=1" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.innodb_force_recovery AS force_recovery_after_restart;
SELECT COUNT(*) AS preserved_count_during_force_recovery
  FROM performance_schema.preserved_transactions;

--perl
use strict;
use warnings;
use File::Spec;
require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite', 'preserve_trx',
                            'include', 'preserve_snapshot_files.pl');

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my @snapshots = PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
my @files = PreserveSnapshotFiles::preserve_all_files($dir);
my @caches = grep { /\.binlog_cache$/ } @files;
my @tainted = grep { /\.tainted$/ } @files;
die "expected one preserved snapshot in $dir, found " . scalar(@snapshots) . "\n"
  unless scalar(@snapshots) == 1;
die "expected one preserved binlog cache in $dir, found " . scalar(@caches) . "\n"
  unless scalar(@caches) == 1;
die "expected one preserved tainted marker in $dir, found " . scalar(@tainted) . "\n"
  unless scalar(@tainted) == 1;
(my $token = (File::Spec->splitpath($snapshots[0]))[2]) =~ s/\.bin$//;
my $tainted_name = (File::Spec->splitpath($tainted[0]))[2];
die "tainted marker token mismatch in $dir\n"
  unless $tainted_name eq "$token.tainted";
open(my $out, '>', File::Spec->catfile($ENV{'MYSQLTEST_VARDIR'}, 'tmp',
                                       'force_recovery_cache_token.inc'))
  or die "cannot write token include: $!";
print {$out} "--let \$force_recovery_cache_token= $token\n";
print {$out} "--let \$force_recovery_cache_snapshot= $snapshots[0]\n";
print {$out} "--let \$force_recovery_cache_binlog= $caches[0]\n";
print {$out} "--let \$force_recovery_cache_tainted= $tainted[0]\n";
close($out);
EOF

--source $MYSQLTEST_VARDIR/tmp/force_recovery_cache_token.inc
--remove_file $MYSQLTEST_VARDIR/tmp/force_recovery_cache_token.inc

--replace_result $force_recovery_cache_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$force_recovery_cache_token'

START TRANSACTION;
--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
ROLLBACK;

--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

--file_exists $force_recovery_cache_snapshot
--file_exists $force_recovery_cache_binlog
--file_exists $force_recovery_cache_tainted

--let $restart_parameters= restart: --preserve-trx-enable=ON --innodb-force-recovery=0
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT @@global.innodb_force_recovery AS force_recovery_after_normal_restart;
SELECT COUNT(*) AS preserved_count_after_normal_restart
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_force_recovery_cache ORDER BY a;
SELECT COUNT(*) AS preserved_count_after_tainted_rollback
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_force_recovery_cache;
SET GLOBAL preserve_trx_enable=ON;

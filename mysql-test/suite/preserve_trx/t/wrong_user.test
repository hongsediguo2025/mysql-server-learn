--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP USER IF EXISTS preserve_wrong_user@localhost;
DROP TABLE IF EXISTS t_wrong_user;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_wrong_user(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_wrong_user VALUES(1,10);
CREATE USER preserve_wrong_user@localhost;
GRANT SELECT, UPDATE ON test.t_wrong_user TO preserve_wrong_user@localhost;

START TRANSACTION;
UPDATE t_wrong_user SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(wrong_user_con, localhost, preserve_wrong_user,,test)
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_ACCESS_DENIED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect wrong_user_con
--connection default

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_wrong_user ORDER BY a;

DROP USER preserve_wrong_user@localhost;
DROP TABLE t_wrong_user;
SET GLOBAL preserve_trx_enable=ON;

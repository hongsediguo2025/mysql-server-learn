--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--disable_result_log

--let $credential_file= $MYSQL_TMP_DIR/unsent-restore-reset.secret
--write_file $credential_file
unsent-restore-reset-secret
EOF
--exec chmod 600 $credential_file

--connect(unsent_receiver,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'unsent-restore-reset-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN, PROCESS ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
SET @receiver_active_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs');

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS unsent_restore_app@localhost;
DROP TABLE IF EXISTS t_unsent_restore_reset;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'unsent-restore-reset-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN, PROCESS ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER unsent_restore_app@localhost;
GRANT SELECT, UPDATE ON test.* TO unsent_restore_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=unsent_restore_reset --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--source include/restart_mysqld.inc
--let $restart_parameters=
--disable_query_log
--disable_result_log

CALL mtr.add_suppression(
  "PRESERVE: standby transfer source epoch commit failed status=9");

CREATE TABLE t_unsent_restore_reset(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_unsent_restore_reset VALUES(1,10),(2,20),(3,30),(4,40);

--connect(unsent_source_ha,localhost,preserve_trx_ha_admin,unsent-restore-reset-secret,test)
SET @unknown_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs');
SET @reset_wins_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins');
--connect(unsent_reset_1,localhost,preserve_trx_ha_admin,unsent-restore-reset-secret,test)
--connect(unsent_reset_2,localhost,preserve_trx_ha_admin,unsent-restore-reset-secret,test)
--connect(unsent_drain,localhost,root,,test)
SET SESSION debug='+d,preserve_trx_transfer_fail_commit_before_send_once';

# Phase A: RESET publishes RESET_REQUESTED after the last stale check but
# before the source restore CAS. The DRAIN actor must lose the claim.
--connect(unsent_app_1,localhost,unsent_restore_app,,test)
--let $app_1_connection_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_unsent_restore_reset SET v=11 WHERE id=1;
--connect(unsent_marker,localhost,unsent_restore_app,,test)
UPDATE t_unsent_restore_reset SET v=22 WHERE id=2;

--connection unsent_drain
SET DEBUG_SYNC=
  'preserve_trx_unsent_failure_before_source_restore_claim SIGNAL unsent_before_claim WAIT_FOR unsent_claim_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection unsent_source_ha
SET DEBUG_SYNC='now WAIT_FOR unsent_before_claim TIMEOUT 30';
--connection unsent_reset_1
--send RESET DRAIN
--connection unsent_reset_2
--send RESET DRAIN
--connection unsent_source_ha
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_reset_drain_wins')=@reset_wins_before+1
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL unsent_claim_release';

--connection unsent_reset_1
--reap
--connection unsent_reset_2
--reap
--connection unsent_drain
--error ER_PRESERVE_TRX_DRAIN_RESET
--reap

--connection unsent_app_1
--let $assert_text= RESET winner preserves the original transaction connection
--let $assert_cond= `SELECT CONNECTION_ID()=$app_1_connection_id`
--source include/assert.inc
UPDATE t_unsent_restore_reset SET v=v+10 WHERE id=1;
COMMIT;

# Phase B: source restore CAS wins first. Both RESET actors must JOIN and wait
# for the source restore barrier instead of restoring the transaction again.
--connect(unsent_app_2,localhost,unsent_restore_app,,test)
--let $app_2_connection_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_unsent_restore_reset SET v=31 WHERE id=3;
--connection unsent_marker
UPDATE t_unsent_restore_reset SET v=44 WHERE id=4;

--connection unsent_drain
SET DEBUG_SYNC=
  'preserve_trx_unsent_source_restore_claimed SIGNAL unsent_claim_won WAIT_FOR unsent_restore_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection unsent_source_ha
SET DEBUG_SYNC='now WAIT_FOR unsent_claim_won TIMEOUT 30';
--connection unsent_reset_1
--send RESET DRAIN
--connection unsent_reset_2
--send RESET DRAIN
--connection unsent_source_ha
--let $wait_condition= SELECT COUNT(*)=2 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL unsent_restore_release';

--connection unsent_reset_1
--reap
--connection unsent_reset_2
--reap
--connection unsent_drain
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
SET SESSION debug='-d,preserve_trx_transfer_fail_commit_before_send_once';
SET DEBUG_SYNC='RESET';

--connection unsent_app_2
--let $assert_text= source restore claimant preserves the original transaction connection
--let $assert_cond= `SELECT CONNECTION_ID()=$app_2_connection_id`
--source include/assert.inc
UPDATE t_unsent_restore_reset SET v=v+10 WHERE id=3;
COMMIT;

--connection unsent_source_ha
--let $assert_text= neither pre-send failure enters COMMIT_UNKNOWN
--let $assert_cond= `SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')=@unknown_before`
--source include/assert.inc

--connection unsent_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@receiver_active_before
--source include/wait_condition.inc

--connection unsent_marker
--enable_result_log
SELECT id,v FROM t_unsent_restore_reset ORDER BY id;
--disable_result_log

--connection default
DROP TABLE t_unsent_restore_reset;
DROP USER unsent_restore_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;

--connection unsent_receiver
DROP USER preserve_trx_ha_admin@localhost;

--connection default
--remove_file $credential_file
--enable_result_log
SELECT 'ok' AS unsent_transaction_restore_reset_race;
--enable_query_log

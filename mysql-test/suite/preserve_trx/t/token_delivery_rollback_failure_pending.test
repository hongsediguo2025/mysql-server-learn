--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_token_rollback_failure;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* token delivery cleanup failed.*");
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .*token is pending and cannot be resumed");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: durable consume-state cleanup");
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;
CREATE USER preserve_pending_intruder@localhost;

CREATE TABLE t_preserve_token_rollback_failure(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_token_rollback_failure VALUES(1,10);

--connect(preserve_owner,localhost,root,,test)
--connection preserve_owner
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET SESSION debug="+d,preserve_trx_fail_token_delivery_rollback";
SET DEBUG_SYNC =
  'preserve_trx_before_token_delivery SIGNAL before_token_rollback WAIT_FOR continue_owner';
START TRANSACTION;
UPDATE t_preserve_token_rollback_failure SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR before_token_rollback TIMEOUT 10';
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserve_conn_id CONN_ID
--eval KILL CONNECTION $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_owner';

--connection preserve_owner
--error 2013
--reap
--disconnect preserve_owner

--connection default
SELECT * FROM t_preserve_token_rollback_failure WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT STATE AS preserved_state
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS preserved_count_with_last_error
  FROM performance_schema.preserved_transactions
 WHERE LAST_ERROR IS NOT NULL;
SELECT COUNT(*) AS preserved_count_with_last_error_at
  FROM performance_schema.preserved_transactions
 WHERE LAST_ERROR_AT IS NOT NULL;

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= failed to rollback durable transaction
--let $grep_output= count
--source include/grep_pattern.inc

--connect(intruder,localhost,preserve_pending_intruder,,test)
--connection intruder
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_ACCESS_DENIED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect intruder

--connection default
--connect(resume_probe,localhost,root,,test)
--connection resume_probe
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect resume_probe

--connection default
--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_restart
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SELECT * FROM t_preserve_token_rollback_failure WHERE a=1;

DROP TABLE t_preserve_token_rollback_failure;
DROP USER preserve_pending_intruder@localhost;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery failed: preserved temporary table image sidecar digest mismatch");
CALL mtr.add_suppression("Preserved transaction .* recovery failed: preserved temporary table undo sidecar digest mismatch");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved temporary table image sidecar digest mismatch");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved temporary table undo sidecar digest mismatch");
CALL mtr.add_suppression("TEMP_SIDECAR_CORRUPT_DEFERRED.*preserved temporary table image sidecar digest mismatch");
CALL mtr.add_suppression("TEMP_SIDECAR_CORRUPT_DEFERRED.*preserved temporary table undo sidecar digest mismatch");
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source include/wait_until_disconnected.inc

--let TEMP_SNAPSHOT_TOKEN= corrupt_temp_image
--let TEMP_SNAPSHOT_SPACE_ID= 4243767291
--let TEMP_SNAPSHOT_CORRUPT_IMAGE= 1
--let TEMP_SNAPSHOT_INCLUDE_UNDO= 1
--let TEMP_SNAPSHOT_CORRUPT_UNDO= 0
--source suite/preserve_trx/include/write_temp_table_preserved_snapshot.inc

--let TEMP_SNAPSHOT_TOKEN= corrupt_temp_undo
--let TEMP_SNAPSHOT_SPACE_ID= 4243767292
--let TEMP_SNAPSHOT_CORRUPT_IMAGE= 0
--let TEMP_SNAPSHOT_INCLUDE_UNDO= 1
--let TEMP_SNAPSHOT_CORRUPT_UNDO= 1
--source suite/preserve_trx/include/write_temp_table_preserved_snapshot.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=OFF" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_text= Corrupt preserved temp image is reported
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= preserved temporary table image sidecar digest mismatch
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

--let $assert_text= Corrupt preserved temp undo is reported
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= preserved temporary table undo sidecar digest mismatch
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--perl
use strict;
use warnings;
use File::Spec;
my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
for my $name (
  'corrupt_temp_image.bin',
  'corrupt_temp_image.tempts.4243767291.image',
  'corrupt_temp_image.tempts.4243767291.undo',
  'corrupt_temp_undo.bin',
  'corrupt_temp_undo.tempts.4243767292.image',
  'corrupt_temp_undo.tempts.4243767292.undo') {
  my $path = File::Spec->catfile($preserve_dir, $name);
  die "unexpected preserved temp artifact remains: $path" if -e $path;
}
EOF

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

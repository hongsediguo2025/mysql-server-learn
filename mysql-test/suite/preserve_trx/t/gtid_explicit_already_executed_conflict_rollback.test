--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_gtid_conflict_preserved;
DROP TABLE IF EXISTS t_gtid_conflict_marker;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

SET SESSION sql_log_bin=0;
CREATE TABLE t_gtid_conflict_preserved(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
CREATE TABLE t_gtid_conflict_marker(a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t_gtid_conflict_preserved VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;

--let MYSQLD_DATADIR= `SELECT @@datadir`
--let $server_uuid= `SELECT @@GLOBAL.SERVER_UUID`
--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
UPDATE t_gtid_conflict_preserved SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
SELECT COUNT(*) AS preserved_count_before_gtid_conflict
  FROM performance_schema.preserved_transactions;

--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
INSERT INTO t_gtid_conflict_marker VALUES(7);
COMMIT;
SET GTID_NEXT=AUTOMATIC;

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT * FROM t_gtid_conflict_preserved ORDER BY a;
SELECT * FROM t_gtid_conflict_marker ORDER BY a;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SET SESSION sql_log_bin=0;
DROP TABLE t_gtid_conflict_preserved, t_gtid_conflict_marker;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL rds_preserve_trx_enable=ON;

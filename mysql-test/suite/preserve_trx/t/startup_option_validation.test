--source include/not_windows.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`
--let $error_log= $MYSQLTEST_VARDIR/log/preserve_trx_startup_option.err

SET GLOBAL rds_preserve_trx_enable=ON;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

--perl
use strict;
use warnings;
use File::Path qw(make_path remove_tree);
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $target = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve-real-target');
rmdir($dir) or die "cannot remove preserve dir before directory symlink test: $!";
remove_tree($target) if -e $target;
make_path($target, {mode => 0700});
symlink($target, $dir) or die "cannot create preserve directory symlink: $!";
print "preserve path is directory symlink\n";
EOF

--perl
use strict;
use warnings;
my $path = $ENV{'error_log'} || '';
unlink $path if $path ne '' && -e $path;
EOF

--error 1
--exec $MYSQLD_CMD --validate-config --rds-preserve-trx-enable=ON --log-error=$error_log > $error_log 2>&1

--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= rds_preserve_trx_enable=ON requires valid snapshot support
--source include/search_pattern.inc

--perl
use strict;
use warnings;
use File::Path qw(remove_tree);
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $target = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve-real-target');
unlink($dir) or die "cannot remove preserve directory symlink: $!";
remove_tree($target) if -e $target;
EOF

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
rmdir($dir) or die "cannot remove preserve dir: $!";
open(my $preserve_fh, '>', $dir) or die "cannot create preserve file: $!";
print {$preserve_fh} 'not a directory';
close($preserve_fh);
print "preserve path is file\n";
EOF

--perl
use strict;
use warnings;
my $path = $ENV{'error_log'} || '';
unlink $path if $path ne '' && -e $path;
EOF

--error 1
--exec $MYSQLD_CMD --validate-config --rds-preserve-trx-enable=ON --log-error=$error_log > $error_log 2>&1

--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= rds_preserve_trx_enable=ON requires valid snapshot support
--source include/search_pattern.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
unlink($dir) or die "cannot remove preserve file: $!";
EOF

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
die "preserve dir missing: $dir" unless -d $dir;
chmod(0000, $dir) or die "cannot remove preserve dir access: $!";
print "preserve dir inaccessible\n";
EOF

--perl
use strict;
use warnings;
my $path = $ENV{'error_log'} || '';
unlink $path if $path ne '' && -e $path;
EOF

--error 1
--exec $MYSQLD_CMD --validate-config --rds-preserve-trx-enable=ON --log-error=$error_log > $error_log 2>&1

--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= rds_preserve_trx_enable=ON requires valid snapshot support
--source include/search_pattern.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
chmod(0700, $dir) or die "cannot restore preserve dir access: $!";
EOF

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
rmdir($dir) or die "cannot remove preserve dir before symlink test: $!";
symlink('missing-preserve-target', $dir) or die "cannot create dangling symlink: $!";
print "preserve path is dangling symlink\n";
EOF

--perl
use strict;
use warnings;
my $path = $ENV{'error_log'} || '';
unlink $path if $path ne '' && -e $path;
EOF

--error 1
--exec $MYSQLD_CMD --validate-config --rds-preserve-trx-enable=ON --log-error=$error_log > $error_log 2>&1

--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= rds_preserve_trx_enable=ON requires valid snapshot support
--source include/search_pattern.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
unlink($dir) or die "cannot remove preserve symlink: $!";
EOF

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

--remove_file $error_log

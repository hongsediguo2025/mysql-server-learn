--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_conversion_fence;
--enable_warnings

--let $old_rds_preserve_trx_enable= `SELECT @@GLOBAL.rds_preserve_trx_enable`

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_lock_warmcopy_conversion_fence(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_conversion_fence VALUES(1,10),(2,20);

--connect(lock_wc_conversion_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_conversion_fence SET v=11 WHERE id=1;
SET SESSION debug="+d,preserve_trx_lock_warmcopy_simulate_conversion_after_freeze";

--connection default
SET SESSION debug="+d,preserve_trx_lock_warmcopy_simulate_conversion_after_freeze";
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= lock warmcopy fence mismatch is logged
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=fence_mismatch.*reason=seal_fence_changed
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= lock warmcopy fence mismatch falls back to live export
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=live_fallback.*reason=seal_fence_changed
--source include/assert_grep.inc
SELECT COUNT(*) AS preserved_count_after_conversion_fallback
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(lock_wc_conversion_resume, localhost, root,,test)
--connection lock_wc_conversion_resume
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
UPDATE t_lock_warmcopy_conversion_fence SET v=21 WHERE id=2;
COMMIT;
--disconnect lock_wc_conversion_resume

--connection default
SELECT id, v FROM t_lock_warmcopy_conversion_fence ORDER BY id;

--connect(lock_wc_snapshot_fence_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_conversion_fence SET v=31 WHERE id=1;
SET SESSION debug="+d,preserve_trx_lock_warmcopy_simulate_conversion_after_snapshot_write";

--connection default
SET SESSION debug="+d,preserve_trx_lock_warmcopy_simulate_conversion_after_snapshot_write";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_lock_warmcopy_simulate_conversion_after_snapshot_write";
SELECT COUNT(*) AS preserved_count_after_snapshot_fence_reject
  FROM performance_schema.preserved_transactions;

--connection lock_wc_snapshot_fence_app
SET SESSION debug="-d,preserve_trx_lock_warmcopy_simulate_conversion_after_snapshot_write";
UPDATE t_lock_warmcopy_conversion_fence SET v=32 WHERE id=2;
COMMIT;
--disconnect lock_wc_snapshot_fence_app

--connection default
SELECT id, v FROM t_lock_warmcopy_conversion_fence ORDER BY id;

DROP TABLE t_lock_warmcopy_conversion_fence;
--disable_query_log
--eval SET GLOBAL rds_preserve_trx_enable=$old_rds_preserve_trx_enable
--enable_query_log

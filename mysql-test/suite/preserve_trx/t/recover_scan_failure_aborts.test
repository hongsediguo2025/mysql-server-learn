--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_scan_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Failed to scan preserved transaction directory .* during recovery");
CALL mtr.add_suppression("PRESERVE: recovery failed before InnoDB background threads could start");
CALL mtr.add_suppression("PRESERVE: rolled back prepared transaction without snapshot during recovery");
CALL mtr.add_suppression("Assertion failure: ha_innodb.cc:.*ib::fatal triggered");
CALL mtr.add_suppression("\\[FATAL\\] Error in DDL Log recovery during Post-Recovery processing");
CALL mtr.add_suppression("Assertion failure: ut0ut.cc:.*");
CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
--enable_query_log

CREATE TABLE t_recover_scan_failure(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_scan_failure VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recover_scan_failure WHERE a=1 FOR UPDATE;
UPDATE t_recover_scan_failure SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= --preserve-trx-enable=ON --debug=d,preserve_trx_fail_recover_scan
--source include/start_mysqld_expecting_crash.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Failed to scan preserved transaction directory .* during recovery
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/wait_for_expected_crash.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--source suite/preserve_trx/include/ha_crash_abandon_preserve_artifacts.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_recover_scan_failure ORDER BY a;

DROP TABLE t_recover_scan_failure;
SET GLOBAL preserve_trx_enable=ON;

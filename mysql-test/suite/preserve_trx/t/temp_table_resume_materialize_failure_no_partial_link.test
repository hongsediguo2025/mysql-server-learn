--source include/not_windows.inc
--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_partial_link_base;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_preserve_partial_link_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_partial_link_base VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_preserve_partial_link_a(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_preserve_partial_link_b(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;

INSERT INTO tmp_preserve_partial_link_a VALUES(1, 10), (2, 21);
INSERT INTO tmp_preserve_partial_link_b VALUES(11, 110), (12, 122);

START TRANSACTION;
UPDATE t_preserve_partial_link_base SET v = 11 WHERE id = 1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let $expect_bin= 1
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

SET SESSION debug="+d,preserve_temp_fail_after_open_before_link";
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug="-d,preserve_temp_fail_after_open_before_link";

SELECT COUNT(*) AS preserved_count_after_failed_resume
  FROM performance_schema.preserved_transactions;
SELECT LAST_ERROR IS NOT NULL AS failed_resume_has_error
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS active_innodb_trx_after_failed_resume
  FROM information_schema.innodb_trx
 WHERE trx_mysql_thread_id = CONNECTION_ID();
--error ER_NO_SUCH_TABLE
SELECT COUNT(*) FROM tmp_preserve_partial_link_a;
--error ER_NO_SUCH_TABLE
SELECT COUNT(*) FROM tmp_preserve_partial_link_b;

--let $expect_bin= 1
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT COUNT(*) AS preserved_count_after_retry_resume
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS partial_link_a_rows, SUM(v) AS partial_link_a_sum
  FROM tmp_preserve_partial_link_a;
SELECT COUNT(*) AS partial_link_b_rows, SUM(v) AS partial_link_b_sum
  FROM tmp_preserve_partial_link_b;

INSERT INTO tmp_preserve_partial_link_a VALUES(3, 30);
INSERT INTO tmp_preserve_partial_link_b VALUES(13, 130);
COMMIT;
SELECT * FROM t_preserve_partial_link_base ORDER BY id;
SELECT COUNT(*) AS a_rows_after_commit, SUM(v) AS a_sum_after_commit
  FROM tmp_preserve_partial_link_a;
SELECT COUNT(*) AS b_rows_after_commit, SUM(v) AS b_sum_after_commit
  FROM tmp_preserve_partial_link_b;

DROP TEMPORARY TABLE tmp_preserve_partial_link_a;
DROP TEMPORARY TABLE tmp_preserve_partial_link_b;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_preserve_partial_link_base;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

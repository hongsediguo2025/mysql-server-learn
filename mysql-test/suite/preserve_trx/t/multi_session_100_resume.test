--source include/big_test.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--perl
use strict;
use warnings;
use File::Spec;

my $vardir = $ENV{'MYSQLTEST_VARDIR'} or die "MYSQLTEST_VARDIR is not set";
my $setup_file = File::Spec->catfile($vardir, 'tmp',
                                     'preserve_trx_multi_session_100_setup.inc');
my $apps_file = File::Spec->catfile($vardir, 'tmp',
                                    'preserve_trx_multi_session_100_preserve.inc');
my $apps_disconnect_file = File::Spec->catfile(
    $vardir, 'tmp', 'preserve_trx_multi_session_100_apps_disconnect.inc');
my $cleanup_file = File::Spec->catfile($vardir, 'tmp',
                                       'preserve_trx_multi_session_100_cleanup.inc');

open(my $setup, '>', $setup_file)
  or die "cannot open $setup_file for write: $!";
open(my $apps, '>', $apps_file)
  or die "cannot open $apps_file for write: $!";
open(my $apps_disconnect, '>', $apps_disconnect_file)
  or die "cannot open $apps_disconnect_file for write: $!";
open(my $cleanup, '>', $cleanup_file)
  or die "cannot open $cleanup_file for write: $!";

print $cleanup "DROP TABLE IF EXISTS t_multi_session_100_tokens;\n";
print $cleanup "DROP TABLE IF EXISTS t_multi_session_100_resume;\n";

print $setup "CREATE TABLE t_multi_session_100_resume(" .
             "id INT PRIMARY KEY, " .
             "v INT, " .
             "resumed_by INT DEFAULT NULL) ENGINE=InnoDB;\n";
print $setup "CREATE TABLE t_multi_session_100_tokens(" .
             "session_id INT PRIMARY KEY AUTO_INCREMENT, " .
             "token VARCHAR(255) NOT NULL UNIQUE) ENGINE=InnoDB;\n";

for my $i (1 .. 100) {
  my $app_name = sprintf("multi_session_app_%03d", $i);
  print $apps "--connect($app_name,localhost,root,,test)\n";
  print $apps "--connection $app_name\n";
  print $apps "START TRANSACTION;\n";
  print $apps "INSERT INTO t_multi_session_100_resume VALUES($i, " .
              ($i * 10) . ", NULL);\n";
  print $apps_disconnect "--disconnect $app_name\n";
}
print $apps "--connection default\n";
print $apps_disconnect "--connection default\n";

close($setup);
close($apps);
close($apps_disconnect);
close($cleanup);
EOF

--disable_query_log
--disable_result_log
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_cleanup.inc
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_setup.inc
--enable_result_log
--enable_query_log

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=3600000;

--disable_query_log
--disable_result_log
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_preserve.inc
--enable_result_log
--enable_query_log

--let $wait_condition= SELECT COUNT(*) = 100 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=LOCAL_CARRIER --rds-preserve-trx-token-retention-timeout-ms=3600000 --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--disable_query_log
--disable_result_log
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_apps_disconnect.inc
INSERT INTO t_multi_session_100_tokens(token)
SELECT TOKEN
  FROM performance_schema.preserved_transactions
 ORDER BY TOKEN;
--enable_result_log
--enable_query_log

SELECT COUNT(*) AS mapped_token_count
  FROM t_multi_session_100_tokens;

SELECT COUNT(*) AS preserved_count_after_generation
  FROM performance_schema.preserved_transactions;

--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
SET SESSION group_concat_max_len=1000000;
--let $write_to_file= $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_resume.inc
--let $write_var= `SELECT GROUP_CONCAT(CONCAT('--connect(resume_', LPAD(session_id, 3, '0'), ',localhost,root,,test)\\n', '--connection resume_', LPAD(session_id, 3, '0'), '\\n', 'RESUME PRESERVED TRANSACTION \"', token, '\";\\n', 'SET @multi_session_row_id = NULL;\\n', 'SELECT id INTO @multi_session_row_id FROM t_multi_session_100_resume WHERE resumed_by IS NULL ORDER BY id LIMIT 1;\\n', 'UPDATE t_multi_session_100_resume SET v = v + 100000, resumed_by = @multi_session_row_id WHERE id = @multi_session_row_id;\\n', 'COMMIT;\\n') ORDER BY session_id SEPARATOR '') FROM t_multi_session_100_tokens`
--source include/write_var_to_file.inc
--enable_query_log

--perl
use strict;
use warnings;
use File::Spec;

require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
my @tokens = PreserveSnapshotFiles::preserve_snapshot_tokens($preserve_dir);

die "expected 100 preserved snapshots, found " . scalar(@tokens) . "\n"
  unless scalar(@tokens) == 100;
EOF

--append_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_resume.inc
--connection default
EOF

--disable_query_log
--disable_result_log
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_resume.inc
--perl
use strict;
use warnings;
use File::Spec;

my $vardir = $ENV{'MYSQLTEST_VARDIR'} or die "MYSQLTEST_VARDIR is not set";
my $file = File::Spec->catfile($vardir, 'tmp',
                               'preserve_trx_multi_session_100_disconnect.inc');
open(my $fh, '>', $file) or die "cannot open $file for write: $!";
for my $idx (1 .. 100) {
  my $name = sprintf("resume_%03d", $idx);
  print $fh "--disconnect $name\n";
}
print $fh "--connection default\n";
close($fh);
EOF
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_disconnect.inc
--enable_result_log
--enable_query_log

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;

SELECT COUNT(*) AS row_count,
       COUNT(DISTINCT id) AS distinct_keys,
       SUM(resumed_by IS NOT NULL) AS resumed_rows,
       SUM(v >= 100000) AS bumped_rows
  FROM t_multi_session_100_resume;

--perl
use strict;
use warnings;
use File::Spec;

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
if (-d $preserve_dir) {
  opendir(my $dh, $preserve_dir)
    or die "cannot open preserve dir $preserve_dir: $!";
  my @leftovers = grep {
    /\.(?:bin|binlog_cache)(?:\.tmp)?$/ &&
      -f File::Spec->catfile($preserve_dir, $_);
  } readdir($dh);
  closedir($dh);
  die "expected no preserved transaction files after resume, found: " .
      join(", ", sort @leftovers) . "\n"
    if @leftovers;
}
EOF

--remove_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_preserve.inc
--remove_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_apps_disconnect.inc
--remove_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_resume.inc
--remove_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_disconnect.inc

--disable_query_log
--disable_result_log
--source $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_cleanup.inc
--enable_result_log
--enable_query_log

--remove_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_setup.inc
--remove_file $MYSQLTEST_VARDIR/tmp/preserve_trx_multi_session_100_cleanup.inc

SET GLOBAL rds_preserve_trx_enable=ON;
--disable_query_log
--disable_result_log
--enable_result_log
--enable_query_log

--let $prefix_replace= 0
--let $prefix_fail= 0
--let $prefix_resize= 0
--let $prefix_copy_fault= 0
--let $prefix_rebuild= 0
--let $prefix_inflight= 0
--let $prefix_seal_mutation= 2
--let $prefix_seal_failure= 1
--source suite/preserve_trx/include/receiver_binlog_prefix_prewarm.inc

--perl
open my $fh, '<', "$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err" or die $!;
my $corrupt = 0;
my $restored = 0;
while (<$fh>) {
  if (/^CURRENT_TEST:/) { $corrupt = 0; $restored = 0; next; }
  ++$corrupt if /receiver semantic apply failed .*frame_type=3 .*object=binlog_cache status=CORRUPT/;
  ++$restored if /PRESERVE_PHASE2_FINAL_V1 .*source_terminal_status=SOURCE_RESTORED .*first_failure_stage=standby_transfer_receiver_not_committed_clean/;
  # Authenticated failure may stop the target pipeline before COMMIT. The
  # include above verifies receiver cleanup and live source transaction data.
  ++$restored if /PRESERVE_PHASE2_FINAL_V1 .*final_ack_us=0 .*source_terminal_status=RUNNING .*first_failure_stage=early_target_pipeline_failed/;
}
die "truncated binlog did not fail protocol SEAL" unless $corrupt > 0;
die "corrupt binlog did not confirm clean source restore" unless $restored > 0;
print "truncated_prefix_rejected_by_protocol_seal\n1\n";
EOF

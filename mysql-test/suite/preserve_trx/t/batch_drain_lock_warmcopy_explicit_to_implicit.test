--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_explicit_to_implicit;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_fallback= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_lock_warmcopy_explicit_to_implicit(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_explicit_to_implicit VALUES
  (1,10,REPEAT('a',32)),
  (3,30,REPEAT('c',32));

--connect(lock_wc_explicit_to_implicit_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_explicit_to_implicit
  SET v=11, pad=REPEAT('x',32)
  WHERE id=1;
SAVEPOINT keep_one;
INSERT INTO t_lock_warmcopy_explicit_to_implicit
  VALUES(2,20,REPEAT('b',32));

--connect(lock_wc_explicit_to_implicit_materializer, localhost, root,,test)
--connection lock_wc_explicit_to_implicit_materializer
SET innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
SELECT id FROM t_lock_warmcopy_explicit_to_implicit
  WHERE id=2
  FOR UPDATE;
--disconnect lock_wc_explicit_to_implicit_materializer

--connection default
SELECT COUNT(*) > 0 AS explicit_insert_lock_materialized
  FROM performance_schema.data_locks
  WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_lock_warmcopy_explicit_to_implicit'
    AND INDEX_NAME='PRIMARY'
    AND LOCK_TYPE='RECORD'
    AND LOCK_STATUS='GRANTED';

--connect(lock_wc_explicit_to_implicit_owner, localhost, root,,test)
--connection lock_wc_explicit_to_implicit_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_phase1_open SIGNAL lock_wc_explicit_to_implicit_open WAIT_FOR lock_wc_explicit_to_implicit_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_explicit_to_implicit_open TIMEOUT 10';

--connection lock_wc_explicit_to_implicit_app
ROLLBACK TO SAVEPOINT keep_one;

--connection default
SET DEBUG_SYNC = 'now SIGNAL lock_wc_explicit_to_implicit_continue';

--connection lock_wc_explicit_to_implicit_owner
--reap
--disconnect lock_wc_explicit_to_implicit_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= lock warmcopy succeeds after explicit record release
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=warmcopy_success.*reason=ok
--let $assert_count_condition= >= 1
--source include/assert_grep.inc

SELECT COUNT(*) AS preserved_count_after_explicit_to_implicit
  FROM performance_schema.preserved_transactions;

--connect(lock_wc_explicit_to_implicit_probe, localhost, root,,test)
--connection lock_wc_explicit_to_implicit_probe
SET innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t_lock_warmcopy_explicit_to_implicit
  VALUES(2,220,REPEAT('z',32));
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_lock_warmcopy_explicit_to_implicit
  SET v=110, pad=REPEAT('q',32)
  WHERE id=1;
--disconnect lock_wc_explicit_to_implicit_probe

--connection default
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(lock_wc_explicit_to_implicit_resume, localhost, root,,test)
--connection lock_wc_explicit_to_implicit_resume
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
--disconnect lock_wc_explicit_to_implicit_resume

--connection default
SELECT COUNT(*) AS preserved_count_after_explicit_to_implicit_resume
  FROM performance_schema.preserved_transactions;
INSERT INTO t_lock_warmcopy_explicit_to_implicit
  VALUES(2,220,REPEAT('z',32));
SELECT id, v, pad IN (REPEAT('x',32), REPEAT('z',32), REPEAT('c',32)) AS pad_ok
  FROM t_lock_warmcopy_explicit_to_implicit
  ORDER BY id;

DROP TABLE t_lock_warmcopy_explicit_to_implicit;
SET DEBUG_SYNC = 'RESET';

--disable_query_log
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=$old_preserve_trx_lock_warmcopy_fallback
--eval SET GLOBAL preserve_trx_lock_warmcopy_enable=$old_preserve_trx_lock_warmcopy_enable
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log

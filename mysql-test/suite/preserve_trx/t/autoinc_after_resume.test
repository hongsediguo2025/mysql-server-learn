--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_autoinc_after_resume;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_autoinc_after_resume(
  id INT AUTO_INCREMENT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO t_autoinc_after_resume(v) VALUES(10);
SELECT LAST_INSERT_ID() AS first_insert_id;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, AUTOINC_LOCK_OWNED
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT LAST_INSERT_ID() AS resumed_last_insert_id;

INSERT INTO t_autoinc_after_resume(v) VALUES(20);
SELECT LAST_INSERT_ID() AS second_insert_id;

COMMIT;
SELECT * FROM t_autoinc_after_resume ORDER BY id;

DROP TABLE t_autoinc_after_resume;
SET GLOBAL rds_preserve_trx_enable=ON;

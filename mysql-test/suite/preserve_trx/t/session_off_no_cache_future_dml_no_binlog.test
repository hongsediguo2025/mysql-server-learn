--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_session_off_future_dml;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SET SESSION sql_log_bin=0;

CREATE TABLE t_session_off_future_dml(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_session_off_future_dml VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_session_off_future_dml WHERE a=1 FOR UPDATE;
UPDATE t_session_off_future_dml SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT BINLOG_STATE, SESSION_SQL_LOG_BIN, WROTE_TO_CACHE, BINLOG_CACHE_SIZE
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.sql_log_bin AS session_sql_log_bin_after_resume;
UPDATE t_session_off_future_dml SET b=12 WHERE a=1;
COMMIT;
SELECT * FROM t_session_off_future_dml WHERE a=1;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/session_off_future_dml.mysqlbinlog
--let $assert_text= resumed session-off transaction remains absent from binlog
--let $assert_file= $MYSQLTEST_VARDIR/tmp/session_off_future_dml.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_session_off_future_dml`
--let $assert_count= 0
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/session_off_future_dml.mysqlbinlog
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_session_off_future_dml;
SET GLOBAL preserve_trx_enable=ON;

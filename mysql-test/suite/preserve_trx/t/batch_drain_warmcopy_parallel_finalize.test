--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_parallel_finalize_tokens;
DROP TABLE IF EXISTS t_warmcopy_parallel_finalize;
--enable_warnings

--let $old_rds_preserve_trx_enable= `SELECT @@GLOBAL.rds_preserve_trx_enable`

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;

CREATE TABLE t_warmcopy_parallel_finalize(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(256)
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_parallel_finalize VALUES
  (1,10,REPEAT('a',256)),
  (2,20,REPEAT('b',256));

--connect(warmcopy_parallel_a, localhost, root,,test)
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_finalize_admission SIGNAL warmcopy_finalize_a_admitted WAIT_FOR warmcopy_finalize_a_release TIMEOUT 5';
START TRANSACTION;
UPDATE t_warmcopy_parallel_finalize
  SET v=11, pad=REPEAT('x',256) WHERE id=1;

--connect(warmcopy_parallel_b, localhost, root,,test)
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_before_finalize_admission WAIT_FOR warmcopy_finalize_a_admitted';
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_finalize_admission SIGNAL warmcopy_finalize_a_release';
START TRANSACTION;
UPDATE t_warmcopy_parallel_finalize
  SET v=22, pad=REPEAT('y',256) WHERE id=2;

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--let _WARM_FINALIZE_ERR_LOG= $MYSQLTEST_VARDIR/log/mysqld.1.err
--perl
use strict;
use warnings;

open(my $fh, '<', $ENV{'_WARM_FINALIZE_ERR_LOG'})
  or die "cannot read mysqld error log: $!";
my $metrics;
while (my $line = <$fh>) {
  $metrics = $line if $line =~ /PRESERVE: warm-copy drain metrics /;
}
close($fh);
die "missing warm-copy drain metrics\n" unless defined($metrics);
$metrics =~ /phase2_total_us=(\d+)/
  or die "missing phase2_total_us in warm-copy drain metrics\n";
die "cross-token warmcopy finalize remained serialized: phase2_total_us=$1\n"
  if $1 >= 2000000;
$metrics =~ /phase2_preserve_worker_count=2(?:\D|$)/
  or die "parallel preserve workers were not exercised\n";
EOF

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
CREATE TABLE t_warmcopy_parallel_finalize_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
  FROM performance_schema.preserved_transactions;
--let $token1= `SELECT TOKEN FROM t_warmcopy_parallel_finalize_tokens WHERE rn=1`
--let $token2= `SELECT TOKEN FROM t_warmcopy_parallel_finalize_tokens WHERE rn=2`

--connect(warmcopy_parallel_resume_1, localhost, root,,test)
--replace_result $token1 TOKEN1
--eval RESUME PRESERVED TRANSACTION '$token1'
COMMIT;
--disconnect warmcopy_parallel_resume_1

--connect(warmcopy_parallel_resume_2, localhost, root,,test)
--replace_result $token2 TOKEN2
--eval RESUME PRESERVED TRANSACTION '$token2'
COMMIT;
--disconnect warmcopy_parallel_resume_2

--connection default
SELECT id, v, pad IN (REPEAT('x',256), REPEAT('y',256)) AS pad_ok
  FROM t_warmcopy_parallel_finalize
  ORDER BY id;
DROP TABLE t_warmcopy_parallel_finalize_tokens;
DROP TABLE t_warmcopy_parallel_finalize;

--disable_query_log
--eval SET GLOBAL rds_preserve_trx_enable=$old_rds_preserve_trx_enable
--enable_query_log
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET DEBUG_SYNC = 'RESET';

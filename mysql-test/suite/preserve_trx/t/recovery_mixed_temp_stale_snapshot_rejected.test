--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_mixed_stale_snapshot;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");
--enable_query_log

CREATE TABLE t_mixed_stale_snapshot(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_mixed_stale_snapshot VALUES(1, 10), (2, 20);

--connect(mixed_stale_target,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_mixed_stale_snapshot(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO tmp_mixed_stale_snapshot VALUES(1, 100);
START TRANSACTION;
UPDATE t_mixed_stale_snapshot SET v=11 WHERE id=1;
UPDATE tmp_mixed_stale_snapshot SET v=101 WHERE id=1;

--connect(mixed_stale_second_target,localhost,root,,test)
START TRANSACTION;
UPDATE t_mixed_stale_snapshot SET v=21 WHERE id=2;

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_delete_snapshot_files";
--error ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_delete_snapshot_files";

SELECT COUNT(*) AS preserved_count_before_restart
  FROM performance_schema.preserved_transactions;

--perl
use strict;
use warnings;
use File::Spec;

require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite', 'preserve_trx',
                            'include', 'preserve_snapshot_files.pl');

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my @snapshots = PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
my @all_files = PreserveSnapshotFiles::preserve_all_files($dir);
my @staged_snapshots = grep { /\.bin\.tmp$/ } @all_files;
my @temp_sidecars = grep { /\.tempts\.\d+\./ }
  @all_files;
my @tainted = grep { /\.tainted$/ } @all_files;
die "unexpected published mixed snapshot, found " . scalar(@snapshots) . "\n"
  unless @snapshots == 0;
die "expected one unpublished mixed snapshot, found " .
    scalar(@staged_snapshots) . "\n"
  unless @staged_snapshots == 1;
die "expected stale temporary-table sidecars\n" unless @temp_sidecars > 0;
die "expected one tainted marker, found " . scalar(@tainted) . "\n"
  unless @tainted == 1;
EOF

--connection mixed_stale_target
SELECT v AS target_value_before_disconnect
  FROM t_mixed_stale_snapshot WHERE id=1;
--disconnect mixed_stale_target

--connection mixed_stale_second_target
SELECT v AS second_target_value_before_disconnect
  FROM t_mixed_stale_snapshot WHERE id=2;
--disconnect mixed_stale_second_target

--connection default
--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_restart
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SELECT * FROM t_mixed_stale_snapshot ORDER BY id;

DROP TABLE t_mixed_stale_snapshot;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

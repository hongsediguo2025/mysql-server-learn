--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_unsupported_context;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SELECT GET_LOCK('resume_unsupported_missing_token_lock', 0)
  AS got_missing_token_lock;
--error ER_PRESERVE_TRX_UNSUPPORTED
RESUME PRESERVED TRANSACTION 'msp_resume_missing_context_token';
SELECT RELEASE_LOCK('resume_unsupported_missing_token_lock')
  AS released_missing_token_lock;

CREATE TABLE t_resume_unsupported_context(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_resume_unsupported_context VALUES(1,10);

START TRANSACTION;
UPDATE t_resume_unsupported_context SET v=20 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

HANDLER t_resume_unsupported_context OPEN;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
HANDLER t_resume_unsupported_context CLOSE;

SELECT GET_LOCK('resume_unsupported_context_lock', 0) AS got_lock;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT RELEASE_LOCK('resume_unsupported_context_lock') AS released_lock;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_resume_unsupported_context ORDER BY id;

DROP TABLE t_resume_unsupported_context;
SET GLOBAL preserve_trx_enable=ON;

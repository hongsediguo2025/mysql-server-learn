--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_drain;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_drain_mode=HARD;

CREATE TABLE t_preserve_drain(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_drain VALUES(1,10),(2,20),(3,30);

--connect(drain_blocker,localhost,root,,test)
--connection drain_blocker
--let $blocker_conn_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
UPDATE t_preserve_drain SET b=21 WHERE a=2;

--connect(drain_preserve,localhost,root,,test)
--connection drain_preserve
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_lock_materialization SIGNAL drain_snapshot_ready WAIT_FOR continue_drain_preserve';
START TRANSACTION;
UPDATE t_preserve_drain SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
# Keep the control connection out of the HARD drain kill set.
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR drain_snapshot_ready TIMEOUT 10';
--replace_result $blocker_conn_id BLOCKER_ID
--eval SELECT COUNT(*) AS blocker_thread_count FROM performance_schema.threads WHERE PROCESSLIST_ID = $blocker_conn_id

--connect(drain_writer,localhost,root,,test)
--connection drain_writer
--error ER_PRESERVE_TRX_UNSUPPORTED
UPDATE t_preserve_drain SET b=31 WHERE a=3;
--disconnect drain_writer

--connection default
--replace_result $preserve_conn_id PRESERVE_ID
--eval KILL QUERY $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_drain_preserve';

--connection drain_preserve
--error ER_QUERY_INTERRUPTED
--reap
SET DEBUG_SYNC = 'RESET';
SELECT * FROM t_preserve_drain WHERE a=1;
ROLLBACK;
--disconnect drain_preserve

--disconnect drain_blocker

--connection default
SELECT * FROM t_preserve_drain ORDER BY a;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_drain;
SET GLOBAL preserve_trx_enable=ON;

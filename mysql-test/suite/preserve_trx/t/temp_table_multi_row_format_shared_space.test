--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_multi_row_format_base;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_multi_row_format_base(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_temp_multi_row_format_base VALUES(1,10);

CREATE TEMPORARY TABLE tmp_multi_row_format_compact(
  id INT PRIMARY KEY,
  v VARCHAR(64),
  KEY(v)
) ENGINE=InnoDB ROW_FORMAT=COMPACT;
CREATE TEMPORARY TABLE tmp_multi_row_format_dynamic(
  id INT PRIMARY KEY,
  v VARCHAR(256),
  KEY(v)
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO tmp_multi_row_format_compact VALUES(1,'compact-before');
INSERT INTO tmp_multi_row_format_dynamic VALUES(1,'dynamic-before');

START TRANSACTION;
UPDATE t_temp_multi_row_format_base SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, TEMP_TABLE_STATE, TEMP_SIDECARS_COMPLETE
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_multi_row_format_compact ORDER BY id;
SELECT * FROM tmp_multi_row_format_dynamic ORDER BY id;
INSERT INTO tmp_multi_row_format_compact VALUES(2,'compact-after');
INSERT INTO tmp_multi_row_format_dynamic VALUES(2,'dynamic-after');
COMMIT;

SELECT * FROM t_temp_multi_row_format_base ORDER BY id;
SELECT COUNT(*) AS compact_rows FROM tmp_multi_row_format_compact;
SELECT COUNT(*) AS dynamic_rows FROM tmp_multi_row_format_dynamic;

DROP TEMPORARY TABLE tmp_multi_row_format_compact;
DROP TEMPORARY TABLE tmp_multi_row_format_dynamic;
DROP TABLE t_temp_multi_row_format_base;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_record_lock_varchar_composite;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_record_lock_varchar_composite(
  tenant VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,
  id DECIMAL(10,2) NOT NULL,
  ts DATETIME(6) NOT NULL,
  v INT,
  PRIMARY KEY(tenant, id, ts)
) ENGINE=InnoDB;
INSERT INTO t_record_lock_varchar_composite VALUES
  ('tenant-a', 10.50, '2026-06-06 10:11:12.123456', 10),
  ('tenant-a', 11.50, '2026-06-06 10:11:12.123456', 20);

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_record_lock_varchar_composite
   SET v=101
 WHERE tenant='tenant-a'
   AND id=10.50
   AND ts='2026-06-06 10:11:12.123456';

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT LOCKS_COUNT >= 1 AS has_preserved_locks
  FROM performance_schema.preserved_transactions;

--connect(composite_writer, localhost, root,,test)
SET SESSION innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_record_lock_varchar_composite
   SET v=102
 WHERE tenant='tenant-a'
   AND id=10.50
   AND ts='2026-06-06 10:11:12.123456';
UPDATE t_record_lock_varchar_composite
   SET v=201
 WHERE tenant='tenant-a'
   AND id=11.50
   AND ts='2026-06-06 10:11:12.123456';

--connection default
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection composite_writer
UPDATE t_record_lock_varchar_composite
   SET v=102
 WHERE tenant='tenant-a'
   AND id=10.50
   AND ts='2026-06-06 10:11:12.123456';
--disconnect composite_writer

--connection default
SELECT tenant, id, ts, v
  FROM t_record_lock_varchar_composite
 ORDER BY tenant, id, ts;

DROP TABLE t_record_lock_varchar_composite;
SET GLOBAL preserve_trx_enable=ON;

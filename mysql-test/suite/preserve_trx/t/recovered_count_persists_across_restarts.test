--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recovered_count;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recovered_count(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recovered_count VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recovered_count WHERE a=1 FOR UPDATE;
UPDATE t_recovered_count SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, RECOVERED_COUNT AS recovered_count_after_first_restart
  FROM performance_schema.preserved_transactions;

--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--replace_column 1 TOKEN
SELECT TOKEN, RECOVERED_COUNT AS recovered_count_after_second_restart
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT * FROM t_recovered_count ORDER BY a;

DROP TABLE t_recovered_count;
SET GLOBAL preserve_trx_enable=ON;

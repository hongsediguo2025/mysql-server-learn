--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--disable_result_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

--let $credential_file= $MYSQL_TMP_DIR/resume-required-phase2-commit.secret
--write_file $credential_file
resume-required-phase2-commit-secret
EOF
--exec chmod 600 $credential_file

--connect(phase2_receiver_admin,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-required-phase2-commit-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN,
      RESUME_ANY_PRESERVED_TRANSACTION,
      PROCESS ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
--connect(phase2_receiver_resume,127.0.0.1,preserve_trx_ha_admin,resume-required-phase2-commit-secret,test,$SERVER_MYPORT_2,)

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS resume_required_phase2_app@localhost;
DROP TABLE IF EXISTS t_resume_required_phase2_commit;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-required-phase2-commit-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN, PROCESS ON *.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER resume_required_phase2_app@localhost;
GRANT SELECT, UPDATE ON test.* TO resume_required_phase2_app@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.*
  TO resume_required_phase2_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=resume_required_phase2_commit --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--source include/restart_mysqld.inc
--let $restart_parameters=
--disable_query_log
--disable_result_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

CREATE TABLE t_resume_required_phase2_commit(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_resume_required_phase2_commit VALUES(1,10);

--connect(phase2_source_ha,localhost,preserve_trx_ha_admin,resume-required-phase2-commit-secret,test)
--connect(phase2_source_app,localhost,resume_required_phase2_app,,test)
--let $app_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_resume_required_phase2_commit SET v=11 WHERE id=1;
SET DEBUG_SYNC=
  'phase2_sched_after_execution_entered SIGNAL phase2_commit_entered WAIT_FOR phase2_commit_execute TIMEOUT 30';
--send COMMIT

--connection phase2_source_ha
SET DEBUG_SYNC='now WAIT_FOR phase2_commit_entered TIMEOUT 30';

--connect(phase2_drain_owner,localhost,root,,test)
SET DEBUG_SYNC=
  'phase2_sched_after_t0_registration SIGNAL phase2_t0_registered WAIT_FOR phase2_t0_continue TIMEOUT 30';
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_after_targets_classified SIGNAL phase2_targets_classified WAIT_FOR phase2_drain_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connection phase2_source_ha
SET DEBUG_SYNC='now WAIT_FOR phase2_t0_registered TIMEOUT 30';

# T0 must observe COMMIT in BODY. Let it finish before normal HARD; its
# command-boundary DRAINED_NO_TRANSACTION transition must insert the ID into
# the session-only set before COMMIT_EPOCH is sent.
SET DEBUG_SYNC='now SIGNAL phase2_commit_execute';
--connection phase2_source_app
--reap
--connection phase2_source_ha
SET DEBUG_SYNC='now SIGNAL phase2_t0_continue';
SET DEBUG_SYNC='now WAIT_FOR phase2_targets_classified TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL phase2_drain_continue';
--connection phase2_drain_owner
--reap

--connection phase2_receiver_resume
--eval RESUME PRESERVED TRANSACTION '$app_id'
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$app_id'

--connection phase2_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--disable_result_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

--connect(phase2_source_cleanup,localhost,root,,test)
--enable_result_log
SELECT id, v FROM t_resume_required_phase2_commit ORDER BY id;
--disable_result_log
DROP TABLE t_resume_required_phase2_commit;
DROP USER resume_required_phase2_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
SET DEBUG_SYNC='RESET';

--connection phase2_receiver_admin
DROP USER preserve_trx_ha_admin@localhost;

--connection phase2_source_cleanup
--remove_file $credential_file
--enable_result_log
SELECT 'ok' AS resume_required_phase2_commit;
--enable_query_log

--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_kill_after_pending;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_kill_after_pending(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_kill_after_pending VALUES(1,10);

--connect(preserve_kill_after_pending,localhost,root,,test)
--connection preserve_kill_after_pending
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_token_delivery_pending SIGNAL after_token_pending WAIT_FOR continue_after_token_pending';
SET DEBUG_SYNC =
  'preserve_trx_release_resources_before_finalize SIGNAL release_finalize_pending WAIT_FOR continue_release_finalize';
START TRANSACTION;
UPDATE t_preserve_kill_after_pending SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR after_token_pending TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL CONNECTION $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_after_token_pending';
SET DEBUG_SYNC = 'now WAIT_FOR release_finalize_pending TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL continue_release_finalize';

--connection preserve_kill_after_pending
--error 2013
--reap
--disconnect preserve_kill_after_pending

--connection default
SELECT * FROM t_preserve_kill_after_pending WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_kill_after_pending;
SET GLOBAL preserve_trx_enable=ON;

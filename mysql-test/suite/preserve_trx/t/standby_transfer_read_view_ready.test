--source include/not_windows.inc
--source include/force_restart.inc
--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/standby-read-view.secret
--write_file $credential_file
standby-read-view-secret
EOF
--exec chmod 600 $credential_file

CREATE USER preserve_trx_ha_admin@'127.0.0.1'
  IDENTIFIED BY 'standby-read-view-secret';
GRANT SHUTDOWN, PROCESS, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON test.* TO preserve_trx_ha_admin@'127.0.0.1';
CREATE USER standby_read_view_app@localhost;
GRANT SELECT, UPDATE ON test.* TO standby_read_view_app@localhost;

# Real TCP transfer with identical physical pages. READY is not a claim that
# this online fixture has run physical promotion or installed the ReadView.
--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-standby-phase2-scheduler-mode=DEPENDENCY_CONVERGENCE_V1 --rds-preserve-trx-phase1-capture-mode=BOUNDED_PIPELINE_V1 --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_1 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=standby_read_view --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--source suite/preserve_trx/include/assert_standby_transfer_source.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;
SELECT @@GLOBAL.rds_preserve_trx_standby_phase2_scheduler_mode='DEPENDENCY_CONVERGENCE_V1'
       AND @@GLOBAL.rds_preserve_trx_transfer_artifact_mode='STANDBY_TRANSFER_SAVE'
       AS dependency_standby_mode;
CREATE TABLE t_standby_read_view(id INT PRIMARY KEY, v INT NOT NULL) ENGINE=InnoDB;
INSERT INTO t_standby_read_view VALUES(1,10),(2,200);
--connect(rv_ha,127.0.0.1,preserve_trx_ha_admin,standby-read-view-secret,test,$SERVER_MYPORT_1,)
--connect(rv_app,localhost,standby_read_view_app,,test)
--let $rv_id= `SELECT CONNECTION_ID()`
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT v AS initial_value FROM t_standby_read_view WHERE id=1;
--connection default
UPDATE t_standby_read_view SET v=20 WHERE id=1;
--connection rv_app
SELECT v AS repeatable_value FROM t_standby_read_view WHERE id=1;
UPDATE t_standby_read_view SET v=201 WHERE id=2;
--connection default
--replace_result $rv_id READ_VIEW_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection rv_ha
# This is source record evidence, not a query into the receiver ready cache.
SELECT HAS_READ_VIEW, RV_LOW_LIMIT_NO > 0 AS source_has_read_view_limit
  FROM performance_schema.preserved_transactions;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=1
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc
SELECT VARIABLE_VALUE=1 AS read_view_token_ready FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens';
SELECT VARIABLE_VALUE=0 AS no_not_ready_tokens FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens';
SELECT VARIABLE_VALUE=1 AS one_accepted_epoch FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';
SELECT id,v FROM t_standby_read_view ORDER BY id;

--connection rv_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection rv_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--shutdown_server 0
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--connect(rv_cleanup,localhost,root,,test)
DROP TABLE t_standby_read_view;
DROP USER standby_read_view_app@localhost;
DROP USER preserve_trx_ha_admin@'127.0.0.1';
--remove_file $credential_file
--enable_query_log

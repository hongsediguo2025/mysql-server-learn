# The ABA window is controlled by Debug Sync; Release builds skip this test.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log

--let $credential_file= $MYSQL_TMP_DIR/binlog_savepoint_aba.secret
--write_file $credential_file
binlog-savepoint-aba-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS preserve_trx_aba_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'binlog-savepoint-aba-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT FILE ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER preserve_trx_aba_app@localhost;
GRANT SELECT, UPDATE ON test.* TO preserve_trx_aba_app@localhost;

--let $source_uuid= query_get_value(SELECT @@GLOBAL.server_uuid AS uuid, uuid, 1)
--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-receiver-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-allowed-source-uuid=$source_uuid --preserve-trx-transfer-target-server-uuid=$source_uuid --preserve-trx-transfer-target-socket=$MASTER_MYSOCK --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=binlog_savepoint_aba --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1024;
SET GLOBAL preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL binlog_format=ROW;

--disable_warnings
DROP TABLE IF EXISTS t_binlog_savepoint_aba;
--enable_warnings
CREATE TABLE t_binlog_savepoint_aba(
  id INT PRIMARY KEY,
  note VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_binlog_savepoint_aba VALUES(1, 'seed');
delimiter |;
CREATE PROCEDURE p_binlog_savepoint_aba(IN p_prefix CHAR(1))
BEGIN
  DECLARE i INT DEFAULT 0;
  WHILE i < 200 DO
    SET i=i+1;
    UPDATE t_binlog_savepoint_aba
      SET note=CONCAT(p_prefix, LPAD(i, 6, '0'), REPEAT(p_prefix, 40))
      WHERE id=1;
  END WHILE;
END|
delimiter ;|
GRANT EXECUTE ON PROCEDURE test.p_binlog_savepoint_aba
  TO preserve_trx_aba_app@localhost;

RESET MASTER;
START TRANSACTION;
SAVEPOINT binlog_aba;
CALL p_binlog_savepoint_aba('A');
ROLLBACK TO SAVEPOINT binlog_aba;
CALL p_binlog_savepoint_aba('B');
UPDATE t_binlog_savepoint_aba SET note='transfer-aba-B' WHERE id=1;
COMMIT;

--let $baseline_binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$baseline_binlog_file > $MYSQLTEST_VARDIR/tmp/binlog_savepoint_aba_baseline.mysqlbinlog

UPDATE t_binlog_savepoint_aba SET note='seed' WHERE id=1;
RESET MASTER;

--connect(binlog_aba_app,localhost,preserve_trx_aba_app,,test)
START TRANSACTION;
SAVEPOINT binlog_aba;
CALL p_binlog_savepoint_aba('A');

--connect(binlog_aba_owner,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_before_prefix_digest_replay SIGNAL binlog_aba_mirror_installed';
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL binlog_aba_phase1_ready WAIT_FOR binlog_aba_phase1_continue';
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_commit_ack_before_final_ack SIGNAL binlog_aba_receiver_accepted WAIT_FOR binlog_aba_final_ack_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connect(binlog_aba_control,localhost,preserve_trx_ha_admin,binlog-savepoint-aba-secret,test)
SET DEBUG_SYNC='now WAIT_FOR binlog_aba_mirror_installed TIMEOUT 30';
SET DEBUG_SYNC='now WAIT_FOR binlog_aba_phase1_ready TIMEOUT 30';

--connection binlog_aba_app
ROLLBACK TO SAVEPOINT binlog_aba;
CALL p_binlog_savepoint_aba('B');
UPDATE t_binlog_savepoint_aba SET note='transfer-aba-B' WHERE id=1;

--connection binlog_aba_control
--let $assert_text= business writes do not rebuild a stale live mirror
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: active binlog mirror reinstall target=[0-9]+
--let $assert_count= 0
--source include/assert_grep.inc
SET DEBUG_SYNC='now SIGNAL binlog_aba_phase1_continue';
SET DEBUG_SYNC='now WAIT_FOR binlog_aba_receiver_accepted TIMEOUT 60';
--let $assert_text= drain owner rebuilt the stale token-local mirror
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: drain-owned active binlog mirror rebuild target=[0-9]+ prepared=1
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= drain-owned rebuild avoided final full-cache fallback
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= transfer_binlog_fallback_
--let $assert_count= 0
--source include/assert_grep.inc

--connect(binlog_aba_reset,localhost,preserve_trx_ha_admin,binlog-savepoint-aba-secret,test)
--send RESET DRAIN
--connection binlog_aba_control
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL binlog_aba_final_ack_continue';

--connection binlog_aba_reset
--reap
--connection binlog_aba_owner
--disable_result_log
--error 4021
--reap
--enable_result_log

--connection binlog_aba_app
COMMIT;
--disconnect binlog_aba_app
--disconnect binlog_aba_reset
--disconnect binlog_aba_owner

--connection default
--let $resumed_binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$resumed_binlog_file > $MYSQLTEST_VARDIR/tmp/binlog_savepoint_aba_transfer.mysqlbinlog

--let _BINLOG_ABA_BASELINE= $MYSQLTEST_VARDIR/tmp/binlog_savepoint_aba_baseline.mysqlbinlog
--let _BINLOG_ABA_TRANSFER= $MYSQLTEST_VARDIR/tmp/binlog_savepoint_aba_transfer.mysqlbinlog
--perl
use strict;
use warnings;

sub normalized_row_events {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my @events;
  while (defined(my $line = <$fh>)) {
    chomp($line);
    next if $line !~ /(?:Table_map|Write_rows|Update_rows|Delete_rows|###)/;
    $line =~ s/^#\d{6}\s+\d{1,2}:\d{2}:\d{2}/#DATE TIME/g;
    $line =~ s/server id \d+/server id SERVER_ID/g;
    $line =~ s/end_log_pos \d+/end_log_pos END_LOG_POS/g;
    $line =~ s/CRC32 0x[0-9a-fA-F]+/CRC32 CRC/g;
    $line =~ s/mapped to number \d+/mapped to number TABLE_ID/g;
    $line =~ s/table id \d+/table id TABLE_ID/g;
    push @events, $line;
  }
  close($fh);
  return join("\n", @events);
}

my $baseline = normalized_row_events($ENV{'_BINLOG_ABA_BASELINE'});
my $transfer = normalized_row_events($ENV{'_BINLOG_ABA_TRANSFER'});
die "baseline produced no row events\n" unless length($baseline);
die "transfer produced no row events\n" unless length($transfer);
die "transfer binlog differs from no-Preserve baseline\n"
  unless $baseline eq $transfer;
EOF

--remove_file $MYSQLTEST_VARDIR/tmp/binlog_savepoint_aba_baseline.mysqlbinlog
--remove_file $MYSQLTEST_VARDIR/tmp/binlog_savepoint_aba_transfer.mysqlbinlog

--enable_query_log
SELECT note FROM t_binlog_savepoint_aba WHERE id=1;
--disable_query_log

DROP PROCEDURE p_binlog_savepoint_aba;
DROP TABLE t_binlog_savepoint_aba;
DROP USER preserve_trx_ha_admin@localhost;
DROP USER preserve_trx_aba_app@localhost;
SET DEBUG_SYNC='RESET';
SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_enable=ON;
--remove_file $credential_file

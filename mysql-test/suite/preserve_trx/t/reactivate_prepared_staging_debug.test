--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_reactivate_prepared;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_reactivate_prepared(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_reactivate_prepared VALUES (1, 10);

START TRANSACTION;
UPDATE t_reactivate_prepared SET v = 11 WHERE id = 1;

SET SESSION debug='+d,preserve_trx_debug_reactivate_prepared_observable';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION;
SET SESSION debug='-d,preserve_trx_debug_reactivate_prepared_observable';

SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-reactivate-prepared-token';

SELECT LAST_ERROR REGEXP
       'reactivate prepared: xid_ok=1 prepare_ok=1 reactivate_ok=1 attached_ok=1 rollback_ok=1'
       AS reactivate_prepared_ok
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-reactivate-prepared-token';

ROLLBACK;
SELECT * FROM t_reactivate_prepared;

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-reactivate-prepared-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP TABLE t_reactivate_prepared;
SET GLOBAL preserve_trx_enable=OFF;

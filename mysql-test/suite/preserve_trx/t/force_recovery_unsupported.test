--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_force_recovery_unsupported;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Skip updating information_schema metadata in InnoDB read-only mode");
CALL mtr.add_suppression("Skip re-populating collations and character sets tables in InnoDB read-only mode");
CALL mtr.add_suppression("PRESERVE: preserved transaction recovery is not supported while innodb_force_recovery is enabled; snapshot and binlog-cache files are retained and marked tainted");
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: preserved transaction snapshot tainted");
CALL mtr.add_suppression("Found 1 prepared XA transactions");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_force_recovery_unsupported(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_force_recovery_unsupported VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_force_recovery_unsupported WHERE a=1 FOR UPDATE;
UPDATE t_force_recovery_unsupported SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --innodb-force-recovery=1" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.innodb_force_recovery AS force_recovery_after_restart;
SELECT COUNT(*) AS preserved_count_during_force_recovery
  FROM performance_schema.preserved_transactions;
--let MYSQLD_DATADIR= `SELECT @@datadir`
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

START TRANSACTION;
--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
ROLLBACK;

--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --innodb-force-recovery=0
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT @@global.innodb_force_recovery AS force_recovery_after_normal_restart;
SELECT COUNT(*) AS preserved_count_after_normal_restart
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_force_recovery_unsupported ORDER BY a;
SELECT COUNT(*) AS preserved_count_after_tainted_rollback
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_force_recovery_unsupported;
SET GLOBAL rds_preserve_trx_enable=ON;

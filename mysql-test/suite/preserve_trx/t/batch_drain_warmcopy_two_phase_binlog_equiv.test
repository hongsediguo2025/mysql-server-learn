--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_two_phase_equiv;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
--disable_query_log
--let $old_global_binlog_format= query_get_value(SHOW GLOBAL VARIABLES LIKE 'binlog_format', Value, 1)
--enable_query_log
--disable_warnings
SET GLOBAL binlog_format=ROW;
--enable_warnings

CREATE TABLE t_warmcopy_two_phase_equiv(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  payload VARBINARY(4096)
) ENGINE=InnoDB;

INSERT INTO t_warmcopy_two_phase_equiv VALUES
  (1,10,REPEAT('a',4096)),
  (2,20,REPEAT('b',4096));

RESET MASTER;

--echo # no-preserve baseline transaction
START TRANSACTION;
UPDATE t_warmcopy_two_phase_equiv
   SET v=11, payload=REPEAT('x',4096)
 WHERE id=1;
INSERT INTO t_warmcopy_two_phase_equiv VALUES(101,101,REPEAT('p',4096));
COMMIT;

--let $baseline_binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$baseline_binlog_file > $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_two_phase_baseline.mysqlbinlog

UPDATE t_warmcopy_two_phase_equiv
   SET v=10, payload=REPEAT('a',4096)
 WHERE id=1;
DELETE FROM t_warmcopy_two_phase_equiv WHERE id=101;
RESET MASTER;

--echo # preserve/resume transaction through warm-copy path
--connect(warmcopy_two_phase_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_two_phase_equiv
   SET v=11, payload=REPEAT('x',4096)
 WHERE id=1;
INSERT INTO t_warmcopy_two_phase_equiv VALUES(101,101,REPEAT('p',4096));

--connect(warmcopy_two_phase_owner, localhost, root,,test)
--connection warmcopy_two_phase_owner
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection warmcopy_two_phase_owner
--reap
--disconnect warmcopy_two_phase_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_text= warm-copy two-phase binlog equivalence used prebuilt fast path metrics
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: warm-copy drain metrics prefix_bytes=[1-9][0-9]* digest_bytes=[1-9][0-9]* durable_bytes=[1-9][0-9]* phase2_pause_us=[1-9][0-9]* full_copy_to_count=0
--let $assert_count= 1
--source include/assert_grep.inc

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

--let $resumed_binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$resumed_binlog_file > $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_two_phase_resumed.mysqlbinlog

--let _BWT_BASELINE_DUMP= $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_two_phase_baseline.mysqlbinlog
--let _BWT_RESUMED_DUMP= $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_two_phase_resumed.mysqlbinlog
--perl
use strict;
use warnings;

sub normalize_table_events {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my @events;
  while (defined(my $line = <$fh>)) {
    chomp($line);
    next if $line =~ /^\s*$/;
    next if $line !~ /(?:Table_map|Write_rows|Update_rows|Delete_rows|###)/;
    next if $line =~ /(?:Xid|GTID|Anonymous_GTID)/;
    $line =~ s/^#\d{6}\s+\d{1,2}:\d{2}:\d{2}/#DATE TIME/g;
    $line =~ s/server id \d+/server id SERVER_ID/g;
    $line =~ s/end_log_pos \d+/end_log_pos END_LOG_POS/g;
    $line =~ s/CRC32 0x[0-9a-fA-F]+/CRC32 CRC/g;
    $line =~ s/mapped to number \d+/mapped to number TABLE_ID/g;
    $line =~ s/table id \d+/table id TABLE_ID/g;
    push @events, $line;
  }
  close($fh);
  return \@events;
}

my $baseline = normalize_table_events($ENV{'_BWT_BASELINE_DUMP'});
my $resumed = normalize_table_events($ENV{'_BWT_RESUMED_DUMP'});
die "baseline produced no normalized row events\n" unless @$baseline;
die "resumed produced no normalized row events\n" unless @$resumed;
my $baseline_text = join("\n", @$baseline);
my $resumed_text = join("\n", @$resumed);
die "warm-copy resumed binlog events differ from baseline\n" .
    "baseline:\n$baseline_text\nresumed:\n$resumed_text\n"
  unless $baseline_text eq $resumed_text;
EOF

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT id, v, OCTET_LENGTH(payload) AS payload_len
  FROM t_warmcopy_two_phase_equiv
 ORDER BY id;

--remove_file $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_two_phase_baseline.mysqlbinlog
--remove_file $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_two_phase_resumed.mysqlbinlog

DROP TABLE t_warmcopy_two_phase_equiv;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
--disable_query_log
--disable_warnings
--eval SET GLOBAL binlog_format=$old_global_binlog_format
--enable_warnings
--enable_query_log

--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_timeout_logged_cache_timestamp;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET SESSION preserve_trx_min_timeout=1;
SET SESSION preserve_trx_default_timeout=1;
SET SESSION preserve_trx_max_timeout=86400;

CREATE TABLE t_timeout_logged_cache_timestamp(
  a INT PRIMARY KEY,
  b VARCHAR(1024)
) ENGINE=InnoDB;
INSERT INTO t_timeout_logged_cache_timestamp VALUES(1, REPEAT('a', 1024));

--connect(preserve_logged_cache_timestamp,localhost,root,,test)
--connection preserve_logged_cache_timestamp
SET SESSION preserve_trx_min_timeout=1;
SET SESSION preserve_trx_default_timeout=1;
SET SESSION preserve_trx_max_timeout=86400;
SET DEBUG_SYNC =
  'preserve_trx_before_binlog_cache_rename SIGNAL before_binlog_cache_rename WAIT_FOR continue_binlog_cache_rename';
START TRANSACTION;
UPDATE t_timeout_logged_cache_timestamp
  SET b = REPEAT('b', 1024) WHERE a = 1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR before_binlog_cache_rename TIMEOUT 5';
--exec perl -MTime::HiRes=time -e 'printf "%s %.6f\n", "--let " . chr(36) . "marker_epoch=", time' > $MYSQLTEST_VARDIR/tmp/timeout_logged_cache_snapshot_marker.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_binlog_cache_rename';

--connection preserve_logged_cache_timestamp
--reap
--source include/wait_until_disconnected.inc

--connection default
--sleep 2
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source $MYSQLTEST_VARDIR/tmp/timeout_logged_cache_snapshot_marker.inc
--disable_query_log
--eval SET @marker_epoch = $marker_epoch
--enable_query_log
SELECT p.BINLOG_STATE,
       p.WROTE_TO_CACHE,
       p.BINLOG_CACHE_SIZE > 0 AS binlog_cache_size_positive,
       p.CREATED_AT >= FROM_UNIXTIME(@marker_epoch) AS created_after_cache_marker,
       TIMESTAMPDIFF(SECOND, p.CREATED_AT, p.EXPIRES_AT) AS timeout_seconds
  FROM performance_schema.preserved_transactions p;

--source suite/preserve_trx/include/get_preserved_token.inc
--file_exists $PRESERVED_BINLOG_CACHE_FILE
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

DROP TABLE t_timeout_logged_cache_timestamp;
SET GLOBAL preserve_trx_enable=ON;

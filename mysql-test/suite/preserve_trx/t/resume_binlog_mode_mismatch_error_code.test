--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_binlog_mismatch_error;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* rejected because snapshot binlog_state=LOGGED_EMPTY requires log_bin=ON");
--enable_query_log

CREATE TABLE t_resume_binlog_mismatch_error(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_resume_binlog_mismatch_error VALUES(1,10);

START TRANSACTION;
UPDATE t_resume_binlog_mismatch_error SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION debug='+d,preserve_trx_resume_force_binlog_mode_mismatch';
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_BINLOG_MODE_MISMATCH
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug='-d,preserve_trx_resume_force_binlog_mode_mismatch';

SELECT STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_resume_binlog_mismatch_error ORDER BY a;

DROP TABLE t_resume_binlog_mismatch_error;
SET GLOBAL preserve_trx_enable=ON;

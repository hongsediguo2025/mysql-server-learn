--source include/have_debug.inc
--source include/no_ps_protocol.inc
--source include/have_null_audit_plugin.inc
--source include/not_log_bin.inc

SET GLOBAL preserve_trx_enable=ON;

--replace_regex /\.dll/.so/
eval INSTALL PLUGIN null_audit SONAME '$AUDIT_NULL';

SET @expected_drain_audit=CONCAT(
  'MYSQL_AUDIT_MESSAGE_INTERNAL;component="mysqld" producer="preserve_trx" ',
  'message="preserved_transaction_control" ',
  'key[0]="action" value[0]="drain" ',
  'key[1]="result" value[1]="success" ',
  'key[2]="target_count" value[2]=0 ',
  'key[3]="token_count" value[3]=0;;');

SET @@null_audit_event_order_check_exact=0;
SET @@null_audit_event_order_check=@expected_drain_audit;
SET @@null_audit_event_record_def='MYSQL_AUDIT_MESSAGE_INTERNAL;MYSQL_AUDIT_QUERY_STATUS_END';
SET SESSION debug='+d,preserve_trx_drain_skip_shutdown_after_audit_no_targets';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_drain_skip_shutdown_after_audit_no_targets';

SELECT @@null_audit_event_order_check;
SELECT @@null_audit_event_record LIKE
       '%message="preserved_transaction_control" key[0]="action" value[0]="drain"%'
       AS drain_audit_recorded;

--disable_warnings
UNINSTALL PLUGIN null_audit;
--enable_warnings
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_detach_after_attach_failure;
--enable_warnings

CALL mtr.add_suppression("Preserved transaction resume failed to detach transaction after savepoint restore failure; retrying cleanup detach");

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_resume_detach_after_attach_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_resume_detach_after_attach_failure VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_resume_detach_after_attach_failure SET v=11 WHERE id=1;
SAVEPOINT s1;
UPDATE t_resume_detach_after_attach_failure SET v=22 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION debug="+d,preserve_trx_fail_restore_savepoints_after_sql,preserve_trx_fail_detach_resumed_from_thd";
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug="-d,preserve_trx_fail_restore_savepoints_after_sql,preserve_trx_fail_detach_resumed_from_thd";

--let $resume_owner_thread_id= `SELECT CONNECTION_ID()`
--replace_result $resume_owner_thread_id RESUME_THREAD_ID
--eval SELECT COUNT(*) AS in_transaction_after_savepoint_failure FROM information_schema.INNODB_TRX WHERE trx_mysql_thread_id = $resume_owner_thread_id
--replace_result $preserved_token TOKEN
--eval SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error FROM performance_schema.preserved_transactions WHERE TOKEN = '$preserved_token'

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

ROLLBACK TO SAVEPOINT s1;
COMMIT;

SELECT * FROM t_resume_detach_after_attach_failure ORDER BY id;

DROP TABLE t_resume_detach_after_attach_failure;
SET GLOBAL rds_preserve_trx_enable=ON;

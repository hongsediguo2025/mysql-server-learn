--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_replaces_user_vars;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_resume_replaces_user_vars(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

SET @preserved_only = 'preserved-value';
SET @overlap_user_var = 'preserved-overlap';
SET @preserved_null = NULL;

START TRANSACTION;
INSERT INTO t_resume_replaces_user_vars VALUES(1,10);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH USER VARS
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET @overlap_user_var = 'current-overlap';
SET @current_only = 'must-be-cleared-by-resume';

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @preserved_only AS preserved_only,
       @overlap_user_var AS overlap_user_var,
       @preserved_null IS NULL AS preserved_null_is_null,
       @current_only IS NULL AS current_only_was_cleared;
COMMIT;

SELECT * FROM t_resume_replaces_user_vars ORDER BY id;

DROP TABLE t_resume_replaces_user_vars;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_close;
DROP PROCEDURE IF EXISTS p_warmcopy_close;
DROP USER IF EXISTS warmcopy_close_app@localhost;
DROP USER IF EXISTS warmcopy_close_transfer@localhost;
--disable_query_log
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_query_log
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=5000;

CREATE TABLE t_warmcopy_close(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_close VALUES(1,10),(2,20);
CREATE USER warmcopy_close_app@localhost;
GRANT SELECT, UPDATE ON test.* TO warmcopy_close_app@localhost;
CREATE USER warmcopy_close_transfer@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO warmcopy_close_transfer@localhost;
--disable_query_log
CREATE USER preserve_trx_ha_admin@localhost;
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
--enable_query_log

--connect(warmcopy_close_app, localhost, warmcopy_close_app,,test)
PREPARE warmcopy_close_stmt FROM
  'UPDATE t_warmcopy_close SET v=v+1 WHERE id=?';
SET @warmcopy_close_id=2;
START TRANSACTION;
UPDATE t_warmcopy_close SET v=11 WHERE id=1;

--connect(warmcopy_close_probe, localhost, warmcopy_close_app,,test)
--connect(warmcopy_close_transfer, localhost, warmcopy_close_transfer,,test)
--connect(warmcopy_close_control, localhost, preserve_trx_ha_admin,,test)

--connection warmcopy_close_control
SET @closing_control_commands_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_closing_control_connection_commands');

--connect(warmcopy_close_owner, localhost, root,,test)
--connection warmcopy_close_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL warmcopy_close_closing WAIT_FOR warmcopy_close_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection warmcopy_close_control
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_close_closing TIMEOUT 10';

--connection warmcopy_close_probe
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--error ER_PRESERVE_TRX_SESSION_DRAINED
SHOW STATUS LIKE 'Threads_connected';
--error ER_PRESERVE_TRX_SESSION_DRAINED
SET @must_not_change=1;
--error ER_PRESERVE_TRX_SESSION_DRAINED
USE test;

--connection warmcopy_close_transfer
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection warmcopy_close_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
BEGIN;
--error ER_PRESERVE_TRX_SESSION_DRAINED
UPDATE t_warmcopy_close SET v=v+1 WHERE id=2;
--error ER_PRESERVE_TRX_SESSION_DRAINED
EXECUTE warmcopy_close_stmt USING @warmcopy_close_id;
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT * FROM t_warmcopy_close WHERE id=2 FOR UPDATE;

# COM_PING is also blocked for an ordinary connection. mysqladmin reports the
# server error and exits nonzero because COM_PING has no SQL-layer fallback.
--error 1
--exec $MYSQLADMIN --no-defaults --socket=$MASTER_MYSOCK --user=warmcopy_close_app ping > $MYSQLTEST_VARDIR/tmp/warmcopy_close_ping.out 2>&1
--exec grep -q "Preserve drain is active" $MYSQLTEST_VARDIR/tmp/warmcopy_close_ping.out

# A dedicated HA control identity remains usable throughout CLOSING.
--exec $MYSQLADMIN --no-defaults --socket=$MASTER_MYSOCK --user=preserve_trx_ha_admin ping > /dev/null 2>&1

--connection warmcopy_close_control
SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
        WHERE VARIABLE_NAME='Preserve_trx_closing_control_connection_commands')
       - @closing_control_commands_before AS closing_control_command_delta;

--connection warmcopy_close_control
SET DEBUG_SYNC = 'now SIGNAL warmcopy_close_continue';

--connection warmcopy_close_owner
--reap
--disconnect warmcopy_close_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
SELECT * FROM t_warmcopy_close ORDER BY id;

DROP TABLE t_warmcopy_close;
DROP USER warmcopy_close_app@localhost;
DROP USER warmcopy_close_transfer@localhost;
--disable_query_log
DROP USER preserve_trx_ha_admin@localhost;
--enable_query_log
--remove_file $MYSQLTEST_VARDIR/tmp/warmcopy_close_ping.out
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=30000;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET DEBUG_SYNC = 'RESET';

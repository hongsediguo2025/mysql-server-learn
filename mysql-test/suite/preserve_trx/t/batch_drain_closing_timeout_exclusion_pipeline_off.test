--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log

--let $initial_log_bin= query_get_value(SELECT @@GLOBAL.log_bin AS value, value, 1)

--let $credential_file= $MYSQL_TMP_DIR/closing-timeout-pipeline-off.secret
--write_file $credential_file
closing-timeout-pipeline-off-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS closing_pipeline_off_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'closing-timeout-pipeline-off-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER closing_pipeline_off_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_pipeline_off_app@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO closing_pipeline_off_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=closing_timeout_pipeline_off --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=200;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=100;

--connect(closing_pipeline_off_ha,localhost,preserve_trx_ha_admin,closing-timeout-pipeline-off-secret,test)

--disable_warnings
DROP TABLE IF EXISTS t_closing_timeout_pipeline_off;
--enable_warnings
CREATE TABLE t_closing_timeout_pipeline_off(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_timeout_pipeline_off VALUES(1,10),(2,20);

--connect(closing_pipeline_off_survivor,localhost,closing_pipeline_off_app,,test)
--let $survivor_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_closing_timeout_pipeline_off SET v=11 WHERE id=1;

--connect(closing_pipeline_off_timeout,localhost,closing_pipeline_off_app,,test)
--let $excluded_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_closing_timeout_pipeline_off SET v=21 WHERE id=2;
SET DEBUG_SYNC=
  'before_execute_sql_command SIGNAL closing_pipeline_off_running WAIT_FOR closing_pipeline_off_continue';
--send SELECT 2 AS excluded_old_command

--connection default
SET DEBUG_SYNC='now WAIT_FOR closing_pipeline_off_running TIMEOUT 10';
SET DEBUG_SYNC=
  'preserve_trx_drain_after_shutdown_handoff SIGNAL closing_pipeline_off_handoff WAIT_FOR closing_pipeline_off_release';
--send DRAIN TRANSACTIONS PRESERVE

--connection closing_pipeline_off_ha
SET DEBUG_SYNC='now WAIT_FOR closing_pipeline_off_handoff TIMEOUT 60';
SELECT VARIABLE_VALUE=1 AS one_accepted_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';
SELECT VARIABLE_VALUE=1 AS one_survivor_receiving
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens';
SELECT VARIABLE_VALUE=1 AS one_timeout_exclusion
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_closing_excluded_tokens';

SET DEBUG_SYNC='now SIGNAL closing_pipeline_off_continue';
--connection closing_pipeline_off_timeout
--reap

--connection closing_pipeline_off_ha
SET DEBUG_SYNC='now SIGNAL closing_pipeline_off_release';

--connection default
--replace_result $survivor_id SURVIVOR_ID $excluded_id EXCLUDED_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--reap

--connection closing_pipeline_off_ha
SHUTDOWN;

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

--eval SELECT @@GLOBAL.log_bin=$initial_log_bin AS binlog_mode_restored

DROP TABLE t_closing_timeout_pipeline_off;
DROP USER preserve_trx_ha_admin@localhost;
DROP USER closing_pipeline_off_app@localhost;
SET DEBUG_SYNC='RESET';
--remove_file $credential_file

--enable_query_log

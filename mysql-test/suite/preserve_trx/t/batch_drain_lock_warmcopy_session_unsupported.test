--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_session_unsupported;
--enable_warnings

--let $old_rds_preserve_trx_enable= `SELECT @@GLOBAL.rds_preserve_trx_enable`

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_lock_warmcopy_session_unsupported(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_session_unsupported VALUES(1,10);

--connect(lock_wc_session_unsupported_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_session_unsupported SET v=11 WHERE id=1;
SELECT GET_LOCK('lock_warmcopy_session_unsupported', 0) AS got_user_lock;

--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SELECT COUNT(*) AS preserved_count_after_session_unsupported
  FROM performance_schema.preserved_transactions;

--connection lock_wc_session_unsupported_app
SELECT IS_USED_LOCK('lock_warmcopy_session_unsupported') IS NOT NULL
  AS user_lock_still_owned_after_reject;
SELECT RELEASE_LOCK('lock_warmcopy_session_unsupported') AS released_user_lock;
COMMIT;
--disconnect lock_wc_session_unsupported_app

--connection default
SELECT id, v FROM t_lock_warmcopy_session_unsupported ORDER BY id;
DROP TABLE t_lock_warmcopy_session_unsupported;

--disable_query_log
--eval SET GLOBAL rds_preserve_trx_enable=$old_rds_preserve_trx_enable
--enable_query_log

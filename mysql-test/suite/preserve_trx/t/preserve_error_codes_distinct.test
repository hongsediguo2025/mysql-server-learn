--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP USER IF EXISTS preserve_error_reader@localhost;
DROP TABLE IF EXISTS t_preserve_error_codes;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--disable_query_log
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .* failed: token not found");
CALL mtr.add_suppression("Preserved transaction .* rejected because snapshot binlog_state=LOGGED_EMPTY requires log_bin=ON");
--enable_query_log

--error ER_PRESERVE_TRX_NOT_FOUND
RESUME PRESERVED TRANSACTION 'missing_token_for_not_found';

CREATE TABLE t_preserve_error_codes(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_error_codes VALUES(1,10);

START TRANSACTION;
UPDATE t_preserve_error_codes SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

CREATE USER preserve_error_reader@localhost;
--connect(preserve_error_reader_con, localhost, preserve_error_reader,,test)
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_ACCESS_DENIED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect preserve_error_reader_con

--connection default
START TRANSACTION;
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_INVALID_STATE
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SET SESSION debug='+d,preserve_trx_resume_force_binlog_mode_mismatch';
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_BINLOG_MODE_MISMATCH
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug='-d,preserve_trx_resume_force_binlog_mode_mismatch';

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_preserve_error_codes ORDER BY a;

DROP USER preserve_error_reader@localhost;
DROP TABLE t_preserve_error_codes;
SET GLOBAL preserve_trx_enable=ON;

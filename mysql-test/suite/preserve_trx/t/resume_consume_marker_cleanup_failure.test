--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_consume_cleanup;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* failed to mark snapshot tainted after resume cleanup failure");
CALL mtr.add_suppression("Preserved transaction .* snapshot cleanup failed after resume; transaction remains attached");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: durable consume-state cleanup");
--enable_query_log

CREATE TABLE t_resume_consume_cleanup(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_resume_consume_cleanup VALUES(1, 10);

START TRANSACTION;
UPDATE t_resume_consume_cleanup SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let $CONSUME_FILE= `SELECT CONCAT(@@global.preserve_trx_dir, '$preserved_token', '.consume_state')`

SET SESSION debug="+d,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_write_tainted_marker";
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug="-d,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_write_tainted_marker";

--file_exists $PRESERVED_SNAPSHOT_FILE
--file_exists $CONSUME_FILE
SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
COMMIT;

--let $restart_parameters= restart: --preserve-trx-enable=ON --skip-log-bin
--source include/restart_mysqld.inc
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_restart
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SELECT * FROM t_resume_consume_cleanup ORDER BY id;

DROP TABLE t_resume_consume_cleanup;
SET GLOBAL preserve_trx_enable=ON;

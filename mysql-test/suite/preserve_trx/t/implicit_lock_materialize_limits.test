--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_explicit_update_limit;
DROP TABLE IF EXISTS t_preserve_export_lock_limit;
DROP TABLE IF EXISTS t_preserve_table_limit_a;
DROP TABLE IF EXISTS t_preserve_table_limit_b;
DROP TABLE IF EXISTS t_preserve_shared_lock_budget;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET @saved_preserve_trx_max_lock_count=@@GLOBAL.preserve_trx_max_lock_count;
SET @saved_preserve_trx_max_modified_tables=@@GLOBAL.preserve_trx_max_modified_tables;

# Explicit record locks over the shared lock-count budget must reject DRAIN
# without releasing or rolling back the business transaction.
CREATE TABLE t_preserve_explicit_update_limit(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_explicit_update_limit VALUES(1,10),(2,20);
SET GLOBAL preserve_trx_max_lock_count=1;
START TRANSACTION;
UPDATE t_preserve_explicit_update_limit SET v=v+100;
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--let $preserve_trx_drain_show_warnings= 1
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

--connect(explicit_update_waiter, localhost, root,,test)
SET innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_preserve_explicit_update_limit SET v=11 WHERE id=1;
--disconnect explicit_update_waiter

--connection default
SELECT * FROM t_preserve_explicit_update_limit ORDER BY id;
ROLLBACK;
SELECT * FROM t_preserve_explicit_update_limit ORDER BY id;
SET GLOBAL preserve_trx_max_lock_count=@saved_preserve_trx_max_lock_count;

# UPDATE plus SELECT FOR UPDATE uses both modified and read record locks. The
# failed DRAIN must leave both locks owned by the original business THD.
CREATE TABLE t_preserve_export_lock_limit(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_export_lock_limit VALUES(1,10),(2,20);
SET GLOBAL preserve_trx_max_lock_count=1;
START TRANSACTION;
UPDATE t_preserve_export_lock_limit SET v=11 WHERE id=1;
SELECT id FROM t_preserve_export_lock_limit WHERE id=2 FOR UPDATE;
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

--connect(export_lock_waiter, localhost, root,,test)
SET innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_preserve_export_lock_limit SET v=21 WHERE id=2;
--disconnect export_lock_waiter

--connection default
SELECT * FROM t_preserve_export_lock_limit ORDER BY id;
ROLLBACK;
SELECT * FROM t_preserve_export_lock_limit ORDER BY id;
SET GLOBAL preserve_trx_max_lock_count=@saved_preserve_trx_max_lock_count;

# The modified-table limit is shared by DRAIN and remains relevant after the
# legacy implicit-lock materializer is removed.
CREATE TABLE t_preserve_table_limit_a(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE t_preserve_table_limit_b(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
SET GLOBAL preserve_trx_max_modified_tables=1;
START TRANSACTION;
INSERT INTO t_preserve_table_limit_a VALUES(1,10);
INSERT INTO t_preserve_table_limit_b VALUES(1,20);
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT COUNT(*) AS visible_before_rollback FROM t_preserve_table_limit_a;
SELECT COUNT(*) AS visible_before_rollback FROM t_preserve_table_limit_b;
ROLLBACK;
SELECT COUNT(*) AS visible_after_rollback FROM t_preserve_table_limit_a;
SELECT COUNT(*) AS visible_after_rollback FROM t_preserve_table_limit_b;
SET GLOBAL preserve_trx_max_modified_tables=@saved_preserve_trx_max_modified_tables;

# Two record locks plus the IX table lock exceed a max_lock_count of two.
CREATE TABLE t_preserve_shared_lock_budget(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_shared_lock_budget VALUES(1,10),(2,20);
SET GLOBAL preserve_trx_max_lock_count=2;
START TRANSACTION;
UPDATE t_preserve_shared_lock_budget SET v=v+1 WHERE id IN (1,2);
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT SUM(v) AS visible_before_rollback FROM t_preserve_shared_lock_budget;
ROLLBACK;
SELECT SUM(v) AS visible_after_rollback FROM t_preserve_shared_lock_budget;
SET GLOBAL preserve_trx_max_lock_count=@saved_preserve_trx_max_lock_count;

DROP TABLE t_preserve_shared_lock_budget;
DROP TABLE t_preserve_table_limit_b;
DROP TABLE t_preserve_table_limit_a;
DROP TABLE t_preserve_export_lock_limit;
DROP TABLE t_preserve_explicit_update_limit;
SET GLOBAL preserve_trx_enable=ON;

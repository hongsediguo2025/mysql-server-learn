--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_gtid_explicit;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SET SESSION sql_log_bin=0;
CREATE TABLE t_gtid_explicit(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_gtid_explicit VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;

--let $server_uuid= `SELECT @@GLOBAL.SERVER_UUID`
--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
UPDATE t_gtid_explicit SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@SESSION.GTID_NEXT = CONCAT(@@GLOBAL.SERVER_UUID, ':7')
  AS gtid_next_reacquired;
COMMIT;
SET GTID_NEXT=AUTOMATIC;
SELECT GTID_SUBSET(CONCAT(@@GLOBAL.SERVER_UUID, ':7'), @@GLOBAL.GTID_EXECUTED)
  AS explicit_gtid_committed;
SELECT GTID_SUBSET(CONCAT(@@GLOBAL.SERVER_UUID, ':1'), @@GLOBAL.GTID_EXECUTED)
  AS automatic_gtid_not_used;
SELECT * FROM t_gtid_explicit WHERE a=1;

SET SESSION sql_log_bin=0;
DROP TABLE t_gtid_explicit;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

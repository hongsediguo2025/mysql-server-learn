--source include/not_log_bin.inc
--source include/force_restart.inc

# Regression test for the secondary-index branch of
# lock_preserve_materialize_implicit_locks(): an UPDATE that mutates a
# secondary-index column leaves an implicit X-lock on the secondary index;
# the preserve flow must materialize it into an explicit record lock so that
# another session attempting to update the same secondary-index key continues
# to block correctly after restart.
#
# Before the fix the materialize path rejected any table with a secondary
# index, so PRESERVE on this transaction would have returned
# ER_PRESERVE_TRX_UNSUPPORTED.

--disable_warnings
DROP TABLE IF EXISTS t_implicit_sec;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_implicit_sec(
  id INT PRIMARY KEY,
  k INT,
  v INT,
  KEY k_idx(k)
) ENGINE=InnoDB;
INSERT INTO t_implicit_sec VALUES(1,100,10),(2,200,20),(3,300,30);

START TRANSACTION;
# Updates the cluster row and the k_idx secondary-index entry for id=2.
UPDATE t_implicit_sec SET k=250, v=21 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) > 0 AS recovered_secondary_record_locks
  FROM performance_schema.data_locks
  WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_implicit_sec'
    AND INDEX_NAME='k_idx'
    AND LOCK_TYPE='RECORD'
    AND LOCK_STATUS='GRANTED';

# The secondary-index implicit X-lock for id=2 (rows with k=250) must have
# been materialized at preserve time so it survives the restart.
--connect(sec_writer, localhost, root,,test)
connection sec_writer;
SET innodb_lock_wait_timeout=1;
# Same secondary-index key range as the preserved trx mutated.
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_implicit_sec SET v=999 WHERE k=250;

connection default;
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

connection sec_writer;
# After ROLLBACK the row goes back to k=200, so this UPDATE should now find
# no matching k=250 row but must not block.
UPDATE t_implicit_sec SET v=999 WHERE k=250;
disconnect sec_writer;

connection default;
SELECT * FROM t_implicit_sec ORDER BY id;

DROP TABLE t_implicit_sec;
SET GLOBAL preserve_trx_enable=ON;

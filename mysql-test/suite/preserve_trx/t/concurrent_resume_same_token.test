--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_concurrent_resume_same_token;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_concurrent_resume_same_token(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_concurrent_resume_same_token VALUES(1, 10);

START TRANSACTION;
UPDATE t_concurrent_resume_same_token SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(resume_same_token_a, localhost, root,,test)
--connection resume_same_token_a
SET DEBUG_SYNC =
  'preserve_trx_resume_after_record_take SIGNAL same_token_record_taken WAIT_FOR continue_same_token_resume';
--replace_result $preserved_token TOKEN
--send_eval RESUME PRESERVED TRANSACTION '$preserved_token'

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR same_token_record_taken TIMEOUT 10';

--connect(resume_same_token_b, localhost, root,,test)
--connection resume_same_token_b
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
--disconnect resume_same_token_b

--connection default
SET DEBUG_SYNC = 'now SIGNAL continue_same_token_resume';

--connection resume_same_token_a
--reap
COMMIT;
--disconnect resume_same_token_a

--connection default
SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_concurrent_resume_same_token ORDER BY id;

DROP TABLE t_concurrent_resume_same_token;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* single preserve cleanup failed after detach: single preserve snapshot cleanup rollback failure; killing session");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_single_snapshot_cleanup_observable;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_single_snapshot_cleanup_observable(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_single_snapshot_cleanup_observable VALUES(1,10);

--connect(single_snapshot_cleanup,localhost,root,,test)
--connection single_snapshot_cleanup
SET SESSION debug="+d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_single_detached_rollback";
START TRANSACTION;
UPDATE t_single_snapshot_cleanup_observable SET v=11 WHERE id=1;
--error ER_QUERY_INTERRUPTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--disconnect single_snapshot_cleanup

--connection default
SELECT STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions;
--let $preserved_token= `SELECT TOKEN FROM performance_schema.preserved_transactions LIMIT 1`

--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/restart_mysqld.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_single_snapshot_cleanup_observable ORDER BY id;

DROP TABLE t_single_snapshot_cleanup_observable;
SET GLOBAL preserve_trx_enable=ON;

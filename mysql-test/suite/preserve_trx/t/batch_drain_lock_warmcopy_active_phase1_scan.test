--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_wc_active_scan;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_fallback= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_lock_wc_active_scan(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_wc_active_scan VALUES(1,10,REPEAT('a',32));

--connect(lock_wc_active_app, localhost, root,,test)
START TRANSACTION;
--disable_query_log
--disable_result_log
SELECT id FROM t_lock_wc_active_scan WHERE id=1 FOR UPDATE;
--enable_result_log
--enable_query_log
UPDATE t_lock_wc_active_scan
  SET v=11, pad=REPEAT('b',32)
  WHERE id=1;
--send SET DEBUG_SYNC = 'now SIGNAL lock_wc_active_scan_target_waiting WAIT_FOR lock_wc_active_scan_target_continue'

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_active_scan_target_waiting TIMEOUT 10';

--connect(lock_wc_active_owner, localhost, root,,test)
--connection lock_wc_active_owner
SET DEBUG_SYNC =
  'preserve_trx_lock_warmcopy_after_active_record_scan SIGNAL lock_wc_active_scan_done WAIT_FOR lock_wc_active_scan_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_active_scan_done TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL lock_wc_active_scan_target_continue';

--connection lock_wc_active_app
--reap

--connection default
SET DEBUG_SYNC = 'now SIGNAL lock_wc_active_scan_continue';

--connection lock_wc_active_owner
--reap
--disconnect lock_wc_active_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= active record target is prebuilt before phase2
--let $assert_select= PRESERVE: warm-copy drain metrics.*phase1_record_prebuilt_target_count=1.*phase1_record_active_scan_target_count=1.*phase2_full_lock_scan_count=0.*materialized_lock_payload_bytes_in_phase2=0.*phase2_record_prebuilt_target_count=1
--let $assert_count_condition= >= 1
--source include/assert_grep.inc

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--let $token= `SELECT TOKEN FROM performance_schema.preserved_transactions`

--connect(lock_wc_active_resume, localhost, root,,test)
--connection lock_wc_active_resume
--replace_result $token TOKEN
--eval RESUME PRESERVED TRANSACTION '$token'
COMMIT;
--disconnect lock_wc_active_resume

--connection default
SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT id, v, pad=REPEAT('b',32) AS pad_ok
  FROM t_lock_wc_active_scan;

DROP TABLE t_lock_wc_active_scan;
--disable_query_log
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=$old_preserve_trx_lock_warmcopy_fallback
--eval SET GLOBAL preserve_trx_lock_warmcopy_enable=$old_preserve_trx_lock_warmcopy_enable
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log
SET DEBUG_SYNC = 'RESET';

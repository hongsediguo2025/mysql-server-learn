--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: recovery timeout expired");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_timeout_wallclock;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_timeout_wallclock(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_timeout_wallclock VALUES(1,10);

START TRANSACTION;
UPDATE t_timeout_wallclock SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_one_second_retention= 1
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--sleep 2

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT EXPIRES_AT IS NOT NULL AS expires_present,
       TIMESTAMPDIFF(SECOND, CREATED_AT, EXPIRES_AT) AS default_timeout_seconds,
       RECOVERED_COUNT AS recovered_count_during_grace
  FROM performance_schema.preserved_transactions;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: recovery timeout expired
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_timeout_wallclock ORDER BY a;

DROP TABLE t_timeout_wallclock;
SET GLOBAL rds_preserve_trx_enable=ON;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --skip-log-bin
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

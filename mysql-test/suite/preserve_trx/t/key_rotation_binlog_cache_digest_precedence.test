--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_key_rotation_binlog_digest;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery deferred cleanup: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_key_rotation_binlog_digest(
  id INT PRIMARY KEY,
  payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO t_key_rotation_binlog_digest VALUES(1,'a'),(2,'b');
RESET MASTER;

START TRANSACTION;
UPDATE t_key_rotation_binlog_digest
   SET payload=REPEAT('x', 80)
 WHERE id=1;
UPDATE t_key_rotation_binlog_digest
   SET payload=REPEAT('y', 80)
 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--perl
use strict;
use warnings;
use Fcntl qw(:DEFAULT :seek);
use Digest::SHA qw(sha256);
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @snapshots = grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected exactly one preserved snapshot\n" unless @snapshots == 1;

my $token = $snapshots[0];
$token =~ s/\.bin\z//;
my $token_inc = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp',
  'key_rotation_binlog_digest_token.inc');
open(my $token_inc_fh, '>', $token_inc)
  or die "cannot write $token_inc: $!";
print {$token_inc_fh} "--let \$preserved_token= $token\n";
close($token_inc_fh);

my $binlog_cache = File::Spec->catfile($dir, "$token.binlog_cache");
die "missing binlog-cache sidecar before corruption"
  unless -f $binlog_cache;
sysopen(my $cache_fh, $binlog_cache, O_RDWR)
  or die "cannot open $binlog_cache: $!";
binmode($cache_fh);
my $byte = '';
sysread($cache_fh, $byte, 1) == 1
  or die "cannot read first binlog-cache byte";
seek($cache_fh, 0, SEEK_SET)
  or die "cannot seek binlog-cache byte";
syswrite($cache_fh, chr((ord($byte) ^ 0x01) & 0xff), 1) == 1
  or die "cannot rewrite first binlog-cache byte";
eval {
  require POSIX;
  POSIX::fsync(fileno($cache_fh));
  1;
};
close($cache_fh) or die "cannot close binlog-cache sidecar: $!";

my $key = File::Spec->catfile($dir, '.key');
my $key_backup = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp',
  'key_rotation_binlog_digest_original.key');
open(my $key_in, '<', $key) or die "cannot read original key: $!";
binmode($key_in);
open(my $key_backup_fh, '>', $key_backup)
  or die "cannot write original key backup: $!";
binmode($key_backup_fh);
print {$key_backup_fh} do { local $/; <$key_in> };
close($key_backup_fh);
close($key_in);
chmod(0600, $key_backup) or die "cannot chmod key backup: $!";

sub write_bound_preserve_key {
  my ($path, $hmac_key) = @_;
  die "bad replacement HMAC key length" unless length($hmac_key) == 32;
  my $auto_cnf = File::Spec->catfile($ENV{'MYSQLD_DATADIR'}, 'auto.cnf');
  open(my $ah, '<', $auto_cnf) or die "cannot read $auto_cnf: $!";
  my $auto_cnf_text = do { local $/; <$ah> };
  close($ah);
  $auto_cnf_text =~ /^server-uuid=([0-9a-fA-F-]{36})$/m
    or die "server-uuid not found in $auto_cnf";
  my $server_uuid = lc($1);
  my $normalized_preserve_dir = $dir;
  $normalized_preserve_dir .= '/'
    unless $normalized_preserve_dir =~ m{/$};
  my $payload =
    "MSPKEY1\0" .
    pack('v', 1) .
    $server_uuid .
    sha256($normalized_preserve_dir) .
    $hmac_key;
  open(my $key_fh, '>:raw', $path)
    or die "cannot replace key before restart: $!";
  print {$key_fh} $payload;
  close($key_fh);
  chmod(0600, $path) or die "cannot chmod replacement key: $!";
}

write_bound_preserve_key($key, 'R' x 32);
print "key_and_binlog_cache_sidecar_corrupted\n1\n";
EOF

--echo # restart: --preserve-trx-enable=ON
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
my $key_backup = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp',
  'key_rotation_binlog_digest_original.key');
unlink($key) or die "cannot remove replacement key: $!";
rename($key_backup, $key) or die "cannot restore original key: $!";
chmod(0600, $key) or die "cannot chmod restored key: $!";
print "old_key_restored_after_failclosed\n1\n";
EOF

SELECT COUNT(*) AS preserved_count_after_restored_key_corrupt_sidecar
  FROM performance_schema.preserved_transactions;
SELECT id, payload
  FROM t_key_rotation_binlog_digest
 ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_key_rotation_binlog_digest;
SET GLOBAL preserve_trx_enable=ON;

--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_explicit_off_late_preserve;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=OFF;

CREATE TABLE t_temp_explicit_off_late_preserve(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

--connect(temp_explicit_off_app,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_temp_explicit_off_late_preserve(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_temp_explicit_off_late_preserve VALUES(1, 100);
UPDATE tmp_temp_explicit_off_late_preserve SET v = 101 WHERE id = 1;
DROP TEMPORARY TABLE tmp_temp_explicit_off_late_preserve;
INSERT INTO t_temp_explicit_off_late_preserve VALUES(1, 10);

--connection default
SET GLOBAL preserve_trx_temp_table_enable=OFF;

--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

--connection temp_explicit_off_app
INSERT INTO t_temp_explicit_off_late_preserve VALUES(2, 20);
COMMIT;
--disconnect temp_explicit_off_app

--connection default
SELECT COUNT(*) AS preserved_count_after_commit
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SELECT * FROM t_temp_explicit_off_late_preserve ORDER BY id;

DROP TABLE t_temp_explicit_off_late_preserve;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

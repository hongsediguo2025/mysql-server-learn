--source include/have_debug_sync.inc
--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_savepoint_truncate;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;

CREATE TABLE t_warmcopy_savepoint_truncate(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_warmcopy_savepoint_truncate VALUES(1,10);

--connect(warmcopy_savepoint_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_savepoint_truncate SET v=11 WHERE id=1;
SAVEPOINT s_warmcopy;
UPDATE t_warmcopy_savepoint_truncate SET v=12 WHERE id=1;

--connect(warmcopy_savepoint_owner, localhost, root,,test)
--connection warmcopy_savepoint_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_savepoint_hwm WAIT_FOR warmcopy_savepoint_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_savepoint_hwm TIMEOUT 10';

--connection warmcopy_savepoint_app
ROLLBACK TO SAVEPOINT s_warmcopy;
SELECT v AS app_visible_value_after_rollback
  FROM t_warmcopy_savepoint_truncate WHERE id=1;

--connection default
SET DEBUG_SYNC = 'now SIGNAL warmcopy_savepoint_continue';

--connection warmcopy_savepoint_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect warmcopy_savepoint_owner

--connection warmcopy_savepoint_app
COMMIT;
--disconnect warmcopy_savepoint_app

--connection default
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_warmcopy_savepoint_truncate;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_savepoint_truncate;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET DEBUG_SYNC = 'RESET';

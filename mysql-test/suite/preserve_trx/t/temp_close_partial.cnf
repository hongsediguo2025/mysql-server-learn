[mysqld.1]
server_id=1
log_error_verbosity=3
default_authentication_plugin=mysql_native_password
log-bin=temp-strict-bin
binlog-format=ROW
gtid-mode=ON
enforce-gtid-consistency=ON
rds-preserve-trx-enable=ON
rds-preserve-trx-temp-id-namespace=ON
# Enter Phase 2 while the test deliberately holds the CLOSE packet body.
rds-preserve-trx-drain-phase1-timeout-ms=1000

[ENV]
SERVER_MYPORT_2=@mysqld.1.port

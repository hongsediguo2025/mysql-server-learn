--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_record_lock_supremum_gap;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_record_lock_supremum_gap(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_record_lock_supremum_gap VALUES(10,10),(20,20),(30,30);

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_record_lock_supremum_gap SET v=11 WHERE id=10;
SELECT * FROM t_record_lock_supremum_gap WHERE id > 30 FOR UPDATE;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(supremum_gap_writer, localhost, root,,test)
SET SESSION innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t_record_lock_supremum_gap VALUES(40,40);
--disconnect supremum_gap_writer
--source include/wait_until_disconnected.inc
--connection default

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

INSERT INTO t_record_lock_supremum_gap VALUES(40,40);
SELECT * FROM t_record_lock_supremum_gap ORDER BY id;

DROP TABLE t_record_lock_supremum_gap;
SET GLOBAL preserve_trx_enable=ON;

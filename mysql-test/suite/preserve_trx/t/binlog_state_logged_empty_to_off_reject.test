--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_logged_empty_to_off;
DROP DATABASE IF EXISTS preserve_trx_ignored;
--enable_warnings

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* rejected because snapshot binlog_state=LOGGED_EMPTY requires log_bin=ON");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: binlog mode mismatch");
CALL mtr.add_suppression("You need to use --log-bin to make --binlog-format work");
--enable_query_log

CREATE DATABASE preserve_trx_ignored;
CREATE TABLE t_logged_empty_to_off(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE preserve_trx_ignored.seed(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_logged_empty_to_off VALUES(1,10);
INSERT INTO preserve_trx_ignored.seed VALUES(1,10);

START TRANSACTION;
UPDATE preserve_trx_ignored.seed SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --skip-log-bin
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--source include/start_mysqld.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* rejected because snapshot binlog_state=LOGGED_EMPTY requires log_bin=ON
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT * FROM t_logged_empty_to_off WHERE a=1;
SELECT * FROM preserve_trx_ignored.seed WHERE a=1;

--let $restart_parameters= restart: --preserve-trx-enable=ON
--source include/restart_mysqld.inc

DROP TABLE t_logged_empty_to_off;
DROP DATABASE preserve_trx_ignored;
SET GLOBAL preserve_trx_enable=ON;

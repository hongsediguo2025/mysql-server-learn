--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_prepare_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_prepare_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_prepare_failure_app,localhost,root,,test)
--connection batch_prepare_failure_app
START TRANSACTION;
INSERT INTO t_batch_prepare_failure VALUES(1,10);

--connection default
SET SESSION debug="+d,pfx_prepare_low";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,pfx_prepare_low";

SELECT COUNT(*) AS preserved_count_after_ha_prepare_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_prepare_failure_app
COMMIT;

--connection default
SELECT * FROM t_batch_prepare_failure ORDER BY id;

--connection batch_prepare_failure_app
START TRANSACTION;
INSERT INTO t_batch_prepare_failure VALUES(2,20);

--connection default
SET SESSION debug="+d,pfx_temp_prepare";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,pfx_temp_prepare";

SELECT COUNT(*) AS preserved_count_after_temp_prepare_failure
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_prepare_failure_app
COMMIT;
--disconnect batch_prepare_failure_app

--connection default
SELECT * FROM t_batch_prepare_failure ORDER BY id;

DROP TABLE t_batch_prepare_failure;
SET GLOBAL preserve_trx_enable=ON;

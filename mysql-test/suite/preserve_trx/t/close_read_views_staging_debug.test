--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_close_read_views;
DROP TABLE IF EXISTS t_close_read_views_marker;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_close_read_views(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE t_close_read_views_marker(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_close_read_views VALUES (1, 10);
INSERT INTO t_close_read_views_marker VALUES (1, 10);

START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT v FROM t_close_read_views WHERE id = 1;
UPDATE t_close_read_views_marker SET v = 11 WHERE id = 1;

SET SESSION debug='+d,preserve_trx_debug_close_read_views_observable';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION;
SET SESSION debug='-d,preserve_trx_debug_close_read_views_observable';

SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-close-read-views-token';

SELECT LAST_ERROR REGEXP
       'close read views: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 before=1 after=0 rollback_ok=1 fallback_rollback_ok=1'
       AS close_read_views_ok
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-close-read-views-token';

SELECT * FROM t_close_read_views_marker;

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-close-read-views-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP TABLE t_close_read_views;
DROP TABLE t_close_read_views_marker;
SET GLOBAL preserve_trx_enable=OFF;

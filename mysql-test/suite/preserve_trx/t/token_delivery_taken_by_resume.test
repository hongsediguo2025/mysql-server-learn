--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_token_delivery_taken;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("PRESERVE token delivery cleanup failed.*");
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_token_delivery_taken(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_token_delivery_taken VALUES(1,10);

--connect(preserve_owner,localhost,root,,test)
--connection preserve_owner
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_before_token_delivery SIGNAL before_token_taken WAIT_FOR continue_owner';
START TRANSACTION;
UPDATE t_preserve_token_delivery_taken SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR before_token_taken TIMEOUT 10';
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(resume_taker,localhost,root,,test)
--connection resume_taker
SET DEBUG_SYNC =
  'preserve_trx_resume_after_record_take SIGNAL resume_record_taken WAIT_FOR continue_resume';
--replace_result $preserved_token TOKEN
--send_eval RESUME PRESERVED TRANSACTION '$preserved_token'

--connection default
# Pending token-delivery records are not resumable, so this wait must time out.
SET DEBUG_SYNC = 'now WAIT_FOR resume_record_taken TIMEOUT 1';
SET DEBUG_SYNC = 'now SIGNAL continue_resume';

--connection resume_taker
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
SET DEBUG_SYNC = 'RESET';
--disconnect resume_taker

--connection default
--replace_result $preserve_conn_id CONN_ID
--eval KILL CONNECTION $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_owner';

--connection preserve_owner
--error 2013
--reap
--disconnect preserve_owner

--connection default
SELECT * FROM t_preserve_token_delivery_taken WHERE a=1;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= PRESERVE token delivery cleanup failed
--let $grep_output= count
--source include/grep_pattern.inc

DROP TABLE t_preserve_token_delivery_taken;
SET GLOBAL preserve_trx_enable=ON;

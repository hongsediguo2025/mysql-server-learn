# A command admitted before CLOSING can invalidate its Phase1 binlog mirror.
# Once that command becomes QUIESCED, a bounded final cache must be published
# as one inline replacement instead of rebuilding a scratch file/session.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/final_stale_inline.secret
--write_file $credential_file
final-stale-inline-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS final_stale_inline_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'final-stale-inline-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT FILE ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER final_stale_inline_app@localhost;
GRANT SELECT, UPDATE ON test.* TO final_stale_inline_app@localhost;
GRANT EXECUTE ON test.* TO final_stale_inline_app@localhost;
GRANT SESSION_VARIABLES_ADMIN ON *.* TO final_stale_inline_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=final_stale_inline --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

CALL mtr.add_suppression(
  "PRESERVE: standby transfer source epoch commit failed status=9");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=1000;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=30000;
SET GLOBAL binlog_format=ROW;

CREATE TABLE t_final_stale_inline(
  id INT PRIMARY KEY,
  note VARCHAR(64) NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_final_stale_inline VALUES(1, 'seed');
delimiter |;
CREATE PROCEDURE p_final_stale_inline()
BEGIN
  DECLARE i INT DEFAULT 0;
  SAVEPOINT final_stale_sp;
  WHILE i < 200 DO
    SET i=i+1;
    UPDATE t_final_stale_inline
      SET note=CONCAT('A', LPAD(i, 6, '0'), REPEAT('a', 40))
      WHERE id=1;
  END WHILE;
  ROLLBACK TO SAVEPOINT final_stale_sp;
  SET i=0;
  WHILE i < 200 DO
    SET i=i+1;
    UPDATE t_final_stale_inline
      SET note=CONCAT('B', LPAD(i, 6, '0'), REPEAT('b', 40))
      WHERE id=1;
  END WHILE;
  UPDATE t_final_stale_inline SET note='transfer-final-B' WHERE id=1;
END|
delimiter ;|

RESET MASTER;
START TRANSACTION;
UPDATE t_final_stale_inline SET note='transfer-start' WHERE id=1;
CALL p_final_stale_inline();
COMMIT;

--let $baseline_binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$baseline_binlog_file > $MYSQLTEST_VARDIR/tmp/final_stale_inline_baseline.mysqlbinlog

UPDATE t_final_stale_inline SET note='seed' WHERE id=1;
RESET MASTER;

--connect(final_stale_app,localhost,final_stale_inline_app,,test)
--let $app_connection_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_final_stale_inline SET note='transfer-start' WHERE id=1;
SET DEBUG_SYNC=
  'before_single_update SIGNAL final_stale_command_blocked WAIT_FOR final_stale_command_continue';
SET DEBUG_SYNC=
  'preserve_trx_phase2_final_hwm_enqueued_before_local_preserve SIGNAL final_stale_hwm_enqueued';
SET DEBUG_SYNC=
  'preserve_trx_before_undo_prepare SIGNAL final_stale_local_preserve_started WAIT_FOR final_stale_local_preserve_continue';
--send CALL p_final_stale_inline()

--connect(final_stale_control,localhost,preserve_trx_ha_admin,final-stale-inline-secret,test)
SET DEBUG_SYNC='now WAIT_FOR final_stale_command_blocked TIMEOUT 30';
SET @unknown_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs');
--let $receiver_active_before= query_get_value(SELECT VARIABLE_VALUE+0 AS value FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs', value, 1)

--connect(final_stale_owner,localhost,root,,test)
SET SESSION debug='+d,preserve_trx_transfer_fail_commit_before_send_once';
SET DEBUG_SYNC=
  'phase2_sched_after_t0_registration SIGNAL final_stale_t0_registered WAIT_FOR final_stale_t0_continue TIMEOUT 30';
SET DEBUG_SYNC=
  'phase2_sched_after_hard_published SIGNAL final_stale_hard_published WAIT_FOR final_stale_hard_continue TIMEOUT 30';
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_after_targets_classified SIGNAL final_stale_closing WAIT_FOR final_stale_closing_continue';
SET DEBUG_SYNC=
  'preserve_trx_batch_after_final_transfer_catchup SIGNAL final_stale_catchup_complete WAIT_FOR final_stale_catchup_continue';
SET DEBUG_SYNC=
  'preserve_trx_transfer_commit_before_send_failed SIGNAL final_stale_unsent_ready WAIT_FOR final_stale_unsent_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connection final_stale_control
SET DEBUG_SYNC='now WAIT_FOR final_stale_t0_registered TIMEOUT 30';
SET GLOBAL debug='+d,preserve_trx_delay_binlog_batch_callback';
SET DEBUG_SYNC='now SIGNAL final_stale_command_continue';

--connection final_stale_app
--reap

--connection final_stale_control
SET DEBUG_SYNC='now SIGNAL final_stale_t0_continue';
SET DEBUG_SYNC='now WAIT_FOR final_stale_hard_published TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL final_stale_hard_continue';
SET DEBUG_SYNC='now WAIT_FOR final_stale_closing TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL final_stale_closing_continue';
SET DEBUG_SYNC='now WAIT_FOR final_stale_hwm_enqueued TIMEOUT 30';
# The receiver admission callback is delayed for two seconds. Entering the
# kernel within one second proves stale replacement transfer overlaps Preserve.
SET DEBUG_SYNC='now WAIT_FOR final_stale_local_preserve_started TIMEOUT 1';
SET GLOBAL debug='-d,preserve_trx_delay_binlog_batch_callback';
SET DEBUG_SYNC='now SIGNAL final_stale_local_preserve_continue';
SET DEBUG_SYNC='now WAIT_FOR final_stale_catchup_complete TIMEOUT 60';
--let $assert_text= final stale token avoided drain-owned mirror rebuild
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: drain-owned active binlog mirror rebuild target=[0-9]+ prepared=1
--let $assert_count= 0
--source include/assert_grep.inc
--let $assert_text= final stale token published one batched replacement
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: ACKed active binlog mirror progress target=[0-9]+ high_watermark=[1-9][0-9]* delta_bytes=[1-9][0-9]* replacement=1 final=1 queued=1
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= stale inline replacement overlapped local Preserve
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: phase2 final HWM overlap async_tokens=1 sync_fallback_tokens=0 coordinator_flush_wait_us=[0-9]+ pending_rejects=0
--let $assert_count= 1
--source include/assert_grep.inc
SET DEBUG_SYNC='now SIGNAL final_stale_catchup_continue';
SET DEBUG_SYNC='now WAIT_FOR final_stale_unsent_ready TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL final_stale_unsent_continue';

--connection final_stale_owner
--disable_result_log
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--enable_result_log
SET SESSION debug='-d,preserve_trx_transfer_fail_commit_before_send_once';
SET DEBUG_SYNC='RESET';

--connection final_stale_app
--let $assert_text= final-stale failure restores the original transaction connection
--let $assert_cond= `SELECT CONNECTION_ID()=$app_connection_id`
--source include/assert.inc
COMMIT;
--disconnect final_stale_app
--disconnect final_stale_owner

--connection final_stale_control
--let $assert_text= final-stale failure avoids COMMIT_UNKNOWN
--let $assert_cond= `SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')=@unknown_before`
--source include/assert.inc

--connection default
--let $transfer_binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$transfer_binlog_file > $MYSQLTEST_VARDIR/tmp/final_stale_inline_transfer.mysqlbinlog

--let _FINAL_STALE_BASELINE= $MYSQLTEST_VARDIR/tmp/final_stale_inline_baseline.mysqlbinlog
--let _FINAL_STALE_TRANSFER= $MYSQLTEST_VARDIR/tmp/final_stale_inline_transfer.mysqlbinlog
--perl
use strict;
use warnings;

sub normalized_row_events {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my @events;
  while (defined(my $line = <$fh>)) {
    chomp($line);
    next if $line !~ /(?:Table_map|Write_rows|Update_rows|Delete_rows|###)/;
    $line =~ s/^#\d{6}\s+\d{1,2}:\d{2}:\d{2}/#DATE TIME/g;
    $line =~ s/server id \d+/server id SERVER_ID/g;
    $line =~ s/end_log_pos \d+/end_log_pos END_LOG_POS/g;
    $line =~ s/CRC32 0x[0-9a-fA-F]+/CRC32 CRC/g;
    $line =~ s/mapped to number \d+/mapped to number TABLE_ID/g;
    $line =~ s/table id \d+/table id TABLE_ID/g;
    push @events, $line;
  }
  close($fh);
  return join("\n", @events);
}

my $baseline = normalized_row_events($ENV{'_FINAL_STALE_BASELINE'});
my $transfer = normalized_row_events($ENV{'_FINAL_STALE_TRANSFER'});
die "baseline produced no row events\n" unless length($baseline);
die "transfer produced no row events\n" unless length($transfer);
die "transfer binlog differs from no-Preserve baseline\n"
  unless $baseline eq $transfer;
EOF

--remove_file $MYSQLTEST_VARDIR/tmp/final_stale_inline_baseline.mysqlbinlog
--remove_file $MYSQLTEST_VARDIR/tmp/final_stale_inline_transfer.mysqlbinlog

--enable_query_log
SELECT note FROM t_final_stale_inline WHERE id=1;
--disable_query_log

--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=$receiver_active_before
--source include/wait_condition.inc
--disconnect final_stale_control

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=final_stale_inline --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc
--let $assert_text= final-stale committed row survives restart
--let $assert_cond= `SELECT note='transfer-final-B' FROM t_final_stale_inline WHERE id=1`
--source include/assert.inc

DROP PROCEDURE p_final_stale_inline;
DROP TABLE t_final_stale_inline;
DROP USER final_stale_inline_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
SET DEBUG_SYNC='RESET';
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=600000;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=1000;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_enable=ON;
--remove_file $credential_file

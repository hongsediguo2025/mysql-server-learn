--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_toctou;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_close_timeout_ms=5000;

CREATE TABLE t_warmcopy_toctou(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_toctou VALUES(1,10),(2,20);
PREPARE warmcopy_toctou_stmt FROM
  'UPDATE t_warmcopy_toctou SET v=v+1 WHERE id=?';

--connect(warmcopy_toctou_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_toctou SET v=11 WHERE id=1;

--connect(warmcopy_toctou_owner, localhost, root,,test)
--connection warmcopy_toctou_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL warmcopy_toctou_window WAIT_FOR warmcopy_toctou_continue';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_toctou_window TIMEOUT 10';
--error ER_PRESERVE_TRX_UNSUPPORTED
BEGIN;
--error ER_PRESERVE_TRX_UNSUPPORTED
UPDATE t_warmcopy_toctou SET v=v+1 WHERE id=2;
SET @warmcopy_toctou_id=2;
--error ER_PRESERVE_TRX_UNSUPPORTED
EXECUTE warmcopy_toctou_stmt USING @warmcopy_toctou_id;
--error ER_PRESERVE_TRX_UNSUPPORTED
SELECT * FROM t_warmcopy_toctou WHERE id=2 FOR UPDATE;
SET DEBUG_SYNC = 'now SIGNAL warmcopy_toctou_continue';

--connection warmcopy_toctou_owner
--reap
--disconnect warmcopy_toctou_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
SELECT * FROM t_warmcopy_toctou ORDER BY id;

DROP TABLE t_warmcopy_toctou;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_close_timeout_ms=30000;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET DEBUG_SYNC = 'RESET';

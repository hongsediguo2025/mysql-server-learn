--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_sidecars_base;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_resume_sidecars_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_resume_sidecars_base VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_resume_sidecars(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_resume_sidecars VALUES(1, 100), (2, 200);

START TRANSACTION;
UPDATE t_resume_sidecars_base SET v = 11 WHERE id = 1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let $expect_bin= 1
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_resume_sidecars ORDER BY id;
COMMIT;
SELECT * FROM t_resume_sidecars_base ORDER BY id;

--let $expect_bin= 0
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

DROP TEMPORARY TABLE tmp_resume_sidecars;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_resume_sidecars_base;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

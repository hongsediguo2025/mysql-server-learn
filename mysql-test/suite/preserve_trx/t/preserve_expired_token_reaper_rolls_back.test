--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction '.*' expired-token reaper forced rollback: recovery timeout expired");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_expired_reaper;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_expired_reaper(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_expired_reaper VALUES(1,10);

START TRANSACTION;
UPDATE t_expired_reaper SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_one_second_retention= 1
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--sleep 2

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--sleep 121

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* expired-token reaper forced rollback: recovery timeout expired
--let $wait_timeout= 45
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_reaper
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_expired_reaper ORDER BY a;

DROP TABLE t_expired_reaper;
SET GLOBAL rds_preserve_trx_enable=ON;

--echo # Lint-only source-shape guard. Physical promotion behavior requires
--echo # integration E2E in the physical-standby project.
--perl
use strict;
use warnings;
use File::Spec;

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $root = File::Spec->rel2abs(File::Spec->catdir($mysql_test_dir, '..'));

sub read_file {
  my ($path) = @_;
  my $full_path = File::Spec->catfile($root, split('/', $path));
  open(my $fh, '<', $full_path) or die "open $path: $!\n";
  my $contents = do { local $/; <$fh> };
  close($fh);
  return $contents;
}

my $promotion = read_file('sql/preserve_trx_promotion.cc');
my $preserve = read_file('sql/preserve_trx.cc');
my $trx = read_file('storage/innobase/trx/trx0trx.cc');
my $trx_preserve = read_file('storage/innobase/trx/trx0preserve.cc');

my ($trx_list_init) =
  $trx =~ /(void\s+trx_lists_init_at_db_start\s*\([^)]*\)\s*\{[\s\S]*?^\})/m
  or die "could not isolate trx_lists_init_at_db_start\n";
die "native trx-list initialization must not understand receiver token selection\n"
  if $trx_list_init =~ /ready_tokens|failed_tokens|CLASSIFIED|receiver|promotion/i;

my ($bootstrap) =
  $promotion =~ /(preserved_trx_prepare_before_trx_sys_init_for_physical_promotion\s*\([\s\S]*?^\})/m
  or die "could not isolate physical promotion bootstrap\n";
die "physical bootstrap must validate the immutable receiver partition\n"
  unless $bootstrap =~ /selection_published/s &&
         $bootstrap =~ /accepted\.ready_tokens/s &&
         $bootstrap =~ /accepted\.failed_tokens/s;
die "physical bootstrap must register only READY resurrection candidates\n"
  unless $bootstrap =~ /if\s*\(ready_tokens\.count\(token\.token\)\s*!=\s*0\)[\s\S]*gate_request\.tokens\.push_back/s &&
         $bootstrap =~ /register_physical_resurrection_candidates\(ready_entries\)/s;

my ($handoff) =
  $promotion =~ /(Preserve_trx_physical_promotion_bootstrap_attempt::prepare_gate_handoff\s*\([\s\S]*?^\})/m
  or die "could not isolate physical promotion gate handoff\n";
die "physical gate handoff must resolve and reserve exact READY transactions\n"
  unless $handoff =~ /trx_preserve_startup_resurrection_find_verified\(key\.token\)/s &&
         $handoff =~ /trx_preserve_startup_reserve_verified/s &&
         $handoff =~ /trx_preserve_validate_reserved_authority/s;
die "physical gate handoff must not scan the native transaction list\n"
  if $handoff =~ /UT_LIST_GET_(?:FIRST|NEXT)|trx_preserve_claim_prepared/s;

my ($gate) =
  $promotion =~ /(adopt_ready_epoch_for_physical_promotion_impl\s*\([\s\S]*?^\})/m
  or die "could not isolate physical promotion gate\n";
die "token-local exact rollback must preserve the other READY tokens\n"
  unless $gate =~ /adopt_result\.rolled_back[\s\S]*ABANDONED_ROLLED_BACK/s &&
         $gate =~ /global_failure/s &&
         $gate =~ /ordinary_recovery_tokens\.push_back\(task\.token\)/s;
die "a token-local failure must not trigger epoch reversal\n"
  if $gate =~ /epoch_has_failed_token/s;

my ($shared_kernel) =
  $preserve =~ /(static bool preserved_trx_recover_or_adopt_bundle_shared\s*\([\s\S]*?^\})/m
  or die "could not isolate shared exact import kernel\n";
die "physical import must exact-claim the verified ACTIVE-Undo transaction\n"
  unless $shared_kernel =~ /options\.exact_trx/s &&
         $shared_kernel =~ /trx_preserve_claim_detached_active_undo_exact/s;
die "physical import must not fall back to an XID scan\n"
  if $shared_kernel =~ /trx_preserve_claim_prepared/s;
EOF

SELECT 'ok' AS physical_promotion_partial_ready_contract_lint;

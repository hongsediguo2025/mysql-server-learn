--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_session_off;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

SET SESSION binlog_format=ROW;
SET SESSION sql_log_bin=0;

CREATE TABLE t_session_off(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_session_off VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_session_off WHERE a=1 FOR UPDATE;
UPDATE t_session_off SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SELECT @@global.log_bin AS log_bin_after_restart;
SET SESSION binlog_format=ROW;

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE,
       SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN
  FROM performance_schema.preserved_transactions;

--error 1
--file_exists $PRESERVED_BINLOG_CACHE_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.sql_log_bin AS session_sql_log_bin_after_resume;
SELECT * FROM t_session_off WHERE a=1;
UPDATE t_session_off SET b=12 WHERE a=1;
COMMIT;
SELECT * FROM t_session_off WHERE a=1;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/session_off.mysqlbinlog
--let $assert_text= DML stays out of the binlog after SESSION_OFF_NO_CACHE resume
--let $assert_file= $MYSQLTEST_VARDIR/tmp/session_off.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_session_off`
--let $assert_count= 0
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/session_off.mysqlbinlog

DROP TABLE t_session_off;
SET GLOBAL preserve_trx_enable=ON;

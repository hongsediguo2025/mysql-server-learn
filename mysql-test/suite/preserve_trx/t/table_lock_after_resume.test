--source include/not_log_bin.inc
--source include/force_restart.inc

# Verify that an explicit InnoDB IX table lock is preserved across shutdown
# and continues to block incompatible table-level lock requests from other
# sessions after the transaction has been recovered into the manager but
# before it is resumed.

--disable_warnings
DROP TABLE IF EXISTS t_table_lock_after_resume;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_table_lock_after_resume(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_table_lock_after_resume VALUES(1,10),(2,20);

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
# This DML acquires an IX table lock that must survive shutdown.
UPDATE t_table_lock_after_resume SET v=21 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) > 0 AS recovered_ix_table_locks
  FROM performance_schema.data_locks
  WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_table_lock_after_resume'
    AND LOCK_TYPE='TABLE'
    AND LOCK_MODE='IX'
    AND LOCK_STATUS='GRANTED';

# The preserved transaction must still hold the IX table lock, so another
# session trying to take an exclusive table-level lock has to wait.
--connect(table_locker, localhost, root,,test)
connection table_locker;
SET lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
LOCK TABLES t_table_lock_after_resume WRITE;

connection default;
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

connection table_locker;
LOCK TABLES t_table_lock_after_resume WRITE;
UNLOCK TABLES;
disconnect table_locker;

connection default;
SELECT * FROM t_table_lock_after_resume ORDER BY id;

DROP TABLE t_table_lock_after_resume;
SET GLOBAL preserve_trx_enable=ON;

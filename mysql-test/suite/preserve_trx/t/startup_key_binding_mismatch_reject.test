--source include/not_windows.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_enable=OFF;

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
open(my $in, '<:raw', $key) or die "cannot read preserve key: $!";
my $payload = do { local $/; <$in> };
close($in);
die "expected bound preserve key" unless length($payload) == 110;
substr($payload, 10, 1) = substr($payload, 10, 1) eq '0' ? '1' : '0';
open(my $out, '>:raw', $key) or die "cannot rewrite preserve key: $!";
print {$out} $payload;
close($out);
print "preserve key binding mismatch\n";
EOF

--let $error_log= $MYSQLTEST_VARDIR/log/preserve_trx_startup_key_binding_mismatch.err
--perl
use strict;
use warnings;
my $path = $ENV{'error_log'} || '';
unlink $path if $path ne '' && -e $path;
EOF

--error 1
--exec $MYSQLD_CMD --validate-config --preserve-trx-enable=ON --log-error=$error_log > $error_log 2>&1

--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= preserve_trx_enable=ON requires valid snapshot support
--source include/search_pattern.inc

--perl
use strict;
use warnings;
use File::Spec;

my $key = File::Spec->catfile($ENV{'MYSQLD_DATADIR'}, 'preserve', '.key');
unlink($key) or die "cannot remove mismatched preserve key: $!";
EOF

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

--remove_file $error_log

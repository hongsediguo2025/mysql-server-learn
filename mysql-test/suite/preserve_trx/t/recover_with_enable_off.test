--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: preserved transaction snapshot tainted: ACTIVE Undo exact reservation failed");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_recover_enable_off;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_recover_enable_off(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_enable_off VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recover_enable_off WHERE a=1 FOR UPDATE;
UPDATE t_recover_enable_off SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=OFF --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.rds_preserve_trx_enable AS enable_after_restart;

SELECT COUNT(*) AS recovered_while_disabled
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_recover_enable_off ORDER BY a;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --skip-log-bin
--source include/restart_mysqld.inc

SELECT @@global.rds_preserve_trx_enable AS enable_after_enabled_restart;

SELECT COUNT(*) AS recovered_after_enabled_restart
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_recover_enable_off ORDER BY a;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_recover_enable_off;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Found 1 prepared XA transactions");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_recover_enable_off;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recover_enable_off(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_enable_off VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recover_enable_off WHERE a=1 FOR UPDATE;
UPDATE t_recover_enable_off SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=OFF --preserve-trx-off-artifact-policy=IGNORE --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT @@global.preserve_trx_enable AS enable_after_restart;

SELECT COUNT(*) AS recovered_while_disabled
  FROM performance_schema.preserved_transactions;

--let $restart_parameters= restart: --preserve-trx-enable=ON --skip-log-bin
--source include/restart_mysqld.inc

SELECT @@global.preserve_trx_enable AS enable_after_enabled_restart;

SELECT COUNT(*) AS recovered_after_enabled_restart
  FROM performance_schema.preserved_transactions;

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT * FROM t_recover_enable_off ORDER BY a;

DROP TABLE t_recover_enable_off;
SET GLOBAL preserve_trx_enable=ON;

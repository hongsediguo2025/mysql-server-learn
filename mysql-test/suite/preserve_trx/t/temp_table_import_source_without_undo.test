--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc
--echo # Source import of a committed temporary table without active temp undo
--disable_query_log
--let $saved_global_debug= `SELECT @@global.debug`
--let $source_trace= $MYSQLTEST_VARDIR/log/temp_source_without_undo.trace
--eval SET GLOBAL debug='d,preserve_temp_import,preserve_temp_import_source_undo_probe,preserve_temp_import_target_data_probe,preserve_trx_fail_before_snapshot_fsync:O,$source_trace'
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TABLE t_source_no_undo(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_source_no_undo
  WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<64)
  SELECT n, n*10 FROM seq;
--connect(source_app,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_source_no_undo(
  id INT PRIMARY KEY, v VARCHAR(32), KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_source_no_undo SELECT id, CONCAT('base-',id) FROM t_source_no_undo;
START TRANSACTION;
UPDATE t_source_no_undo SET v=v+1;
--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--let _TEMP_SOURCE_TRACE= $source_trace
--perl
use strict;
use warnings;
open(my $fh, '<', $ENV{'_TEMP_SOURCE_TRACE'}) or die "missing source trace: $!";
my $trace = do { local $/; <$fh> };
close($fh);
die "source plan without undo was rejected\n"
  unless $trace =~ /temporary source import prepared spaces=1 tables=1 undo_records=0 links=0 external=0 targets=0/;
die "committed temporary rows were not preserved\n"
  unless $trace =~ /temporary data page relocation complete .*current=0 baseline=64 external=0/;
die "workspace admission or missing current undo was not checked\n"
  unless $trace =~ /temporary data page workspace faults=1 missing_undo=1 growth=1/;
die "snapshot failure was not reached\n"
  unless $trace =~ /temporary snapshot fsync fault/;
EOF
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
--connection source_app
--enable_query_log
SELECT COUNT(*)=64 AND SUM(v=CONCAT('base-',id))=64 AS baseline_ok
  FROM tmp_source_no_undo;
SELECT SUM(v)=20864 AS persistent_pending_ok FROM t_source_no_undo;
--disable_query_log
UPDATE tmp_source_no_undo SET v='after-capture';
DELETE FROM tmp_source_no_undo WHERE id=64;
ROLLBACK;
--enable_query_log
SELECT COUNT(*)=64 AND SUM(v=CONCAT('base-',id))=64 AS temp_rollback_ok
  FROM tmp_source_no_undo;
SELECT SUM(v)=20800 AS persistent_rollback_ok FROM t_source_no_undo;
--disable_query_log
START TRANSACTION;
UPDATE tmp_source_no_undo SET v='committed' WHERE id=1;
UPDATE t_source_no_undo SET v=7 WHERE id=1;
COMMIT;
--enable_query_log
SELECT v='committed' AS temp_commit_ok FROM tmp_source_no_undo WHERE id=1;
SELECT v=7 AS persistent_commit_ok FROM t_source_no_undo WHERE id=1;
--disable_query_log
DROP TEMPORARY TABLE tmp_source_no_undo;
--disconnect source_app
--connection default
DROP TABLE t_source_no_undo;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
--eval SET GLOBAL debug='$saved_global_debug'
--enable_query_log

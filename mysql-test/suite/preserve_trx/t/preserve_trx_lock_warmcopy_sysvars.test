SELECT @@global.preserve_trx_lock_warmcopy_enable AS lock_warmcopy_enable_default_on;
SELECT @@global.preserve_trx_lock_warmcopy_fallback_to_live_export AS lock_warmcopy_fallback_default_on;
SELECT @@global.preserve_trx_lock_warmcopy_max_memory_bytes AS lock_warmcopy_max_memory_default;
SELECT @@global.preserve_trx_lock_warmcopy_max_journal_bytes AS lock_warmcopy_max_journal_default;
SELECT @@global.preserve_trx_lock_warmcopy_max_dirty_shards AS lock_warmcopy_max_dirty_shards_default;
SELECT @@global.preserve_trx_lock_warmcopy_max_mdl_descriptors AS lock_warmcopy_max_mdl_descriptors_default;
SELECT @@global.preserve_trx_lock_warmcopy_seal_threads AS lock_warmcopy_seal_threads_default;
SELECT @@global.preserve_trx_parallel_preserve_threads AS parallel_preserve_threads_default;
SELECT @@global.preserve_trx_lock_warmcopy_conversion_wait_timeout_ms AS lock_warmcopy_conversion_wait_default;

SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_max_memory_bytes=1048576;
SET GLOBAL preserve_trx_lock_warmcopy_max_journal_bytes=2097152;
SET GLOBAL preserve_trx_lock_warmcopy_max_dirty_shards=7;
SET GLOBAL preserve_trx_lock_warmcopy_max_mdl_descriptors=11;
SET GLOBAL preserve_trx_lock_warmcopy_seal_threads=3;
SET GLOBAL preserve_trx_parallel_preserve_threads=4;
SET GLOBAL preserve_trx_lock_warmcopy_conversion_wait_timeout_ms=5;

SELECT @@global.preserve_trx_lock_warmcopy_enable AS lock_warmcopy_enable_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_fallback_to_live_export AS lock_warmcopy_fallback_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_max_memory_bytes AS lock_warmcopy_max_memory_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_max_journal_bytes AS lock_warmcopy_max_journal_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_max_dirty_shards AS lock_warmcopy_max_dirty_shards_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_max_mdl_descriptors AS lock_warmcopy_max_mdl_descriptors_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_seal_threads AS lock_warmcopy_seal_threads_after_set;
SELECT @@global.preserve_trx_parallel_preserve_threads AS parallel_preserve_threads_after_set;
SELECT @@global.preserve_trx_lock_warmcopy_conversion_wait_timeout_ms AS lock_warmcopy_conversion_wait_after_set;

SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SELECT @@global.preserve_trx_warmcopy_enable AS binlog_warmcopy_enable_independent;
SELECT @@global.preserve_trx_lock_warmcopy_enable AS lock_warmcopy_enable_independent;

SELECT VARIABLE_NAME, VARIABLE_VALUE REGEXP '^[0-9]+$' AS numeric_status
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME IN (
    'Preserve_trx_lock_warmcopy_artifact_bytes',
    'Preserve_trx_lock_warmcopy_attempts',
    'Preserve_trx_lock_warmcopy_canonical_mismatch',
    'Preserve_trx_lock_warmcopy_conversion_freeze_waits',
    'Preserve_trx_lock_warmcopy_dirty_shards',
    'Preserve_trx_lock_warmcopy_final_fence_mismatch',
    'Preserve_trx_lock_warmcopy_journal_bytes',
    'Preserve_trx_lock_warmcopy_live_fallback',
    'Preserve_trx_lock_warmcopy_phase2_pause_us',
    'Preserve_trx_lock_warmcopy_resource_limit',
    'Preserve_trx_lock_warmcopy_sealed_invalid',
    'Preserve_trx_lock_warmcopy_sealed_valid',
    'Preserve_trx_lock_warmcopy_spill_bytes',
    'Preserve_trx_lock_warmcopy_spill_failures',
    'Preserve_trx_lock_warmcopy_strict_reject',
    'Preserve_trx_lock_warmcopy_unsupported_family',
    'Preserve_trx_phase2_detach_claim_us',
    'Preserve_trx_phase2_lock_preflight_us',
    'Preserve_trx_phase2_lock_seal_us',
    'Preserve_trx_phase2_participant_close_us',
    'Preserve_trx_phase2_participant_preflight_us',
    'Preserve_trx_phase2_participant_prepare_us',
    'Preserve_trx_phase2_prepare_us',
    'Preserve_trx_phase2_register_us',
    'Preserve_trx_phase2_slo_miss_count',
    'Preserve_trx_phase2_snapshot_write_us',
    'Preserve_trx_phase2_target_preserve_us',
    'Preserve_trx_phase2_target_wait_us',
    'Preserve_trx_phase2_total_us')
  ORDER BY VARIABLE_NAME;

SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
SET GLOBAL preserve_trx_lock_warmcopy_max_memory_bytes=268435456;
SET GLOBAL preserve_trx_lock_warmcopy_max_journal_bytes=1073741824;
SET GLOBAL preserve_trx_lock_warmcopy_max_dirty_shards=100000;
SET GLOBAL preserve_trx_lock_warmcopy_max_mdl_descriptors=100000;
SET GLOBAL preserve_trx_lock_warmcopy_seal_threads=0;
SET GLOBAL preserve_trx_parallel_preserve_threads=0;
SET GLOBAL preserve_trx_lock_warmcopy_conversion_wait_timeout_ms=30000;

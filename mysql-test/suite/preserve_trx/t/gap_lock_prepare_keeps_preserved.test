--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_gap_prepare;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_preserve_gap_prepare(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_gap_prepare VALUES(10,10),(20,20),(30,30);

--connect(gap_prepare_app,localhost,root,,test)
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_preserve_gap_prepare SET v=11 WHERE id=10;
SELECT * FROM t_preserve_gap_prepare
  WHERE id > 10 AND id <= 20 FOR UPDATE;

--connection default
SET SESSION debug="+d,ib_force_release_gap_lock_prepare";
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source include/wait_until_disconnected.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(gap_prepare_writer, localhost, root,,test)
SET SESSION innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_preserve_gap_prepare SET v=21 WHERE id=20;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t_preserve_gap_prepare VALUES(15,15);
--disconnect gap_prepare_writer
--source include/wait_until_disconnected.inc
--connection default

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

ROLLBACK;
UPDATE t_preserve_gap_prepare SET v=21 WHERE id=20;
INSERT INTO t_preserve_gap_prepare VALUES(15,15);
SELECT * FROM t_preserve_gap_prepare ORDER BY id;

DROP TABLE t_preserve_gap_prepare;
SET GLOBAL rds_preserve_trx_enable=ON;

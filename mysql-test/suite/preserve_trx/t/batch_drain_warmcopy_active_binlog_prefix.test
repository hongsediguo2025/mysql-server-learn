# Phase1 must install a binlog-cache mirror while a stored procedure has both
# an active statement rollback position and a pending Rows_log_event.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/active_binlog_prefix.secret
--write_file $credential_file
active-binlog-prefix-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS active_binlog_prefix_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'active-binlog-prefix-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT FILE ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER active_binlog_prefix_app@localhost;
GRANT SELECT, UPDATE ON test.* TO active_binlog_prefix_app@localhost;
GRANT SESSION_VARIABLES_ADMIN ON *.* TO active_binlog_prefix_app@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$MASTER_MYSOCK --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=active_binlog_prefix --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL preserve_trx_transfer_phase1_batch_bytes=1048576;
SET GLOBAL preserve_trx_drain_closing_command_timeout_ms=30000;
SET GLOBAL preserve_trx_warmcopy_pending_range_limit=8;
SET GLOBAL binlog_format=ROW;

CREATE TABLE t_active_binlog_prefix(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  payload VARBINARY(4096) NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_active_binlog_prefix
VALUES(1, 0, REPEAT('a', 4096));
delimiter |;
CREATE PROCEDURE p_active_binlog_prefix_seed()
BEGIN
  DECLARE i INT DEFAULT 0;
  WHILE i < 400 DO
    SET i=i+1;
    UPDATE t_active_binlog_prefix
      SET v=v+1, payload=REPEAT(CHAR(65 + MOD(i, 26)), 4096)
      WHERE id=1;
  END WHILE;
END|
CREATE PROCEDURE p_active_binlog_prefix()
BEGIN
  DECLARE i INT DEFAULT 0;
  INSERT INTO t_active_binlog_prefix
  VALUES(1000, 1, REPEAT('b', 4096));
  WHILE i < 432 DO
    SET i=i+1;
    INSERT INTO t_active_binlog_prefix
    VALUES(1000+i, 1, REPEAT(CHAR(65 + MOD(i, 26)), 4096));
  END WHILE;
  UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
  SET i=0;
  WHILE i < 432 DO
    SET i=i+1;
    INSERT INTO t_active_binlog_prefix
    VALUES(2000+i, 1, REPEAT(CHAR(65 + MOD(i, 26)), 4096));
  END WHILE;
  DELETE FROM t_active_binlog_prefix WHERE id=2001;
END|
delimiter ;|
GRANT EXECUTE ON PROCEDURE test.p_active_binlog_prefix_seed
  TO active_binlog_prefix_app@localhost;
GRANT EXECUTE ON PROCEDURE test.p_active_binlog_prefix
  TO active_binlog_prefix_app@localhost;

--connect(active_binlog_prefix_app,localhost,active_binlog_prefix_app,,test)
START TRANSACTION;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
UPDATE t_active_binlog_prefix SET v=v+1 WHERE id=1;
CALL p_active_binlog_prefix_seed();
SET DEBUG_SYNC=
  'ha_write_row_end SIGNAL active_binlog_prefix_install_ready WAIT_FOR active_binlog_prefix_install_continue';
SET DEBUG_SYNC=
  'before_single_update SIGNAL active_binlog_prefix_pending_ready WAIT_FOR active_binlog_prefix_pending_continue';
SET DEBUG_SYNC=
  'planned_single_delete SIGNAL active_binlog_prefix_final_ready WAIT_FOR active_binlog_prefix_final_continue';
--send CALL p_active_binlog_prefix()

--connect(active_binlog_prefix_control,localhost,preserve_trx_ha_admin,active-binlog-prefix-secret,test)
SET DEBUG_SYNC='now WAIT_FOR active_binlog_prefix_install_ready TIMEOUT 30';
SET @binlog_prewarm_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME=
    'Preserve_trx_recv_binlog_obj_prewarm_first_start_us');
SET @object_prewarm_count_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME=
    'Preserve_trx_transfer_receiver_object_prewarm_count');

--connect(active_binlog_prefix_owner,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_open SIGNAL active_binlog_prefix_admission_open WAIT_FOR active_binlog_prefix_scan_continue';
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_after_first_active_prefix_chunk SIGNAL active_binlog_prefix_copy_started WAIT_FOR active_binlog_prefix_copy_continue';
SET DEBUG_SYNC=
  'preserve_trx_transfer_before_commit_send_ownership_cas SIGNAL active_binlog_prefix_commit_ready WAIT_FOR active_binlog_prefix_commit_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection active_binlog_prefix_control
SET DEBUG_SYNC='now WAIT_FOR active_binlog_prefix_admission_open TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL active_binlog_prefix_install_continue';
SET DEBUG_SYNC='now WAIT_FOR active_binlog_prefix_pending_ready TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL active_binlog_prefix_scan_continue';
SET DEBUG_SYNC='now WAIT_FOR active_binlog_prefix_copy_started TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL active_binlog_prefix_copy_continue';
--let $wait_condition= SELECT VARIABLE_VALUE+0 > @binlog_prewarm_before FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_recv_binlog_obj_prewarm_first_start_us'
--source include/wait_condition.inc
--enable_query_log
SELECT VARIABLE_VALUE+0 > @binlog_prewarm_before
       AS active_binlog_prefix_streamed_before_command_boundary
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME=
    'Preserve_trx_recv_binlog_obj_prewarm_first_start_us';
--disable_query_log

--connection active_binlog_prefix_control
--let $wait_condition= SELECT VARIABLE_VALUE+0 >= @object_prewarm_count_before + 1 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_object_prewarm_count'
--source include/wait_condition.inc
SET @object_prewarm_count_before_progress=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME=
    'Preserve_trx_transfer_receiver_object_prewarm_count');
SET DEBUG_SYNC='now SIGNAL active_binlog_prefix_pending_continue';
SET DEBUG_SYNC='now WAIT_FOR active_binlog_prefix_final_ready TIMEOUT 30';
--let $wait_condition= SELECT VARIABLE_VALUE+0 >= @object_prewarm_count_before_progress + 1 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_object_prewarm_count'
--source include/wait_condition.inc
--let $assert_text= active stored-procedure mirror advanced beyond one MiB before command boundary
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: ACKed active binlog mirror progress target=[0-9]+ high_watermark=[1-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]* delta_bytes=[1-9][0-9]*
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= contiguous active binlog appends did not exhaust the pending range limit
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: active binlog mirror degraded target=[0-9]+ reason=warm-copy pending mirror range limit exceeded
--let $assert_count= 0
--source include/assert_grep.inc

SET DEBUG_SYNC='now SIGNAL active_binlog_prefix_final_continue';

--connection active_binlog_prefix_app
--reap

--connection active_binlog_prefix_control
SET DEBUG_SYNC='now WAIT_FOR active_binlog_prefix_commit_ready TIMEOUT 30';
--let $assert_text= quiesced target closed on a final or already-published receiver high watermark
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: (ACKed active binlog mirror progress|standby transfer phase2 binlog catchup).* (final=1|already_current_tokens=1)
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= quiesced final high watermark joined the coordinator batch
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: ACKed active binlog mirror progress target=[0-9]+ high_watermark=[1-9][0-9]* delta_bytes=[1-9][0-9]* replacement=0 final=1 queued=1
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= ACKed final high watermark satisfied source freshness coverage
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: standby transfer final target coverage event=check target_count=1 phase1_declared=1 missing_declared=0 record_blob=1 record_fallback=0 missing_record=0 binlog_blob=1 missing_binlog=0
--let $assert_count= 1
--source include/assert_grep.inc

--connect(active_binlog_prefix_reset,localhost,preserve_trx_ha_admin,active-binlog-prefix-secret,test)
--send RESET DRAIN

--connection active_binlog_prefix_control
--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE PROCESSLIST_INFO='RESET DRAIN'
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL active_binlog_prefix_commit_continue';

--connection active_binlog_prefix_reset
--reap

--connection active_binlog_prefix_owner
--error 4021
--reap

--connection active_binlog_prefix_app
COMMIT;

--connection default
SELECT COUNT(*) AS row_count, SUM(v) AS value_sum,
       MIN(OCTET_LENGTH(payload)) AS min_payload_bytes,
       MAX(OCTET_LENGTH(payload)) AS max_payload_bytes
  FROM t_active_binlog_prefix;
--disconnect active_binlog_prefix_app
--disconnect active_binlog_prefix_reset
--disconnect active_binlog_prefix_owner
--disconnect active_binlog_prefix_control
DROP PROCEDURE p_active_binlog_prefix;
DROP PROCEDURE p_active_binlog_prefix_seed;
DROP TABLE t_active_binlog_prefix;
DROP USER active_binlog_prefix_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
SET DEBUG_SYNC='RESET';
SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL preserve_trx_transfer_phase1_batch_bytes=4194304;
SET GLOBAL preserve_trx_drain_closing_command_timeout_ms=1000;
SET GLOBAL preserve_trx_warmcopy_pending_range_limit=1024;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_enable=ON;
--remove_file $credential_file

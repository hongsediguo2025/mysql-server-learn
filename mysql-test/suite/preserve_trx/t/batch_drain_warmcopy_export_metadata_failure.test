--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_export_metadata_fail;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;

CREATE TABLE t_warmcopy_export_metadata_fail(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;
INSERT INTO t_warmcopy_export_metadata_fail VALUES(1,10);

--connect(warmcopy_export_metadata_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_export_metadata_fail SET v=11 WHERE id=1;

--connect(warmcopy_export_metadata_owner, localhost, root,,test)
--connection warmcopy_export_metadata_owner
SET SESSION debug="+d,preserve_trx_fail_warmcopy_export_metadata";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_fail_warmcopy_export_metadata";
--disconnect warmcopy_export_metadata_owner

--connection default
SELECT COUNT(*) AS preserved_count_after_drain
  FROM performance_schema.preserved_transactions;

--connection warmcopy_export_metadata_app
COMMIT;
--disconnect warmcopy_export_metadata_app

--connection default
SELECT COUNT(*) AS preserved_count_after_commit
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_warmcopy_export_metadata_fail;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_export_metadata_fail;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET DEBUG_SYNC = 'RESET';

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .* failed: token not found");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_resume_bruteforce_limit;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_resume_bruteforce_limit(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_resume_bruteforce_limit VALUES(1,10);

START TRANSACTION;
UPDATE t_resume_bruteforce_limit SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--disable_query_log
--disable_result_log
--let $attempt= 1
while ($attempt <= 35)
{
  --error ER_PRESERVE_TRX_NOT_FOUND
  --eval RESUME PRESERVED TRANSACTION 'msp_invalid_bruteforce_$attempt'
  --inc $attempt
}
--enable_result_log
--enable_query_log

SELECT COUNT(*) AS preserved_count_after_invalid_attempts
  FROM performance_schema.preserved_transactions;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_resume_bruteforce_limit ORDER BY a;

DROP TABLE t_resume_bruteforce_limit;
SET GLOBAL preserve_trx_enable=ON;

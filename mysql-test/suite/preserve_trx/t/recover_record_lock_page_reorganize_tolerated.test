--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_record_lock_page_reorg;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recover_record_lock_page_reorg(
  id INT PRIMARY KEY,
  v INT,
  pad VARCHAR(200)
) ENGINE=InnoDB;

--disable_query_log
--disable_result_log
--let $i= 1
while ($i <= 60)
{
  --eval INSERT INTO t_recover_record_lock_page_reorg SELECT $i, $i * 10, RPAD(CONCAT('row', $i), 180, 'x')
  --inc $i
}
--enable_result_log
--enable_query_log

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_recover_record_lock_page_reorg SET v=30001 WHERE id=30;
SELECT id, v, CHAR_LENGTH(pad) AS pad_len
  FROM t_recover_record_lock_page_reorg WHERE id=30;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(reorg_writer,localhost,root,,test)
--disable_query_log
--disable_result_log
--let $i= 1
while ($i <= 20)
{
  --eval UPDATE t_recover_record_lock_page_reorg SET pad=RPAD(CONCAT('short', id), 10, 'y') WHERE id=$i
  --inc $i
}
--enable_result_log
--enable_query_log
--disable_query_log
--disable_result_log
SET GLOBAL innodb_monitor_enable=index_page_reorg_successful;
SET GLOBAL innodb_monitor_reset=index_page_reorg_successful;
--enable_result_log
--enable_query_log
--let $reorg_success_before= `SELECT COUNT FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME='index_page_reorg_successful'`
SET SESSION debug='+d,do_page_reorganize';
INSERT INTO t_recover_record_lock_page_reorg VALUES(1000,1000,'trigger');
SET SESSION debug='-d,do_page_reorganize';
--let $reorg_success_after= `SELECT COUNT FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME='index_page_reorg_successful'`
if ($reorg_success_after <= $reorg_success_before)
{
  --die Expected page reorganization before second restart
}
--disconnect reorg_writer
--connection default

--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_page_reorganize
FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT id, v, CHAR_LENGTH(pad) AS pad_len
  FROM t_recover_record_lock_page_reorg
 WHERE id IN (1,20,30,1000)
 ORDER BY id;

SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;

DROP TABLE t_recover_record_lock_page_reorg;
SET GLOBAL preserve_trx_enable=ON;
--disable_query_log
--disable_result_log
SET GLOBAL innodb_monitor_disable=index_page_reorg_successful;
--enable_result_log
--enable_query_log

--perl
use strict;
use warnings;
use File::Spec;

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));

sub read_source {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my $src = do { local $/; <$fh> };
  close($fh);
  return $src;
}

my $sql_matrix = read_source(File::Spec->catfile(
  $source_root, 'mysql-test', 'suite', 'preserve_trx', 't',
  'batch_drain_drained_session_blocked.test'));
my $binary_ps = read_source(File::Spec->catfile(
  $source_root, 'mysql-test', 'suite', 'preserve_trx', 't',
  'batch_drain_drained_session_binary_ps_blocked.test'));
my $indirect = read_source(File::Spec->catfile(
  $source_root, 'mysql-test', 'suite', 'preserve_trx', 't',
  'draining_blocks_indirect_writes.test'));

die "drained-session SQL matrix must cover ordinary SQL, transaction control, prepared statements, and RESUME\n"
  unless $sql_matrix =~ /ER_PRESERVE_TRX_SESSION_DRAINED[\s\S]*SELECT 1/s &&
         $sql_matrix =~ /COMMIT/s &&
         $sql_matrix =~ /PREPARE drained_stmt/s &&
         $sql_matrix =~ /EXECUTE drained_existing_stmt/s &&
         $sql_matrix =~ /RESUME PRESERVED TRANSACTION/s;
die "drained-session matrix must include binary protocol prepared statement execute\n"
  unless $binary_ps =~ /COM_STMT_PREPARE/s &&
         $binary_ps =~ /stmt_execute_error_code=4020/s &&
         $binary_ps =~ /ping_error_code=4020/s;
die "drain command blocking must include indirect write paths\n"
  unless $indirect =~ /CALL p_preserve_drain_update/s &&
         $indirect =~ /EXECUTE preserve_drain_update_stmt/s &&
         $indirect =~ /LOCK TABLES/s;
EOF

SELECT 'ok' AS batch_drain_drained_session_command_matrix_lint;

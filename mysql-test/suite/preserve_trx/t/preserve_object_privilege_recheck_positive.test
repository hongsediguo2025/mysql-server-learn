--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP USER IF EXISTS preserve_obj_user@localhost;
DROP ROLE IF EXISTS preserve_obj_role;
DROP DATABASE IF EXISTS preserve_obj_db;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE DATABASE preserve_obj_db;
USE preserve_obj_db;

CREATE TABLE t_preserve_obj_priv_ok(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_obj_priv_ok VALUES(1,10);

CREATE USER preserve_obj_user@localhost;
CREATE ROLE preserve_obj_role;
GRANT SHUTDOWN ON *.* TO preserve_obj_user@localhost;
GRANT SELECT ON preserve_obj_db.t_preserve_obj_priv_ok TO preserve_obj_user@localhost;
GRANT UPDATE ON preserve_obj_db.t_preserve_obj_priv_ok TO preserve_obj_role;
GRANT preserve_obj_role TO preserve_obj_user@localhost;

--connect(obj_user_con, localhost, preserve_obj_user,,preserve_obj_db)
SET ROLE preserve_obj_role;
START TRANSACTION;
UPDATE t_preserve_obj_priv_ok SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT * FROM t_preserve_obj_priv_ok ORDER BY a;
--disconnect obj_user_con

--connection default
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(obj_user_resume_con, localhost, preserve_obj_user,,preserve_obj_db)
SET ROLE preserve_obj_role;
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT * FROM t_preserve_obj_priv_ok ORDER BY a;
--disconnect obj_user_resume_con
--connection default

DROP USER preserve_obj_user@localhost;
DROP ROLE preserve_obj_role;
USE test;
DROP DATABASE preserve_obj_db;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_user_vars_decimal;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_resume_user_vars_decimal(id INT PRIMARY KEY, v INT)
  ENGINE=InnoDB;

SET @preserve_decimal_var = CAST(123.45 AS DECIMAL(10,2));
SET @preserve_int_var = CAST(42 AS SIGNED);
SET @preserve_real_var = 3.5e0;
SET @preserve_null_decimal_var = CAST(NULL AS DECIMAL(10,2));
SET @preserve_string_var = 'restored-value';

START TRANSACTION;
INSERT INTO t_resume_user_vars_decimal VALUES(1,10);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300 WITH USER VARS
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @preserve_decimal_var AS decimal_var,
       @preserve_int_var AS int_var,
       @preserve_real_var AS real_var,
       @preserve_null_decimal_var IS NULL AS null_decimal_var,
       @preserve_string_var AS string_var;
COMMIT;

SELECT * FROM t_resume_user_vars_decimal ORDER BY id;

DROP TABLE t_resume_user_vars_decimal;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_windows.inc
--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery failed: encrypted tablespace key unavailable");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_keyring_logged_cache_temp;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_keyring_logged_cache_temp(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_keyring_logged_cache_temp VALUES(1,10);

CREATE TEMPORARY TABLE tmp_keyring_logged_cache_temp(
  a INT PRIMARY KEY,
  b VARCHAR(64)
) ENGINE=InnoDB;
INSERT INTO tmp_keyring_logged_cache_temp VALUES(1,'before-preserve');

START TRANSACTION;
UPDATE t_keyring_logged_cache_temp SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --debug=d,preserve_trx_simulate_encrypted_tablespace_key_unavailable
--source include/start_mysqld.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery failed: encrypted tablespace key unavailable
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR, BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE,
       TEMP_TABLE_STATE, TEMP_SIDECARS_COMPLETE
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS resumable_count
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'PRESERVED';

--let $preserved_token= `SELECT TOKEN FROM performance_schema.preserved_transactions LIMIT 1`
--let $expect_bin= 1
--let $expect_binlog_cache= 1
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

--let _KEYRING_COMBO_TOKEN= $preserved_token
--perl
use strict;
use warnings;
use File::Spec;

my $token = $ENV{'_KEYRING_COMBO_TOKEN'} or die "missing token";
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
die "missing tainted marker"
  unless -f File::Spec->catfile($dir, "$token.tainted");
EOF
--let _KEYRING_COMBO_TOKEN=

SELECT * FROM t_keyring_logged_cache_temp ORDER BY a;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_taint_cleanup
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_keyring_logged_cache_temp ORDER BY a;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_keyring_logged_cache_temp;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

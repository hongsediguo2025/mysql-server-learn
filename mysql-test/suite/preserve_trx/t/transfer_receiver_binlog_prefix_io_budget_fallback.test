# A failed seed handoff must rebuild from disk with the full read budget.
--let $prefix_replace= 0
--let $prefix_fail= 0
--let $prefix_resize= 0
--let $prefix_copy_fault= 1
--let $prefix_rebuild= 1
--let $prefix_fault_debug= preserve_trx_receiver_fail_seed_after_prefix_take
--let $prefix_inflight= 0
--let $prefix_fault_signal= receiver_seed_prefix_discarded
--let $prefix_io_budget= 1
--source suite/preserve_trx/include/receiver_binlog_prefix_prewarm.inc

--perl
my $path = "$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err";
open my $fh, '<', $path or die "open $path: $!";
my ($staged, $raw) = (0, 0);
my $in_test = 0;
while (<$fh>) {
  if (/^CURRENT_TEST:\s+(\S+)/) {
    $in_test = $1 eq 'preserve_trx.transfer_receiver_binlog_prefix_io_budget_fallback';
    ($staged, $raw) = (0, 0) if $in_test;
    next;
  }
  next unless $in_test;
  if (/staged token file-read budget bytes=(\d+)/) {
    die "metadata-only load charged $1 payload bytes" unless $1 == 0;
    ++$staged;
  }
  if (/staged raw binlog file-read budget bytes=(\d+)/) {
    # Two ROW updates, each with 1,048,593-byte before/after payloads.
    die "raw fallback did not charge the complete final payload: $1"
      unless $1 == 4194690;
    ++$raw;
  }
}
die "no staged read budget observed" unless $staged > 0;
die "expected exactly one actual staged raw read, got $raw" unless $raw == 1;
print "raw_fallback_has_full_read_budget\n1\n";
EOF

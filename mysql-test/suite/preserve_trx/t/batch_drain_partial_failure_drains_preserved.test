--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_partial_failure;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_batch_partial_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_partial_app1,localhost,root,,test)
--connection batch_partial_app1
START TRANSACTION;
INSERT INTO t_batch_partial_failure VALUES(1,10);

--connect(batch_partial_app2,localhost,root,,test)
--connection batch_partial_app2
START TRANSACTION;
INSERT INTO t_batch_partial_failure VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target";

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--connection batch_partial_app1
COMMIT;
--disconnect batch_partial_app1

--connection batch_partial_app2
ROLLBACK;
--disconnect batch_partial_app2

--connection default
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT * FROM t_batch_partial_failure ORDER BY id;

DROP TABLE t_batch_partial_failure;
SET GLOBAL rds_preserve_trx_enable=ON;

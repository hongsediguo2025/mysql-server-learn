--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_read_view_export_fail;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_read_view_export_fail(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_read_view_export_fail VALUES(1,10),(2,20);

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT * FROM t_read_view_export_fail WHERE a=1;
UPDATE t_read_view_export_fail SET b=11 WHERE a=1;

--connect(read_view_export_control,localhost,root,,test)
SET SESSION debug="+d,preserve_trx_fail_export_read_view";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_export_read_view";
--disconnect read_view_export_control
--connection default

SELECT * FROM t_read_view_export_fail WHERE a=1;
ROLLBACK;
SELECT * FROM t_read_view_export_fail ORDER BY a;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_read_view_export_fail;
SET GLOBAL rds_preserve_trx_enable=ON;

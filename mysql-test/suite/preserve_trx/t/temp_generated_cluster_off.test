--disable_query_log
--let $saved_temp= `SELECT @@global.rds_preserve_trx_temp_table_enable`
SET GLOBAL rds_preserve_trx_temp_table_enable=OFF;
CREATE TABLE t_generated_off(id INT, v INT, KEY(v)) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_generated_off LIKE t_generated_off;
INSERT INTO t_generated_off WITH RECURSIVE s(n) AS
  (SELECT 1 UNION ALL SELECT n+1 FROM s WHERE n<512) SELECT n,n*10 FROM s;
INSERT INTO tmp_generated_off SELECT * FROM t_generated_off;
START TRANSACTION;
UPDATE t_generated_off SET v=v+7 WHERE id<=256;
UPDATE tmp_generated_off SET v=v+7 WHERE id<=256;
DELETE FROM t_generated_off WHERE id=512;
DELETE FROM tmp_generated_off WHERE id=512;
INSERT INTO t_generated_off VALUES(513,5130),(513,5130);
INSERT INTO tmp_generated_off VALUES(513,5130),(513,5130);
ROLLBACK;
--enable_query_log
SELECT COUNT(*)=512 AND SUM(v)=1313280 AS native_rollback FROM t_generated_off;
SELECT COUNT(*)=512 AND SUM(v)=1313280 AS temp_rollback FROM tmp_generated_off;
--disable_query_log
START TRANSACTION;
INSERT INTO t_generated_off VALUES(513,5130),(513,5130);
INSERT INTO tmp_generated_off VALUES(513,5130),(513,5130);
COMMIT;
--enable_query_log
SELECT COUNT(*)=514 AND SUM(v)=1323540 AS native_insert FROM t_generated_off;
SELECT COUNT(*)=514 AND SUM(v)=1323540 AS temp_insert FROM tmp_generated_off;
--disable_query_log
DROP TEMPORARY TABLE tmp_generated_off;
DROP TABLE t_generated_off;
--eval SET GLOBAL rds_preserve_trx_temp_table_enable=$saved_temp
--enable_query_log

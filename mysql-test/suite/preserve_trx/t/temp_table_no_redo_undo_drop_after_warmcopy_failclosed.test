--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_temp_table_enable=ON;

--connect(temp_drop_target, localhost, root,,test)
--connection temp_drop_target
CREATE TEMPORARY TABLE tmp_preserve_keep(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_preserve_drop_late(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_preserve_keep VALUES(1, 10);
INSERT INTO tmp_preserve_drop_late VALUES(9, 90);

--connect(temp_drop_owner, localhost, root,,test)
--connection temp_drop_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_open SIGNAL temp_drop_warmcopy_open WAIT_FOR temp_drop_continue_warmcopy';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR temp_drop_warmcopy_open TIMEOUT 10';

--connection temp_drop_target
DROP TEMPORARY TABLE tmp_preserve_drop_late;

--connection default
SET DEBUG_SYNC = 'now SIGNAL temp_drop_continue_warmcopy';

--connection temp_drop_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect temp_drop_owner

--connection default
--remove_file $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection temp_drop_target
SELECT * FROM tmp_preserve_keep ORDER BY id;
--error ER_NO_SUCH_TABLE
SELECT * FROM tmp_preserve_drop_late;
COMMIT;

DROP TEMPORARY TABLE tmp_preserve_keep;
--disconnect temp_drop_target
--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET DEBUG_SYNC = 'RESET';

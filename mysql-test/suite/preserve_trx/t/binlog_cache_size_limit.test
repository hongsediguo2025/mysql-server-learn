--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_binlog_cache_size_limit;
--enable_warnings

--let $MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;
SET @saved_preserve_trx_max_binlog_cache_bytes=@@GLOBAL.preserve_trx_max_binlog_cache_bytes;
SET GLOBAL preserve_trx_max_binlog_cache_bytes=1;

CREATE TABLE t_binlog_cache_size_limit(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_binlog_cache_size_limit VALUES(1,10);
RESET MASTER;

START TRANSACTION;
UPDATE t_binlog_cache_size_limit SET b=11 WHERE a=1;
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_binlog_cache_size_limit ORDER BY a;
ROLLBACK;
SELECT * FROM t_binlog_cache_size_limit ORDER BY a;
--exec sh -c 'test ! -d "$MYSQLD_DATADIR/preserve" || ! find "$MYSQLD_DATADIR/preserve" \( -name "*.bin" -o -name "*.bin.tmp" -o -name "*.binlog_cache" -o -name "*.binlog_cache.tmp" \) -print -quit | grep -q .'

START TRANSACTION;
UPDATE t_binlog_cache_size_limit SET b=12 WHERE a=1;
COMMIT;
SELECT * FROM t_binlog_cache_size_limit ORDER BY a;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/binlog_cache_size_limit.mysqlbinlog
--let $assert_text= Rolled back over-limit preserved transaction is discarded from binlog cache
--let $assert_file= $MYSQLTEST_VARDIR/tmp/binlog_cache_size_limit.mysqlbinlog
--let $assert_select= @2=11
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--let $assert_text= Later committed transaction remains in binlog after over-limit preserve failure
--let $assert_file= $MYSQLTEST_VARDIR/tmp/binlog_cache_size_limit.mysqlbinlog
--let $assert_select= @2=12
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/binlog_cache_size_limit.mysqlbinlog

DROP TABLE t_binlog_cache_size_limit;

SET GLOBAL preserve_trx_max_binlog_cache_bytes=@saved_preserve_trx_max_binlog_cache_bytes;
SET GLOBAL preserve_trx_enable=ON;

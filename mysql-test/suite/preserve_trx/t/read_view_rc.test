--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_read_view_rc;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_read_view_rc(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_read_view_rc VALUES(1,10),(2,200);

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
SELECT * FROM t_read_view_rc WHERE a=1;

--connect(rc_writer, localhost, root,,test)
UPDATE t_read_view_rc SET b=20 WHERE a=1;
--disconnect rc_writer
--source include/wait_until_disconnected.inc
--connection default

SELECT * FROM t_read_view_rc WHERE a=1;
UPDATE t_read_view_rc SET b=201 WHERE a=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(rc_writer_after, localhost, root,,test)
UPDATE t_read_view_rc SET b=30 WHERE a=1;
--disconnect rc_writer_after
--source include/wait_until_disconnected.inc
--connection default

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT * FROM t_read_view_rc WHERE a=1;
SELECT * FROM t_read_view_rc WHERE a=2;

--connect(rc_writer_after_second, localhost, root,,test)
UPDATE t_read_view_rc SET b=40 WHERE a=1;
--disconnect rc_writer_after_second
--source include/wait_until_disconnected.inc
--connection default

SELECT * FROM t_read_view_rc WHERE a=1;
SELECT * FROM t_read_view_rc WHERE a=2;

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--error 1
--file_exists $PRESERVED_SNAPSHOT_FILE

COMMIT;
SELECT * FROM t_read_view_rc ORDER BY a;

DROP TABLE t_read_view_rc;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/have_log_bin.inc
--source include/force_restart.inc
--source include/not_windows.inc

# Current release contract: temp-DML with no-redo row history is fail-closed.
# Positive temp sidecar P_S/rebind coverage lives in no-temp-row-history tests.

--disable_warnings
DROP TABLE IF EXISTS t_ps_warmcopy_temp_obs;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1024;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=8192;

CREATE TABLE t_ps_warmcopy_temp_obs(
  id INT PRIMARY KEY,
  payload VARBINARY(4096)
) ENGINE=InnoDB;
INSERT INTO t_ps_warmcopy_temp_obs VALUES(1, REPEAT('a', 1024));

--connect(ps_warmcopy_temp_app, localhost, root,,test)
CREATE TEMPORARY TABLE tmp_ps_warmcopy_temp_obs(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_ps_warmcopy_temp_obs VALUES(1, 10), (2, 20);
UPDATE tmp_ps_warmcopy_temp_obs SET v = v + 1 WHERE id = 1;
UPDATE t_ps_warmcopy_temp_obs
   SET payload = REPEAT('b', 2048)
 WHERE id = 1;

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--connection ps_warmcopy_temp_app
SELECT COUNT(*) AS temp_rows, SUM(v) AS temp_sum
  FROM tmp_ps_warmcopy_temp_obs;

COMMIT;
DROP TEMPORARY TABLE tmp_ps_warmcopy_temp_obs;
--disconnect ps_warmcopy_temp_app

--connection default
SELECT payload = REPEAT('b', 2048) AS persistent_payload_ok
  FROM t_ps_warmcopy_temp_obs
 WHERE id = 1;

DROP TABLE t_ps_warmcopy_temp_obs;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

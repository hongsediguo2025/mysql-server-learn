--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_logged_savepoint;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_logged_savepoint(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_logged_savepoint VALUES(1,10),(2,20),(3,30);
RESET MASTER;

START TRANSACTION;
UPDATE t_logged_savepoint SET v=11 WHERE id=1;
SAVEPOINT s1;
UPDATE t_logged_savepoint SET v=22 WHERE id=2;
SAVEPOINT s2;
UPDATE t_logged_savepoint SET v=33 WHERE id=3;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK TO SAVEPOINT s1;
RELEASE SAVEPOINT s1;
COMMIT;

SELECT * FROM t_logged_savepoint ORDER BY id;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/binlog_savepoint.mysqlbinlog
--let $assert_text= Preserved logged savepoint keeps pre-savepoint row event
--let $assert_file= $MYSQLTEST_VARDIR/tmp/binlog_savepoint.mysqlbinlog
--let $assert_select= @1=1
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= Preserved logged savepoint truncates post-savepoint row event
--let $assert_file= $MYSQLTEST_VARDIR/tmp/binlog_savepoint.mysqlbinlog
--let $assert_select= @1=2
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--exec awk "/^# at / { pos = \$3 + 0 } /end_log_pos/ { split(\$0, endpos, \"end_log_pos \"); split(endpos[2], endval, \" \"); last_end = endval[1] + 0 } /transaction_length=/ && !seen { split(\$0, parts, \"transaction_length=\"); split(parts[2], value, \" \"); first_start = pos; first_length = value[1] + 0; seen = 1 } END { if (!seen || !last_end) { print \"missing GTID transaction_length or end_log_pos\"; exit 1 } expected = last_end - first_start; if (first_length != expected) { printf(\"transaction_length mismatch: got %d expected %d\\n\", first_length, expected); exit 1 } }" $MYSQLTEST_VARDIR/tmp/binlog_savepoint.mysqlbinlog
--remove_file $MYSQLTEST_VARDIR/tmp/binlog_savepoint.mysqlbinlog

DROP TABLE t_logged_savepoint;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_transfer_startup_native_rollback;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_transfer_startup_native_rollback(
  id INT PRIMARY KEY,
  value INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_transfer_startup_native_rollback VALUES(1, 10);

--connect(active_trx,localhost,root,,test)
START TRANSACTION;
UPDATE t_transfer_startup_native_rollback SET value=20 WHERE id=1;

--connection default
--source include/kill_mysqld.inc
--disconnect active_trx

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --skip-log-bin
--source include/start_mysqld.inc
--let $restart_parameters=

# Transfer startup skips Preserve artifact recovery, but native InnoDB crash
# recovery must still roll back an ordinary uncommitted ACTIVE transaction.
SELECT id, value FROM t_transfer_startup_native_rollback;
SELECT COUNT(*) AS preserved_transactions_after_native_rollback
  FROM performance_schema.preserved_transactions;

DROP TABLE t_transfer_startup_native_rollback;

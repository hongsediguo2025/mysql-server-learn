--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_compression_metadata_mismatch;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("RESUME PRESERVED TRANSACTION .* failed: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction '.*' resume forced rollback: corrupt durable transaction snapshot");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_compression_metadata_mismatch(
  id INT PRIMARY KEY,
  payload TEXT
) ENGINE=InnoDB;
INSERT INTO t_compression_metadata_mismatch VALUES(1, REPEAT('a', 1000));

SET SESSION binlog_transaction_compression=ON;
SET SESSION binlog_transaction_compression_level_zstd=10;
START TRANSACTION;
UPDATE t_compression_metadata_mismatch
   SET payload=REPEAT('b', 1000)
 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_BINLOG_CACHE_FILE

--let _CMMR_TOKEN= $preserved_token
--perl
use strict;
use warnings;
use File::Spec;
use Fcntl qw(:DEFAULT :seek);

my $token = $ENV{'_CMMR_TOKEN'} or die "missing preserved token";
my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');
my $path = PreserveSnapshotFiles::preserve_snapshot_path_for_token($dir,
                                                                   $token);
defined($path) or die "cannot find snapshot for token $token";
sysopen(my $fh, $path, O_RDWR) or die "cannot open $path: $!";
binmode($fh);

my $bytes = do { local $/; <$fh> };
die "snapshot too small" unless length($bytes) > 520;
my $offset = 520;
my $found;
while ($offset + 6 <= length($bytes)) {
  my $tag = unpack('v', substr($bytes, $offset, 2));
  my $len = unpack('V', substr($bytes, $offset + 2, 4));
  die "bad tlv length" if $len > length($bytes) - $offset - 6;
  if ($tag == 0x60) {
    die "binlog cache metadata tlv too small" if $len < 2;
    $found = $offset + 6;
    last;
  }
  $offset += 6 + $len;
}
die "binlog cache metadata tlv not found" unless defined $found;

seek($fh, $found, SEEK_SET) or die "cannot seek metadata byte: $!";
my $byte = '';
sysread($fh, $byte, 1) == 1 or die "cannot read metadata byte";
seek($fh, $found, SEEK_SET) or die "cannot seek metadata byte for write: $!";
syswrite($fh, chr((ord($byte) ^ 0x01) & 0xff), 1) == 1
  or die "cannot corrupt metadata byte";
eval {
  require POSIX;
  POSIX::fsync(fileno($fh));
  1;
};
close($fh) or die "cannot close snapshot: $!";

print "corrupted_binlog_cache_metadata_tlv\n1\n";
EOF

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_CORRUPT_SNAPSHOT
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT COUNT(*) AS preserved_count_after_reject
  FROM performance_schema.preserved_transactions;
SELECT id, LENGTH(payload) AS payload_length,
       SUBSTR(payload, 1, 1) AS payload_prefix
  FROM t_compression_metadata_mismatch;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_compression_metadata_mismatch;
SET GLOBAL rds_preserve_trx_enable=ON;

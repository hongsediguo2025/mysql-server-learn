--source include/force_restart.inc

--let $restart_parameters= restart: --preserve-trx-enable=OFF
--source include/restart_mysqld.inc
--let $restart_parameters=

--disable_warnings
DROP TABLE IF EXISTS t_batch_temp_top_enable_after_temp_dml;
--enable_warnings

SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_batch_temp_top_enable_after_temp_dml(
  sid INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;

--connect(batch_temp_top_enable_app1,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_batch_temp_top_enable_after_temp_dml(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_batch_temp_top_enable_after_temp_dml VALUES(1, 100);
UPDATE tmp_batch_temp_top_enable_after_temp_dml SET v = 101 WHERE id = 1;

--connect(batch_temp_top_enable_app2,localhost,root,,test)
START TRANSACTION;
INSERT INTO t_batch_temp_top_enable_after_temp_dml VALUES(2, 20);

--connection default
--error ER_WRONG_ARGUMENTS
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

--connection batch_temp_top_enable_app1
INSERT INTO t_batch_temp_top_enable_after_temp_dml VALUES(1, 10);

--connection default
--let $wait_condition= SELECT COUNT(*) = 2 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_DISABLED
DRAIN TRANSACTIONS PRESERVE;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection batch_temp_top_enable_app1
INSERT INTO t_batch_temp_top_enable_after_temp_dml VALUES(3, 30);
COMMIT;
--disconnect batch_temp_top_enable_app1

--connection batch_temp_top_enable_app2
INSERT INTO t_batch_temp_top_enable_after_temp_dml VALUES(4, 40);
COMMIT;
--disconnect batch_temp_top_enable_app2

--connection default
SELECT * FROM t_batch_temp_top_enable_after_temp_dml ORDER BY sid;

DROP TABLE t_batch_temp_top_enable_after_temp_dml;

--let $restart_parameters= restart: --preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

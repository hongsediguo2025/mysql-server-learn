--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_state;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction resume failed to activate prepared undo state");
--enable_query_log

CREATE TABLE t_preserve_state(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_state VALUES(1,10);

--connect(state_preserve_con,localhost,root,,test)
--connection state_preserve_con
SET DEBUG_SYNC =
  'preserve_trx_before_snapshot_timestamp SIGNAL state_snapshotting WAIT_FOR continue_state_snapshotting';
START TRANSACTION;
UPDATE t_preserve_state SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR state_snapshotting TIMEOUT 10';
SELECT COUNT(*) AS snapshotting_rows
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'SNAPSHOTTING';
--replace_column 1 TOKEN
SHOW PRESERVED TRANSACTIONS;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_state_snapshotting';

--connection state_preserve_con
--reap
--disconnect state_preserve_con

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(state_resume_con,localhost,root,,test)
--connection state_resume_con
SET DEBUG_SYNC =
  'preserve_trx_resume_after_record_take SIGNAL state_resuming WAIT_FOR continue_state_resuming';
--replace_result $preserved_token TOKEN
--send_eval RESUME PRESERVED TRANSACTION '$preserved_token'

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR state_resuming TIMEOUT 10';
--replace_result $preserved_token TOKEN
SELECT TOKEN, STATE
  FROM performance_schema.preserved_transactions;

SET DEBUG_SYNC = 'now SIGNAL continue_state_resuming';

--connection state_resume_con
--reap
ROLLBACK;
--disconnect state_resume_con

--connection default
TRUNCATE TABLE t_preserve_state;
INSERT INTO t_preserve_state VALUES(1,10);

START TRANSACTION;
UPDATE t_preserve_state SET b=12 WHERE a=1;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION debug="+d,preserve_trx_fail_activate_resumed";
--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SET SESSION debug="-d,preserve_trx_fail_activate_resumed";

--replace_result $preserved_token TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

TRUNCATE TABLE t_preserve_state;
INSERT INTO t_preserve_state VALUES(1,10);

--connect(state_batch_app,localhost,root,,test)
--connection state_batch_app
START TRANSACTION;
UPDATE t_preserve_state SET b=13 WHERE a=1;

--connect(state_batch_owner,localhost,root,,test)
--connection state_batch_owner
SET DEBUG_SYNC =
  'preserve_trx_batch_after_one_target_preserved SIGNAL state_draining WAIT_FOR continue_state_draining';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.preserved_transactions WHERE STATE = 'DRAINING'
--source include/wait_condition.inc
SELECT COUNT(*) AS draining_rows
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'DRAINING';

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_state_draining';

--connection state_batch_owner
--reap
--disconnect state_batch_owner
--connection state_batch_app
--disconnect state_batch_app

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

DROP TABLE t_preserve_state;
SET GLOBAL preserve_trx_enable=ON;

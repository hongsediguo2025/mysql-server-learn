SELECT
  @@GLOBAL.preserve_trx_max_total AS max_total,
  @@GLOBAL.preserve_trx_max_pending_per_user AS max_pending_per_user,
  @@GLOBAL.preserve_trx_batch_max_transactions AS batch_max_transactions,
  @@SESSION.preserve_trx_default_timeout AS default_timeout,
  @@SESSION.preserve_trx_min_timeout AS min_timeout,
  @@SESSION.preserve_trx_max_timeout AS max_timeout,
  @@GLOBAL.preserve_trx_recovery_max_count AS recovery_max_count,
  @@GLOBAL.preserve_trx_recovery_grace_seconds AS recovery_grace_seconds,
  @@GLOBAL.preserve_trx_max_snapshot_bytes AS max_snapshot_bytes,
  @@GLOBAL.preserve_trx_max_binlog_cache_bytes AS max_binlog_cache_bytes;

SET @saved_max_total=@@GLOBAL.preserve_trx_max_total;
SET @saved_max_pending_per_user=@@GLOBAL.preserve_trx_max_pending_per_user;
SET @saved_batch_max_transactions=@@GLOBAL.preserve_trx_batch_max_transactions;
SET @saved_default_timeout=@@SESSION.preserve_trx_default_timeout;
SET @saved_min_timeout=@@SESSION.preserve_trx_min_timeout;
SET @saved_max_timeout=@@SESSION.preserve_trx_max_timeout;
SET @saved_recovery_max_count=@@GLOBAL.preserve_trx_recovery_max_count;
SET @saved_recovery_grace_seconds=@@GLOBAL.preserve_trx_recovery_grace_seconds;
SET @saved_max_snapshot_bytes=@@GLOBAL.preserve_trx_max_snapshot_bytes;
SET @saved_max_binlog_cache_bytes=@@GLOBAL.preserve_trx_max_binlog_cache_bytes;

SET GLOBAL preserve_trx_max_total=7;
SET GLOBAL preserve_trx_max_pending_per_user=5;
SET GLOBAL preserve_trx_batch_max_transactions=3;
SET SESSION preserve_trx_default_timeout=301;
SET SESSION preserve_trx_min_timeout=2;
SET SESSION preserve_trx_max_timeout=302;
SET GLOBAL preserve_trx_recovery_max_count=4;
SET GLOBAL preserve_trx_recovery_grace_seconds=60;
SET GLOBAL preserve_trx_max_snapshot_bytes=4096;
SET GLOBAL preserve_trx_max_binlog_cache_bytes=8192;

SELECT
  @@GLOBAL.preserve_trx_max_total AS max_total,
  @@GLOBAL.preserve_trx_max_pending_per_user AS max_pending_per_user,
  @@GLOBAL.preserve_trx_batch_max_transactions AS batch_max_transactions,
  @@SESSION.preserve_trx_default_timeout AS default_timeout,
  @@SESSION.preserve_trx_min_timeout AS min_timeout,
  @@SESSION.preserve_trx_max_timeout AS max_timeout,
  @@GLOBAL.preserve_trx_recovery_max_count AS recovery_max_count,
  @@GLOBAL.preserve_trx_recovery_grace_seconds AS recovery_grace_seconds,
  @@GLOBAL.preserve_trx_max_snapshot_bytes AS max_snapshot_bytes,
  @@GLOBAL.preserve_trx_max_binlog_cache_bytes AS max_binlog_cache_bytes;

SET GLOBAL preserve_trx_max_total=@saved_max_total;
SET GLOBAL preserve_trx_max_pending_per_user=@saved_max_pending_per_user;
SET GLOBAL preserve_trx_batch_max_transactions=@saved_batch_max_transactions;
SET SESSION preserve_trx_default_timeout=@saved_default_timeout;
SET SESSION preserve_trx_min_timeout=@saved_min_timeout;
SET SESSION preserve_trx_max_timeout=@saved_max_timeout;
SET GLOBAL preserve_trx_recovery_max_count=@saved_recovery_max_count;
SET GLOBAL preserve_trx_recovery_grace_seconds=@saved_recovery_grace_seconds;
SET GLOBAL preserve_trx_max_snapshot_bytes=@saved_max_snapshot_bytes;
SET GLOBAL preserve_trx_max_binlog_cache_bytes=@saved_max_binlog_cache_bytes;

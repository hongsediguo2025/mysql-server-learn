--source include/have_debug.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/receiver-selection-deadline.secret
--write_file $credential_file
receiver-selection-deadline-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS receiver_deadline_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'receiver-selection-deadline-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER receiver_deadline_app@localhost;
GRANT SELECT, UPDATE ON test.* TO receiver_deadline_app@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$MASTER_MYSOCK --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=receiver_selection_deadline --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL preserve_trx_batch_max_transactions=3;
SET GLOBAL preserve_trx_transfer_pipeline_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=1000;
SET GLOBAL preserve_trx_token_retention_timeout_ms=120000;

CREATE TABLE t_receiver_selection_deadline(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_receiver_selection_deadline VALUES(1,10),(2,20),(3,30);

--connect(receiver_deadline_ha,localhost,preserve_trx_ha_admin,receiver-selection-deadline-secret,test)

--connect(receiver_deadline_app1,localhost,receiver_deadline_app,,test)
--let $app1_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_receiver_selection_deadline SET v=11 WHERE id=1;

--connect(receiver_deadline_app2,localhost,receiver_deadline_app,,test)
--let $app2_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_receiver_selection_deadline SET v=21 WHERE id=2;

--connect(receiver_deadline_app3,localhost,receiver_deadline_app,,test)
--let $app3_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_receiver_selection_deadline SET v=31 WHERE id=3;

--connection default
--replace_result $app1_id APP1_ID $app2_id APP2_ID $app3_id APP3_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection receiver_deadline_ha
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=3
--source include/wait_condition.inc
SELECT VARIABLE_VALUE=3 AS three_classified_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens';
SELECT VARIABLE_VALUE=0 AS zero_ready_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens';
SELECT VARIABLE_VALUE=3 AS three_failed_tokens
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens';
SELECT VARIABLE_VALUE=1 AS epoch_retained
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';

SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc
SELECT VARIABLE_VALUE=1 AS selection_stays_frozen
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

--connect(receiver_deadline_cleanup,localhost,root,,test)
DROP TABLE t_receiver_selection_deadline;
DROP USER receiver_deadline_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file

--enable_query_log

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction batch cleanup failed after target preserve error");

--disable_warnings
DROP TABLE IF EXISTS t_batch_current_reattach_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_current_reattach_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_current_reattach_app,localhost,root,,test)
--connection batch_current_reattach_app
START TRANSACTION;
INSERT INTO t_batch_current_reattach_failure VALUES(1,10);

--connection default
SET SESSION debug="+d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_reattach_original_thd";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_after_snapshot_rename,preserve_trx_fail_reattach_original_thd";

SELECT 1 AS server_alive_after_current_target_failure;
SELECT COUNT(*) AS preserved_cleanup_records
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'PRESERVED'
   AND LAST_ERROR IS NOT NULL
   AND LAST_ERROR_AT IS NOT NULL;
--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions
 ORDER BY TOKEN;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection batch_current_reattach_app
--source include/wait_until_disconnected.inc

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

SELECT * FROM t_batch_current_reattach_failure ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_batch_current_reattach_failure;
SET GLOBAL preserve_trx_enable=ON;

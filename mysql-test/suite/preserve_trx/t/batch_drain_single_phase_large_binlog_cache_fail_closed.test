--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_single_phase_large_cache;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_single_phase_max_binlog_cache_bytes= `SELECT @@GLOBAL.preserve_trx_single_phase_max_binlog_cache_bytes`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=8;

CREATE TABLE t_single_phase_large_cache(
  id INT PRIMARY KEY,
  payload VARBINARY(1024)
) ENGINE=InnoDB;
RESET MASTER;

--connect(single_phase_large_app, localhost, root,,test)
START TRANSACTION;
INSERT INTO t_single_phase_large_cache VALUES(1, REPEAT('a',512));
UPDATE t_single_phase_large_cache SET payload=REPEAT('b',512) WHERE id=1;

--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection single_phase_large_app
COMMIT;
--disconnect single_phase_large_app

--connection default
SELECT id, OCTET_LENGTH(payload) AS payload_len,
       payload = REPEAT('b',512) AS payload_ok
  FROM t_single_phase_large_cache;
--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/single_phase_large.mysqlbinlog
--let $assert_text= single-phase fail-closed transaction remains committable in binlog
--let $assert_file= $MYSQLTEST_VARDIR/tmp/single_phase_large.mysqlbinlog
--let $assert_select= t_single_phase_large_cache
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= single-phase fail-closed transaction row event is committed in binlog
--let $assert_file= $MYSQLTEST_VARDIR/tmp/single_phase_large.mysqlbinlog
--let $assert_select= @1=1
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= single-phase fail-closed transaction commits with a nonzero Xid event
--let $assert_file= $MYSQLTEST_VARDIR/tmp/single_phase_large.mysqlbinlog
--let $assert_select= Xid = [1-9][0-9]*
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/single_phase_large.mysqlbinlog

DROP TABLE t_single_phase_large_cache;
--disable_query_log
--eval SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=$old_preserve_trx_single_phase_max_binlog_cache_bytes
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log

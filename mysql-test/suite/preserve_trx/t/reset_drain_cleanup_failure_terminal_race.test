# Review-IDs: CR-A1/RR-H1
# Workload: W04 + O06/O10 | FX: reset terminal publication race
# Overlays: O06,O10
# Actors: T1A/T1B=owner transactions, T2=DRAIN owner, T3=async RESET DRAIN,
#         T4=observer/native DML
# RED invariant (unfixed code): RESET DRAIN wins reset ownership after the
#   manager was already published DRAIN_CLEANUP_FAILED;
#   preserve_trx_publish_reset_cleanup() has no DRAIN_CLEANUP_FAILED case and
#   aborts the server on the named invariant
#   reset_manager_publication_failed (see mysqld error log of the red run).
# GREEN invariant (this .result is the hand-written GREEN contract per plan
#   section 7.2): RESET DRAIN returns in bounded time through the unified
#   terminal funnel; exactly one source restore/barrier/cleanup executes; the
#   server survives the race; a later RESET DRAIN returns NO_ACTIVE/OK,
#   proving the manager is IDLE; T1A/T1B each reach one terminal state; the
#   O06 native commit is preserved.
#
# This runtime race test requires a Debug server with Debug Sync enabled.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log

--let $credential_file= $MYSQL_TMP_DIR/reset_cleanup_terminal.secret
--write_file $credential_file
reset-cleanup-terminal-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS reset_terminal_app@localhost;
DROP TABLE IF EXISTS reset_terminal_native;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'reset-cleanup-terminal-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER reset_terminal_app@localhost;
GRANT SELECT, INSERT, UPDATE, DELETE ON test.* TO reset_terminal_app@localhost;
GRANT SESSION_VARIABLES_ADMIN ON *.* TO reset_terminal_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=reset_terminal_mtr --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=

CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
CALL mtr.add_suppression("PRESERVE: RESET DRAIN invariant failure");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");
CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files");
CALL mtr.add_suppression("Preserved transaction '.*' expired-token reaper forced rollback: recovery timeout expired");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=1000;

--enable_query_log
# W04: two tables updated in opposite logical directions.
CREATE TABLE reset_terminal_accounts(
  id INT PRIMARY KEY,
  balance INT NOT NULL,
  version INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE reset_terminal_ledger(
  id INT AUTO_INCREMENT PRIMARY KEY,
  account_id INT NOT NULL,
  delta INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO reset_terminal_accounts VALUES
  (1,1000,0),(2,1000,0),(3,1000,0),(4,1000,0);
--disable_query_log

# O06: committed native background owned by a non-target.
CREATE TABLE reset_terminal_native(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO reset_terminal_native VALUES (1,10),(2,20);

# T1A: W04 debit 1 / credit 2 + ledger rows.
--connect(reset_term_app_a,localhost,reset_terminal_app,,test)
START TRANSACTION;
UPDATE reset_terminal_accounts SET balance=balance-50, version=version+1
  WHERE id=1;
UPDATE reset_terminal_accounts SET balance=balance+50, version=version+1
  WHERE id=2;
INSERT INTO reset_terminal_ledger(account_id,delta) VALUES (1,-50),(2,50);

# T1B: W04 debit 3 / credit 4 + ledger rows (disjoint rows from T1A).
--connect(reset_term_app_b,localhost,reset_terminal_app,,test)
START TRANSACTION;
UPDATE reset_terminal_accounts SET balance=balance-30, version=version+1
  WHERE id=3;
UPDATE reset_terminal_accounts SET balance=balance+30, version=version+1
  WHERE id=4;
INSERT INTO reset_terminal_ledger(account_id,delta) VALUES (3,-30),(4,30);

# T2: DRAIN owner. Fault selectors force the phase-2 final lock-fence change
# branch and a deterministic restore cleanup failure (reattach fails,
# snapshot delete fails), pinning T2 inside
# finish_cleanup_failure_without_shutdown with the manager already published
# as DRAIN_CLEANUP_FAILED.
--connect(reset_term_owner,localhost,root,,test)
SET SESSION debug='+d,preserve_trx_early_force_final_fence_change,preserve_trx_fail_reattach_original_thd,preserve_trx_fail_delete_snapshot_files';
SET DEBUG_SYNC=
  'preserve_trx_cleanup_failure_terminal_published SIGNAL t2_cleanup_terminal WAIT_FOR t2_cleanup_terminal_release';
--send DRAIN TRANSACTIONS PRESERVE

# T4/HA observer: wait until T2 published DRAIN_CLEANUP_FAILED and is parked
# before returning from finish_cleanup_failure_without_shutdown.
--connect(reset_term_ha,localhost,preserve_trx_ha_admin,reset-cleanup-terminal-secret,test)
SET DEBUG_SYNC='now WAIT_FOR t2_cleanup_terminal TIMEOUT 60';

# T3: RESET DRAIN wins reset ownership while the manager is already
# DRAIN_CLEANUP_FAILED.
--connect(reset_term_reset,localhost,preserve_trx_ha_admin,reset-cleanup-terminal-secret,test)
SET DEBUG_SYNC=
  'preserve_trx_reset_after_ownership_before_manager_publish SIGNAL t3_reset_won WAIT_FOR t3_reset_publish_release';
--send RESET DRAIN

--connection reset_term_ha
SET DEBUG_SYNC='now WAIT_FOR t3_reset_won TIMEOUT 60';

# T4 has now observed the exact request_reset()==WON linearization point.
# Let T3 publish RESET_CLEANUP while it still owns the active-attempt mutex;
# T2 cannot retire the attempt before that publication completes.
SET DEBUG_SYNC='now SIGNAL t3_reset_publish_release';
SET DEBUG_SYNC='now SIGNAL t2_cleanup_terminal_release';

# On unfixed code T3's RESET DRAIN aborts the server on the named invariant
# reset_manager_publication_failed; both reaps then see CR_SERVER_LOST.
--connection reset_term_reset
--reap

--connection reset_term_owner
--error ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED
--reap

--connection reset_term_ha
--enable_query_log
# GREEN-only step: on unfixed code the server is dead here, so the red run
# stops with the named invariant abort in the crash log.
SELECT 1 AS server_survived_terminal_race;

# GREEN verification: bounded RESET already returned above; the manager must
# be IDLE now (a fresh RESET DRAIN gets NO_ACTIVE -> OK).
--connect(reset_term_idle_probe,localhost,preserve_trx_ha_admin,reset-cleanup-terminal-secret,test)
RESET DRAIN;
--disconnect reset_term_idle_probe

--connection reset_term_ha
# T1A/T1B were force-terminated by the deterministic cleanup failure; their
# W04 changes never committed. O06 native commit is preserved.
SELECT GROUP_CONCAT(CONCAT(id,':',balance,':',version) ORDER BY id)
       AS accounts_after_race
  FROM reset_terminal_accounts;
SELECT COUNT(*) AS ledger_rows_after_race FROM reset_terminal_ledger;
SELECT COUNT(*) AS preserved_records_after_race
  FROM performance_schema.preserved_transactions;
SELECT * FROM reset_terminal_native ORDER BY id;
--disable_query_log

--connection default
DROP TABLE reset_terminal_accounts;
DROP TABLE reset_terminal_ledger;
DROP TABLE reset_terminal_native;
DROP USER preserve_trx_ha_admin@localhost;
DROP USER reset_terminal_app@localhost;
SET DEBUG_SYNC='RESET';
--remove_file $credential_file
--disconnect reset_term_ha

--enable_query_log

--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_ps_warmcopy_temp_obs;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_ps_warmcopy_temp_obs(
  id INT PRIMARY KEY,
  payload VARBINARY(2048)
) ENGINE=InnoDB;
INSERT INTO t_ps_warmcopy_temp_obs VALUES(1,REPEAT('a',1024));

--connect(ps_warmcopy_temp_app, localhost, root,,test)
CREATE TEMPORARY TABLE tmp_ps_warmcopy_temp_obs(
  id INT PRIMARY KEY,
  note VARCHAR(64)
) ENGINE=InnoDB;
INSERT INTO tmp_ps_warmcopy_temp_obs VALUES(1,'before-preserve');

START TRANSACTION;
UPDATE t_ps_warmcopy_temp_obs
  SET payload=REPEAT('b',1024)
  WHERE id=1;

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source include/wait_until_disconnected.inc
--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS binlog_cache_size_positive,
       BINLOG_WARMCOPY_STATE,
       TEMP_TABLE_STATE,
       TEMP_IMAGE_BYTES > 0 AS temp_image_bytes_positive,
       TEMP_UNDO_BYTES,
       TEMP_SIDECARS_COMPLETE
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_ps_warmcopy_temp_obs ORDER BY id;
COMMIT;
--disconnect ps_warmcopy_temp_app

--connection default
SELECT id, payload=REPEAT('b',1024) AS payload_ok
  FROM t_ps_warmcopy_temp_obs
  ORDER BY id;

DROP TABLE t_ps_warmcopy_temp_obs;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed to activate reattached transaction");

--disable_warnings
DROP TABLE IF EXISTS t_batch_reattach_activate_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_reattach_activate_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_reattach_activate_a,localhost,root,,test)
--connection batch_reattach_activate_a
--let $app_a_thread_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
INSERT INTO t_batch_reattach_activate_failure VALUES(1,10);

--connect(batch_reattach_activate_b,localhost,root,,test)
--connection batch_reattach_activate_b
START TRANSACTION;
INSERT INTO t_batch_reattach_activate_failure VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_fail_after_detach_for_batch_reattach,preserve_trx_fail_activate_reattached_original";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_after_detach_for_batch_reattach,preserve_trx_fail_activate_reattached_original";

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--replace_result $app_a_thread_id APP_A_THREAD_ID
--eval SELECT COUNT(*) AS app_a_innodb_trx_count FROM information_schema.INNODB_TRX WHERE trx_mysql_thread_id = $app_a_thread_id
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_reattach_activate_a
SELECT COUNT(*) AS app_a_in_transaction_after_cleanup_failure
  FROM information_schema.INNODB_TRX
 WHERE trx_mysql_thread_id = CONNECTION_ID();
ROLLBACK;
--disconnect batch_reattach_activate_a

--connection batch_reattach_activate_b
ROLLBACK;
--disconnect batch_reattach_activate_b

--connection default
SELECT * FROM t_batch_reattach_activate_failure ORDER BY id;

DROP TABLE t_batch_reattach_activate_failure;
SET GLOBAL preserve_trx_enable=ON;

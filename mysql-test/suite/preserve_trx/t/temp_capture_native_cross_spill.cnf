[mysqld.1]
server_id=1
default_authentication_plugin=mysql_native_password
log-bin=temp-ready-source
binlog-format=ROW
gtid-mode=ON
enforce-gtid-consistency=ON
rds-preserve-trx-enable=ON
rds-preserve-trx-temp-id-namespace=ON
rds-preserve-trx-result-capture-enable=ON

[mysqld.2]
server_id=2
default_authentication_plugin=mysql_native_password
log-bin=temp-ready-receiver
binlog-format=ROW
gtid-mode=ON
enforce-gtid-consistency=ON
rds-preserve-trx-enable=ON
rds-preserve-trx-temp-id-namespace=ON
rds-preserve-trx-result-capture-enable=ON
rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE
rds-preserve-trx-standby-phase2-scheduler-mode=DEPENDENCY_CONVERGENCE_V1
rds-preserve-trx-phase1-capture-mode=BOUNDED_PIPELINE_V1

[ENV]
SERVER_MYPORT_2=@mysqld.2.port

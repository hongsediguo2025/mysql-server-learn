--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_gap_next_key_after_resume;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_gap_next_key_after_resume(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_gap_next_key_after_resume VALUES(10,10),(20,20),(30,30);

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_gap_next_key_after_resume SET v=11 WHERE id=10;
SELECT * FROM t_gap_next_key_after_resume
  WHERE id > 10 AND id <= 20 FOR UPDATE;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--connect(gap_writer, localhost, root,,test)
SET SESSION innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t_gap_next_key_after_resume SET v=21 WHERE id=20;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t_gap_next_key_after_resume VALUES(15,15);
--disconnect gap_writer
--source include/wait_until_disconnected.inc
--connection default

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

ROLLBACK;
UPDATE t_gap_next_key_after_resume SET v=21 WHERE id=20;
INSERT INTO t_gap_next_key_after_resume VALUES(15,15);
SELECT * FROM t_gap_next_key_after_resume ORDER BY id;

DROP TABLE t_gap_next_key_after_resume;
SET GLOBAL preserve_trx_enable=ON;

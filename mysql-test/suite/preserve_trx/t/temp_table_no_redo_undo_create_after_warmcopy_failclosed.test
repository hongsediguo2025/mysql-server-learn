--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_temp_table_enable=ON;

--connect(temp_create_target, localhost, root,,test)
--connection temp_create_target
CREATE TEMPORARY TABLE tmp_preserve_existing(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_preserve_existing VALUES(1, 10);

--connect(temp_create_owner, localhost, root,,test)
--connection temp_create_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_open SIGNAL temp_create_warmcopy_open WAIT_FOR temp_create_continue_warmcopy';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR temp_create_warmcopy_open TIMEOUT 10';

--connection temp_create_target
CREATE TEMPORARY TABLE tmp_preserve_created_late(
  id INT PRIMARY KEY,
  note VARCHAR(20)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_created_late VALUES(7, 'created-late');

--connection default
SET DEBUG_SYNC = 'now SIGNAL temp_create_continue_warmcopy';

--connection temp_create_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect temp_create_owner

--connection default
--remove_file $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection temp_create_target
SELECT * FROM tmp_preserve_existing ORDER BY id;
SELECT * FROM tmp_preserve_created_late ORDER BY id;
INSERT INTO tmp_preserve_created_late VALUES(8, 'after-resume');
COMMIT;
SELECT COUNT(*) AS created_late_rows FROM tmp_preserve_created_late;

DROP TEMPORARY TABLE tmp_preserve_created_late;
DROP TEMPORARY TABLE tmp_preserve_existing;
--disconnect temp_create_target
--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET DEBUG_SYNC = 'RESET';

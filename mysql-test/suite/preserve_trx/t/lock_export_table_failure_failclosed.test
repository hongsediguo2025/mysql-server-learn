--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_export_table_failclosed;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_lock_export_table_failclosed(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_export_table_failclosed VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_lock_export_table_failclosed SET v=21 WHERE id=2;

--connect(table_lock_export_control,localhost,root,,test)
SET SESSION debug="+d,preserve_trx_fail_export_table_locks";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_fail_export_table_locks";
--disconnect table_lock_export_control
--connection default

SELECT v AS value_visible_in_failed_preserve_trx
  FROM t_lock_export_table_failclosed
 WHERE id=2;
COMMIT;

SELECT * FROM t_lock_export_table_failclosed ORDER BY id;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_lock_export_table_failclosed;
SET GLOBAL preserve_trx_enable=ON;

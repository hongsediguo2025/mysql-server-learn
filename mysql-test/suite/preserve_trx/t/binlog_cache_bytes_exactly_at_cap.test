--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_binlog_cache_exact_cap;
--enable_warnings

--let $saved_preserve_trx_max_binlog_cache_bytes= `SELECT @@GLOBAL.preserve_trx_max_binlog_cache_bytes`
--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_binlog_cache_exact_cap(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_binlog_cache_exact_cap VALUES(1,10);
RESET MASTER;

START TRANSACTION;
UPDATE t_binlog_cache_exact_cap SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir $dir: $!";
my @caches = grep { /\.binlog_cache$/ } readdir($dh);
closedir($dh);
die "expected one binlog cache, found " . scalar(@caches) . "\n"
  unless @caches == 1;
my $path = File::Spec->catfile($dir, $caches[0]);
my $size = -s $path;
die "expected nonempty binlog cache\n" unless defined($size) && $size > 0;
my $inc = File::Spec->catfile($ENV{'MYSQLTEST_VARDIR'}, 'tmp',
                              'binlog_cache_exact_cap.inc');
open(my $out, '>', $inc) or die "cannot write $inc: $!";
print {$out} "--let \$measured_binlog_cache_bytes= $size\n";
close($out);
EOF

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--source $MYSQLTEST_VARDIR/tmp/binlog_cache_exact_cap.inc
--let $below_binlog_cache_bytes= `SELECT $measured_binlog_cache_bytes - 1`

--disable_query_log
--eval SET GLOBAL preserve_trx_max_binlog_cache_bytes=$measured_binlog_cache_bytes
--enable_query_log

START TRANSACTION;
UPDATE t_binlog_cache_exact_cap SET v=12 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--let $exact_cache_size_match= `SELECT BINLOG_CACHE_SIZE = $measured_binlog_cache_bytes FROM performance_schema.preserved_transactions`
if ($exact_cache_size_match != 1)
{
  SELECT BINLOG_CACHE_SIZE
    FROM performance_schema.preserved_transactions;
  --die exact binlog cache byte cap did not preserve the expected cache size
}
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--disable_query_log
--eval SET GLOBAL preserve_trx_max_binlog_cache_bytes=$below_binlog_cache_bytes
--enable_query_log

START TRANSACTION;
UPDATE t_binlog_cache_exact_cap SET v=13 WHERE id=1;
--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc
SELECT v AS value_after_reject
  FROM t_binlog_cache_exact_cap
 WHERE id=1;
ROLLBACK;
SELECT v AS value_after_rollback
  FROM t_binlog_cache_exact_cap
 WHERE id=1;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--disable_query_log
--eval SET GLOBAL preserve_trx_max_binlog_cache_bytes=$saved_preserve_trx_max_binlog_cache_bytes
--enable_query_log
DROP TABLE t_binlog_cache_exact_cap;
SET GLOBAL preserve_trx_enable=ON;

--remove_file $MYSQLTEST_VARDIR/tmp/binlog_cache_exact_cap.inc

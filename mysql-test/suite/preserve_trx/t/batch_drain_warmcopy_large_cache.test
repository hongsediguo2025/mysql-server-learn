--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_large;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1024;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=4096;

CREATE TABLE t_warmcopy_large(
  id INT PRIMARY KEY,
  sid INT NOT NULL,
  payload VARBINARY(512),
  KEY(sid)
) ENGINE=InnoDB;

INSERT INTO t_warmcopy_large VALUES
  (1,1,REPEAT('a',512)),
  (2,2,REPEAT('b',512));
RESET MASTER;

--connect(warmcopy_large_a, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_large SET payload=REPEAT('x',512) WHERE id=1;
INSERT INTO t_warmcopy_large VALUES(101,1,REPEAT('p',512));

--connect(warmcopy_large_b, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_large SET payload=REPEAT('y',512) WHERE id=2;
INSERT INTO t_warmcopy_large VALUES(102,2,REPEAT('q',512));

--connect(warmcopy_large_owner, localhost, root,,test)
--connection warmcopy_large_owner
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection warmcopy_large_owner
--reap
--disconnect warmcopy_large_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $assert_text= warm-copy large cache used prebuilt fast path metrics
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: warm-copy drain metrics prefix_bytes=[1-9][0-9]* digest_bytes=[1-9][0-9]* durable_bytes=[1-9][0-9]* phase2_pause_us=[1-9][0-9]* full_copy_to_count=0
--let $assert_count= 1
--source include/assert_grep.inc

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

CREATE TEMPORARY TABLE warmcopy_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
  FROM performance_schema.preserved_transactions;

--let $token1= `SELECT TOKEN FROM warmcopy_tokens WHERE rn=1`
--let $token2= `SELECT TOKEN FROM warmcopy_tokens WHERE rn=2`

--connect(warmcopy_large_resume1, localhost, root,,test)
--connection warmcopy_large_resume1
--replace_result $token1 TOKEN
--eval RESUME PRESERVED TRANSACTION '$token1'
COMMIT;

--connect(warmcopy_large_resume2, localhost, root,,test)
--connection warmcopy_large_resume2
--replace_result $token2 TOKEN
--eval RESUME PRESERVED TRANSACTION '$token2'
COMMIT;

--connection default
SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS row_count,
       SUM(sid=1) AS sid1_rows,
       SUM(sid=2) AS sid2_rows
  FROM t_warmcopy_large;
SELECT id, sid, OCTET_LENGTH(payload) AS payload_len,
       CASE id
         WHEN 1 THEN payload=REPEAT('x',512)
         WHEN 2 THEN payload=REPEAT('y',512)
         WHEN 101 THEN payload=REPEAT('p',512)
         WHEN 102 THEN payload=REPEAT('q',512)
       END AS payload_ok
  FROM t_warmcopy_large
  ORDER BY id;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_large.mysqlbinlog
--let $assert_text= committed warm-copy resumed transaction one appears once in binlog
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_large.mysqlbinlog
--let $assert_select= @1=101
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= committed warm-copy resumed transaction two appears once in binlog
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_large.mysqlbinlog
--let $assert_select= @1=102
--let $assert_count= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/batch_drain_warmcopy_large.mysqlbinlog

DROP TABLE t_warmcopy_large;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;

--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_binlog_cache_sidecar_digest;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
--enable_query_log

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_binlog_cache_sidecar_digest(
  id INT PRIMARY KEY,
  payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO t_binlog_cache_sidecar_digest VALUES(1,'a'),(2,'b');
RESET MASTER;

START TRANSACTION;
UPDATE t_binlog_cache_sidecar_digest
   SET payload=REPEAT('x', 80)
 WHERE id=1;
UPDATE t_binlog_cache_sidecar_digest
   SET payload=REPEAT('y', 80)
 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--file_exists $PRESERVED_BINLOG_CACHE_FILE

--let _BCDM_BINLOG_CACHE_FILE= $PRESERVED_BINLOG_CACHE_FILE
--perl
use strict;
use warnings;
use Fcntl qw(:DEFAULT :seek);

my $path = $ENV{'_BCDM_BINLOG_CACHE_FILE'} or die "missing binlog cache path";
sysopen(my $fh, $path, O_RDWR) or die "cannot open $path: $!";
binmode($fh);
my $byte = '';
sysread($fh, $byte, 1) == 1 or die "cannot read first binlog-cache byte";
seek($fh, 0, SEEK_SET) or die "cannot seek binlog-cache byte";
syswrite($fh, chr((ord($byte) ^ 0x01) & 0xff), 1) == 1
  or die "cannot rewrite first binlog-cache byte";
eval {
  require POSIX;
  POSIX::fsync(fileno($fh));
  1;
};
close($fh) or die "cannot close binlog-cache sidecar: $!";

print "corrupted_same_size_binlog_cache_sidecar\n1\n";
EOF

--let $restart_parameters= restart: --preserve-trx-enable=ON
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

SELECT COUNT(*) AS preserved_count_after_corrupt_sidecar
  FROM performance_schema.preserved_transactions;
SELECT id, payload
  FROM t_binlog_cache_sidecar_digest
 ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_binlog_cache_sidecar_digest;
SET GLOBAL preserve_trx_enable=ON;

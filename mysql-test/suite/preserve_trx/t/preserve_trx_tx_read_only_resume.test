--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_tx_read_only;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_tx_read_only(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_tx_read_only VALUES(1,10);

SET SESSION transaction_read_only=ON;
START TRANSACTION READ WRITE;
UPDATE t_preserve_tx_read_only SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SET SESSION transaction_read_only=OFF;
SELECT @@session.transaction_read_only AS session_read_only_before_resume;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@session.transaction_read_only AS session_read_only_after_resume;
UPDATE t_preserve_tx_read_only SET b=12 WHERE a=1;
COMMIT;
SELECT @@session.transaction_read_only AS session_read_only_after_commit;

START TRANSACTION;
--error ER_CANT_EXECUTE_IN_READ_ONLY_TRANSACTION
UPDATE t_preserve_tx_read_only SET b=13 WHERE a=1;
ROLLBACK;
SET SESSION transaction_read_only=OFF;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SELECT * FROM t_preserve_tx_read_only ORDER BY a;
DROP TABLE t_preserve_tx_read_only;
SET GLOBAL preserve_trx_enable=ON;

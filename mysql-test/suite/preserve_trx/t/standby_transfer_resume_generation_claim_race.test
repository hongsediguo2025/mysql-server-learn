--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--disable_result_log

--let $credential_file= $MYSQL_TMP_DIR/resume-generation-claim.secret
--write_file $credential_file
resume-generation-claim-secret
EOF
--exec chmod 600 $credential_file

--connect(generation_receiver_root,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP TABLE IF EXISTS t_generation_claim_receiver;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-generation-claim-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN,
      RESUME_ANY_PRESERVED_TRANSACTION,
      PROCESS, SYSTEM_VARIABLES_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE TABLE t_generation_claim_receiver(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_generation_claim_receiver VALUES(1,100);
--connect(generation_receiver_a,127.0.0.1,preserve_trx_ha_admin,resume-generation-claim-secret,test,$SERVER_MYPORT_2,)
--connect(generation_receiver_b,127.0.0.1,preserve_trx_ha_admin,resume-generation-claim-secret,test,$SERVER_MYPORT_2,)

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS generation_claim_app@localhost;
DROP TABLE IF EXISTS t_generation_claim_source;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'resume-generation-claim-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN, PROCESS ON *.*
  TO preserve_trx_ha_admin@localhost;
CREATE USER generation_claim_app@localhost;
GRANT SELECT, UPDATE ON test.* TO generation_claim_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=resume_generation_claim --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--source include/restart_mysqld.inc
--let $restart_parameters=
--disable_query_log
--disable_result_log

CREATE TABLE t_generation_claim_source(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_generation_claim_source VALUES(1,10);

--connect(generation_source_ha,localhost,preserve_trx_ha_admin,resume-generation-claim-secret,test)
--connect(generation_source_idle,localhost,generation_claim_app,,test)
--let $source_idle_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
--connect(generation_source_marker,localhost,generation_claim_app,,test)
UPDATE t_generation_claim_source SET v=11 WHERE id=1;

# Receiver A obtains a generation=0 provisional transaction claim before the
# source publishes the same numeric token in the new session-only set.
--connection generation_receiver_a
SET SESSION debug='+d,preserve_trx_force_transaction_resume_candidate';
SET DEBUG_SYNC=
  'preserve_trx_resume_after_handoff_begin SIGNAL generation_claim_acquired WAIT_FOR generation_claim_release';
--send_eval RESUME PRESERVED TRANSACTION '$source_idle_id'

--connection generation_receiver_root
SET DEBUG_SYNC='now WAIT_FOR generation_claim_acquired TIMEOUT 30';
UPDATE t_generation_claim_receiver SET v=101 WHERE id=1;

--connection default
DRAIN TRANSACTIONS PRESERVE;

# The new S generation is visible, but A's provisional transaction claim must
# prevent B from consuming the same numeric token.
--connection generation_receiver_b
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$source_idle_id'

--connection generation_receiver_root
SET DEBUG_SYNC='now SIGNAL generation_claim_release';
--connection generation_receiver_a
--error ER_PRESERVE_TRX_NOT_FOUND
--reap
SET SESSION debug='-d,preserve_trx_force_transaction_resume_candidate';
SET DEBUG_SYNC='RESET';

# Releasing A's claim makes the same S member consumable exactly once.
--connection generation_receiver_b
--eval RESUME PRESERVED TRANSACTION '$source_idle_id'
--error ER_PRESERVE_TRX_HANDOFF_UNAVAILABLE
--eval RESUME PRESERVED TRANSACTION '$source_idle_id'

--connection generation_source_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--disable_result_log

--connect(generation_source_cleanup,localhost,root,,test)
--enable_result_log
SELECT id,v FROM t_generation_claim_source ORDER BY id;
--connection generation_receiver_root
SELECT id,v FROM t_generation_claim_receiver ORDER BY id;
--disable_result_log

--connection generation_source_cleanup
DROP TABLE t_generation_claim_source;
DROP USER generation_claim_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;

--connection generation_receiver_root
DROP TABLE t_generation_claim_receiver;
DROP USER preserve_trx_ha_admin@localhost;

--connection generation_source_cleanup
--remove_file $credential_file
--enable_result_log
SELECT 'ok' AS resume_generation_claim_race;
--enable_query_log

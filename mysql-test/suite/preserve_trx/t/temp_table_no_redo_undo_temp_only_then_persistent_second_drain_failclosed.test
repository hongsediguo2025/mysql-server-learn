--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_second_drain(
  sid INT NOT NULL,
  k INT NOT NULL,
  v BIGINT NOT NULL,
  counter INT NOT NULL DEFAULT 0,
  note VARCHAR(96),
  PRIMARY KEY(sid, k),
  UNIQUE KEY uq_sid_note(sid, note),
  KEY idx_sid_v(sid, v)
) ENGINE=InnoDB;

--connect(app,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_temp_second_drain(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_temp_second_drain VALUES(1, 10);
UPDATE tmp_temp_second_drain SET v = 11 WHERE id = 1;

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--connection app
SELECT COUNT(*), COALESCE(SUM(v),0) FROM tmp_temp_second_drain;
REPLACE INTO t_temp_second_drain
  (sid,k,v,counter,note)
VALUES
  (1,100003,10000003,3,'s001-t00001-n003');
COMMIT;
--disconnect app

--connection default
SELECT sid,k,v,counter,note FROM t_temp_second_drain ORDER BY sid,k;

DROP TABLE t_temp_second_drain;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

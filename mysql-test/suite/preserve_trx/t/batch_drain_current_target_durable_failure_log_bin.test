--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_current_durable_log_bin;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_current_durable_log_bin(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_current_durable_log_bin VALUES(1,10);
RESET MASTER;

--connect(batch_current_durable_log_bin_app,localhost,root,,test)
--connection batch_current_durable_log_bin_app
START TRANSACTION;
UPDATE t_batch_current_durable_log_bin SET v=11 WHERE id=1;

--connection default
SET SESSION debug="+d,preserve_trx_fail_after_undo_prepared";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_after_undo_prepared";

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_current_durable_log_bin_app
SELECT * FROM t_batch_current_durable_log_bin ORDER BY id;
COMMIT;
--disconnect batch_current_durable_log_bin_app

--connection default
SELECT * FROM t_batch_current_durable_log_bin ORDER BY id;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/batch_current_durable_log_bin.mysqlbinlog
--let $assert_text= Current target durable failure keeps logged binlog cache committable
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_current_durable_log_bin.mysqlbinlog
--let $assert_select= t_batch_current_durable_log_bin
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= Current target durable failure commits with a nonzero Xid event
--let $assert_file= $MYSQLTEST_VARDIR/tmp/batch_current_durable_log_bin.mysqlbinlog
--let $assert_select= Xid = [1-9][0-9]*
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/batch_current_durable_log_bin.mysqlbinlog

DROP TABLE t_batch_current_durable_log_bin;
SET GLOBAL preserve_trx_enable=ON;

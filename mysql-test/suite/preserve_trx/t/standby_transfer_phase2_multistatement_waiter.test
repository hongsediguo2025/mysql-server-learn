--source suite/preserve_trx/include/phase2_multistatement_setup.inc
--connect(multi_blocker,localhost,phase2_multi_app,,test)
BEGIN;
UPDATE t_phase2_multi SET v=10 WHERE id=1;
--connect(multi_anchor,localhost,phase2_multi_app,,test)
BEGIN;
UPDATE t_phase2_multi SET v=40 WHERE id=4;
SET DEBUG_SYNC='phase2_sched_after_execution_entered SIGNAL multi_anchor_body WAIT_FOR multi_anchor_continue TIMEOUT 30';
--send UPDATE t_phase2_multi SET v=v+1 WHERE id=4
--connection default
SET DEBUG_SYNC='now WAIT_FOR multi_anchor_body TIMEOUT 5';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die anchor did not enter BODY before T0
}
--connect(multi_waiter,localhost,phase2_multi_app,,test)
BEGIN;
UPDATE t_phase2_multi SET v=20 WHERE id=2;
SET DEBUG_SYNC='phase2_sched_after_command_held SIGNAL multi_waiter_next_held';
SET DEBUG_SYNC='lock_wait_will_wait SIGNAL multi_packet_wait';
delimiter ||;
--send
UPDATE t_phase2_multi SET v=v+1 WHERE id=1;
UPDATE t_phase2_multi SET v=900 WHERE id=3; COMMIT||
delimiter ;||
--connection default
SET DEBUG_SYNC='now WAIT_FOR multi_packet_wait TIMEOUT 5';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die first packet statement did not enter lock wait
}
SET DEBUG_SYNC='phase2_sched_after_innodb_support_registered SIGNAL multi_waiter_support';
--send DRAIN TRANSACTIONS PRESERVE
--connection multi_ha
SET DEBUG_SYNC='now WAIT_FOR multi_waiter_support TIMEOUT 10';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die waiter support was not registered
}
--connection multi_blocker
COMMIT;
--connection multi_ha
# The old lock wait has ended, but the next SQL has no support. The still
# executing anchor prevents HARD, so this signal proves an actual SOFT HELD.
SET DEBUG_SYNC='now WAIT_FOR multi_waiter_next_held TIMEOUT 5';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die waiter next statement inherited its preceding BODY admission
}
SET DEBUG_SYNC='now SIGNAL multi_anchor_continue';
--connection multi_waiter
--enable_result_log
--enable_info
--error ER_PRESERVE_TRX_SESSION_DRAINED
--reap
--disable_info
--disable_result_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection multi_anchor
--reap
--connection default
--reap
--connection multi_ha
--let $data_ok= `SELECT (SELECT v=10 FROM t_phase2_multi WHERE id=1) AND (SELECT v=0 FROM t_phase2_multi WHERE id=2) AND (SELECT v=0 FROM t_phase2_multi WHERE id=3)`
if (!$data_ok)
{
  --die waiter executed or committed the rest of its multi-statement packet
}
--source suite/preserve_trx/include/phase2_multistatement_cleanup.inc
--enable_result_log
--echo multi_statement_waiter_next_sql_held_without_support

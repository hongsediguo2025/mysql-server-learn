--perl
use strict;
use warnings;
my $path = $ENV{'MYSQLTEST_VARDIR'} . '/tmp/phase2_protocol_raw_hard.out';
open(my $fh, '<', $path)
  or die "cannot read hard-cutoff output: $!";
my $text = do { local $/; <$fh> };
close($fh);
die "4020 escaped before target-classification handoff"
  if $text =~ /raw_hard_cutoff_complete/;
EOF

--connection protocol_ha
SET DEBUG_SYNC='now SIGNAL protocol_release_targets';
SET DEBUG_SYNC='now WAIT_FOR protocol_before_non_survivor_prune TIMEOUT 10';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die CLOSING did not reach the existing non-survivor prune barrier
}

# Counter/pin completion is only response-release eligibility.  The rejected
# command must finish the complete native dispatch cleanup and reach its next
# real idle boundary before target attach is allowed, while its 4020 remains
# unsent until the existing non-survivor prune succeeds.  PROCESSLIST Sleep is
# the server-side cleanup proof; the raw client below is the response proof.
--let $post_closing_safe_idle= `SELECT COUNT(*) FROM performance_schema.threads WHERE PROCESSLIST_ID=$protocol_post_closing_id AND PROCESSLIST_COMMAND='Sleep'`
if (!$post_closing_safe_idle)
{
  --die native 4020 did not reach the post-dispatch idle boundary before non-survivor prune
}
--perl
use strict;
use warnings;
select(undef, undef, undef, 0.2);
my $path = $ENV{'MYSQLTEST_VARDIR'} . '/tmp/phase2_protocol_raw_hard.out';
open(my $fh, '<', $path)
  or die "cannot read hard-cutoff output: $!";
my $text = do { local $/; <$fh> };
close($fh);
die "HARD-frozen 4020 escaped before non-survivor prune"
  if $text =~ /raw_hard_cutoff_complete/;
EOF

--connection protocol_ha
SET DEBUG_SYNC='now SIGNAL protocol_run_non_survivor_prune';

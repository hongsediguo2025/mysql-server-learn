--connect(protocol_body_wins,localhost,phase2_scheduler_protocol_app,,test)
START TRANSACTION;
UPDATE t_phase2_scheduler_protocol SET v=11 WHERE id=1;
SET DEBUG_SYNC=
  'phase2_sched_after_execution_entered SIGNAL protocol_body_entered WAIT_FOR protocol_release_body TIMEOUT 30';

--connect(protocol_t0_wins,localhost,phase2_scheduler_protocol_app,,test)
START TRANSACTION;
UPDATE t_phase2_scheduler_protocol SET v=21 WHERE id=2;
SET DEBUG_SYNC=
  'phase2_sched_after_command_held SIGNAL protocol_t0_command_held';
SET DEBUG_SYNC=
  'phase2_sched_after_route_null_before_body_cas SIGNAL protocol_admission_ready WAIT_FOR protocol_release_admission TIMEOUT 30';

# This idle transaction sends a new command only after CLOSING is visible.
# Its native 4020 response must wait for the authoritative lifetime-pin
# handoff, even though it never entered the scheduler HELD set.
--connect(protocol_post_closing,localhost,phase2_scheduler_protocol_app,,test)
START TRANSACTION;
UPDATE t_phase2_scheduler_protocol SET v=51 WHERE id=5;
--let $protocol_post_closing_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC=
  'phase2_sched_native_closing_waiting_for_handoff SIGNAL protocol_native_handoff_wait';

--connection protocol_ha
--connection protocol_body_wins
--send UPDATE t_phase2_scheduler_protocol SET v=v+100 WHERE id=1

--connection protocol_ha
SET DEBUG_SYNC='now WAIT_FOR protocol_body_entered TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die command did not win the BODY CAS before scheduler publication
}
--exec echo "execute" > $raw_ps_execute_go
SET DEBUG_SYNC='now WAIT_FOR raw_ps_body_entered TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die prepared statement did not enter BODY before scheduler publication

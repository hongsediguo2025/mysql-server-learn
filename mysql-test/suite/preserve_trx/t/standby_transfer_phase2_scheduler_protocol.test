--connect(protocol_ha,localhost,preserve_trx_ha_admin,phase2-scheduler-protocol-secret,test)

# A native proof UNKNOWN aborts only the scheduler attempt. A BODY command
# keeps running, while a HELD command waits for native admission restoration
# and then executes without inheriting a stale permit.
--connect(protocol_abort_body,localhost,phase2_scheduler_protocol_app,,test)
START TRANSACTION;
UPDATE t_phase2_scheduler_protocol SET v=31 WHERE id=3;
SET DEBUG_SYNC=
  'phase2_sched_after_execution_entered SIGNAL protocol_abort_body_entered WAIT_FOR protocol_release_abort_body TIMEOUT 30';
--send UPDATE t_phase2_scheduler_protocol SET v=v+100 WHERE id=3

--connection protocol_ha
SET DEBUG_SYNC='now WAIT_FOR protocol_abort_body_entered TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die abort anchor did not enter BODY before scheduler publication
}

--connect(protocol_abort_held,localhost,phase2_scheduler_protocol_app,,test)
START TRANSACTION;
UPDATE t_phase2_scheduler_protocol SET v=41 WHERE id=4;
SET DEBUG_SYNC=
  'phase2_sched_after_command_held SIGNAL protocol_abort_command_held';

--connect(protocol_abort_owner,localhost,root,,test)
SET SESSION DEBUG='+d,phase2_sched_force_innodb_unknown';
SET DEBUG_SYNC=
  'phase2_sched_after_t0_registration SIGNAL protocol_abort_t0_registered WAIT_FOR protocol_run_abort_probe TIMEOUT 30';
--send DRAIN TRANSACTIONS PRESERVE

--connection protocol_ha
SET DEBUG_SYNC='now WAIT_FOR protocol_abort_t0_registered TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die abort attempt did not complete T0 registration
}
--exec echo "soft" > $raw_soft_go
--let $grep_file= $raw_output
--let $grep_pattern= raw_abort_soft_done
--let $wait_timeout= 10
--source include/wait_for_pattern_in_file.inc

--connection protocol_abort_held
--send UPDATE t_phase2_scheduler_protocol SET v=v+100 WHERE id=4

--connection protocol_ha
SET DEBUG_SYNC='now WAIT_FOR protocol_abort_command_held TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die abort candidate did not enter HELD
}
SET DEBUG_SYNC='now SIGNAL protocol_run_abort_probe';

--connection protocol_abort_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap

--connection protocol_abort_held
--reap

--connection protocol_ha
SET DEBUG_SYNC='now SIGNAL protocol_release_abort_body';

--connection protocol_abort_body
--reap
COMMIT;
--connection protocol_abort_held
COMMIT;

--connection protocol_ha
--exec echo "restore" > $raw_restore_go
--let $grep_file= $raw_output
--let $grep_pattern= raw_abort_long_data_complete
--let $wait_timeout= 10
--source include/wait_for_pattern_in_file.inc

--connection protocol_ha
SELECT SUM(v)=272 AS native_admission_restored
  FROM t_phase2_scheduler_protocol WHERE id IN (3,4);
SELECT HEX(payload)=HEX('phase2-long-data') AS long_data_preserved
  FROM t_phase2_scheduler_protocol WHERE id=3;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=2000;


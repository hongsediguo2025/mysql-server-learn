--connect(protocol_receiver,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'phase2-scheduler-protocol-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
GRANT PROCESS ON *.* TO preserve_trx_ha_admin@localhost;

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS phase2_scheduler_protocol_app@localhost;
DROP TABLE IF EXISTS t_phase2_scheduler_protocol;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'phase2-scheduler-protocol-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER phase2_scheduler_protocol_app@localhost;
GRANT SELECT, INSERT, UPDATE ON test.*
  TO phase2_scheduler_protocol_app@localhost;
GRANT SESSION_VARIABLES_ADMIN ON *.*
  TO phase2_scheduler_protocol_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-standby-phase2-scheduler-mode=DEPENDENCY_CONVERGENCE_V1 --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_2 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=phase2_scheduler_protocol --rds-preserve-trx-transfer-credential-secret-file=$credential_file --rds-preserve-trx-drain-phase1-timeout-ms=10000 --rds-preserve-trx-drain-phase2-timeout-ms=10000
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

SELECT @@GLOBAL.rds_preserve_trx_standby_phase2_scheduler_mode
  AS dependency_mode;

--connection default
CREATE TABLE t_phase2_scheduler_protocol(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  payload VARBINARY(128) NOT NULL DEFAULT ''
) ENGINE=InnoDB;
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(1,10);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(2,20);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(3,30);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(4,40);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(5,50);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(6,60);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(7,70);
INSERT INTO t_phase2_scheduler_protocol(id,v) VALUES(8,80);

--let $raw_ready= $MYSQLTEST_VARDIR/tmp/phase2_protocol_raw_ready
--let $raw_soft_go= $MYSQLTEST_VARDIR/tmp/phase2_protocol_raw_soft_go

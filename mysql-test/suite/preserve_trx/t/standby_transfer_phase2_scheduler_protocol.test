--exec_in_background perl $MYSQL_TEST_DIR/suite/preserve_trx/include/phase2_scheduler_raw_protocol_client.pl $SERVER_MYSOCK_1 abort_long_data $raw_ready $raw_soft_go $raw_soft_done $raw_restore_go >> $raw_output 2>&1

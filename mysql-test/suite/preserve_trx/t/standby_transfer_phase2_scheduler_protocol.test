--connect(protocol_owner,localhost,root,,test)
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_phase1_binlog_stream SIGNAL protocol_phase1_streamed WAIT_FOR protocol_phase1_release';
SET DEBUG_SYNC=
  'phase2_sched_after_publish_before_t0 SIGNAL protocol_route_published';
SET DEBUG_SYNC=
  'phase2_sched_after_t0_claim_before_register SIGNAL protocol_t0_claimed WAIT_FOR protocol_release_t0_claim TIMEOUT 30';
SET DEBUG_SYNC=
  'phase2_sched_after_t0_executing_registered SIGNAL protocol_body_registered';
SET DEBUG_SYNC=
  'phase2_sched_after_t0_registration SIGNAL protocol_t0_registered WAIT_FOR protocol_begin_hard TIMEOUT 30';
SET DEBUG_SYNC=
  'phase2_sched_after_hard_published SIGNAL protocol_hard_published WAIT_FOR protocol_release_hard TIMEOUT 30';
SET DEBUG_SYNC=
  'phase2_sched_after_authoritative_counter_before_handoff_pins SIGNAL protocol_counter_classified WAIT_FOR protocol_release_handoff_pins TIMEOUT 30';
SET DEBUG_SYNC=
  'preserve_trx_warmcopy_after_targets_classified SIGNAL protocol_targets_classified WAIT_FOR protocol_release_targets TIMEOUT 30';
SET DEBUG_SYNC=
  'preserve_trx_batch_after_targets_quiesced_before_attach SIGNAL protocol_before_non_survivor_prune WAIT_FOR protocol_run_non_survivor_prune TIMEOUT 30';
--send DRAIN TRANSACTIONS PRESERVE

--connection protocol_ha
SET DEBUG_SYNC='now WAIT_FOR protocol_phase1_streamed TIMEOUT 30';
SET @phase1_frame_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_frame_count');
SET @phase1_send_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_network_send_count');
SET @phase1_batch_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_batch_count');
--let $assert_text= Phase1 transport metrics are nonzero before dependency scheduling
--let $assert_cond= `SELECT @phase1_frame_before>0 AND @phase1_send_before>0 AND @phase1_batch_before>0`
--source include/assert.inc
--disable_result_log
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--enable_result_log
--let $assert_text= rejected nested drain does not reset Phase1 transport metrics
--let $assert_cond= `SELECT @phase1_frame_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_frame_count') AND @phase1_send_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_network_send_count') AND @phase1_batch_before=(SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_phase1_batch_count')`
--source include/assert.inc
SET DEBUG_SYNC='now SIGNAL protocol_phase1_release';

SET DEBUG_SYNC='now WAIT_FOR protocol_route_published TIMEOUT 2';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die dependency scheduler route was not published before T0
}
SET DEBUG_SYNC='now WAIT_FOR protocol_t0_claimed TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die T0 did not claim the command paused before BODY
}
SET DEBUG_SYNC='now SIGNAL protocol_release_admission';
SET DEBUG_SYNC='now SIGNAL protocol_release_t0_claim';
SET DEBUG_SYNC='now WAIT_FOR protocol_t0_registered TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die dependency scheduler did not complete T0 registration
}
--exec echo "soft" > $raw_hard_soft_go
SET DEBUG_SYNC='now WAIT_FOR raw_hard_fetch_held TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die raw COM_STMT_FETCH did not enter HELD
}
SET DEBUG_SYNC='now WAIT_FOR protocol_body_registered TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die T0 did not retain the command that already entered BODY
}
SET DEBUG_SYNC='now WAIT_FOR protocol_t0_command_held TIMEOUT 5';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die T0-claimed command did not remain HELD before HARD
}
SET DEBUG_SYNC='now SIGNAL protocol_begin_hard';
SET DEBUG_SYNC='now WAIT_FOR protocol_hard_published TIMEOUT 10';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die dependency scheduler did not publish deadline HARD with BODY active
}
SET DEBUG_SYNC='now SIGNAL raw_release_ps_body';
SET DEBUG_SYNC='now SIGNAL protocol_release_body';
--let $grep_file= $raw_ps_output
--let $grep_pattern= raw_ps_body_error_complete
--let $wait_timeout= 10
--source include/wait_for_pattern_in_file.inc

# HARD freezes the command as CUTOFF, but the response must remain private
# until CLOSING has taken the authoritative target snapshot. Otherwise a
# 4020-triggered client disconnect can change the target set being captured.
--perl
use strict;
use warnings;
select(undef, undef, undef, 0.2);
my $path = $ENV{'MYSQLTEST_VARDIR'} . '/tmp/phase2_protocol_raw_hard.out';
open(my $fh, '<', $path)
  or die "cannot read hard-cutoff output: $!";
my $text = do { local $/; <$fh> };
close($fh);
die "HARD exposed 4020 before CLOSING target snapshot"
  if $text =~ /raw_hard_cutoff_complete/;
EOF

--connection protocol_ha
SET DEBUG_SYNC='now SIGNAL protocol_release_hard';
SET DEBUG_SYNC='now WAIT_FOR protocol_counter_classified TIMEOUT 10';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die CLOSING did not finish its authoritative target counter
}

--connection protocol_post_closing
--send SELECT v FROM t_phase2_scheduler_protocol WHERE id=5

--connection protocol_ha
SET DEBUG_SYNC='now WAIT_FOR protocol_native_handoff_wait TIMEOUT 10';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die post-CLOSING native command did not wait for the handoff barrier
}
SET DEBUG_SYNC='now SIGNAL protocol_release_handoff_pins';
SET DEBUG_SYNC='now WAIT_FOR protocol_targets_classified TIMEOUT 10';
--let $sync_warning_count= `SELECT @@warning_count`
if ($sync_warning_count)
{
  --die CLOSING did not complete authoritative target classification

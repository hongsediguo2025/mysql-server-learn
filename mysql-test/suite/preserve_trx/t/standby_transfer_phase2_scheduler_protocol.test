--connection protocol_t0_wins
--error ER_PRESERVE_TRX_SESSION_DRAINED
--reap

--connection protocol_body_wins
--reap
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT * FROM t_phase2_scheduler_protocol;

--connection protocol_owner
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
--reap

--let _PHASE2_FINAL_LOG= $MYSQLTEST_VARDIR/log/mysqld.1.err
--perl
use strict;
use warnings;

open(my $fh, '<', $ENV{'_PHASE2_FINAL_LOG'})
  or die "cannot read source error log: $!";
my @records;
while (my $line = <$fh>) {
  @records = () if $line =~
      /CURRENT_TEST: preserve_trx\.standby_transfer_phase2_scheduler_protocol/;
  push @records, $line if $line =~ /PRESERVE_PHASE2_FINAL_V1 /;
}
close($fh);
die "expected one abort and one deadline final record" unless @records == 2;
my @field = map { +{ /([a-z0-9_]+)=([^\s]+)/g } } @records;
die "safety-abort final record is inconsistent"
  unless ($field[0]{'attempt_id'} // 0) == 1 &&
         ($field[0]{'generation'} // 0) == 1 &&
         ($field[0]{'scheduler_terminal_result'} // '') eq 'SAFETY_ABORT' &&
         ($field[0]{'hard_published_us'} // 1) == 0 &&
         ($field[0]{'final_ack_us'} // 1) == 0 &&
         ($field[0]{'last_body_exit_state'} // '') eq
             'COVERAGE_INCOMPLETE' &&
         ($field[0]{'eligible_body_count'} // 0) > 0 &&
         ($field[0]{'tail_fallback_used'} // 1) == 0;
die "deadline-HARD final record is inconsistent"
  unless ($field[1]{'attempt_id'} // 0) == 2 &&
         ($field[1]{'generation'} // 0) == 2 &&
         ($field[1]{'scheduler_terminal_result'} // '') eq 'HARD_DEADLINE' &&
         ($field[1]{'hard_published_us'} // 0) > 0 &&
         ($field[1]{'closing_published_us'} // 0) >=
             $field[1]{'hard_published_us'} &&
         ($field[1]{'final_ack_us'} // 0) >=
             $field[1]{'closing_published_us'} &&
         ($field[1]{'last_body_exit_state'} // '') eq
             'COVERAGE_INCOMPLETE' &&
         ($field[1]{'exact_body_exit_coverage_complete'} // 1) == 0 &&
         ($field[1]{'last_command_end_missing'} // 0) == 1 &&
         ($field[1]{'tail_fallback_used'} // 1) == 0;
EOF
--let _PHASE2_FINAL_LOG=


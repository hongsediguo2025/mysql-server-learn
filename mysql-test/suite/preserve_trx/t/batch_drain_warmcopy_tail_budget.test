--source include/have_debug_sync.inc
--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_tail;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=8;

CREATE TABLE t_warmcopy_tail(id INT PRIMARY KEY, payload VARBINARY(1024))
  ENGINE=InnoDB;
INSERT INTO t_warmcopy_tail VALUES(1,REPEAT('a',512));

--connect(warmcopy_tail_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_tail SET payload=REPEAT('b',512) WHERE id=1;

--connect(warmcopy_tail_owner, localhost, root,,test)
--connection warmcopy_tail_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_tail_hwm WAIT_FOR warmcopy_tail_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_tail_hwm TIMEOUT 10';
--let $prefix_bytes= `SELECT COALESCE((SELECT CAST(VARIABLE_VALUE AS SIGNED) FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_warmcopy_prefix_bytes'), -1)`
--let $assert_text= warm-copy tail-budget test has an admitted prebuilt prefix before tail update
--let $assert_cond= $prefix_bytes > 0
--source include/assert.inc
--connection warmcopy_tail_app
UPDATE t_warmcopy_tail SET payload=REPEAT('c',1024) WHERE id=1;
SET DEBUG_SYNC = 'RESET';
--connection default
SET DEBUG_SYNC = 'now SIGNAL warmcopy_tail_continue';

--connection warmcopy_tail_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--disconnect warmcopy_tail_owner

--connection warmcopy_tail_app
COMMIT;
--disconnect warmcopy_tail_app

--connection default
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT OCTET_LENGTH(payload) AS payload_len FROM t_warmcopy_tail;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_warmcopy_tail;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET DEBUG_SYNC = 'RESET';

--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_non_row_preserve_preflight;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_non_row_preserve_preflight(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_non_row_preserve_preflight VALUES(1,10),(2,20);

--connect(non_row_batch_target,localhost,root,,test)
SET SESSION binlog_format=STATEMENT;
START TRANSACTION;
UPDATE t_non_row_preserve_preflight SET v=21 WHERE id=2;

--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

--connection non_row_batch_target
UPDATE t_non_row_preserve_preflight SET v=22 WHERE id=2;
ROLLBACK;
--disconnect non_row_batch_target

--connection default
SELECT * FROM t_non_row_preserve_preflight ORDER BY id;
DROP TABLE t_non_row_preserve_preflight;

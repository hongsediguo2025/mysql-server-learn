--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_non_row_preserve_preflight;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_drain_mode=HARD;

CREATE TABLE t_non_row_preserve_preflight(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_non_row_preserve_preflight VALUES(1,10),(2,20);

--connect(non_row_blocker,localhost,root,,test)
--let $blocker_conn_id= `SELECT CONNECTION_ID()`
START TRANSACTION;
UPDATE t_non_row_preserve_preflight SET v=21 WHERE id=2;

--connect(non_row_owner,localhost,root,,test)
SET SESSION binlog_format=STATEMENT;
START TRANSACTION;
UPDATE t_non_row_preserve_preflight SET v=11 WHERE id=1;
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ROLLBACK;
--disconnect non_row_owner

--connection default
--replace_result $blocker_conn_id BLOCKER_ID
--eval SELECT COUNT(*) AS blocker_thread_count FROM performance_schema.threads WHERE PROCESSLIST_ID = $blocker_conn_id

--connection non_row_blocker
UPDATE t_non_row_preserve_preflight SET v=22 WHERE id=2;
ROLLBACK;
--disconnect non_row_blocker

--connect(non_row_batch_target,localhost,root,,test)
SET SESSION binlog_format=STATEMENT;
START TRANSACTION;
UPDATE t_non_row_preserve_preflight SET v=21 WHERE id=2;

--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

--connection non_row_batch_target
UPDATE t_non_row_preserve_preflight SET v=22 WHERE id=2;
ROLLBACK;
--disconnect non_row_batch_target

--connection default
SELECT * FROM t_non_row_preserve_preflight ORDER BY id;
DROP TABLE t_non_row_preserve_preflight;
SET GLOBAL preserve_trx_drain_mode=SOFT;

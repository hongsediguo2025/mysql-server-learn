--disable_warnings
DROP TABLE IF EXISTS xa_keep;
--enable_warnings

CREATE TABLE xa_keep(a INT PRIMARY KEY) ENGINE=InnoDB;

XA START 'normal_xa';
INSERT INTO xa_keep VALUES(1);
XA END 'normal_xa';
XA PREPARE 'normal_xa';
XA RECOVER;
XA ROLLBACK 'normal_xa';

SELECT COUNT(*) AS rows_after_rollback FROM xa_keep;

--error ER_XAER_INVAL
XA START X'4d53505f50524553', X'746f6b656e', 1836281843;

--error ER_XAER_INVAL
XA PREPARE X'4d53505f50524553', X'746f6b656e', 1836281843;

--error ER_XAER_NOTA
XA COMMIT X'4d53505f50524553', X'746f6b656e', 1836281843;

DROP TABLE xa_keep;

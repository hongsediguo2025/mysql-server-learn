--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_snapshot_bin_symlink_reject;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted: startup snapshot is unreadable or mismatched");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_snapshot_bin_symlink_reject(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_snapshot_bin_symlink_reject VALUES(1,10);

START TRANSACTION;
UPDATE t_snapshot_bin_symlink_reject SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');
my @snapshots = PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
die "expected one snapshot" unless @snapshots == 1;
my $snapshot = $snapshots[0];
my (undef, $snapshot_dir, undef) = File::Spec->splitpath($snapshot);
my $real = File::Spec->catfile($snapshot_dir, 'snapshot-bin-real');
rename($snapshot, $real) or die "cannot rename snapshot: $!";
symlink($real, $snapshot) or die "cannot create snapshot symlink: $!";
print "snapshot bin symlink installed\n";
EOF

--echo # restart: --rds-preserve-trx-enable=ON --skip-log-bin
--exec echo "restart: --rds-preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted: startup snapshot is unreadable or mismatched
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_snapshot_symlink
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_snapshot_bin_symlink_reject ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_snapshot_bin_symlink_reject;

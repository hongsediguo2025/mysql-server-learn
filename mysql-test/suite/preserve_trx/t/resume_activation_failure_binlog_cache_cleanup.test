--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_activation_binlog;
--enable_warnings

--let $MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction resume failed to activate prepared undo state");
--enable_query_log

CREATE TABLE t_resume_activation_binlog(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_resume_activation_binlog VALUES(1,10),(2,20);
SET SESSION sql_log_bin=1;
RESET MASTER;

--let $server_uuid= `SELECT @@GLOBAL.SERVER_UUID`
--replace_result $server_uuid SERVER_UUID
--eval SET GTID_NEXT='$server_uuid:7'
START TRANSACTION;
UPDATE t_resume_activation_binlog SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION debug="+d,preserve_trx_fail_activate_resumed";

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SET SESSION debug="-d,preserve_trx_fail_activate_resumed";

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
SELECT @@SESSION.GTID_NEXT AS gtid_next_after_failed_resume;
SET GTID_NEXT=AUTOMATIC;
SELECT * FROM t_resume_activation_binlog WHERE a=1;

START TRANSACTION;
UPDATE t_resume_activation_binlog SET b=12 WHERE a=2;
COMMIT;
SELECT * FROM t_resume_activation_binlog ORDER BY a;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/resume_activation_binlog_cleanup.mysqlbinlog
--let $assert_text= New transaction remains in binlog after activation failure cleanup
--let $assert_file= $MYSQLTEST_VARDIR/tmp/resume_activation_binlog_cleanup.mysqlbinlog
--let $assert_select= @2=12
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_text= Rolled back activation failure transaction is discarded from imported binlog cache
--let $assert_file= $MYSQLTEST_VARDIR/tmp/resume_activation_binlog_cleanup.mysqlbinlog
--let $assert_select= @2=11
--let $assert_count_condition= == 0
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/resume_activation_binlog_cleanup.mysqlbinlog

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
SET GTID_NEXT=AUTOMATIC;

SET SESSION sql_log_bin=0;
DROP TABLE t_resume_activation_binlog;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

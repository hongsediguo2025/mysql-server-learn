--disable_warnings
DROP TABLE IF EXISTS t_standby_transfer_reject;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_standby_transfer_reject(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO t_standby_transfer_reject VALUES(1,10);
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ROLLBACK;

SELECT COUNT(*) FROM t_standby_transfer_reject;

DROP TABLE t_standby_transfer_reject;
SET GLOBAL preserve_trx_enable=ON;

--error ER_SPECIFIC_ACCESS_DENIED_ERROR
RESET DRAIN;
CREATE USER preserve_trx_ha_admin@localhost;
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
--connect(preserve_trx_ha_admin_con, localhost, preserve_trx_ha_admin,,test)
RESET DRAIN;
--disconnect preserve_trx_ha_admin_con
--connection default

SELECT @@GLOBAL.preserve_trx_transfer_receiver_prewarm_timeout_ms;
SELECT @@GLOBAL.preserve_trx_token_retention_timeout_ms;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=1000;
SET GLOBAL preserve_trx_token_retention_timeout_ms=3600000;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_prewarm_timeout_ms;
SELECT @@GLOBAL.preserve_trx_token_retention_timeout_ms;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=999;
SHOW WARNINGS;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_prewarm_timeout_ms;
SET GLOBAL preserve_trx_token_retention_timeout_ms=3600001;
SHOW WARNINGS;
SELECT @@GLOBAL.preserve_trx_token_retention_timeout_ms;
--error ER_GLOBAL_VARIABLE
SET SESSION preserve_trx_transfer_receiver_prewarm_timeout_ms=1000;
--error ER_GLOBAL_VARIABLE
SET SESSION preserve_trx_token_retention_timeout_ms=1000;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=10000;
SET GLOBAL preserve_trx_token_retention_timeout_ms=30000;

SHOW GLOBAL STATUS LIKE 'Preserve_trx_reset_drain_wins';
SHOW GLOBAL STATUS LIKE 'Preserve_trx_reset_drain_too_late';
SHOW GLOBAL STATUS LIKE 'Preserve_trx_transfer_receiver_active_epochs';
SHOW GLOBAL STATUS LIKE 'Preserve_trx_transfer_receiver_expired_epochs';

--source include/force_restart.inc
--let $restart_parameters= restart: --preserve-trx-enable=OFF
--source include/restart_mysqld.inc
--let $restart_parameters=

--connect(preserve_trx_ha_admin_off_con, localhost, preserve_trx_ha_admin,,test)
RESET DRAIN;
--disconnect preserve_trx_ha_admin_off_con
--connection default

--let $restart_parameters= restart: --preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

--connect(preserve_trx_ha_admin_tx_con, localhost, preserve_trx_ha_admin,,test)
START TRANSACTION;
SAVEPOINT ha_reset_guard;
RESET DRAIN;
ROLLBACK TO SAVEPOINT ha_reset_guard;
ROLLBACK;
--disconnect preserve_trx_ha_admin_tx_con
--connection default

CREATE USER preserve_reset_denied@localhost;
GRANT SHUTDOWN ON *.* TO preserve_reset_denied@localhost;
--connect(preserve_reset_denied_con, localhost, preserve_reset_denied,,test)
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
RESET DRAIN;
--disconnect preserve_reset_denied_con
--connection default
DROP USER preserve_reset_denied@localhost;
DROP USER preserve_trx_ha_admin@localhost;

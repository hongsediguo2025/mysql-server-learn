RESET DRAIN;

SELECT @@GLOBAL.preserve_trx_transfer_receiver_prewarm_timeout_ms;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_ready_timeout_ms;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=1000;
SET GLOBAL preserve_trx_transfer_receiver_ready_timeout_ms=3600000;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_prewarm_timeout_ms;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_ready_timeout_ms;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=999;
SHOW WARNINGS;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_prewarm_timeout_ms;
SET GLOBAL preserve_trx_transfer_receiver_ready_timeout_ms=3600001;
SHOW WARNINGS;
SELECT @@GLOBAL.preserve_trx_transfer_receiver_ready_timeout_ms;
--error ER_GLOBAL_VARIABLE
SET SESSION preserve_trx_transfer_receiver_prewarm_timeout_ms=1000;
--error ER_GLOBAL_VARIABLE
SET SESSION preserve_trx_transfer_receiver_ready_timeout_ms=1000;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=10000;
SET GLOBAL preserve_trx_transfer_receiver_ready_timeout_ms=30000;

SHOW GLOBAL STATUS LIKE 'Preserve_trx_reset_drain_wins';
SHOW GLOBAL STATUS LIKE 'Preserve_trx_reset_drain_too_late';
SHOW GLOBAL STATUS LIKE 'Preserve_trx_transfer_receiver_active_epochs';
SHOW GLOBAL STATUS LIKE 'Preserve_trx_transfer_receiver_expired_epochs';


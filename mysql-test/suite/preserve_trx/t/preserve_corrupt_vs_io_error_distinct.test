--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_read_error_distinct;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery failed: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery deferred cleanup: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery failed: I/O error reading durable transaction snapshot");
CALL mtr.add_suppression("\\[FATAL\\] Preserved transaction preflight failed before InnoDB recovery could proceed");
CALL mtr.add_suppression("Plugin initialization aborted at srv0start.cc.* with error Generic error");
CALL mtr.add_suppression("Failed to initialize DD Storage Engine");
CALL mtr.add_suppression("Data Dictionary initialization failed");
CALL mtr.add_suppression("Assertion failure: ha_innodb.cc:.*ib::fatal triggered");
CALL mtr.add_suppression("\\[FATAL\\] Error in DDL Log recovery during Post-Recovery processing");
CALL mtr.add_suppression("Assertion failure: ut0ut.cc:.*");
CALL mtr.add_suppression("Aborting");
CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
--enable_query_log

CREATE TABLE t_preserve_read_error_distinct(
  a INT PRIMARY KEY,
  b INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_read_error_distinct VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_preserve_read_error_distinct SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--perl
use strict;
use warnings;
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
opendir(my $dh, $dir) or die "cannot open preserve dir: $dir: $!";
my @snapshots = grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected one preserved snapshot in $dir, found " . scalar(@snapshots) . "\n"
  unless scalar(@snapshots) == 1;
my $snapshot = File::Spec->catfile($dir, $snapshots[0]);
open(my $corrupt, '+<', $snapshot) or die "cannot corrupt snapshot: $!";
binmode($corrupt);
print {$corrupt} "CORRUPT!";
close($corrupt);
EOF

--echo # restart: --preserve-trx-enable=ON --skip-log-bin
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc

SELECT COUNT(*) AS preserved_count_after_corrupt_read
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_preserve_read_error_distinct WHERE a=1;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

START TRANSACTION;
UPDATE t_preserve_read_error_distinct SET b=21 WHERE a=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
--source include/wait_until_disconnected.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= --preserve-trx-enable=ON --skip-log-bin --debug=d,preserve_trx_fail_snapshot_read_io
--source include/start_mysqld_expecting_crash.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= Preserved transaction .* recovery failed: I/O error reading durable transaction snapshot
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/wait_for_expected_crash.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

SELECT * FROM t_preserve_read_error_distinct ORDER BY a;

DROP TABLE t_preserve_read_error_distinct;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_log_bin.inc
--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_single_phase_pending_rows;
--enable_warnings

--let $old_rds_preserve_trx_enable= `SELECT @@GLOBAL.rds_preserve_trx_enable`

SET GLOBAL rds_preserve_trx_enable=ON;

CREATE TABLE t_single_phase_pending_rows(
  id INT PRIMARY KEY,
  payload VARCHAR(1200)
) ENGINE=InnoDB;
INSERT INTO t_single_phase_pending_rows VALUES
  (1,'before'), (2,'before'), (3,'before'), (4,'before'), (5,'before'),
  (6,'before'), (7,'before'), (8,'before'), (9,'before'), (10,'before'),
  (11,'before'), (12,'before'), (13,'before'), (14,'before'), (15,'before'),
  (16,'before'), (17,'before'), (18,'before'), (19,'before'), (20,'before');
RESET MASTER;

SELECT COUNT(*) AS status_counter_exists
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_warmcopy_provider_full_copy_to_count';
--let $full_copy_before= `SELECT CAST(VARIABLE_VALUE AS SIGNED) FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_warmcopy_provider_full_copy_to_count'`

--connect(single_phase_pending_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_single_phase_pending_rows
  SET payload=CONCAT(REPEAT('p',1000), '-', id);

--connection default
SET DEBUG='+d,preserve_trx_fail_flush_pending_rows_event';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG='-d,preserve_trx_fail_flush_pending_rows_event';
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--let $full_copy_after= `SELECT CAST(VARIABLE_VALUE AS SIGNED) FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_warmcopy_provider_full_copy_to_count'`
--disable_query_log
--eval SET @single_phase_full_copy_delta=$full_copy_after - $full_copy_before
--enable_query_log
SELECT @single_phase_full_copy_delta AS full_copy_delta;

--connection single_phase_pending_app
COMMIT;
--disconnect single_phase_pending_app

--connection default
SELECT COUNT(*) AS changed_rows
  FROM t_single_phase_pending_rows
 WHERE payload = CONCAT(REPEAT('p',1000), '-', id);

DROP TABLE t_single_phase_pending_rows;
--disable_query_log
--eval SET GLOBAL rds_preserve_trx_enable=$old_rds_preserve_trx_enable
--enable_query_log

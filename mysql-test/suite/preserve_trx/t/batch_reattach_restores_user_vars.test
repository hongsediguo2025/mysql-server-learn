--source include/have_debug.inc
--source include/not_log_bin.inc

CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");

--disable_warnings
DROP TABLE IF EXISTS t_batch_reattach_user_vars;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_reattach_user_vars(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_reattach_user_vars_a,localhost,root,,test)
--connection batch_reattach_user_vars_a
SET @batch_preserved_only = 'target-a-preserved';
SET @batch_overlap_user_var = 'target-a-overlap';
START TRANSACTION;
INSERT INTO t_batch_reattach_user_vars VALUES(1,10);

--connect(batch_reattach_user_vars_b,localhost,root,,test)
--connection batch_reattach_user_vars_b
SET @batch_preserved_only = 'target-b-preserved';
SET @batch_overlap_user_var = 'target-b-overlap';
START TRANSACTION;
INSERT INTO t_batch_reattach_user_vars VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target,preserve_trx_batch_clear_user_vars_before_reattach_restore";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target,preserve_trx_batch_clear_user_vars_before_reattach_restore";

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection batch_reattach_user_vars_a
SELECT @batch_preserved_only AS target_a_preserved_only,
       @batch_overlap_user_var AS target_a_overlap_user_var;
ROLLBACK;
--disconnect batch_reattach_user_vars_a

--connection batch_reattach_user_vars_b
SELECT @batch_preserved_only AS target_b_preserved_only,
       @batch_overlap_user_var AS target_b_overlap_user_var;
ROLLBACK;
--disconnect batch_reattach_user_vars_b

--connection default
SELECT * FROM t_batch_reattach_user_vars ORDER BY id;

DROP TABLE t_batch_reattach_user_vars;
SET GLOBAL preserve_trx_enable=ON;

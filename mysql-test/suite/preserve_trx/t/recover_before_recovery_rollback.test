--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_before_rollback;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recover_before_rollback(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_before_rollback VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recover_before_rollback WHERE a=1 FOR UPDATE;
UPDATE t_recover_before_rollback SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --debug=d,preserve_trx_assert_recovered_before_recovery_rollback" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= PRESERVE: preserved transactions recovered before recovery rollback can observe them;
--source include/search_pattern.inc

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--error 1
--file_exists $PRESERVED_SNAPSHOT_FILE

COMMIT;
SELECT * FROM t_recover_before_rollback ORDER BY a;

DROP TABLE t_recover_before_rollback;
SET GLOBAL preserve_trx_enable=ON;

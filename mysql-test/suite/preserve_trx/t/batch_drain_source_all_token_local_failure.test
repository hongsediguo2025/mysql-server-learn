--source include/have_debug.inc
--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/source-all-token-local-failure-v1.secret
--write_file $credential_file
source-all-token-local-failure-v1-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS source_all_token_local_v1_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'source-all-token-local-failure-v1-secret';
GRANT SHUTDOWN, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER source_all_token_local_v1_app@localhost;
GRANT SELECT, UPDATE ON test.* TO source_all_token_local_v1_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=source_all_token_local_failure_v1 --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;

CREATE TABLE t_source_all_token_local_failure_v1(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_source_all_token_local_failure_v1 VALUES(1,10);

--connect(source_all_local_v1_ha,localhost,preserve_trx_ha_admin,source-all-token-local-failure-v1-secret,test)
--connect(source_all_local_v1_app,localhost,source_all_token_local_v1_app,,test)
--let $app_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_source_all_token_local_failure_v1 SET v=11 WHERE id=1;

--connection source_all_local_v1_ha
SET GLOBAL debug='+d,preserve_trx_early_fail_candidate_finalize';

--connection default
--replace_result $app_id APP_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection source_all_local_v1_ha
SET GLOBAL debug='-d,preserve_trx_early_fail_candidate_finalize';
SELECT VARIABLE_VALUE=0 AS no_receiver_epoch
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs';
SELECT VARIABLE_VALUE=0 AS no_receiver_token
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_inflight_tokens';

--connection source_all_local_v1_app
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;

--connection source_all_local_v1_ha
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

--connect(source_all_local_v1_cleanup,localhost,root,,test)
SELECT v FROM t_source_all_token_local_failure_v1;
DROP TABLE t_source_all_token_local_failure_v1;
DROP USER source_all_token_local_v1_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
--remove_file $credential_file

--enable_query_log

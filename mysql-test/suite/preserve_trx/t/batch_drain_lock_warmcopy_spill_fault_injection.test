--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_warmcopy_spill_fault;
--enable_warnings

--let $old_preserve_trx_enable= `SELECT @@GLOBAL.preserve_trx_enable`
--let $old_preserve_trx_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_enable= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_enable`
--let $old_preserve_trx_lock_warmcopy_fallback= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export`
--let $old_preserve_trx_lock_warmcopy_max_memory_bytes= `SELECT @@GLOBAL.preserve_trx_lock_warmcopy_max_memory_bytes`
--let $old_preserve_trx_recovery_max_count= `SELECT @@GLOBAL.preserve_trx_recovery_max_count`

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_max_memory_bytes=1;
SET GLOBAL preserve_trx_recovery_max_count=10;

CREATE TABLE t_lock_warmcopy_spill_fault(
  id INT PRIMARY KEY,
  v INT,
  pad VARBINARY(128)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_spill_fault VALUES(1,10,REPEAT('a',64));

--connect(lock_wc_spill_fault_strict_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=11, pad=REPEAT('b',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_force_spill_failure';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= lock warmcopy spill failure is logged
--let $assert_select= PRESERVE_LOCK_WARMCOPY.*action=spill_failure.*reason=resource_limit_exceeded
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
SELECT VARIABLE_NAME, CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS positive
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME IN (
    'Preserve_trx_lock_warmcopy_attempts',
    'Preserve_trx_lock_warmcopy_resource_limit',
    'Preserve_trx_lock_warmcopy_sealed_invalid',
    'Preserve_trx_lock_warmcopy_spill_failures',
    'Preserve_trx_lock_warmcopy_strict_reject')
  ORDER BY VARIABLE_NAME;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_force_spill_failure';

--connection lock_wc_spill_fault_strict_app
ROLLBACK;
--disconnect lock_wc_spill_fault_strict_app

--connection default
--connect(lock_wc_spill_segment_short_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=15, pad=REPEAT('f',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_after_tmp_short_write';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_after_tmp_short_write';

--connection lock_wc_spill_segment_short_app
ROLLBACK;
--disconnect lock_wc_spill_segment_short_app

--connection default
--connect(lock_wc_spill_segment_fsync_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=16, pad=REPEAT('g',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_segment_fsync_failure';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_segment_fsync_failure';

--connection lock_wc_spill_segment_fsync_app
ROLLBACK;
--disconnect lock_wc_spill_segment_fsync_app

--connection default
--connect(lock_wc_spill_segment_rename_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=17, pad=REPEAT('h',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_after_tmp_write_before_rename';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_after_tmp_write_before_rename';

--connection lock_wc_spill_segment_rename_app
ROLLBACK;
--disconnect lock_wc_spill_segment_rename_app

--connection default
--connect(lock_wc_spill_segment_dirsync_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=18, pad=REPEAT('i',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_parent_dir_fsync_failure';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_parent_dir_fsync_failure';

--connection lock_wc_spill_segment_dirsync_app
ROLLBACK;
--disconnect lock_wc_spill_segment_dirsync_app

--connection default
--connect(lock_wc_spill_manifest_strict_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=13, pad=REPEAT('d',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_manifest_short_write';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT VARIABLE_NAME, CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS positive
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME IN (
    'Preserve_trx_lock_warmcopy_resource_limit',
    'Preserve_trx_lock_warmcopy_sealed_invalid',
    'Preserve_trx_lock_warmcopy_spill_failures',
    'Preserve_trx_lock_warmcopy_strict_reject')
  ORDER BY VARIABLE_NAME;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_manifest_short_write';

--connection lock_wc_spill_manifest_strict_app
ROLLBACK;
--disconnect lock_wc_spill_manifest_strict_app

--connection default
--connect(lock_wc_spill_manifest_fsync_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=19, pad=REPEAT('j',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_manifest_fsync_failure';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_manifest_fsync_failure';

--connection lock_wc_spill_manifest_fsync_app
ROLLBACK;
--disconnect lock_wc_spill_manifest_fsync_app

--connection default
--connect(lock_wc_spill_manifest_rename_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=20, pad=REPEAT('k',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_manifest_before_rename';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_manifest_before_rename';

--connection lock_wc_spill_manifest_rename_app
ROLLBACK;
--disconnect lock_wc_spill_manifest_rename_app

--connection default
--connect(lock_wc_spill_manifest_dirsync_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=21, pad=REPEAT('l',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_manifest_parent_dir_fsync_failure';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_manifest_parent_dir_fsync_failure';

--connection lock_wc_spill_manifest_dirsync_app
ROLLBACK;
--disconnect lock_wc_spill_manifest_dirsync_app

--connection default
--connect(lock_wc_spill_orphan_cleanup_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=14, pad=REPEAT('e',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_orphan_cleanup_failure';
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug='-d,preserve_trx_lock_warmcopy_spill_orphan_cleanup_failure';

--connection lock_wc_spill_orphan_cleanup_app
ROLLBACK;
--disconnect lock_wc_spill_orphan_cleanup_app

--connection default
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;

--connect(lock_wc_spill_fault_fallback_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_lock_warmcopy_spill_fault SET v=12, pad=REPEAT('c',64)
  WHERE id=1;

--connection default
SET SESSION debug='+d,preserve_trx_lock_warmcopy_spill_manifest_short_write';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_spill_fault_fallback
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/get_preserved_token.inc

--connect(lock_wc_spill_fault_fallback_resume, localhost, root,,test)
--connection lock_wc_spill_fault_fallback_resume
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
--disconnect lock_wc_spill_fault_fallback_resume

--connection default
SELECT COUNT(*) AS preserved_count_after_spill_fault_resume
  FROM performance_schema.preserved_transactions;
SELECT id, v, pad=REPEAT('c',64) AS pad_ok
  FROM t_lock_warmcopy_spill_fault
  ORDER BY id;

DROP TABLE t_lock_warmcopy_spill_fault;
--disable_query_log
--eval SET GLOBAL preserve_trx_recovery_max_count=$old_preserve_trx_recovery_max_count
--eval SET GLOBAL preserve_trx_lock_warmcopy_max_memory_bytes=$old_preserve_trx_lock_warmcopy_max_memory_bytes
--eval SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=$old_preserve_trx_lock_warmcopy_fallback
--eval SET GLOBAL preserve_trx_lock_warmcopy_enable=$old_preserve_trx_lock_warmcopy_enable
--eval SET GLOBAL preserve_trx_warmcopy_enable=$old_preserve_trx_warmcopy_enable
--eval SET GLOBAL preserve_trx_enable=$old_preserve_trx_enable
--enable_query_log

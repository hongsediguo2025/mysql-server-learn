--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_idle_silent;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1024;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=4096;

CREATE TABLE t_warmcopy_idle_silent(
  id INT PRIMARY KEY,
  payload VARBINARY(1024)
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_idle_silent VALUES(1,REPEAT('a',512));
RESET MASTER;

--connect(warmcopy_idle_silent_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_idle_silent SET payload=REPEAT('b',512) WHERE id=1;
SET DEBUG_SYNC =
  'before_execute_sql_command SIGNAL warmcopy_idle_silent_select_blocked WAIT_FOR warmcopy_idle_silent_select_continue';
--send SELECT COUNT(*) FROM t_warmcopy_idle_silent WHERE id=1

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_idle_silent_select_blocked TIMEOUT 10';

--connect(warmcopy_idle_silent_owner, localhost, root,,test)
--connection warmcopy_idle_silent_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_idle_silent_hwm WAIT_FOR warmcopy_idle_silent_continue_drain';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_idle_silent_hwm TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL warmcopy_idle_silent_select_continue';

--connection warmcopy_idle_silent_app
--reap
SET DEBUG_SYNC = 'RESET';

--connection default
SET DEBUG_SYNC = 'now SIGNAL warmcopy_idle_silent_continue_drain';

--connection warmcopy_idle_silent_owner
--reap
--disconnect warmcopy_idle_silent_owner

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
--disconnect warmcopy_idle_silent_app

--connection default
SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;
SELECT id, payload=REPEAT('b',512) AS payload_ok
  FROM t_warmcopy_idle_silent;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/warmcopy_idle_silent.mysqlbinlog
--let $assert_text= committed warm-copy idle silent transaction appears once in binlog
--let $assert_file= $MYSQLTEST_VARDIR/tmp/warmcopy_idle_silent.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_warmcopy_idle_silent`
--let $assert_count= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/warmcopy_idle_silent.mysqlbinlog

DROP TABLE t_warmcopy_idle_silent;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET DEBUG_SYNC = 'RESET';

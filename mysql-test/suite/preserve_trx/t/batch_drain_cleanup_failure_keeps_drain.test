--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");

--disable_warnings
DROP TABLE IF EXISTS t_batch_cleanup_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_cleanup_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_cleanup_failure_a,localhost,root,,test)
--connection batch_cleanup_failure_a
START TRANSACTION;
INSERT INTO t_batch_cleanup_failure VALUES(1,10);

--connect(batch_cleanup_failure_b,localhost,root,,test)
--connection batch_cleanup_failure_b
START TRANSACTION;
INSERT INTO t_batch_cleanup_failure VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_reattach_original_thd";
--error ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_reattach_original_thd";

SELECT 1 AS server_alive_after_cleanup_failure;
SELECT COUNT(*) AS preserved_cleanup_records
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'PRESERVED'
   AND LAST_ERROR IS NOT NULL
   AND LAST_ERROR_AT IS NOT NULL;
--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions
 ORDER BY TOKEN;
--error ER_PRESERVE_TRX_UNSUPPORTED
BEGIN;

--connection batch_cleanup_failure_a
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--disconnect batch_cleanup_failure_a

--connection batch_cleanup_failure_b
ROLLBACK;
--disconnect batch_cleanup_failure_b

--connection default
--replace_column 2 PID_FILE
SHOW VARIABLES LIKE 'pid_file';
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_restart
  FROM performance_schema.preserved_transactions;

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT COUNT(*) AS preserved_count_after_resume
  FROM performance_schema.preserved_transactions;

DROP TABLE t_batch_cleanup_failure;
SET GLOBAL preserve_trx_enable=ON;

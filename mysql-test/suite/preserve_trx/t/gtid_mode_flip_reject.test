--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_gtid_mode_flip;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* rejected because snapshot binlog_state=LOGGED_WITH_CACHE requires gtid_mode=ON");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: binlog mode mismatch");
--enable_query_log

SET SESSION sql_log_bin=0;
CREATE TABLE t_gtid_mode_flip(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_gtid_mode_flip VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;

SELECT @@GLOBAL.GTID_MODE AS gtid_mode_before;

START TRANSACTION;
UPDATE t_gtid_mode_flip SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --gtid-mode=OFF --enforce-gtid-consistency=OFF
--source include/start_mysqld.inc

SELECT @@GLOBAL.GTID_MODE AS gtid_mode_after_restart;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_gtid_mode_flip WHERE a=1;

SET SESSION lock_wait_timeout=1;
SET SESSION sql_log_bin=0;
DROP TABLE t_gtid_mode_flip;
SET SESSION sql_log_bin=1;
RESET MASTER;

--let $restart_parameters= restart: --preserve-trx-enable=ON --gtid-mode=ON --enforce-gtid-consistency
--source include/restart_mysqld.inc

SET GLOBAL preserve_trx_enable=ON;

--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_participant_observability;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_warmcopy_participant_observability(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_participant_observability VALUES(1,10);

--connect(warmcopy_observe_target, localhost, root,,test)
CREATE TEMPORARY TABLE tmp_warmcopy_observe(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_warmcopy_observe VALUES(1,100);
UPDATE t_warmcopy_participant_observability SET v=11 WHERE id=1;

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

--let $assert_text= warmcopy participant observation is emitted by production drain
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: drain participant observation stage=target_preserve_failed index=0 state=ABANDONED owns_artifact=(YES|NO) bytes_used=[0-9]+ bytes_budget=[0-9]+ phase1_progress=[0-9]+ failure_reason=aborted
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection warmcopy_observe_target
SELECT * FROM tmp_warmcopy_observe ORDER BY id;
UPDATE t_warmcopy_participant_observability SET v=12 WHERE id=1;
COMMIT;
DROP TEMPORARY TABLE tmp_warmcopy_observe;
--disconnect warmcopy_observe_target

--connection default
SELECT * FROM t_warmcopy_participant_observability ORDER BY id;
DROP TABLE t_warmcopy_participant_observability;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_enable=ON;

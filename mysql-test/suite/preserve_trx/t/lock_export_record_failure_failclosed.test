--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_lock_export_record_failclosed;
--enable_warnings

SET GLOBAL rds_preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_lock_export_record_failclosed(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_export_record_failclosed VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_lock_export_record_failclosed SET v=11 WHERE id=1;

--connect(record_lock_export_control,localhost,root,,test)
SET SESSION debug="+d,preserve_trx_fail_export_record_locks";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="-d,preserve_trx_fail_export_record_locks";
--disconnect record_lock_export_control
--connection default

SELECT v AS value_visible_in_failed_preserve_trx
  FROM t_lock_export_record_failclosed
 WHERE id=1;
COMMIT;

SELECT * FROM t_lock_export_record_failclosed ORDER BY id;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_lock_export_record_failclosed;
SET GLOBAL rds_preserve_trx_enable=ON;

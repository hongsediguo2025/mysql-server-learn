--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;

CREATE TEMPORARY TABLE tmp_preserve_allocator_before_resume(
  id INT PRIMARY KEY,
  marker INT NOT NULL,
  payload LONGBLOB NOT NULL,
  KEY(marker)
) ENGINE=InnoDB;

INSERT INTO tmp_preserve_allocator_before_resume VALUES
  (1, 10, REPEAT('a', 32768));

START TRANSACTION;
INSERT INTO tmp_preserve_allocator_before_resume VALUES
  (2, 20, REPEAT('b', 32768));
UPDATE tmp_preserve_allocator_before_resume
   SET marker = 11, payload = CONCAT(payload, 'p')
 WHERE id = 1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --preserve-trx-max-temp-sidecar-bytes=1073741824 --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--connect(other_allocator,localhost,root,,test)
--connection other_allocator
CREATE TEMPORARY TABLE tmp_other_allocator_before_resume(
  id INT PRIMARY KEY,
  payload LONGBLOB NOT NULL
) ENGINE=InnoDB;
START TRANSACTION;
--disable_query_log
--let $i= 1
while ($i <= 64)
{
  --eval INSERT INTO tmp_other_allocator_before_resume VALUES($i, REPEAT('o', 32768))
  --inc $i
}
UPDATE tmp_other_allocator_before_resume
   SET payload = CONCAT(payload, 'x')
 WHERE id BETWEEN 1 AND 64;
--enable_query_log
COMMIT;
DROP TEMPORARY TABLE tmp_other_allocator_before_resume;
--disconnect other_allocator

--connection default
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT id, marker, LENGTH(payload) AS payload_len
  FROM tmp_preserve_allocator_before_resume
 ORDER BY id;

INSERT INTO tmp_preserve_allocator_before_resume VALUES
  (3, 30, REPEAT('c', 32768));
UPDATE tmp_preserve_allocator_before_resume
   SET marker = 22, payload = CONCAT(payload, REPEAT('q', 32768))
 WHERE id = 2;
DELETE FROM tmp_preserve_allocator_before_resume WHERE id = 1;
COMMIT;

SELECT id, marker, LENGTH(payload) AS payload_len
  FROM tmp_preserve_allocator_before_resume
 ORDER BY id;

DROP TEMPORARY TABLE tmp_preserve_allocator_before_resume;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

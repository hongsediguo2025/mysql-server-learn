--source include/have_debug_sync.inc
--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_disconnect_cleanup;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CALL mtr.add_suppression("PRESERVE: release_resources is finalizing pending token delivery");

CREATE TABLE t_preserve_disconnect_cleanup(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_disconnect_cleanup VALUES(1,10);

--connect(preserve_disconnect_owner,localhost,root,,test)
--connection preserve_disconnect_owner
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET SESSION debug="+d,preserve_trx_skip_dispatch_finalize_statement_response";
SET DEBUG_SYNC =
  'preserve_trx_after_token_delivery_pending SIGNAL disconnect_token_pending WAIT_FOR continue_disconnect_token_pending';
SET DEBUG_SYNC =
  'preserve_trx_release_resources_before_finalize SIGNAL release_finalize_pending WAIT_FOR continue_release_finalize';
SET SESSION debug="+d,preserve_trx_trace_release_resources_pending";
START TRANSACTION;
UPDATE t_preserve_disconnect_cleanup SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR disconnect_token_pending TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL CONNECTION $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_disconnect_token_pending';
SET DEBUG_SYNC = 'now WAIT_FOR release_finalize_pending TIMEOUT 10';

SELECT COUNT(*) AS pending_count_during_release_resources
  FROM performance_schema.preserved_transactions;

SET DEBUG_SYNC = 'now SIGNAL continue_release_finalize';

--connection preserve_disconnect_owner
--error 2013
--reap
--disconnect preserve_disconnect_owner

--connection default
SELECT * FROM t_preserve_disconnect_cleanup ORDER BY a;
SELECT COUNT(*) AS preserved_count_after_disconnect
  FROM performance_schema.preserved_transactions;

--let $assert_text= release_resources finalizes pending token delivery
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: release_resources is finalizing pending token delivery
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

DROP TABLE t_preserve_disconnect_cleanup;
SET GLOBAL preserve_trx_enable=ON;

--perl
use strict;
use warnings;
use File::Spec;

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));

my $header_path = File::Spec->catfile($source_root, 'sql', 'preserve_trx.h');
open(my $header_fh, '<', $header_path)
  or die "cannot open $header_path: $!";
my $header = do { local $/; <$header_fh> };
close($header_fh);

die "preserve release-resources cleanup hook must be declared\n"
  unless $header =~ /void\s+preserved_trx_release_resources\s*\(\s*THD\s*\*\s*thd\s*\)/s;

my $class_path = File::Spec->catfile($source_root, 'sql', 'sql_class.cc');
open(my $class_fh, '<', $class_path)
  or die "cannot open $class_path: $!";
my $class = do { local $/; <$class_fh> };
close($class_fh);

die "THD::release_resources must call preserve cleanup before generic cleanup and ha_close_connection\n"
  unless $class =~
         /void\s+THD::release_resources\s*\(\s*\).*?preserved_trx_release_resources\s*\(\s*this\s*\).*?if\s*\(\s*!is_cleanup_done\s*\(\s*\)\s*\)\s*cleanup\s*\(\s*\).*?ha_close_connection\s*\(\s*this\s*\)/s;
EOF

--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_retired_token_replay;
--enable_warnings
CALL mtr.add_suppression("Found 1 prepared XA transactions");

--let $MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_retired_token_replay(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_retired_token_replay VALUES(1, 10);

--connect(target,localhost,root,,test)
START TRANSACTION;
UPDATE t_retired_token_replay SET v=20 WHERE id=1;

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-recovery-max-count=10 --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--let $retired_token= `SELECT TOKEN FROM performance_schema.preserved_transactions LIMIT 1`
--connect(resumer,localhost,root,,test)
--connection resumer
--disable_query_log
--eval RESUME PRESERVED TRANSACTION '$retired_token'
--enable_query_log
ROLLBACK;
--disconnect resumer

--connection default
SELECT COUNT(*) AS preserved_after_retire
  FROM performance_schema.preserved_transactions;
--exec sh -c 'test ! -e "$MYSQLD_DATADIR/preserve/.xid_provenance"'

--let $restart_parameters= restart: --preserve-trx-enable=OFF --preserve-trx-off-artifact-policy=IGNORE --skip-log-bin
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--connect(xa_client,localhost,root,,test)
--disable_query_log
--eval XA START X'4d53505f50524553', '$retired_token', 1836281843
--enable_query_log
UPDATE t_retired_token_replay SET v=30 WHERE id=1;
--disable_query_log
--eval XA END X'4d53505f50524553', '$retired_token', 1836281843
--eval XA PREPARE X'4d53505f50524553', '$retired_token', 1836281843
--enable_query_log
--disconnect xa_client

--connection default
--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-off-artifact-policy=FAIL_IF_PRESENT --skip-log-bin
--let $do_not_echo_parameters= 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters=
--let $restart_parameters=

--replace_column 4 DATA
XA RECOVER CONVERT XID;
--disable_query_log
--eval XA ROLLBACK X'4d53505f50524553', '$retired_token', 1836281843
--enable_query_log
SELECT * FROM t_retired_token_replay ORDER BY id;

DROP TABLE t_retired_token_replay;

--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_no_redo_truncate_anchor(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_no_redo_truncate_anchor VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_temp_no_redo_truncate_only(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO tmp_temp_no_redo_truncate_only VALUES(1, 10), (2, 20);

START TRANSACTION;
UPDATE t_temp_no_redo_truncate_anchor SET v=11 WHERE id=1;
TRUNCATE TABLE tmp_temp_no_redo_truncate_only;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-temp-table-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

# TRUNCATE commits the persistent update before DRAIN. With no active target,
# DRAIN shuts down cleanly and must not fabricate a resume token or artifact.
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_temp_no_redo_truncate_anchor ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_temp_no_redo_truncate_anchor;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

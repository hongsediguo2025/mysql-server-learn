--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_drain_stmt;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_drain_mode=HARD;

CREATE TABLE t_preserve_drain_stmt(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_drain_stmt VALUES(1,10),(2,20),(3,30);

--connect(drain_stmt_holder,localhost,root,,test)
--connection drain_stmt_holder
START TRANSACTION;
UPDATE t_preserve_drain_stmt SET b=21 WHERE a=2;

--connect(drain_stmt_writer,localhost,root,,test)
--connection drain_stmt_writer
--let $stmt_writer_conn_id= `SELECT CONNECTION_ID()`
SET SESSION innodb_lock_wait_timeout=50;
--send UPDATE t_preserve_drain_stmt SET b=22 WHERE a=2

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.data_lock_waits
--source include/wait_condition.inc

--connect(drain_stmt_preserve,localhost,root,,test)
--connection drain_stmt_preserve
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_lock_materialization SIGNAL drain_stmt_ready WAIT_FOR continue_drain_stmt';
START TRANSACTION;
UPDATE t_preserve_drain_stmt SET b=11 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR drain_stmt_ready TIMEOUT 10';
--replace_result $stmt_writer_conn_id STMT_WRITER_ID
--eval SELECT COUNT(*) AS stmt_writer_thread_count FROM performance_schema.threads WHERE PROCESSLIST_ID = $stmt_writer_conn_id
--replace_result $preserve_conn_id PRESERVE_ID
--eval KILL QUERY $preserve_conn_id
SET DEBUG_SYNC = 'now SIGNAL continue_drain_stmt';

--connection drain_stmt_preserve
--error ER_QUERY_INTERRUPTED
--reap
SET DEBUG_SYNC = 'RESET';
ROLLBACK;
--disconnect drain_stmt_preserve

--connection drain_stmt_writer
--error 2013
--reap
--disconnect drain_stmt_writer

--disconnect drain_stmt_holder

--connection default
SELECT * FROM t_preserve_drain_stmt ORDER BY a;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

DROP TABLE t_preserve_drain_stmt;
SET GLOBAL preserve_trx_enable=ON;

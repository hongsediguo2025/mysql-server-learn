--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_recovery_logged_cache_lazy_payload;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_recovery_logged_cache_lazy_payload(
  id INT PRIMARY KEY,
  payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO t_recovery_logged_cache_lazy_payload VALUES(1,'a'),(2,'b');
RESET MASTER;

START TRANSACTION;
UPDATE t_recovery_logged_cache_lazy_payload
   SET payload=REPEAT('x', 80)
 WHERE id=1;
UPDATE t_recovery_logged_cache_lazy_payload
   SET payload=REPEAT('y', 80)
 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, RECOVERED_COUNT,
       BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_BINLOG_CACHE_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;

SELECT id, LENGTH(payload) AS payload_length,
       SUBSTR(payload, 1, 1) AS payload_prefix
  FROM t_recovery_logged_cache_lazy_payload
 ORDER BY id;

--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--exec $MYSQL_BINLOG --force-if-open --base64-output=decode-rows -v -v $MYSQLTEST_VARDIR/mysqld.1/data/$binlog_file > $MYSQLTEST_VARDIR/tmp/recovery_logged_cache_lazy_payload.mysqlbinlog
--let $assert_text= Recovered logged-cache transaction writes row events on final COMMIT
--let $assert_file= $MYSQLTEST_VARDIR/tmp/recovery_logged_cache_lazy_payload.mysqlbinlog
--let $assert_select= ### UPDATE `test`.`t_recovery_logged_cache_lazy_payload`
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--remove_file $MYSQLTEST_VARDIR/tmp/recovery_logged_cache_lazy_payload.mysqlbinlog

DROP TABLE t_recovery_logged_cache_lazy_payload;
SET GLOBAL preserve_trx_enable=ON;

# Phase1 must not flush a target THD after an idle sample becomes stale.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/idle_to_active_binlog_race.secret
--write_file $credential_file
idle-to-active-binlog-race-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS idle_to_active_binlog_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'idle-to-active-binlog-race-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT FILE ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
CREATE USER idle_to_active_binlog_app@localhost;
GRANT SELECT, INSERT, UPDATE ON test.* TO idle_to_active_binlog_app@localhost;
GRANT SESSION_VARIABLES_ADMIN ON *.* TO idle_to_active_binlog_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=idle_to_active_binlog_race --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

CALL mtr.add_suppression(
  "PRESERVE: standby transfer source epoch commit failed status=9");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=30000;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=1000;
SET GLOBAL binlog_format=ROW;
SET @receiver_active_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs');
SET @unknown_before=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs');

CREATE TABLE t_idle_to_active_binlog_race(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  payload VARBINARY(4096) NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_idle_to_active_binlog_race
VALUES(1, 0, REPEAT('a', 4096));

--connect(idle_to_active_app,localhost,idle_to_active_binlog_app,,test)
--let $app_connection_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_idle_to_active_binlog_race SET v=v+1 WHERE id=1;

--connect(idle_to_active_owner,localhost,root,,test)
SET SESSION debug='+d,preserve_trx_transfer_fail_commit_before_send_once';
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_phase1_target_collection SIGNAL idle_target_collected WAIT_FOR idle_target_collection_continue';
SET DEBUG_SYNC=
  'preserve_trx_transfer_after_phase1_binlog_stream SIGNAL idle_target_phase1_streamed WAIT_FOR idle_target_phase1_continue';
SET DEBUG_SYNC=
  'preserve_trx_transfer_commit_before_send_failed SIGNAL idle_target_unsent_ready WAIT_FOR idle_target_unsent_continue';
--send DRAIN TRANSACTIONS PRESERVE

--connect(idle_to_active_control,localhost,preserve_trx_ha_admin,idle-to-active-binlog-race-secret,test)
SET DEBUG_SYNC='now WAIT_FOR idle_target_collected TIMEOUT 30';

--connection idle_to_active_app
SET DEBUG_SYNC=
  'ha_write_row_end SIGNAL idle_target_pending_ready WAIT_FOR idle_target_pending_continue';
--send INSERT INTO t_idle_to_active_binlog_race VALUES(2, 1, REPEAT('b', 4096))

--connection idle_to_active_control
SET DEBUG_SYNC='now WAIT_FOR idle_target_pending_ready TIMEOUT 30';
SET DEBUG_SYNC='now SIGNAL idle_target_collection_continue';
SET DEBUG_SYNC='now WAIT_FOR idle_target_phase1_streamed TIMEOUT 30';
--enable_query_log
SELECT 1 AS server_survived_idle_to_active_race;
--disable_query_log
SET DEBUG_SYNC='now SIGNAL idle_target_pending_continue';

--connection idle_to_active_app
--reap

--connection idle_to_active_control
SET DEBUG_SYNC='now SIGNAL idle_target_phase1_continue';
SET DEBUG_SYNC='now WAIT_FOR idle_target_unsent_ready TIMEOUT 30';
# Let the receiver finish its in-flight prewarm before the source sends ABORT;
# otherwise the one-shot prepared-token purge can legitimately race a live
# worker and leave a terminal registry entry behind.
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc
SET DEBUG_SYNC='now SIGNAL idle_target_unsent_continue';

--connection idle_to_active_owner
--disable_result_log
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
--enable_result_log
SET SESSION debug='-d,preserve_trx_transfer_fail_commit_before_send_once';
SET DEBUG_SYNC='RESET';

--connection idle_to_active_app
--let $assert_text= idle-to-active source restore keeps the original transaction connection
--let $assert_cond= `SELECT CONNECTION_ID()=$app_connection_id`
--source include/assert.inc
COMMIT;

--connection default
--let $assert_text= idle-to-active pre-COMMIT-send failure avoids COMMIT_UNKNOWN
--let $assert_cond= `SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_source_commit_unknown_epochs')=@unknown_before`
--source include/assert.inc
--enable_query_log
SELECT COUNT(*) AS row_count, SUM(v) AS value_sum
  FROM t_idle_to_active_binlog_race;
--disable_query_log
--let $assert_text= idle-to-active preserves the exact committed rows
--let $assert_cond= `SELECT GROUP_CONCAT(CONCAT(id, ':', v) ORDER BY id)='1:1,2:1' FROM t_idle_to_active_binlog_race`
--source include/assert.inc

--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=@receiver_active_before AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc

--disconnect idle_to_active_app
--disconnect idle_to_active_owner
--disconnect idle_to_active_control

# A failed self-transfer may leave target-local prepared resources until server
# teardown. Restart after the source transaction has committed so native table
# cleanup does not race those receiver-owned handles.
--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$MASTER_MYPORT --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=idle_to_active_binlog_race --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log
--source suite/preserve_trx/include/assert_phase2_dependency_mode.inc

--let $assert_text= idle-to-active committed rows survive source restart
--let $assert_cond= `SELECT GROUP_CONCAT(CONCAT(id, ':', v) ORDER BY id)='1:1,2:1' FROM t_idle_to_active_binlog_race`
--source include/assert.inc

DROP TABLE t_idle_to_active_binlog_race;
DROP USER idle_to_active_binlog_app@localhost;
DROP USER preserve_trx_ha_admin@localhost;
SET DEBUG_SYNC='RESET';
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=1000;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=30000;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_enable=ON;
--remove_file $credential_file

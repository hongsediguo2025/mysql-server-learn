--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/force_restart.inc

--disable_query_log
--let $credential_file= $MYSQL_TMP_DIR/standby-transfer-gtid-mismatch.secret
--write_file $credential_file
standby-transfer-gtid-mismatch-secret
EOF
--exec chmod 600 $credential_file

--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@'127.0.0.1';
DROP USER IF EXISTS gtid_mismatch_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@'127.0.0.1'
  IDENTIFIED BY 'standby-transfer-gtid-mismatch-secret';
GRANT SHUTDOWN, PROCESS, SYSTEM_VARIABLES_ADMIN,
      PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@'127.0.0.1';
GRANT SELECT ON performance_schema.*
  TO preserve_trx_ha_admin@'127.0.0.1';
CREATE USER gtid_mismatch_app@localhost;
GRANT SELECT, UPDATE ON test.*
  TO gtid_mismatch_app@localhost;

--let $restart_parameters= restart: --rds-preserve-trx-enable=ON --rds-preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --rds-preserve-trx-transfer-target-host=127.0.0.1 --rds-preserve-trx-transfer-target-port=$SERVER_MYPORT_1 --rds-preserve-trx-transfer-target-user=preserve_trx_ha_admin --rds-preserve-trx-transfer-credential-name=standby_transfer_gtid_mismatch --rds-preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=120000;

--connect(standby_transfer_gtid_mismatch_ha,127.0.0.1,preserve_trx_ha_admin,standby-transfer-gtid-mismatch-secret,test,$SERVER_MYPORT_1,)

--connection default
--disable_warnings
DROP TABLE IF EXISTS t_standby_transfer_gtid_mismatch;
--enable_warnings
CREATE TABLE t_standby_transfer_gtid_mismatch(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_standby_transfer_gtid_mismatch VALUES(1,10);

--connect(standby_transfer_gtid_mismatch_app,localhost,gtid_mismatch_app,,test)
--let $app_id= query_get_value(SELECT CONNECTION_ID() AS id, id, 1)
START TRANSACTION;
UPDATE t_standby_transfer_gtid_mismatch SET v=11 WHERE id=1;

--connection default
--replace_result $app_id APP_ID
--replace_column 1 GENERATION 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

# The artifact was captured under ON. Resume the paused receiver only after its
# runtime mode changes, so the token must fail at the semantic gate rather than
# merely miss a deadline.
--connection standby_transfer_gtid_mismatch_ha
SET GLOBAL GTID_MODE=ON_PERMISSIVE;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens')=1
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0
--source include/wait_condition.inc

SELECT VARIABLE_VALUE=1 AS one_classified_token
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_tokens';
SELECT VARIABLE_VALUE=0 AS no_ready_token
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_ready_tokens';
SELECT VARIABLE_VALUE=1 AS one_not_ready_token
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_auto_prewarm_not_ready_tokens';
SELECT VARIABLE_VALUE=1 AS semantic_gate_executed
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_tokens';
SELECT VARIABLE_VALUE=12 AS unsupported_artifact_status
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_seal_prewarm_last_status';

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --rds-preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

--connect(standby_transfer_gtid_mismatch_cleanup,localhost,root,,test)
DROP TABLE t_standby_transfer_gtid_mismatch;
DROP USER gtid_mismatch_app@localhost;
DROP USER preserve_trx_ha_admin@'127.0.0.1';
--remove_file $credential_file

--enable_query_log

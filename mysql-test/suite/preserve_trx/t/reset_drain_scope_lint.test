--perl
use strict;
use warnings;
use File::Find;
use File::Spec;

# Lint-only source-shape guard. Runtime RESET/TTL behavior is covered by
# targeted GUnit, SQL MTR, and the standalone dual-mysqld E2E.

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));

sub read_source {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my $src = do { local $/; <$fh> };
  close($fh);
  return $src;
}

sub source_path {
  return File::Spec->catfile($source_root, @_);
}

sub assert_tree_has_no_reset_drain_hook {
  my ($root, $label) = @_;
  my @violations;
  find(
    {
      no_chdir => 1,
      wanted => sub {
        return unless -f $_ && /\.(?:cc|h|ic)$/;
        my $src = read_source($File::Find::name);
        if ($src =~
            /(?:reset[_ ]drain|receiver_(?:prewarm|ready)_timeout|accepted_epoch_lifecycle)/i) {
          push @violations, File::Spec->abs2rel($File::Find::name, $source_root);
        }
      },
    },
    $root
  );
  die "$label must not contain RESET DRAIN/receiver TTL hooks: @violations\n"
    if @violations;
}

my $preserve = read_source(source_path('sql', 'preserve_trx.cc'));
my $preserve_header = read_source(source_path('sql', 'preserve_trx.h'));
my $kernel_header =
  read_source(source_path('sql', 'preserve_trx_kernel.h'));
my $transfer = read_source(source_path('sql', 'preserve_trx_transfer.cc'));
my $transfer_header =
  read_source(source_path('sql', 'preserve_trx_transfer.h'));
my $drain = read_source(source_path('sql', 'preserve_trx_drain.cc')) .
            read_source(source_path('sql', 'preserve_trx_drain.h'));
my $binlog = read_source(source_path('sql', 'binlog.cc')) .
             read_source(source_path('sql', 'binlog.h'));

assert_tree_has_no_reset_drain_hook(
  source_path('storage', 'innobase'), 'InnoDB shared paths');
die "sql/binlog.* must not contain RESET DRAIN/receiver TTL hooks\n"
  if $binlog =~
     /(?:reset[_ ]drain|receiver_(?:prewarm|ready)_timeout|accepted_epoch_lifecycle)/i;
die "sql/preserve_trx_drain.* must remain untouched by RESET DRAIN/receiver TTL\n"
  if $drain =~
     /(?:reset[_ ]drain|receiver_(?:prewarm|ready)_timeout|accepted_epoch_lifecycle)/i;

my $all_reset_sources = $preserve . $transfer . $transfer_header;
die "RESET DRAIN must not expose active-drain test-only APIs in production sources\n"
  if ($preserve . $preserve_header) =~
     /active_drain[A-Za-z0-9_]*_for_unit_test/;
for my $test_only_api (
  qw(
    preserved_trx_compare_exchange_manager_state_owner_for_unit_test
    preserved_trx_collect_batch_restore_thread_ids_for_unit_test
  )
) {
  die "RESET DRAIN must not expose $test_only_api in production sources\n"
    if ($preserve . $preserve_header) =~ /\Q$test_only_api\E/;
}
die "RESET DRAIN/receiver TTL must not add lifecycle_generation\n"
  if $all_reset_sources =~ /lifecycle_generation/;
die "receiver expiry must reuse housekeeping instead of adding a reaper thread\n"
  if $all_reset_sources =~
     /(?:std::thread[^\n;]*receiver[^\n;]*reaper|receiver[^\n;]*reaper[^\n;]*std::thread)/is;

die "standby transfer protocol version changed\n"
  unless $transfer_header =~
         /kPreserveTrxTransferProtocolVersion\s*=\s*2/ &&
         $transfer_header !~ /kPreserveTrxTransferLegacyProtocolVersion/;

my ($frame_enum) =
  $transfer_header =~
    /(enum class Preserve_trx_transfer_frame_type\s*:\s*uint16_t\s*\{.*?^\};)/ms
  or die "could not isolate transfer frame enum\n";
die "RESET DRAIN must not add a transfer wire frame\n"
  if $frame_enum =~ /RESET|EXPIRE|TTL/i;

my ($status_enum) =
  $transfer_header =~
    /(enum class Preserve_trx_transfer_status\s*\{.*?^\};)/ms
  or die "could not isolate transfer status enum\n";
die "RESET DRAIN must not add a transfer wire status\n"
  if $status_enum =~ /RESET|EXPIRE|TTL/i;

my ($commit_body) =
  $transfer =~
    /(Preserve_trx_transfer_source_epoch_session::commit_epoch_impl\([\s\S]*?^})/m
  or die "could not isolate source commit_epoch\n";
my $ack_pos = index($commit_body, 'const bool commit_acknowledged');
my $arbiter_pos = index($commit_body, 'm_final_ack_arbiter(');
my $committed_pos = index($commit_body, 'm_epoch_committed = true');
my $handoff_pos = index($commit_body, 'm_before_commit_send(');
my $commit_send_pos =
  index($commit_body, 'sink->send_encoded_frame(encoded_commit)');
die "source ownership handoff must be acquired immediately before the first COMMIT network send\n"
  unless $handoff_pos >= 0 && $commit_send_pos > $handoff_pos;
die "FINAL_ACK arbiter must stay after receiver commit acknowledgement and before epoch publication\n"
  unless $ack_pos >= 0 && $arbiter_pos > $ack_pos &&
         $committed_pos > $arbiter_pos;
die "FINAL_ACK arbiter must remain guarded by commit acknowledgement\n"
  unless $commit_body =~
         /bool final_ack_accepted\s*=\s*commit_acknowledged[\s\S]*m_final_ack_arbiter/s;

die "receiver TTL must expose the existing receiver reaper scan entry point\n"
  unless $transfer_header =~
         /preserve_trx_transfer_receiver_reaper_scan_once\s*\(\s*uint64_t\s+now_us\s*\)/;
die "receiver TTL public scan must delegate to the existing registry scan\n"
  unless $transfer =~
         /preserve_trx_transfer_receiver_reaper_scan_once\s*\(\s*uint64_t\s+now_us\s*\)\s*\{\s*receiver_reaper_scan_once\s*\(\s*now_us,\s*&default_receiver_registry\(\)\s*\)/s;
die "receiver TTL must run from the existing preserve housekeeping loop\n"
  unless $preserve =~
         /preserve_trx_transfer_receiver_reaper_scan_once\s*\(\s*now_us\s*\)/;

my ($manager_owner_cas) =
  $preserve =~
    /(bool preserve_trx_compare_exchange_manager_state_owner\(\n    Preserve_trx_manager_state expected_state,[\s\S]*?^})/m
  or die "could not isolate exact manager state/owner CAS\n";
die "manager takeover CAS must compare both expected state and owner\n"
  unless $manager_owner_cas =~
           /preserve_trx_pack_manager_state_owner\(expected_state, expected_owner\)/s &&
         $manager_owner_cas =~ /compare_exchange_strong\(expected, desired\)/s;

my ($batch_restore) =
  $preserve =~
    /(static bool restore_preserved_batch_items_to_original_thds\([\s\S]*?^})/m
  or die "could not isolate RESET batch restore\n";
my $collector_scan_count = () =
  $batch_restore =~ /do_for_all_thd_copy\(&collector\)/g;
die "RESET batch restore must collect target THDs in one global scan\n"
  unless $collector_scan_count == 1;
my $restore_guard_pos = index($batch_restore, 'ownership.restore_allowed()');
my $restore_scan_pos = index($batch_restore, 'do_for_all_thd_copy(&collector)');
die "batch restore must reject HANDOFF_PENDING/COMMIT_UNKNOWN before touching target THDs\n"
  unless $restore_guard_pos >= 0 && $restore_scan_pos > $restore_guard_pos;
die "RESET batch restore must replay targets in reverse preserve order\n"
  unless $batch_restore =~
           /for \(size_t i = items\.size\(\); i != 0; --i\)/s &&
         $batch_restore =~
           /targets\[i - 1\]\.thd, items\[i - 1\]/s;

die "receiver COMMIT status query must use the epoch terminal tombstone, not accepted lifecycle alone\n"
  unless $transfer =~
         /preserve_trx_transfer_query_epoch_commit_status\([\s\S]*query_epoch_terminal\s*\(\s*root_dir,\s*epoch_id\s*\)/s;

die "batch target preserve kernel request must carry only the existing drain ownership state\n"
  unless $kernel_header =~
         /const Preserve_trx_drain_ownership_state\s*\*drain_ownership\s*\{\s*nullptr\s*\}/s;
die "batch target helper must keep drain ownership optional and disabled by default\n"
  unless $preserve_header =~
         /Preserve_trx_deferred_transfer_candidate\s*\*deferred_transfer_candidate\s*=\s*nullptr,\s*const Preserve_trx_drain_ownership_state\s*\*drain_ownership\s*=\s*nullptr/s;
die "batch target preserve must pass the active attempt ownership without creating another cancel flag\n"
  unless $preserve =~
         /m_drain_attempt\s*==\s*nullptr\s*\?\s*nullptr\s*:\s*&m_drain_attempt->ownership/s;

my ($preserve_kernel) =
  $preserve =~
    /(bool preserve_trx_kernel_preserve_attached_transaction\([\s\S]*?^})/m
  or die "could not isolate batch target preserve kernel\n";
die "kernel RESET polling must use the active drain ownership and RESET_REQUESTED\n"
  unless $preserve_kernel =~
           /return request\.drain_ownership\s*!=\s*nullptr\s*&&[\s\S]*Preserve_trx_drain_terminal::RESET_REQUESTED/s;
die "kernel must not retain the removed single-delivery mode\n"
  if $preserve_kernel =~ /batch_delivery|Preserve_trx_delivery_mode/s;
die "preflight RESET must reuse the attached pre-prepare recovery branch\n"
  unless $preserve_kernel =~
         /if \(reset_requested\(\)\)\s*return reject_after_binlog_export\("batch_target_preserve_reset"\)/s;
die "RESET before engine prepare must reuse the complete unprepared restore branch\n"
  unless $preserve_kernel =~
         /preserve_trx_batch_cancel_before_prepare[\s\S]*set_failure_reason\("batch_target_preserve_reset"\)[\s\S]*return restore_unprepared_batch_prepare_failure_or_rollback\(\)/s;
die "RESET after engine prepare must thaw and reuse the prepared restore branch\n"
  unless $preserve_kernel =~
         /preserve_trx_batch_cancel_after_prepare[\s\S]*thaw_lock_warmcopy_conversion\(\)[\s\S]*return restore_prepared_batch_or_rollback\(\)/s;
die "RESET after detach must reuse the detached reattach-or-rollback branch\n"
  unless $preserve_kernel =~
         /preserve_trx_after_detach_before_claim[\s\S]*preserve_trx_batch_cancel_after_detach[\s\S]*return reject_after_detach_failure_or_rollback\(\)/s;
die "RESET before artifact publication must discard warm blobs and reuse snapshot cleanup\n"
  unless $preserve_kernel =~
         /preserve_trx_before_artifact_publish[\s\S]*preserve_trx_batch_cancel_before_publish[\s\S]*discard_prebuilt_binlog_blob_if_needed\(\)[\s\S]*return reject_after_snapshot_failure\(false\)/s;

die "early workers must collect completed items and enter RESET completion immediately after join\n"
  unless $preserve =~
         /join_workers\.rollback\(\);[\s\S]*?if \(reset_requested\(\)\) \{[\s\S]*?collect_completed_target_items\(\);[\s\S]*?return finish_phase2_reset\(\s*&preserved_batch_items,\s*"reset_during_early_target_pipeline"\);[\s\S]*?const size_t expected_completed_workers/s;
die "phase-2 workers must enter RESET completion before ordinary target failure handling\n"
  unless $preserve =~
         /const Preserve_batch_target_execution \*failed_execution[\s\S]*if \(reset_requested\(\)\)\s*return finish_phase2_reset\(&preserved_batch_items,\s*"reset_after_phase2_workers"\);\s*if \(failed_execution != nullptr\)/s;
die "RESET must not retain the removed XID-provenance completion wrapper\n"
  if $preserve =~ /finish_reset_with_provenance|batch_provenance_tokens/;

my ($reset_participant_stop) =
  $preserve =~
    /(auto stop_reset_participant_admission = \[\&\]\(\) \{[\s\S]*?^  \};)/m
  or die "RESET must expose a narrow participant-admission stop helper\n";
die "RESET participant-admission stop must detach binlog warmcopy mirrors without destroying the provider\n"
  unless $reset_participant_stop =~
         /warmcopy_participant->stop_mirroring_for_reset\s*\(\s*\)/s;
die "RESET participant-admission stop must close the lock warmcopy epoch before sessions become runnable\n"
  unless $reset_participant_stop =~ /lock_warmcopy_close_epoch\s*\(\s*\)/s;

my ($phase1_reset) =
  $preserve =~
    /(auto finish_phase1_reset = \[\&\]\(const char \*stage\) \{[\s\S]*?)(?=^  auto reject_or_finish_phase1_reset)/m
  or die "could not isolate phase-1 RESET completion\n";
my $phase1_stop_pos =
  index($phase1_reset, 'stop_reset_participant_admission()');
my $phase1_clear_pos =
  index($phase1_reset, 'Preserve_batch_clear_generation');
my $phase1_barrier_pos =
  index($phase1_reset,
        'preserve_trx_publish_active_drain_reset_barrier');
my $phase1_abort_pos =
  index($phase1_reset, 'abort_drain_participants(stage)');
die "phase-1 RESET must stop participant admission, clear session state, publish the release barrier, then perform physical participant cleanup\n"
  unless $phase1_stop_pos >= 0 &&
         $phase1_clear_pos > $phase1_stop_pos &&
         $phase1_barrier_pos > $phase1_clear_pos &&
         $phase1_abort_pos > $phase1_barrier_pos;

my ($phase2_reset) =
  $preserve =~
    /(auto finish_phase2_reset\s*=[\s\S]*?)(?=^  auto finish_with_shutdown)/m
  or die "could not isolate phase-2 RESET completion\n";
my $phase2_stop_pos =
  index($phase2_reset, 'stop_reset_participant_admission()');
my $phase2_restore_pos =
  index($phase2_reset, 'restore_preserved_batch_items_for_reset');
my $phase2_barrier_pos =
  index($phase2_reset,
        'preserve_trx_publish_active_drain_reset_barrier');
my $phase2_abort_pos =
  rindex($phase2_reset, 'abort_drain_participants(stage)');
die "phase-2 RESET must stop participant admission, classify every token, publish the release barrier, then perform physical participant cleanup\n"
  unless $phase2_stop_pos >= 0 &&
         $phase2_restore_pos > $phase2_stop_pos &&
         $phase2_barrier_pos > $phase2_restore_pos &&
         $phase2_abort_pos > $phase2_barrier_pos;

die "RESET must not retain the obsolete all-runnable/reset-failed binary contract\n"
  if $preserve =~ /all_transactions_runnable|reset_failed/;
die "RESET request must reject post-COMMIT ownership as too late\n"
  unless $preserve =~
         /request_reset\s*\(\)[\s\S]*HANDOFF_PENDING[\s\S]*COMMIT_UNKNOWN[\s\S]*COMMITTED_HANDOFF[\s\S]*TOO_LATE/s;
die "RESET request must retain source-only shutdown handoff restoration\n"
  unless $preserve =~
         /request_reset\s*\(\)[\s\S]*SHUTDOWN_HANDOFF[\s\S]*SOURCE_RESTORE_PENDING[\s\S]*WON/s;
die "receiver-owns handoff resolution must publish the live-source transfer fence\n"
  unless $preserve =~
         /preserved_trx_resolve_handoff_unknown[\s\S]*?acknowledge_commit[\s\S]*?Preserve_trx_manager_state::TRANSFER_HANDOFF_COMPLETE\s*,\s*0/s;
die "source-owns handoff resolution must fail-stop if guarded restore exits incomplete\n"
  unless $preserve =~
         /begin_source_restore\(\)\)[\s\S]{0,350}preserve_trx_reset_invariant_failure\([\s\S]*?"quarantined_reset_source_restore_transition_failed"[\s\S]*?preserve_trx_publish_active_drain_reset_barrier\(attempt\);/s;
die "receiver-owned resolution must retain the active attempt; only source-owned resolution may archive it\n"
  unless $preserve =~
         /RECEIVER_FENCED_SOURCE_OWNS[\s\S]*?g_active_drain_attempt\.reset\(\);[\s\S]*?g_last_resolved_drain_attempt\s*=\s*std::move\(attempt\);/s;
die "RESET must not send receiver ABORT after source restore ownership wins\n"
  unless $preserve =~
         /auto abort_batch_transfer_epoch[\s\S]{0,800}preserve_trx_active_drain_reset_requested\(active_drain_attempt\)[\s\S]{0,120}return;/s;
die "post-ACK RESET context must be published before terminal manager handoff\n"
  unless $preserve =~
         /quarantined_items\s*=\s*std::move\(preserved_batch_items\)[\s\S]{0,500}source_restore_context_ready\.store[\s\S]{0,1200}TRANSFER_HANDOFF_COMPLETE/s;
die "RESET cleanup must use the existing reaper with bounded token work\n"
  unless $preserve =~
         /preserved_trx_expired_reaper_scan_once[\s\S]{0,300}preserved_trx_reset_attempt_reaper_scan_once/s &&
         $preserve =~
         /kMaxResetTokensPerPass\s*=\s*16[\s\S]*complete_source_restore\(\)[\s\S]*Preserve_trx_manager_state::IDLE/s;
die "active local-carrier DRAIN without an attempt must remain unsupported, not fatal\n"
  unless $preserve =~
         /attempt\s*==\s*nullptr[\s\S]{0,900}WARMCOPY_DRAINING[\s\S]{0,300}SHUTDOWN_REQUESTED[\s\S]{0,120}UNSUPPORTED/s;
die "RESET scope exit must publish the release barrier or fail-stop\n"
  unless $preserve =~
         /drain_scope_exited_before_reset_release_barrier[\s\S]{0,120}active_drain_attempt/s;

EOF

SELECT 'ok' AS reset_drain_scope_lint;

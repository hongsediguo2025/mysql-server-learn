--source include/not_log_bin.inc

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

CREATE TEMPORARY TABLE tmp_preserve_untracked(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
SAVEPOINT before_temp_history;
CREATE TEMPORARY TABLE tmp_preserve_untracked_late(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_untracked_late VALUES(1, 10);

--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

ROLLBACK;
DROP TEMPORARY TABLE tmp_preserve_untracked_late;
DROP TEMPORARY TABLE tmp_preserve_untracked;

SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
START TRANSACTION;
CREATE TEMPORARY TABLE tmp_preserve_toggle_off_late(
  id INT PRIMARY KEY
) ENGINE=InnoDB;
SET GLOBAL rds_preserve_trx_temp_table_enable=OFF;

--let $preserve_trx_drain_clause=
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
ROLLBACK;
DROP TEMPORARY TABLE tmp_preserve_toggle_off_late;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_sidecar_write_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_sidecar_write_failure(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_sidecar_write_failure VALUES(1, 10);

CREATE TEMPORARY TABLE tmp_temp_sidecar_write_failure(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_temp_sidecar_write_failure VALUES(1, 100), (2, 200);

START TRANSACTION;
UPDATE t_temp_sidecar_write_failure SET v=11 WHERE id=1;

--connect(temp_sidecar_failure_control,localhost,root,,test)
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
--disconnect temp_sidecar_failure_control
--connection default

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

SELECT COUNT(*) AS temp_rows, SUM(v) AS temp_sum
  FROM tmp_temp_sidecar_write_failure;
SELECT * FROM t_temp_sidecar_write_failure ORDER BY id;
ROLLBACK;
SELECT * FROM t_temp_sidecar_write_failure ORDER BY id;

DROP TEMPORARY TABLE tmp_temp_sidecar_write_failure;
DROP TABLE t_temp_sidecar_write_failure;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

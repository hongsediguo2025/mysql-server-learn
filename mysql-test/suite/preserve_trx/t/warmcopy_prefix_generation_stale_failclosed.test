--source include/have_debug_sync.inc
--source include/have_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_warmcopy_prefix_stale;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=4096;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1024;

CREATE TABLE t_warmcopy_prefix_stale(
  id INT PRIMARY KEY,
  v INT,
  payload VARBINARY(1024)
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_prefix_stale VALUES(1,10,REPEAT('a',1024));

--connect(warmcopy_prefix_stale_app, localhost, root,,test)
START TRANSACTION;
UPDATE t_warmcopy_prefix_stale
  SET v=11, payload=REPEAT('b',1024)
  WHERE id=1;
SAVEPOINT stale_sp;
UPDATE t_warmcopy_prefix_stale
  SET v=12, payload=REPEAT('c',1024)
  WHERE id=1;

--connect(warmcopy_prefix_stale_owner, localhost, root,,test)
--connection warmcopy_prefix_stale_owner
SET DEBUG_SYNC =
  'preserve_trx_warmcopy_before_prefix_digest_replay SIGNAL warmcopy_prefix_copied WAIT_FOR warmcopy_prefix_continue';
--send DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_prefix_copied TIMEOUT 10';
--connection warmcopy_prefix_stale_app
ROLLBACK TO SAVEPOINT stale_sp;
--connection default
SET DEBUG_SYNC = 'now SIGNAL warmcopy_prefix_continue';

--connection warmcopy_prefix_stale_owner
--error ER_PRESERVE_TRX_UNSUPPORTED
--reap
SET DEBUG_SYNC = 'RESET';
--disconnect warmcopy_prefix_stale_owner

--connection default
--let $assert_text= stale warmcopy generation fails during phase1
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= PRESERVE: drain participant observation stage=open_phase1_failed index=0 state=ABANDONED owns_artifact=(YES|NO) bytes_used=[0-9]+ bytes_budget=[0-9]+ .*phase1_progress=[0-9]+ failure_reason=warm-copy phase1 preparation failed
--let $assert_count_condition= >= 1
--source include/assert_grep.inc
--let $assert_count_condition=

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

--connection warmcopy_prefix_stale_app
COMMIT;
SELECT id, v, OCTET_LENGTH(payload) AS payload_len,
       payload=REPEAT('b',1024) AS payload_ok
  FROM t_warmcopy_prefix_stale
  ORDER BY id;
--disconnect warmcopy_prefix_stale_app

--connection default
DROP TABLE t_warmcopy_prefix_stale;
SET GLOBAL preserve_trx_warmcopy_chunk_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_tail_budget_bytes=1048576;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc
--echo # Receiver SQL attach: exact TABLE journal, rollback and retry
--disable_query_log
--let $saved_global_debug= `SELECT @@global.debug`
--let $undo_trace= $MYSQLTEST_VARDIR/log/temp_receiver_sql_attach_names.trace
--eval SET GLOBAL debug='d,preserve_temp_import,preserve_temp_import_source_undo_probe,preserve_temp_transfer_input_probe,preserve_temp_receiver_pipeline_probe,preserve_temp_receiver_sql_attach_probe,preserve_temp_receiver_sql_metadata_probe:O,$undo_trace'
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TABLE t_undo_multi_base(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_undo_multi_base
  WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<64)
  SELECT n, n*10 FROM seq;
--connect(undo_app,localhost,root,,test)
CREATE TEMPORARY TABLE MiXeD_preserved_space_7_table_8(
  k VARBINARY(32) PRIMARY KEY, n INT NULL, v VARBINARY(128)
) ENGINE=InnoDB ROW_FORMAT=REDUNDANT;
CREATE TEMPORARY TABLE `Aux$Case`(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO MiXeD_preserved_space_7_table_8 VALUES('',NULL,''),('b',2,0xff);
INSERT INTO `Aux$Case` SELECT id,id FROM t_undo_multi_base;
START TRANSACTION;
UPDATE MiXeD_preserved_space_7_table_8 SET n=1 WHERE k='';
UPDATE `Aux$Case` SET v=v+100;
DELETE FROM MiXeD_preserved_space_7_table_8 WHERE k='b';
INSERT INTO MiXeD_preserved_space_7_table_8 VALUES('c',3,0x00ff);
# Cross the insert/update stream boundary, then link another update predecessor.
UPDATE MiXeD_preserved_space_7_table_8 SET n=4 WHERE k='c';
UPDATE MiXeD_preserved_space_7_table_8 SET n=3 WHERE k='c';
DELETE FROM `Aux$Case` WHERE id=2;
INSERT INTO `Aux$Case` VALUES(2,555);
UPDATE t_undo_multi_base SET v=999 WHERE id=1;
--connection default
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;
--let _TEMP_UNDO_TRACE= $undo_trace
--perl
use strict;
use warnings;
open(my $fh, '<', $ENV{'_TEMP_UNDO_TRACE'}) or die "missing undo trace: $!";
my $trace = do { local $/; <$fh> };
close($fh);
die "SQL table attach and retry were not checked\n"
  unless $trace =~ /temporary receiver SQL attach checked tables=2 rows=66 retry=1/;
die "SQL definitions were not prepared before receiver readiness\n"
  unless $trace =~ /temporary receiver SQL metadata ready tables=2/;
die "impossible ownership count was not rejected before allocation\n"
  unless $trace =~ /temporary manifest claim count exceeds payload/;
die "two tables did not share one transferred image and undo\n"
  unless $trace =~ /temporary transfer input checked objects=2 rejected=16 pinned_after_cleanup=1 replacement_checked=1 wrong_pin_checked=1/;
die "receiver pipeline did not prepare and retire the complete owner\n"
  unless $trace =~ /temporary receiver pipeline checked tables=2 undo_records=71 batches=[1-9][0-9]* cancelled=1/;
EOF
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
--connection undo_app
--enable_query_log
SELECT COUNT(*)=2 AND SUM(k='' AND n=1 AND v='')=1
  AND SUM(k='c' AND n=3 AND v=0x00ff)=1 AS captured_key_ok FROM MiXeD_preserved_space_7_table_8;
SELECT COUNT(*)=64 AND SUM(v)=8933 AS captured_aux_ok FROM `Aux$Case`;
--disable_query_log
UPDATE MiXeD_preserved_space_7_table_8 SET v=0x1234 WHERE k='';
DELETE FROM `Aux$Case` WHERE id=64;
ROLLBACK;
--enable_query_log
SELECT COUNT(*)=2 AND SUM(k='' AND n IS NULL AND v='')=1
  AND SUM(k='b' AND n=2 AND v=0xff)=1 AS key_rollback_ok FROM MiXeD_preserved_space_7_table_8;
SELECT COUNT(*)=64 AND SUM(v)=2080 AS aux_rollback_ok FROM `Aux$Case`;
SELECT COUNT(*)=64 AND SUM(v)=20800 AS persistent_rollback_ok FROM t_undo_multi_base;
--disable_query_log
START TRANSACTION;
UPDATE MiXeD_preserved_space_7_table_8 SET n=7 WHERE k='';
UPDATE `Aux$Case` SET v=7 WHERE id=1;
UPDATE t_undo_multi_base SET v=7 WHERE id=1;
COMMIT;
--enable_query_log
SELECT n=7 AND v='' AS key_commit_ok FROM MiXeD_preserved_space_7_table_8 WHERE k='';
SELECT v=7 AS aux_commit_ok FROM `Aux$Case` WHERE id=1;
SELECT v=7 AS persistent_commit_ok FROM t_undo_multi_base WHERE id=1;
--disable_query_log
DROP TEMPORARY TABLE MiXeD_preserved_space_7_table_8, `Aux$Case`;
--disconnect undo_app
--connection default
DROP TABLE t_undo_multi_base;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
--eval SET GLOBAL debug='$saved_global_debug'
--enable_query_log

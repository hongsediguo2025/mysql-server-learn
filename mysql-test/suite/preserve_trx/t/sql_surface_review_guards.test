--source include/force_restart.inc

--let $restart_parameters= restart: --preserve-trx-enable=OFF
--source include/restart_mysqld.inc
--let $restart_parameters=

--disable_warnings
DROP USER IF EXISTS preserve_pfs_denied@localhost;
--enable_warnings

CREATE USER preserve_pfs_denied@localhost;
--connect(preserve_pfs_denied_con, localhost, preserve_pfs_denied,,test)
--error ER_TABLEACCESS_DENIED_ERROR
SELECT COUNT(*) FROM performance_schema.preserved_transactions;
--disconnect preserve_pfs_denied_con
--connection default

--error ER_PRESERVE_TRX_DISABLED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 60;

--error ER_PARSE_ERROR
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 1.5;

--error ER_PRESERVE_TRX_DISABLED
DRAIN TRANSACTIONS PRESERVE WITH USER VARS;

--error ER_PRESERVE_TRX_DISABLED
DRAIN TRANSACTIONS PRESERVE WITH NO USER VARS;

--error ER_PARSE_ERROR
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 1 WITH TIMEOUT 2;

--error ER_PRESERVE_TRX_DISABLED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 NO USER VARS;

--error ER_PRESERVE_TRX_DISABLED
DRAIN TRANSACTIONS PRESERVE NO USER VARS;

--error ER_PARSE_ERROR
DRAIN TRANSACTIONS PRESERVE WITH USER VARS WITH NO USER VARS;

--error ER_PARSE_ERROR
DRAIN TRANSACTIONS PRESERVE WITH NO USER VARS WITH USER VARS;

DROP USER preserve_pfs_denied@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON
--source include/restart_mysqld.inc
--let $restart_parameters=

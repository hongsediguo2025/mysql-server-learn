--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_implicit_lock_after_resume;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_implicit_lock_after_resume(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_implicit_lock_after_resume VALUES(1,10),(2,20);

START TRANSACTION;
INSERT INTO t_implicit_lock_after_resume VALUES(3,30);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

# Batch DRAIN preserves the native trx_id/Undo identity instead of converting
# the insert's implicit record ownership into a second explicit lock.
--replace_column 1 TOKEN
SELECT TOKEN, LOCKS_COUNT
  FROM performance_schema.preserved_transactions;

--connect(implicit_writer, localhost, root,,test)
SET innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t_implicit_lock_after_resume VALUES(3,31);

connection default;
--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

connection implicit_writer;
INSERT INTO t_implicit_lock_after_resume VALUES(3,31);
disconnect implicit_writer;

connection default;
SELECT * FROM t_implicit_lock_after_resume ORDER BY id;

DROP TABLE t_implicit_lock_after_resume;
SET GLOBAL preserve_trx_enable=ON;

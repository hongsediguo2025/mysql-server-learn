--source suite/preserve_trx/include/phase2_multistatement_setup.inc
CREATE TABLE t_multi_ddl(id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t_multi_ddl VALUES(1),(2);
--connect(multi_blocker,localhost,phase2_multi_app,,test)
BEGIN;
UPDATE t_phase2_multi SET v=10 WHERE id=1;
--connect(multi_waiter,localhost,phase2_multi_app,,test)
BEGIN;
SET DEBUG_SYNC='lock_wait_will_wait SIGNAL multi_ddl_waiting';
--send UPDATE t_phase2_multi SET v=v+1 WHERE id=1
--connection default
SET DEBUG_SYNC='now WAIT_FOR multi_ddl_waiting TIMEOUT 5';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die DDL blocker has no confirmed waiter
}
SET DEBUG_SYNC='phase2_sched_after_innodb_support_registered SIGNAL multi_ddl_support';
--send DRAIN TRANSACTIONS PRESERVE
--connection multi_ha
SET DEBUG_SYNC='now WAIT_FOR multi_ddl_support TIMEOUT 10';
--let $sync_warnings= `SELECT @@warning_count`
if ($sync_warnings)
{
  --die DDL blocker support was not proved
}
--connection multi_blocker
delimiter ||;
--send
ALTER TABLE t_multi_ddl ADD COLUMN c INT, ALGORITHM=INSTANT;
UPDATE t_phase2_multi SET v=900 WHERE id=3||
delimiter ;||
--enable_result_log
--enable_info
--error ER_PRESERVE_TRX_SESSION_DRAINED
--reap
--disable_info
--disable_result_log
--error ER_PRESERVE_TRX_SESSION_DRAINED
SELECT 1;
--connection multi_waiter
--reap
--connection default
--reap
--connection multi_ha
--let $data_ok= `SELECT (SELECT v=10 FROM t_phase2_multi WHERE id=1) AND (SELECT v=0 FROM t_phase2_multi WHERE id=3) AND (SELECT COUNT(*)=2 FROM t_multi_ddl WHERE c IS NULL)`
if (!$data_ok)
{
  --die DDL implicit commit or subsequent-statement cutoff was violated
}
--source suite/preserve_trx/include/phase2_multistatement_cleanup.inc
DROP TABLE t_multi_ddl;
--enable_result_log
--echo multi_statement_ddl_completed_and_next_update_cut_off

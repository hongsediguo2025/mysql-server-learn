--source include/not_log_bin.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TEMPORARY TABLE tmp_preserve_temp_autoinc(
  id INT AUTO_INCREMENT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

START TRANSACTION;
INSERT INTO tmp_preserve_temp_autoinc(v) VALUES(10),(20);

--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--let $preserve_trx_drain_error= ER_PRESERVE_TRX_UNSUPPORTED
--source suite/preserve_trx/include/drain_transaction_from_control_expect_error.inc

ROLLBACK;
DROP TEMPORARY TABLE tmp_preserve_temp_autoinc;

SET GLOBAL preserve_trx_temp_table_enable=ON;

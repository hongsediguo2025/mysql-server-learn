--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_binlog_compress_resume_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_binlog_compress_resume_failure(
  id INT PRIMARY KEY,
  payload TEXT
) ENGINE=InnoDB;
INSERT INTO t_binlog_compress_resume_failure VALUES(1, REPEAT('a', 1000));

SET SESSION binlog_transaction_compression=ON;
SET SESSION binlog_transaction_compression_level_zstd=10;
START TRANSACTION;
UPDATE t_binlog_compress_resume_failure
   SET payload=REPEAT('b', 1000)
 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_column 1 TOKEN
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE,
       BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
  FROM performance_schema.preserved_transactions;

SET SESSION binlog_transaction_compression=OFF;
SET SESSION binlog_transaction_compression_level_zstd=1;
SELECT @@session.binlog_transaction_compression AS compression_before_failed_resume;
SELECT @@session.binlog_transaction_compression_level_zstd AS compression_level_before_failed_resume;
SET SESSION debug="+d,preserve_trx_fail_resume_before_attach";

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SET SESSION debug="-d,preserve_trx_fail_resume_before_attach";
SELECT @@session.binlog_transaction_compression AS compression_after_failed_resume;
SELECT @@session.binlog_transaction_compression_level_zstd AS compression_level_after_failed_resume;
SELECT COUNT(*) AS remaining_preserved
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_SNAPSHOT_FILE
--file_exists $PRESERVED_BINLOG_CACHE_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT @@session.binlog_transaction_compression AS compression_after_successful_resume;
SELECT @@session.binlog_transaction_compression_level_zstd AS compression_level_after_successful_resume;
COMMIT;

SELECT id, LENGTH(payload) AS payload_length,
       SUBSTR(payload, 1, 1) AS payload_prefix
  FROM t_binlog_compress_resume_failure;

DROP TABLE t_binlog_compress_resume_failure;
SET GLOBAL preserve_trx_enable=ON;

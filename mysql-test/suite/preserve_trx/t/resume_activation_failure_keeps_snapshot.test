--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_resume_activation_failure;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

--disable_query_log
CALL mtr.add_suppression("Preserved transaction resume failed to validate ACTIVE Undo state");
--enable_query_log

CREATE TABLE t_resume_activation_failure(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_resume_activation_failure VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_resume_activation_failure WHERE a=1 FOR UPDATE;
UPDATE t_resume_activation_failure SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET SESSION debug="+d,preserve_trx_fail_activate_resumed";

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT @@transaction_isolation AS isolation_after_failed_resume;

SET SESSION debug="-d,preserve_trx_fail_activate_resumed";

--replace_result $preserved_token TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions;
--file_exists $PRESERVED_SNAPSHOT_FILE

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

COMMIT;
SELECT * FROM t_resume_activation_failure ORDER BY a;

DROP TABLE t_resume_activation_failure;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: failed to update durable transaction recovery count");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_recovered_count_rewrite_failclosed;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_recovered_count_rewrite_failclosed(
  a INT PRIMARY KEY,
  b INT
) ENGINE=InnoDB;
INSERT INTO t_recovered_count_rewrite_failclosed VALUES(1,10);

START TRANSACTION;
SELECT * FROM t_recovered_count_rewrite_failclosed WHERE a=1 FOR UPDATE;
UPDATE t_recovered_count_rewrite_failclosed SET b=11 WHERE a=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause= WITH TIMEOUT 300
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --debug=d,preserve_trx_fail_recovered_count_rewrite
--source include/start_mysqld.inc

SELECT COUNT(*) AS preserved_count_after_legacy_rewrite_debug
  FROM performance_schema.preserved_transactions;
--replace_column 1 TOKEN
SELECT TOKEN, RECOVERED_COUNT AS recovered_count_after_legacy_rewrite_debug
  FROM performance_schema.preserved_transactions;

--source suite/preserve_trx/include/get_preserved_token.inc

--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/restart_mysqld.inc

SELECT COUNT(*) AS preserved_count_after_second_restart
  FROM performance_schema.preserved_transactions;
--replace_column 1 TOKEN
SELECT TOKEN, RECOVERED_COUNT AS recovered_count_after_second_restart
  FROM performance_schema.preserved_transactions;

--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
COMMIT;
SELECT * FROM t_recovered_count_rewrite_failclosed ORDER BY a;

DROP TABLE t_recovered_count_rewrite_failclosed;
SET GLOBAL preserve_trx_enable=ON;

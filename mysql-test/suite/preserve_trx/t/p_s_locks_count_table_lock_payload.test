--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_p_s_locks_count_table_lock;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_p_s_locks_count_table_lock(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_p_s_locks_count_table_lock VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_p_s_locks_count_table_lock SET v=21 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT LOCKS_COUNT >= 2 AS locks_count_includes_table_payload
  FROM performance_schema.preserved_transactions;
SELECT COUNT(*) > 0 AS recovered_ix_table_locks
  FROM performance_schema.data_locks
  WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_p_s_locks_count_table_lock'
    AND LOCK_TYPE='TABLE'
    AND LOCK_MODE='IX'
    AND LOCK_STATUS='GRANTED';

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_p_s_locks_count_table_lock ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_p_s_locks_count_table_lock;
SET GLOBAL preserve_trx_enable=ON;

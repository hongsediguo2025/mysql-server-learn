--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");

--disable_warnings
DROP TABLE IF EXISTS t_batch_cleanup_no_shutdown;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_batch_cleanup_no_shutdown(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

--connect(batch_cleanup_no_shutdown_a,localhost,root,,test)
--connection batch_cleanup_no_shutdown_a
START TRANSACTION;
INSERT INTO t_batch_cleanup_no_shutdown VALUES(1,10);

--connect(batch_cleanup_no_shutdown_b,localhost,root,,test)
--connection batch_cleanup_no_shutdown_b
START TRANSACTION;
INSERT INTO t_batch_cleanup_no_shutdown VALUES(2,20);

--connection default
SET SESSION debug="+d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_reattach_original_thd";
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_batch_fail_after_one_target,preserve_trx_fail_reattach_original_thd";

SELECT 1 AS server_alive_after_cleanup_failure;
SELECT COUNT(*) AS preserved_cleanup_records
  FROM performance_schema.preserved_transactions
 WHERE STATE = 'PRESERVED'
   AND LAST_ERROR IS NOT NULL
   AND LAST_ERROR_AT IS NOT NULL;
--replace_column 1 TOKEN
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
  FROM performance_schema.preserved_transactions
 ORDER BY TOKEN;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

--connection batch_cleanup_no_shutdown_a
--source include/wait_until_disconnected.inc

--connection default
--error ER_WRONG_ARGUMENTS
SET GLOBAL preserve_trx_enable=OFF;

--connect(batch_cleanup_no_shutdown_new,localhost,root,,test)
--connection batch_cleanup_no_shutdown_new
INSERT INTO t_batch_cleanup_no_shutdown VALUES(99,99);
--disconnect batch_cleanup_no_shutdown_new

--connection batch_cleanup_no_shutdown_b
ROLLBACK;
--disconnect batch_cleanup_no_shutdown_b

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--shutdown_server
--source include/wait_until_disconnected.inc
--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_restart
  FROM performance_schema.preserved_transactions;
SELECT * FROM t_batch_cleanup_no_shutdown ORDER BY id;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_batch_cleanup_no_shutdown;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t_savepoint_payload;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_savepoint_payload(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_savepoint_payload VALUES (1, 10);

START TRANSACTION;
UPDATE t_savepoint_payload SET v = v + 1 WHERE id = 1;
SAVEPOINT sp1;
UPDATE t_savepoint_payload SET v = v + 1 WHERE id = 1;
SAVEPOINT sp2;

SET SESSION debug='+d,preserve_trx_debug_savepoint_payload_observable';
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION;
SET SESSION debug='-d,preserve_trx_debug_savepoint_payload_observable';

--replace_regex /payload_bytes=[0-9]+/payload_bytes=#/
SELECT TOKEN, STATE, LAST_ERROR
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-savepoint-payload-token';

ROLLBACK;

SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
  FROM performance_schema.preserved_transactions
  WHERE TOKEN='debug-savepoint-payload-token';
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';

DROP TABLE t_savepoint_payload;
SET GLOBAL preserve_trx_enable=ON;

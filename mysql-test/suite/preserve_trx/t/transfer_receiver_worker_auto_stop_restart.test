--source include/not_windows.inc
--source include/force_restart.inc

--disable_query_log

--let $credential_file= $MYSQL_TMP_DIR/standby-transfer-no-shutdown.secret
--write_file $credential_file
standby-transfer-no-shutdown-secret
EOF
--exec chmod 600 $credential_file

--connect(standby_transfer_receiver,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'standby-transfer-no-shutdown-secret';
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
GRANT PROCESS ON *.* TO preserve_trx_ha_admin@localhost;
SET GLOBAL preserve_trx_transfer_receiver_prewarm_timeout_ms=120000;
SET GLOBAL preserve_trx_token_retention_timeout_ms=120000;

--connection default
--disable_warnings
DROP USER IF EXISTS preserve_trx_ha_admin@localhost;
DROP USER IF EXISTS standby_transfer_app@localhost;
--enable_warnings
CREATE USER preserve_trx_ha_admin@localhost
  IDENTIFIED BY 'standby-transfer-no-shutdown-secret';
GRANT SHUTDOWN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO preserve_trx_ha_admin@localhost;
GRANT PRESERVE_TRX_TRANSFER_ADMIN ON *.*
  TO preserve_trx_ha_admin@localhost;
GRANT SELECT ON performance_schema.* TO preserve_trx_ha_admin@localhost;
GRANT PROCESS ON *.* TO preserve_trx_ha_admin@localhost;
CREATE USER standby_transfer_app@localhost;
GRANT SELECT, UPDATE ON test.* TO standby_transfer_app@localhost;

--let $restart_parameters= restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$SERVER_MYSOCK_2 --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=standby_transfer_no_shutdown --preserve-trx-transfer-credential-secret-file=$credential_file
--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log
--let $restart_parameters=
--disable_query_log

CALL mtr.add_suppression(
  "PRESERVE: rolled back prepared transaction without snapshot during recovery");

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;

--connect(standby_transfer_ha,localhost,preserve_trx_ha_admin,standby-transfer-no-shutdown-secret,test)

--connection default
--disable_warnings
DROP TABLE IF EXISTS t_standby_transfer_no_shutdown;
--enable_warnings
CREATE TABLE t_standby_transfer_no_shutdown(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_standby_transfer_no_shutdown VALUES(1,10);

--connect(standby_transfer_source,localhost,standby_transfer_app,,test)
START TRANSACTION;
UPDATE t_standby_transfer_no_shutdown SET v=11 WHERE id=1;

--connection default
--replace_column 1 GENERATION 3 SOURCE_ID 6 CLOSING_STARTED_US 7 CLOSING_DEADLINE_US
DRAIN TRANSACTIONS PRESERVE;

--connection standby_transfer_receiver
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
--source include/wait_condition.inc
SET @epoch_retained=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=1;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--source include/wait_condition.inc

SELECT @epoch_retained AS epoch_retained;
SELECT VARIABLE_VALUE=0 AS workers_stopped
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle';
--disable_query_log

--connection standby_transfer_ha
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-transfer-artifact-mode=STANDBY_TRANSFER_SAVE --preserve-trx-transfer-target-socket=$SERVER_MYSOCK_2 --preserve-trx-transfer-target-user=preserve_trx_ha_admin --preserve-trx-transfer-credential-name=standby_transfer_no_shutdown --preserve-trx-transfer-credential-secret-file=$credential_file" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;

--connect(standby_transfer_ha_second,localhost,preserve_trx_ha_admin,standby-transfer-no-shutdown-secret,test)

--connection standby_transfer_receiver
SET GLOBAL preserve_trx_transfer_prewarm_paused=ON;

--connect(standby_transfer_source_second,localhost,standby_transfer_app,,test)
START TRANSACTION;
UPDATE t_standby_transfer_no_shutdown SET v=12 WHERE id=1;

--connect(standby_transfer_control_second,localhost,root,,test)
--disable_result_log
DRAIN TRANSACTIONS PRESERVE;
--enable_result_log

--connection standby_transfer_receiver
SET @workers_restarted=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')>0;
SET GLOBAL preserve_trx_transfer_prewarm_paused=OFF;
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_queued_bytes')=0 AND (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_active')=0
--source include/wait_condition.inc
--let $wait_condition= SELECT (SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle')=0
--source include/wait_condition.inc
SET @two_epochs_retained=(
  SELECT VARIABLE_VALUE+0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_active_epochs')=2;
SELECT @workers_restarted AS workers_restarted;
SELECT VARIABLE_VALUE=0 AS workers_restopped
  FROM performance_schema.global_status
 WHERE VARIABLE_NAME='Preserve_trx_transfer_receiver_worker_idle';
SELECT @two_epochs_retained AS two_epochs_retained;

--connection standby_transfer_ha_second
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect
--disable_query_log

--connect(standby_transfer_cleanup,localhost,root,,test)
DROP TABLE t_standby_transfer_no_shutdown;
DROP USER preserve_trx_ha_admin@localhost;
DROP USER standby_transfer_app@localhost;

--connection standby_transfer_receiver
DROP USER preserve_trx_ha_admin@localhost;

--connection standby_transfer_cleanup
--remove_file $credential_file

--enable_query_log

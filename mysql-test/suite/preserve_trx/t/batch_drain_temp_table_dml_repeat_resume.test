--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;

CREATE TABLE t_temp_repeat_resume_base(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_temp_repeat_resume_base VALUES(1, 10);

--connect(temp_repeat_app, localhost, root,,test)
--connection temp_repeat_app
CREATE TEMPORARY TABLE tmp_temp_repeat_resume(
  id INT PRIMARY KEY,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO tmp_temp_repeat_resume VALUES(1, 100);
START TRANSACTION;
UPDATE tmp_temp_repeat_resume SET v = 101 WHERE id = 1;
UPDATE t_temp_repeat_resume_base SET v = 11 WHERE id = 1;

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --preserve-trx-lock-warmcopy-enable=OFF --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--connect(temp_repeat_resume_1, localhost, root,,test)
--connection temp_repeat_resume_1
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_temp_repeat_resume ORDER BY id;
UPDATE tmp_temp_repeat_resume SET v = 102 WHERE id = 1;
INSERT INTO tmp_temp_repeat_resume VALUES(2, 200);
UPDATE t_temp_repeat_resume_base SET v = 12 WHERE id = 1;

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --preserve-trx-lock-warmcopy-enable=OFF --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--connect(temp_repeat_resume_2, localhost, root,,test)
--connection temp_repeat_resume_2
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
SELECT * FROM tmp_temp_repeat_resume ORDER BY id;
COMMIT;
SELECT * FROM t_temp_repeat_resume_base ORDER BY id;
DROP TEMPORARY TABLE tmp_temp_repeat_resume;
--disconnect temp_repeat_resume_2

--connection default
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
DROP TABLE t_temp_repeat_resume_base;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

--source include/have_debug.inc
--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_implicit_lock_materialize_failclosed;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_implicit_lock_materialize_failclosed(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_implicit_lock_materialize_failclosed VALUES(1,10),(2,20);

START TRANSACTION;
INSERT INTO t_implicit_lock_materialize_failclosed VALUES(3,30);

SET SESSION debug="+d,preserve_trx_fail_materialize_implicit_locks";
--error ER_PRESERVE_TRX_UNSUPPORTED
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="-d,preserve_trx_fail_materialize_implicit_locks";

SELECT COUNT(*) AS inserted_row_visible_in_failed_preserve_trx
  FROM t_implicit_lock_materialize_failclosed
 WHERE id=3 AND v=30;
COMMIT;

SELECT * FROM t_implicit_lock_materialize_failclosed ORDER BY id;
SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_snapshot_file.inc

DROP TABLE t_implicit_lock_materialize_failclosed;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_log_bin.inc
--source include/force_restart.inc
--source include/have_debug.inc

# Isolate the 0x31 table-lock import path. The restart uses a debug flag that
# prevents record-lock import from rebuilding intention table locks, so the
# recovered TABLE IX below can only come from the table-lock TLV.

--disable_warnings
DROP TABLE IF EXISTS t_table_lock_tlv_import_isolated;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_table_lock_tlv_import_isolated(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_table_lock_tlv_import_isolated VALUES(1,10),(2,20);

START TRANSACTION;
UPDATE t_table_lock_tlv_import_isolated SET v=21 WHERE id=2;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--let $restart_parameters= restart: --preserve-trx-enable=ON --debug=d,preserve_trx_skip_record_lock_table_resurrect
--exec echo "$restart_parameters" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) > 0 AS recovered_ix_from_table_lock_tlv
  FROM performance_schema.data_locks
  WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_table_lock_tlv_import_isolated'
    AND LOCK_TYPE='TABLE'
    AND LOCK_MODE='IX'
    AND LOCK_STATUS='GRANTED';

SELECT COUNT(*) > 0 AS recovered_record_locks
  FROM performance_schema.data_locks
  WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_table_lock_tlv_import_isolated'
    AND LOCK_TYPE='RECORD'
    AND LOCK_STATUS='GRANTED';

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'
ROLLBACK;

SELECT * FROM t_table_lock_tlv_import_isolated ORDER BY id;

DROP TABLE t_table_lock_tlv_import_isolated;
SET GLOBAL preserve_trx_enable=ON;

--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--let MYSQLD_DATADIR= `SELECT @@datadir`

--disable_warnings
DROP TABLE IF EXISTS t_temp_legacy_undo_base;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_legacy_undo_base(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_temp_legacy_undo_base VALUES(1,10);

CREATE TEMPORARY TABLE tmp_legacy_undo(
  id INT PRIMARY KEY,
  v INT,
  KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_legacy_undo VALUES(1,100),(2,200);

START TRANSACTION;
UPDATE t_temp_legacy_undo_base SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
PREPARE SHUTDOWN PRESERVE TRANSACTION;
--source include/wait_until_disconnected.inc

--perl
use strict;
use warnings;
use Compress::Zlib qw(crc32);
use Digest::SHA qw(sha256);
use File::Copy qw(copy);
use File::Spec;

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
opendir(my $dh, $preserve_dir) or die "cannot open preserve dir: $!";
my @bins = sort grep { /\.bin$/ } readdir($dh);
closedir($dh);
die "expected one preserved snapshot, found " . scalar(@bins) unless @bins == 1;

my $bin_name = $bins[0];
my ($token) = $bin_name =~ /^(.*)\.bin$/;
die "bad snapshot name $bin_name" unless defined $token && length($token) > 0;
my $bin_path = File::Spec->catfile($preserve_dir, $bin_name);
my $orig_path = File::Spec->catfile($preserve_dir, "$bin_name.orig");
copy($bin_path, $orig_path) or die "cannot backup $bin_path: $!";

open(my $fh, '<:raw', $bin_path) or die "cannot read $bin_path: $!";
my $snapshot = do { local $/; <$fh> };
close($fh);

sub read_le16_at { return unpack('v', substr($_[0], $_[1], 2)); }
sub read_le32_at { return unpack('V', substr($_[0], $_[1], 4)); }
sub read_le64_at { return unpack('Q<', substr($_[0], $_[1], 8)); }
sub le16 { return pack('v', $_[0]); }
sub le32 { return pack('V', $_[0]); }
sub le64 { return pack('Q<', $_[0]); }
sub string_field {
  my ($value) = @_;
  return le32(length($value)) . $value;
}
sub read_string {
  my ($buf, $off_ref) = @_;
  my $len = read_le32_at($buf, $$off_ref);
  $$off_ref += 4;
  die "string outside manifest" if $$off_ref + $len > length($buf);
  my $value = substr($buf, $$off_ref, $len);
  $$off_ref += $len;
  return $value;
}
sub tlv {
  my ($tag, $value) = @_;
  return le16($tag) . le32(length($value)) . $value;
}

die "bad preserve magic" unless substr($snapshot, 0, 8) eq 'PTRXSNP1';
my $header_len = read_le16_at($snapshot, 10);
my $payload_len = read_le64_at($snapshot, 48);
my $payload = substr($snapshot, $header_len, $payload_len);

my @tlvs;
my $pos = 0;
my $manifest_index = -1;
while ($pos < length($payload)) {
  die "bad tlv boundary" if $pos + 6 > length($payload);
  my $tag = read_le16_at($payload, $pos);
  my $len = read_le32_at($payload, $pos + 2);
  $pos += 6;
  die "bad tlv length" if $pos + $len > length($payload);
  my $value = substr($payload, $pos, $len);
  push @tlvs, [$tag, $value];
  $manifest_index = $#tlvs if $tag == 0x80;
  $pos += $len;
}
die "missing temp manifest tlv" if $manifest_index < 0;

my $manifest = $tlvs[$manifest_index]->[1];
die "manifest too short" if length($manifest) < 20;
die "legacy test expects no existing temp undo descriptors"
  unless read_le32_at($manifest, length($manifest) - 4) == 0;

my $off = 0;
my $manifest_version = read_le32_at($manifest, $off); $off += 4;
my $table_count = read_le32_at($manifest, $off); $off += 4;
$off += 8;
die "unexpected manifest shape" unless $manifest_version >= 6 && $table_count == 1;
$off += 4;
read_string($manifest, \$off);
read_string($manifest, \$off);
read_string($manifest, \$off);
$off += 1;
read_string($manifest, \$off);
$off += 4;
my $source_space_id = read_le32_at($manifest, $off);
die "bad source space id" if $source_space_id == 0;

my $undo_payload = 'legacy-no-redo-undo-sidecar';
my $undo_name = "$token.tempts.$source_space_id.undo";
my $undo_path = File::Spec->catfile($preserve_dir, $undo_name);
open(my $uh, '>:raw', $undo_path) or die "cannot write legacy undo sidecar: $!";
print {$uh} $undo_payload;
close($uh);

my $undo_descriptor =
  le32($source_space_id) .
  string_field($undo_name) .
  le64(length($undo_payload)) .
  sha256($undo_payload) .
  le32($source_space_id) .
  le32(7) .
  le32(1);
substr($manifest, length($manifest) - 4, 4) = le32(1);
$manifest .= $undo_descriptor;
$tlvs[$manifest_index]->[1] = $manifest;

my $new_payload = join('', map { tlv($_->[0], $_->[1]) } @tlvs);
substr($snapshot, $header_len, $payload_len) = $new_payload;
substr($snapshot, 48, 8) = le64(length($new_payload));
substr($snapshot, 56, 8) = le64(0);

substr($snapshot, 516, 4) = "\0" x 4;
substr($snapshot, 516, 4) = le32(crc32($snapshot));

open(my $out, '>:raw', $bin_path) or die "cannot rewrite $bin_path: $!";
print {$out} $snapshot;
close($out);
EOF

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --preserve-trx-recovery-grace-seconds=30" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc

--replace_result $preserved_token TOKEN
--eval SELECT COUNT(*) AS preserved_count_before_legacy_undo_resume FROM performance_schema.preserved_transactions WHERE TOKEN = '$preserved_token'

--replace_result $preserved_token TOKEN
--error ER_PRESERVE_TRX_UNSUPPORTED
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

--replace_result $preserved_token TOKEN
--eval SELECT COUNT(*) AS preserved_count_after_legacy_undo_resume FROM performance_schema.preserved_transactions WHERE TOKEN = '$preserved_token'

--let $assert_text= Legacy no-redo undo sidecar is rejected before sidecar parse
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= preserved temporary table undo sidecar
--let $assert_count= 0
--source include/assert_grep.inc
--let $assert_count=

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SHUTDOWN;
--source include/wait_until_disconnected.inc

--perl
use strict;
use warnings;
use File::Copy qw(move);
use File::Spec;

my $datadir = $ENV{'MYSQLD_DATADIR'} or die "MYSQLD_DATADIR is not set";
my $preserve_dir = File::Spec->catdir($datadir, 'preserve');
opendir(my $dh, $preserve_dir) or die "cannot open preserve dir: $!";
my @orig = sort grep { /\.bin\.orig$/ } readdir($dh);
closedir($dh);
die "expected one original snapshot, found " . scalar(@orig) unless @orig == 1;
my $orig_path = File::Spec->catfile($preserve_dir, $orig[0]);
(my $bin_name = $orig[0]) =~ s/\.orig$//;
my $bin_path = File::Spec->catfile($preserve_dir, $bin_name);
move($orig_path, $bin_path) or die "cannot restore original snapshot: $!";
opendir($dh, $preserve_dir) or die "cannot reopen preserve dir: $!";
for my $name (readdir($dh)) {
  next unless $name =~ /\.tempts\.\d+\.undo$/;
  unlink File::Spec->catfile($preserve_dir, $name)
    or die "cannot remove legacy undo sidecar $name: $!";
}
closedir($dh);
EOF

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT * FROM tmp_legacy_undo ORDER BY id;
COMMIT;
SELECT * FROM t_temp_legacy_undo_base ORDER BY id;
DROP TEMPORARY TABLE tmp_legacy_undo;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_temp_legacy_undo_base;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

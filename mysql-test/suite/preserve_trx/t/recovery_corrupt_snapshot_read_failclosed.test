--source include/have_debug.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery deferred cleanup: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_recovery_corrupt_read;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let MYSQLD_DATADIR= `SELECT @@datadir`

CREATE TABLE t_recovery_corrupt_read(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_recovery_corrupt_read VALUES(1,10);

START TRANSACTION;
UPDATE t_recovery_corrupt_read SET v=11 WHERE id=1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $preserve_trx_drain_clause=
--source suite/preserve_trx/include/drain_transaction_from_control.inc
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--source suite/preserve_trx/include/assert_one_snapshot_file.inc

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= restart: --preserve-trx-enable=ON --skip-log-bin --debug=d,preserve_trx_simulate_preflight_snapshot_read_corrupt,preserve_trx_simulate_recover_snapshot_read_corrupt
--source include/start_mysqld.inc

SELECT * FROM t_recovery_corrupt_read ORDER BY id;
SELECT COUNT(*) AS preserved_count_after_corrupt_read
  FROM performance_schema.preserved_transactions;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_recovery_corrupt_read;
SET GLOBAL preserve_trx_enable=ON;

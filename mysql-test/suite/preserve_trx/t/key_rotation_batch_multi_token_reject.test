--source include/not_windows.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_key_rotation_batch;
--enable_warnings

--disable_query_log
CALL mtr.add_suppression("Preserved transaction .* recovery deferred cleanup: corrupt durable transaction snapshot");
CALL mtr.add_suppression("Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot");
CALL mtr.add_suppression("PRESERVE: failed to authenticate XID provenance before storage engine recovery");
CALL mtr.add_suppression("Aborting");
--enable_query_log

--let MYSQLD_DATADIR= `SELECT @@datadir`

SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_key_rotation_batch(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;

--connect(key_batch_app1,localhost,root,,test)
--connection key_batch_app1
START TRANSACTION;
INSERT INTO t_key_rotation_batch VALUES(1,10);

--connect(key_batch_app2,localhost,root,,test)
--connection key_batch_app2
START TRANSACTION;
INSERT INTO t_key_rotation_batch VALUES(2,20);

--connection default
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--perl
use strict;
use warnings;
use Digest::SHA qw(sha256);
use File::Copy qw(copy);
use File::Spec;

require File::Spec->catfile($ENV{'MYSQL_TEST_DIR'}, 'suite',
                            'preserve_trx', 'include',
                            'preserve_snapshot_files.pl');

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
my $key_backup = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp', 'key_rotation_batch_original.key');

my @snapshots = PreserveSnapshotFiles::preserve_snapshot_bin_files($dir);
die "expected two old-key snapshots before key replacement, found "
  . scalar(@snapshots) . "\n" unless @snapshots == 2;

copy($key, $key_backup) or die "cannot backup original key: $!";
chmod(0600, $key_backup) or die "cannot chmod original key backup: $!";

sub write_bound_preserve_key {
  my ($path, $hmac_key) = @_;
  die "bad replacement HMAC key length" unless length($hmac_key) == 32;
  my $auto_cnf = File::Spec->catfile($ENV{'MYSQLD_DATADIR'}, 'auto.cnf');
  open(my $ah, '<', $auto_cnf) or die "cannot read $auto_cnf: $!";
  my $auto_cnf_text = do { local $/; <$ah> };
  close($ah);
  $auto_cnf_text =~ /^server-uuid=([0-9a-fA-F-]{36})$/m
    or die "server-uuid not found in $auto_cnf";
  my $server_uuid = lc($1);
  my $normalized_preserve_dir = $dir;
  $normalized_preserve_dir .= '/'
    unless $normalized_preserve_dir =~ m{/$};
  my $payload =
    "MSPKEY1\0" .
    pack('v', 1) .
    $server_uuid .
    sha256($normalized_preserve_dir) .
    $hmac_key;
  open(my $key_fh, '>:raw', $path) or die "cannot replace key: $!";
  print {$key_fh} $payload;
  close($key_fh);
  chmod(0600, $path) or die "cannot chmod replacement key: $!";
}

write_bound_preserve_key($key, 'B' x 32);
print "batch key replaced before restart\n";
EOF

--let $_server_id= 1
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--let $restart_parameters= --preserve-trx-enable=ON --skip-log-bin --preserve-trx-recovery-max-count=10
--source include/start_mysqld_expecting_crash.inc

--let $grep_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern= PRESERVE: failed to authenticate XID provenance before storage engine recovery
--let $wait_timeout= 30
--source include/wait_for_pattern_in_file.inc
--source suite/preserve_trx/include/wait_for_expected_crash.inc

--perl
use strict;
use warnings;
use File::Copy qw(move);
use File::Spec;

my $dir = File::Spec->catdir($ENV{'MYSQLD_DATADIR'}, 'preserve');
my $key = File::Spec->catfile($dir, '.key');
my $key_backup = File::Spec->catfile(
  $ENV{'MYSQLTEST_VARDIR'}, 'tmp', 'key_rotation_batch_original.key');
unlink($key) or die "cannot remove replacement key: $!";
move($key_backup, $key) or die "cannot restore original key: $!";
chmod(0600, $key) or die "cannot chmod restored key: $!";
print "batch_old_key_restored_after_failclosed\n1\n";
EOF

--exec echo "restart: --preserve-trx-enable=ON --skip-log-bin --preserve-trx-recovery-max-count=10" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SELECT COUNT(*) AS preserved_count_after_key_failclosed
  FROM performance_schema.preserved_transactions;
--let $preserved_token_1= `SELECT TOKEN FROM performance_schema.preserved_transactions ORDER BY TOKEN LIMIT 1`
--let $preserved_token_2= `SELECT TOKEN FROM performance_schema.preserved_transactions ORDER BY TOKEN LIMIT 1 OFFSET 1`
--replace_result $preserved_token_1 TOKEN_1
--eval RESUME PRESERVED TRANSACTION '$preserved_token_1'
ROLLBACK;
--replace_result $preserved_token_2 TOKEN_2
--eval RESUME PRESERVED TRANSACTION '$preserved_token_2'
ROLLBACK;

SELECT COUNT(*) AS committed_rows_after_key_failclosed
  FROM t_key_rotation_batch;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_key_rotation_batch;
SET GLOBAL preserve_trx_enable=ON;

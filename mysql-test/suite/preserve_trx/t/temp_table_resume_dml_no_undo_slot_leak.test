--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_temp_resume_dml_base;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_temp_resume_dml_base(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_resume_dml_base VALUES(1,0);

CREATE TEMPORARY TABLE tmp_resume_dml_after_preserve(
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO tmp_resume_dml_after_preserve VALUES(0,0);

--let $cycle= 1
while ($cycle <= 12)
{
  START TRANSACTION;
  UPDATE t_temp_resume_dml_base SET v=v+1 WHERE id=1;
  --exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
  PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
  --source include/wait_until_disconnected.inc

  --exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
  --enable_reconnect
  --source include/wait_until_connected_again.inc
  --disable_reconnect

  --source suite/preserve_trx/include/get_preserved_token.inc
  --replace_result $preserved_token TOKEN
  --eval RESUME PRESERVED TRANSACTION '$preserved_token'
  --eval INSERT INTO tmp_resume_dml_after_preserve VALUES($cycle, $cycle * 10)
  UPDATE tmp_resume_dml_after_preserve SET v=v+1 WHERE id=0;
  COMMIT;

  --inc $cycle
}

SELECT * FROM t_temp_resume_dml_base ORDER BY id;
SELECT COUNT(*) AS temp_rows, SUM(v) AS temp_sum
  FROM tmp_resume_dml_after_preserve;

--let $expect_bin= 0
--let $expect_temp_sidecar_count= 1
--source suite/preserve_trx/include/assert_preserve_dir_files.inc

DROP TEMPORARY TABLE tmp_resume_dml_after_preserve;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc

DROP TABLE t_temp_resume_dml_base;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

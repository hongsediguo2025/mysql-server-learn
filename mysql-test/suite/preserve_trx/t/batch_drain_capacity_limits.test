--source include/not_log_bin.inc

--disable_warnings
DROP TABLE IF EXISTS t_batch_capacity;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;
--let $old_batch_max= `SELECT @@GLOBAL.preserve_trx_batch_max_transactions`
--let $old_max_total= `SELECT @@GLOBAL.preserve_trx_max_total`
--let $old_per_user= `SELECT @@GLOBAL.preserve_trx_max_pending_per_user`

CREATE TABLE t_batch_capacity(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;

--connect(batch_capacity_app1,localhost,root,,test)
--connection batch_capacity_app1
START TRANSACTION;
INSERT INTO t_batch_capacity VALUES(1,10);

--connect(batch_capacity_app2,localhost,root,,test)
--connection batch_capacity_app2
START TRANSACTION;
INSERT INTO t_batch_capacity VALUES(2,20);

--connection default
SET GLOBAL preserve_trx_batch_max_transactions=1;
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

SET GLOBAL preserve_trx_batch_max_transactions=256;
SET GLOBAL preserve_trx_max_total=1;
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

SET GLOBAL preserve_trx_max_total=256;
SET GLOBAL preserve_trx_max_pending_per_user=1;
--error ER_PRESERVE_TRX_UNSUPPORTED
DRAIN TRANSACTIONS PRESERVE;

SET GLOBAL preserve_trx_max_pending_per_user=256;

SELECT COUNT(*) AS preserved_count
  FROM performance_schema.preserved_transactions;

--connection batch_capacity_app1
UPDATE t_batch_capacity SET v=11 WHERE id=1;
COMMIT;
--disconnect batch_capacity_app1

--connection batch_capacity_app2
UPDATE t_batch_capacity SET v=21 WHERE id=2;
COMMIT;
--disconnect batch_capacity_app2

--connection default
SELECT * FROM t_batch_capacity ORDER BY id;

DROP TABLE t_batch_capacity;
SET GLOBAL preserve_trx_enable=ON;
--disable_query_log
--disable_result_log
--eval SET GLOBAL preserve_trx_batch_max_transactions=$old_batch_max
--eval SET GLOBAL preserve_trx_max_total=$old_max_total
--eval SET GLOBAL preserve_trx_max_pending_per_user=$old_per_user
--enable_result_log
--enable_query_log

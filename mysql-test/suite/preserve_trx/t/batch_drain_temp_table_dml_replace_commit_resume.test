--source include/not_log_bin.inc
--source include/force_restart.inc

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

CREATE TABLE t_batch_temp_replace(
  sid INT NOT NULL,
  k INT NOT NULL,
  v BIGINT NOT NULL,
  counter INT NOT NULL DEFAULT 0,
  amount DECIMAL(18,2) NOT NULL DEFAULT 0.00,
  d DATE NOT NULL,
  note VARCHAR(96),
  js JSON,
  payload VARCHAR(96),
  deleted TINYINT NOT NULL DEFAULT 0,
  g BIGINT GENERATED ALWAYS AS (v + sid) STORED,
  PRIMARY KEY(sid, k),
  UNIQUE KEY uq_sid_note(sid, note),
  KEY idx_sid_v(sid, v),
  KEY idx_sid_g(sid, g),
  KEY idx_sid_deleted(sid, deleted)
) ENGINE=InnoDB;
INSERT INTO t_batch_temp_replace
  (sid,k,v,counter,amount,d,note,js,deleted)
VALUES
  (1,33,1033,0,10.00,DATE '2026-05-21','seed-1-33',
   JSON_OBJECT('seed_sid',1,'seed_k',33),0);

--connect(app,localhost,root,,test)
CREATE TEMPORARY TABLE tmp_batch_temp_replace(
  id INT PRIMARY KEY,
  v INT NOT NULL,
  KEY(v)
) ENGINE=InnoDB;
SET @batch_temp_sid = 1;
START TRANSACTION;
INSERT INTO tmp_batch_temp_replace VALUES(1, 10);
UPDATE tmp_batch_temp_replace SET v = 11 WHERE id = 1;
REPLACE INTO tmp_batch_temp_replace VALUES(1, 12);
REPLACE INTO t_batch_temp_replace
  (sid,k,v,counter,amount,d,note,js,deleted)
VALUES
  (1,100003,10000003,3,33.33,DATE '2026-05-23',
   's001-t00001-n003',JSON_OBJECT('op','replace','stmt',3),0);

--connection default
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.threads WHERE PROCESSLIST_USER = 'root' AND PROCESSLIST_DB = 'test' AND PROCESSLIST_COMMAND = 'Sleep'
--source include/wait_condition.inc
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc

--exec echo "restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --skip-log-bin" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

SELECT COUNT(*), COALESCE(SUM(v),0) FROM tmp_batch_temp_replace;
REPLACE INTO t_batch_temp_replace
  (sid,k,v,counter,amount,d,note,js,deleted)
VALUES
  (1,100093,10000093,93,33.33,DATE '2026-05-23',
   's001-t00001-n093',JSON_OBJECT('op','replace','stmt',93),0);
COMMIT;

--connection default
SELECT sid,k,v,counter,note FROM t_batch_temp_replace ORDER BY sid,k;

DROP TEMPORARY TABLE tmp_batch_temp_replace;
DROP TABLE t_batch_temp_replace;
--source suite/preserve_trx/include/assert_no_preserve_residue.inc
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

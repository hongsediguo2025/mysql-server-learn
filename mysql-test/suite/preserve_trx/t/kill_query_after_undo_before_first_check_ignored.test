--source include/have_debug_sync.inc
--source include/not_log_bin.inc
--source include/force_restart.inc

--disable_warnings
DROP TABLE IF EXISTS t_preserve_kill_query_first_check;
--enable_warnings

SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE t_preserve_kill_query_first_check(a INT PRIMARY KEY, b INT)
  ENGINE=InnoDB;
INSERT INTO t_preserve_kill_query_first_check VALUES(1,10);

--connect(preserve_kill_query_first_check,localhost,root,,test)
--connection preserve_kill_query_first_check
--let $preserve_conn_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC =
  'preserve_trx_after_undo_prepared_before_kill_check SIGNAL after_undo_before_kill WAIT_FOR continue_after_undo_before_kill';
START TRANSACTION;
UPDATE t_preserve_kill_query_first_check SET b=12 WHERE a=1;
--send PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300

--connection default
--sleep 2
SET DEBUG_SYNC = 'now WAIT_FOR after_undo_before_kill TIMEOUT 10';
--replace_result $preserve_conn_id CONN_ID
--eval KILL QUERY $preserve_conn_id
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG_SYNC = 'now SIGNAL continue_after_undo_before_kill';

--connection preserve_kill_query_first_check
--reap
--disconnect preserve_kill_query_first_check

--connection default
--source suite/preserve_trx/include/wait_until_disconnected_allow_preserve_block.inc
--exec echo "restart: --preserve-trx-enable=ON" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--source suite/preserve_trx/include/get_preserved_token.inc
--replace_result $preserved_token TOKEN
--eval RESUME PRESERVED TRANSACTION '$preserved_token'

ROLLBACK;
SELECT * FROM t_preserve_kill_query_first_check WHERE a=1;

DROP TABLE t_preserve_kill_query_first_check;
SET GLOBAL preserve_trx_enable=ON;

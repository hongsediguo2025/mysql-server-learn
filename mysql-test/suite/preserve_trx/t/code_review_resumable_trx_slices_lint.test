die "pre-prepare reject paths after logged binlog export must route through reject_after_binlog_export\n"
  if $pre_prepare_post_binlog_export =~ /return\s+reject_unsupported_for_delivery\s*\(/s;

$temp_table =~ /bool preserve_trx_temp_table_build_baseline_image[\s\S]*?^}/m

         $temp_table_carrier =~ /write_warm_undo[\s\S]*length\s*>\s*temp_sidecar_max_read_bytes\s*\(\s*\)[\s\S]*atomic_write_file/s;
die "temp-table raw image builder must receive the temp sidecar byte budget before payload allocation\n"
  unless $temp_baseline_builder =~ /trx_preserve_temp_space_image_build_raw_sidecar_payload\s*\([\s\S]*preserve_trx_max_temp_sidecar_bytes/s &&
         $trx_temp_preserve =~ /raw_size\s*>\s*max_payload_bytes[\s\S]*payload->assign/s;
die "temp sidecar carrier must not read-limit by preserve_trx_max_binlog_cache_bytes\n"
  if $temp_table_carrier =~ /preserve_trx_max_binlog_cache_bytes/s;

$temp_table =~ /bool preserve_trx_temp_table_has_row_history[\s\S]*?^}/m

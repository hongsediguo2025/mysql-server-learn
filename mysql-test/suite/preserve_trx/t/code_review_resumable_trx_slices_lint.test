die "recover_all must mark force-recovery taint through Preserved_trx_store\n"
  unless $recover_all =~ /->mark_tainted\s*\(/s;
die "recover_all must remove taint markers through Preserved_trx_store\n"
  unless $recover_all =~ /->remove_taint\s*\(/s;
die "recover_all must not directly scan local files\n"
  if $recover_all =~ /\bmy_dir\s*\(/s;

$ha_innodb =~ /if\s*\(srv_force_recovery\s*>=\s*SRV_FORCE_NO_BACKGROUND\)[\s\S]*?return\s*;/m

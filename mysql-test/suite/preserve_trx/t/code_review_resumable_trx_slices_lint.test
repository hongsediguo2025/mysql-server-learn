  or die "GTID restore call sites must use preserve_snapshot_allows_gtid_restore\n";

$preserve =~ /Preserve_snapshot_metadata make_no_cache_metadata[\s\S]*?^}/m
  or die "could not isolate make_no_cache_metadata\n";
my $make_no_cache_metadata = $&;
die "new no-cache metadata must clear GTID restore fields\n"
  unless $make_no_cache_metadata =~ /metadata\.binlog_gtid_next\.clear\s*\(\s*\)/s &&

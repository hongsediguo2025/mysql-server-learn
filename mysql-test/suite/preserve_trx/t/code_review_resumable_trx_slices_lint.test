$temp_table_carrier =~ /seal_warm_image[\s\S]*?install_temp_file[\s\S]*?fsync_directory_after_install\s*\(\s*m_dir\s*,\s*sealed_path\s*\)/m
  or die "temp image seal must cleanup installed sidecar on post-install fsync failure\n";
$temp_table_carrier =~ /seal_warm_undo[\s\S]*?install_temp_file[\s\S]*?fsync_directory_after_install\s*\(\s*m_dir\s*,\s*sealed_path\s*\)/m
  or die "temp undo seal must cleanup installed sidecar on post-install fsync failure\n";
$temp_table_carrier =~ /bool shared_physical_image_matches[\s\S]*?^}/m

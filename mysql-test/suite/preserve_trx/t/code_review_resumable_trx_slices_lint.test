my $single_drain = $&;
die "single-trx drain must fail closed on system-thread RW transactions\n"
  unless $single_drain =~ /is_system_thread[\s\S]*m_has_unsupported_thread/s;
die "single-trx hard drain timeout test must be able to keep active transactions alive deterministically\n"
  unless $single_drain =~ /preserve_trx_drain_skip_kill_active/s;

$preserve =~ /bool preserve_trx_drain_other_active_transactions[\s\S]*?^}/m
  or die "could not isolate preserve_trx_drain_other_active_transactions\n";
my $single_drain_loop = $&;
die "single-trx hard drain must have a configurable absolute timeout\n"
  unless $single_drain_loop =~ /preserve_trx_drain_hard_timeout_ms/s &&
         $single_drain_loop =~ /hard_deadline_us/s &&
         $single_drain_loop =~ /ER_PRESERVE_TRX_DRAIN_TIMEOUT/s;
die "single-trx hard drain must arm its deadline when hard mode begins\n"
  unless $single_drain_loop =~ /auto\s+arm_hard_deadline/s &&
         $single_drain_loop =~ /if\s*\(\s*hard_drain\s*\)\s*arm_hard_deadline/s &&
         $single_drain_loop =~ /hard_drain\s*=\s*true\s*;[\s\S]*arm_hard_deadline/s;
$preserve =~
  /if\s*\(preserve_trx_drain_other_active_transactions\(target_thd\)\)\s*\{[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate single-trx drain failure branch\n";
my $single_drain_failure_branch = $&;
die "single-trx drain failure must preserve a specific hard-timeout error\n"
  unless $single_drain_failure_branch =~
         /target_thd->is_error\s*\(\s*\)[\s\S]*return\s+true/s;

$preserve =~
  /bool preserve_trx_kernel_preserve_attached_transaction\([\s\S]*?^}/m
  or die "could not isolate preserve_trx_kernel_preserve_attached_transaction\n";
my $preserve_kernel_kill_branch = $&;
die "preserve kernel kill checks must route through binlog/export cleanup helpers\n"
  if $preserve_kernel_kill_branch =~
     /if\s*\(\s*thd->killed\s*\)\s*\{\s*thd->send_kill_message\s*\(\s*\)\s*;\s*return\s+true\s*;\s*\}/s;

$preserve =~ /class Preserve_thd_context_switch[\s\S]*?^};/m
  or die "could not isolate Preserve_thd_context_switch\n";
my $context_switch = $&;
die "batch THD context switch must lock target THD data for the final attach guard\n"
  unless $context_switch =~ /LOCK_thd_data/ &&
         $context_switch =~ /preserve_trx_batch_state/;
die "batch THD context switch must restore ATTACHING targets on early return\n"
  unless $context_switch =~ /m_generation/s &&
         $context_switch =~ /Preserve_trx_batch_thd_state::ATTACHING[\s\S]*Preserve_trx_batch_thd_state::QUIESCED/s;

$preserve =~ /if\s*\(preserved_trx_record_resume_deadline_expired\(record\)\)[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate second resume deadline branch\n";
my $resume_deadline = $&;
die "second resume deadline branch must preserve timeout as LAST_ERROR before rollback\n"
  unless $resume_deadline =~ /preserve_trx_set_record_error|restore_record_after_resume_failure/s;

$preserve =~ /bool Sql_cmd_resume_preserved_transaction::execute\(THD \*thd\)[\s\S]*?^}/m
  or die "could not isolate Sql_cmd_resume_preserved_transaction::execute\n";
my $resume_execute = $&;
die "SQL RESUME wrapper must delegate to preserved_trx_resume_record_on_thd\n"
  unless $resume_execute =~ /preserved_trx_resume_record_on_thd\s*\(/s;
die "SQL RESUME wrapper must not directly run the large resume core\n"
  if $resume_execute =~ /preserved_trx_take_resumable_record\s*\(|restore_detached_mdl_context\s*\(|trx_preserve_attach_to_thd\s*\(/s;
$preserve =~ /static bool preserved_trx_resume_record_on_thd[\s\S]*?^}/m
  or die "could not isolate preserved_trx_resume_record_on_thd\n";
my $resume_core = $&;
my $deadline_pos = index($resume_core,
                         "preserved_trx_record_resume_deadline_expired(record)");
my $not_resumable_pos = index($resume_core, "if (!record.resumable)");
my $temp_preclaim_pos = index($resume_core,
                              "preserve_trx_temp_table_preclaim_decision");
die "resume deadline cleanup must run before non-resumable pending-token rejection\n"
  unless $deadline_pos >= 0 &&
         $not_resumable_pos >= 0 &&
         $deadline_pos < $not_resumable_pos;
die "resume deadline cleanup must run before temp-table retryable preclaim\n"
  unless $deadline_pos >= 0 &&
         $temp_preclaim_pos >= 0 &&
         $deadline_pos < $temp_preclaim_pos;

$preserve =~ /static bool rollback_resumable_record_after_resume_timeout[\s\S]*?^}/m
  or die "could not isolate rollback_resumable_record_after_resume_timeout\n";
my $resume_timeout_rollback = $&;
die "resume timeout rollback failure must be runtime injectable\n"
  unless $resume_timeout_rollback =~ /preserve_trx_fail_resume_timeout_rollback/s;

$preserve =~ /bool preserved_trx_add_record_with_error[\s\S]*?^}/m
  or die "could not isolate preserved_trx_add_record_with_error\n";
my $add_record_with_error = $&;
die "preserved_trx_add_record_with_error must set LAST_ERROR before publishing the record\n"
  unless $add_record_with_error =~
         /preserve_trx_set_record_error[\s\S]*g_preserved_trx_records\.push_back/s;
die "preserved_trx_add_record_with_error must not repair LAST_ERROR after publishing the record\n"
  if $add_record_with_error =~
     /g_preserved_trx_records\.push_back[\s\S]*preserved_trx_update_record_error/s;

$preserve =~ /static bool restore_record_after_resume_failure[\s\S]*?^}/m
  or die "could not isolate restore_record_after_resume_failure\n";
my $restore_record_after_resume_failure = $&;
die "resume failure record restore must atomically publish LAST_ERROR with the record\n"
  if $restore_record_after_resume_failure =~
     /preserved_trx_add_record[\s\S]*preserved_trx_update_record_error/s;

$preserve =~ /static void rollback_pending_token_delivery_record[\s\S]*?^}/m
  or die "could not isolate rollback_pending_token_delivery_record\n";
my $rollback_pending_token_delivery_record = $&;
die "token delivery rollback failure must atomically publish LAST_ERROR with the record\n"
  if $rollback_pending_token_delivery_record =~
     /preserved_trx_add_record[\s\S]*preserved_trx_update_record_error/s;

my $resume_execute_for_failure_guards = $resume_core;

$resume_execute_for_failure_guards =~ /if\s*\(restore_savepoints_to_thd[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate RESUME savepoint failure branch\n";
my $resume_savepoint_failure = $&;
die "RESUME savepoint failure branch must route through detach cleanup helper\n"
  unless $resume_savepoint_failure =~ /detach_resumed_after_failure/s &&
         $resume_savepoint_failure !~ /else\s*\{[\s\S]*thd_state_guard\.dismiss/s;

$resume_execute_for_failure_guards =~ /if\s*\(trx_preserve_activate_resumed\(record\.trx\)[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate RESUME activation failure branch\n";
my $resume_activation_failure = $&;
die "RESUME activation failure branch must route through detach cleanup helper\n"
  unless $resume_activation_failure =~
         /detach_resumed_after_failure/s &&
         $resume_activation_failure !~ /else\s*\{[\s\S]*thd_state_guard\.dismiss/s;

$resume_execute_for_failure_guards =~
  /auto detach_resumed_after_failure[\s\S]*?return true;\s*\n\s*\};/m
  or die "could not isolate RESUME detach failure cleanup helper\n";
my $resume_detach_failure_helper = $&;
die "RESUME detach cleanup helper must publish observable-only FAILED token before killing session\n"
  unless $resume_detach_failure_helper =~
         /preserved_trx_add_resume_detach_failure_observable_record[\s\S]*THD::KILL_CONNECTION/s;

$preserve =~ /bool preserve_trx_has_unsupported_transaction_contents[\s\S]*?^}/m
  or die "could not isolate preserve_trx_has_unsupported_transaction_contents\n";
my $unsupported_contents = $&;
die "unsupported transaction check must include STMT-scope non-transactional changes\n"
  unless $unsupported_contents =~ /has_modified_non_trans_table\s*\(\s*Transaction_ctx::STMT/s;
die "generic unsupported transaction check must leave temp row-history decisions to the temp-table manifest layer\n"
  if $unsupported_contents =~ /preserve_trx_temp_table_has_row_history/s;

my $unsupported_preflight_pos =
  index($preserve, 'const bool unsupported_transaction_contents =');
my $unsupported_call_pos = $unsupported_preflight_pos < 0 ? -1 :
  index($preserve,
        'preserve_trx_has_unsupported_transaction_contents(thd, binlog_state)',
        $unsupported_preflight_pos);
my $temp_preflight_pos = $unsupported_call_pos < 0 ? -1 :
  index($preserve, 'preserve_trx_temp_table_preflight_preserve(thd)',
        $unsupported_call_pos);
my $lock_preflight_stage_pos = $temp_preflight_pos < 0 ? -1 :
  index($preserve, 'set_stage(Preserve_trx_preserve_stage::LOCK_PREFLIGHT)',
        $temp_preflight_pos);
die "unsupported transaction contents must be rejected before preserve lock/prepare flow\n"
  unless $unsupported_preflight_pos >= 0 && $unsupported_call_pos >= 0 &&
         $temp_preflight_pos >= 0 && $lock_preflight_stage_pos >= 0 &&
         $unsupported_call_pos < $temp_preflight_pos &&
         $temp_preflight_pos < $lock_preflight_stage_pos;
my $prelock_preserve_window =
  substr($preserve, $unsupported_preflight_pos,
         $lock_preflight_stage_pos - $unsupported_preflight_pos);
die "unsupported transaction contents must fail closed before preserve lock/prepare flow\n"
  unless $prelock_preserve_window =~
         /return\s+reject_after_binlog_export\s*\(\s*"unsupported_transaction_contents"\s*\)/s;
die "temp-table preflight failure must fail closed before preserve lock/prepare flow\n"
  unless $prelock_preserve_window =~
         /temp_preflight_status\s*!=\s*Preserve_snapshot_status::OK[\s\S]*return\s+reject_after_binlog_export\s*\(/s;

$preserve =~ /bool no_cache_gtid_state_is_clean[\s\S]*?^}/m
  or die "could not isolate no_cache_gtid_state_is_clean\n";
my $no_cache_gtid = $&;
die "no-cache GTID preserve must fail closed for GTID_NEXT_LIST ownership\n"
  unless $no_cache_gtid =~ /get_gtid_next_list/s &&
         $no_cache_gtid =~ /OWNED_SIDNO_GTID_SET/s;
die "no-cache GTID preserve must require GTID_NEXT=AUTOMATIC\n"
  unless $no_cache_gtid =~ /gtid_next\.type\s*!=\s*AUTOMATIC_GTID/s;
my $gtid_next_list_ifdef_start = index($no_cache_gtid, '#ifdef HAVE_GTID_NEXT_LIST');
my $gtid_next_list_ifdef_end =
  $gtid_next_list_ifdef_start < 0 ? -1 :
  index($no_cache_gtid, '#endif', $gtid_next_list_ifdef_start);
my $owned_sidno_pos = index($no_cache_gtid, 'OWNED_SIDNO_GTID_SET');
die "OWNED_SIDNO_GTID_SET rejection must not depend on HAVE_GTID_NEXT_LIST\n"
  if $gtid_next_list_ifdef_start >= 0 && $gtid_next_list_ifdef_end >= 0 &&
     $owned_sidno_pos > $gtid_next_list_ifdef_start &&
     $owned_sidno_pos < $gtid_next_list_ifdef_end;

$preserve =~ /bool preserve_snapshot_allows_gtid_restore[\s\S]*?^}/m
  or die "could not isolate preserve_snapshot_allows_gtid_restore\n";
my $gtid_restore_gate = $&;
die "GTID restore gate must allow only LOGGED_WITH_CACHE snapshots with GTID metadata\n"
  unless $gtid_restore_gate =~ /LOGGED_WITH_CACHE/s &&
         $gtid_restore_gate =~ /!\s*metadata\.binlog_gtid_next\.empty/s;
$preserve !~ /if\s*\(\s*!\s*record\.metadata\.binlog_gtid_next\.empty\s*\(\s*\)\s*\)\s*\{[\s\S]*?restore_logged_cache_gtid_next/s
  or die "GTID restore call sites must use preserve_snapshot_allows_gtid_restore\n";

$preserve =~ /Preserve_snapshot_metadata make_no_cache_metadata[\s\S]*?^}/m
  or die "could not isolate make_no_cache_metadata\n";
my $make_no_cache_metadata = $&;
die "new no-cache metadata must clear GTID restore fields\n"
  unless $make_no_cache_metadata =~ /metadata\.binlog_gtid_next\.clear\s*\(\s*\)/s &&
         $make_no_cache_metadata =~ /metadata\.binlog_owned_gtid\.clear\s*\(\s*\)/s;
die "new no-cache metadata must not serialize THD GTID_NEXT text\n"
  if $make_no_cache_metadata =~ /gtid_next\.to_string|metadata\.binlog_gtid_next\.assign/s;

$bundle =~ /std::vector<Preserve_snapshot_tlv> no_cache_tlvs[\s\S]*?^}/m
  or die "could not isolate no_cache_tlvs\n";
my $no_cache_tlvs = $&;
die "new no-cache snapshots must not emit GTID restore metadata TLV\n"
  if $no_cache_tlvs =~ /kTlvBinlogNoCacheMetadata/s;

$preserve =~ /if\s*\(trx_preserve_export_read_view[\s\S]*?preserve_trx_reject_unsupported\s*\(\s*\)/m
  or die "preserve flow must reject ReadView export failure before durable point\n";
$trx_preserve =~ /dberr_t trx_preserve_export_read_view[\s\S]*?^}/m
  or die "could not isolate trx_preserve_export_read_view\n";
my $read_view_export = $&;
die "ReadView export failure must have an injectable debug point\n"
  unless $read_view_export =~ /preserve_trx_fail_export_read_view/s;
die "ReadView export failure must fail closed\n"
  unless $read_view_export =~ /preserve_trx_fail_export_read_view[\s\S]*return\s+DB_ERROR/s &&
         $read_view_export =~ /preserve_export_view[\s\S]*return\s+DB_ERROR/s;
$trx_preserve =~ /dberr_t trx_preserve_import_read_view[\s\S]*?^}/m
  or die "could not isolate trx_preserve_import_read_view\n";
my $read_view_import = $&;
die "ReadView import must reject future system bounds before MVCC import\n"
  unless $read_view_import =~ /trx_sys_get_next_trx_id_or_no/s &&
         $read_view_import =~ /snapshot\.low_limit_no\s*>\s*next_trx_id_or_no/s &&
         $read_view_import =~ /snapshot\.low_limit_id\s*>\s*next_trx_id_or_no/s;
$trx_preserve =~ /static bool trx_preserve_parse_read_view_payload[\s\S]*?^}/m
  or die "could not isolate trx_preserve_parse_read_view_payload\n";
my $read_view_parse = $&;
die "ReadView payload validation must reject zero low_limit_no\n"
  unless $read_view_parse =~ /snapshot->low_limit_no\s*==\s*0/s;
$bundle =~ /bool read_view_payload_is_valid[\s\S]*?^}/m
  or die "could not isolate read_view_payload_is_valid\n";
my $bundle_read_view_parse = $&;
die "bundle ReadView payload validation must reject zero low_limit_no before writing durable snapshots\n"
  unless $bundle_read_view_parse =~ /view_low_limit_no\s*==\s*0/s;

$carrier_file =~ /bool write_tainted_marker[\s\S]*?^}/m
  or die "could not isolate write_tainted_marker\n";
my $taint_writer = $&;
die "force recovery taint marker must have an injectable failure point\n"
  unless $taint_writer =~ /preserve_trx_fail_write_tainted_marker/s;

$preserve =~ /bool preserved_trx_recover_all[\s\S]*?if\s*\(srv_force_recovery\s*>\s*0\)[\s\S]*?files are retained and marked tainted[\s\S]*?return\s+false\s*;/m
  or die "could not isolate force-recovery taint branch\n";
my $force_taint_branch = $&;
die "force recovery must fail closed when taint marker persistence fails\n"
  unless $force_taint_branch =~ /taint_error/s &&
         $force_taint_branch =~ /return\s+true\s*;/s;
die "force recovery taint marker failure must retain snapshot evidence\n"
  if $force_taint_branch =~ /remove_with_status\s*\(/s;

my $preflight_pos = index($mysqld, 'preserved_trx_preflight_recoverability()');
die "could not isolate startup preserve-trx preflight call\n"
  if $preflight_pos < 0;
$mysqld =~ /if\s*\([\s\S]{0,240}preserved_trx_preflight_recoverability\s*\(\s*\)[\s\S]{0,80}\)\s*\{\s*unireg_abort/m
  or die "could not isolate startup preserve-trx preflight condition\n";
my $preflight_window = $&;
die "startup preserve-trx preflight must run even when --skip-log-bin is used\n"
  if $preflight_window =~ /\bopt_bin_log\b/s;

$preserve =~ /Preserve_trx_command_block_result preserved_trx_protocol_command_block_result[\s\S]*?^}/m
  or die "could not isolate preserved_trx_protocol_command_block_result\n";
my $protocol_command_gate = $&;
die "protocol command gate must block COM_FIELD_LIST and COM_REFRESH when drain is blocking lock-taking commands\n"
  unless $protocol_command_gate =~ /preserve_trx_protocol_command_may_create_trx_or_lock/s &&
         $preserve =~ /case\s+COM_FIELD_LIST\s*:/s &&
         $preserve =~ /case\s+COM_REFRESH\s*:/s &&
         $protocol_command_gate =~ /BLOCK_DRAINING/s;
$sql_parse =~ /bool dispatch_command\(THD \*thd, const COM_DATA \*com_data,[\s\S]*?^}/m
  or die "could not isolate dispatch_command\n";
my $dispatch_command = $&;
my $protocol_gate_pos =
  index($dispatch_command, 'preserved_trx_protocol_command_block_result');
my $dispatch_switch_pos = index($dispatch_command, 'switch (command)');
die "dispatch_command must run preserve protocol command gate before the protocol switch\n"
  unless $protocol_gate_pos >= 0 && $dispatch_switch_pos >= 0 &&
         $protocol_gate_pos < $dispatch_switch_pos &&
         $dispatch_command =~ /ER_PRESERVE_TRX_UNSUPPORTED/s &&
         $dispatch_command =~ /ER_PRESERVE_TRX_SESSION_DRAINED/s;

$preserve =~ /static bool recover_preserved_snapshot[\s\S]*?^}/m
  or die "could not isolate recover_preserved_snapshot\n";
my $recover_snapshot = $&;
die "recovery must read durable snapshots through Preserved_trx_store\n"
  unless $preserve =~
         /Preserve_snapshot_status\s+preserved_trx_load_bundle_for_recover_or_prewarm[\s\S]*create_preserved_trx_default_store[\s\S]*->read\s*\(/s &&
         $recover_snapshot =~ /preserved_trx_load_bundle_for_recover_or_prewarm/s;
die "recovery must read semantic external payloads without eager-loading logged binlog cache payload while registering preserved snapshots\n"
  unless $recover_snapshot =~
         /preserved_trx_load_bundle_for_recover_or_prewarm[\s\S]*Preserved_trx_recover_load_profile::WITH_SEMANTIC_EXTERNAL_BLOBS[\s\S]*&bundle/s;
die "startup recovery must persist recovery attempts through a batch ledger\n"
  unless $preserve =~ /preserved_trx_recovery_attempt_ledger/s &&
         $recover_snapshot =~ /recovery_attempt_count/s;
die "startup recovery must not rewrite each snapshot recovered_count in the hot path\n"
  if $recover_snapshot =~ /recovered_count_rewrite_after_claim/s;
my $shared_recover_adopt_start =
  index($preserve, 'static bool preserved_trx_recover_or_adopt_bundle_shared');
my $recover_snapshot_start =
  index($preserve, 'static bool recover_preserved_snapshot');
die "could not isolate preserved_trx_recover_or_adopt_bundle_shared\n"
  unless $shared_recover_adopt_start >= 0 &&
         $recover_snapshot_start > $shared_recover_adopt_start;
my $shared_recover_adopt_kernel =
  substr($preserve, $shared_recover_adopt_start,
         $recover_snapshot_start - $shared_recover_adopt_start);
my $recover_add_record_pos =
  index($shared_recover_adopt_kernel, 'preserved_trx_add_record');
my $recover_claim_pos =
  index($shared_recover_adopt_kernel, 'trx_preserve_claim_prepared');
die "recovery must claim the prepared transaction before publishing the recovered record\n"
  unless $recover_add_record_pos >= 0 && $recover_claim_pos >= 0 &&
         $recover_claim_pos < $recover_add_record_pos;
die "recovery must not call legacy raw snapshot read/rewrite helpers\n"
  if $recover_snapshot =~ /preserved_trx_read_snapshot|read_snapshot_with_identity_check|rewrite_snapshot_recovered_count/s;
die "recovery max-count cleanup must leave a FAILED observable P_S record\n"
  unless $recover_snapshot =~
         /metadata\.recovered_count\s*>=\s*preserve_trx_recovery_max_count[\s\S]*?preserved_trx_add_failed_observable_record\s*\(\s*metadata\s*,\s*"recovery max count exceeded"\s*\)[\s\S]*?rollback_preserved_snapshot_or_log/s;
die "recovery timeout cleanup must leave a FAILED observable P_S record\n"
  unless $recover_snapshot =~
         /if\s*\(\s*recovery_deadline_expired\s*\)[\s\S]*?preserved_trx_add_failed_observable_record\s*\(\s*metadata\s*,\s*"recovery timeout expired"\s*\)[\s\S]*?rollback_preserved_snapshot_or_log/s;

die "recovered-count offset must not be duplicated in carrier\n"
  if $carrier =~ /kRecoveredCountOffset\s*=/;
die "carrier recovered-count rewrite must use bundle-owned header offset\n"
  unless $carrier =~ /preserve_trx_bundle_recovered_count_offset\s*\(\s*\)/s;

$carrier_file =~ /bool create_key[\s\S]*?^}/m
  or die "could not isolate create_key\n";
my $carrier_create_key = $&;
die "carrier key tmp creation must use O_CREAT and O_EXCL\n"
  unless $carrier_create_key =~ /my_create\s*\([^;]*O_CREAT[^;]*O_EXCL/s;
die "carrier key tmp creation must reject preexisting tmp symlinks\n"
  unless $carrier_create_key =~ /path_is_symlink\s*\(\s*tmp_path\s*\)/s;

$bundle =~ /Preserve_snapshot_status encode_preserved_trx_bundle[\s\S]*?^}/m
  or die "could not isolate encode_preserved_trx_bundle\n";
my $snapshot_encode = $&;
die "snapshot encode must reject empty runtime server_uuid before durable write\n"
  unless $snapshot_encode =~ /context\.server_uuid\.empty\s*\(\s*\)[\s\S]*?Preserve_snapshot_status::INVALID_ARGUMENT/s;

$bundle =~ /Preserve_snapshot_status decode_preserved_trx_snapshot_bytes[\s\S]*?^}/m
  or die "could not isolate decode_preserved_trx_snapshot_bytes\n";
my $snapshot_decode = $&;
die "snapshot identity validation must reject empty runtime server_uuid\n"
  unless $snapshot_decode =~ /context\.server_uuid\.empty\s*\(\s*\)[\s\S]*?Preserve_snapshot_status::CORRUPT/s;
die "snapshot identity validation must compare runtime server_uuid unconditionally after empty check\n"
  unless $snapshot_decode =~ /read_fixed_string\s*\([^;]*kServerUuidOffset[\s\S]*!=\s*context\.server_uuid/s;

$drain =~ /Preserve_trx_drain_orchestrator::observations[\s\S]*?^}/m
  or die "drain orchestrator must expose participant observations\n";
my $drain_observations = $&;
die "drain orchestrator observations must read every participant observation\n"
  unless $drain_observations =~ /participant->observation\s*\(\s*\)/s;

$preserve =~ /static void log_preserve_trx_drain_participant_observations[\s\S]*?^}/m
  or die "drain participant observations must be emitted to production logs\n";
my $drain_observation_logger = $&;
die "drain participant observation log must include state and bytes fields\n"
  unless $drain_observation_logger =~ /state=/s &&
         $drain_observation_logger =~ /bytes_used=/s &&
         $drain_observation_logger =~ /bytes_budget=/s &&
         $drain_observation_logger =~ /failure_reason=/s;

$preserve =~ /bool Preserve_trx_drain_service::execute[\s\S]*?^}/m
  or die "could not isolate DRAIN service implementation\n";
my $drain_execute = $&;
die "DRAIN abort paths must consume participant observations\n"

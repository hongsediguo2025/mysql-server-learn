$preserve =~
  /if\s*\(preserve_trx_drain_other_active_transactions\(target_thd\)\)\s*\{[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate single-trx drain failure branch\n";
my $single_drain_failure_branch = $&;
die "single-trx drain failure must preserve a specific hard-timeout error\n"

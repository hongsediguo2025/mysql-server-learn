         $preserve =~ /listing\.stale_tmp_tokens/s &&
         $preserve =~ /delete_stale_tmp_files_or_log[\s\S]*heavy_cleanup/s;
my $bundle_doc_matches =
  $bundle_doc eq '' ||
  ($bundle_doc =~ /Format Version 8 and TLV Extensions/s &&
   $bundle_doc =~ /0x81[\s\S]*kTlvExternalBlobDescriptors/s &&
   $bundle_doc =~ /> 8/s);
die "TLV registry source contract must keep the current writer format and multi-blob descriptor tag\n"
  unless $bundle =~ /constexpr uint16_t kSnapshotFormatVersion\s*=\s*8\s*;/s &&
         $bundle =~ /constexpr uint16_t kTlvExternalBlobDescriptors\s*=\s*0x81\s*;/s &&
         $bundle =~ /format_version\s*<\s*8[\s\S]*kTlvExternalBlobDescriptors/s &&
         $bundle_doc_matches;
die "SQL savepoint validator must bound binlog positions and event counters by snapshot metadata\n"
  unless $bundle =~
         /bool sql_savepoints_payload_is_valid[\s\S]*max_binlog_position[\s\S]*max_binlog_event_counter[\s\S]*binlog_position\s*>\s*max_binlog_position[\s\S]*checkpoint_event_counter\s*>\s*max_binlog_event_counter/s &&
         $bundle =~
         /sql_savepoints_payload_is_valid\s*\(\s*metadata\.sql_savepoints_payload[\s\S]*metadata\.binlog_cache_size[\s\S]*metadata\.binlog_cache_event_counter/s &&
         $gunit =~ /BinlogSavepointPositionCannotExceedPayload/s &&
         $gunit =~ /BinlogSavepointEventCounterCannotExceedCache/s;
die "startup recovery success must emit an audit event\n"
  unless $shared_recover_adopt_kernel =~
         /audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*local_startup\s*\?\s*"recover"\s*:\s*"promotion-adopt"\s*,\s*"success"\s*\)/s;
die "startup recovery and promotion prewarm must share bundle load helper\n"
  unless $preserve =~
         /Preserve_snapshot_status\s+preserved_trx_load_bundle_for_recover_or_prewarm/s &&
         $preserve =~
         /recover_preserved_snapshot[\s\S]*preserved_trx_load_bundle_for_recover_or_prewarm/s &&
         $promotion =~
         /preserved_trx_promotion_prewarm_standby_pending_token[\s\S]*preserved_trx_load_bundle_for_recover_or_prewarm/s;
die "startup recovery and promotion prewarm must share side-effect-free dry validation\n"
  unless $preserve =~
         /Preserve_snapshot_status\s+preserved_trx_dry_validate_loaded_bundle/s &&
         $preserve =~
         /recover_preserved_snapshot[\s\S]*preserved_trx_dry_validate_loaded_bundle/s &&
         $promotion =~
         /preserved_trx_promotion_prewarm_standby_pending_token[\s\S]*prewarm_loaded_bundle_into_ready_cache/s &&
         $promotion =~
         /prewarm_loaded_bundle_into_ready_cache[\s\S]*preserved_trx_dry_validate_loaded_bundle/s;

my $resume_execute_audit = $resume_core;
die "successful RESUME must emit an audit event\n"
  unless $resume_execute_audit =~
         /audit_preserved_trx_event\s*\(\s*thd\s*,\s*token\s*,\s*"resume"\s*,\s*"success"\s*\)/s;
die "RESUME must revalidate durable carrier contents before attaching the preserved transaction\n"
  unless $resume_execute_audit =~
         /store->read\s*\(\s*token\s*,\s*true\s*,\s*Preserved_trx_carrier::Payload_read_mode::\s*METADATA_ONLY\s*,\s*&durable_bundle\s*\)[\s\S]*durable_status\s*==\s*Preserve_snapshot_status::CORRUPT[\s\S]*rollback_resumable_record_after_corrupt_snapshot[\s\S]*my_error\s*\(\s*ER_PRESERVE_TRX_CORRUPT_SNAPSHOT/s;
die "RESUME not-found privilege probe must not load external blob payloads\n"
  unless $resume_execute_audit =~
         /token_is_filename_safe\s*\(\s*token\s*\)[\s\S]*store->read\s*\(\s*token\s*,\s*true\s*,\s*Preserved_trx_carrier::Payload_read_mode::\s*METADATA_ONLY\s*,\s*&bundle\s*\)/s;
my $resume_take_pos = index($resume_execute_audit,
                            'preserved_trx_take_resumable_record');
die "RESUME must not full-read durable carrier before claiming the record\n"
  if $resume_take_pos > 0 &&
     substr($resume_execute_audit, 0, $resume_take_pos) =~
       /store->read\s*\(\s*token\s*,\s*true\s*,\s*&/s;

$preserve =~ /static void rollback_pending_token_delivery_record[\s\S]*?^}/m
  or die "could not isolate rollback_pending_token_delivery_record\n";
my $token_delivery_rollback = $&;
die "token-delivery failure rollback must emit an audit event\n"
  unless $token_delivery_rollback =~
         /audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"rollback"/s;

die "recovery failure rollback must emit an audit event\n"
  unless $preserve =~
         /static bool rollback_preserved_snapshot_or_log[\s\S]*?audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"rollback"/s &&
         $preserve =~
         /static bool rollback_claimed_preserved_snapshot_or_log[\s\S]*?audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"rollback"/s;
die "resume-timeout rollback must emit an audit event\n"
  unless $resume_timeout_rollback =~
         /audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*record\.metadata\.token\s*,\s*"rollback"\s*,\s*"timeout"/s;
die "resume corrupt-snapshot rollback must emit an audit event\n"
  unless $preserve =~
         /static bool rollback_resumable_record_after_corrupt_snapshot[\s\S]*?audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*record\.metadata\.token\s*,\s*"rollback"\s*,\s*"failure"/s;
$transfer =~
  /static bool preserve_trx_transfer_source_endpoint_ready\(\)[\s\S]*?^}/m
  or die "could not isolate preserve_trx_transfer_source_endpoint_ready\n";
my $transfer_endpoint_ready = $&;
$transfer =~
  /Preserve_trx_transfer_artifact_decision\s+preserve_trx_transfer_artifact_decision\(\)[\s\S]*?^}/m
  or die "could not isolate preserve_trx_transfer_artifact_decision\n";
my $transfer_artifact_decision = $&;
die "standby-transfer artifact decision must require a configured source endpoint before entering STANDBY_TRANSFER_SAVE\n"
  unless $transfer_endpoint_ready =~
         /preserve_trx_transfer_target_host[\s\S]*preserve_trx_transfer_target_port[\s\S]*preserve_trx_transfer_target_socket[\s\S]*preserve_trx_transfer_target_server_uuid[\s\S]*preserve_trx_transfer_target_user[\s\S]*preserve_trx_transfer_credential_name/s &&
         $transfer_artifact_decision =~
         /preserve_trx_transfer_source_endpoint_ready\s*\(\s*\)[\s\S]*UNSUPPORTED[\s\S]*STANDBY_TRANSFER_SAVE/s &&
         $transfer =~
         /preserve_trx_transfer_make_configured_frame_sink[\s\S]*preserve_trx_transfer_source_endpoint_ready\s*\(\s*\)[\s\S]*UNSUPPORTED/s;
$transfer =~
  /Preserve_trx_transfer_artifact_decision\s+preserve_trx_transfer_artifact_decision_for_request[\s\S]*?^}/m
  or die "could not isolate preserve_trx_transfer_artifact_decision_for_request\n";
my $transfer_artifact_decision_for_request = $&;
die "standby-transfer request decision must allow STANDBY_TRANSFER_SAVE only for batch manager delivery\n"
  unless $transfer_artifact_decision_for_request =~
         /STANDBY_TRANSFER_SAVE[\s\S]*BATCH_MANAGER_DELIVERY[\s\S]*UNSUPPORTED/s;
die "portable transfer manifest must use the explicit numeric transfer token, not bundle metadata token\n"
  if $transfer =~ /built_manifest\.token\s*=\s*bundle\.metadata\.token/s;
die "portable transfer manifest must assign the caller-selected transfer token\n"
  unless $transfer =~
         /preserve_trx_transfer_build_portable_objects[\s\S]*uint64_t transfer_token[\s\S]*transfer_token\s*==\s*0[\s\S]*built_manifest\.token\s*=\s*transfer_token/s;
$sql_parse =~
  /case\s+COM_PRESERVE_TRX_TRANSFER\s*:\s*\{[\s\S]*?break\s*;\s*\}/
  or die "could not isolate COM_PRESERVE_TRX_TRANSFER dispatch case\n";
my $transfer_com_case = $&;
die "standby transfer COM command must route through the transfer module handler instead of keeping protocol logic in sql_parse.cc\n"
  unless $transfer_com_case =~ /preserve_trx_transfer_dispatch_command\s*\(/s;
die "standby transfer COM command must not directly return ER_UNKNOWN_COM_ERROR from sql_parse.cc\n"
  if $transfer_com_case =~ /ER_UNKNOWN_COM_ERROR/s;
$transfer =~
  /void\s+preserve_trx_transfer_dispatch_command\(THD \*thd\)[\s\S]*?^}/m
  or die "could not isolate preserve_trx_transfer_dispatch_command\n";
my $transfer_dispatch_command = $&;
die "standby transfer receiver dispatch must require PRESERVE_TRX_TRANSFER_ADMIN before staging frames\n"
  unless $transfer_dispatch_command =~ /PRESERVE_TRX_TRANSFER_ADMIN/s &&

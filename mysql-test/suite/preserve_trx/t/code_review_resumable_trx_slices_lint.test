         index($transfer_dispatch_command, 'has_global_grant') <
         index($transfer_dispatch_command, 'preserve_trx_transfer_handle_receiver_payload');
die "standby transfer receiver dispatch must not require source-side preserve_trx_transfer_enable\n"
  if $transfer_dispatch_command =~ /!preserve_trx_transfer_enable/s;
die "standby transfer receiver dispatch must log non-OK frame status before mapping to generic SQL errors\n"
  unless $transfer_dispatch_command =~

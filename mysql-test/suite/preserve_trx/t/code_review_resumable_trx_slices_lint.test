$temp_table =~ /Preserve_snapshot_status preserve_trx_temp_table_preflight_preserve[\s\S]*?^}/m
  or die "could not isolate preserve_trx_temp_table_preflight_preserve\n";
my $temp_preflight_preserve = $&;
die "temp preflight must reject dropped-temp row history even when no temp tables remain linked\n"

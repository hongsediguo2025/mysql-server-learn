my $ha_force_branch = $&;
die "InnoDB force-recovery startup must not ignore preserved-trx recovery errors\n"
  unless $ha_force_branch =~ /preserved_trx_recover_all\s*\(\s*\)/s &&
         $ha_force_branch =~ /fatal/s;

die "snapshot compatibility wrapper definitions or calls must not remain public in preserve_trx.h\n"
  if $preserve_header =~

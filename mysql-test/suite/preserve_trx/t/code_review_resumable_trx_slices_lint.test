$preserve =~ /bool preserved_trx_recover_all[\s\S]*?^}/m
  or die "could not isolate preserved_trx_recover_all\n";
my $recover_all = $&;
die "recover_all must list snapshots through Preserved_trx_store\n"
  unless $recover_all =~ /create_preserved_trx_default_store/s &&

--perl
use strict;
use warnings;
use File::Spec;

# Lint-only source-shape guard; behavior coverage lives in targeted MTR/gunit
# tests. Do not cite this file as evidence for runtime preserve/resume behavior.

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));

sub read_source {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my $src = do { local $/; <$fh> };
  close($fh);
  return $src;
}

sub read_optional_source {
  my ($path) = @_;
  return '' unless -f $path;
  return read_source($path);
}

my $preserve_path = File::Spec->catfile($source_root, 'sql', 'preserve_trx.cc');
my $preserve_header_path = File::Spec->catfile($source_root, 'sql',
                                              'preserve_trx.h');
my $binlog_path = File::Spec->catfile($source_root, 'sql', 'binlog.cc');
my $binlog_ostream_path = File::Spec->catfile($source_root, 'sql',
                                              'binlog_ostream.cc');
my $bundle_path = File::Spec->catfile($source_root, 'sql',
                                      'preserve_trx_bundle.cc');
my $lock_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                    'lock', 'lock0lock.cc');
my $purge_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                     'trx', 'trx0purge.cc');
my $trx_preserve_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                           'trx', 'trx0preserve.cc');
my $trx_temp_preserve_path = File::Spec->catfile(
  $source_root, 'storage', 'innobase', 'trx', 'trx0temp_preserve.cc');
my $trx_undo_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                        'trx', 'trx0undo.cc');
my $trx_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                   'trx', 'trx0trx.cc');
my $mtr_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                   'mtr', 'mtr0mtr.cc');
my $ha_innodb_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                         'handler', 'ha_innodb.cc');
my $mysqld_path = File::Spec->catfile($source_root, 'sql', 'mysqld.cc');
my $carrier_file_path = File::Spec->catfile($source_root, 'sql',
                                            'preserve_trx_carrier_file.cc');
my $carrier_path = File::Spec->catfile($source_root, 'sql',
                                       'preserve_trx_carrier.cc');
my $bundle_doc_path = File::Spec->catfile(
  $source_root, 'design', 'resumable-trx-bundle-carrier-decoupling.md');
my $temp_table_path = File::Spec->catfile($source_root, 'sql',
                                          'preserve_trx_temp_table.cc');
my $temp_table_carrier_path = File::Spec->catfile(
  $source_root, 'sql', 'preserve_trx_temp_table_carrier.cc');
my $mdl_context_backup_path = File::Spec->catfile(
  $source_root, 'sql', 'mdl_context_backup.cc');
my $drain_path = File::Spec->catfile($source_root, 'sql',
                                     'preserve_trx_drain.cc');
my $handler_path = File::Spec->catfile($source_root, 'sql', 'handler.cc');
my $gunit_path = File::Spec->catfile($source_root, 'unittest', 'gunit',
                                     'preserve_trx-t.cc');
my $sql_parse_path = File::Spec->catfile($source_root, 'sql', 'sql_parse.cc');

my $preserve = read_source($preserve_path);
my $preserve_header = read_source($preserve_header_path);
my $binlog = read_source($binlog_path);
my $binlog_ostream = read_source($binlog_ostream_path);
my $bundle = read_source($bundle_path);
my $lock = read_source($lock_path);
my $purge = read_source($purge_path);
my $trx_preserve = read_source($trx_preserve_path);
my $trx_temp_preserve = read_source($trx_temp_preserve_path);
my $trx_undo = read_source($trx_undo_path);
my $trx = read_source($trx_path);
my $mtr = read_source($mtr_path);
my $ha_innodb = read_source($ha_innodb_path);
my $mysqld = read_source($mysqld_path);
my $carrier_file = read_source($carrier_file_path);
my $carrier = read_source($carrier_path);
my $bundle_doc = read_optional_source($bundle_doc_path);
my $temp_table = read_source($temp_table_path);
my $temp_table_carrier = read_source($temp_table_carrier_path);
my $mdl_context_backup = read_source($mdl_context_backup_path);
my $drain = read_source($drain_path);
my $handler = read_source($handler_path);
my $gunit = read_source($gunit_path);
my $sql_parse = read_source($sql_parse_path);

$lock =~ /static bool lock_preserve_page_identity_matches[\s\S]*?^}/m
  or die "could not isolate lock_preserve_page_identity_matches\n";
my $page_identity = $&;
die "predicate lock identity must fail closed when the persisted identity is empty\n"
  unless $page_identity =~
         /lock_preserve_entry_is_predicate[\s\S]*entry\.heap_offsets\.empty\s*\(\s*\)[\s\S]*return\s+false\s*;/s;
die "predicate lock identity must compare stable predicate page identity payloads\n"
  unless $page_identity =~
         /lock_preserve_entry_is_predicate[\s\S]*current_identity\s*==\s*entry\.heap_offsets/s;
die "ordinary record lock identity must document page_n_heap as diagnostic-only context\n"
  unless $page_identity =~
         /page_n_heap is retained in the payload as diagnostic context[\s\S]*not a stable identity component for ordinary\s+record locks/s;
die "ordinary record lock identity must not reject solely on page_n_heap drift\n"
  if $page_identity =~
     /entry\.page_n_heap\s*!=\s*page_dir_get_n_heap\s*\(\s*page\s*\)[\s\S]*return\s+false\s*;/s;

die "preserved temp-table acquire must parse the final generated _preserved_space_<id>_table_<id> suffix and require an active reservation\n"
  unless $ha_innodb =~
         /for\s*\(\s*const char \*candidate\s*=\s*(?:std::)?strstr\s*\(\s*table_name,\s*marker\s*\)[\s\S]*suffix\s*=\s*candidate[\s\S]*table_suffix[\s\S]*generated_name[\s\S]*is_preserved_space_id_reserved/s;

$lock =~ /static dberr_t lock_preserve_resurrect_table_lock\s*\([^)]*\)\s*\{[\s\S]*?^}/m
  or die "could not isolate lock_preserve_resurrect_table_lock\n";
my $preserve_resurrect_table_lock = $&;
die "preserved table-lock resurrect must fail closed instead of assert-aborting on incompatible locks\n"
  unless $preserve_resurrect_table_lock =~
         /lock_table_other_has_incompatible[\s\S]*return\s+DB_LOCK_WAIT\s*;/s &&
         $preserve_resurrect_table_lock !~ /ut_a\s*\(\s*!\s*lock_table_other_has_incompatible/s;

$lock =~ /static dberr_t lock_preserve_import_one_table_lock\s*\([^)]*\)\s*\{[\s\S]*?^}/m
  or die "could not isolate lock_preserve_import_one_table_lock\n";
my $preserve_import_table_lock = $&;
die "preserved table-lock import must delegate resurrection errors to the caller\n"
  unless $preserve_import_table_lock =~
         /return\s+lock_preserve_resurrect_table_lock\s*\(\s*table\s*,\s*trx\s*,\s*mode\s*\)\s*;/s;

$lock =~ /static dberr_t lock_preserve_import_record_lock[\s\S]*?^}/m
  or die "could not isolate lock_preserve_import_record_lock\n";
my $preserve_import_record_lock = $&;
die "preserved record-lock import must fail closed when intention-lock resurrect sees an incompatible table lock\n"
  unless $preserve_import_record_lock =~
         /lock_preserve_resurrect_table_lock[\s\S]*if\s*\(\s*table_err\s*!=\s*DB_SUCCESS\s*\)[\s\S]*return\s+table_err/s;

$lock =~ /static bool lock_preserve_append_record_image[\s\S]*?^}/m
  or die "could not isolate lock_preserve_append_record_image\n";
my $preserve_record_image = $&;
die "record-lock export must explicitly fail closed on unsupported field-length sentinels\n"
  unless $preserve_record_image =~ /UNIV_SQL_ADD_COL_DEFAULT/s &&
         $preserve_record_image =~ /UNIV_NO_INDEX_VALUE/s &&
         $preserve_record_image =~ /UNIV_MULTI_VALUE_ARRAY_MARKER/s &&
         $preserve_record_image =~ /UNIV_EXTERN_STORAGE_FIELD/s;
die "record-lock export must explicitly fail closed on instant-drop column sentinels when this source tree defines them\n"
  if $lock =~ /UNIV_SQL_INSTANT_DROP_COL/s &&
     $preserve_record_image !~ /UNIV_SQL_INSTANT_DROP_COL/s;

$lock =~ /static dberr_t lock_preserve_import_predicate_lock[\s\S]*?^}/m
  or die "could not isolate lock_preserve_import_predicate_lock\n";
my $preserve_import_predicate_lock = $&;
die "preserved predicate-lock import must fail closed when intention-lock resurrect sees an incompatible table lock\n"
  unless $preserve_import_predicate_lock =~
         /lock_preserve_resurrect_table_lock[\s\S]*if\s*\(\s*table_err\s*!=\s*DB_SUCCESS\s*\)[\s\S]*return\s+table_err/s;

$mdl_context_backup =~
  /bool MDL_context_backup_manager::create_backup\(const MDL_context \*context[\s\S]*?^}/m
  or die "could not isolate session MDL create_backup overload\n";
my $session_mdl_backup = $&;
die "duplicate session MDL backup must fail closed instead of reporting success\n"
  unless $session_mdl_backup =~ /if\s*\(\s*check_key_exist\s*\(\s*key_obj\s*\)\s*\)\s*return\s+true\s*;/s;

$binlog =~ /bool mysql_binlog_preserve_export[\s\S]*?^}/m
  or die "could not isolate mysql_binlog_preserve_export\n";
my $binlog_export = $&;
die "binlog export must explicitly fail closed when trx cache has pending rows\n"
  unless $binlog_export =~ /trx_cache\.pending\s*\(\s*\)\s*!=\s*nullptr/s;

$binlog =~ /bool mysql_binlog_preserve_reactivate_after_prepare_failure[\s\S]*?^}/m
  or die "could not isolate mysql_binlog_preserve_reactivate_after_prepare_failure\n";
my $binlog_prepare_failure_reactivate = $&;
die "binlog prepare-failure reactivation must clear table-map state before more DML can be logged\n"
  unless $binlog_prepare_failure_reactivate =~ /thd->clear_binlog_table_maps\s*\(\s*\)/s;
die "binlog prepare-failure reactivation must reset trx-cache statement savepoint state after resetting STMT scope\n"
  unless $binlog_prepare_failure_reactivate =~
         /reset_scope\s*\(\s*Transaction_ctx::STMT\s*\)[\s\S]*set_prev_position\s*\(\s*MY_OFF_T_UNDEF\s*\)/s;

$binlog =~ /bool mysql_binlog_preserve_export_metadata_only[\s\S]*?^}/m
  or die "could not isolate mysql_binlog_preserve_export_metadata_only\n";
my $binlog_export_metadata_only = $&;
die "metadata-only binlog export must expose warmcopy failure injection\n"
  unless $binlog_export_metadata_only =~
         /preserve_trx_fail_warmcopy_export_metadata[\s\S]*return\s+true/s;

$binlog =~ /bool mysql_binlog_preserve_warmcopy_build_blob[\s\S]*?^}/m
  or die "could not isolate mysql_binlog_preserve_warmcopy_build_blob\n";
my $warmcopy_build_blob = $&;
die "warmcopy build must fail closed when metadata export fails\n"
  unless $warmcopy_build_blob =~
         /mysql_binlog_preserve_export_metadata_only\s*\(\s*thd\s*,\s*&metadata\s*\)[\s\S]*return\s+true\s*;/s;
die "warmcopy full-build path must compute and publish the external blob digest\n"
  unless $warmcopy_build_blob =~ /ostream\.finish\s*\(\s*&digest\s*\)/s &&
         $warmcopy_build_blob =~ /blob->digest\s*=\s*digest/s;
my $warmcopy_finalize_start = index($binlog, 'bool finalize(THD *thd');
my $warmcopy_finalize_end =
  index($binlog, 'Binlog_warmcopy_mirror_status write_at',
        $warmcopy_finalize_start);
die "could not isolate warmcopy live-session finalize\n"
  if $warmcopy_finalize_start < 0 || $warmcopy_finalize_end < 0 ||
     $warmcopy_finalize_end <= $warmcopy_finalize_start;
my $warmcopy_finalize =
  substr($binlog, $warmcopy_finalize_start,
         $warmcopy_finalize_end - $warmcopy_finalize_start);
die "warmcopy live session must fail closed until every mirrored byte is digested\n"
  unless $warmcopy_finalize =~ /m_digest_until\s*!=\s*current_length/s &&
         $warmcopy_finalize =~ /!\s*m_pending_ranges\.empty\s*\(\s*\)/s;
die "warmcopy live-session path must compute and publish the external blob digest\n"
  unless $warmcopy_finalize =~ /EVP_DigestFinal_ex[\s\S]*digest\.data\s*\(\s*\)/s &&
         $warmcopy_finalize =~ /blob->digest\s*=\s*digest/s;

$preserve =~ /bool preserved_trx_metadata_locks_count[\s\S]*?^}/m
  or die "could not isolate preserved_trx_metadata_locks_count\n";
my $metadata_locks_count = $&;
die "P_S LOCKS_COUNT must include preserved table-lock payload entries\n"
  unless $metadata_locks_count =~ /metadata\.table_locks_payload/s &&
         $metadata_locks_count =~ /trx_preserve_table_locks_payload_lock_count/s;

$carrier =~ /Preserve_snapshot_status cleanup_after_write_failure[\s\S]*?^}/m
  or die "could not isolate cleanup_after_write_failure\n";
my $store_write_cleanup = $&;
die "store write cleanup must remove the full carrier record after snapshot write failure\n"
  unless $store_write_cleanup =~ /remove_with_status\s*\(\s*token\s*\)/s;

$carrier =~ /Preserve_snapshot_status Preserved_trx_store::write[\s\S]*?^Preserve_snapshot_status Preserved_trx_store::read/m
  or die "could not isolate Preserved_trx_store::write\n";
my $store_writer = $&;
die "store writer must persist external blobs before the main snapshot\n"
  unless $store_writer =~ /write_external_blobs_new[\s\S]*write_snapshot_new/s;
die "store writer must clean external blobs when the main snapshot already exists\n"
  unless $store_writer =~ /write_snapshot_new[\s\S]*cleanup_external_blobs_after_write_failure/s;
die "store writer must clean the full carrier record when final snapshot write fails\n"
  unless $store_writer =~ /write_snapshot_new[\s\S]*cleanup_after_write_failure/s;

$purge =~ /static bool trx_purge_check_if_marked_undo_is_empty[\s\S]*?^}/m
  or die "could not isolate trx_purge_check_if_marked_undo_is_empty\n";
my $purge_check = $&;
die "undo truncate check must explicitly account for preserved transactions\n"
  unless $purge_check =~ /trx_preserve|TRX_STATE_PRESERVED|xid_is_preserve_magic/s;
die "undo truncate check must collect preserved rsegs before taking marked rseg locks\n"
  unless $purge_check =~ /trx_preserve_collect_preserved_rsegs[\s\S]*marked_rsegs->x_lock/s;
die "undo truncate check must not call trx_sys-scanning preserve helper under rseg latch\n"
  if $purge_check =~ /rseg->latch\s*\(\s*\)[\s\S]*trx_preserve_rseg_has_preserved_trx/s;
die "undo truncate check must use the pre-collected preserved rseg set under rseg latch\n"
  unless $purge_check =~ /rseg->latch\s*\(\s*\)[\s\S]*std::find\s*\(\s*preserve_rsegs\.begin/s;

$trx =~ /static trx_t \*trx_resurrect_insert[\s\S]*?^}/m
  or die "could not isolate trx_resurrect_insert\n";
my $trx_resurrect_insert = $&;
die "force recovery must keep preserve magic XA transactions prepared\n"
  unless $trx_resurrect_insert =~
         /preserve_magic_xid\s*=\s*xid_is_preserve_magic[\s\S]*srv_force_recovery\s*==\s*0\s*\|\|\s*preserve_magic_xid/s &&
         $trx_resurrect_insert =~ /\+\+trx_sys->n_prepared_trx/s;

$carrier_file =~ /Preserved_trx_carrier_status read_file_limited[\s\S]*?^}/m
  or die "could not isolate read_file_limited\n";
my $carrier_limited_read = $&;
die "carrier read must stat and enforce the byte limit before allocation/open read\n"
  unless $carrier_limited_read =~ /file_exists\s*\([^;]*&stat_area/s &&
         $carrier_limited_read =~ /stat_area\.st_size[\s\S]*>\s*max_bytes/s &&
         $carrier_limited_read =~ /open_regular_file_no_follow_for_read/s &&
         index($carrier_limited_read, 'stat_area.st_size') <
         index($carrier_limited_read, 'out->assign') &&
         index($carrier_limited_read, 'open_regular_file_no_follow_for_read') <
         index($carrier_limited_read, 'out->assign');

$carrier_file =~ /Preserved_trx_carrier_status Local_file_preserved_trx_carrier::read_existing[\s\S]*?^}/m
  or die "could not isolate Local_file_preserved_trx_carrier::read_existing\n";
my $carrier_read_existing = $&;
die "carrier read_existing must apply snapshot and external blob read limits\n"
  unless $carrier_read_existing =~ /read_limits\.max_snapshot_bytes/s &&
         $carrier_read_existing =~ /read_limits\.max_external_blob_bytes/s;
die "carrier metadata-only read must stream external sidecar digest metadata without returning payloads\n"
  unless $carrier_read_existing =~ /Payload_read_mode::METADATA_ONLY/s &&
         $carrier_read_existing =~ /read_external_blob_metadata/s &&
         $carrier_read_existing =~ /set_blob_descriptor_from_payload/s;
die "carrier snapshot-only read must not scan external sidecars\n"
  unless index($carrier_read_existing, 'Payload_read_mode::SNAPSHOT_ONLY') >= 0 &&
         index($carrier_read_existing, 'Payload_read_mode::SNAPSHOT_ONLY') <
         index($carrier_read_existing, 'binlog_cache_path');

$temp_table_carrier =~ /Preserved_trx_carrier_status validate_file_digest[\s\S]*?^}/m
  or die "could not isolate temp sidecar streaming digest validator\n";
my $temp_sidecar_digest_validator = $&;
die "temporary table sidecar recovery validation must stream digest bytes instead of allocating the full sidecar\n"
  unless $temp_sidecar_digest_validator =~ /EVP_DigestUpdate/s &&
         $temp_sidecar_digest_validator =~ /my_read/s &&
         $temp_sidecar_digest_validator !~ /out->assign/s;
$temp_table =~ /Preserve_snapshot_status preserve_trx_temp_table_validate_sidecars[\s\S]*?^}/m
  or die "could not isolate preserve_trx_temp_table_validate_sidecars\n";
my $temp_sidecar_validation = $&;
die "temporary table startup sidecar validation must not call payload-returning sealed sidecar reads\n"
  unless $temp_sidecar_validation =~ /validate_sealed_image/s &&
         $temp_sidecar_validation =~ /validate_sealed_undo/s &&
         $temp_sidecar_validation !~ /read_sealed_image/s &&
         $temp_sidecar_validation !~ /read_sealed_undo/s;

$carrier =~ /bool external_blob_metadata_matches_descriptors[\s\S]*?^}/m
  or die "could not isolate external_blob_metadata_matches_descriptors\n";
my $carrier_metadata_match = $&;
die "metadata-only store read must validate sidecar names, sizes, and digests against snapshot descriptors\n"
  unless $carrier_metadata_match =~ /external_blobs\.size\(\)\s*!=\s*descriptors\.size\(\)/s &&
         $carrier_metadata_match =~ /candidate\.name\s*==\s*descriptor\.name/s &&
         $carrier_metadata_match =~ /candidate\.descriptor\.name\s*==\s*descriptor\.name/s &&
         $carrier_metadata_match =~ /blob->descriptor\.size\s*!=\s*descriptor\.size/s &&
         $carrier_metadata_match =~ /blob->descriptor\.digest\s*!=\s*descriptor\.digest/s;
my $store_read_start =
  index($carrier, 'Preserve_snapshot_status Preserved_trx_store::read(',
        index($carrier, 'Preserve_snapshot_status Preserved_trx_store::read(') + 1);
die "could not isolate Preserved_trx_store::read with payload_read_mode\n"
  if $store_read_start < 0;
my $store_read_end =
  index($carrier, 'Preserve_snapshot_status Preserved_trx_store::rewrite_recovered_count',
        $store_read_start);
die "could not find Preserved_trx_store::read end\n"
  if $store_read_end < 0;
my $store_read_payload_mode =
  substr($carrier, $store_read_start, $store_read_end - $store_read_start);
die "store metadata-only read must not accept empty sidecar metadata silently\n"
  unless $store_read_payload_mode =~
           /const bool read_external_blobs[\s\S]*Payload_read_mode::WITH_EXTERNAL_BLOBS/s &&
         $store_read_payload_mode =~
           /if\s*\(\s*read_external_blobs\s*\)[\s\S]*external_blobs_match_descriptors/s &&
         $store_read_payload_mode =~
           /else\s+if\s*\(\s*validate_external_blob_metadata\s*\)[\s\S]*external_blob_metadata_matches_descriptors/s;

$preserve =~ /static bool reactivate_current_batch_prepared_failure_to_original_thd[\s\S]*?^}/m
  or die "could not isolate reactivate_current_batch_prepared_failure_to_original_thd\n";
my $batch_prepare_reactivate = $&;
die "batch prepare failure reactivation must accept active or prepared magic transactions\n"
  unless $batch_prepare_reactivate =~
         /trx_preserve_reactivate_prepare_failure_in_original_thd/s;

$preserve =~ /auto restore_batch_prepare_failure_or_rollback = \[\&\]\(\) \{[\s\S]*?^\s*\};/m
  or die "could not isolate restore_batch_prepare_failure_or_rollback\n";
my $batch_prepare_restore = $&;
$batch_prepare_restore =~
  /if\s*\(\s*batch_delivery\s*\)\s*\{([\s\S]*?)return\s+reject_unsupported_for_delivery\s*\(\s*\);\s*\}\s*return\s+reject_single_after_attached_cleanup/ms
  or die "could not isolate batch branch in restore_batch_prepare_failure_or_rollback\n";
my $batch_prepare_restore_branch = $1;
die "batch prepare failure branch must not rollback the user transaction\n"
  if $batch_prepare_restore_branch =~ /ha_rollback_trans/s;
die "batch prepare failure branch must restore InnoDB and binlog state before rejecting\n"
  unless $batch_prepare_restore_branch =~
         /reactivate_current_batch_prepared_failure_to_original_thd/s &&
         $batch_prepare_restore_branch =~
         /mysql_binlog_preserve_reactivate_after_prepare_failure/s &&
         $batch_prepare_restore_branch =~ /reattached_to_original_thd/s;
$preserve =~ /DBUG_EXECUTE_IF\s*\(\s*"pfx_prepare_low"[\s\S]*?prepare_failed\s*=\s*true[\s\S]*?if\s*\(\s*prepare_failed\s*\)\s*\{[\s\S]*?return\s+restore_unprepared_batch_prepare_failure_or_rollback\s*\(\s*\)\s*;/m
  or die "pre-ha_prepare_low failure hook must route through unprepared batch restore helper\n";
$preserve =~ /ha_prepare_low\s*\(\s*thd\s*,\s*true\s*\)[\s\S]*?return\s+restore_batch_prepare_failure_or_rollback\s*\(\s*\)\s*;/m
  or die "ha_prepare_low engine failure must route through prepared batch restore helper\n";
$preserve =~ /DBUG_EXECUTE_IF\s*\(\s*"pfx_temp_prepare"[\s\S]*?temp_prepare_failed\s*=\s*true[\s\S]*?if\s*\(\s*temp_prepare_failed\s*\)\s*\{[\s\S]*?return\s+restore_batch_prepare_failure_or_rollback\s*\(\s*\)\s*;/m
  or die "temp-only prepare failure hook must route through batch restore helper\n";

$preserve =~ /auto reject_after_binlog_export = \[\&\]\(const char \*reason\) \{[\s\S]*?^\s*\};/m
  or die "could not isolate reject_after_binlog_export\n";
my $reject_after_binlog_export = $&;
die "pre-prepare reject after binlog export must restore the exported binlog cache\n"
  unless $reject_after_binlog_export =~
         /mysql_binlog_preserve_reactivate_after_prepare_failure\s*\(\s*thd\s*,\s*binlog_snapshot\s*\)/s;
my $pre_prepare_export_start = index($preserve, 'has_logged_binlog_cache = true;');
my $pre_prepare_export_end =
  index($preserve, 'auto restore_batch_prepare_failure_or_rollback');
die "could not isolate pre-prepare post-binlog-export region\n"
  if $pre_prepare_export_start < 0 || $pre_prepare_export_end < 0 ||
     $pre_prepare_export_end <= $pre_prepare_export_start;
my $pre_prepare_post_binlog_export =
  substr($preserve, $pre_prepare_export_start,
         $pre_prepare_export_end - $pre_prepare_export_start);
$pre_prepare_post_binlog_export =~
  s/auto reject_after_binlog_export = \[\&\]\(const char \*reason\) \{[\s\S]*?^\s*\};\n//m

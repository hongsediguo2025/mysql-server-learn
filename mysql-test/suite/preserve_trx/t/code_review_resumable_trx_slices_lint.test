die "standby promotion Phase A must fail closed while promotion-ready cache is missing\n"
  unless $promotion =~ /READY_CACHE_NOT_READY/s &&
         $promotion =~ /require_promotion_ready_cache/s;
die "standby promotion Phase B must expose a promotion-ready cache without changing startup recovery\n"
  unless $promotion =~ /g_ready_cache/s &&
         $promotion =~ /preserved_trx_promotion_ready_cache_put_for_unit_test/s &&
         $promotion =~ /preserved_trx_promotion_ready_summary_for_epoch/s;
$promotion =~
  /Preserve_trx_promotion_adopt_status\s+preserved_trx_adopt_standby_pending_all_for_promotion\s*\([\s\S]*?^}/m

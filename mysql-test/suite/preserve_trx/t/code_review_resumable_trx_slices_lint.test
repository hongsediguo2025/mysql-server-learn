my $read_view_export = $&;
die "ReadView export failure must have an injectable debug point\n"
  unless $read_view_export =~ /preserve_trx_fail_export_read_view/s;
die "ReadView export failure must fail closed\n"
  unless $read_view_export =~ /preserve_trx_fail_export_read_view[\s\S]*return\s+DB_ERROR/s &&
         $read_view_export =~ /preserve_export_view[\s\S]*return\s+DB_ERROR/s;
$trx_preserve =~ /dberr_t trx_preserve_import_read_view[\s\S]*?^}/m

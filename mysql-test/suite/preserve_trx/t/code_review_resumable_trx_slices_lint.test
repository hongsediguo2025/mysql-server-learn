my $drain_execute = $&;
die "DRAIN abort paths must consume participant observations\n"
  unless $drain_execute =~ /abort_drain_participants[\s\S]*log_preserve_trx_drain_participant_observations/s;
die "DRAIN finalize path must consume participant observations\n"
  unless $drain_execute =~ /finalize_drain_participants[\s\S]*log_preserve_trx_drain_participant_observations/s;
my $drain_execute_without_observation_helpers = $drain_execute;
$drain_execute_without_observation_helpers =~
  s/auto abort_drain_participants = \[\&\]\(const char \*stage\) \{[\s\S]*?\n  \};\n\n//s

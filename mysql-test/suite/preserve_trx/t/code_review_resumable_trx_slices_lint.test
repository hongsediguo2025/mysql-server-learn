--perl
use strict;
use warnings;
use File::Spec;

# Lint-only source-shape guard; behavior coverage lives in targeted MTR/gunit
# tests. Do not cite this file as evidence for runtime preserve/resume behavior.

my $mysql_test_dir = $ENV{'MYSQL_TEST_DIR'}
  or die "MYSQL_TEST_DIR is not set";
my $source_root = File::Spec->rel2abs(
  File::Spec->catdir($mysql_test_dir, '..'));

sub read_source {
  my ($path) = @_;
  open(my $fh, '<', $path) or die "cannot open $path: $!";
  my $src = do { local $/; <$fh> };
  close($fh);
  return $src;
}

sub read_optional_source {
  my ($path) = @_;
  return '' unless -f $path;
  return read_source($path);
}

my $preserve_path = File::Spec->catfile($source_root, 'sql', 'preserve_trx.cc');
my $preserve_header_path = File::Spec->catfile($source_root, 'sql',
                                              'preserve_trx.h');
my $binlog_path = File::Spec->catfile($source_root, 'sql', 'binlog.cc');
my $binlog_warmcopy_path = File::Spec->catfile($source_root, 'sql',
                                               'binlog_warmcopy.cc');
my $binlog_ostream_path = File::Spec->catfile($source_root, 'sql',
                                              'binlog_ostream.cc');
my $bundle_path = File::Spec->catfile($source_root, 'sql',
                                      'preserve_trx_bundle.cc');
my $lock_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                    'lock', 'lock0lock.cc');
my $lock_preserve_path = File::Spec->catfile($source_root, 'storage',
                                             'innobase', 'lock',
                                             'lock0preserve.cc');
my $lock_header_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                           'include', 'lock0lock.h');
my $lock_priv_ic_path = File::Spec->catfile($source_root, 'storage',
                                           'innobase', 'include',
                                           'lock0priv.ic');
my $lock_warmcopy_path = File::Spec->catfile($source_root, 'storage',
                                            'innobase', 'lock',
                                            'lock0warmcopy.cc');
my $lock_warmcopy_header_path = File::Spec->catfile(
  $source_root, 'storage', 'innobase', 'include', 'lock0warmcopy.h');
my $purge_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                     'trx', 'trx0purge.cc');
my $trx_preserve_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                           'trx', 'trx0preserve.cc');
my $trx_preserve_header_path = File::Spec->catfile(
  $source_root, 'storage', 'innobase', 'include', 'trx0preserve.h');
my $trx_temp_preserve_path = File::Spec->catfile(
  $source_root, 'storage', 'innobase', 'trx', 'trx0temp_preserve.cc');
my $trx_undo_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                        'trx', 'trx0undo.cc');
my $trx_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                   'trx', 'trx0trx.cc');
my $mtr_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                   'mtr', 'mtr0mtr.cc');
my $ha_innodb_path = File::Spec->catfile($source_root, 'storage', 'innobase',
                                         'handler', 'ha_innodb.cc');
my $mysqld_path = File::Spec->catfile($source_root, 'sql', 'mysqld.cc');
my $carrier_file_path = File::Spec->catfile($source_root, 'sql',
                                            'preserve_trx_carrier_file.cc');
my $carrier_path = File::Spec->catfile($source_root, 'sql',
                                       'preserve_trx_carrier.cc');
my $carrier_header_path = File::Spec->catfile($source_root, 'sql',
                                              'preserve_trx_carrier.h');
my $bundle_doc_path = File::Spec->catfile(
  $source_root, 'design', 'resumable-trx-bundle-carrier-decoupling.md');
my $temp_table_path = File::Spec->catfile($source_root, 'sql',
                                          'preserve_trx_temp_table.cc');
my $temp_table_carrier_path = File::Spec->catfile(
  $source_root, 'sql', 'preserve_trx_temp_table_carrier.cc');
my $mdl_context_backup_path = File::Spec->catfile(
  $source_root, 'sql', 'mdl_context_backup.cc');
my $mdl_context_backup_header_path = File::Spec->catfile(
  $source_root, 'sql', 'mdl_context_backup.h');
my $drain_path = File::Spec->catfile($source_root, 'sql',
                                     'preserve_trx_drain.cc');
my $handler_path = File::Spec->catfile($source_root, 'sql', 'handler.cc');
my $xa_path = File::Spec->catfile($source_root, 'sql', 'xa.cc');
my $gunit_path = File::Spec->catfile($source_root, 'unittest', 'gunit',
                                     'preserve_trx-t.cc');
my $sql_parse_path = File::Spec->catfile($source_root, 'sql', 'sql_parse.cc');
my $sql_class_path = File::Spec->catfile($source_root, 'sql', 'sql_class.cc');
my $sys_vars_path = File::Spec->catfile($source_root, 'sql', 'sys_vars.cc');
my $transfer_path = File::Spec->catfile($source_root, 'sql',
                                        'preserve_trx_transfer.cc');
my $transfer_header_path = File::Spec->catfile($source_root, 'sql',
                                               'preserve_trx_transfer.h');
my $sql_lock_warmcopy_path = File::Spec->catfile(
  $source_root, 'sql', 'preserve_trx_lock_warmcopy.cc');
my $promotion_path = File::Spec->catfile($source_root, 'sql',
                                         'preserve_trx_promotion.cc');
my $promotion_header_path = File::Spec->catfile($source_root, 'sql',
                                                'preserve_trx_promotion.h');
my $standby_transfer_doc_path = File::Spec->catfile(
  $source_root, 'design', 'preserve-resume-8.0.22-standby-transfer-design.md');

my $preserve = read_source($preserve_path);
my $preserve_header = read_source($preserve_header_path);
my $binlog = read_source($binlog_path);
my $binlog_warmcopy = read_source($binlog_warmcopy_path);
my $binlog_ostream = read_source($binlog_ostream_path);
my $bundle = read_source($bundle_path);
my $lock = read_source($lock_path);
my $lock_preserve = read_source($lock_preserve_path);
my $lock_header = read_source($lock_header_path);
my $lock_priv_ic = read_source($lock_priv_ic_path);
my $lock_warmcopy = read_source($lock_warmcopy_path);
my $lock_warmcopy_header = read_source($lock_warmcopy_header_path);
my $purge = read_source($purge_path);
my $trx_preserve = read_source($trx_preserve_path);
my $trx_preserve_header = read_source($trx_preserve_header_path);
my $trx_temp_preserve = read_source($trx_temp_preserve_path);
my $trx_undo = read_source($trx_undo_path);
my $trx = read_source($trx_path);
my $mtr = read_source($mtr_path);
my $ha_innodb = read_source($ha_innodb_path);
my $mysqld = read_source($mysqld_path);
my $carrier_file = read_source($carrier_file_path);
my $carrier = read_source($carrier_path);
my $carrier_header = read_source($carrier_header_path);
my $bundle_doc = read_optional_source($bundle_doc_path);
my $temp_table = read_source($temp_table_path);
my $temp_table_carrier = read_source($temp_table_carrier_path);
my $mdl_context_backup = read_source($mdl_context_backup_path);
my $mdl_context_backup_header = read_source($mdl_context_backup_header_path);
my $drain = read_source($drain_path);
my $handler = read_source($handler_path);
my $xa = read_source($xa_path);
my $gunit = read_source($gunit_path);
my $sql_parse = read_source($sql_parse_path);
my $sql_class = read_source($sql_class_path);
my $sys_vars = read_source($sys_vars_path);
my $transfer = read_source($transfer_path);
my $transfer_header = read_source($transfer_header_path);
my $sql_lock_warmcopy = read_source($sql_lock_warmcopy_path);
my $promotion = read_source($promotion_path);
my $promotion_header = read_source($promotion_header_path);
my $standby_transfer_doc = read_optional_source($standby_transfer_doc_path);

die "standby transfer portable bundle codec must not use a production hard-coded HMAC key\n"
  if $transfer =~ /std::fill\s*\([^;]*hmac_key[^;]*0x74[^;]*\)/s;
die "standby transfer portable bundle codec must not use a production hard-coded datadir fingerprint\n"
  if $transfer =~ /std::fill\s*\([^;]*datadir_fingerprint[^;]*0x72[^;]*\)/s;
die "standby transfer portable bundle codec must not use a production zero server uuid\n"
  if $transfer =~ /server_uuid\s*=\s*"00000000-0000-0000-0000-000000000000"/s;
die "standby transfer commit marker publication must not truncate an existing temp file\n"
  if $transfer =~
     /write_commit_marker_file[\s\S]*my_create\s*\([^;]*O_WRONLY\s*\|\s*O_TRUNC[^;]*\)/s;
die "standby transfer epoch fact publication must not truncate an existing temp file\n"
  if $transfer =~
     /write_epoch_fact_file[\s\S]*my_create\s*\([^;]*O_WRONLY\s*\|\s*O_TRUNC[^;]*\)/s;
die "standby streaming transfer must expose a session-backed artifact sink for phase1-declared tokens\n"
  unless $transfer_header =~ /class\s+Preserve_trx_transfer_session_artifact_sink/s;
die "standby streaming transfer source epoch session must finalize externally built manifest objects for phase1 builders\n"
  unless $transfer_header =~ /send_token_objects\s*\(\s*const\s+Preserve_trx_transfer_manifest\s*&\s*manifest\s*,\s*const\s+std::vector<Preserve_trx_transfer_object_payload>\s*&\s*objects\s*\)/s &&
         $transfer =~ /Preserve_trx_transfer_source_epoch_session::send_token_objects/s;
die "standby streaming transfer source epoch session must batch phase2 final token metadata frames\n"
  unless $transfer_header =~ /send_token_objects_batch\s*\(\s*const\s+Preserve_trx_transfer_manifest\s*&\s*manifest\s*,\s*const\s+std::vector<Preserve_trx_transfer_object_payload>\s*&\s*objects\s*,\s*const\s+std::set<std::string>\s*&\s*presealed_objects\s*,\s*bool\s+queue_final_metadata\s*=\s*false\s*\)/s &&
         $transfer =~ /Preserve_trx_transfer_source_epoch_session::send_token_objects_batch/s;
die "standby streaming transfer source epoch session must expose chunk-level object streaming for phase1 builders\n"
  unless $transfer_header =~ /begin_token_objects\s*\(\s*const\s+Preserve_trx_transfer_manifest\s*&\s*manifest\s*(?:,\s*bool\s+queue_final_metadata\s*=\s*false)?\s*\)/s &&
         $transfer_header =~ /write_object_chunk\s*\(\s*uint64_t\s+transfer_token\s*,\s*const\s+std::string\s*&\s*object_id\s*,\s*uint64_t\s+chunk_offset\s*,\s*const\s+std::string\s*&\s*chunk_payload\s*\)/s &&
         $transfer_header =~ /seal_object\s*\(\s*uint64_t\s+transfer_token\s*,\s*const\s+std::string\s*&\s*object_id\s*\)/s &&
         $transfer_header =~ /finalize_token_manifest\s*\(\s*uint64_t\s+transfer_token\s*\)/s &&
         $transfer =~ /Preserve_trx_transfer_source_epoch_session::write_object_chunk/s;
die "standby streaming transfer must declare large objects before the final token manifest so receiver prewarm can start early\n"
  unless $transfer_header =~ /DECLARE_OBJECT/s &&
         $transfer_header =~ /declare_object\s*\(\s*uint64_t\s+transfer_token\s*,\s*const\s+Preserve_trx_transfer_object_descriptor\s*&\s*descriptor\s*\)/s &&
         $transfer =~ /Preserve_trx_transfer_source_epoch_session::declare_object/s &&
         $transfer =~ /Preserve_trx_transfer_frame_type::DECLARE_OBJECT/s;
my ($session_artifact_sink_publish) =
  $transfer =~ /(Preserve_trx_transfer_session_artifact_sink::publish_bundle[\s\S]*?return Preserve_snapshot_status::OK;\n})/s
  or die "could not isolate standby streaming transfer session artifact sink publish path\n";
die "standby streaming transfer session artifact sink must batch final token metadata, not fall back to send_token_bundle\n"
  unless $session_artifact_sink_publish =~ /send_token_objects_batch/s &&
         $session_artifact_sink_publish !~ /send_token_bundle/s;
die "preserve external THD pins must block new pins once THD teardown starts\n"
  unless $preserve =~ /g_preserved_trx_thd_teardown/s &&
         $preserve =~ /g_preserved_trx_thd_teardown\.count\s*\(\s*thd\s*\)/s;
my ($release_resources_body) =
  $sql_class =~ /(void THD::release_resources\(\)[\s\S]*?^})/m
  or die "could not isolate THD::release_resources\n";
die "THD::release_resources must wait for preserve external THD pins before releasing thread id/resources\n"
  unless $release_resources_body =~
     /preserved_trx_begin_external_thd_teardown\s*\(\s*this\s*\)[\s\S]*release_thread_id/s &&
         $release_resources_body =~
     /m_release_resources_done\s*=\s*true[\s\S]*preserved_trx_end_external_thd_teardown\s*\(\s*this\s*\)/s;
my ($receiver_payload_batch) =
  $transfer =~ /(preserve_trx_transfer_handle_receiver_payload_batch[\s\S]*?return\s+preserve_trx_transfer_apply_receiver_frame_batch_with_workers[\s\S]*?;\n})/s
  or die "could not isolate standby receiver encoded payload batch path\n";
die "standby receiver encoded payload batch path must use receiver worker_count after durable sequence admission\n"
  unless $receiver_payload_batch !~ /\(void\)\s*worker_count\s*;/ &&
         $receiver_payload_batch =~ /worker_count/s &&
         $receiver_payload_batch =~ /pre_admit_receiver_batch_sequence/s &&
         $receiver_payload_batch =~ /preserve_trx_transfer_apply_receiver_frame_batch_with_workers\(\s*frames,\s*(?:worker_count|written_metadata\s*==\s*nullptr\s*\?\s*worker_count\s*:\s*1)/s;
my ($receiver_apply_frame) =
  $transfer =~ /(Preserve_trx_transfer_status preserve_trx_transfer_apply_receiver_frame[\s\S]*?^}\n\nPreserve_trx_transfer_status preserve_trx_transfer_replay_receiver_spool)/m
  or die "could not isolate standby receiver frame apply path\n";
die "standby receiver SEAL_OBJECT path must enqueue object/staged prewarm instead of synchronously prewarming\n"
  unless $receiver_apply_frame =~ /enqueue_receiver_object_prewarm/s &&
         $receiver_apply_frame =~ /enqueue_receiver_staged_token_prewarm/s;
die "standby receiver COMMIT_EPOCH path must not launch committed-epoch cold prewarm\n"
  if $receiver_apply_frame =~ /enqueue_receiver_committed_epoch_prewarm/s;
die "standby receiver frame apply path must not synchronously prewarm staged or committed tokens\n"
  if $receiver_apply_frame =~ /preserved_trx_promotion_prewarm_staged_bundle_for_receiver/s ||
     $receiver_apply_frame =~ /note_receiver_sync_prewarm_wait/s;
my ($receiver_staged_prewarm_job) =
  $transfer =~ /(Preserve_trx_promotion_adopt_status run_receiver_staged_token_prewarm_job\([\s\S]*?^}\n\nstatic (?:void|bool) run_receiver_object_prewarm_job)/m
  or die "could not isolate standby receiver staged-token prewarm job\n";
die "online standby receiver staged-token READY must not publish local carrier projection\n"
  if $receiver_staged_prewarm_job =~ /publish_receiver_standby_bundle_projection/s;
die "standby receiver staged-token publish must not serialize full token publish under a global mutex\n"
  if $receiver_staged_prewarm_job =~ /g_receiver_standby_publish_mutex[\s\S]*preserve_trx_transfer_publish_standby_bundle/s;
die "standby receiver projection must not use a single global mutex\n"
  if $transfer =~ /static\s+std::mutex\s+g_receiver_standby_publish_mutex\s*;/;
my ($receiver_projection_helper) =
  $transfer =~ /(Preserve_trx_transfer_status publish_receiver_standby_bundle_projection[\s\S]*?^}\n\nPreserve_trx_transfer_status write_epoch_fact_file)/m
  or die "could not isolate standby receiver projection helper\n";
die "standby receiver projection must use token-sharded locks and lock-wait metrics\n"
  unless $transfer =~ /kReceiverProjectionLockShardCount\s*=\s*4096/s &&
         $receiver_projection_helper =~ /receiver_standby_projection_mutex\s*\(\s*manifest\.token\s*\)/s &&
         $receiver_projection_helper =~ /g_receiver_projection_lock_wait_us/s;
my ($receiver_projection_options) =
  $transfer =~ /(Preserve_snapshot_write_options receiver_standby_projection_write_options\(\)[\s\S]*?^}\n\nbool receiver_standby_projection_exists)/m
  or die "could not isolate standby receiver projection write options\n";
die "standby receiver projection must not direct-sync token files in the READY path\n"
  unless $receiver_projection_options =~ /options\.defer_file_fsync\s*=\s*true\s*;/s &&
         $receiver_projection_options =~ /options\.defer_directory_fsync\s*=\s*true\s*;/s;
die "standby receiver projection READY path must not fsync the token shard directory directly\n"
  if $receiver_projection_helper =~ /preserve_trx_fsync_default_store_token_directory/s ||
     $receiver_projection_helper =~ /preserve_trx_fsync_default_store_directory/s;
die "standby receiver staged-token prewarm must deduplicate in-flight and completed token jobs\n"
  unless $transfer =~ /g_receiver_staged_token_prewarm_inflight/s &&
         $transfer =~ /g_receiver_staged_token_prewarm_done/s;
die "standby receiver projection diagnostics must expose publish and write breakdown status\n"
  unless $transfer =~ /g_receiver_projection_publish_count/s &&
         $transfer =~ /g_receiver_projection_snapshot_write_us/s &&
         $transfer =~ /g_receiver_projection_marker_write_us/s &&
         $transfer =~ /g_receiver_epoch_ready_bind_attempts/s &&
         $mysqld =~ /Preserve_trx_transfer_receiver_projection_publish_count/s &&
         $mysqld =~ /Preserve_trx_transfer_receiver_projection_lock_wait_us/s &&
         $mysqld =~ /Preserve_trx_transfer_receiver_epoch_ready_bind_attempts/s;
die "standby streaming transfer must not create a per-token configured frame sink when the kernel request already has a source epoch session\n"
  unless $preserve =~
     /request\.transfer_source_epoch_session\s*==\s*nullptr[\s\S]*preserve_trx_transfer_make_configured_frame_sink/s;
die "standby streaming transfer kernel path must pass the source epoch session into artifact sink factory\n"
  unless $preserve =~
     /preserve_trx_make_artifact_sink_for_decision[\s\S]*request\.transfer_source_epoch_session[\s\S]*request\.transfer_preserve_dir/s;
die "standby streaming transfer batch path must own one source epoch session for all target tokens\n"
  unless $preserve =~ /batch_transfer_source_session/s;
die "standby streaming transfer must force two-phase drain so the source epoch can open during phase1\n"
  unless $preserve =~
     /standby_transfer_streaming_enabled[\s\S]*two_phase_enabled\s*=[\s\S]*standby_transfer_streaming_enabled/s;
die "standby streaming transfer source epoch must open after phase1 participants and before WARMCOPY_CLOSING\n"
  unless $preserve =~
     /open_phase1_participants\s*\(\s*\)[\s\S]*open_batch_transfer_source_epoch\s*\(\s*\)[\s\S]*transition_to\s*\(\s*Preserve_trx_manager_state::WARMCOPY_CLOSING/s;
die "standby streaming transfer must predeclare phase1 target tokens before WARMCOPY_CLOSING\n"
  unless $preserve =~
     /declare_phase1_transfer_targets[\s\S]*transition_to\s*\(\s*Preserve_trx_manager_state::WARMCOPY_CLOSING/s;
die "standby streaming transfer phase2 diagnostics must split target preserve wall time before optimization\n"
  unless $preserve =~ /phase2_target_pin_us/s &&
         $preserve =~ /phase2_target_worker_wall_us/s &&
         $preserve =~ /phase2_target_result_collect_us/s &&
         $preserve =~ /phase2_transfer_commit_epoch_us/s;
	die "standby streaming transfer phase2 diagnostics must expose source-side transfer bytes and ACK time\n"
	  unless $preserve =~ /source_phase2_transfer_snapshot_bundle_bytes/s &&
	         $preserve =~ /source_phase2_transfer_final_metadata_frame_count/s &&
	         $preserve =~ /source_phase2_transfer_final_metadata_ack_us/s &&
	         $transfer =~ /g_transfer_phase2_snapshot_bundle_bytes/s &&
	         $transfer =~ /g_transfer_phase2_final_metadata_frame_count/s &&
	         $transfer =~ /g_transfer_phase2_final_metadata_encoded_bytes/s;
	die "standby receiver prewarm diagnostics must expose object-proof and fallback counters\n"
	  unless $transfer =~ /g_receiver_object_prewarm_proof_count/s &&
	         $transfer =~ /g_receiver_object_prewarm_miss_count/s &&
	         $transfer =~ /g_receiver_committed_epoch_fallback_count/s &&
	         $mysqld =~ /Preserve_trx_transfer_receiver_object_prewarm_proof_count/s &&
	         $mysqld =~ /Preserve_trx_transfer_receiver_object_prewarm_miss_count/s &&
	         $mysqld =~ /Preserve_trx_transfer_receiver_committed_epoch_fallback_count/s;
	die "standby streaming transfer must stream phase1 record-lock blobs before WARMCOPY_CLOSING\n"
	  unless $preserve =~
	     /stream_phase1_transfer_record_lock_blobs[\s\S]*transition_to\s*\(\s*Preserve_trx_manager_state::WARMCOPY_CLOSING/s;
die "standby streaming transfer must stream phase1 binlog-cache blobs before WARMCOPY_CLOSING\n"
  unless $preserve =~
     /stream_phase1_transfer_binlog_cache_blobs[\s\S]*transition_to\s*\(\s*Preserve_trx_manager_state::WARMCOPY_CLOSING/s;
my ($phase1_binlog_streamer) =
  $preserve =~ /(static bool stream_phase1_transfer_binlog_cache_blobs[\s\S]*?^}\n\n\/\*)/m
  or die "could not isolate phase1 transfer binlog-cache streaming helper\n";
die "standby phase1 binlog-cache streaming must be target-set driven, not idle-scan-only\n"
  if $phase1_binlog_streamer =~ /Warmcopy_prepare_idle_participants/s;
die "standby streaming transfer must send phase1 prewarm manifests before WARMCOPY_CLOSING\n"
  unless $preserve =~
     /begin_phase1_transfer_prewarm_manifests[\s\S]*transition_to\s*\(\s*Preserve_trx_manager_state::WARMCOPY_CLOSING/s;
die "standby phase1 record-store preparation must stream each completed blob through the adaptive batch sender\n"
  unless $preserve =~
     /prepare_phase1_record_store_targets\s*\(\s*\[&\]\s*\(\s*uint64_t[\s\S]*batch_transfer_phase1_sender[\s\S]*enqueue/s;
my ($phase1_record_streamer) =
  $preserve =~ /(auto stream_phase1_transfer_record_lock_blobs[\s\S]*?^  };)/m
  or die "could not isolate phase1 transfer record-lock streaming helper\n";
die "existing phase1 prebuilt record blobs must use the adaptive batch sender when batching is enabled\n"
  unless $phase1_record_streamer =~
         /batch_transfer_phase1_sender[\s\S]*enqueue[\s\S]*flush/s;
die "standby phase1 adaptive sender must flush before WARMCOPY_CLOSING\n"
  unless $preserve =~
     /batch_transfer_phase1_sender[\s\S]*flush\s*\(\s*\)[\s\S]*transition_to\s*\(\s*Preserve_trx_manager_state::WARMCOPY_CLOSING/s;
die "standby phase1 sender must snapshot batch, chunk, and inflight limits into the source epoch\n"
  unless $preserve =~ /Preserve_trx_transfer_source_epoch_options[\s\S]*chunk_bytes[\s\S]*max_inflight_bytes[\s\S]*phase1_batch_bytes/s;
die "standby phase1 sender thread must initialize and release MySQL thread state\n"
  unless $transfer =~ /Preserve_trx_transfer_phase1_batch_sender::Impl[\s\S]*my_thread_init\s*\(\s*\)[\s\S]*my_thread_end\s*\(\s*\)/s;
die "receiver staged-token prewarm must preserve a retry requested while the token job is still inflight\n"
  unless $transfer =~
         /g_receiver_staged_token_prewarm_deferred[\s\S]*finish_receiver_staged_token_prewarm_job[\s\S]*g_receiver_prewarm_jobs\.push_back\s*\(\s*job\s*\)/s;
die "standby phase1 control frames must use batch source-session APIs\n"
  unless $preserve =~ /declare_tokens_batch/s &&
         $preserve =~ /begin_token_prewarm_manifests_batch/s;
my ($receiver_dispatch_command) =
  $transfer =~ /(void preserve_trx_transfer_dispatch_command\(THD \*thd\)[\s\S]*?^}\n\nPreserve_snapshot_status Preserve_trx_local_carrier_artifact_sink::publish_bundle)/m
  or die "could not isolate standby receiver COM dispatch path\n";

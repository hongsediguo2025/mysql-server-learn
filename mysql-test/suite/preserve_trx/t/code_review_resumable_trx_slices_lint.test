  or die "pre-ha_prepare_low failure hook must route through unprepared batch restore helper\n";
$preserve =~ /ha_prepare_low\s*\(\s*thd\s*,\s*true\s*\)[\s\S]*?return\s+restore_batch_prepare_failure_or_rollback\s*\(\s*\)\s*;/m

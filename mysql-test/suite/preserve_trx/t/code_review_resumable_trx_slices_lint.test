         $temp_cleanup_sidecars =~ /remove_sealed_image/s &&
         $temp_cleanup_sidecars !~ /remove_warm_undo/s &&
         $temp_cleanup_sidecars !~ /remove_sealed_undo/s &&
         $temp_cleanup_sidecars !~ /remove_sealed_sidecars/s;
$temp_table_carrier =~ /Preserved_trx_carrier_status fsync_directory_after_install[\s\S]*?^}/m

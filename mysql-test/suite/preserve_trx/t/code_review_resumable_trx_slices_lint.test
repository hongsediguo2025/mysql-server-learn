my $read_view_import = $&;
die "ReadView import must reject future system bounds before MVCC import\n"
  unless $read_view_import =~ /trx_sys_get_next_trx_id_or_no/s &&
         $read_view_import =~ /snapshot\.low_limit_no\s*>\s*next_trx_id_or_no/s &&
         $read_view_import =~ /snapshot\.low_limit_id\s*>\s*next_trx_id_or_no/s;
$trx_preserve =~ /static bool trx_preserve_parse_read_view_payload[\s\S]*?^}/m
  or die "could not isolate trx_preserve_parse_read_view_payload\n";
my $read_view_parse = $&;
die "ReadView payload validation must reject zero low_limit_no\n"
  unless $read_view_parse =~ /snapshot->low_limit_no\s*==\s*0/s;
$bundle =~ /bool read_view_payload_is_valid[\s\S]*?^}/m
  or die "could not isolate read_view_payload_is_valid\n";
my $bundle_read_view_parse = $&;
die "bundle ReadView payload validation must reject zero low_limit_no before writing durable snapshots\n"
  unless $bundle_read_view_parse =~ /view_low_limit_no\s*==\s*0/s;

$carrier_file =~ /bool write_tainted_marker[\s\S]*?^}/m
  or die "could not isolate write_tainted_marker\n";
my $taint_writer = $&;
die "force recovery taint marker must have an injectable failure point\n"
  unless $taint_writer =~ /preserve_trx_fail_write_tainted_marker/s;

$preserve =~ /bool preserved_trx_recover_all[\s\S]*?if\s*\(srv_force_recovery\s*>\s*0\)[\s\S]*?files are retained and marked tainted[\s\S]*?return\s+false\s*;/m
  or die "could not isolate force-recovery taint branch\n";
my $force_taint_branch = $&;
die "force recovery must fail closed when taint marker persistence fails\n"
  unless $force_taint_branch =~ /taint_error/s &&
         $force_taint_branch =~ /return\s+true\s*;/s;
die "force recovery taint marker failure must retain snapshot evidence\n"
  if $force_taint_branch =~ /remove_with_status\s*\(/s;

my $preflight_pos = index($mysqld, 'preserved_trx_preflight_recoverability()');
die "could not isolate startup preserve-trx preflight call\n"
  if $preflight_pos < 0;
$mysqld =~ /if\s*\([^)]*preserved_trx_preflight_recoverability\s*\(\s*\)[^)]*\)\s*\{\s*unireg_abort/m
  or die "could not isolate startup preserve-trx preflight condition\n";
my $preflight_window = $&;
die "startup preserve-trx preflight must run even when --skip-log-bin is used\n"
  if $preflight_window =~ /\bopt_bin_log\b/s;

$preserve =~ /Preserve_trx_command_block_result preserved_trx_protocol_command_block_result[\s\S]*?^}/m
  or die "could not isolate preserved_trx_protocol_command_block_result\n";
my $protocol_command_gate = $&;
die "protocol command gate must block COM_FIELD_LIST and COM_REFRESH when drain is blocking lock-taking commands\n"
  unless $protocol_command_gate =~ /preserve_trx_protocol_command_may_create_trx_or_lock/s &&
         $preserve =~ /case\s+COM_FIELD_LIST\s*:/s &&
         $preserve =~ /case\s+COM_REFRESH\s*:/s &&
         $protocol_command_gate =~ /BLOCK_DRAINING/s;
$sql_parse =~ /bool dispatch_command\(THD \*thd, const COM_DATA \*com_data,[\s\S]*?^}/m
  or die "could not isolate dispatch_command\n";
my $dispatch_command = $&;
my $protocol_gate_pos =
  index($dispatch_command, 'preserved_trx_protocol_command_block_result');
my $dispatch_switch_pos = index($dispatch_command, 'switch (command)');
die "dispatch_command must run preserve protocol command gate before the protocol switch\n"
  unless $protocol_gate_pos >= 0 && $dispatch_switch_pos >= 0 &&
         $protocol_gate_pos < $dispatch_switch_pos &&
         $dispatch_command =~ /ER_PRESERVE_TRX_UNSUPPORTED/s &&
         $dispatch_command =~ /ER_PRESERVE_TRX_SESSION_DRAINED/s;

$preserve =~ /static bool recover_preserved_snapshot[\s\S]*?^}/m
  or die "could not isolate recover_preserved_snapshot\n";
my $recover_snapshot = $&;
die "recovery must read durable snapshots through Preserved_trx_store\n"
  unless $recover_snapshot =~ /create_preserved_trx_default_store/s &&
         $recover_snapshot =~ /->read\s*\(/s;
die "recovery must not load logged binlog cache payload while registering preserved snapshots\n"
  unless $recover_snapshot =~ /store->read\s*\(\s*token\s*,\s*true\s*,[\s\S]*Payload_read_mode::METADATA_ONLY[\s\S]*&bundle\s*\)/s;
die "recovery must rewrite recovered_count through Preserved_trx_store\n"
  unless $recover_snapshot =~ /->rewrite_recovered_count\s*\(/s;
my $recover_add_record_pos =
  index($recover_snapshot, 'preserved_trx_add_record');
my $recover_rewrite_count_pos =
  index($recover_snapshot, '->rewrite_recovered_count');
my $recover_claim_pos = index($recover_snapshot, 'trx_preserve_claim_prepared');
die "recovery must rewrite durable recovered_count after claiming but before publishing the recovered record\n"
  unless $recover_add_record_pos >= 0 && $recover_rewrite_count_pos >= 0 &&
         $recover_claim_pos >= 0 &&
         $recover_claim_pos < $recover_rewrite_count_pos &&
         $recover_rewrite_count_pos < $recover_add_record_pos;
die "recovery recovered_count rewrite failure must rollback the claimed transaction before registration\n"
  unless $recover_snapshot =~
         /rewrite_recovered_count[\s\S]*rollback_claimed_preserved_snapshot_or_log/s &&
         $recover_snapshot !~ /rewrite_recovered_count[\s\S]*preserved_trx_add_record[\s\S]*preserved_trx_update_record_last_error/s;
die "recovery must not call legacy raw snapshot read/rewrite helpers\n"
  if $recover_snapshot =~ /preserved_trx_read_snapshot|read_snapshot_with_identity_check|rewrite_snapshot_recovered_count/s;
die "recovery max-count cleanup must leave a FAILED observable P_S record\n"
  unless $recover_snapshot =~
         /metadata\.recovered_count\s*>=\s*preserve_trx_recovery_max_count[\s\S]*?preserved_trx_add_failed_observable_record\s*\(\s*metadata\s*,\s*"recovery max count exceeded"\s*\)[\s\S]*?rollback_preserved_snapshot_or_log/s;
die "recovery timeout cleanup must leave a FAILED observable P_S record\n"
  unless $recover_snapshot =~
         /if\s*\(\s*recovery_deadline_expired\s*\)[\s\S]*?preserved_trx_add_failed_observable_record\s*\(\s*metadata\s*,\s*"recovery timeout expired"\s*\)[\s\S]*?rollback_preserved_snapshot_or_log/s;

die "recovered-count offset must not be duplicated in carrier\n"
  if $carrier =~ /kRecoveredCountOffset\s*=/;
die "carrier recovered-count rewrite must use bundle-owned header offset\n"
  unless $carrier =~ /preserve_trx_bundle_recovered_count_offset\s*\(\s*\)/s;

$carrier_file =~ /bool create_key[\s\S]*?^}/m
  or die "could not isolate create_key\n";
my $carrier_create_key = $&;
die "carrier key tmp creation must use O_CREAT and O_EXCL\n"
  unless $carrier_create_key =~ /my_create\s*\([^;]*O_CREAT[^;]*O_EXCL/s;
die "carrier key tmp creation must reject preexisting tmp symlinks\n"
  unless $carrier_create_key =~ /path_is_symlink\s*\(\s*tmp_path\s*\)/s;

$bundle =~ /Preserve_snapshot_status encode_preserved_trx_bundle[\s\S]*?^}/m
  or die "could not isolate encode_preserved_trx_bundle\n";
my $snapshot_encode = $&;
die "snapshot encode must reject empty runtime server_uuid before durable write\n"
  unless $snapshot_encode =~ /context\.server_uuid\.empty\s*\(\s*\)[\s\S]*?Preserve_snapshot_status::INVALID_ARGUMENT/s;

$bundle =~ /Preserve_snapshot_status decode_preserved_trx_snapshot_bytes[\s\S]*?^}/m
  or die "could not isolate decode_preserved_trx_snapshot_bytes\n";
my $snapshot_decode = $&;
die "snapshot identity validation must reject empty runtime server_uuid\n"
  unless $snapshot_decode =~ /context\.server_uuid\.empty\s*\(\s*\)[\s\S]*?Preserve_snapshot_status::CORRUPT/s;
die "snapshot identity validation must compare runtime server_uuid unconditionally after empty check\n"
  unless $snapshot_decode =~ /read_fixed_string\s*\([^;]*kServerUuidOffset[\s\S]*!=\s*context\.server_uuid/s;

$drain =~ /Preserve_trx_drain_orchestrator::observations[\s\S]*?^}/m
  or die "drain orchestrator must expose participant observations\n";
my $drain_observations = $&;
die "drain orchestrator observations must read every participant observation\n"
  unless $drain_observations =~ /participant->observation\s*\(\s*\)/s;

$preserve =~ /static void log_preserve_trx_drain_participant_observations[\s\S]*?^}/m

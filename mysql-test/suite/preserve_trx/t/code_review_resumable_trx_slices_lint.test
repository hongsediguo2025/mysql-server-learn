die "preserve_trx.h must not expose the local-file carrier implementation\n"
  if $preserve_header =~ /preserve_trx_carrier_file\.h|Local_file_preserved_trx_carrier/s;
die "SQL orchestration must not include the local-file carrier implementation\n"
  if $preserve =~ /preserve_trx_carrier_file\.h/s;
die "snapshot compatibility wrapper definitions or calls must be removed from SQL orchestration\n"
  if $preserve =~
     /\bpreserved_trx_(write_snapshot|read_snapshot|delete_snapshot_files)\s*\(/s;
die "legacy identity-check snapshot wrapper must be removed from SQL orchestration\n"
  if $preserve =~ /\bread_snapshot_with_identity_check\s*\(/s;
die "legacy recovered-count rewrite wrapper must be removed from SQL orchestration\n"
  if $preserve =~ /\brewrite_snapshot_recovered_count\s*\(/s;
die "SQL orchestration must not instantiate the local-file carrier directly\n"
  if $preserve =~ /Local_file_preserved_trx_carrier/s;
die "legacy local-file snapshot byte decoder must be removed from SQL orchestration\n"
  if $preserve =~ /\bvalidate_snapshot_bytes\s*\(/s;
die "legacy local-file binlog-cache sidecar validator must be removed from SQL orchestration\n"
  if $preserve =~ /\bvalidate_external_binlog_cache\s*\(/s;
die "preserve-trx gunit must use Store/codec/carrier APIs instead of snapshot wrappers\n"
  if $gunit =~
     /\bpreserved_trx_(write_snapshot|read_snapshot|delete_snapshot_files)\s*\(/s;

$preserve =~ /static bool restore_batch_record_to_original_thd[\s\S]*?^}/m
  or die "could not isolate restore_batch_record_to_original_thd\n";
my $batch_restore = $&;
die "batch cleanup must lazy-load logged binlog cache payload through the store path\n"
  unless $batch_restore =~ /hydrate_logged_binlog_cache_payload_if_needed/s;
die "batch cleanup must not read local snapshot files directly\n"
  if $batch_restore =~ /read_snapshot_with_identity_check|preserved_trx_read_snapshot|Local_file_preserved_trx_carrier/s;
my $batch_restore_activate_pos =
  index($batch_restore, 'trx_preserve_activate_reattached_in_original_thd');
my $batch_restore_delete_pos =
  index($batch_restore, 'delete_snapshot_files_with_status');
die "batch cleanup must activate reattached undo state before deleting the durable snapshot\n"
  unless $batch_restore_activate_pos >= 0 &&
         $batch_restore_delete_pos >= 0 &&
         $batch_restore_activate_pos < $batch_restore_delete_pos;

$preserve =~ /bool hydrate_logged_binlog_cache_payload_if_needed[\s\S]*?^}/m
  or die "could not isolate hydrate_logged_binlog_cache_payload_if_needed\n";
my $hydrate_cache_payload = $&;
die "logged binlog-cache hydration must use the default store factory\n"
  unless $hydrate_cache_payload =~ /create_preserved_trx_default_store/s &&
         $hydrate_cache_payload =~ /->read\s*\(/s;
die "logged binlog-cache hydration must validate the hydrated token against registered metadata\n"
  unless $hydrate_cache_payload =~ /bundle\.metadata\.token\s*!=\s*record->metadata\.token/s;
die "logged binlog-cache hydration must validate the hydrated payload digest metadata\n"
  unless $hydrate_cache_payload =~ /blob_descriptors/s &&
         $preserve =~
         /bool preserved_trx_blob_descriptors_equal[\s\S]*right->digest\s*!=\s*left\.digest/s;

$preserve =~ /static Preserve_snapshot_delete_status delete_snapshot_files_with_status[\s\S]*?^}/m
  or die "could not isolate delete_snapshot_files_with_status\n";
my $delete_snapshot = $&;
die "snapshot deletion must use the default store factory\n"
  unless $delete_snapshot =~ /create_preserved_trx_default_store/s &&
         $delete_snapshot =~ /->remove_with_status\s*\(/s;
die "SQL orchestration must not keep token-only direct temp sidecar cleanup helper\n"
  if $preserve =~ /delete_preserved_temp_table_sidecars_by_token_or_log/s;

$preserve =~ /bool Sql_cmd_drain_transactions_preserve::execute[\s\S]*?^}/m
  or die "could not isolate Sql_cmd_drain_transactions_preserve::execute\n";
my $drain_sql_entry = $&;
die "DRAIN SQL entry must delegate to a command facade with parsed options only\n"
  unless $drain_sql_entry =~
         /Preserve_trx_drain_request\s+request\s*\{\s*m_options\s*\}/s &&
         $drain_sql_entry =~ /Preserve_trx_drain_service\s+service/s &&
         $drain_sql_entry =~ /return\s+service\.execute\s*\(\s*thd\s*,\s*request\s*\)/s;
die "DRAIN SQL entry must not directly own warm-copy, target enumeration, preserve kernel, or shutdown details\n"
  if $drain_sql_entry =~
     /Warmcopy|Preserve_batch_|Global_THD_manager|Preserve_trx_manager_state_guard|preserve_trx_preserve_attached_transaction|preserve_trx_execute_drain_transactions_preserve|shutdown\s*\(/s;

$preserve =~ /bool Preserve_trx_drain_service::execute[\s\S]*?^}/m
  or die "could not isolate Preserve_trx_drain_service::execute\n";
my $drain_service_impl = $&;
die "DRAIN service must route drain participant phases through DrainOrchestrator\n"
  unless $drain_service_impl =~ /Preserve_trx_drain_orchestrator/s;
die "DRAIN service must adapt warm-copy through DrainParticipant\n"
  unless $drain_service_impl =~ /Warmcopy_batch_drain_participant/s;
die "DRAIN service must not directly open warm-copy epochs\n"
  if $drain_service_impl =~ /\bopen_epoch\s*\(/s;
die "DRAIN service must not directly begin warm-copy closing\n"
  if $drain_service_impl =~ /\bbegin_closing\s*\(/s;
die "DRAIN service must not directly prepare warm-copy payloads\n"
  if $drain_service_impl =~
     /Warmcopy_prepare_idle_participants|Warmcopy_prepare_quiesced_targets|Warmcopy_tail_budget_validator|Warmcopy_open_admission_scope|Warmcopy_batch_blob_provider/s;

$preserve =~ /class Warmcopy_batch_drain_participant[\s\S]*?^};/m
  or die "could not isolate Warmcopy_batch_drain_participant\n";
my $warmcopy_participant = $&;
die "warm-copy drain participant must expose artifact/budget/progress observation\n"
  unless $warmcopy_participant =~ /observation\s*\(\s*\)\s+const\s+override/s &&
         $warmcopy_participant =~ /Preserve_trx_drain_participant_observation\s+m_observation/s &&
         $warmcopy_participant =~ /bytes_budget\s*=\s*preserve_trx_warmcopy_max_total_bytes/s &&
         $warmcopy_participant =~ /bytes_used\s*=\s*m_provider->total_bytes\s*\(\s*\)/s &&
         $warmcopy_participant =~ /phase1_progress/s &&
         $warmcopy_participant =~ /failure_reason/s;
die "warm-copy drain participant must report ready, degraded, abandoned, and finalized states\n"
  unless $warmcopy_participant =~ /Preserve_trx_drain_participant_state::READY/s &&
         $warmcopy_participant =~ /Preserve_trx_drain_participant_state::DEGRADED/s &&
         $warmcopy_participant =~ /Preserve_trx_drain_participant_state::ABANDONED/s &&
         $warmcopy_participant =~ /Preserve_trx_drain_participant_state::FINALIZED/s;
die "warm-copy participant must preserve concrete quiesced-target failure reason\n"
  unless $warmcopy_participant =~
         /prepare_quiesced_targets[\s\S]*mark_degraded\s*\(\s*"warm-copy quiesced target preparation failed"/s;
die "warm-copy participant must preserve concrete tail-budget failure reason\n"
  unless $warmcopy_participant =~
         /tail_budget_within_limits[\s\S]*mark_degraded\s*\(\s*"warm-copy tail budget exceeded"/s;
$warmcopy_participant =~ /void abort_phase\(\)[\s\S]*?^\s*}\n\n\s*void finalize_phase/m
  or die "could not isolate Warmcopy_batch_drain_participant::abort_phase\n";
my $warmcopy_participant_abort = $&;
die "warm-copy abort must not clear last observed bytes after a degraded failure\n"
  if $warmcopy_participant_abort =~ /bytes_used\s*=\s*0/s;

my $preserve_attached_start =
  index($preserve, 'bool preserve_trx_preserve_attached_transaction(');
die "could not isolate preserve_trx_preserve_attached_transaction\n"
  if $preserve_attached_start < 0;
my $preserve_attached_end =
  index($preserve, 'static const char *preserve_trx_drain_participant_state_name',
        $preserve_attached_start);
die "could not find preserve_trx_preserve_attached_transaction end\n"
  if $preserve_attached_end < 0;
my $preserve_attached =
  substr($preserve, $preserve_attached_start,
         $preserve_attached_end - $preserve_attached_start);
die "preserve public helper must route object construction through kernel\n"
  unless $preserve_attached =~ /Preserve_trx_kernel_request\s+request/s &&
         $preserve_attached =~ /preserve_trx_kernel_preserve_attached_transaction\s*\(\s*request\s*\)/s;
die "preserve public helper must not directly export objects or write snapshots\n"
  if $preserve_attached =~
     /create_preserved_trx_default_store|build_preserved_trx_bundle|trx_preserve_export_record_locks|trx_preserve_export_table_locks|trx_preserve_export_read_view/s;
die "preserve public helper must own client token delivery after kernel success\n"
  unless $preserve_attached =~ /preserved_trx_register_pending_token_delivery/s &&
         $preserve_attached =~ /\bmy_ok\s*\(/s;

my $preserve_kernel_start =
  index($preserve, 'bool preserve_trx_kernel_preserve_attached_transaction(');
die "could not isolate preserve_trx_kernel_preserve_attached_transaction\n"
  if $preserve_kernel_start < 0;
my $preserve_kernel_end =
  index($preserve, 'bool preserve_trx_preserve_attached_transaction(',
        $preserve_kernel_start);
die "could not find preserve_trx_kernel_preserve_attached_transaction end\n"
  if $preserve_kernel_end < 0;
my $preserve_kernel =
  substr($preserve, $preserve_kernel_start,
         $preserve_kernel_end - $preserve_kernel_start);
die "preserve kernel path must write snapshots through the default store factory until store/carrier slice splits it\n"
  unless $preserve_kernel =~ /create_preserved_trx_default_store/s &&
         $preserve_kernel =~ /->write\s*\(/s;
die "preserve kernel must not send client OK packets\n"
  if $preserve_kernel =~ /\bmy_ok\s*\(/s;
die "preserve kernel must not register pending token delivery\n"
  if $preserve_kernel =~ /preserved_trx_register_pending_token_delivery/s;

$preserve =~ /class Preserve_batch_quiesced_idle_target[\s\S]*?^};/m
  or die "could not isolate Preserve_batch_quiesced_idle_target\n";
my $quiesced_target = $&;
die "batch target early errors must clear QUIESCED/ATTACHING state\n"
  unless $quiesced_target =~ /clear_target_after_error/s &&
         $quiesced_target =~ /preserve_trx_is_unsupported_common_context\(candidate\)[\s\S]*clear_target_after_error\(candidate\)[\s\S]*return/s &&
         $quiesced_target =~ /!switch_thd\.active\(\)[\s\S]*clear_target_after_error\(candidate\)[\s\S]*return/s;

my $switch_pos = index($quiesced_target, 'Preserve_thd_context_switch switch_thd');
die "could not find batch target context-switch scope\n" if $switch_pos < 0;
my $scope_start = rindex(substr($quiesced_target, 0, $switch_pos), '{');
die "could not find batch target context-switch scope start\n"
  if $scope_start < 0;
my $depth = 0;
my $scope_end = -1;
for my $idx ($scope_start .. length($quiesced_target) - 1) {
  my $ch = substr($quiesced_target, $idx, 1);
  ++$depth if $ch eq '{';
  --$depth if $ch eq '}';
  if ($idx > $scope_start && $depth == 0) {
    $scope_end = $idx;
    last;
  }
}
die "could not find batch target context-switch scope end\n" if $scope_end < 0;
my $switch_scope = substr($quiesced_target, $scope_start, $scope_end - $scope_start + 1);
die "batch target must not clear state while THD globals are switched\n"
  if $switch_scope =~ /clear_target_after_error\s*\(/s;
die "batch target ATTACHING failures must defer state clear until after globals restore\n"
  unless $switch_scope =~ /!switch_thd\.active\(\)[\s\S]*early_target_error\s*=\s*true/s &&
         $switch_scope =~ /preserve_trx_is_unsupported_common_context\(candidate\)[\s\S]*early_target_error\s*=\s*true/s;
my $after_switch_scope = substr($quiesced_target, $scope_end + 1);
die "batch target deferred ATTACHING failures must clear after context-switch scope\n"
  unless $after_switch_scope =~ /if\s*\(\s*early_target_error\s*\)[\s\S]*clear_target_after_error\s*\(\s*candidate\s*\)[\s\S]*return/s;

$preserve =~ /void audit_preserved_trx_event[\s\S]*?^}/m
  or die "could not isolate audit_preserved_trx_event\n";
my $audit_helper = $&;
die "preserve-trx audit helper must emit MYSQL_AUDIT_MESSAGE_INTERNAL events\n"
  unless $audit_helper =~ /MYSQL_AUDIT_MESSAGE_INTERNAL/s &&
         $audit_helper =~ /preserved_transaction/s;
die "preserve-trx audit helper must redact tokens before audit emission\n"
  unless $audit_helper =~ /preserved_trx_redacted_token/s;
die "preserve-trx audit helper must include action, token, and result fields\n"
  unless $audit_helper =~ /"action"/s &&
         $audit_helper =~ /"token"/s &&
         $audit_helper =~ /"result"/s;
die "preserve-trx audit helper must allow null THD global dispatch for startup recovery\n"
  if $audit_helper =~ /thd\s*==\s*nullptr[\s\S]*return/s;

$preserve =~ /void preserved_trx_finalize_statement_response[\s\S]*?^}/m
  or die "could not isolate preserved_trx_finalize_statement_response\n";
my $token_delivery_finalization = $&;
die "successful live PRESERVE token delivery must emit an audit event\n"
  unless $token_delivery_finalization =~
         /audit_preserved_trx_event\s*\(\s*thd\s*,\s*token\s*,\s*"preserve"\s*,\s*"success"\s*\)/s;

die "batch preserve target success must emit an audit event\n"
  unless $preserve =~
         /batch_delivery[\s\S]*?audit_preserved_trx_event\s*\(\s*thd\s*,\s*token\s*,\s*"preserve"\s*,\s*"success"\s*\)/s;
die "manager state and drain owner must be published as one packed snapshot\n"
  unless $preserve =~ /std::atomic<uint64_t>\s+g_manager_state_owner/s &&
         $preserve =~ /preserve_trx_manager_state_owner_snapshot/s;
die "manager state and drain owner must not use legacy split atomics\n"
  if $preserve =~ /std::atomic<Preserve_trx_manager_state>\s+g_manager_state/s ||
     $preserve =~ /std::atomic<my_thread_id>\s+g_draining_thread_id/s;
die "batch cleanup failure must not publish ownerless SHUTDOWN_REQUESTED state\n"
  if $preserve =~
     /g_draining_thread_id\.store\s*\(\s*0\s*\)[\s\S]*g_manager_state\.store\s*\(\s*Preserve_trx_manager_state::SHUTDOWN_REQUESTED\s*\)/s;
$preserve =~ /auto finish_cleanup_failure_without_shutdown = \[\&\]\(const char \*stage\) \{([\s\S]*?)^\s*\};/m
  or die "could not isolate batch cleanup failure no-shutdown helper\n";
my $batch_cleanup_failure_no_shutdown = $1;
die "batch cleanup failure helper must not call shutdown\n"
  if $batch_cleanup_failure_no_shutdown =~ /shutdown\s*\(/s;
die "batch cleanup failure helper must clear non-preserved targets, abort participants, and return cleanup-failed error\n"
  unless $batch_cleanup_failure_no_shutdown =~ /Preserve_batch_clear_generation/s &&
         $batch_cleanup_failure_no_shutdown =~ /abort_drain_participants\s*\(\s*stage\s*\)/s &&
         $batch_cleanup_failure_no_shutdown =~ /preserve_trx_reject_batch_cleanup_failed\s*\(\s*\)/s;
die "batch cleanup failure must use a dedicated client error\n"
  unless $preserve =~ /ER_PRESERVE_TRX_BATCH_CLEANUP_FAILED/s;
$preserve =~ /DEBUG_SYNC\s*\(\s*thd\s*,\s*"preserve_trx_batch_after_targets_quiesced_before_attach"\s*\)([\s\S]*?)Preserve_batch_quiesced_idle_target\s+batch/m
  or die "batch drain must expose a pre-attach sync point after targets are quiesced\n";
die "pre-attach sync point must be before target context-switch attach loop\n"
  if $& =~ /preserve_trx_preserve_attached_transaction/s;
$preserve =~ /void reset_thd_after_preserve_detach\(THD \*thd\)([\s\S]*?)^}/m
  or die "could not isolate reset_thd_after_preserve_detach\n";
my $reset_after_detach = $1;
die "preserve detach reset must end the THD PSI transaction before clearing its handle\n"
  unless $reset_after_detach =~ /MYSQL_ROLLBACK_TRANSACTION\s*\(\s*thd->m_transaction_psi\s*\)[\s\S]*thd->m_transaction_psi\s*=\s*nullptr/s;
die "batch reattach activation failure must not leave an active transaction attached\n"
  unless $preserve =~
         /trx_preserve_activate_reattached_in_original_thd[\s\S]*restore_record_after_failure/s &&
         $preserve =~
         /static bool restore_batch_record_to_original_thd[\s\S]*if\s*\(attached\)[\s\S]*trx_preserve_detach_resumed_from_thd/s;

$preserve =~ /static bool restore_batch_record_to_original_thd[\s\S]*?^}/m
  or die "could not isolate restore_batch_record_to_original_thd for WI-29\n";
my $wi29_batch_restore = $&;
die "batch reattach attached-detach failure must restore token or terminate after publishing failure\n"
  if $wi29_batch_restore =~
     /else\s*\{\s*thd_state_guard\.dismiss\s*\(\s*\)\s*;\s*return true\s*;\s*\}/s;
die "batch restore delete-before-unlink cleanup failure after activation must taint the stale snapshot\n"
  unless $wi29_batch_restore =~
         /ERROR_BEFORE_SNAPSHOT_DELETE[\s\S]*mark_tainted\s*\(\s*item\.token\s*\)/s;
die "batch restore delete-after-unlink cleanup failure must clear the target batch state\n"
  unless $wi29_batch_restore =~
         /ERROR_AFTER_SNAPSHOT_DELETE[\s\S]*preserve_trx_set_batch_state\s*\(\s*thd\s*,\s*0\s*,\s*Preserve_trx_batch_thd_state::NONE\s*\)/s;

$preserve =~ /static bool reattach_current_batch_preserve_failure_to_original_thd[\s\S]*?^}/m
  or die "could not isolate reattach_current_batch_preserve_failure_to_original_thd for WI-29\n";
my $wi29_current_reattach = $&;
my $wi29_current_delete_pos =
  index($wi29_current_reattach, 'delete_snapshot_after_activation();');
my $wi29_current_activate_pos =
  index($wi29_current_reattach, 'trx_preserve_activate_reattached_in_original_thd');
die "current batch cleanup must activate reattached undo state before durable snapshot delete\n"
  unless $wi29_current_delete_pos >= 0 && $wi29_current_activate_pos >= 0 &&
         $wi29_current_activate_pos < $wi29_current_delete_pos;
die "current batch cleanup snapshot delete-before-unlink failure after activation must taint the stale snapshot\n"
  unless $wi29_current_reattach =~
         /ERROR_BEFORE_SNAPSHOT_DELETE[\s\S]*mark_tainted\s*\(\s*token\s*\)/s;
die "current batch cleanup snapshot delete-before-unlink failure must restore SQL transaction state before returning to the app session\n"
  unless $wi29_current_reattach =~
         /ERROR_BEFORE_SNAPSHOT_DELETE[\s\S]*mark_tainted\s*\(\s*token\s*\)[\s\S]*reset_preserve_xid_to_active_transaction_xid\s*\(\s*thd\s*\)[\s\S]*preserve_trx_set_batch_state\s*\(\s*thd\s*,\s*0\s*,\s*Preserve_trx_batch_thd_state::NONE\s*\)/s;
die "current batch cleanup snapshot delete-after-unlink failure must not keep the target drained\n"
  unless $preserve =~
         /restored_active_to_original_thd[\s\S]*unresolved_detached_state[\s\S]*must_keep_target_drained\s*=\s*!m_error\s*\|\|\s*unresolved_detached_state/s;
die "current batch reattach activation failure must detach before caller rollback cleanup\n"
  unless $wi29_current_reattach =~
         /trx_preserve_activate_reattached_in_original_thd[\s\S]*!=\s*DB_SUCCESS[\s\S]*trx_preserve_detach_resumed_from_thd_for_cleanup/s;
die "batch target post-detach heuristic must recognize completed rollback cleanup\n"
  unless $preserve =~
         /cleanup_completed_after_detach_failure[\s\S]*durable_point_crossed/s &&
         $preserve =~
         /cleanup_completed_after_detach_failure[\s\S]*must_keep_target_drained/s;
die "batch post-detach rollback cleanup must publish a completed-cleanup result\n"
  unless $preserve =~
         /rollback_claimed_after_detach_failure[\s\S]*cleanup_completed_after_detach_failure[\s\S]*rollback_status\s*==\s*DB_SUCCESS/s;
die "WI-29 runtime MTR must have a post-detach batch reattach failpoint\n"
  unless $preserve =~ /preserve_trx_fail_after_detach_for_batch_reattach/s &&
         $trx_preserve =~ /preserve_trx_fail_activate_reattached_original/s;
die "Slice 2 local carrier must expose crash hook before snapshot .bin rename\n"
  unless $carrier_file =~
         /snapshot_file[\s\S]*preserve_trx_crash_before_snapshot_rename[\s\S]*install_temp_file/s;
die "recovered-count rewrite must remove stale snapshot temp files before atomic replacement\n"
  unless $carrier_file =~
         /rewrite_existing[\s\S]*remove_stale_tmp_before_create[\s\S]*atomic_write_file\s*\([^;]*remove_stale_tmp_before_create/s;
$carrier_file =~ /Preserve_snapshot_delete_status remove_stale_tmp_files_for_token[\s\S]*?^}/m
  or die "could not isolate remove_stale_tmp_files_for_token\n";
my $stale_tmp_cleanup = $&;
die "stale tmp cleanup must delete only tmp snapshot and sidecar artifacts\n"
  unless $stale_tmp_cleanup =~ /token\s*\+\s*"\.bin\.tmp"/s &&
         $stale_tmp_cleanup =~ /token\s*\+\s*"\.binlog_cache\.tmp"/s &&
         $stale_tmp_cleanup =~ /token\s*\+\s*"\.tainted\.tmp"/s &&
         $stale_tmp_cleanup =~ /remove_generic_external_blobs_for_token\s*\(\s*dir\s*,\s*token\s*,\s*true\s*,\s*false/s &&
         $stale_tmp_cleanup =~ /remove_temp_sidecars_for_token[\s\S]*Temp_sidecar_removal_mode::NON_COMMITTED_ARTIFACTS/s &&
         $stale_tmp_cleanup !~ /remove_generic_external_blobs_for_token\s*\(\s*dir\s*,\s*token\s*,\s*false\s*,\s*true/s &&
         $stale_tmp_cleanup !~ /Temp_sidecar_removal_mode::ALL/s;
$carrier_file =~ /Preserve_snapshot_delete_status delete_snapshot_files_with_status[\s\S]*?^}/m
  or die "could not isolate local carrier delete_snapshot_files_with_status\n";
my $carrier_delete_snapshot = $&;
my $install_temp_file_start =
  index($carrier_file, 'Atomic_write_status install_temp_file');
my $install_temp_file_end =
  index($carrier_file, 'Atomic_write_status atomic_write_file',
        $install_temp_file_start);
die "could not isolate install_temp_file\n"
  if $install_temp_file_start < 0 || $install_temp_file_end < 0 ||
     $install_temp_file_end <= $install_temp_file_start;
my $install_temp_file =
  substr($carrier_file, $install_temp_file_start,
         $install_temp_file_end - $install_temp_file_start);
my $link_success_start =
  index($install_temp_file,
        'if (link(tmp_path.c_str(), final_path.c_str()) == 0)');
my $link_success_end =
  index($install_temp_file, 'set_my_errno(errno);', $link_success_start);
die "could not isolate install_temp_file link-success branch\n"
  if $link_success_start < 0 || $link_success_end < 0 ||
     $link_success_end <= $link_success_start;
my $link_success_branch =
  substr($install_temp_file, $link_success_start,
         $link_success_end - $link_success_start);
die "install_temp_file must treat link-success tmp cleanup failure as a stale-artifact cleanup issue, not an untracked final-file failure\n"
  unless $link_success_branch =~
         /my_delete\s*\(tmp_path\.c_str\(\)[\s\S]*return\s+Atomic_write_status::OK/s &&
         $link_success_branch !~ /Atomic_write_status::IO_ERROR/s;
my $snapshot_unlink_pos =
  index($carrier_delete_snapshot, 'my_delete(snapshot_path.c_str()');
my $binlog_delete_pos =
  index($carrier_delete_snapshot, 'delete_optional_sidecar(binlog_cache_path)');
my $stale_tmp_call_pos =
  index($carrier_delete_snapshot, 'remove_stale_tmp_files_for_token');
my $temp_all_pos =
  index($carrier_delete_snapshot, 'Temp_sidecar_removal_mode::ALL');
die "Slice 2 stale tmp artifacts should be cleaned before main snapshot unlink\n"
  unless $stale_tmp_call_pos >= 0 &&
         $snapshot_unlink_pos >= 0 &&
         $stale_tmp_call_pos < $snapshot_unlink_pos;
die "Slice 2 committed sidecars must not be deleted before the main snapshot unlink barrier\n"
  unless $temp_all_pos > $snapshot_unlink_pos &&
         $binlog_delete_pos > $snapshot_unlink_pos &&
         $binlog_delete_pos < $temp_all_pos;
die "Slice 2 SQL success cleanup must not directly delete temp-table sidecars after store removal\n"
  unless $delete_snapshot !~
         /preserve_trx_temp_table_remove_token_sidecars/s;
die "Slice 2 snapshot-failure cleanup must use unified token removal, not direct temp sidecar deletion\n"
  unless $preserve =~
         /reject_after_snapshot_failure[\s\S]*delete_preserved_snapshot_files_and_sidecars_or_log\s*\(\s*preserve_trx_default_dir\(\)\s*,\s*token\s*,\s*&metadata\s*\)/s &&
         $preserve =~
         /reject_after_snapshot_failure[\s\S]*store->mark_tainted\s*\(\s*token\s*\)/s &&
         $preserve !~
         /reject_after_snapshot_failure[\s\S]*write_failure_delete_status\s*==\s*Preserve_snapshot_delete_status::OK[\s\S]*delete_snapshot_files/s &&
         $preserve !~
         /reject_after_snapshot_failure[\s\S]*delete_preserved_temp_table_sidecars_by_token_or_log/s;
die "Slice 2 bootstrap temp orphan cleanup must route through Preserved_trx_store remove_with_status\n"
  unless $preserve =~
         /delete_orphan_temp_table_sidecars_or_log[\s\S]*Preserved_trx_store\s*&store[\s\S]*store\.remove_with_status/s &&
         $preserve =~ /delete_orphan_temp_table_sidecars_or_log\s*\(\s*store\.store\(\)\s*,\s*listing\s*\)/s;
die "temporary tablespace bootstrap must skip force recovery before carrier scan\n"
  unless $preserve =~
         /bool preserved_temp_images_bootstrap_preamble\s*\(\s*\)\s*\{\s*if\s*\(srv_force_recovery\s*>\s*0\)\s*return\s+false;\s*const std::string dir[\s\S]*create_preserved_trx_default_store/s;
die "temporary tablespace bootstrap must snapshot-read headers before validating temp sidecars\n"
  unless $preserve =~
         /bool preserved_temp_images_bootstrap_preamble[\s\S]*store->read\s*\(\s*token\s*,\s*true\s*,\s*Preserved_trx_carrier::Payload_read_mode::SNAPSHOT_ONLY[\s\S]*validate_temp_sidecars_for_bootstrap/s &&
         $preserve =~
         /Preserve_snapshot_status validate_temp_sidecars_for_bootstrap[\s\S]*preserve_trx_temp_table_validate_sidecars/s;
die "startup recovery must delete stale tmp files for durable snapshot tokens without deleting final artifacts\n"
  unless $preserve =~
         /for\s*\(\s*const std::string &token\s*:\s*snapshot_tokens\s*\)[\s\S]*delete_stale_tmp_files_or_log\s*\(\s*store\.store\(\)\s*,\s*token\s*\)[\s\S]*recover_preserved_snapshot/s;
my $bundle_doc_matches =
  $bundle_doc eq '' ||
  ($bundle_doc =~ /Format Version 8 and TLV Extensions/s &&
   $bundle_doc =~ /0x81[\s\S]*kTlvExternalBlobDescriptors/s &&
   $bundle_doc =~ /> 8/s);
die "TLV registry source contract must keep the current writer format and multi-blob descriptor tag\n"
  unless $bundle =~ /constexpr uint16_t kSnapshotFormatVersion\s*=\s*8\s*;/s &&
         $bundle =~ /constexpr uint16_t kTlvExternalBlobDescriptors\s*=\s*0x81\s*;/s &&
         $bundle =~ /format_version\s*<\s*8[\s\S]*kTlvExternalBlobDescriptors/s &&
         $bundle_doc_matches;
die "SQL savepoint validator must bound binlog positions and event counters by snapshot metadata\n"
  unless $bundle =~
         /bool sql_savepoints_payload_is_valid[\s\S]*max_binlog_position[\s\S]*max_binlog_event_counter[\s\S]*binlog_position\s*>\s*max_binlog_position[\s\S]*checkpoint_event_counter\s*>\s*max_binlog_event_counter/s &&
         $bundle =~
         /sql_savepoints_payload_is_valid\s*\(\s*metadata\.sql_savepoints_payload[\s\S]*metadata\.binlog_cache_size[\s\S]*metadata\.binlog_cache_event_counter/s &&
         $gunit =~ /BinlogSavepointPositionCannotExceedPayload/s &&
         $gunit =~ /BinlogSavepointEventCounterCannotExceedCache/s;
die "startup recovery success must emit an audit event\n"
  unless $recover_snapshot =~
         /audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"recover"\s*,\s*"success"\s*\)/s;

$preserve =~ /bool Sql_cmd_resume_preserved_transaction::execute[\s\S]*?^}/m
  or die "could not isolate Sql_cmd_resume_preserved_transaction::execute\n";
my $resume_execute_audit = $&;
die "successful RESUME must emit an audit event\n"
  unless $resume_execute_audit =~
         /audit_preserved_trx_event\s*\(\s*thd\s*,\s*token\s*,\s*"resume"\s*,\s*"success"\s*\)/s;
die "RESUME must revalidate durable carrier contents before attaching the preserved transaction\n"
  unless $resume_execute_audit =~
         /store->read\s*\(\s*token\s*,\s*true\s*,\s*Preserved_trx_carrier::Payload_read_mode::\s*METADATA_ONLY\s*,\s*&durable_bundle\s*\)[\s\S]*durable_status\s*==\s*Preserve_snapshot_status::CORRUPT[\s\S]*rollback_resumable_record_after_corrupt_snapshot[\s\S]*my_error\s*\(\s*ER_PRESERVE_TRX_CORRUPT_SNAPSHOT/s;
die "RESUME not-found privilege probe must not load external blob payloads\n"
  unless $resume_execute_audit =~
         /token_is_filename_safe\s*\(\s*token\s*\)[\s\S]*store->read\s*\(\s*token\s*,\s*true\s*,\s*Preserved_trx_carrier::Payload_read_mode::\s*METADATA_ONLY\s*,\s*&bundle\s*\)/s;
my $resume_take_pos = index($resume_execute_audit,
                            'preserved_trx_take_resumable_record');
die "RESUME must not full-read durable carrier before claiming the record\n"
  if $resume_take_pos > 0 &&
     substr($resume_execute_audit, 0, $resume_take_pos) =~
       /store->read\s*\(\s*token\s*,\s*true\s*,\s*&/s;

$preserve =~ /static void rollback_pending_token_delivery_record[\s\S]*?^}/m
  or die "could not isolate rollback_pending_token_delivery_record\n";
my $token_delivery_rollback = $&;
die "token-delivery failure rollback must emit an audit event\n"
  unless $token_delivery_rollback =~
         /audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"rollback"/s;

die "recovery failure rollback must emit an audit event\n"
  unless $preserve =~
         /static bool rollback_preserved_snapshot_or_log[\s\S]*?audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"rollback"/s &&
         $preserve =~
         /static bool rollback_claimed_preserved_snapshot_or_log[\s\S]*?audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*token\s*,\s*"rollback"/s;
die "resume-timeout rollback must emit an audit event\n"
  unless $resume_timeout_rollback =~
         /audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*record\.metadata\.token\s*,\s*"rollback"\s*,\s*"timeout"/s;
die "resume corrupt-snapshot rollback must emit an audit event\n"
  unless $preserve =~
         /static bool rollback_resumable_record_after_corrupt_snapshot[\s\S]*?audit_preserved_trx_event\s*\(\s*current_thd\s*,\s*record\.metadata\.token\s*,\s*"rollback"\s*,\s*"failure"/s;
EOF

SELECT 'ok' AS code_review_resumable_trx_slices_lint;

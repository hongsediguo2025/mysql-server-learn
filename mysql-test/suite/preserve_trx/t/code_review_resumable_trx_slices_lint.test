my $unsupported_contents = $&;
die "unsupported transaction check must include STMT-scope non-transactional changes\n"
  unless $unsupported_contents =~ /has_modified_non_trans_table\s*\(\s*Transaction_ctx::STMT/s;
die "generic unsupported transaction check must leave temp row-history decisions to the temp-table manifest layer\n"
  if $unsupported_contents =~ /preserve_trx_temp_table_has_row_history/s;

my $unsupported_preflight_pos =
  index($preserve, 'const bool unsupported_transaction_contents =');
my $unsupported_call_pos = $unsupported_preflight_pos < 0 ? -1 :
  index($preserve,

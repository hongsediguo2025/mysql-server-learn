my $context_switch = $&;
die "batch THD context switch must lock target THD data for the final attach guard\n"
  unless $context_switch =~ /LOCK_thd_data/ &&
         $context_switch =~ /preserve_trx_batch_state/;
die "batch THD context switch must restore ATTACHING targets on early return\n"

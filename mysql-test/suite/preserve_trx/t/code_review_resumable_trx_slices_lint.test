die "temp update hook must run for transactional temp rows even when the feature gate is disabled\n"
  unless $handler_update_row_untracked =~ /preserve_trx_temp_table_row_capture_candidate[\s\S]*preserve_trx_temp_table_note_row_update/s;
die "temp delete hook must run for transactional temp rows even when the feature gate is disabled\n"
  unless $handler_delete_row_untracked =~ /preserve_trx_temp_table_row_capture_candidate[\s\S]*preserve_trx_temp_table_note_row_delete/s;

$temp_table =~ /Preserve_snapshot_status preserve_trx_temp_table_materialize_for_resume[\s\S]*?^}/m

die "temp-table no-redo undo preflight must fail closed before preserve lock/prepare flow\n"
  unless $prelock_preserve_window =~
         /temp_preflight_status\s*!=\s*Preserve_snapshot_status::OK[\s\S]*return\s+reject_after_binlog_export\s*\(\s*"temp_table_no_redo_undo_unsupported"\s*\)/s;

$preserve =~ /bool no_cache_gtid_state_is_clean[\s\S]*?^}/m

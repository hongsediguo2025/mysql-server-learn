$preserve =~ /void preserved_trx_finalize_statement_response[\s\S]*?^}/m
  or die "could not isolate preserved_trx_finalize_statement_response\n";
my $token_delivery_finalization = $&;
die "statement response finalize wrapper must be inert when preserve_trx_enable is OFF\n"

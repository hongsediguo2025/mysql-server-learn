die "standby transfer receiver dispatch failure log must include decoded frame type when available\n"
  unless $transfer_dispatch_command =~
         /preserve_trx_transfer_decode_frame\s*\(\s*encoded_frame[\s\S]*frame_type[\s\S]*std::to_string\s*\(\s*static_cast<int>\s*\(\s*decoded_frame\.type\s*\)\s*\)/s;
$transfer =~

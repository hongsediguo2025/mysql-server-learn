$preserve =~ /std::atomic<size_t>\s+next_startup_recovery_index[\s\S]*?for\s*\(std::thread\s+&worker\s*:\s*startup_recovery_workers\)/m
  or die "could not isolate startup recovery worker pool\n";
my $startup_recovery_worker_pool = $&;
die "startup recovery worker must catch exceptions and still call my_thread_end\n"

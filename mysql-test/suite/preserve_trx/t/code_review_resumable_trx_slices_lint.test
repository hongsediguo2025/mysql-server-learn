die "single-trx hard drain timeout test must be able to keep active transactions alive deterministically\n"
  unless $single_drain =~ /preserve_trx_drain_skip_kill_active/s;

$preserve =~ /bool preserve_trx_drain_other_active_transactions[\s\S]*?^}/m
  or die "could not isolate preserve_trx_drain_other_active_transactions\n";
my $single_drain_loop = $&;
die "single-trx hard drain must have a configurable absolute timeout\n"
  unless $single_drain_loop =~ /preserve_trx_drain_hard_timeout_ms/s &&
         $single_drain_loop =~ /hard_deadline_us/s &&
         $single_drain_loop =~ /ER_PRESERVE_TRX_DRAIN_TIMEOUT/s;
die "single-trx hard drain must arm its deadline when hard mode begins\n"
  unless $single_drain_loop =~ /auto\s+arm_hard_deadline/s &&
         $single_drain_loop =~ /if\s*\(\s*hard_drain\s*\)\s*arm_hard_deadline/s &&

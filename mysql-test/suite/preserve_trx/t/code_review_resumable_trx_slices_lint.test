die "no-cache GTID preserve must require GTID_NEXT=AUTOMATIC\n"
  unless $no_cache_gtid =~ /gtid_next\.type\s*!=\s*AUTOMATIC_GTID/s;
my $gtid_next_list_ifdef_start = index($no_cache_gtid, '#ifdef HAVE_GTID_NEXT_LIST');
my $gtid_next_list_ifdef_end =
  $gtid_next_list_ifdef_start < 0 ? -1 :
  index($no_cache_gtid, '#endif', $gtid_next_list_ifdef_start);
my $owned_sidno_pos = index($no_cache_gtid, 'OWNED_SIDNO_GTID_SET');
die "OWNED_SIDNO_GTID_SET rejection must not depend on HAVE_GTID_NEXT_LIST\n"

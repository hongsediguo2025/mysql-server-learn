my $resume_execute_for_failure_guards = $&;

$resume_execute_for_failure_guards =~ /if\s*\(restore_savepoints_to_thd[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate RESUME savepoint failure branch\n";
my $resume_savepoint_failure = $&;
die "RESUME savepoint failure branch must route through detach cleanup helper\n"
  unless $resume_savepoint_failure =~ /detach_resumed_after_failure/s &&
         $resume_savepoint_failure !~ /else\s*\{[\s\S]*thd_state_guard\.dismiss/s;

$resume_execute_for_failure_guards =~ /if\s*\(trx_preserve_activate_resumed\(record\.trx\)[\s\S]*?return preserve_trx_reject_unsupported\(\);/m
  or die "could not isolate RESUME activation failure branch\n";

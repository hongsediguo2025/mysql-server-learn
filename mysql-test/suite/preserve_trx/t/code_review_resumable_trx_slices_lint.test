my $temp_stage_dirty_page = $&;
$mtr =~ /void add_dirty_page_to_flush_list\(mtr_memo_slot_t \*slot\) const[\s\S]*?buf_flush_note_modification/m
  or die "could not isolate add_dirty_page_to_flush_list\n";
my $mtr_add_dirty_page = $&;
die "mtr dirty-page hot path must test temp preserve hook enablement before staging a page image\n"
  unless $mtr_add_dirty_page =~
           /trx_preserve_temp_space_image_dirty_page_hook_enabled\s*\(\s*\)[\s\S]*trx_preserve_temp_space_image_stage_dirty_page\s*\(/s;
my $temp_stage_active_filter_pos =
  index($temp_stage_dirty_page,
        'trx_preserve_temp_space_image_may_have_active_stream');
my $temp_stage_reserve_pos =
  index($temp_stage_dirty_page,
        'trx_preserve_temp_space_image_try_reserve_staged_dirty_page_bytes');
my $temp_stage_copy_pos =
  index($temp_stage_dirty_page, 'staged.bytes.assign');
my $temp_stage_count_add_pos =
  index($temp_stage_dirty_page,
        'trx_preserve_temp_staged_dirty_page_count.fetch_add');
die "temp dirty-page staging must filter active source-space before admission accounting\n"
  unless $temp_stage_active_filter_pos >= 0 &&
         $temp_stage_count_add_pos >= 0 &&
         $temp_stage_active_filter_pos < $temp_stage_count_add_pos;
die "temp dirty-page staging must resolve source-space membership and staged-byte budget before copying page bytes\n"
  unless $temp_stage_reserve_pos >= 0 && $temp_stage_copy_pos >= 0 &&
         $temp_stage_reserve_pos < $temp_stage_copy_pos;

$handler =~ /int handler::ha_update_row[\s\S]*?^}/m
  or die "could not isolate handler::ha_update_row\n";
my $handler_update_row = $&;
die "ha_update_row must gate temp-table payload copy before allocating old+new payload\n"
  unless $handler_update_row =~ /preserve_trx_temp_table_row_capture_candidate/s &&
         index($handler_update_row, 'preserve_trx_temp_table_row_capture_candidate') >= 0 &&
         index($handler_update_row, 'preserve_trx_temp_table_enable') >= 0 &&
         index($handler_update_row, 'std::string payload') >= 0 &&
         index($handler_update_row, 'preserve_trx_temp_table_row_capture_candidate') <
         index($handler_update_row, 'preserve_trx_temp_table_enable') &&
         index($handler_update_row, 'preserve_trx_temp_table_enable') <
         index($handler_update_row, 'std::string payload') &&
         $handler_update_row =~
           /!\s*preserve_trx_temp_table_enable[\s\S]*preserve_trx_temp_table_note_row_update\s*\(\s*ha_thd\(\)\s*,\s*table\s*,\s*nullptr\s*,\s*0\s*\)/s;

$binlog_ostream =~ /bool Binlog_cache_storage::write[\s\S]*?^}/m

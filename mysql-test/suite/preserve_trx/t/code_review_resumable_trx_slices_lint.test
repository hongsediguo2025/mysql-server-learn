         $promotion =~
         /preserved_trx_set_promotion_apply_state_provider_for_unit_test[\s\S]*preserved_trx_set_promotion_apply_state_provider\s*\(\s*provider\s*\)/s;
die "standby promotion must not synthesize apply-reached from local redo without a provider or DBUG seam\n"
  if $promotion_gate =~
     /apply_state\.apply_frozen\s*=\s*true[\s\S]{0,240}trx_preserve_current_redo_lsn/s;
die "standby promotion prewarm may hydrate standby-pending artifacts only outside the gate\n"
  unless $promotion =~ /preserved_trx_promotion_prewarm_standby_pending_token/s &&
         $promotion =~ /WITH_SEMANTIC_EXTERNAL_BLOBS/s;
die "standby promotion batch prewarm must use a bounded worker pool over the shared single-token prewarm helper\n"
  unless $promotion_header =~ /preserved_trx_promotion_prewarm_standby_pending_tokens/s &&
         $promotion =~ /preserved_trx_promotion_prewarm_standby_pending_tokens[\s\S]*std::atomic<size_t>\s+next_token/s &&
         $promotion =~ /preserved_trx_promotion_prewarm_standby_pending_tokens[\s\S]*worker_count/s &&
         $promotion =~ /preserved_trx_promotion_prewarm_standby_pending_tokens[\s\S]*workers\.emplace_back\s*\(\s*run_worker\s*\)/s &&
         $promotion =~ /preserved_trx_promotion_prewarm_standby_pending_tokens[\s\S]*preserved_trx_promotion_prewarm_standby_pending_token/s;
die "standby promotion Phase D execute mode must not report READY tokens as skipped success\n"
  unless $promotion_header =~ /execute_adopt/s &&
         $promotion_header =~ /Preserve_trx_promotion_adopt_executor/s &&
         $promotion_header =~
         /preserved_trx_promotion_ready_cache_put_bundle_for_unit_test/s &&
         $promotion_header =~
         /preserved_trx_promotion_prewarm_standby_pending_token/s &&
         $promotion_gate =~ /request\.execute_adopt/s &&
         $promotion_gate =~ /cache_entry\.has_ready_bundle/s &&
         $promotion =~ /promotion_adopt_ready_bundle_default/s &&
         $promotion =~ /write_adopted_marker_for_tokens/s &&
         $promotion_gate =~ /promotion-ready record not built/s;
$preserve =~
  /bool preserved_trx_adopt_ready_bundle_for_promotion\s*\([\s\S]*?^}/m
  or die "could not isolate preserved_trx_adopt_ready_bundle_for_promotion\n";
my $promotion_ready_adopt_helper = $&;
die "standby promotion Phase D helper must delegate claim/import/register to the shared startup recover/adopt kernel\n"
  unless $promotion_ready_adopt_helper =~
         /preserved_trx_recover_or_adopt_bundle_shared/s;
die "standby promotion Phase D helper must not directly claim, import semantic state, or register preserved records\n"
  if $promotion_ready_adopt_helper =~
     /trx_preserve_claim_prepared\s*\(|trx_preserve_import_read_view\s*\(|trx_preserve_import_table_locks\s*\(|trx_preserve_import_record_locks\s*\(|create_detached_mdl_context\s*\(|preserved_trx_add_record\s*\(/s;
die "shared startup recover/adopt kernel must contain claim/import/register and post-claim rollback\n"
  unless $preserve =~
         /preserved_trx_recover_or_adopt_bundle_shared[\s\S]*trx_preserve_claim_prepared[\s\S]*trx_preserve_import_read_view[\s\S]*trx_preserve_import_table_locks[\s\S]*trx_preserve_import_record_locks[\s\S]*create_detached_mdl_context[\s\S]*preserved_trx_add_record[\s\S]*trx_preserve_rollback_claimed/s;
die "promotion-adopted records must be registered as promotion-owned and non-resumable until the promotion resume core consumes them\n"
  unless $preserve =~ /ADOPTED_FOR_PROMOTION/s &&
         $shared_recover_adopt_kernel =~
         /preserved_trx_add_record\s*\(\s*metadata\s*,\s*trx\s*,\s*local_startup\s*,[\s\S]*local_startup\s*\?\s*Preserved_trx_lifecycle_state::PRESERVED\s*:\s*Preserved_trx_lifecycle_state::ADOPTED_FOR_PROMOTION/s;
$resume_core =~ /if\s*\(\s*!record\.resumable\s*\)[\s\S]*?return preserve_trx_reject_unsupported\s*\(\s*\);/m
  or die "could not isolate SQL RESUME non-resumable branch\n";
my $non_resumable_resume_branch = $&;
die "ordinary SQL RESUME must not turn non-resumable promotion-owned records into FAILED records\n"
  unless $non_resumable_resume_branch =~ /preserved_trx_update_record_last_error/s &&
         $non_resumable_resume_branch !~ /preserved_trx_update_record_error/s;
die "resume core must be policy-scoped so SQL users cannot construct PROMOTION_RESUME_ON_THD\n"
  unless $preserve =~ /enum\s+class\s+Preserved_trx_resume_policy[\s\S]*SQL_RESUME[\s\S]*PROMOTION_RESUME_ON_THD/s &&
         $resume_core =~ /const\s+Preserved_trx_resume_options\s*&options/s &&
         $resume_execute =~ /Preserved_trx_resume_policy::SQL_RESUME/s &&
         $resume_execute !~ /PROMOTION_RESUME_ON_THD/s;
die "promotion-owned records must have a dedicated take helper guarded by ADOPTED_FOR_PROMOTION and non-resumable state\n"
  unless $preserve =~ /preserved_trx_take_promotion_adopted_record[\s\S]*ADOPTED_FOR_PROMOTION[\s\S]*!it->resumable/s &&
         $resume_core =~ /preserved_trx_take_promotion_adopted_record/s;
die "promotion resume-on-THD must be exposed only through a protected peer THD handle\n"
  unless $preserve_header =~ /class\s+Preserved_trx_peer_thd_handle[\s\S]*THD\s*\*\s*get\s*\(\s*\)\s*const/s &&
         $preserve_header =~ /using\s+Preserved_trx_peer_thd_resolver\s*=[\s\S]*Preserved_trx_peer_thd_handle\s*\*/s &&
         $preserve =~ /preserved_trx_resume_adopted_for_promotion_on_thd\s*\(\s*Preserved_trx_peer_thd_handle\s*\*/s &&
         $preserve !~ /preserved_trx_resume_adopted_for_promotion_on_thd\s*\(\s*THD\s*\*/s;
die "shared startup recover/adopt kernel must accept operation options with a monotonic deadline\n"
  unless $preserve =~ /struct Preserved_trx_recover_or_adopt_options[\s\S]*deadline_us/s &&
         $shared_recover_adopt_kernel =~ /const Preserved_trx_recover_or_adopt_options\s*&options/s &&
         $shared_recover_adopt_kernel =~ /recover_or_adopt_deadline_expired/s;
die "promotion default adopt path must pass gate_timeout_ms as the shared-kernel deadline\n"
  unless $promotion =~
         /promotion_adopt_ready_bundle_default[\s\S]*gate_deadline_us[\s\S]*preserved_trx_adopt_ready_bundle_for_promotion\s*\([\s\S]*gate_deadline_us/s &&
         $promotion_gate =~ /gate_deadline_us\s*=\s*my_micro_time\s*\(\s*\)\s*\+\s*request\.gate_timeout_ms\s*\*\s*1000/s;
die "promotion gate must fail closed when the requested token count exceeds the batch budget\n"
  unless $promotion_header =~ /gate_batch_tokens/s &&
         $promotion_gate =~
         /requested_tokens\.size\s*\(\s*\)\s*>\s*request\.gate_batch_tokens/s &&
         $promotion_gate =~ /TOO_MANY_PROMOTION_TOKENS/s;
die "promotion gate worker_count must drive a bounded adopt worker pool\n"
  unless $promotion =~ /#include\s+<thread>/s &&
         $promotion_gate =~ /std::atomic<size_t>\s+next_task/s &&
         $promotion_gate =~ /request\.worker_count/s &&
         $promotion_gate =~ /workers\.emplace_back\s*\(\s*run_worker\s*\)/s;
die "standby promotion Phase D helper must not delete standby artifacts inside the promotion gate\n"
  if $promotion_ready_adopt_helper =~
     /delete_preserved_snapshot_files_and_sidecars_or_log|remove_with_status|remove_standby_pending/s;
die "standby promotion Phase C+ must expose a read-only detached prepared-trx probe\n"
  unless $trx_preserve =~
         /bool\s+trx_preserve_probe_detached_prepared\s*\(\s*const XID\s*&xid\s*\)/s;
$trx_preserve =~
  /bool\s+trx_preserve_probe_detached_prepared\s*\(\s*const XID\s*&xid\s*\)\s*\{[\s\S]*?^}/m
  or die "could not isolate trx_preserve_probe_detached_prepared\n";
my $promotion_prepared_probe = $&;
die "standby promotion prepared-trx probe must not claim, mark, or reset prepared transactions\n"
  if $promotion_prepared_probe =~
     /preserve_trx_claimed\s*=|trx_preserve_mark_preserved|xid->reset\s*\(/s;
die "standby promotion prepared-trx probe must only report detached prepared preserve XIDs\n"
  unless $promotion_prepared_probe =~ /mysql_thd\s*==\s*nullptr/s &&
         $promotion_prepared_probe =~ /TRX_STATE_PREPARED/s &&
         $promotion_prepared_probe =~ /xid\.eq\s*\(\s*trx->xid\s*\)/s;
die "standby promotion abandoned cleanup must be a separate worker entry, not a gate-side wait\n"
  unless $promotion =~ /preserved_trx_cleanup_abandoned_standby_promotion_epoch/s &&
         $promotion =~ /read_promotion_abandoned_epoch/s &&
         $promotion =~ /trx_preserve_rollback_by_token/s;
die "standby promotion abandoned cleanup must stay out of startup, local recovery, and ordinary SQL dispatch\n"
  if $preserve =~ /preserved_trx_cleanup_abandoned_standby_promotion_epoch/s ||
     $mysqld =~ /preserved_trx_cleanup_abandoned_standby_promotion_epoch/s ||
     $sql_parse =~ /preserved_trx_cleanup_abandoned_standby_promotion_epoch/s;
die "standby promotion must report token-level abandoned outcomes without failing service promotion\n"
  unless $promotion =~ /OK_WITH_ABANDONED_TOKENS/s &&
         $promotion =~ /abandoned_count/s &&
         $promotion =~ /promotion-ready cache not built/s;
die "standby promotion abandoned marker must be an epoch-level side artifact\n"
  unless $promotion =~ /PTRX_PROMOTION_ABANDONED_EPOCH_V1/s &&
         $promotion =~ /write_promotion_abandoned_epoch/s &&
         $carrier_file =~ /promotion_abandoned/s;
die "standby promotion abandoned marker must carry cleanup states for async rollback/audit\n"
  unless $promotion =~ /CLEANUP_PENDING/s &&
         $promotion =~ /CLEANUP_ROLLED_BACK/s &&
         $promotion =~ /CLEANUP_NOT_FOUND/s &&
         $promotion =~ /CLEANUP_TAINTED/s &&
         $promotion =~ /CLAIMED_IMPORT_FAILED/s;
die "standby transfer design doc must not claim production HA promotion is complete in this milestone\n"
  unless $standby_transfer_doc =~
         /当前实现状态[\s\S]*source transport[\s\S]*fail-closed/s ||
         $standby_transfer_doc =~
         /真实物理备机升主[\s\S]*不在/s;
EOF

SELECT 'ok' AS code_review_resumable_trx_slices_lint;

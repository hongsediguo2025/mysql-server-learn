$preserve =~ /bool Sql_cmd_drain_transactions_preserve::execute[\s\S]*?^}/m
  or die "could not isolate DRAIN SQL command execute\n";
my $drain_sql_execute = $&;
die "DRAIN SQL command must delegate to Preserve_trx_drain_service\n"
  unless $drain_sql_execute =~ /Preserve_trx_drain_service\s+service/s &&
         $drain_sql_execute =~ /service\.execute\s*\(/s;
die "DRAIN SQL command must not directly run target enumeration or shutdown\n"
  if $drain_sql_execute =~
     /Global_THD_manager|Preserve_batch_|Warmcopy_batch_|shutdown\s*\(/s;

$preserve =~ /bool preserved_trx_preflight_recoverability[\s\S]*?^}/m
  or die "could not isolate preserved_trx_preflight_recoverability\n";
my $preflight_recovery = $&;
die "recovery preflight must list snapshots through Preserved_trx_store\n"
  unless $preflight_recovery =~ /create_preserved_trx_default_store/s &&
         $preflight_recovery =~ /->list_tokens\s*\(/s &&

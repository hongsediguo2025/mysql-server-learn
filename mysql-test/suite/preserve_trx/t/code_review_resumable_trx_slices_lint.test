die "standby transfer staged-token prewarm must carry receiver registry sealed-object proof\n"
  unless $transfer =~ /enqueue_receiver_staged_token_prewarm\s*\([^)]*Preserve_trx_transfer_receiver_registry\s*\*\s*registry/s &&
         $transfer =~ /job\.registry\s*=\s*registry/s &&
         $transfer =~ /enqueue_receiver_staged_token_prewarm\s*\(\s*root_dir\s*,\s*sealed_manifest\s*,\s*registry\s*\)/s;
die "standby transfer staged-token publish must not re-seal already sealed objects\n"
  unless $transfer =~ /objects_already_sealed/s &&
         $transfer =~ /preserve_trx_transfer_load_standby_bundle_from_staging[\s\S]*objects_already_sealed/s &&
         $transfer =~ /preserve_trx_transfer_publish_standby_bundle[\s\S]*objects_already_sealed/s;
die "standby transfer COMMIT_EPOCH final metadata failures must log the finalize substage\n"
  unless $transfer_commit_epoch_branch =~
         /standby transfer receiver commit epoch finalize failed[\s\S]*transfer_status_name\s*\(\s*status\s*\)/s;
die "standby transfer production source client must resolve credential-name before opening a socket\n"
  unless $transfer =~
         /default_transfer_client_connect[\s\S]*resolve_transfer_credential[\s\S]*mysql_real_connect/s &&
         $gunit =~ /ConfiguredFrameSinkDefaultClientUsesCredentialStore/s;
die "standby transfer production source client must send frames through COM_PRESERVE_TRX_TRANSFER\n"
  unless $transfer =~
         /default_transfer_client_send[\s\S]*simple_command[\s\S]*COM_PRESERVE_TRX_TRANSFER/s;
die "standby transfer source publication must be selected only by artifact mode, not by a duplicate source enable sysvar\n"
  if $sys_vars =~ /preserve_trx_transfer_enable/s ||
     $transfer =~ /preserve_trx_transfer_enable/s ||
     $transfer_header =~ /preserve_trx_transfer_enable/s;
die "batch target preserve failure log must include the failed target thread id\n"
  unless $preserve =~
         /PRESERVE: batch target preserve failed[\s\S]*target_thread_id=/s;
die "standby transfer must log final-target coverage before preserving targets\n"
  unless $preserve =~
         /PRESERVE: standby transfer final target coverage/s &&
         $preserve =~ /missing_declared=/s &&
         $preserve =~ /missing_binlog=/s &&
         $preserve =~ /missing_record=/s;
die "standby final-target coverage must distinguish phase1 presealed binlog blobs from fallback warmcopy blobs\n"
  unless $preserve =~ /phase1_blob_matches_current_thd/s;
die "standby final-target coverage must not treat missing binlog provider as covered\n"
  if $preserve =~ /batch_transfer_binlog_blob_provider\s*==\s*nullptr\s*\|\|/s;
die "standby transfer must not expose reserved/no-op source sender sysvars\n"
  if $sys_vars =~ /preserve_trx_transfer_sender_workers/s ||
     $transfer =~ /preserve_trx_transfer_sender_workers/s ||
     $transfer_header =~ /preserve_trx_transfer_sender_workers/s;
die "standby transfer must not expose ineffective data session sysvars while frames are single-sequence\n"
  if $sys_vars =~ /preserve_trx_transfer_data_sessions/s ||
     $transfer =~ /preserve_trx_transfer_data_sessions/s ||
     $transfer_header =~ /preserve_trx_transfer_data_sessions/s;
die "standby transfer receiver worker sysvar must document the batch receiver worker path\n"
  unless $sys_vars =~
         /preserve_trx_transfer_receiver_workers[\s\S]*batch receiver[\s\S]*classic single-frame dispatch/s;
die "standby transfer receiver batch payload path must use the bounded frame worker helper\n"
  unless $transfer_header =~ /preserve_trx_transfer_handle_receiver_payload_batch/s &&
         $transfer_header =~ /preserve_trx_transfer_apply_receiver_frame_batch_with_workers/s &&
         $transfer =~ /preserve_trx_transfer_handle_receiver_payload_batch[\s\S]*preserve_trx_transfer_decode_frame[\s\S]*preserve_trx_transfer_apply_receiver_frame_batch_with_workers/s;
die "standby promotion simulator must expose transfer control frames for prewarm and gate only through COM_PRESERVE_TRX_TRANSFER\n"
  unless $transfer_header =~ /PROMOTION_PREWARM_TOKEN/s &&
         $transfer_header =~ /PROMOTION_GATE_EPOCH/s &&
         $transfer =~ /PROMOTION_PREWARM_TOKEN[\s\S]*preserved_trx_promotion_prewarm_standby_pending_tokens/s &&
         $transfer =~ /PROMOTION_GATE_EPOCH[\s\S]*preserved_trx_adopt_standby_pending_all_for_promotion/s;
$transfer =~
  /Preserve_trx_transfer_status\s+preserve_trx_transfer_apply_receiver_frame_batch_with_workers\s*\([\s\S]*?^}/m
  or die "could not isolate receiver frame batch worker helper\n";
my $transfer_batch_worker_helper = $&;
die "standby promotion gate frame must be a receiver batch barrier after prewarm worker segments complete\n"
  unless $transfer_batch_worker_helper =~
         /is_batch_barrier[\s\S]*COMMIT_EPOCH[\s\S]*PROMOTION_GATE_EPOCH/s &&
         $transfer_batch_worker_helper =~ /flush_segment\s*\(\s*\)[\s\S]*apply_frame\s*\(\s*frame\s*,\s*context\s*\)/s;
$transfer =~ /Preserve_trx_transfer_status preserve_trx_transfer_seal_staged_object[\s\S]*?^}/m
  or die "could not isolate preserve_trx_transfer_seal_staged_object\n";
my $transfer_seal_staged_object = $&;
die "standby transfer SEAL_OBJECT must verify object digest with streaming IO, not read the full object into memory\n"
  unless $transfer =~ /sha256_digest_file_streaming/s &&
         $transfer_seal_staged_object =~ /sha256_digest_file_streaming/s &&
         $transfer_seal_staged_object !~ /read_whole_file/s;
die "standby promotion Phase C must use transfer manifest protocol version 3\n"
  unless $transfer_header =~
         /kPreserveTrxTransferProtocolVersion\s*=\s*3\s*;/s &&
         $transfer_header =~ /source_prepare_lsn/s &&
         $transfer_header =~ /source_epoch_commit_lsn/s &&
         $transfer =~ /parsed\.protocol_version\s*!=\s*2/s;
die "standby promotion Phase A must expose a single promotion adopt entry point\n"
  unless $promotion =~
         /preserved_trx_adopt_standby_pending_all_for_promotion/s;
die "standby promotion Phase A entry must stay out of local preserve recovery\n"
  if $preserve =~ /preserved_trx_adopt_standby_pending_all_for_promotion/s;
die "standby promotion Phase A entry must stay out of mysqld startup\n"
  if $mysqld =~ /preserved_trx_adopt_standby_pending_all_for_promotion/s;
die "standby promotion Phase A entry must not be exposed through ordinary SQL dispatch\n"
  if $sql_parse =~ /preserved_trx_adopt_standby_pending_all_for_promotion/s;
die "standby promotion Phase A must stay out of local startup recovery\n"
  if $promotion =~ /preserved_trx_recover_all\s*\(|recover_preserved_snapshot\s*\(/s;
die "standby promotion Phase A must not claim or register prepared transactions\n"
  if $promotion =~ /trx_preserve_claim_prepared\s*\(|preserved_trx_add_record\s*\(/s;
die "standby promotion Phase A must not import semantic transaction state\n"
  if $promotion =~

die "RESUME detach cleanup helper must publish observable-only FAILED token before killing session\n"
  unless $resume_detach_failure_helper =~
         /preserved_trx_add_resume_detach_failure_observable_record[\s\S]*THD::KILL_CONNECTION/s;

$preserve =~ /bool preserve_trx_has_unsupported_transaction_contents[\s\S]*?^}/m

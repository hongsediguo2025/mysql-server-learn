SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_commit(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_preserve_commit VALUES(1, 10), (2, 20);
UPDATE tmp_preserve_commit SET v = v + 1 WHERE id = 1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT COUNT(*) AS temp_rows, SUM(v) AS temp_sum FROM tmp_preserve_commit;
temp_rows	temp_sum
2	31
COMMIT;
SELECT * FROM tmp_preserve_commit ORDER BY id;
id	v
1	11
2	20
DROP TEMPORARY TABLE tmp_preserve_commit;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

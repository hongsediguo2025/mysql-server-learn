DROP TABLE IF EXISTS t_warmcopy_post_prepare_failure;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
CREATE TABLE t_warmcopy_post_prepare_failure(
id INT PRIMARY KEY,
v INT,
payload VARBINARY(512)
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_post_prepare_failure VALUES(1,10,'seed');
RESET MASTER;
START TRANSACTION;
UPDATE t_warmcopy_post_prepare_failure
SET v=11, payload=REPEAT('a',512)
WHERE id=1;
SET SESSION debug="+d,preserve_trx_fail_after_undo_prepared";
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_after_undo_prepared";
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT id, v, OCTET_LENGTH(payload) AS payload_len,
payload = REPEAT('a',512) AS payload_matches_expected
FROM t_warmcopy_post_prepare_failure
ORDER BY id;
id	v	payload_len	payload_matches_expected
1	11	512	1
COMMIT;

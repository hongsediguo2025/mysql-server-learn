SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_alter(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_preserve_alter VALUES(1, 10);
SET DEBUG_SYNC =
'preserve_trx_warmcopy_open SIGNAL temp_alter_warmcopy_open WAIT_FOR temp_alter_continue_warmcopy';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR temp_alter_warmcopy_open TIMEOUT 10';
ALTER TABLE tmp_preserve_alter ADD COLUMN c INT DEFAULT 7;
START TRANSACTION;
INSERT INTO tmp_preserve_alter(id, v, c) VALUES(2, 20, 8);
SET DEBUG_SYNC = 'now SIGNAL temp_alter_continue_warmcopy';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT * FROM tmp_preserve_alter ORDER BY id;
id	v	c
1	10	7
2	20	8
COMMIT;
DROP TEMPORARY TABLE tmp_preserve_alter;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET DEBUG_SYNC = 'RESET';

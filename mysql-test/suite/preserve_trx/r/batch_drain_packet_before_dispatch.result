DROP TABLE IF EXISTS t_batch_packet_before_dispatch;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_packet_before_dispatch(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
SET DEBUG_SYNC =
'preserve_trx_after_command_read_before_packet_marker SIGNAL batch_packet_read WAIT_FOR continue_batch_packet';
START TRANSACTION; INSERT INTO t_batch_packet_before_dispatch VALUES(1,10);
SET DEBUG_SYNC = 'now WAIT_FOR batch_packet_read TIMEOUT 10';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now SIGNAL continue_batch_packet';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
UPDATE t_batch_packet_before_dispatch SET v=v+1 WHERE id=1;
COMMIT;
SELECT * FROM t_batch_packet_before_dispatch;
id	v
1	11
DROP TABLE t_batch_packet_before_dispatch;
SET GLOBAL preserve_trx_enable=ON;

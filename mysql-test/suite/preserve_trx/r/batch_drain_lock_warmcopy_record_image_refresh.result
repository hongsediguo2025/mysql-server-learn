DROP TABLE IF EXISTS t_lock_warmcopy_record_image_refresh;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_record_image_refresh(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_record_image_refresh
VALUES(1,10,REPEAT('a',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_record_image_refresh
SET v=11, pad=REPEAT('b',32)
WHERE id=1;
SET DEBUG_SYNC =
'preserve_trx_lock_warmcopy_after_active_record_scan SIGNAL lock_wc_image_scanned WAIT_FOR continue_lock_wc_image_drain';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_image_scanned TIMEOUT 10';
UPDATE t_lock_warmcopy_record_image_refresh
SET v=12, pad=REPEAT('c',32)
WHERE id=1;
SET DEBUG_SYNC = 'now SIGNAL continue_lock_wc_image_drain';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT id, v, pad=REPEAT('c',32) AS pad_ok
FROM t_lock_warmcopy_record_image_refresh;
id	v	pad_ok
1	12	1
DROP TABLE t_lock_warmcopy_record_image_refresh;

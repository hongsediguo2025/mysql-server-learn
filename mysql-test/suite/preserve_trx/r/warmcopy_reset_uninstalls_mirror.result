DROP TABLE IF EXISTS t_warmcopy_reset_mirror;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
CREATE TABLE t_warmcopy_reset_mirror(id INT PRIMARY KEY, v INT)
ENGINE=InnoDB;
INSERT INTO t_warmcopy_reset_mirror VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_warmcopy_reset_mirror SET v=11 WHERE id=1;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_reset_hwm WAIT_FOR warmcopy_reset_continue';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_reset_hwm TIMEOUT 10';
ROLLBACK;
START TRANSACTION;
UPDATE t_warmcopy_reset_mirror SET v=21 WHERE id=2;
SET DEBUG_SYNC = 'now SIGNAL warmcopy_reset_continue';
ERROR HY000: Resumable transactions across shutdown do not support this operation
COMMIT;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT * FROM t_warmcopy_reset_mirror ORDER BY id;
id	v
1	10
2	21
DROP TABLE t_warmcopy_reset_mirror;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET DEBUG_SYNC = 'RESET';

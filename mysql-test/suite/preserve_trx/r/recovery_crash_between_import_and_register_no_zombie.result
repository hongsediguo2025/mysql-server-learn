DROP TABLE IF EXISTS t_recover_import_register_crash;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_recover_import_register_crash(
a INT PRIMARY KEY,
b INT
) ENGINE=InnoDB;
INSERT INTO t_recover_import_register_crash VALUES(1,10),(2,20);
START TRANSACTION;
SELECT * FROM t_recover_import_register_crash WHERE a=1 FOR UPDATE;
a	b
1	10
UPDATE t_recover_import_register_crash SET b=21 WHERE a=2;
DRAIN TRANSACTIONS PRESERVE;

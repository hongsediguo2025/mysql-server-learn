DROP TABLE IF EXISTS t_attach_activate;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_attach_activate(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_attach_activate VALUES (1, 10);
START TRANSACTION;
UPDATE t_attach_activate SET v = 11 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_attach_activate_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_attach_activate_observable';
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-attach-activate-token';
TOKEN	STATE	LAST_ERROR
debug-attach-activate-token	FAILED	attach activate: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 attach_ok=1 activate_ok=1 rollback_ok=1
SELECT LAST_ERROR REGEXP
'attach activate: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 attach_ok=1 activate_ok=1 rollback_ok=1'
       AS attach_activate_ok
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-attach-activate-token';
attach_activate_ok
1
COMMIT;
SELECT * FROM t_attach_activate;
id	v
1	11
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-attach-activate-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
DROP TABLE t_attach_activate;
SET GLOBAL preserve_trx_enable=ON;

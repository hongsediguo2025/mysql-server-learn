DROP TABLE IF EXISTS t_basic_resume;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_basic_resume(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_basic_resume VALUES(1,10);
START TRANSACTION;
UPDATE t_basic_resume SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SELECT * FROM t_basic_resume ORDER BY a;
a	b
1	10
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM t_basic_resume ORDER BY a;
a	b
1	11
UPDATE t_basic_resume SET b=12 WHERE a=1;
COMMIT;
SELECT * FROM t_basic_resume ORDER BY a;
a	b
1	12
DROP TABLE t_basic_resume;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_read_view_pin;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_read_view_pin(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_read_view_pin VALUES(1,10),(2,20);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT * FROM t_read_view_pin WHERE a=1;
a	b
1	10
UPDATE t_read_view_pin SET b=21 WHERE a=2;
SET SESSION debug="+d,preserve_trx_assert_read_view_pinned_after_detach";
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
Pattern "PRESERVE: read view pinned after detach" found
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT * FROM t_read_view_pin ORDER BY a;
a	b
1	10
2	21
DROP TABLE t_read_view_pin;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_savepoint_suffix;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_savepoint_suffix(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_savepoint_suffix VALUES(1, 10), (2, 20);
RESET MASTER;
START TRANSACTION;
SELECT * FROM t_savepoint_suffix WHERE id=1 FOR UPDATE;
id	v
1	10
SAVEPOINT before_binlog_participant;
UPDATE t_savepoint_suffix SET v=21 WHERE id=2;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK TO SAVEPOINT before_binlog_participant;
COMMIT;
SELECT * FROM t_savepoint_suffix ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_savepoint_suffix;

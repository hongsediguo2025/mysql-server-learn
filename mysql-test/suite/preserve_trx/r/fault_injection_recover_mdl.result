DROP TABLE IF EXISTS t_fault_recover_mdl;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_fault_recover_mdl(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_fault_recover_mdl VALUES(1,10);
START TRANSACTION;
UPDATE t_fault_recover_mdl SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
# restart: --rds-preserve-trx-enable=ON --debug=d,preserve_trx_fail_recover_mdl

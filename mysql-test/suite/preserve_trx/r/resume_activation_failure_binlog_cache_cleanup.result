DROP TABLE IF EXISTS t_resume_activation_binlog;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_activation_binlog(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_resume_activation_binlog VALUES(1,10),(2,20);
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GTID_NEXT='SERVER_UUID:7';
START TRANSACTION;
UPDATE t_resume_activation_binlog SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="+d,preserve_trx_fail_activate_resumed";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_activate_resumed";
SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;
remaining_preserved
1
SELECT @@SESSION.GTID_NEXT AS gtid_next_after_failed_resume;
gtid_next_after_failed_resume
AUTOMATIC
SET GTID_NEXT=AUTOMATIC;
SELECT * FROM t_resume_activation_binlog WHERE a=1;
a	b
1	10
START TRANSACTION;
UPDATE t_resume_activation_binlog SET b=12 WHERE a=2;
COMMIT;
SELECT * FROM t_resume_activation_binlog ORDER BY a;
a	b
1	10
2	12
include/assert_grep.inc [New transaction remains in binlog after activation failure cleanup]
include/assert_grep.inc [Rolled back activation failure transaction is discarded from imported binlog cache]
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SET GTID_NEXT=AUTOMATIC;
SET SESSION sql_log_bin=0;
DROP TABLE t_resume_activation_binlog;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

CREATE TABLE reset_direct_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE reset_direct_ledger(
id INT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL
) ENGINE=InnoDB;

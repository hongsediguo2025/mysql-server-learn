DROP TABLE IF EXISTS t_snapshot_header_corrupt_matrix;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_snapshot_header_corrupt_matrix(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_snapshot_header_corrupt_matrix VALUES(1,10);
# corrupt snapshot magic
START TRANSACTION;
UPDATE t_snapshot_header_corrupt_matrix SET v=11 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE;
# restart: --preserve-trx-enable=ON --skip-log-bin
include/wait_for_pattern_in_file.inc [Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted: startup snapshot is unreadable or mismatched]
SELECT COUNT(*) AS preserved_count_after_corrupt_header
FROM performance_schema.preserved_transactions;
preserved_count_after_corrupt_header
0
SELECT * FROM t_snapshot_header_corrupt_matrix ORDER BY id;
id	v
1	10

DROP TABLE IF EXISTS t_preserve_staged_link_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_preserve_staged_link_base(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_staged_link_base VALUES(1, 10);
CREATE TEMPORARY TABLE tmp_preserve_staged_link_a(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_preserve_staged_link_b(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_staged_link_a VALUES(1, 10), (2, 21);
INSERT INTO tmp_preserve_staged_link_b VALUES(11, 110), (12, 122);
START TRANSACTION;
UPDATE t_preserve_staged_link_base SET v = 11 WHERE id = 1;
UPDATE tmp_preserve_staged_link_a SET v = v + 1 WHERE id = 1;
INSERT INTO tmp_preserve_staged_link_a VALUES(3, 30);
DELETE FROM tmp_preserve_staged_link_a WHERE id = 2;
UPDATE tmp_preserve_staged_link_b SET v = v + 1 WHERE id = 11;
INSERT INTO tmp_preserve_staged_link_b VALUES(13, 130);
DELETE FROM tmp_preserve_staged_link_b WHERE id = 12;
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="+d,preserve_temp_fail_after_first_staged_link";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_temp_fail_after_first_staged_link";
SELECT COUNT(*) AS preserved_count_after_failed_link
FROM performance_schema.preserved_transactions;
preserved_count_after_failed_link
1
SELECT LAST_ERROR IS NOT NULL AS failed_link_has_error
FROM performance_schema.preserved_transactions;
failed_link_has_error
1
SELECT COUNT(*) AS active_innodb_trx_after_failed_link
FROM information_schema.innodb_trx
WHERE trx_mysql_thread_id = CONNECTION_ID();
active_innodb_trx_after_failed_link
0
SELECT COUNT(*) FROM tmp_preserve_staged_link_a;
ERROR 42S02: Table 'test.tmp_preserve_staged_link_a' doesn't exist
SELECT COUNT(*) FROM tmp_preserve_staged_link_b;
ERROR 42S02: Table 'test.tmp_preserve_staged_link_b' doesn't exist
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT COUNT(*) AS preserved_count_after_retry_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_retry_resume
0
SELECT COUNT(*) AS staged_link_a_rows, SUM(v) AS staged_link_a_sum
FROM tmp_preserve_staged_link_a;
staged_link_a_rows	staged_link_a_sum
2	41
SELECT COUNT(*) AS staged_link_b_rows, SUM(v) AS staged_link_b_sum
FROM tmp_preserve_staged_link_b;
staged_link_b_rows	staged_link_b_sum
2	241
INSERT INTO tmp_preserve_staged_link_a VALUES(4, 40);
INSERT INTO tmp_preserve_staged_link_b VALUES(14, 140);
COMMIT;
SELECT * FROM t_preserve_staged_link_base ORDER BY id;
id	v
1	11
SELECT COUNT(*) AS a_rows_after_commit, SUM(v) AS a_sum_after_commit
FROM tmp_preserve_staged_link_a;
a_rows_after_commit	a_sum_after_commit
3	81
SELECT COUNT(*) AS b_rows_after_commit, SUM(v) AS b_sum_after_commit
FROM tmp_preserve_staged_link_b;
b_rows_after_commit	b_sum_after_commit
3	381
DROP TEMPORARY TABLE tmp_preserve_staged_link_a;
DROP TEMPORARY TABLE tmp_preserve_staged_link_b;
DROP TABLE t_preserve_staged_link_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

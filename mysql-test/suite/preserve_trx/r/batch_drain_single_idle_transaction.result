DROP TABLE IF EXISTS t_batch_single;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_single(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_batch_single VALUES(1, 10);
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE, GLOBAL_LOG_BIN
FROM performance_schema.preserved_transactions;
TOKEN	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE	GLOBAL_LOG_BIN
TOKEN	GLOBAL_OFF_NO_CACHE	NO	0	OFF
RESUME PRESERVED TRANSACTION 'TOKEN';
UPDATE t_batch_single SET v = v + 1 WHERE id = 1;
COMMIT;
SELECT * FROM t_batch_single;
id	v
1	11
DROP TABLE t_batch_single;
SET GLOBAL preserve_trx_enable=ON;

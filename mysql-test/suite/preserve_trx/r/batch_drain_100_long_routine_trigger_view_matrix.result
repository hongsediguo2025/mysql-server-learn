SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_recovery_max_count=200;
SELECT COUNT(*) AS session_count
FROM t_batch_long_control;
session_count
100
SELECT MIN(TIMESTAMPDIFF(MICROSECOND, started_at, NOW(6))) >= 5000000
AS all_sessions_older_than_five_seconds
FROM t_batch_long_control;
all_sessions_older_than_five_seconds
1
DRAIN TRANSACTIONS PRESERVE WITH USER VARS;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
100
SELECT COUNT(*) AS preserved_state_count
FROM performance_schema.preserved_transactions
WHERE STATE = 'PRESERVED';
preserved_state_count
100
SELECT COUNT(*) AS mapped_token_count
FROM t_batch_long_tokens;
mapped_token_count
100
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT COUNT(*) AS resume_success_count
FROM t_batch_long_audit
WHERE resumed_ok = 1;
resume_success_count
100
SELECT COUNT(DISTINCT sid) AS resumed_distinct_sessions
FROM t_batch_long_audit;
resumed_distinct_sessions
100
SELECT MIN(lifecycle_age_us) >= 5000000 AS all_resumed_lifecycles_were_long
FROM t_batch_long_audit;
all_resumed_lifecycles_were_long
1
SELECT MIN(sql_count) >= 8 AS every_session_ran_enough_sql
FROM t_batch_long_audit;
every_session_ran_enough_sql
1
SELECT MAX(max_stmt_us) < 1000000 AS every_statement_under_one_second
FROM t_batch_long_audit;
every_statement_under_one_second
1
SELECT COUNT(*) AS audit_rows
FROM t_batch_long_audit;
audit_rows
100
SELECT COUNT(*) AS audit_control_case_mismatch_count
FROM t_batch_long_audit a
JOIN t_batch_long_control c USING(sid)
WHERE a.case_id <> c.case_id;
audit_control_case_mismatch_count
0
SELECT COUNT(DISTINCT detail) AS routine_cases_ok
FROM t_batch_long_audit WHERE resumed_ok = 1;
routine_cases_ok
20
SELECT detail, COUNT(*) = 5 AS ok
FROM t_batch_long_audit GROUP BY detail ORDER BY detail;
detail	ok
after-trigger	1
before-trigger	1
function-expression	1
function-string-expression	1
mixed-routine-view-trigger	1
multiple-procedure-calls	1
prepared-deallocate	1
prepared-execute	1
prepared-params	1
procedure-insert	1
procedure-savepoint-light	1
procedure-update	1
resume-procedure-call	1
resume-trigger-fire	1
resume-view-update	1
trigger-unique	1
view-insert	1
view-predicate	1
view-read-base-write	1
view-update	1
SELECT COUNT(*) = 70 AS trigger_audit_cases_ok
FROM t_rtv_trigger_audit;
trigger_audit_cases_ok
1
SELECT COUNT(*) = 30 AS mixed_trigger_audit_cases_ok
FROM t_rtv_trigger_audit a JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 20
AND a.action_name LIKE '%mixed%';
mixed_trigger_audit_cases_ok
1
SELECT COUNT(*) = 30 AS view_cases_ok
FROM t_batch_long_audit
WHERE detail IN ('view-insert',
'view-update',
'view-read-base-write',
'view-predicate',
'resume-view-update',
'mixed-routine-view-trigger');
view_cases_ok
1
SELECT COUNT(*) = 1 AS procedure_exists
FROM information_schema.routines
WHERE routine_schema = DATABASE()
AND routine_name = 'p_rtv_insert_update'
   AND routine_type = 'PROCEDURE';
procedure_exists
1
SELECT COUNT(*) = 1 AS function_exists
FROM information_schema.routines
WHERE routine_schema = DATABASE()
AND routine_name = 'f_rtv_delta'
   AND routine_type = 'FUNCTION';
function_exists
1
SELECT COUNT(*) = 1 AS view_exists
FROM information_schema.views
WHERE table_schema = DATABASE()
AND table_name = 'v_rtv_base';
view_exists
1
SELECT COUNT(*) = 2 AS triggers_exist
FROM information_schema.triggers
WHERE trigger_schema = DATABASE()
AND trigger_name IN ('t_rtv_bi', 't_rtv_au');
triggers_exist
1
SELECT 1 AS case_id,
COUNT(*) = 5 AS ok
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 1 AND b.k = 101 AND b.note = 'proc-insert-post'
UNION ALL SELECT 2, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 2 AND b.k = 2 AND b.note = 'proc-update-post'
UNION ALL SELECT 3, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 3 AND b.k = 3 AND b.note = 'function-post'
UNION ALL SELECT 4, COUNT(*) = 10
FROM t_rtv_trigger_audit a JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 4 AND a.action_name LIKE 'bi-trigger-bi%'
UNION ALL SELECT 5, COUNT(*) = 10
FROM t_rtv_trigger_audit a JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 5 AND a.action_name LIKE 'au-trigger-au%'
UNION ALL SELECT 6, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 6 AND b.k = 106 AND b.note = 'view-insert-post'
UNION ALL SELECT 7, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 7 AND b.k = 7 AND b.note = 'view-update-post'
UNION ALL SELECT 8, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 8 AND b.k = 8 AND b.note = 'view-read-post'
UNION ALL SELECT 9, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 9 AND b.k = 9 AND b.note = 'prepared-post'
UNION ALL SELECT 10, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 10 AND b.k = 110 AND b.note = 'deallocate-post'
UNION ALL SELECT 11, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 11 AND b.k = 11 AND b.note = 'multi-proc-post'
UNION ALL SELECT 12, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 12 AND b.k = 12 AND b.note = 'proc-save-post'
UNION ALL SELECT 13, COUNT(*) = 10
FROM t_rtv_trigger_audit a JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 13
AND a.k = 13
AND a.action_name LIKE 'au-trigger-au-unique%'
UNION ALL SELECT 14, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 14 AND b.k = 14
AND b.note = CONCAT('string-', b.sid + 28, '-post')
UNION ALL SELECT 15, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 15 AND b.k = 15 AND b.note = 'view-predicate-post'
UNION ALL SELECT 16, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 16 AND b.k = 16 AND b.note = 'prepared-param-post'
UNION ALL SELECT 17, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 17 AND b.k = 17 AND b.note = 'resume-procedure-post'
UNION ALL SELECT 18, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 18 AND b.k = 18 AND b.note = 'resume-view-post'
UNION ALL SELECT 19, COUNT(*) = 5
FROM t_rtv_trigger_audit a JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 19
AND a.k = 19
AND a.action_name = 'au-resume-trigger-post'
UNION ALL SELECT 20, COUNT(*) = 5
FROM t_rtv_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 20 AND b.k = 120 AND b.note = 'mixed-post'
ORDER BY case_id;
case_id	ok

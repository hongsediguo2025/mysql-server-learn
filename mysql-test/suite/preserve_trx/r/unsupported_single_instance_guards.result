DROP PROCEDURE IF EXISTS preserve_proc;
DROP FUNCTION IF EXISTS preserve_func;
DROP TRIGGER IF EXISTS preserve_trigger_bi;
DROP TABLE IF EXISTS t_innodb;
DROP TABLE IF EXISTS t_myisam;
DROP TABLE IF EXISTS t_trigger;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_innodb(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t_myisam(a INT PRIMARY KEY, b INT) ENGINE=MyISAM;
CREATE TABLE t_trigger(a INT PRIMARY KEY) ENGINE=InnoDB;
XA START 'msp_xa_active';
INSERT INTO t_innodb VALUES(1,1);
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
XA END 'msp_xa_active';
XA ROLLBACK 'msp_xa_active';
XA START 'msp_xa_prepared';
INSERT INTO t_innodb VALUES(2,2);
XA END 'msp_xa_prepared';
XA PREPARE 'msp_xa_prepared';
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
XA ROLLBACK 'msp_xa_prepared';
XA START 'msp_xa_detached_other';
INSERT INTO t_innodb VALUES(3,3);
XA END 'msp_xa_detached_other';
XA PREPARE 'msp_xa_detached_other';
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
XA ROLLBACK 'msp_xa_detached_other';
START TRANSACTION;
INSERT INTO t_myisam VALUES(1,1);
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Invalid preserved transaction state
ROLLBACK;
Warnings:
Warning	1196	Some non-transactional changed tables couldn't be rolled back
DELETE FROM t_myisam WHERE a=1;
LOCK TABLES t_innodb WRITE;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
UNLOCK TABLES;
START TRANSACTION;
SELECT GET_LOCK('preserve_trx_user_lock', 0);
GET_LOCK('preserve_trx_user_lock', 0)
1
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT RELEASE_LOCK('preserve_trx_user_lock');
RELEASE_LOCK('preserve_trx_user_lock')
1
ROLLBACK;
HANDLER t_innodb OPEN;
START TRANSACTION;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
HANDLER t_innodb CLOSE;
CREATE PROCEDURE preserve_proc()
BEGIN
START TRANSACTION;
INSERT INTO t_innodb VALUES(10,10);
DRAIN TRANSACTIONS PRESERVE;
END|
CALL preserve_proc();
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
CREATE TRIGGER preserve_trigger_bi BEFORE INSERT ON t_trigger
FOR EACH ROW
BEGIN
DRAIN TRANSACTIONS PRESERVE;
END|
INSERT INTO t_trigger VALUES(1);
ERROR HY000: Resumable transactions across shutdown do not support this operation
CREATE FUNCTION preserve_func() RETURNS INT
BEGIN
DRAIN TRANSACTIONS PRESERVE;
RETURN 1;
END|
SELECT preserve_func();
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET @preserve_stmt='DRAIN TRANSACTIONS PRESERVE';
PREPARE preserve_ps FROM @preserve_stmt;
ERROR HY000: This command is not supported in the prepared statement protocol yet
DROP FUNCTION preserve_func;
DROP TRIGGER preserve_trigger_bi;
DROP PROCEDURE preserve_proc;
DROP TABLE t_trigger;
DROP TABLE t_myisam;
DROP TABLE t_innodb;
SET GLOBAL preserve_trx_enable=ON;

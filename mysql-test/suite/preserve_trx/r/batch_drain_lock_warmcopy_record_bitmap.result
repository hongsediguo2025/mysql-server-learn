DROP TABLE IF EXISTS t_lock_warmcopy_record_bitmap;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_record_bitmap(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_record_bitmap VALUES
(1,10,REPEAT('a',32)),
(2,20,REPEAT('b',32)),
(3,30,REPEAT('c',32)),
(4,40,REPEAT('d',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_record_bitmap
SET v=v+100, pad=REPEAT('x',32)
WHERE id IN (2,3);
DRAIN TRANSACTIONS PRESERVE;
include/assert_grep.inc [lock warmcopy succeeds for multi-record bitmap]
SELECT COUNT(*) AS preserved_count_after_record_bitmap_warmcopy
FROM performance_schema.preserved_transactions;
preserved_count_after_record_bitmap_warmcopy
1
SET innodb_lock_wait_timeout=1;
UPDATE t_lock_warmcopy_record_bitmap SET v=201 WHERE id=2;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
UPDATE t_lock_warmcopy_record_bitmap SET v=301 WHERE id=3;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
UPDATE t_lock_warmcopy_record_bitmap SET v=41 WHERE id=4;
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_record_bitmap_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_record_bitmap_resume
0
SELECT id, v, pad = REPEAT('x',32) AS pad_x
FROM t_lock_warmcopy_record_bitmap
ORDER BY id;
id	v	pad_x
1	10	0
2	120	1
3	130	1
4	41	0
DROP TABLE t_lock_warmcopy_record_bitmap;

UPDATE t_lock_warmcopy_final_recheck SET v=21 WHERE id=2;
COMMIT;
SELECT id, v FROM t_lock_warmcopy_final_recheck ORDER BY id;
id	v
1	11
2	21
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
SELECT @@GLOBAL.preserve_trx_lock_warmcopy_fallback_to_live_export
AS final_recheck_fallback_enabled;
final_recheck_fallback_enabled
1
START TRANSACTION;
UPDATE t_lock_warmcopy_final_recheck SET v=31 WHERE id=1;
SET SESSION debug="+d,preserve_trx_lock_warmcopy_simulate_conversion_after_freeze";
SET SESSION debug="+d,preserve_trx_lock_warmcopy_simulate_conversion_after_freeze";
DRAIN TRANSACTIONS PRESERVE;
include/assert_grep.inc [lock warmcopy final fence fallback is logged]
SELECT COUNT(*) AS preserved_count_after_final_recheck_fallback

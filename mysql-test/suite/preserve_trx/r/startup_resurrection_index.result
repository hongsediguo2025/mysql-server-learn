CALL mtr.add_suppression("Preserved transaction '.*' recovery forced rollback: preserved transaction snapshot tainted: ACTIVE Undo exact reservation failed");
DROP TABLE IF EXISTS t_startup_resurrection_index;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_startup_resurrection_index(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_startup_resurrection_index VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_startup_resurrection_index SET v=11 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE;
SELECT
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_candidates')=1
AS index_candidates,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_hits')=1
AS index_hits,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_fallbacks')=0
AS no_fallback,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_anchor_checks')>=1
AS anchors_checked,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_pages')=0
AS no_undo_body_pages,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_records')=0
AS no_undo_body_records;
index_candidates	index_hits	no_fallback	anchors_checked	no_undo_body_pages	no_undo_body_records
1	1	1	1	1	1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
START TRANSACTION;
UPDATE t_startup_resurrection_index SET v=21 WHERE id=2;
DRAIN TRANSACTIONS PRESERVE;
SELECT
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_candidates')=1
AS index_candidates,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_hits')=0
AS no_index_hit,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_index_fallbacks')=1
AS one_fallback,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_pages')>0
AS fallback_read_undo_pages,
(SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_startup_resurrection_undo_body_records')>0
AS fallback_read_undo_records;
index_candidates	no_index_hit	one_fallback	fallback_read_undo_pages	fallback_read_undo_records
1	1	1	1	1
SELECT COUNT(*) AS preserved_after_anchor_fallback
FROM performance_schema.preserved_transactions;
preserved_after_anchor_fallback
0
SELECT v AS rolled_back_value
FROM t_startup_resurrection_index WHERE id=2;
rolled_back_value
20
SELECT * FROM t_startup_resurrection_index ORDER BY id;
id	v
1	11
2	20
DROP TABLE t_startup_resurrection_index;

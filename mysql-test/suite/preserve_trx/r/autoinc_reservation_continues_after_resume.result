DROP TABLE IF EXISTS t_autoinc_reservation_resume;
DROP TABLE IF EXISTS t_autoinc_reservation_touch;
DROP TABLE IF EXISTS t_autoinc_forced_resume;
DROP TABLE IF EXISTS t_autoinc_forced_touch;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_autoinc_reservation_touch(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
CREATE TABLE t_autoinc_reservation_resume(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_autoinc_reservation_touch VALUES(1,1);
START TRANSACTION;
UPDATE t_autoinc_reservation_touch SET v = 2 WHERE id = 1;
SAVEPOINT before_autoinc_allocation;
INSERT INTO t_autoinc_reservation_resume(v) VALUES(10),(20);
SELECT LAST_INSERT_ID() AS first_reserved_id;
first_reserved_id
1
ROLLBACK TO SAVEPOINT before_autoinc_allocation;
SELECT COUNT(*) AS rows_after_rollback_to_savepoint
FROM t_autoinc_reservation_resume;
rows_after_rollback_to_savepoint
0
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
INSERT INTO t_autoinc_reservation_resume(v) VALUES(30);
SELECT LAST_INSERT_ID() AS id_after_resume;
id_after_resume
3
COMMIT;
SELECT * FROM t_autoinc_reservation_resume ORDER BY id;
id	v
3	30
SELECT * FROM t_autoinc_reservation_touch ORDER BY id;
id	v
1	2
DROP TABLE t_autoinc_reservation_resume;
DROP TABLE t_autoinc_reservation_touch;
CREATE TABLE t_autoinc_forced_resume(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
CREATE TABLE t_autoinc_forced_touch(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_autoinc_forced_touch VALUES(1,1);
START TRANSACTION;
UPDATE t_autoinc_forced_touch SET v = 2 WHERE id = 1;
SET INSERT_ID=100;
SELECT @@session.insert_id AS forced_insert_id_before_preserve;
forced_insert_id_before_preserve
100
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT @@session.insert_id AS forced_insert_id_after_resume;
forced_insert_id_after_resume
100
INSERT INTO t_autoinc_forced_resume(v) VALUES(40);
SELECT LAST_INSERT_ID() AS forced_insert_id_used_after_resume;
forced_insert_id_used_after_resume
100
COMMIT;
SELECT * FROM t_autoinc_forced_resume ORDER BY id;
id	v
100	40
SELECT * FROM t_autoinc_forced_touch ORDER BY id;
id	v
1	2
DROP TABLE t_autoinc_forced_resume;
DROP TABLE t_autoinc_forced_touch;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_record_lock_import_fast_path;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_record_lock_import_fast_path(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_record_lock_import_fast_path
VALUES(1,10,REPEAT('a',32));
START TRANSACTION;
UPDATE t_record_lock_import_fast_path
SET v=11, pad=REPEAT('b',32)
WHERE id=1;
SET DEBUG_SYNC =
'preserve_trx_after_begin_before_command_read SIGNAL record_fast_idle WAIT_FOR record_fast_continue';
SET DEBUG_SYNC = 'now WAIT_FOR record_fast_idle TIMEOUT 10';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now SIGNAL record_fast_continue';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT id, v, pad = REPEAT('b',32) AS pad_ok
FROM t_record_lock_import_fast_path
ORDER BY id;
id	v	pad_ok
1	11	1
DROP TABLE t_record_lock_import_fast_path;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

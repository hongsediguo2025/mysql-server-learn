DROP TABLE IF EXISTS t_timeout_bounds;
SET GLOBAL preserve_trx_enable=ON;
SET @saved_preserve_trx_min_timeout=@@SESSION.preserve_trx_min_timeout;
SET @saved_preserve_trx_default_timeout=@@SESSION.preserve_trx_default_timeout;
SET @saved_preserve_trx_max_timeout=@@SESSION.preserve_trx_max_timeout;
SET @saved_global_preserve_trx_min_timeout=@@GLOBAL.preserve_trx_min_timeout;
SET @saved_global_preserve_trx_default_timeout=@@GLOBAL.preserve_trx_default_timeout;
SET @saved_global_preserve_trx_max_timeout=@@GLOBAL.preserve_trx_max_timeout;
SET SESSION preserve_trx_min_timeout=10;
SET SESSION preserve_trx_default_timeout=15;
SET SESSION preserve_trx_max_timeout=20;
SELECT @@session.preserve_trx_min_timeout AS min_timeout,
@@session.preserve_trx_default_timeout AS default_timeout,
@@session.preserve_trx_max_timeout AS max_timeout;
min_timeout	default_timeout	max_timeout
10	15	20
SET GLOBAL preserve_trx_min_timeout=11;
SET GLOBAL preserve_trx_default_timeout=12;
SET GLOBAL preserve_trx_max_timeout=13;
SELECT @@session.preserve_trx_min_timeout AS inherited_min_timeout,
@@session.preserve_trx_default_timeout AS inherited_default_timeout,
@@session.preserve_trx_max_timeout AS inherited_max_timeout;
inherited_min_timeout	inherited_default_timeout	inherited_max_timeout
11	12	13
CREATE TABLE t_timeout_bounds(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Invalid preserved transaction state
START TRANSACTION;
INSERT INTO t_timeout_bounds VALUES(1,1);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 9;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 9;
ERROR HY000: Resumable transactions across shutdown do not support this operation
START TRANSACTION;
INSERT INTO t_timeout_bounds VALUES(2,2);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 21;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 21;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION preserve_trx_default_timeout=25;
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Invalid preserved transaction state
START TRANSACTION;
INSERT INTO t_timeout_bounds VALUES(3,3);
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION preserve_trx_default_timeout=15;
SET SESSION preserve_trx_min_timeout=30;
SET SESSION preserve_trx_max_timeout=20;
START TRANSACTION;
INSERT INTO t_timeout_bounds VALUES(4,4);
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
DROP TABLE t_timeout_bounds;
SET SESSION preserve_trx_min_timeout=@saved_preserve_trx_min_timeout;
SET SESSION preserve_trx_default_timeout=@saved_preserve_trx_default_timeout;
SET SESSION preserve_trx_max_timeout=@saved_preserve_trx_max_timeout;
SET GLOBAL preserve_trx_min_timeout=@saved_global_preserve_trx_min_timeout;
SET GLOBAL preserve_trx_default_timeout=@saved_global_preserve_trx_default_timeout;
SET GLOBAL preserve_trx_max_timeout=@saved_global_preserve_trx_max_timeout;
SET GLOBAL preserve_trx_enable=ON;

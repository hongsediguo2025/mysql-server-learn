DROP TABLE IF EXISTS t_batch_multiple;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_batch_multiple(
a INT PRIMARY KEY,
b INT,
resumed_by INT DEFAULT NULL
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_batch_multiple VALUES(1,10,NULL);
START TRANSACTION;
INSERT INTO t_batch_multiple VALUES(2,20,NULL);
DRAIN TRANSACTIONS PRESERVE;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
2
CREATE TEMPORARY TABLE t_batch_multiple_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS token_count
FROM t_batch_multiple_tokens;
token_count
2
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT COUNT(*) AS row_count,
COUNT(DISTINCT a) AS distinct_keys,
SUM(resumed_by IS NOT NULL) AS resumed_rows,
SUM(b >= 100) AS bumped_rows
FROM t_batch_multiple;
row_count	distinct_keys	resumed_rows	bumped_rows
2	2	2	2
DROP TABLE t_batch_multiple;
SET GLOBAL rds_preserve_trx_enable=ON;

DROP USER IF EXISTS phase1_readiness_app@localhost;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_warmcopy_close_timeout_ms=5000;
SET GLOBAL preserve_trx_drain_closing_command_timeout_ms=200;
SET GLOBAL preserve_trx_transfer_phase1_timeout_ms=5000;
CREATE USER phase1_readiness_app@localhost;
GRANT SELECT ON test.* TO phase1_readiness_app@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO phase1_readiness_app@localhost;
SET DEBUG_SYNC=
'before_execute_sql_command SIGNAL phase1_old_running WAIT_FOR phase1_old_continue';
SELECT 1 AS old_command;
SET DEBUG_SYNC='now WAIT_FOR phase1_old_running TIMEOUT 10';
SET SESSION debug='+d,preserve_trx_drain_skip_shutdown_after_audit_no_targets';
SET DEBUG_SYNC=
'preserve_trx_phase1_readiness_before_wait SIGNAL phase1_readiness_tail WAIT_FOR phase1_readiness_continue';
SET DEBUG_SYNC=
'preserve_trx_phase1_readiness_after_sample SIGNAL phase1_readiness_sampled WAIT_FOR phase1_readiness_sample_continue';
SET DEBUG_SYNC=
'preserve_trx_phase1_readiness_before_poll_sleep SIGNAL phase1_readiness_waiting WAIT_FOR phase1_readiness_poll_continue';
SET DEBUG_SYNC=
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL phase1_closing_entered';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC='now WAIT_FOR phase1_readiness_tail TIMEOUT 10';
SET DEBUG_SYNC=
'before_execute_sql_command SIGNAL phase1_fresh_running WAIT_FOR phase1_fresh_continue';
SELECT 2 AS fresh_command;
SET DEBUG_SYNC='now WAIT_FOR phase1_fresh_running TIMEOUT 10';
SET DEBUG_SYNC='now SIGNAL phase1_readiness_continue';
SET DEBUG_SYNC='now WAIT_FOR phase1_readiness_sampled TIMEOUT 10';
SET DEBUG_SYNC='now SIGNAL phase1_fresh_continue';
fresh_command
2
SET DEBUG_SYNC='now SIGNAL phase1_readiness_sample_continue';
SET DEBUG_SYNC='now WAIT_FOR phase1_readiness_waiting TIMEOUT 10';
SET DEBUG_SYNC='now SIGNAL phase1_old_continue';
old_command
1
SET DEBUG_SYNC='now SIGNAL phase1_readiness_poll_continue';
SET DEBUG_SYNC='now WAIT_FOR phase1_closing_entered TIMEOUT 10';
SET SESSION debug='';
SELECT VARIABLE_VALUE >= 1 AS readiness_sampled
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_samples';
readiness_sampled
1
SELECT VARIABLE_VALUE >= 2 AS inflight_sampled
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_inflight_commands';
inflight_sampled
1
SELECT VARIABLE_VALUE >= 200000 AS old_command_age_seen
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_oldest_command_age_us';
old_command_age_seen
1
SELECT VARIABLE_VALUE=1 AS one_frozen_offender
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_offender_count';
one_frozen_offender
1
SELECT VARIABLE_VALUE > 0 AS readiness_waited
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_wait_us';
readiness_waited
1
SET GLOBAL preserve_trx_transfer_phase1_timeout_ms=50;
SET GLOBAL preserve_trx_drain_closing_command_timeout_ms=5000;
SET DEBUG_SYNC=
'before_execute_sql_command SIGNAL phase1_deadline_old_running WAIT_FOR phase1_deadline_old_continue';
SELECT 3 AS deadline_command;
SET DEBUG_SYNC='now WAIT_FOR phase1_deadline_old_running TIMEOUT 10';
SET SESSION debug='+d,preserve_trx_drain_skip_shutdown_after_audit_no_targets';
SET DEBUG_SYNC=
'preserve_trx_phase1_readiness_before_wait SIGNAL phase1_deadline_tail WAIT_FOR phase1_deadline_continue';
SET DEBUG_SYNC=
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL phase1_deadline_closing WAIT_FOR phase1_deadline_closing_continue';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC='now WAIT_FOR phase1_deadline_tail TIMEOUT 10';
SET DEBUG_SYNC='now SIGNAL phase1_deadline_continue';
SET DEBUG_SYNC='now WAIT_FOR phase1_deadline_closing TIMEOUT 10';
SELECT VARIABLE_VALUE=0 AS expired_readiness_did_not_scan
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_samples';
expired_readiness_did_not_scan
1
SELECT VARIABLE_VALUE=0 AS expired_readiness_did_not_wait
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_phase1_readiness_wait_us';
expired_readiness_did_not_wait
1
SET DEBUG_SYNC='now SIGNAL phase1_deadline_old_continue';
deadline_command
3
SET DEBUG_SYNC='now SIGNAL phase1_deadline_closing_continue';
SET SESSION debug='';
DROP USER phase1_readiness_app@localhost;
SET GLOBAL preserve_trx_transfer_phase1_timeout_ms=600000;
SET GLOBAL preserve_trx_drain_closing_command_timeout_ms=1000;
SET GLOBAL preserve_trx_warmcopy_close_timeout_ms=30000;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET DEBUG_SYNC='RESET';

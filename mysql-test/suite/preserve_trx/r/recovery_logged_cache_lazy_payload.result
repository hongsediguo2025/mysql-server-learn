DROP TABLE IF EXISTS t_recovery_logged_cache_lazy_payload;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_recovery_logged_cache_lazy_payload(
id INT PRIMARY KEY,
payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO t_recovery_logged_cache_lazy_payload VALUES(1,'a'),(2,'b');
RESET MASTER;
START TRANSACTION;
UPDATE t_recovery_logged_cache_lazy_payload
SET payload=REPEAT('x', 80)
WHERE id=1;
UPDATE t_recovery_logged_cache_lazy_payload
SET payload=REPEAT('y', 80)
WHERE id=2;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT TOKEN, RECOVERED_COUNT,
BINLOG_STATE, WROTE_TO_CACHE,
BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
FROM performance_schema.preserved_transactions;
TOKEN	RECOVERED_COUNT	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE_POSITIVE
TOKEN	1	LOGGED_WITH_CACHE	YES	1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT id, LENGTH(payload) AS payload_length,
SUBSTR(payload, 1, 1) AS payload_prefix
FROM t_recovery_logged_cache_lazy_payload
ORDER BY id;
id	payload_length	payload_prefix
1	80	x
2	80	y
include/assert_grep.inc [Recovered logged-cache transaction writes row events on final COMMIT]
DROP TABLE t_recovery_logged_cache_lazy_payload;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_resume_consume_cleanup;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_consume_cleanup(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_resume_consume_cleanup VALUES(1, 10);
START TRANSACTION;
UPDATE t_resume_consume_cleanup SET v=11 WHERE id=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_write_tainted_marker";
RESUME PRESERVED TRANSACTION 'TOKEN';
SET SESSION debug="-d,preserve_trx_fail_delete_snapshot_files,preserve_trx_fail_write_tainted_marker";
SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;
remaining_preserved
0
COMMIT;
# restart: --preserve-trx-enable=ON --skip-log-bin
SELECT COUNT(*) AS preserved_count_after_restart
FROM performance_schema.preserved_transactions;
preserved_count_after_restart
0
SELECT * FROM t_resume_consume_cleanup ORDER BY id;
id	v
1	11
DROP TABLE t_resume_consume_cleanup;
SET GLOBAL preserve_trx_enable=ON;

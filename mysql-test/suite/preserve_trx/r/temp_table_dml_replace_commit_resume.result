SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_replace_insert(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;
CREATE TABLE t_preserve_replace_insert(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_replace_insert VALUES(1, 10);
START TRANSACTION;
UPDATE tmp_preserve_replace_insert SET v = 11 WHERE id = 1;
REPLACE INTO tmp_preserve_replace_insert VALUES(1, 12);
REPLACE INTO t_preserve_replace_insert VALUES(1, 100);
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
REPLACE INTO t_preserve_replace_insert VALUES(2, 200);
COMMIT;
SELECT * FROM tmp_preserve_replace_insert ORDER BY id;
id	v
1	12
SELECT * FROM t_preserve_replace_insert ORDER BY id;
id	v
1	100
2	200
DROP TABLE t_preserve_replace_insert;
DROP TEMPORARY TABLE tmp_preserve_replace_insert;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

DROP TABLE IF EXISTS t_read_view_rr;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_read_view_rr(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_read_view_rr VALUES(1,10),(2,200),(3,300);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT * FROM t_read_view_rr WHERE a=1;
a	b
1	10
UPDATE t_read_view_rr SET b=20 WHERE a=1;
UPDATE t_read_view_rr SET b=330 WHERE a=3;
UPDATE t_read_view_rr SET b=201 WHERE a=2;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM t_read_view_rr WHERE a=1;
a	b
1	10
SELECT * FROM t_read_view_rr WHERE a=2;
a	b
2	201
SELECT * FROM t_read_view_rr WHERE a=3;
a	b
3	300
SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;
remaining_preserved
0
COMMIT;
SELECT * FROM t_read_view_rr ORDER BY a;
a	b
1	20
2	201
3	330
DROP TABLE t_read_view_rr;
SET GLOBAL preserve_trx_enable=ON;

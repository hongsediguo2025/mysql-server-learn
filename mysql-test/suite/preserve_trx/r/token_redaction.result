DROP TABLE IF EXISTS t_preserve_token_redaction;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL log_output='TABLE';
SET GLOBAL general_log=OFF;
SET GLOBAL slow_query_log=OFF;
TRUNCATE TABLE mysql.general_log;
TRUNCATE TABLE mysql.slow_log;
SET GLOBAL general_log=ON;
SET GLOBAL slow_query_log=ON;
SET GLOBAL long_query_time=0;
SET GLOBAL log_slow_admin_statements=ON;
CREATE TABLE t_preserve_token_redaction(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preserve_token_redaction VALUES(1,10);
START TRANSACTION;
UPDATE t_preserve_token_redaction SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET @preserved_token='TOKEN';
SET @redacted_preserved_token=CONCAT('****', RIGHT(@preserved_token, 4));
SET GLOBAL log_output='TABLE';
SET GLOBAL general_log=ON;
SET GLOBAL log_raw=ON;
SET GLOBAL slow_query_log=ON;
SET GLOBAL long_query_time=0;
SET SESSION long_query_time=0;
SET GLOBAL log_slow_admin_statements=ON;
TRUNCATE TABLE mysql.general_log;
TRUNCATE TABLE mysql.slow_log;
SET DEBUG_SYNC =
'preserve_trx_resume_start SIGNAL resume_started WAIT_FOR resume_continue';
RESUME PRESERVED TRANSACTION 'TOKEN';
SET DEBUG_SYNC = 'now WAIT_FOR resume_started TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL resume_continue';
SET DEBUG_SYNC = 'RESET';
COMMIT;
SELECT COUNT(*) AS raw_token_in_general_log
FROM mysql.general_log
WHERE argument LIKE CONCAT('%', @preserved_token, '%');
raw_token_in_general_log
0
SELECT COUNT(*) > 0 AS redacted_last4_token_in_general_log
FROM mysql.general_log
WHERE argument LIKE '%RESUME PRESERVED TRANSACTION%'
   AND argument LIKE CONCAT('%', @redacted_preserved_token, '%');
redacted_last4_token_in_general_log
1
SELECT COUNT(*) AS bare_redacted_token_in_general_log
FROM mysql.general_log
WHERE argument = "RESUME PRESERVED TRANSACTION '****'";
bare_redacted_token_in_general_log
0
SELECT COUNT(*) AS raw_token_in_slow_log
FROM mysql.slow_log
WHERE sql_text LIKE CONCAT('%', @preserved_token, '%');
raw_token_in_slow_log
0
SELECT COUNT(*) > 0 AS redacted_last4_token_in_slow_log
FROM mysql.slow_log
WHERE sql_text LIKE '%RESUME PRESERVED TRANSACTION%'
   AND sql_text LIKE CONCAT('%', @redacted_preserved_token, '%');
redacted_last4_token_in_slow_log
1
SELECT COUNT(*) AS bare_redacted_token_in_slow_log
FROM mysql.slow_log
WHERE sql_text = "RESUME PRESERVED TRANSACTION '****'";
bare_redacted_token_in_slow_log
0
TRUNCATE TABLE mysql.general_log;
TRUNCATE TABLE mysql.slow_log;

SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_temp_autoinc(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_preserve_temp_autoinc(v) VALUES(10),(20);
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
DROP TEMPORARY TABLE tmp_preserve_temp_autoinc;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

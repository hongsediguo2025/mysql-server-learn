DROP TABLE IF EXISTS t_predicate_lock_anchor;
DROP TABLE IF EXISTS t_predicate_lock_after_resume;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_predicate_lock_anchor(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
CREATE TABLE t_predicate_lock_after_resume(
id INT PRIMARY KEY,
pos POINT NOT NULL SRID 0,
SPATIAL KEY(pos)
) ENGINE=InnoDB;
INSERT INTO t_predicate_lock_anchor VALUES(1,0);
INSERT INTO t_predicate_lock_after_resume VALUES
(1, ST_GeomFromText('POINT(1 1)')),
(2, ST_GeomFromText('POINT(10 10)'));
SET @g = ST_GeomFromText('POLYGON((0 0,0 5,5 5,5 0,0 0))');
START TRANSACTION;
UPDATE t_predicate_lock_anchor SET v=1 WHERE id=1;
SELECT COUNT(*) AS locked_rows
FROM t_predicate_lock_after_resume FORCE INDEX(pos)
WHERE MBRWithin(pos, @g) FOR UPDATE;
locked_rows
1
SET innodb_lock_wait_timeout=1;
INSERT INTO t_predicate_lock_after_resume VALUES
(4, ST_GeomFromText('POINT(2 2)'));
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS recovered_predicate_locks
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_predicate_lock_after_resume'
    AND INDEX_NAME='pos'
    AND LOCK_MODE LIKE '%PREDICATE%'
    AND LOCK_STATUS='GRANTED';
recovered_predicate_locks
1
SET innodb_lock_wait_timeout=1;
INSERT INTO t_predicate_lock_after_resume VALUES
(3, ST_GeomFromText('POINT(2 2)'));
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
INSERT INTO t_predicate_lock_after_resume VALUES
(3, ST_GeomFromText('POINT(2 2)'));
SELECT id, ST_AsText(pos) AS pos
FROM t_predicate_lock_after_resume ORDER BY id;
id	pos
1	POINT(1 1)
2	POINT(10 10)
3	POINT(2 2)
SELECT * FROM t_predicate_lock_anchor;
id	v
1	0
DROP TABLE t_predicate_lock_after_resume;
DROP TABLE t_predicate_lock_anchor;
SET GLOBAL preserve_trx_enable=ON;

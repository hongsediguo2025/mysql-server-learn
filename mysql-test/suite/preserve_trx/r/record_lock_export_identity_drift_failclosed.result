DROP TABLE IF EXISTS t_record_lock_export_identity_drift;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_record_lock_export_identity_drift(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_record_lock_export_identity_drift VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_record_lock_export_identity_drift SET v=11 WHERE id=1;
SELECT * FROM t_record_lock_export_identity_drift WHERE id=2 FOR SHARE;
id	v
2	20
SET SESSION debug='+d,preserve_trx_simulate_export_record_lock_identity_drift';
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_simulate_export_record_lock_identity_drift';
SELECT * FROM t_record_lock_export_identity_drift ORDER BY id;
id	v
1	11
2	20
COMMIT;
SELECT * FROM t_record_lock_export_identity_drift ORDER BY id;
id	v
1	11
2	20
include/assert_grep.inc [Record-lock export drift reason is logged]
DROP TABLE t_record_lock_export_identity_drift;
SET GLOBAL preserve_trx_enable=ON;

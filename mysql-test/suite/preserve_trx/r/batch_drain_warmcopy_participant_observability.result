DROP TABLE IF EXISTS t_warmcopy_participant_observability;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TABLE t_warmcopy_participant_observability(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_participant_observability VALUES(1,10);
CREATE TEMPORARY TABLE tmp_warmcopy_observe(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_warmcopy_observe VALUES(1,100);
UPDATE t_warmcopy_participant_observability SET v=11 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE;
include/assert_grep.inc [warmcopy participant observation is emitted by production drain]
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_warmcopy_observe ORDER BY id;
id	v
1	100
COMMIT;
DROP TEMPORARY TABLE tmp_warmcopy_observe;
SELECT * FROM t_warmcopy_participant_observability ORDER BY id;
id	v
1	11
DROP TABLE t_warmcopy_participant_observability;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_recover_before_purge;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_recover_before_purge(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_before_purge VALUES(1,10);
START TRANSACTION;
SELECT * FROM t_recover_before_purge WHERE a=1 FOR UPDATE;
a	b
1	10
UPDATE t_recover_before_purge SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
Pattern "PRESERVE: preserved transaction recovery begin" found
Pattern "PRESERVE: preserved transaction recovery end .*elapsed_us=[0-9]+" found
Pattern "PRESERVE: preserved transaction recovery end .*phase_list_us=[0-9]+ .*phase_snapshot_recover_us=[0-9]+ .*phase_snapshot_load_us=[0-9]+ .*phase_snapshot_validate_us=[0-9]+ .*phase_snapshot_kernel_us=[0-9]+ .*phase_snapshot_claim_us=[0-9]+ .*phase_snapshot_read_view_us=[0-9]+ .*phase_snapshot_table_locks_us=[0-9]+ .*phase_snapshot_record_locks_us=[0-9]+ .*phase_snapshot_record_lock_entries=[1-9][0-9]* .*phase_snapshot_record_lock_stable_page_hits=[0-9]+ .*phase_snapshot_record_lock_image_resolves=[0-9]+ .*phase_snapshot_record_lock_bitmap_pages=[1-9][0-9]* .*phase_snapshot_record_lock_bitmap_bits=[1-9][0-9]* .*phase_snapshot_record_lock_page_get_us=[0-9]+ .*phase_snapshot_record_lock_page_get_count=[1-9][0-9]* .*phase_snapshot_record_lock_table_open_us=[0-9]+ .*phase_snapshot_record_lock_prefetch_pages=[0-9]+ .*phase_snapshot_record_lock_prefetch_bytes=[0-9]+ .*phase_snapshot_predicate_locks_us=[0-9]+ .*phase_snapshot_mdl_us=[0-9]+ .*phase_snapshot_register_us=[0-9]+" found
Pattern "PRESERVE: recovery completed before purge thread start" found
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;
remaining_preserved
0
COMMIT;
SELECT * FROM t_recover_before_purge ORDER BY a;
a	b
1	11
DROP TABLE t_recover_before_purge;
SET GLOBAL preserve_trx_enable=ON;

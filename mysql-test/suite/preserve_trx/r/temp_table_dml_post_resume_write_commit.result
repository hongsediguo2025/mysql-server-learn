SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_post_resume_write_commit(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_post_resume_write_commit VALUES(1, 10);
START TRANSACTION;
UPDATE tmp_preserve_post_resume_write_commit SET v = 11 WHERE id = 1;
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_preserve_post_resume_write_commit ORDER BY id;
id	v
1	11
INSERT INTO tmp_preserve_post_resume_write_commit VALUES(2, 20);
UPDATE tmp_preserve_post_resume_write_commit SET v = 12 WHERE id = 1;
COMMIT;
SELECT * FROM tmp_preserve_post_resume_write_commit ORDER BY id;
id	v
1	12
2	20
DROP TEMPORARY TABLE tmp_preserve_post_resume_write_commit;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

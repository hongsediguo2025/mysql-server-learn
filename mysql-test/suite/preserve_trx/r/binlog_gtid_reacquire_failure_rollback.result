DROP TABLE IF EXISTS t_gtid_reacquire;
DROP TABLE IF EXISTS t_gtid_reacquire_conflict;
SET GLOBAL preserve_trx_enable=ON;
SET SESSION sql_log_bin=0;
CREATE TABLE t_gtid_reacquire(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t_gtid_reacquire_conflict(a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t_gtid_reacquire VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GTID_NEXT='SERVER_UUID:7';
START TRANSACTION;
UPDATE t_gtid_reacquire SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SET GTID_NEXT='SERVER_UUID:7';
START TRANSACTION;
INSERT INTO t_gtid_reacquire_conflict VALUES(7);
COMMIT;
SET GTID_NEXT=AUTOMATIC;
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT * FROM t_gtid_reacquire WHERE a=1;
a	b
1	10
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SET SESSION sql_log_bin=0;
DROP TABLE t_gtid_reacquire, t_gtid_reacquire_conflict;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_batch_inflight;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_inflight(
id INT PRIMARY KEY,
v INT,
tag VARCHAR(32),
resumed_by INT DEFAULT NULL
) ENGINE=InnoDB;
INSERT INTO t_batch_inflight VALUES
(1,10,'base-a',NULL),
(2,20,'base-b',NULL);
START TRANSACTION;
UPDATE t_batch_inflight SET v=11, tag='a-first' WHERE id=1;
SET DEBUG_SYNC =
'before_execute_sql_command SIGNAL batch_inflight_a_blocked WAIT_FOR continue_batch_inflight_a';
UPDATE t_batch_inflight SET v=12, tag='a-inflight' WHERE id=1;
SET DEBUG_SYNC =
'before_execute_sql_command SIGNAL batch_inflight_b_blocked WAIT_FOR continue_batch_inflight_b';
UPDATE t_batch_inflight SET v=22, tag='b-autocommit' WHERE id=2;
START TRANSACTION;
INSERT INTO t_batch_inflight VALUES(3,30,'c-idle',NULL);
SET DEBUG_SYNC = 'now WAIT_FOR batch_inflight_a_blocked TIMEOUT 10';
SET DEBUG_SYNC = 'now WAIT_FOR batch_inflight_b_blocked TIMEOUT 10';
SET GLOBAL preserve_trx_batch_max_transactions=2;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now SIGNAL continue_batch_inflight_a';
SET DEBUG_SYNC = 'now SIGNAL continue_batch_inflight_b';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
2
CREATE TEMPORARY TABLE t_batch_inflight_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS token_count
FROM t_batch_inflight_tokens;
token_count
2
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT COUNT(*) AS row_count,
SUM(tag='a-inflight' AND v=1012 AND resumed_by IS NOT NULL) AS a_resumed,
SUM(tag='b-autocommit' AND v=22 AND resumed_by IS NULL) AS b_committed,
SUM(tag='c-idle' AND v=1030 AND resumed_by IS NOT NULL) AS c_resumed,
COUNT(DISTINCT resumed_by) AS resume_sessions
FROM t_batch_inflight;
row_count	a_resumed	b_committed	c_resumed	resume_sessions
3	1	1	1	2
DROP TABLE t_batch_inflight;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_lock_warmcopy_journal_budget;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_max_journal_bytes=1;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_journal_budget(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_journal_budget VALUES
(1,10,REPEAT('a',32)),
(2,20,REPEAT('b',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_journal_budget SET v=21, pad=REPEAT('c',32)
WHERE id=2;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
START TRANSACTION;
UPDATE t_lock_warmcopy_journal_budget SET v=11, pad=REPEAT('d',32)
WHERE id=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count_after_fallback
FROM performance_schema.preserved_transactions;
preserved_count_after_fallback
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_fallback_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_fallback_resume
0
SELECT id, v, pad=REPEAT('d',32) AS pad_ok
FROM t_lock_warmcopy_journal_budget
WHERE id=1
ORDER BY id;
id	v	pad_ok
1	11	1
DROP TABLE t_lock_warmcopy_journal_budget;

DROP TABLE IF EXISTS t_resume_bruteforce_limit;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_bruteforce_limit(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_resume_bruteforce_limit VALUES(1,10);
START TRANSACTION;
UPDATE t_resume_bruteforce_limit SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SELECT COUNT(*) AS preserved_count_after_invalid_attempts
FROM performance_schema.preserved_transactions;
preserved_count_after_invalid_attempts
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT * FROM t_resume_bruteforce_limit ORDER BY a;
a	b
1	11
DROP TABLE t_resume_bruteforce_limit;
SET GLOBAL preserve_trx_enable=ON;

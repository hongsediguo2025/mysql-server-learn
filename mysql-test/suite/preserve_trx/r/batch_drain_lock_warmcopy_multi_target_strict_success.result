DROP TABLE IF EXISTS t_lock_warmcopy_multi_strict_tokens;
DROP TABLE IF EXISTS t_lock_warmcopy_multi_strict;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_multi_strict(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_multi_strict VALUES
(1,10,REPEAT('a',32)),
(2,20,REPEAT('b',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_multi_strict SET v=11, pad=REPEAT('x',32)
WHERE id=1;
START TRANSACTION;
UPDATE t_lock_warmcopy_multi_strict SET v=22, pad=REPEAT('y',32)
WHERE id=2;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
2
CREATE TABLE t_lock_warmcopy_multi_strict_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
FROM performance_schema.preserved_transactions;
RESUME PRESERVED TRANSACTION 'TOKEN1';
COMMIT;
RESUME PRESERVED TRANSACTION 'TOKEN2';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT id, v, pad IN (REPEAT('x',32), REPEAT('y',32)) AS pad_ok
FROM t_lock_warmcopy_multi_strict
ORDER BY id;
id	v	pad_ok
1	11	1
2	22	1
DROP TABLE t_lock_warmcopy_multi_strict_tokens;
DROP TABLE t_lock_warmcopy_multi_strict;

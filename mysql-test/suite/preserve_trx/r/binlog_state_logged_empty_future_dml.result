DROP TABLE IF EXISTS t_logged_empty;
DROP DATABASE IF EXISTS preserve_trx_ignored;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE DATABASE preserve_trx_ignored;
CREATE TABLE t_logged_empty(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE preserve_trx_ignored.seed(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_logged_empty VALUES(1,10);
INSERT INTO preserve_trx_ignored.seed VALUES(1,10);
START TRANSACTION;
UPDATE preserve_trx_ignored.seed SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SELECT @@global.log_bin AS log_bin_after_restart;
log_bin_after_restart
1
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE,
SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN
FROM performance_schema.preserved_transactions;
TOKEN	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE	SESSION_SQL_LOG_BIN	GLOBAL_LOG_BIN
TOKEN	LOGGED_EMPTY	NO	0	ON	ON
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT @@session.sql_log_bin AS session_sql_log_bin_after_resume;
session_sql_log_bin_after_resume
1
SELECT * FROM preserve_trx_ignored.seed WHERE a=1;
a	b
1	11
UPDATE t_logged_empty SET b=11 WHERE a=1;
COMMIT;
SELECT * FROM t_logged_empty WHERE a=1;
a	b
1	11
SELECT * FROM preserve_trx_ignored.seed WHERE a=1;
a	b
1	11
include/assert_grep.inc [Future DML is written to the binlog after LOGGED_EMPTY resume]
DROP TABLE t_logged_empty;
DROP DATABASE preserve_trx_ignored;
SET GLOBAL rds_preserve_trx_enable=ON;

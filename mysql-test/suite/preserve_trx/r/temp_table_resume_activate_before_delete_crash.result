DROP TABLE IF EXISTS t_preserve_temp_activate_crash_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_preserve_temp_activate_crash_base(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_temp_activate_crash_base VALUES(1, 10);
CREATE TEMPORARY TABLE tmp_preserve_temp_activate_crash(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_temp_activate_crash VALUES(1, 100);
START TRANSACTION;
UPDATE t_preserve_temp_activate_crash_base SET v = 11 WHERE id = 1;
UPDATE tmp_preserve_temp_activate_crash SET v = 101 WHERE id = 1;
INSERT INTO tmp_preserve_temp_activate_crash VALUES(2, 200);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_crash_after_resume_activate_before_snapshot_delete";
RESUME PRESERVED TRANSACTION 'TOKEN';

SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_post_resume_write_rollback(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_post_resume_write_rollback VALUES(1, 10);
START TRANSACTION;
UPDATE tmp_preserve_post_resume_write_rollback SET v = 11 WHERE id = 1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_preserve_post_resume_write_rollback ORDER BY id;
id	v
1	11
INSERT INTO tmp_preserve_post_resume_write_rollback VALUES(2, 20);
UPDATE tmp_preserve_post_resume_write_rollback SET v = 12 WHERE id = 1;
ROLLBACK;
SELECT * FROM tmp_preserve_post_resume_write_rollback ORDER BY id;
id	v
1	10
DROP TEMPORARY TABLE tmp_preserve_post_resume_write_rollback;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

DROP TABLE IF EXISTS t_preserve_mat_budget_exit;
SET GLOBAL preserve_trx_enable=ON;
SET @saved_preserve_trx_max_lock_count=@@GLOBAL.preserve_trx_max_lock_count;
CREATE TABLE t_preserve_mat_budget_exit(
id INT PRIMARY KEY,
k INT,
v INT,
KEY k_idx(k)
) ENGINE=InnoDB;
SET GLOBAL preserve_trx_max_lock_count=1;
START TRANSACTION;
INSERT INTO t_preserve_mat_budget_exit VALUES(1,100,10);
SET DEBUG_SYNC=
'preserve_trx_materialize_after_first_secondary_page_open SIGNAL secondary_scanned';
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET DEBUG_SYNC='now WAIT_FOR secondary_scanned TIMEOUT 0';
Warnings:
Warning	1639	debug sync point wait timed out
SHOW WARNINGS;
Level	Code	Message
Warning	1639	debug sync point wait timed out
SET DEBUG_SYNC='RESET';
ROLLBACK;
SELECT COUNT(*) AS visible_after_rollback
FROM t_preserve_mat_budget_exit;
visible_after_rollback
0
SET GLOBAL preserve_trx_max_lock_count=@saved_preserve_trx_max_lock_count;
DROP TABLE t_preserve_mat_budget_exit;
SET GLOBAL preserve_trx_enable=ON;

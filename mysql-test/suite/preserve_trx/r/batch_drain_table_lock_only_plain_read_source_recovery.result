DROP TABLE IF EXISTS t_plain_lock_tokens;
DROP TABLE IF EXISTS t_plain_lock_modified;
DROP TABLE IF EXISTS t_plain_lock_source;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_plain_lock_modified(
id INT PRIMARY KEY,
v INT,
note VARCHAR(32)
) ENGINE=InnoDB;
CREATE TABLE t_plain_lock_source(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
CREATE TABLE t_plain_lock_tokens(
session_id INT PRIMARY KEY,
token VARCHAR(255) NOT NULL UNIQUE
) ENGINE=InnoDB;
INSERT INTO t_plain_lock_modified VALUES
(1,10,'base'),(2,20,'base'),(3,30,'base'),(4,40,'base');
INSERT INTO t_plain_lock_source VALUES(1,100),(2,200),(3,300),(4,400);
DRAIN TRANSACTIONS PRESERVE;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
4
INSERT INTO t_plain_lock_tokens(session_id, token)
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN), TOKEN
FROM performance_schema.preserved_transactions;
SELECT COUNT(*) AS mapped_token_count
FROM t_plain_lock_tokens;
mapped_token_count
4
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT COUNT(*) AS row_count,
SUM(id BETWEEN 1 AND 4) AS base_rows,
SUM(id BETWEEN 101 AND 104) AS copied_rows,
SUM(note = 'plain-read-source') AS copied_note_rows
FROM t_plain_lock_modified;
row_count	base_rows	copied_rows	copied_note_rows
8	4	4	4
DROP TABLE t_plain_lock_tokens;
DROP TABLE t_plain_lock_modified;
DROP TABLE t_plain_lock_source;
SET GLOBAL rds_preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_read_view_payload;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_read_view_payload(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_read_view_payload VALUES (1, 10);
START TRANSACTION;
SELECT v FROM t_read_view_payload WHERE id = 1;
v
10
UPDATE t_read_view_payload SET v = v + 1 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_read_view_payload_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_read_view_payload_observable';
SELECT TOKEN, STATE, HAS_READ_VIEW, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-read-view-payload-token';
TOKEN	STATE	HAS_READ_VIEW	LAST_ERROR
debug-read-view-payload-token	FAILED	YES	read view payload: export_ok=1 valid=1 has_read_view=1 payload_bytes=# low_limit_no=#
ROLLBACK;
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-read-view-payload-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
DROP TABLE t_read_view_payload;
SET GLOBAL preserve_trx_enable=ON;

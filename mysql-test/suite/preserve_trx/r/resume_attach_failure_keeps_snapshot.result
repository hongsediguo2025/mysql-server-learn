DROP TABLE IF EXISTS t_resume_attach_failure;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_attach_failure(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_resume_attach_failure VALUES(1,10);
START TRANSACTION;
SELECT * FROM t_resume_attach_failure WHERE a=1 FOR UPDATE;
a	b
1	10
UPDATE t_resume_attach_failure SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_fail_attach_to_thd";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_attach_to_thd";
SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;
remaining_preserved
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT * FROM t_resume_attach_failure ORDER BY a;
a	b
1	11
DROP TABLE t_resume_attach_failure;
SET GLOBAL preserve_trx_enable=ON;

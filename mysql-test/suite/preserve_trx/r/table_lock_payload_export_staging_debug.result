DROP TABLE IF EXISTS t_table_lock_payload;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_table_lock_payload(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_table_lock_payload VALUES (1, 10);
START TRANSACTION;
UPDATE t_table_lock_payload SET v = 11 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_table_lock_payload_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_table_lock_payload_observable';
SELECT TOKEN, STATE, LOCKS_COUNT, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-table-lock-payload-token';
TOKEN	STATE	LOCKS_COUNT	LAST_ERROR
debug-table-lock-payload-token	FAILED	1	table lock payload: export_ok=1 valid=1 count_ok=1 count=1 has_autoinc=0 payload_bytes=#
SELECT LAST_ERROR REGEXP
'table lock payload: export_ok=1 valid=1 count_ok=1 count=[1-9][0-9]* has_autoinc=0 payload_bytes=[1-9][0-9]*'
       AS table_lock_payload_ok
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-table-lock-payload-token';
table_lock_payload_ok
1
ROLLBACK;
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-table-lock-payload-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
DROP TABLE t_table_lock_payload;
SET GLOBAL preserve_trx_enable=OFF;

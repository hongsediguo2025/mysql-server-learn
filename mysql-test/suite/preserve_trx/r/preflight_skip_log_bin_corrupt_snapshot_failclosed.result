DROP TABLE IF EXISTS t_preflight_corrupt_snapshot;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preflight_corrupt_snapshot(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preflight_corrupt_snapshot VALUES(1,10);
START TRANSACTION;
SELECT * FROM t_preflight_corrupt_snapshot WHERE a=1 FOR UPDATE;
a	b
1	10
UPDATE t_preflight_corrupt_snapshot SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
# restart: --preserve-trx-enable=ON --skip-log-bin
include/wait_for_pattern_in_file.inc [Preserved transaction .* recovery forced rollback: corrupt durable transaction snapshot]
SELECT COUNT(*) AS preserved_count_after_corrupt_preflight
FROM performance_schema.preserved_transactions;
preserved_count_after_corrupt_preflight
0
SELECT * FROM t_preflight_corrupt_snapshot ORDER BY a;
a	b
1	10
DROP TABLE t_preflight_corrupt_snapshot;
SET GLOBAL preserve_trx_enable=ON;

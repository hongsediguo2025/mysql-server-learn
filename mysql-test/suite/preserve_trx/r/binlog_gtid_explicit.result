DROP TABLE IF EXISTS t_gtid_explicit;
SET GLOBAL preserve_trx_enable=ON;
SET SESSION sql_log_bin=0;
CREATE TABLE t_gtid_explicit(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_gtid_explicit VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GTID_NEXT='SERVER_UUID:7';
START TRANSACTION;
UPDATE t_gtid_explicit SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT @@SESSION.GTID_NEXT = CONCAT(@@GLOBAL.SERVER_UUID, ':7')
AS gtid_next_reacquired;
gtid_next_reacquired
1
COMMIT;
SET GTID_NEXT=AUTOMATIC;
SELECT GTID_SUBSET(CONCAT(@@GLOBAL.SERVER_UUID, ':7'), @@GLOBAL.GTID_EXECUTED)
AS explicit_gtid_committed;
explicit_gtid_committed
1
SELECT GTID_SUBSET(CONCAT(@@GLOBAL.SERVER_UUID, ':1'), @@GLOBAL.GTID_EXECUTED)
AS automatic_gtid_not_used;
automatic_gtid_not_used
0
SELECT * FROM t_gtid_explicit WHERE a=1;
a	b
1	11
SET SESSION sql_log_bin=0;
DROP TABLE t_gtid_explicit;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

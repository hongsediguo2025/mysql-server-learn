DROP TABLE IF EXISTS t_prepare_rollback_gtid;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_prepare_rollback_gtid(id INT PRIMARY KEY, v INT)
ENGINE=InnoDB;
INSERT INTO t_prepare_rollback_gtid VALUES (1, 10);
START TRANSACTION;
UPDATE t_prepare_rollback_gtid SET v = 11 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_prepare_rollback_gtid_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_prepare_rollback_gtid_observable';
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-prepare-rollback-gtid-token';
TOKEN	STATE	LAST_ERROR
debug-prepare-rollback-gtid-token	FAILED	prepare rollback gtid: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 prepare_gtid_ok=1 rollback_ok=1 fallback_rollback_ok=1
SELECT LAST_ERROR REGEXP
'prepare rollback gtid: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 prepare_gtid_ok=1 rollback_ok=1 fallback_rollback_ok=1'
       AS prepare_rollback_gtid_ok
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-prepare-rollback-gtid-token';
prepare_rollback_gtid_ok
1
SELECT * FROM t_prepare_rollback_gtid;
id	v
1	10
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-prepare-rollback-gtid-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
DROP TABLE t_prepare_rollback_gtid;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_temp_top_enable_after_temp_dml;
SET GLOBAL preserve_trx_enable=OFF;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_temp_top_enable_after_temp_dml(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_temp_top_enable_after_temp_dml(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_temp_top_enable_after_temp_dml VALUES(1, 100);
UPDATE tmp_temp_top_enable_after_temp_dml SET v = 101 WHERE id = 1;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
INSERT INTO t_temp_top_enable_after_temp_dml VALUES(1, 10);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
INSERT INTO t_temp_top_enable_after_temp_dml VALUES(2, 20);
COMMIT;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT * FROM t_temp_top_enable_after_temp_dml ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_temp_top_enable_after_temp_dml;
SET GLOBAL preserve_trx_enable=ON;

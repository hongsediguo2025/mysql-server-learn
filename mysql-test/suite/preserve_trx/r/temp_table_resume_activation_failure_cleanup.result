DROP TABLE IF EXISTS t_preserve_temp_activation_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_preserve_temp_activation_base(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_preserve_temp_activation_base VALUES(1, 10);
CREATE TEMPORARY TABLE tmp_preserve_temp_activation_a(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_preserve_temp_activation_b(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_temp_activation_a VALUES(1, 10), (2, 21);
INSERT INTO tmp_preserve_temp_activation_b VALUES(11, 110), (12, 122);
START TRANSACTION;
UPDATE t_preserve_temp_activation_base SET v = 11 WHERE id = 1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_fail_activate_resumed";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_activate_resumed";
SELECT COUNT(*) AS preserved_count_after_failed_activation
FROM performance_schema.preserved_transactions;
preserved_count_after_failed_activation
1
SELECT LAST_ERROR IS NOT NULL AS failed_activation_has_error
FROM performance_schema.preserved_transactions;
failed_activation_has_error
1
SELECT COUNT(*) AS active_innodb_trx_after_failed_activation
FROM information_schema.innodb_trx
WHERE trx_mysql_thread_id = CONNECTION_ID();
active_innodb_trx_after_failed_activation
0
SELECT COUNT(*) FROM tmp_preserve_temp_activation_a;
ERROR 42S02: Table 'test.tmp_preserve_temp_activation_a' doesn't exist
SELECT COUNT(*) FROM tmp_preserve_temp_activation_b;
ERROR 42S02: Table 'test.tmp_preserve_temp_activation_b' doesn't exist
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT COUNT(*) AS preserved_count_after_retry_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_retry_resume
0
SELECT COUNT(*) AS activation_a_rows, SUM(v) AS activation_a_sum
FROM tmp_preserve_temp_activation_a;
activation_a_rows	activation_a_sum
2	31
SELECT COUNT(*) AS activation_b_rows, SUM(v) AS activation_b_sum
FROM tmp_preserve_temp_activation_b;
activation_b_rows	activation_b_sum
2	232
INSERT INTO tmp_preserve_temp_activation_a VALUES(3, 30);
INSERT INTO tmp_preserve_temp_activation_b VALUES(13, 130);
COMMIT;
SELECT * FROM t_preserve_temp_activation_base ORDER BY id;
id	v
1	11
SELECT COUNT(*) AS a_rows_after_commit, SUM(v) AS a_sum_after_commit
FROM tmp_preserve_temp_activation_a;
a_rows_after_commit	a_sum_after_commit
3	61
SELECT COUNT(*) AS b_rows_after_commit, SUM(v) AS b_sum_after_commit
FROM tmp_preserve_temp_activation_b;
b_rows_after_commit	b_sum_after_commit
3	362
DROP TEMPORARY TABLE tmp_preserve_temp_activation_a;
DROP TEMPORARY TABLE tmp_preserve_temp_activation_b;
DROP TABLE t_preserve_temp_activation_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

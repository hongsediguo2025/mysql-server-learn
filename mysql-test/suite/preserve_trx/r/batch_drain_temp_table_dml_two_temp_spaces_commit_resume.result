SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
CREATE TABLE t_two_temp_spaces_commit_base(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_two_temp_commit_a(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_two_temp_commit_b(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_two_temp_commit_a VALUES(1, 10), (2, 20);
INSERT INTO tmp_two_temp_commit_b VALUES(1, 100), (2, 200);
START TRANSACTION;
UPDATE tmp_two_temp_commit_a SET v = v + 1 WHERE id = 1;
INSERT INTO tmp_two_temp_commit_a VALUES(3, 30);
DELETE FROM tmp_two_temp_commit_a WHERE id = 2;
UPDATE tmp_two_temp_commit_b SET v = v + 10 WHERE id = 1;
INSERT INTO tmp_two_temp_commit_b VALUES(3, 300);
DELETE FROM tmp_two_temp_commit_b WHERE id = 2;
INSERT INTO t_two_temp_spaces_commit_base VALUES(1, 7);
UPDATE t_two_temp_spaces_commit_base SET v = v + 1 WHERE id = 1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT 'a_before_continue' AS phase, COUNT(*) AS rows_seen, SUM(v) AS sum_seen
FROM tmp_two_temp_commit_a;
phase	rows_seen	sum_seen
a_before_continue	2	41
SELECT 'b_before_continue' AS phase, COUNT(*) AS rows_seen, SUM(v) AS sum_seen
FROM tmp_two_temp_commit_b;
phase	rows_seen	sum_seen
b_before_continue	2	410
INSERT INTO tmp_two_temp_commit_a VALUES(4, 40);
UPDATE tmp_two_temp_commit_a SET v = v + 100 WHERE id = 1;
INSERT INTO tmp_two_temp_commit_b VALUES(4, 400);
UPDATE tmp_two_temp_commit_b SET v = v + 1000 WHERE id = 1;
COMMIT;
SELECT 'a_after_commit' AS phase, COUNT(*) AS rows_seen, SUM(v) AS sum_seen
FROM tmp_two_temp_commit_a;
phase	rows_seen	sum_seen
a_after_commit	3	181
SELECT 'b_after_commit' AS phase, COUNT(*) AS rows_seen, SUM(v) AS sum_seen
FROM tmp_two_temp_commit_b;
phase	rows_seen	sum_seen
b_after_commit	3	1810
SELECT COUNT(*) AS base_rows, SUM(v) AS base_sum
FROM t_two_temp_spaces_commit_base;
base_rows	base_sum
1	8
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
DROP TEMPORARY TABLE tmp_two_temp_commit_a;
DROP TEMPORARY TABLE tmp_two_temp_commit_b;
DROP TABLE t_two_temp_spaces_commit_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;

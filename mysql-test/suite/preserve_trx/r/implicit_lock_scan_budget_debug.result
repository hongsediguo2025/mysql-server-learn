DROP TABLE IF EXISTS t_preserve_scan_budget_debug;
SET GLOBAL preserve_trx_enable=ON;
SET @saved_preserve_trx_max_scan_pages=@@GLOBAL.preserve_trx_max_scan_pages;
CREATE TABLE t_preserve_scan_budget_debug(id INT PRIMARY KEY, v INT)
ENGINE=InnoDB;
SET GLOBAL preserve_trx_max_scan_pages=0;
START TRANSACTION;
INSERT INTO t_preserve_scan_budget_debug VALUES(1,10);
SET DEBUG_SYNC=
'preserve_trx_materialize_after_first_page_open SIGNAL first_page_opened';
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET DEBUG_SYNC='now WAIT_FOR first_page_opened TIMEOUT 0';
Warnings:
Warning	1639	debug sync point wait timed out
SET DEBUG_SYNC='RESET';
ROLLBACK;
SET GLOBAL preserve_trx_max_scan_pages=@saved_preserve_trx_max_scan_pages;
DROP TABLE t_preserve_scan_budget_debug;
SET GLOBAL preserve_trx_enable=ON;

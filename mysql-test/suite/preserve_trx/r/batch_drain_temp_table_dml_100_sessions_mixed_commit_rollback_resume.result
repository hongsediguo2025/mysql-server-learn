SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
DRAIN TRANSACTIONS PRESERVE WITH USER VARS;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
100
INSERT INTO t_batch_temp_100_mixed_tokens(token)
SELECT TOKEN
FROM performance_schema.preserved_transactions
ORDER BY TOKEN;
SELECT COUNT(*) AS mapped_token_count
FROM t_batch_temp_100_mixed_tokens;
mapped_token_count
100
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT COUNT(*) AS base_rows, SUM(v) AS base_sum
FROM t_batch_temp_100_mixed_base;
base_rows	base_sum
50	25050
SELECT COUNT(*) AS checked_sessions,
SUM(should_commit) AS committed_sessions,
SUM(temp_rows) AS checked_temp_rows,
SUM(temp_sum) AS checked_temp_sum
FROM t_batch_temp_100_mixed_check;
checked_sessions	committed_sessions	checked_temp_rows	checked_temp_sum
100	50	100	500650
SELECT COUNT(*) AS rolled_back_sessions_with_rows
FROM t_batch_temp_100_mixed_check
WHERE should_commit = 0 AND temp_rows <> 0;
rolled_back_sessions_with_rows
0
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;

DROP TABLE IF EXISTS t_batch_force_recovery;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_force_recovery(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_force_recovery VALUES(1,10);
RESET MASTER;
START TRANSACTION;
UPDATE t_batch_force_recovery SET v=11 WHERE id=1;
START TRANSACTION;
INSERT INTO t_batch_force_recovery VALUES(2,20);
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;

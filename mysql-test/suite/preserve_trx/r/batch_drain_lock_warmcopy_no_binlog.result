DROP TABLE IF EXISTS t_lock_warmcopy_no_binlog;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_no_binlog(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_no_binlog VALUES(1,10,REPEAT('a',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_no_binlog SET v=11, pad=REPEAT('b',32)
WHERE id=1;
DRAIN TRANSACTIONS PRESERVE;
include/assert_grep.inc [lock warmcopy success is logged without binlog]
SELECT COUNT(*) AS preserved_count_no_binlog
FROM performance_schema.preserved_transactions;
preserved_count_no_binlog
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_no_binlog_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_no_binlog_after_resume
0
SELECT id, v, pad = REPEAT('b',32) AS pad_ok
FROM t_lock_warmcopy_no_binlog
ORDER BY id;
id	v	pad_ok
1	11	1
DROP TABLE t_lock_warmcopy_no_binlog;

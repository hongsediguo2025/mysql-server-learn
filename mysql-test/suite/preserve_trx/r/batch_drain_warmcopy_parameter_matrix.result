DROP TABLE IF EXISTS t_warmcopy_parameter_matrix;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_drain_phase2_timeout_ms=5000;
SET GLOBAL preserve_trx_recovery_max_count=10;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=1048576;
CREATE TABLE t_warmcopy_parameter_matrix(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_warmcopy_parameter_matrix VALUES
(1,10,REPEAT('a',32)),
(2,20,REPEAT('b',32)),
(3,30,REPEAT('c',32));
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
START TRANSACTION;
UPDATE t_warmcopy_parameter_matrix
SET v=11, pad=REPEAT('x',32)
WHERE id=1;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL warmcopy_matrix_binlog_closing WAIT_FOR warmcopy_matrix_binlog_continue';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_matrix_binlog_closing TIMEOUT 10';
SELECT 'binlog_only_two_phase_observed' AS matrix_case;
matrix_case
binlog_only_two_phase_observed
SET DEBUG_SYNC = 'now SIGNAL warmcopy_matrix_binlog_continue';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
START TRANSACTION;
UPDATE t_warmcopy_parameter_matrix
SET v=22, pad=REPEAT('y',32)
WHERE id=2;

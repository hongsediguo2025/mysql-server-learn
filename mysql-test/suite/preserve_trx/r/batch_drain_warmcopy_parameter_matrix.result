SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
START TRANSACTION;
UPDATE t_warmcopy_parameter_matrix
SET v=33, pad=REPEAT('z',32)
WHERE id=3;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL warmcopy_matrix_both_closing WAIT_FOR warmcopy_matrix_both_continue';
DRAIN TRANSACTIONS PRESERVE;

DROP TABLE IF EXISTS t_batch_all_pending_no_tokens;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_all_pending_no_tokens(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_all_pending_no_tokens VALUES(1,10),(2,20);
SET DEBUG_SYNC =
'before_execute_sql_command SIGNAL batch_no_token_a_ready WAIT_FOR continue_batch_no_token_a';
UPDATE t_batch_all_pending_no_tokens SET v=11 WHERE id=1;
SET DEBUG_SYNC =
'before_execute_sql_command SIGNAL batch_no_token_b_ready WAIT_FOR continue_batch_no_token_b';
UPDATE t_batch_all_pending_no_tokens SET v=21 WHERE id=2;
SET DEBUG_SYNC = 'now WAIT_FOR batch_no_token_a_ready TIMEOUT 10';
SET DEBUG_SYNC = 'now WAIT_FOR batch_no_token_b_ready TIMEOUT 10';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now SIGNAL continue_batch_no_token_a';
SET DEBUG_SYNC = 'now SIGNAL continue_batch_no_token_b';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT * FROM t_batch_all_pending_no_tokens ORDER BY id;
id	v
1	11
2	21
DROP TABLE t_batch_all_pending_no_tokens;
SET GLOBAL preserve_trx_enable=ON;

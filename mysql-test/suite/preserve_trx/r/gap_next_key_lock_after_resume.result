DROP TABLE IF EXISTS t_gap_next_key_after_resume;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_gap_next_key_after_resume(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_gap_next_key_after_resume VALUES(10,10),(20,20),(30,30);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_gap_next_key_after_resume SET v=11 WHERE id=10;
SELECT * FROM t_gap_next_key_after_resume
WHERE id > 10 AND id <= 20 FOR UPDATE;
id	v
20	20
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION innodb_lock_wait_timeout=1;
UPDATE t_gap_next_key_after_resume SET v=21 WHERE id=20;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
INSERT INTO t_gap_next_key_after_resume VALUES(15,15);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
UPDATE t_gap_next_key_after_resume SET v=21 WHERE id=20;
INSERT INTO t_gap_next_key_after_resume VALUES(15,15);
SELECT * FROM t_gap_next_key_after_resume ORDER BY id;
id	v
10	10
15	15
20	21
30	30
DROP TABLE t_gap_next_key_after_resume;
SET GLOBAL preserve_trx_enable=ON;

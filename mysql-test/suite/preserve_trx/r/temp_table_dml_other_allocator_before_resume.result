SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
CREATE TEMPORARY TABLE tmp_preserve_allocator_before_resume(
id INT PRIMARY KEY,
marker INT NOT NULL,
payload LONGBLOB NOT NULL,
KEY(marker)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_allocator_before_resume VALUES
(1, 10, REPEAT('a', 32768));
START TRANSACTION;
INSERT INTO tmp_preserve_allocator_before_resume VALUES
(2, 20, REPEAT('b', 32768));
UPDATE tmp_preserve_allocator_before_resume
SET marker = 11, payload = CONCAT(payload, 'p')
WHERE id = 1;
DRAIN TRANSACTIONS PRESERVE;
CREATE TEMPORARY TABLE tmp_other_allocator_before_resume(
id INT PRIMARY KEY,
payload LONGBLOB NOT NULL
) ENGINE=InnoDB;
START TRANSACTION;
COMMIT;
DROP TEMPORARY TABLE tmp_other_allocator_before_resume;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT id, marker, LENGTH(payload) AS payload_len
FROM tmp_preserve_allocator_before_resume
ORDER BY id;
id	marker	payload_len
1	11	32769
2	20	32768
INSERT INTO tmp_preserve_allocator_before_resume VALUES
(3, 30, REPEAT('c', 32768));
UPDATE tmp_preserve_allocator_before_resume
SET marker = 22, payload = CONCAT(payload, REPEAT('q', 32768))
WHERE id = 2;
DELETE FROM tmp_preserve_allocator_before_resume WHERE id = 1;
COMMIT;
SELECT id, marker, LENGTH(payload) AS payload_len
FROM tmp_preserve_allocator_before_resume
ORDER BY id;
id	marker	payload_len
2	22	65536
3	30	32768
DROP TEMPORARY TABLE tmp_preserve_allocator_before_resume;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_batch_capacity;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_capacity(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_batch_capacity VALUES(1,10);
START TRANSACTION;
INSERT INTO t_batch_capacity VALUES(2,20);
SET GLOBAL preserve_trx_batch_max_transactions=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET GLOBAL preserve_trx_batch_max_transactions=256;
SET GLOBAL preserve_trx_max_total=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET GLOBAL preserve_trx_max_total=256;
SET GLOBAL preserve_trx_max_pending_per_user=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET GLOBAL preserve_trx_max_pending_per_user=256;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
UPDATE t_batch_capacity SET v=11 WHERE id=1;
COMMIT;
UPDATE t_batch_capacity SET v=21 WHERE id=2;
COMMIT;
SELECT * FROM t_batch_capacity ORDER BY id;
id	v
1	11
2	21
DROP TABLE t_batch_capacity;
SET GLOBAL preserve_trx_enable=ON;

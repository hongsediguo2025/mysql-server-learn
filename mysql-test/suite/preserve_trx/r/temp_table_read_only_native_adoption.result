SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
CREATE TEMPORARY TABLE tmp_preserve_temp_read_only(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
SET SESSION transaction_read_only=ON;
START TRANSACTION;
INSERT INTO tmp_preserve_temp_read_only VALUES(1, 10), (2, 20);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION transaction_read_only=OFF;
SELECT @@session.transaction_read_only AS session_read_only_before_resume;
session_read_only_before_resume
0
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT @@session.transaction_read_only AS session_read_only_after_resume;
session_read_only_after_resume
1
INSERT INTO tmp_preserve_temp_read_only VALUES(3, 30);
COMMIT;
SELECT @@session.transaction_read_only AS session_read_only_after_commit;
session_read_only_after_commit
1
SET SESSION transaction_read_only=OFF;
SELECT COUNT(*) AS row_count, SUM(v) AS v_sum
FROM tmp_preserve_temp_read_only;
row_count	v_sum
3	60
DROP TEMPORARY TABLE tmp_preserve_temp_read_only;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_resume_double_detach_failure;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_double_detach_failure(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_resume_double_detach_failure VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_resume_double_detach_failure SET v=11 WHERE id=1;
SAVEPOINT s1;
UPDATE t_resume_double_detach_failure SET v=22 WHERE id=2;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_fail_restore_savepoints_after_sql,preserve_trx_fail_detach_resumed_from_thd,preserve_trx_fail_detach_resumed_from_thd_for_cleanup";
RESUME PRESERVED TRANSACTION 'TOKEN';
Got one of the listed errors
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error FROM performance_schema.preserved_transactions WHERE TOKEN = 'TOKEN';
TOKEN	STATE	has_last_error
TOKEN	FAILED	1
# restart
SELECT COUNT(*) AS preserved_count_after_restart
FROM performance_schema.preserved_transactions;
preserved_count_after_restart
0
SELECT * FROM t_resume_double_detach_failure ORDER BY id;

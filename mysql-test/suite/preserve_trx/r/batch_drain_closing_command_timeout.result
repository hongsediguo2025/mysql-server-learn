DROP TABLE IF EXISTS t_closing_command_timeout;
DROP USER IF EXISTS closing_timeout_app@localhost;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_drain_phase2_timeout_ms=200;
CREATE TABLE t_closing_command_timeout(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_closing_command_timeout VALUES(1,10),(2,20),(3,30);
CREATE USER closing_timeout_app@localhost;
GRANT SELECT, UPDATE ON test.* TO closing_timeout_app@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO closing_timeout_app@localhost;
START TRANSACTION;
UPDATE t_closing_command_timeout SET v=11 WHERE id=1;
SET DEBUG_SYNC=
'before_execute_sql_command SIGNAL closing_timeout_a_running WAIT_FOR closing_timeout_a_continue';
UPDATE t_closing_command_timeout SET v=12 WHERE id=1;
SET DEBUG_SYNC=
'before_execute_sql_command SIGNAL closing_timeout_b_running WAIT_FOR closing_timeout_b_continue';
UPDATE t_closing_command_timeout SET v=22 WHERE id=2;
SET DEBUG_SYNC='now WAIT_FOR closing_timeout_a_running TIMEOUT 10';
SET DEBUG_SYNC='now WAIT_FOR closing_timeout_b_running TIMEOUT 10';
SET DEBUG_SYNC=
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL closing_timeout_entered';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC='now WAIT_FOR closing_timeout_entered TIMEOUT 10';
ERROR HY000: DRAIN TRANSACTIONS PRESERVE hard drain timed out
SELECT VARIABLE_VALUE BETWEEN 150000 AND 1000000 AS shared_deadline_wait
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_closing_command_wait_us';
shared_deadline_wait
1
SELECT VARIABLE_VALUE BETWEEN 190000 AND 210000 AS shared_effective_budget
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_closing_command_effective_budget_us';
shared_effective_budget
1
SELECT VARIABLE_VALUE >= 1 AS timed_out_seen
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_closing_command_timed_out_count';
timed_out_seen
1
SET DEBUG_SYNC='now SIGNAL closing_timeout_a_continue';
SET DEBUG_SYNC='now SIGNAL closing_timeout_b_continue';
COMMIT;
SET GLOBAL preserve_trx_drain_phase2_timeout_ms=50;
START TRANSACTION;
SET DEBUG_SYNC=
'before_execute_sql_command SIGNAL closing_timeout_c_running WAIT_FOR closing_timeout_c_continue';
UPDATE t_closing_command_timeout SET v=33 WHERE id=3;
SET DEBUG_SYNC='now WAIT_FOR closing_timeout_c_running TIMEOUT 10';
SET DEBUG_SYNC=
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL closing_timeout_clamp_entered';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC='now WAIT_FOR closing_timeout_clamp_entered TIMEOUT 10';
ERROR HY000: DRAIN TRANSACTIONS PRESERVE hard drain timed out
SELECT VARIABLE_VALUE BETWEEN 40000 AND 60000 AS phase2_effective_budget
FROM performance_schema.global_status
WHERE VARIABLE_NAME='Preserve_trx_closing_command_effective_budget_us';
phase2_effective_budget
1
SET DEBUG_SYNC='now SIGNAL closing_timeout_c_continue';
COMMIT;
SELECT * FROM t_closing_command_timeout ORDER BY id;
id	v
1	12
2	22
3	33
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
DROP TABLE t_closing_command_timeout;
DROP USER closing_timeout_app@localhost;
SET GLOBAL preserve_trx_drain_phase2_timeout_ms=30000;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET DEBUG_SYNC='RESET';

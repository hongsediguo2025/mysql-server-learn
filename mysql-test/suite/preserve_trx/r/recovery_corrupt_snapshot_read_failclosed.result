DROP TABLE IF EXISTS t_recovery_corrupt_read;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_recovery_corrupt_read(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_recovery_corrupt_read VALUES(1,10);
START TRANSACTION;
UPDATE t_recovery_corrupt_read SET v=11 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
# restart: --preserve-trx-enable=ON --skip-log-bin --debug=d,preserve_trx_simulate_preflight_snapshot_read_corrupt,preserve_trx_simulate_recover_snapshot_read_corrupt
SELECT * FROM t_recovery_corrupt_read ORDER BY id;
id	v
1	10
SELECT COUNT(*) AS preserved_count_after_corrupt_read
FROM performance_schema.preserved_transactions;
preserved_count_after_corrupt_read
0
DROP TABLE t_recovery_corrupt_read;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_resume_before_attach_binlog;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_before_attach_binlog(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_resume_before_attach_binlog VALUES(1,10),(2,20);
RESET MASTER;
START TRANSACTION;
UPDATE t_resume_before_attach_binlog SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_fail_resume_before_attach";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_resume_before_attach";
SELECT COUNT(*) AS remaining_preserved
FROM performance_schema.preserved_transactions;
remaining_preserved
1
START TRANSACTION;
UPDATE t_resume_before_attach_binlog SET b=12 WHERE a=2;
COMMIT;
SELECT * FROM t_resume_before_attach_binlog ORDER BY a;
a	b
1	10
2	12
include/assert_grep.inc [New transaction remains in binlog after before-attach resume cleanup]
include/assert_grep.inc [Failed before-attach resume transaction is discarded from imported binlog cache]
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
DROP TABLE t_resume_before_attach_binlog;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_ps_warmcopy_temp_obs;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
CREATE TABLE t_ps_warmcopy_temp_obs(
id INT PRIMARY KEY,
payload VARBINARY(4096)
) ENGINE=InnoDB;
INSERT INTO t_ps_warmcopy_temp_obs VALUES(1, REPEAT('a', 1024));
CREATE TEMPORARY TABLE tmp_ps_warmcopy_temp_obs(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO tmp_ps_warmcopy_temp_obs VALUES(1, 10), (2, 20);
UPDATE tmp_ps_warmcopy_temp_obs SET v = v + 1 WHERE id = 1;
UPDATE t_ps_warmcopy_temp_obs
SET payload = REPEAT('b', 2048)
WHERE id = 1;
DRAIN TRANSACTIONS PRESERVE;
SELECT TOKEN, BINLOG_WARMCOPY_STATE, TEMP_TABLE_STATE,
TEMP_IMAGE_BYTES > 0 AS temp_image_bytes_positive,
TEMP_UNDO_BYTES > 0 AS temp_undo_bytes_positive,
TEMP_SIDECARS_COMPLETE
FROM performance_schema.preserved_transactions;
TOKEN	BINLOG_WARMCOPY_STATE	TEMP_TABLE_STATE	temp_image_bytes_positive	temp_undo_bytes_positive	TEMP_SIDECARS_COMPLETE
TOKEN	READY	READY	1	1	YES
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT COUNT(*) AS temp_rows, SUM(v) AS temp_sum
FROM tmp_ps_warmcopy_temp_obs;
temp_rows	temp_sum
2	31
COMMIT;
SELECT * FROM tmp_ps_warmcopy_temp_obs ORDER BY id;
id	v
1	11
2	20
DROP TEMPORARY TABLE tmp_ps_warmcopy_temp_obs;
SELECT payload = REPEAT('b', 2048) AS persistent_payload_ok
FROM t_ps_warmcopy_temp_obs
WHERE id = 1;
persistent_payload_ok
1
DROP TABLE t_ps_warmcopy_temp_obs;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

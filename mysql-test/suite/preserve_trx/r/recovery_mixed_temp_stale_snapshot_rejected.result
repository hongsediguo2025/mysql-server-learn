DROP TABLE IF EXISTS t_mixed_stale_snapshot;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_mixed_stale_snapshot(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_mixed_stale_snapshot VALUES(1, 10);
CREATE TEMPORARY TABLE tmp_mixed_stale_snapshot(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO tmp_mixed_stale_snapshot VALUES(1, 100);
SET SESSION debug="+d,preserve_trx_fail_delete_snapshot_files";
SET DEBUG_SYNC =
'preserve_trx_before_token_delivery SIGNAL mixed_token_ready WAIT_FOR mixed_continue';
START TRANSACTION;
UPDATE t_mixed_stale_snapshot SET v=11 WHERE id=1;
UPDATE tmp_mixed_stale_snapshot SET v=101 WHERE id=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR mixed_token_ready TIMEOUT 10';
KILL CONNECTION CONN_ID;
SET DEBUG_SYNC = 'now SIGNAL mixed_continue';
ERROR HY000: Lost connection to MySQL server during query
SELECT COUNT(*) AS preserved_count_before_restart
FROM performance_schema.preserved_transactions;
preserved_count_before_restart
0
# restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON
SELECT COUNT(*) AS preserved_count_after_restart
FROM performance_schema.preserved_transactions;
preserved_count_after_restart
0
SELECT * FROM t_mixed_stale_snapshot ORDER BY id;
id	v
1	10
DROP TABLE t_mixed_stale_snapshot;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

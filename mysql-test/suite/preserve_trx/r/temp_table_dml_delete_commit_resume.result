SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_delete_commit(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_delete_commit VALUES(1, 10), (2, 20), (3, 30);
START TRANSACTION;
DELETE FROM tmp_preserve_delete_commit WHERE id = 2;
UPDATE tmp_preserve_delete_commit SET v = 31 WHERE id = 3;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_preserve_delete_commit ORDER BY id;
id	v
1	10
3	31
COMMIT;
SELECT * FROM tmp_preserve_delete_commit ORDER BY id;
id	v
1	10
3	31
DROP TEMPORARY TABLE tmp_preserve_delete_commit;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_preserve_kill_query_first_check;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_kill_query_first_check(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preserve_kill_query_first_check VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_after_undo_prepared_before_kill_check SIGNAL after_undo_before_kill WAIT_FOR continue_after_undo_before_kill';
START TRANSACTION;
UPDATE t_preserve_kill_query_first_check SET b=12 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR after_undo_before_kill TIMEOUT 10';
KILL QUERY CONN_ID;
SET DEBUG_SYNC = 'now SIGNAL continue_after_undo_before_kill';
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_preserve_kill_query_first_check WHERE a=1;
a	b
1	10
DROP TABLE t_preserve_kill_query_first_check;
SET GLOBAL preserve_trx_enable=ON;

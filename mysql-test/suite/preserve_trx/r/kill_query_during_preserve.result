DROP TABLE IF EXISTS t_preserve_kill_query;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_kill_query(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_kill_query VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_after_lock_materialization SIGNAL before_durable WAIT_FOR continue_preserve';
START TRANSACTION;
UPDATE t_preserve_kill_query SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR before_durable TIMEOUT 10';
KILL QUERY CONN_ID;
SET DEBUG_SYNC = 'now SIGNAL continue_preserve';
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
SELECT * FROM t_preserve_kill_query WHERE a=1;
a	b
1	11
ROLLBACK;
SELECT * FROM t_preserve_kill_query WHERE a=1;
a	b
1	10
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
DROP TABLE t_preserve_kill_query;
SET GLOBAL preserve_trx_enable=ON;

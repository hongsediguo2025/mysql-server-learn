SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_delete_rollback(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_delete_rollback VALUES(1, 10), (2, 20), (3, 30);
START TRANSACTION;
DELETE FROM tmp_preserve_delete_rollback WHERE id = 2;
UPDATE tmp_preserve_delete_rollback SET v = 31 WHERE id = 3;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_preserve_delete_rollback ORDER BY id;
id	v
1	10
3	31
ROLLBACK;
SELECT * FROM tmp_preserve_delete_rollback ORDER BY id;
id	v
1	10
2	20
3	30
DROP TEMPORARY TABLE tmp_preserve_delete_rollback;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

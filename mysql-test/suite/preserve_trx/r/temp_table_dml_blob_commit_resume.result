SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_blob(
id BIGINT PRIMARY KEY,
v BIGINT NOT NULL,
payload LONGBLOB NOT NULL,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_blob VALUES
(1, 10, REPEAT('a', 65536)),
(2, 20, REPEAT('b', 65536));
START TRANSACTION;
INSERT INTO tmp_preserve_blob VALUES(3, 30, REPEAT('c', 65536));
UPDATE tmp_preserve_blob
SET v = 31, payload = CONCAT(payload, 'd')
WHERE id = 3;
DELETE FROM tmp_preserve_blob WHERE id = 1;
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT id, v, LENGTH(payload) AS payload_len
FROM tmp_preserve_blob
ORDER BY id;
id	v	payload_len
2	20	65536
3	31	65537
COMMIT;
SELECT id, v, LENGTH(payload) AS payload_len
FROM tmp_preserve_blob
ORDER BY id;
id	v	payload_len
2	20	65536
3	31	65537
DROP TEMPORARY TABLE tmp_preserve_blob;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
SET GLOBAL rds_preserve_trx_enable=ON;

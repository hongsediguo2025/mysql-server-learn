DROP TABLE IF EXISTS t_autoinc_after_resume;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_autoinc_after_resume(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_autoinc_after_resume(v) VALUES(10);
SELECT LAST_INSERT_ID() AS first_insert_id;
first_insert_id
1
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT TOKEN, AUTOINC_LOCK_OWNED
FROM performance_schema.preserved_transactions;
TOKEN	AUTOINC_LOCK_OWNED
TOKEN	NO
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT LAST_INSERT_ID() AS resumed_last_insert_id;
resumed_last_insert_id
1
INSERT INTO t_autoinc_after_resume(v) VALUES(20);
SELECT LAST_INSERT_ID() AS second_insert_id;
second_insert_id
2
COMMIT;
SELECT * FROM t_autoinc_after_resume ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_autoinc_after_resume;
SET GLOBAL preserve_trx_enable=ON;

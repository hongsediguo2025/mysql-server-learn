SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_temp_table_enable=ON;
CREATE TABLE t_batch_temp_replace(
sid INT NOT NULL,
k INT NOT NULL,
v BIGINT NOT NULL,
counter INT NOT NULL DEFAULT 0,
amount DECIMAL(18,2) NOT NULL DEFAULT 0.00,
d DATE NOT NULL,
note VARCHAR(96),
js JSON,
payload VARCHAR(96),
deleted TINYINT NOT NULL DEFAULT 0,
g BIGINT GENERATED ALWAYS AS (v + sid) STORED,
PRIMARY KEY(sid, k),
UNIQUE KEY uq_sid_note(sid, note),
KEY idx_sid_v(sid, v),
KEY idx_sid_g(sid, g),
KEY idx_sid_deleted(sid, deleted)
) ENGINE=InnoDB;

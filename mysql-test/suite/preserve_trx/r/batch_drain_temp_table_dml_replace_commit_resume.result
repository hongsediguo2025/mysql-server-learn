CREATE TEMPORARY TABLE tmp_batch_temp_replace(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;
SET @batch_temp_sid = 1;
START TRANSACTION;
INSERT INTO tmp_batch_temp_replace VALUES(1, 10);
UPDATE tmp_batch_temp_replace SET v = 11 WHERE id = 1;

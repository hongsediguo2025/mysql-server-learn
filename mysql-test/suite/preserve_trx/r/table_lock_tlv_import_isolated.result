DROP TABLE IF EXISTS t_table_lock_tlv_import_isolated;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_table_lock_tlv_import_isolated(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_table_lock_tlv_import_isolated VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_table_lock_tlv_import_isolated SET v=21 WHERE id=2;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT COUNT(*) > 0 AS recovered_ix_from_table_lock_tlv
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_table_lock_tlv_import_isolated'
    AND LOCK_TYPE='TABLE'
    AND LOCK_MODE='IX'
    AND LOCK_STATUS='GRANTED';
recovered_ix_from_table_lock_tlv
1
SELECT COUNT(*) > 0 AS recovered_record_locks
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_table_lock_tlv_import_isolated'
    AND LOCK_TYPE='RECORD'
    AND LOCK_STATUS='GRANTED';
recovered_record_locks
1
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_table_lock_tlv_import_isolated ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_table_lock_tlv_import_isolated;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_warmcopy_timeout;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
SET GLOBAL rds_preserve_trx_drain_phase1_timeout_ms=1;
SET GLOBAL rds_preserve_trx_drain_phase2_timeout_ms=100;
CREATE TABLE t_warmcopy_timeout(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_timeout VALUES(1,10);
START TRANSACTION;
UPDATE t_warmcopy_timeout SET v=11 WHERE id=1;
SET DEBUG_SYNC =
'before_execute_sql_command SIGNAL warmcopy_timeout_blocked WAIT_FOR warmcopy_timeout_continue';
UPDATE t_warmcopy_timeout SET v=12 WHERE id=1;
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_timeout_blocked TIMEOUT 10';
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL warmcopy_timeout_closing';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_timeout_closing TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL warmcopy_timeout_continue';
ERROR HY000: DRAIN TRANSACTIONS PRESERVE hard drain timed out
COMMIT;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT * FROM t_warmcopy_timeout;

DROP TABLE IF EXISTS t_batch_capacity_exact;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_batch_capacity_exact(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_batch_capacity_exact VALUES(1,10);
START TRANSACTION;
INSERT INTO t_batch_capacity_exact VALUES(2,20);
DRAIN TRANSACTIONS PRESERVE;
SELECT COUNT(*) AS preserved_count_at_exact_limit
FROM performance_schema.preserved_transactions;
preserved_count_at_exact_limit
2
CREATE TEMPORARY TABLE t_batch_capacity_exact_tokens AS
SELECT ROW_NUMBER() OVER (ORDER BY TOKEN) AS rn, TOKEN
FROM performance_schema.preserved_transactions;
RESUME PRESERVED TRANSACTION 'TOKEN1';
COMMIT;
RESUME PRESERVED TRANSACTION 'TOKEN2';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_commit
FROM performance_schema.preserved_transactions;
preserved_count_after_commit
0
SELECT COUNT(*) AS committed_rows
FROM t_batch_capacity_exact;
committed_rows
2
DROP TABLE t_batch_capacity_exact;
SET GLOBAL rds_preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_keyring_logged_cache_temp;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_keyring_logged_cache_temp(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_keyring_logged_cache_temp VALUES(1,10);
CREATE TEMPORARY TABLE tmp_keyring_logged_cache_temp(
a INT PRIMARY KEY,
b VARCHAR(64)
) ENGINE=InnoDB;
INSERT INTO tmp_keyring_logged_cache_temp VALUES(1,'before-preserve');
START TRANSACTION;
UPDATE t_keyring_logged_cache_temp SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
# restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON --debug=d,preserve_trx_simulate_encrypted_tablespace_key_unavailable
include/wait_for_pattern_in_file.inc [Preserved transaction .* recovery failed: encrypted tablespace key unavailable]
SELECT TOKEN, STATE, LAST_ERROR, BINLOG_STATE, WROTE_TO_CACHE,
BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE,
TEMP_TABLE_STATE, TEMP_SIDECARS_COMPLETE
FROM performance_schema.preserved_transactions;
TOKEN	STATE	LAST_ERROR	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE_POSITIVE	TEMP_TABLE_STATE	TEMP_SIDECARS_COMPLETE
TOKEN	FAILED	encrypted tablespace key unavailable	LOGGED_WITH_CACHE	YES	1	READY	YES
SELECT COUNT(*) AS resumable_count
FROM performance_schema.preserved_transactions
WHERE STATE = 'PRESERVED';
resumable_count
0
SELECT * FROM t_keyring_logged_cache_temp ORDER BY a;
a	b
1	10
# restart: --preserve-trx-enable=ON --preserve-trx-temp-table-enable=ON
include/wait_for_pattern_in_file.inc [Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted]
SELECT COUNT(*) AS preserved_count_after_taint_cleanup
FROM performance_schema.preserved_transactions;
preserved_count_after_taint_cleanup
0
SELECT * FROM t_keyring_logged_cache_temp ORDER BY a;
a	b
1	10
DROP TABLE t_keyring_logged_cache_temp;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

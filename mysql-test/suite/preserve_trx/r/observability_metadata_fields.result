DROP TABLE IF EXISTS t_preserve_obs_a;
DROP TABLE IF EXISTS t_preserve_obs_b;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_obs_a(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t_preserve_obs_b(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_obs_a VALUES(1,10);
INSERT INTO t_preserve_obs_b VALUES(1,20);
START TRANSACTION;
UPDATE t_preserve_obs_a SET b=11 WHERE a=1;
UPDATE t_preserve_obs_b SET b=21 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT TOKEN,
CREATED_AT IS NOT NULL AS created_present,
EXPIRES_AT IS NOT NULL AS expires_present,
AGE_SECONDS >= 0 AS age_nonnegative,
MOD_TABLES_COUNT
FROM performance_schema.preserved_transactions;
TOKEN	created_present	expires_present	age_nonnegative	MOD_TABLES_COUNT
TOKEN	1	1	1	2
SHOW PRESERVED TRANSACTIONS;
TOKEN	USER	HOST	STATE	CREATED_AT	EXPIRES_AT	RECOVERED_COUNT	AGE_SECONDS	SCHEMA_NAME	ISOLATION	MOD_TABLES_COUNT	LOCKS_COUNT	HAS_READ_VIEW	RV_LOW_LIMIT_NO	SAVEPOINT_COUNT	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE	BINLOG_WARMCOPY_STATE	SESSION_SQL_LOG_BIN	GLOBAL_LOG_BIN	GTID_NEXT	AUTOINC_LOCK_OWNED	TEMP_TABLE_STATE	TEMP_IMAGE_BYTES	TEMP_UNDO_BYTES	TEMP_SIDECARS_COMPLETE	LAST_ERROR	LAST_ERROR_AT
TOKEN	root	localhost	PRESERVED	CREATED_AT	EXPIRES_AT	1	AGE_SECONDS	test	REPEATABLE-READ	2	4	NO	0	0	GLOBAL_OFF_NO_CACHE	NO	0	NONE	ON	OFF	NULL	NO	NONE	0	0	YES	NULL	NULL
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
DROP TABLE t_preserve_obs_a;
DROP TABLE t_preserve_obs_b;
SET GLOBAL preserve_trx_enable=ON;

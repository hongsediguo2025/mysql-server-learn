DROP TABLE IF EXISTS t_preserve_state;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_state(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_state VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_before_token_delivery SIGNAL state_snapshotting WAIT_FOR continue_state_snapshotting';
START TRANSACTION;
UPDATE t_preserve_state SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR state_snapshotting TIMEOUT 10';
SELECT COUNT(*) AS snapshotting_rows
FROM performance_schema.preserved_transactions
WHERE STATE = 'SNAPSHOTTING';
snapshotting_rows
1
SHOW PRESERVED TRANSACTIONS;
TOKEN	USER	HOST	STATE	CREATED_AT	EXPIRES_AT	RECOVERED_COUNT	AGE_SECONDS	SCHEMA_NAME	ISOLATION	MOD_TABLES_COUNT	LOCKS_COUNT	HAS_READ_VIEW	RV_LOW_LIMIT_NO	SAVEPOINT_COUNT	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE	BINLOG_WARMCOPY_STATE	SESSION_SQL_LOG_BIN	GLOBAL_LOG_BIN	GTID_NEXT	AUTOINC_LOCK_OWNED	TEMP_TABLE_STATE	TEMP_IMAGE_BYTES	TEMP_UNDO_BYTES	TEMP_SIDECARS_COMPLETE	LAST_ERROR	LAST_ERROR_AT
TOKEN	root	localhost	SNAPSHOTTING	CREATED_AT	EXPIRES_AT	0	AGE_SECONDS	test	REPEATABLE-READ	1	2	NO	0	0	GLOBAL_OFF_NO_CACHE	NO	0	NONE	ON	OFF	NULL	NO	NONE	0	0	YES	NULL	NULL
SET DEBUG_SYNC = 'now SIGNAL continue_state_snapshotting';
SET DEBUG_SYNC =
'preserve_trx_resume_after_record_take SIGNAL state_resuming WAIT_FOR continue_state_resuming';
RESUME PRESERVED TRANSACTION 'TOKEN';
SET DEBUG_SYNC = 'now WAIT_FOR state_resuming TIMEOUT 10';
SELECT TOKEN, STATE
FROM performance_schema.preserved_transactions;
TOKEN	STATE
TOKEN	RESUMING
SET DEBUG_SYNC = 'now SIGNAL continue_state_resuming';
ROLLBACK;
TRUNCATE TABLE t_preserve_state;
INSERT INTO t_preserve_state VALUES(1,10);
START TRANSACTION;
UPDATE t_preserve_state SET b=12 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET SESSION debug="+d,preserve_trx_fail_activate_resumed";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_activate_resumed";
SELECT TOKEN, STATE, LAST_ERROR IS NOT NULL AS has_last_error
FROM performance_schema.preserved_transactions;
TOKEN	STATE	has_last_error
TOKEN	PRESERVED	1
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
TRUNCATE TABLE t_preserve_state;
INSERT INTO t_preserve_state VALUES(1,10);
START TRANSACTION;
UPDATE t_preserve_state SET b=13 WHERE a=1;
SET DEBUG_SYNC =
'preserve_trx_batch_after_one_target_preserved SIGNAL state_draining WAIT_FOR continue_state_draining';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS draining_rows
FROM performance_schema.preserved_transactions
WHERE STATE = 'DRAINING';
draining_rows
1
SET DEBUG_SYNC = 'now SIGNAL continue_state_draining';
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
DROP TABLE t_preserve_state;
SET GLOBAL preserve_trx_enable=ON;

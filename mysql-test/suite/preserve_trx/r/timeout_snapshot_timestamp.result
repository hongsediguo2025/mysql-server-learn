DROP TABLE IF EXISTS t_timeout_snapshot_timestamp;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_token_retention_timeout_ms=1000;
CREATE TABLE t_timeout_snapshot_timestamp(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_timeout_snapshot_timestamp VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_before_snapshot_timestamp SIGNAL before_snapshot_timestamp WAIT_FOR continue_snapshot_timestamp';
START TRANSACTION;
UPDATE t_timeout_snapshot_timestamp SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR before_snapshot_timestamp TIMEOUT 3';
SET DEBUG_SYNC = 'now SIGNAL continue_snapshot_timestamp';
SELECT p.CREATED_AT >= FROM_UNIXTIME(@marker_epoch) AS created_after_marker,
TIMESTAMPDIFF(SECOND, p.CREATED_AT, p.EXPIRES_AT) AS timeout_seconds
FROM performance_schema.preserved_transactions p;
created_after_marker	timeout_seconds
1	1
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
DROP TABLE t_timeout_snapshot_timestamp;
SET GLOBAL preserve_trx_enable=ON;

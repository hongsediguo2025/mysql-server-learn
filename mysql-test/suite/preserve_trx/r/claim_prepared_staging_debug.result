DROP TABLE IF EXISTS t_claim_prepared;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_claim_prepared(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_claim_prepared VALUES (1, 10);
START TRANSACTION;
UPDATE t_claim_prepared SET v = 11 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_claim_prepared_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_claim_prepared_observable';
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-claim-prepared-token';
TOKEN	STATE	LAST_ERROR
debug-claim-prepared-token	FAILED	claim prepared: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 rollback_ok=1 fallback_rollback_ok=1
SELECT LAST_ERROR REGEXP
'claim prepared: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 rollback_ok=1 fallback_rollback_ok=1'
       AS claim_prepared_ok
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-claim-prepared-token';
claim_prepared_ok
1
SELECT * FROM t_claim_prepared;
id	v
1	10
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-claim-prepared-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
DROP TABLE t_claim_prepared;
SET GLOBAL preserve_trx_enable=OFF;

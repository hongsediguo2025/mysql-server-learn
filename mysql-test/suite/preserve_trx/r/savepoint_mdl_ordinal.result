DROP TABLE IF EXISTS t_savepoint_mdl_o_anchor;
DROP TABLE IF EXISTS t_savepoint_mdl_o_before;
DROP TABLE IF EXISTS t_savepoint_mdl_o_after;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_savepoint_mdl_o_anchor(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE t_savepoint_mdl_o_before(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE t_savepoint_mdl_o_after(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_savepoint_mdl_o_anchor VALUES(1,10);
INSERT INTO t_savepoint_mdl_o_before VALUES(1,20);
INSERT INTO t_savepoint_mdl_o_after VALUES(1,30);
START TRANSACTION;
UPDATE t_savepoint_mdl_o_anchor SET v=11 WHERE id=1;
SAVEPOINT before_mdl;
SELECT * FROM t_savepoint_mdl_o_before ORDER BY id;
id	v
1	20
SAVEPOINT after_before_mdl;
SELECT * FROM t_savepoint_mdl_o_after ORDER BY id;
id	v
1	30
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET lock_wait_timeout=1;
ALTER TABLE t_savepoint_mdl_o_before ADD COLUMN ddl_marker INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ALTER TABLE t_savepoint_mdl_o_after ADD COLUMN ddl_marker INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK TO SAVEPOINT before_mdl;
ALTER TABLE t_savepoint_mdl_o_before ADD COLUMN ddl_marker INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ALTER TABLE t_savepoint_mdl_o_after ADD COLUMN ddl_marker INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
COMMIT;
ALTER TABLE t_savepoint_mdl_o_before ADD COLUMN ddl_marker INT;
ALTER TABLE t_savepoint_mdl_o_after ADD COLUMN ddl_marker INT;
SELECT * FROM t_savepoint_mdl_o_anchor ORDER BY id;
id	v
1	11
SELECT * FROM t_savepoint_mdl_o_before ORDER BY id;
id	v	ddl_marker
1	20	NULL
SELECT * FROM t_savepoint_mdl_o_after ORDER BY id;
id	v	ddl_marker
1	30	NULL
DROP TABLE t_savepoint_mdl_o_after;
DROP TABLE t_savepoint_mdl_o_before;
DROP TABLE t_savepoint_mdl_o_anchor;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_preserve_kill_query_after_undo;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_kill_query_after_undo(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preserve_kill_query_after_undo VALUES(1,10);
SET SESSION debug="+d,preserve_trx_fail_before_snapshot_fsync";
SET DEBUG_SYNC =
'preserve_trx_after_undo_prepared SIGNAL after_undo WAIT_FOR continue_after_undo';
START TRANSACTION;
UPDATE t_preserve_kill_query_after_undo SET b=12 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR after_undo TIMEOUT 10';
KILL QUERY CONN_ID;
SET DEBUG_SYNC = 'now SIGNAL continue_after_undo';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET DEBUG_SYNC = 'RESET';
SELECT * FROM t_preserve_kill_query_after_undo WHERE a=1;
a	b
1	10
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
DROP TABLE t_preserve_kill_query_after_undo;
SET GLOBAL preserve_trx_enable=ON;

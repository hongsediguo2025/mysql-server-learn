SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=OFF;
CREATE TABLE t_dynamic_enable_base(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TEMPORARY TABLE tmp_dynamic_enable(id INT PRIMARY KEY, v INT)
ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_dynamic_enable_base VALUES(1, 1);
INSERT INTO tmp_dynamic_enable VALUES(1, 10);
SET GLOBAL preserve_trx_temp_table_enable=ON;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
DROP TEMPORARY TABLE tmp_dynamic_enable;
DROP TABLE t_dynamic_enable_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

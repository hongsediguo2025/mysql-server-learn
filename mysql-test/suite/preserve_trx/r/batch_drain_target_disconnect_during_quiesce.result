DROP TABLE IF EXISTS t_batch_disconnect;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_disconnect(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
SET DEBUG_SYNC =
'preserve_trx_batch_after_one_target_preserved SIGNAL batch_disconnect_paused WAIT_FOR continue_batch_disconnect';
START TRANSACTION;
INSERT INTO t_batch_disconnect VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_batch_after_one_target_preserved SIGNAL batch_disconnect_paused WAIT_FOR continue_batch_disconnect';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR batch_disconnect_paused TIMEOUT 1';
SET DEBUG_SYNC = 'now SIGNAL continue_batch_disconnect';
RESUME PRESERVED TRANSACTION 'TOKEN';
UPDATE t_batch_disconnect SET b=11 WHERE a=1;
COMMIT;
SELECT * FROM t_batch_disconnect;
a	b
1	11
DROP TABLE t_batch_disconnect;
SET GLOBAL preserve_trx_enable=ON;

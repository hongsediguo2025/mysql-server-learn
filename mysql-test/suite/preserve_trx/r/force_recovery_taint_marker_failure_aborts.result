INSERT INTO t_force_recovery_taint_fail VALUES(1,10);
START TRANSACTION;
UPDATE t_force_recovery_taint_fail SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;

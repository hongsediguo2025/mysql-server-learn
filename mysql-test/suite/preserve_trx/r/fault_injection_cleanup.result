DROP TABLE IF EXISTS t_preserve_fault_cleanup;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_fault_cleanup(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_preserve_fault_cleanup VALUES(1,10);
SET SESSION debug="+d,preserve_trx_fail_after_lock_materialization";
START TRANSACTION;
UPDATE t_preserve_fault_cleanup SET b=b+1 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_after_lock_materialization";
SELECT * FROM t_preserve_fault_cleanup WHERE a=1;
a	b
1	11
ROLLBACK;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0

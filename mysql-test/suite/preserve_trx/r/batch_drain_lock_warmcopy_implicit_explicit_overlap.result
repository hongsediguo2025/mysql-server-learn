DROP TABLE IF EXISTS t_lock_warmcopy_implicit_explicit;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_lock_warmcopy_implicit_explicit(
id INT PRIMARY KEY,
uk INT UNIQUE,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_implicit_explicit VALUES
(1,10,10,REPEAT('a',32)),
(3,30,30,REPEAT('c',32));
START TRANSACTION;
INSERT INTO t_lock_warmcopy_implicit_explicit
VALUES(2,20,20,REPEAT('b',32));
SET innodb_lock_wait_timeout=1;
SELECT id FROM t_lock_warmcopy_implicit_explicit
WHERE id=2
FOR UPDATE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SELECT COUNT(*) > 0 AS explicit_primary_lock_materialized
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_lock_warmcopy_implicit_explicit'
    AND INDEX_NAME='PRIMARY'
    AND LOCK_TYPE='RECORD'
    AND LOCK_STATUS='GRANTED';
explicit_primary_lock_materialized
1
DRAIN TRANSACTIONS PRESERVE;
include/assert_grep.inc [lock warmcopy succeeds after implicit explicit overlap]
SELECT COUNT(*) AS preserved_count_after_implicit_explicit_overlap
FROM performance_schema.preserved_transactions;
preserved_count_after_implicit_explicit_overlap
1
SELECT COUNT(*) AS visible_before_overlap_resume
FROM t_lock_warmcopy_implicit_explicit FORCE INDEX(uk)
WHERE uk=20;
visible_before_overlap_resume
0
SET innodb_lock_wait_timeout=1;
INSERT INTO t_lock_warmcopy_implicit_explicit
VALUES(4,20,40,REPEAT('d',32));
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_implicit_explicit_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_implicit_explicit_resume
0
INSERT INTO t_lock_warmcopy_implicit_explicit
VALUES(5,20,50,REPEAT('e',32));
ERROR 23000: Duplicate entry '20' for key 't_lock_warmcopy_implicit_explicit.uk'
SELECT id, uk, v, pad=REPEAT('b',32) AS pad_ok
FROM t_lock_warmcopy_implicit_explicit FORCE INDEX(uk)
WHERE uk=20;
id	uk	v	pad_ok
2	20	20	1
DROP TABLE t_lock_warmcopy_implicit_explicit;

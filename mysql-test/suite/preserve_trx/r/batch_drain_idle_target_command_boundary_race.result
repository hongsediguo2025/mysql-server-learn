DROP TABLE IF EXISTS t_batch_idle_boundary;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_idle_boundary(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_batch_idle_boundary VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_after_begin_before_command_read SIGNAL idle_target_before_read WAIT_FOR continue_idle_target_read';
SET DEBUG_SYNC = 'now WAIT_FOR idle_target_before_read TIMEOUT 10';
SET DEBUG_SYNC =
'preserve_trx_batch_after_targets_quiesced_before_attach SIGNAL idle_target_quiesced WAIT_FOR continue_idle_target_attach';
SET DEBUG_SYNC =
'preserve_trx_batch_after_one_target_preserved SIGNAL idle_target_preserved WAIT_FOR continue_idle_target_preserved';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR idle_target_quiesced TIMEOUT 2';
SELECT COUNT(*) AS preserved_count_before_attach
FROM performance_schema.preserved_transactions;
preserved_count_before_attach
0
SELECT 1;
SET DEBUG_SYNC = 'now SIGNAL continue_idle_target_read';
SET DEBUG_SYNC = 'now SIGNAL continue_idle_target_attach';
SET DEBUG_SYNC = 'now WAIT_FOR idle_target_preserved TIMEOUT 10';
ERROR HY000: This session's transaction has been preserved by DRAIN TRANSACTIONS PRESERVE
SET DEBUG_SYNC = 'now SIGNAL continue_idle_target_preserved';
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_batch_idle_boundary;
a	b
DROP TABLE t_batch_idle_boundary;
SET GLOBAL preserve_trx_enable=ON;

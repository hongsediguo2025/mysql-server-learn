DROP TABLE IF EXISTS t_resume_replaces_empty_user_vars;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_replaces_empty_user_vars(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_resume_replaces_empty_user_vars VALUES(1,10);
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300 WITH USER VARS;
SET @current_only = 'must-be-cleared-by-empty-user-vars-snapshot';
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT @current_only IS NULL AS current_only_was_cleared;
current_only_was_cleared
1
COMMIT;
SELECT * FROM t_resume_replaces_empty_user_vars ORDER BY id;
id	v
1	10
DROP TABLE t_resume_replaces_empty_user_vars;
SET GLOBAL preserve_trx_enable=ON;

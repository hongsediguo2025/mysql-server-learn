DROP TABLE IF EXISTS t_ps_warmcopy_temp_obs;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TABLE t_ps_warmcopy_temp_obs(
id INT PRIMARY KEY,
payload VARBINARY(2048)
) ENGINE=InnoDB;
INSERT INTO t_ps_warmcopy_temp_obs VALUES(1,REPEAT('a',1024));
CREATE TEMPORARY TABLE tmp_ps_warmcopy_temp_obs(
id INT PRIMARY KEY,
note VARCHAR(64)
) ENGINE=InnoDB;
INSERT INTO tmp_ps_warmcopy_temp_obs VALUES(1,'before-preserve');
START TRANSACTION;
UPDATE t_ps_warmcopy_temp_obs
SET payload=REPEAT('b',1024)
WHERE id=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE,
BINLOG_CACHE_SIZE > 0 AS binlog_cache_size_positive,
BINLOG_WARMCOPY_STATE,
TEMP_TABLE_STATE,
TEMP_IMAGE_BYTES > 0 AS temp_image_bytes_positive,
TEMP_UNDO_BYTES,
TEMP_SIDECARS_COMPLETE
FROM performance_schema.preserved_transactions;
TOKEN	BINLOG_STATE	WROTE_TO_CACHE	binlog_cache_size_positive	BINLOG_WARMCOPY_STATE	TEMP_TABLE_STATE	temp_image_bytes_positive	TEMP_UNDO_BYTES	TEMP_SIDECARS_COMPLETE
TOKEN	LOGGED_WITH_CACHE	YES	1	READY	READY	1	0	YES
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_ps_warmcopy_temp_obs ORDER BY id;
id	note
1	before-preserve
COMMIT;
SELECT id, payload=REPEAT('b',1024) AS payload_ok
FROM t_ps_warmcopy_temp_obs
ORDER BY id;
id	payload_ok
1	1
DROP TABLE t_ps_warmcopy_temp_obs;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_lock_warmcopy_mdl_unsupported;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_lock_warmcopy_mdl_unsupported(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_mdl_unsupported VALUES(1,10);
LOCK TABLES t_lock_warmcopy_mdl_unsupported WRITE;
UPDATE t_lock_warmcopy_mdl_unsupported SET v=11 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*) AS preserved_count_after_explicit_mdl_reject
FROM performance_schema.preserved_transactions;
preserved_count_after_explicit_mdl_reject
0
UNLOCK TABLES;
SELECT id, v FROM t_lock_warmcopy_mdl_unsupported ORDER BY id;
id	v
1	11
DROP TABLE t_lock_warmcopy_mdl_unsupported;

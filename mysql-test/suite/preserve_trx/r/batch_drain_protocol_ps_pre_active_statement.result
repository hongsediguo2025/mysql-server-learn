DROP TABLE IF EXISTS t_batch_drain_protocol_ps;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_drain_protocol_ps(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_batch_drain_protocol_ps VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_batch_drain_protocol_ps SET b=11 WHERE a=1;
SET DEBUG_SYNC = 'now WAIT_FOR protocol_ps_after_gate TIMEOUT 10';
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_closing_state_before_targets SIGNAL protocol_ps_closing WAIT_FOR continue_protocol_ps_closing';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR protocol_ps_closing TIMEOUT 10';
SET DEBUG_SYNC = 'now SIGNAL continue_protocol_ps';
SET DEBUG_SYNC = 'now SIGNAL continue_protocol_ps_closing';
include/wait_for_pattern_in_file.inc [protocol_ps_writer_done]
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_batch_drain_protocol_ps ORDER BY a;
a	b
1	10
2	21
DROP TABLE t_batch_drain_protocol_ps;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

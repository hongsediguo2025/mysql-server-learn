DROP TABLE IF EXISTS t_single_register_cleanup_observable;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_single_register_cleanup_observable(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_single_register_cleanup_observable VALUES(1,10);
SET SESSION debug="+d,preserve_trx_fail_add_record,preserve_trx_fail_single_detached_rollback";
START TRANSACTION;
UPDATE t_single_register_cleanup_observable SET v=11 WHERE id=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR 70100: Query execution was interrupted
SELECT STATE, LAST_ERROR IS NOT NULL AS has_last_error
FROM performance_schema.preserved_transactions;
STATE	has_last_error
FAILED	1
# restart
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_single_register_cleanup_observable ORDER BY id;
id	v
1	10
DROP TABLE t_single_register_cleanup_observable;
SET GLOBAL preserve_trx_enable=ON;

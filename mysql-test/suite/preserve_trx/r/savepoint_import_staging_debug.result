DROP TABLE IF EXISTS t_savepoint_import;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_savepoint_import(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_savepoint_import VALUES (1, 10);
START TRANSACTION;
UPDATE t_savepoint_import SET v = v + 1 WHERE id = 1;
SAVEPOINT sp1;
UPDATE t_savepoint_import SET v = v + 1 WHERE id = 1;
SAVEPOINT sp2;
UPDATE t_savepoint_import SET v = v + 1 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_savepoint_import_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_savepoint_import_observable';
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-savepoint-import-token';
TOKEN	STATE	LAST_ERROR
debug-savepoint-import-token	FAILED	savepoint import: export_ok=1 valid=1 import_ok=1 count=2 payload_bytes=#
ROLLBACK TO SAVEPOINT sp1;
SELECT v FROM t_savepoint_import WHERE id = 1;
v
11
ROLLBACK;
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear

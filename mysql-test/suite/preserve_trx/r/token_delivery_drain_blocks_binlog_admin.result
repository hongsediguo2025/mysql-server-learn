DROP TABLE IF EXISTS t_preserve_token_binlog_admin;
SET GLOBAL preserve_trx_enable=ON;
SET SESSION sql_log_bin=0;
CREATE TABLE t_preserve_token_binlog_admin(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preserve_token_binlog_admin VALUES(1,10);
SET SESSION sql_log_bin=1;
RESET MASTER;
SET DEBUG_SYNC =
'preserve_trx_finalize_token_delivery SIGNAL token_binlog_admin_pending WAIT_FOR continue_token_binlog_admin';
START TRANSACTION;
UPDATE t_preserve_token_binlog_admin SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR token_binlog_admin_pending TIMEOUT 10';
FLUSH BINARY LOGS;
ERROR HY000: Resumable transactions across shutdown do not support this operation
FLUSH LOGS;
ERROR HY000: Resumable transactions across shutdown do not support this operation
RESET MASTER;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET DEBUG_SYNC = 'now SIGNAL continue_token_binlog_admin';
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_preserve_token_binlog_admin ORDER BY a;
a	b
1	10
SET SESSION sql_log_bin=0;
DROP TABLE t_preserve_token_binlog_admin;
SET SESSION sql_log_bin=1;
RESET MASTER;
SET GLOBAL preserve_trx_enable=ON;

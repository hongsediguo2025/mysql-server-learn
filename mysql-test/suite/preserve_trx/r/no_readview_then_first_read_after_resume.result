DROP TABLE IF EXISTS t_no_readview_then_first_read;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_no_readview_then_first_read(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_no_readview_then_first_read VALUES(1,10),(2,20);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_no_readview_then_first_read SET v=21 WHERE id=2;
DRAIN TRANSACTIONS PRESERVE;
SELECT ISOLATION, HAS_READ_VIEW, RV_LOW_LIMIT_NO
FROM performance_schema.preserved_transactions;
ISOLATION	HAS_READ_VIEW	RV_LOW_LIMIT_NO
REPEATABLE-READ	NO	0
UPDATE t_no_readview_then_first_read SET v=11 WHERE id=1;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT v AS first_read_after_resume
FROM t_no_readview_then_first_read
WHERE id=1;
first_read_after_resume
11
UPDATE t_no_readview_then_first_read SET v=12 WHERE id=1;
SELECT v AS second_read_same_view
FROM t_no_readview_then_first_read
WHERE id=1;
second_read_same_view
11
SELECT v AS own_write_seen
FROM t_no_readview_then_first_read
WHERE id=2;
own_write_seen
21
ROLLBACK;
SELECT * FROM t_no_readview_then_first_read ORDER BY id;
id	v
1	12
2	20
DROP TABLE t_no_readview_then_first_read;
SET GLOBAL preserve_trx_enable=ON;

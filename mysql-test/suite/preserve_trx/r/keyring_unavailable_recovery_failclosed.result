DROP TABLE IF EXISTS t_keyring_unavailable_recovery;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_keyring_unavailable_recovery(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_keyring_unavailable_recovery VALUES(1,10);
START TRANSACTION;
SELECT * FROM t_keyring_unavailable_recovery WHERE a=1 FOR UPDATE;
a	b
1	10
UPDATE t_keyring_unavailable_recovery SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
# restart: --preserve-trx-enable=ON --debug=d,preserve_trx_simulate_encrypted_tablespace_key_unavailable
include/wait_for_pattern_in_file.inc [Preserved transaction .* recovery failed: encrypted tablespace key unavailable]
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions;
TOKEN	STATE	LAST_ERROR
TOKEN	FAILED	encrypted tablespace key unavailable
SELECT COUNT(*) AS resumable_count
FROM performance_schema.preserved_transactions
WHERE STATE = 'PRESERVED';
resumable_count
0
SELECT * FROM t_keyring_unavailable_recovery ORDER BY a;
a	b
1	10
# restart: --preserve-trx-enable=ON
include/wait_for_pattern_in_file.inc [Preserved transaction .* recovery forced rollback: preserved transaction snapshot tainted]
SELECT COUNT(*) AS preserved_count_after_taint_cleanup
FROM performance_schema.preserved_transactions;
preserved_count_after_taint_cleanup
0
SELECT * FROM t_keyring_unavailable_recovery ORDER BY a;
a	b
1	10
DROP TABLE t_keyring_unavailable_recovery;
SET GLOBAL preserve_trx_enable=ON;

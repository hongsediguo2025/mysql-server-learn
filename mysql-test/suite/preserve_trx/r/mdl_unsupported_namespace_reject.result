DROP TABLE IF EXISTS t_mdl_unsupported_namespace;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_mdl_unsupported_namespace(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
LOCK INSTANCE FOR BACKUP;
START TRANSACTION;
INSERT INTO t_mdl_unsupported_namespace VALUES(1,10);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK;
UNLOCK INSTANCE;
DROP TABLE t_mdl_unsupported_namespace;
SET GLOBAL preserve_trx_enable=ON;

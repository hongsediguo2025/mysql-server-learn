DROP TABLE IF EXISTS t_lock_warmcopy_record_page_drift;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_max_dirty_shards=0;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_record_page_drift(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_record_page_drift VALUES
(1,10,REPEAT('a',32)),
(2,20,REPEAT('b',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_record_page_drift
SET v=11, pad=REPEAT('x',32)
WHERE id=1;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_phase1_open SIGNAL lock_wc_page_drift_strict_open WAIT_FOR lock_wc_page_drift_strict_continue';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_page_drift_strict_open TIMEOUT 10';
UPDATE t_lock_warmcopy_record_page_drift
SET v=12, pad=REPEAT('w',32)
WHERE id=2;
SET DEBUG_SYNC = 'now SIGNAL lock_wc_page_drift_strict_continue';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT VARIABLE_NAME, CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS positive
FROM performance_schema.global_status
WHERE VARIABLE_NAME IN (
'Preserve_trx_lock_warmcopy_attempts',
'Preserve_trx_lock_warmcopy_resource_limit',
'Preserve_trx_lock_warmcopy_sealed_invalid',
'Preserve_trx_lock_warmcopy_strict_reject')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	positive
Preserve_trx_lock_warmcopy_attempts	1
Preserve_trx_lock_warmcopy_resource_limit	1
Preserve_trx_lock_warmcopy_sealed_invalid	1
Preserve_trx_lock_warmcopy_strict_reject	1
ROLLBACK;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
START TRANSACTION;
UPDATE t_lock_warmcopy_record_page_drift
SET v=13, pad=REPEAT('m',32)
WHERE id=1;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_phase1_open SIGNAL lock_wc_page_drift_fallback_open WAIT_FOR lock_wc_page_drift_fallback_continue';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR lock_wc_page_drift_fallback_open TIMEOUT 10';
UPDATE t_lock_warmcopy_record_page_drift
SET v=22, pad=REPEAT('y',32)
WHERE id=2;
SET DEBUG_SYNC = 'now SIGNAL lock_wc_page_drift_fallback_continue';
SELECT COUNT(*) AS preserved_count_after_fallback
FROM performance_schema.preserved_transactions;
preserved_count_after_fallback
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_fallback_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_fallback_resume
0
SELECT id, v, pad=REPEAT('y',32) AS pad_ok
FROM t_lock_warmcopy_record_page_drift
WHERE id=2;
id	v	pad_ok
2	22	1
DROP TABLE t_lock_warmcopy_record_page_drift;
SET DEBUG_SYNC = 'RESET';

DROP TABLE IF EXISTS t_batch_blocked;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_blocked(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
SET DEBUG_SYNC =
'preserve_trx_batch_after_one_target_preserved SIGNAL batch_preserve_paused WAIT_FOR continue_batch_preserve';
START TRANSACTION;
INSERT INTO t_batch_blocked VALUES(1,10);
SET DEBUG_SYNC =
'preserve_trx_batch_after_one_target_preserved SIGNAL batch_preserve_paused WAIT_FOR continue_batch_preserve';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR batch_preserve_paused TIMEOUT 1';
SELECT 1;
SET DEBUG_SYNC = 'now SIGNAL continue_batch_preserve';
ERROR HY000: Preserve drain is active; this command was not executed
RESUME PRESERVED TRANSACTION 'TOKEN';
UPDATE t_batch_blocked SET b=11 WHERE a=1;
COMMIT;
SELECT * FROM t_batch_blocked;
a	b
1	11
DROP TABLE t_batch_blocked;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_single_phase_small_cache;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=1048576;
CREATE TABLE t_single_phase_small_cache(
id INT PRIMARY KEY,
payload VARBINARY(256)
) ENGINE=InnoDB;
RESET MASTER;
START TRANSACTION;
INSERT INTO t_single_phase_small_cache VALUES(1, REPEAT('a',128));
UPDATE t_single_phase_small_cache SET payload=REPEAT('b',128) WHERE id=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT id, OCTET_LENGTH(payload) AS payload_len,
payload = REPEAT('b',128) AS payload_ok
FROM t_single_phase_small_cache;
id	payload_len	payload_ok
1	128	1
DROP TABLE t_single_phase_small_cache;

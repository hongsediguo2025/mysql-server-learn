SET GLOBAL preserve_trx_enable=ON;
SET SESSION debug='+d,preserve_trx_debug_resume_acceptance_observable';
RESUME PRESERVED TRANSACTION 'debug-resume-acceptance-token';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_resume_acceptance_observable';
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-resume-acceptance-token';
TOKEN	STATE	LAST_ERROR
debug-resume-acceptance-token	FAILED	resume acceptance: can_accept=1
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-resume-acceptance-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
SET GLOBAL preserve_trx_enable=ON;

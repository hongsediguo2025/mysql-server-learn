DROP TABLE IF EXISTS t_preserve_drain_kill_owner;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_drain_mode=HARD;
CREATE TABLE t_preserve_drain_kill_owner(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preserve_drain_kill_owner VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_preserve_drain_kill_owner SET b=21 WHERE a=2;
SET DEBUG_SYNC =
'preserve_trx_drain_before_kill_active SIGNAL before_drain_kill WAIT_FOR continue_drain_kill';
START TRANSACTION;
UPDATE t_preserve_drain_kill_owner SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR before_drain_kill TIMEOUT 10';
KILL QUERY PRESERVE_ID;
SET DEBUG_SYNC = 'now SIGNAL continue_drain_kill';
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
ROLLBACK;
SELECT * FROM t_preserve_drain_kill_owner WHERE a=2;
a	b
2	21
ROLLBACK;
SELECT * FROM t_preserve_drain_kill_owner ORDER BY a;
a	b
1	10
2	20
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
DROP TABLE t_preserve_drain_kill_owner;
SET GLOBAL preserve_trx_enable=ON;

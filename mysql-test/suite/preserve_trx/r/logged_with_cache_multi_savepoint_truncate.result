DROP TABLE IF EXISTS t_logged_multi_savepoint;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_logged_multi_savepoint(id INT PRIMARY KEY, v INT)
ENGINE=InnoDB;
INSERT INTO t_logged_multi_savepoint VALUES(1,10),(2,20),(3,30),(4,40);
RESET MASTER;
START TRANSACTION;
UPDATE t_logged_multi_savepoint SET v=11 WHERE id=1;
SAVEPOINT s1;
UPDATE t_logged_multi_savepoint SET v=22 WHERE id=2;
SAVEPOINT s2;
UPDATE t_logged_multi_savepoint SET v=33 WHERE id=3;
SAVEPOINT s3;
UPDATE t_logged_multi_savepoint SET v=44 WHERE id=4;
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK TO SAVEPOINT s2;
UPDATE t_logged_multi_savepoint SET v=55 WHERE id=2;
COMMIT;
SELECT * FROM t_logged_multi_savepoint ORDER BY id;
id	v
1	11
2	55
3	30
4	40
include/assert_grep.inc [pre-truncation row id 1 remains in binlog]
include/assert_grep.inc [replacement row id 2 is logged after rollback-to-savepoint]
include/assert_grep.inc [truncated row id 3 is absent from binlog]
include/assert_grep.inc [truncated row id 4 is absent from binlog]
DROP TABLE t_logged_multi_savepoint;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_autoinc_table_lock;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_autoinc_table_lock(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
SET SESSION debug="+d,preserve_trx_keep_autoinc_lock_at_statement_end";
INSERT INTO t_autoinc_table_lock(v) VALUES(10);
DRAIN TRANSACTIONS PRESERVE;
SELECT TOKEN, AUTOINC_LOCK_OWNED
FROM performance_schema.preserved_transactions;
TOKEN	AUTOINC_LOCK_OWNED
TOKEN	YES
SET innodb_lock_wait_timeout=1;
INSERT INTO t_autoinc_table_lock(v) VALUES(99);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
INSERT INTO t_autoinc_table_lock(v) VALUES(20);
SELECT * FROM t_autoinc_table_lock ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_autoinc_table_lock;
SET GLOBAL rds_preserve_trx_enable=ON;

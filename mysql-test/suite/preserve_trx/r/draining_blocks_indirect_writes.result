DROP PROCEDURE IF EXISTS p_preserve_drain_update;
DROP TABLE IF EXISTS t_preserve_drain_indirect;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_preserve_drain_indirect(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_preserve_drain_indirect VALUES(1,10),(2,20),(3,30),(4,40);
CREATE PROCEDURE p_preserve_drain_update()
BEGIN
UPDATE t_preserve_drain_indirect SET b=31 WHERE a=3;
END|
SET DEBUG_SYNC =
'preserve_trx_after_lock_materialization SIGNAL drain_indirect_ready WAIT_FOR continue_drain_indirect';
START TRANSACTION;
UPDATE t_preserve_drain_indirect SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR drain_indirect_ready TIMEOUT 10';
SET @preserve_drain_update_sql =
'UPDATE t_preserve_drain_indirect SET b=21 WHERE a=2';
PREPARE preserve_drain_update_stmt FROM @preserve_drain_update_sql;
EXECUTE preserve_drain_update_stmt;
ERROR HY000: Resumable transactions across shutdown do not support this operation
DEALLOCATE PREPARE preserve_drain_update_stmt;
CALL p_preserve_drain_update();
ERROR HY000: Resumable transactions across shutdown do not support this operation
RESUME PRESERVED TRANSACTION 'missing_drain_token';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION lock_wait_timeout=1;
LOCK TABLES t_preserve_drain_indirect WRITE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT * FROM t_preserve_drain_indirect WHERE a=4 FOR UPDATE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT * FROM t_preserve_drain_indirect WHERE a=4 FOR SHARE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET @preserve_drain_locking_read =
(SELECT b FROM t_preserve_drain_indirect WHERE a=4 FOR UPDATE);
ERROR HY000: Resumable transactions across shutdown do not support this operation
DO (SELECT b FROM t_preserve_drain_indirect WHERE a=4 FOR SHARE);
ERROR HY000: Resumable transactions across shutdown do not support this operation
BEGIN;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SAVEPOINT preserve_drain_sp;
ERROR HY000: Resumable transactions across shutdown do not support this operation
ROLLBACK TO SAVEPOINT preserve_drain_sp;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET autocommit=0;
ERROR HY000: Resumable transactions across shutdown do not support this operation
XA START 'preserve_drain_xa';
ERROR HY000: Resumable transactions across shutdown do not support this operation
FLUSH TABLES WITH READ LOCK;
ERROR HY000: Resumable transactions across shutdown do not support this operation
FLUSH TABLES t_preserve_drain_indirect FOR EXPORT;
ERROR HY000: Resumable transactions across shutdown do not support this operation
LOCK INSTANCE FOR BACKUP;
ERROR HY000: Resumable transactions across shutdown do not support this operation
KILL QUERY PRESERVE_ID;
SET DEBUG_SYNC = 'now SIGNAL continue_drain_indirect';
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
ROLLBACK;
SELECT * FROM t_preserve_drain_indirect ORDER BY a;
a	b
1	10
2	20
3	30
4	40
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
DROP PROCEDURE p_preserve_drain_update;
DROP TABLE t_preserve_drain_indirect;
SET GLOBAL preserve_trx_enable=ON;

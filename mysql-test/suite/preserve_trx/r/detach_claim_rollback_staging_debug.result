DROP TABLE IF EXISTS t_detach_claim_rollback;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_detach_claim_rollback(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_detach_claim_rollback VALUES (1, 10);
START TRANSACTION;
UPDATE t_detach_claim_rollback SET v = 11 WHERE id = 1;
SET SESSION debug='+d,preserve_trx_debug_detach_claim_rollback_observable';
PREPARE SHUTDOWN PRESERVE TRANSACTION;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_debug_detach_claim_rollback_observable';
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-detach-claim-rollback-token';
TOKEN	STATE	LAST_ERROR
debug-detach-claim-rollback-token	FAILED	detach claim rollback: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 rollback_ok=1 fallback_rollback_ok=1
SELECT LAST_ERROR REGEXP
'detach claim rollback: xid_ok=1 prepare_ok=1 detach_ok=1 claim_ok=1 rollback_ok=1 fallback_rollback_ok=1'
       AS detach_claim_rollback_ok
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-detach-claim-rollback-token';
detach_claim_rollback_ok
1
SELECT * FROM t_detach_claim_rollback;
id	v
1	10
SET SESSION debug='+d,preserve_trx_clear_debug_observable_records';
SELECT COUNT(*) AS after_clear
FROM performance_schema.preserved_transactions
WHERE TOKEN='debug-detach-claim-rollback-token';
after_clear
0
SET SESSION debug='-d,preserve_trx_clear_debug_observable_records';
DROP TABLE t_detach_claim_rollback;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_warmcopy_degraded;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
CREATE TABLE t_warmcopy_degraded(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_degraded VALUES(1,10);
START TRANSACTION;
UPDATE t_warmcopy_degraded SET v=11 WHERE id=1;
SET SESSION debug="+d,preserve_trx_warmcopy_fail_after_source_copy";
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_warmcopy_fail_after_source_copy";
SELECT COUNT(*) AS preserved_count_after_drain
FROM performance_schema.preserved_transactions;
preserved_count_after_drain
0
COMMIT;
SELECT COUNT(*) AS preserved_count_after_commit
FROM performance_schema.preserved_transactions;
preserved_count_after_commit
0
SELECT * FROM t_warmcopy_degraded;
id	v
1	11
DROP TABLE t_warmcopy_degraded;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;

DROP TABLE IF EXISTS t_fault_resume_mdl;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_fault_resume_mdl(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_fault_resume_mdl VALUES(1,10);
START TRANSACTION;
UPDATE t_fault_resume_mdl SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
SET SESSION debug="+d,preserve_trx_fail_resume_transfer_mdl";
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_resume_transfer_mdl";
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions;
TOKEN	STATE	LAST_ERROR
TOKEN	PRESERVED	MDL transfer failure
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT * FROM t_fault_resume_mdl ORDER BY a;
a	b
1	10
DROP TABLE t_fault_resume_mdl;
SET GLOBAL preserve_trx_enable=ON;

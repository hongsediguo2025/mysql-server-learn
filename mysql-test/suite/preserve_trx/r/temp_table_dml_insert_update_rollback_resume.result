SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_rollback(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_rollback VALUES(1, 10), (2, 20);
START TRANSACTION;
UPDATE tmp_preserve_rollback SET v = 99 WHERE id = 1;
INSERT INTO tmp_preserve_rollback VALUES(3, 30);
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_preserve_rollback ORDER BY id;
id	v
1	99
2	20
3	30
ROLLBACK;
SELECT * FROM tmp_preserve_rollback ORDER BY id;
id	v
1	10
2	20
DROP TEMPORARY TABLE tmp_preserve_rollback;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

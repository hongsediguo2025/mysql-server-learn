DROP TABLE IF EXISTS t_retired_token_replay;
CALL mtr.add_suppression("Found 1 prepared XA transactions");
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_retired_token_replay(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_retired_token_replay VALUES(1, 10);
START TRANSACTION;
UPDATE t_retired_token_replay SET v=20 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ROLLBACK;
SELECT COUNT(*) AS preserved_after_retire
FROM performance_schema.preserved_transactions;
preserved_after_retire
0
# restart: --preserve-trx-enable=OFF --preserve-trx-off-artifact-policy=IGNORE --skip-log-bin
UPDATE t_retired_token_replay SET v=30 WHERE id=1;
# restart: --preserve-trx-enable=ON --preserve-trx-off-artifact-policy=FAIL_IF_PRESENT --skip-log-bin

DROP TABLE IF EXISTS t_rollback_after_resume;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_rollback_after_resume(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_rollback_after_resume VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_rollback_after_resume SET b=11 WHERE a=1;
INSERT INTO t_rollback_after_resume VALUES(3,30);
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM t_rollback_after_resume ORDER BY a;
a	b
1	11
2	20
3	30
ROLLBACK;
SELECT * FROM t_rollback_after_resume ORDER BY a;
a	b
1	10
2	20
DROP TABLE t_rollback_after_resume;
SET GLOBAL preserve_trx_enable=ON;

DROP TABLE IF EXISTS t_binlog_cache_sidecar_digest;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_binlog_cache_sidecar_digest(
id INT PRIMARY KEY,
payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO t_binlog_cache_sidecar_digest VALUES(1,'a'),(2,'b');
RESET MASTER;
START TRANSACTION;
UPDATE t_binlog_cache_sidecar_digest
SET payload=REPEAT('x', 80)
WHERE id=1;
UPDATE t_binlog_cache_sidecar_digest
SET payload=REPEAT('y', 80)
WHERE id=2;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
corrupted_same_size_binlog_cache_sidecar
1
# restart: --preserve-trx-enable=ON
SELECT COUNT(*) AS preserved_count_after_corrupt_sidecar
FROM performance_schema.preserved_transactions;
preserved_count_after_corrupt_sidecar
0
SELECT id, payload
FROM t_binlog_cache_sidecar_digest
ORDER BY id;
id	payload
1	a
2	b
DROP TABLE t_binlog_cache_sidecar_digest;
SET GLOBAL preserve_trx_enable=ON;

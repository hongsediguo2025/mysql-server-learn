DROP TABLE IF EXISTS t_temp_default_on_base;
SELECT @@global.preserve_trx_temp_table_enable AS temp_table_gate_default;
temp_table_gate_default
1
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_temp_default_on_base(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_temp_default_on_base VALUES(1, 10);
CREATE TEMPORARY TABLE tmp_temp_default_on(
id INT PRIMARY KEY,
v INT,
UNIQUE KEY uq_v(v)
) ENGINE=InnoDB;
INSERT INTO tmp_temp_default_on VALUES(1, 100), (2, 200);
START TRANSACTION;
UPDATE t_temp_default_on_base SET v = 11 WHERE id = 1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT @@global.preserve_trx_temp_table_enable AS temp_table_gate_after_restart;
temp_table_gate_after_restart
1
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_temp_default_on ORDER BY id;
id	v
1	100
2	200
INSERT INTO tmp_temp_default_on VALUES(3, 100);
ERROR 23000: Duplicate entry '100' for key 'tmp_temp_default_on.uq_v'
COMMIT;
SELECT * FROM t_temp_default_on_base ORDER BY id;
id	v
1	11
DROP TEMPORARY TABLE tmp_temp_default_on;
DROP TABLE t_temp_default_on_base;
SET GLOBAL preserve_trx_enable=ON;

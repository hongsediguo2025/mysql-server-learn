SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
LOCK INSTANCE FOR BACKUP;
DRAIN TRANSACTIONS PRESERVE;
ERROR HY000: Resumable transactions across shutdown do not support this operation
UNLOCK INSTANCE;
SELECT COUNT(*) AS preserved_count_after_backup_lock_reject
FROM performance_schema.preserved_transactions;
preserved_count_after_backup_lock_reject
0

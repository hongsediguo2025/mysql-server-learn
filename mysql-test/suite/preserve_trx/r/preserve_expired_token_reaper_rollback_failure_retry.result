DROP TABLE IF EXISTS t_expired_reaper_rollback_failure;
SET GLOBAL preserve_trx_enable=ON;
SET SESSION preserve_trx_min_timeout=1;
SET SESSION preserve_trx_default_timeout=1;
SET SESSION preserve_trx_max_timeout=86400;
CREATE TABLE t_expired_reaper_rollback_failure(a INT PRIMARY KEY, b INT)
ENGINE=InnoDB;
INSERT INTO t_expired_reaper_rollback_failure VALUES(1,10);
START TRANSACTION;
UPDATE t_expired_reaper_rollback_failure SET b=11 WHERE a=1;
DRAIN TRANSACTIONS PRESERVE;
include/wait_for_pattern_in_file.inc [Preserved transaction .* expired-token reaper forced rollback: recovery timeout expired]
SELECT STATE,
LAST_ERROR = 'expired-token reaper rollback failure'
         AS last_error_preserved,
LAST_ERROR_AT IS NOT NULL AS last_error_at_set
FROM performance_schema.preserved_transactions;
STATE	last_error_preserved	last_error_at_set
PRESERVED	1	1
# restart: --preserve-trx-enable=ON --preserve-trx-recovery-grace-seconds=30
include/wait_for_pattern_in_file.inc [Preserved transaction .* expired-token reaper forced rollback: recovery timeout expired]
SELECT COUNT(*) AS preserved_count_after_retry_cleanup
FROM performance_schema.preserved_transactions;
preserved_count_after_retry_cleanup
1
SELECT TOKEN, STATE, LAST_ERROR
FROM performance_schema.preserved_transactions;
TOKEN	STATE	LAST_ERROR
TOKEN	FAILED	recovery timeout expired
SELECT * FROM t_expired_reaper_rollback_failure ORDER BY a;
a	b
1	10
DROP TABLE t_expired_reaper_rollback_failure;
SET GLOBAL preserve_trx_enable=ON;
# restart: --preserve-trx-enable=ON --skip-log-bin

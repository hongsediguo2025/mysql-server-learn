DROP TABLE IF EXISTS t_lock_warmcopy_autoinc;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_autoinc(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
SET SESSION debug="+d,preserve_trx_keep_autoinc_lock_at_statement_end";
INSERT INTO t_lock_warmcopy_autoinc(v) VALUES(10);
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
include/assert_grep.inc [lock warmcopy succeeds for autoinc table lock]
SELECT COUNT(*) AS preserved_count_after_autoinc_warmcopy
FROM performance_schema.preserved_transactions;
preserved_count_after_autoinc_warmcopy
1
SELECT TOKEN, AUTOINC_LOCK_OWNED
FROM performance_schema.preserved_transactions;
TOKEN	AUTOINC_LOCK_OWNED
TOKEN	YES
SET innodb_lock_wait_timeout=1;
INSERT INTO t_lock_warmcopy_autoinc(v) VALUES(99);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
INSERT INTO t_lock_warmcopy_autoinc(v) VALUES(20);
SELECT COUNT(*) AS preserved_count_after_autoinc_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_autoinc_resume
0
SELECT * FROM t_lock_warmcopy_autoinc ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_lock_warmcopy_autoinc;

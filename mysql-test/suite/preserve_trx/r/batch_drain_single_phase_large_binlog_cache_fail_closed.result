DROP TABLE IF EXISTS t_single_phase_large_cache;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_single_phase_max_binlog_cache_bytes=8;
CREATE TABLE t_single_phase_large_cache(
id INT PRIMARY KEY,
payload VARBINARY(1024)
) ENGINE=InnoDB;
RESET MASTER;
START TRANSACTION;
INSERT INTO t_single_phase_large_cache VALUES(1, REPEAT('a',512));
UPDATE t_single_phase_large_cache SET payload=REPEAT('b',512) WHERE id=1;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
COMMIT;
SELECT id, OCTET_LENGTH(payload) AS payload_len,
payload = REPEAT('b',512) AS payload_ok
FROM t_single_phase_large_cache;
id	payload_len	payload_ok
1	512	1
include/assert_grep.inc [single-phase fail-closed transaction remains committable in binlog]
include/assert_grep.inc [single-phase fail-closed transaction row event is committed in binlog]
include/assert_grep.inc [single-phase fail-closed transaction commits with a nonzero Xid event]
DROP TABLE t_single_phase_large_cache;

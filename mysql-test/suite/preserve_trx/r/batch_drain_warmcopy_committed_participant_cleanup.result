DROP TABLE IF EXISTS t_warmcopy_abandon;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=PROMOTION_PREPARE;
CREATE TABLE t_warmcopy_abandon(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_abandon VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_warmcopy_abandon SET v=11 WHERE id=1;
START TRANSACTION;
UPDATE t_warmcopy_abandon SET v=21 WHERE id=2;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_abandon_hwm WAIT_FOR warmcopy_abandon_continue';
DRAIN TRANSACTIONS PRESERVE;
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_abandon_hwm TIMEOUT 10';
COMMIT;
SET DEBUG_SYNC = 'now SIGNAL warmcopy_abandon_continue';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT * FROM t_warmcopy_abandon ORDER BY id;
id	v
1	11
2	21
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
DROP TABLE t_warmcopy_abandon;
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_runtime_profile=BUSINESS_FIRST;
SET DEBUG_SYNC = 'RESET';

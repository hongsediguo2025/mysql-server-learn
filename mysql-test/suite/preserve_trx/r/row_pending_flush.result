DROP TABLE IF EXISTS t_row_pending_flush;
SET GLOBAL rds_preserve_trx_enable=ON;
CREATE TABLE t_row_pending_flush(a INT PRIMARY KEY, b VARCHAR(128)) ENGINE=InnoDB;
INSERT INTO t_row_pending_flush VALUES
(1,'before'), (2,'before'), (3,'before'), (4,'before'), (5,'before'),
(6,'before'), (7,'before'), (8,'before'), (9,'before'), (10,'before');
START TRANSACTION;
UPDATE t_row_pending_flush SET b=CONCAT('after-', a);
DRAIN TRANSACTIONS PRESERVE;
SELECT TOKEN, BINLOG_STATE, WROTE_TO_CACHE, BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE
FROM performance_schema.preserved_transactions;
TOKEN	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE_POSITIVE
TOKEN	LOGGED_WITH_CACHE	YES	1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS rows_after_commit
FROM t_row_pending_flush WHERE b = CONCAT('after-', a);
rows_after_commit
10
include/assert_grep.inc [Pending row update is flushed into exported LOGGED_WITH_CACHE payload]
DROP TABLE t_row_pending_flush;
SET GLOBAL rds_preserve_trx_enable=ON;

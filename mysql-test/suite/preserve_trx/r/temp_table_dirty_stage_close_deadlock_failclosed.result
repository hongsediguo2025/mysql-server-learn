DROP TABLE IF EXISTS t_temp_dirty_close_base;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_temp_dirty_close_base(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_temp_dirty_close_base VALUES(1, 10);
CREATE TEMPORARY TABLE tmp_temp_dirty_close_owner(
id INT PRIMARY KEY,
payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO tmp_temp_dirty_close_owner VALUES(1, 'owner-before-preserve');
CREATE TEMPORARY TABLE tmp_temp_dirty_close_worker(
id INT PRIMARY KEY,
payload VARCHAR(128)
) ENGINE=InnoDB;
INSERT INTO tmp_temp_dirty_close_worker VALUES(1, 'worker-before-close');
START TRANSACTION;
UPDATE t_temp_dirty_close_base SET v = 11 WHERE id = 1;
SET DEBUG_SYNC =
'preserve_temp_stage_admission_close_entered SIGNAL temp_dirty_close_entered WAIT_FOR temp_dirty_close_continue';
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR temp_dirty_close_entered TIMEOUT 10';
INSERT INTO tmp_temp_dirty_close_worker VALUES (2, 'worker-during-close-a'), (3, 'worker-during-close-b'), (4, 'worker-during-close-c'), (5, 'worker-during-close-d');
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*) AS worker_temp_rows FROM tmp_temp_dirty_close_worker;
worker_temp_rows
1
SET DEBUG_SYNC = 'now SIGNAL temp_dirty_close_continue';
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT * FROM tmp_temp_dirty_close_owner ORDER BY id;
id	payload
1	owner-before-preserve
COMMIT;
SELECT * FROM t_temp_dirty_close_base ORDER BY id;
id	v
1	11
DROP TEMPORARY TABLE tmp_temp_dirty_close_owner;
DROP TABLE t_temp_dirty_close_base;
SET GLOBAL preserve_trx_enable=ON;
SET DEBUG_SYNC = 'RESET';

DROP TABLE IF EXISTS t_lock_warmcopy_payload_equivalence;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=OFF;
SET GLOBAL preserve_trx_lock_warmcopy_enable=ON;
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=OFF;
SET GLOBAL preserve_trx_recovery_max_count=10;
CREATE TABLE t_lock_warmcopy_payload_equivalence(
id INT PRIMARY KEY,
v INT,
pad VARBINARY(64)
) ENGINE=InnoDB;
INSERT INTO t_lock_warmcopy_payload_equivalence VALUES(1,10,REPEAT('a',32));
START TRANSACTION;
UPDATE t_lock_warmcopy_payload_equivalence
SET v=11, pad=REPEAT('b',32)
WHERE id=1;
SET SESSION debug='+d,preserve_trx_lock_warmcopy_corrupt_record_payload_for_equivalence_test';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
include/assert_grep.inc [lock warmcopy canonical failure is logged]
SELECT VARIABLE_NAME, CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS positive
FROM performance_schema.global_status
WHERE VARIABLE_NAME IN (
'Preserve_trx_lock_warmcopy_artifact_bytes',
'Preserve_trx_lock_warmcopy_attempts',
'Preserve_trx_lock_warmcopy_canonical_mismatch',
'Preserve_trx_lock_warmcopy_sealed_valid',
'Preserve_trx_lock_warmcopy_strict_reject')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	positive
Preserve_trx_lock_warmcopy_artifact_bytes	1
Preserve_trx_lock_warmcopy_attempts	1
Preserve_trx_lock_warmcopy_canonical_mismatch	1
Preserve_trx_lock_warmcopy_sealed_valid	1
Preserve_trx_lock_warmcopy_strict_reject	1
SET SESSION debug='-d,preserve_trx_lock_warmcopy_corrupt_record_payload_for_equivalence_test';
COMMIT;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT id, v, pad=REPEAT('b',32) AS pad_ok
FROM t_lock_warmcopy_payload_equivalence;
id	v	pad_ok
1	11	1
SET GLOBAL preserve_trx_lock_warmcopy_fallback_to_live_export=ON;
START TRANSACTION;
UPDATE t_lock_warmcopy_payload_equivalence
SET v=12, pad=REPEAT('c',32)
WHERE id=1;
SET SESSION debug='+d,preserve_trx_lock_warmcopy_corrupt_record_payload_for_equivalence_test';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT COUNT(*) AS preserved_count_after_fallback
FROM performance_schema.preserved_transactions;
preserved_count_after_fallback
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT COUNT(*) AS preserved_count_after_fallback_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_fallback_resume
0
SELECT id, v, pad=REPEAT('c',32) AS pad_ok
FROM t_lock_warmcopy_payload_equivalence;
id	v	pad_ok
1	12	1
DROP TABLE t_lock_warmcopy_payload_equivalence;

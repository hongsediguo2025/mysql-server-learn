DROP TABLE IF EXISTS t_record_lock_after_resume;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_record_lock_after_resume(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_record_lock_after_resume VALUES(1,10),(2,20);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_record_lock_after_resume SET v=21 WHERE id=2;
SELECT * FROM t_record_lock_after_resume WHERE id=1 FOR SHARE;
id	v
1	10
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SET innodb_lock_wait_timeout=1;
UPDATE t_record_lock_after_resume SET v=11 WHERE id=1;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
UPDATE t_record_lock_after_resume SET v=11 WHERE id=1;
SELECT * FROM t_record_lock_after_resume ORDER BY id;
id	v
1	11
2	20
DROP TABLE t_record_lock_after_resume;
SET GLOBAL preserve_trx_enable=ON;

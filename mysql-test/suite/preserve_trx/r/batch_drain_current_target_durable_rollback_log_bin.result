DROP TABLE IF EXISTS t_batch_current_durable_rollback_log_bin;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_batch_current_durable_rollback_log_bin(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_batch_current_durable_rollback_log_bin VALUES(1,10),(2,20);
RESET MASTER;
START TRANSACTION;
UPDATE t_batch_current_durable_rollback_log_bin SET v=11 WHERE id=1;
SET SESSION debug="+d,preserve_trx_fail_after_undo_prepared";
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug="-d,preserve_trx_fail_after_undo_prepared";
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT * FROM t_batch_current_durable_rollback_log_bin ORDER BY id;
id	v
1	11
2	20
ROLLBACK;
START TRANSACTION;
UPDATE t_batch_current_durable_rollback_log_bin SET v=22 WHERE id=2;
COMMIT;
SELECT * FROM t_batch_current_durable_rollback_log_bin ORDER BY id;
id	v
1	10
2	22

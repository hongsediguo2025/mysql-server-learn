DROP TABLE IF EXISTS t_temp_image_oversized_base;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1024;
CREATE TABLE t_temp_image_oversized_base(id INT PRIMARY KEY, v INT)
ENGINE=InnoDB;
INSERT INTO t_temp_image_oversized_base VALUES(1,10);
CREATE TEMPORARY TABLE tmp_temp_image_oversized(
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
INSERT INTO tmp_temp_image_oversized VALUES(1,100),(2,200);
START TRANSACTION;
UPDATE t_temp_image_oversized_base SET v=11 WHERE id=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*) AS preserved_count_after_oversized_image
FROM performance_schema.preserved_transactions;
preserved_count_after_oversized_image
0
COMMIT;
SELECT * FROM t_temp_image_oversized_base ORDER BY id;
id	v
1	11
SELECT * FROM tmp_temp_image_oversized ORDER BY id;
id	v
1	100
2	200
DROP TEMPORARY TABLE tmp_temp_image_oversized;
DROP TABLE t_temp_image_oversized_base;
SET GLOBAL preserve_trx_max_temp_sidecar_bytes=1073741824;
SET GLOBAL preserve_trx_temp_table_enable=ON;
SET GLOBAL preserve_trx_enable=ON;

SET GLOBAL rds_preserve_trx_enable=ON;
# restart: --rds-preserve-trx-enable=ON
preserve path is directory symlink
Pattern "rds_preserve_trx_enable=ON requires valid snapshot support" found
# restart: --rds-preserve-trx-enable=ON
preserve path is file
Pattern "rds_preserve_trx_enable=ON requires valid snapshot support" found
# restart: --rds-preserve-trx-enable=ON
preserve dir inaccessible
Pattern "rds_preserve_trx_enable=ON requires valid snapshot support" found
# restart: --rds-preserve-trx-enable=ON
preserve path is dangling symlink
Pattern "rds_preserve_trx_enable=ON requires valid snapshot support" found
# restart: --rds-preserve-trx-enable=ON

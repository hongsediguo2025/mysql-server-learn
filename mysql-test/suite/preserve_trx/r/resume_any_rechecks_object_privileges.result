DROP USER IF EXISTS preserve_resume_any_no_table@localhost;
DROP USER IF EXISTS preserve_resume_any_readonly@localhost;
DROP DATABASE IF EXISTS preserve_resume_any_obj_db;
SET GLOBAL preserve_trx_enable=ON;
CREATE DATABASE preserve_resume_any_obj_db;
USE preserve_resume_any_obj_db;
CREATE TABLE t_resume_any_obj_priv(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_resume_any_obj_priv VALUES(1,10);
CREATE USER preserve_resume_any_no_table@localhost;
GRANT RESUME_ANY_PRESERVED_TRANSACTION ON *.* TO
preserve_resume_any_no_table@localhost;
CREATE USER preserve_resume_any_readonly@localhost;
GRANT RESUME_ANY_PRESERVED_TRANSACTION ON *.* TO
preserve_resume_any_readonly@localhost;
GRANT SELECT ON preserve_resume_any_obj_db.t_resume_any_obj_priv TO
preserve_resume_any_readonly@localhost;
START TRANSACTION;
UPDATE t_resume_any_obj_priv SET b=11 WHERE a=1;
PREPARE SHUTDOWN PRESERVE TRANSACTION WITH TIMEOUT 300;
SELECT TOKEN, USER, HOST, MOD_TABLES_COUNT
FROM performance_schema.preserved_transactions;
TOKEN	USER	HOST	MOD_TABLES_COUNT
TOKEN	root	localhost	1
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Access denied for preserved transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Access denied for preserved transaction
SELECT COUNT(*) AS preserved_after_failed_resume_any
FROM performance_schema.preserved_transactions;
preserved_after_failed_resume_any
1
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_resume_any_obj_priv ORDER BY a;
a	b
1	10
DROP USER preserve_resume_any_no_table@localhost;
DROP USER preserve_resume_any_readonly@localhost;
USE test;
DROP DATABASE preserve_resume_any_obj_db;
SET GLOBAL preserve_trx_enable=ON;

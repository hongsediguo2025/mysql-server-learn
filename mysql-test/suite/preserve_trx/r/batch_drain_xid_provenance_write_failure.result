DROP TABLE IF EXISTS t_xid_provenance_write_failure;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_xid_provenance_write_failure(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_xid_provenance_write_failure VALUES(1, 10), (2, 20);
START TRANSACTION;
UPDATE t_xid_provenance_write_failure SET v=20 WHERE id=1;
START TRANSACTION;
UPDATE t_xid_provenance_write_failure SET v=30 WHERE id=2;
SET SESSION debug='+d,preserve_trx_fail_xid_provenance_write';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_fail_xid_provenance_write';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
SELECT v AS value_in_original_transaction
FROM t_xid_provenance_write_failure WHERE id=1;
value_in_original_transaction
20
COMMIT;
SELECT v AS value_in_second_original_transaction
FROM t_xid_provenance_write_failure WHERE id=2;
value_in_second_original_transaction
30
COMMIT;
SELECT * FROM t_xid_provenance_write_failure ORDER BY id;
id	v
1	20
2	30
START TRANSACTION;
UPDATE t_xid_provenance_write_failure SET v=30 WHERE id=1;
START TRANSACTION;
UPDATE t_xid_provenance_write_failure SET v=40 WHERE id=2;
SET SESSION debug='+d,preserve_trx_fail_xid_provenance_bind';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
ERROR HY000: Resumable transactions across shutdown do not support this operation
SET SESSION debug='-d,preserve_trx_fail_xid_provenance_bind';
SELECT COUNT(*) AS preserved_count_after_bind_failure
FROM performance_schema.preserved_transactions;
preserved_count_after_bind_failure
0
SELECT v AS value_after_bind_failure
FROM t_xid_provenance_write_failure WHERE id=1;
value_after_bind_failure
30
COMMIT;
SELECT v AS second_value_after_bind_failure
FROM t_xid_provenance_write_failure WHERE id=2;
second_value_after_bind_failure
40
COMMIT;
SELECT * FROM t_xid_provenance_write_failure ORDER BY id;
id	v
1	30
2	40
DROP TABLE t_xid_provenance_write_failure;

DROP TABLE IF EXISTS t_savepoint_multilock_autoinc;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_savepoint_multilock_autoinc(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT,
KEY v_idx(v)
) ENGINE=InnoDB;
INSERT INTO t_savepoint_multilock_autoinc(v) VALUES(10),(20);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
UPDATE t_savepoint_multilock_autoinc SET v=11 WHERE id=1;
SAVEPOINT s_record;
SELECT * FROM t_savepoint_multilock_autoinc FORCE INDEX(v_idx)
WHERE v > 11 AND v < 20 FOR UPDATE;
id	v
SAVEPOINT s_gap;
INSERT INTO t_savepoint_multilock_autoinc(v) VALUES(30);
SELECT LAST_INSERT_ID() AS first_generated_id;
first_generated_id
3
SAVEPOINT s_insert;
INSERT INTO t_savepoint_multilock_autoinc(v) VALUES(40);
SELECT LAST_INSERT_ID() AS second_generated_id;
second_generated_id
4
UPDATE t_savepoint_multilock_autoinc SET v=22 WHERE id=2;
DRAIN TRANSACTIONS PRESERVE;
SELECT SAVEPOINT_COUNT, LOCKS_COUNT >= 1 AS has_preserved_locks
FROM performance_schema.preserved_transactions;
SAVEPOINT_COUNT	has_preserved_locks
3	1
SET SESSION innodb_lock_wait_timeout=1;
INSERT INTO t_savepoint_multilock_autoinc(id, v) VALUES(100,15);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SET SESSION lock_wait_timeout=1;
LOCK TABLES t_savepoint_multilock_autoinc WRITE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT LAST_INSERT_ID() AS resumed_last_insert_id;
resumed_last_insert_id
4
ROLLBACK TO SAVEPOINT s_gap;
INSERT INTO t_savepoint_multilock_autoinc(v) VALUES(50);
SELECT LAST_INSERT_ID() AS insert_after_rollback_to;
insert_after_rollback_to
5
COMMIT;
INSERT INTO t_savepoint_multilock_autoinc(id, v) VALUES(100,15);
LOCK TABLES t_savepoint_multilock_autoinc WRITE;
UNLOCK TABLES;
SELECT id, v FROM t_savepoint_multilock_autoinc ORDER BY id;
id	v
1	11
2	20
5	50
100	15
DROP TABLE t_savepoint_multilock_autoinc;
SET GLOBAL preserve_trx_enable=ON;

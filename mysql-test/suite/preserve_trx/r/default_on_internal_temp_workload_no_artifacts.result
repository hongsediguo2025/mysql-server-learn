SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
DROP TABLE IF EXISTS t_preserve_default_on_internal_tmp;
CREATE TABLE t_preserve_default_on_internal_tmp(
id INT PRIMARY KEY,
grp INT NOT NULL,
pad VARCHAR(200) NOT NULL,
KEY(grp)
) ENGINE=InnoDB;
INSERT INTO t_preserve_default_on_internal_tmp
WITH RECURSIVE n(i) AS (
SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 256
)
SELECT i, i % 17, RPAD(CONCAT('payload-', i), 180, 'x') FROM n;
SET SESSION tmp_table_size=16384;
SET SESSION max_heap_table_size=16384;
SELECT COUNT(*) AS grouped_rows
FROM (
SELECT grp, COUNT(*) AS c, SUM(LENGTH(pad)) AS bytes
FROM t_preserve_default_on_internal_tmp
GROUP BY grp
HAVING c > 0
ORDER BY bytes DESC
) AS grouped;
grouped_rows
17
SELECT COUNT(*) AS derived_rows
FROM (
SELECT a.grp, a.id, b.bytes
FROM t_preserve_default_on_internal_tmp AS a
JOIN (
SELECT grp, SUM(LENGTH(pad)) AS bytes
FROM t_preserve_default_on_internal_tmp
GROUP BY grp
) AS b ON b.grp = a.grp
ORDER BY b.bytes DESC, a.id DESC
LIMIT 128
) AS derived;
derived_rows
128
WITH cte AS (
SELECT grp, COUNT(*) AS c
FROM t_preserve_default_on_internal_tmp
GROUP BY grp
)
SELECT SUM(c) AS cte_rows FROM cte;
cte_rows
256
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
0
preserve_artifacts 0
DROP TABLE t_preserve_default_on_internal_tmp;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

DROP TABLE IF EXISTS t_resume_read_only_guard;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_resume_read_only_guard(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_resume_read_only_guard VALUES(1, 10);
START TRANSACTION;
UPDATE t_resume_read_only_guard SET v=20 WHERE id=1;
DRAIN TRANSACTIONS PRESERVE;
SET GLOBAL read_only=ON;
RESUME PRESERVED TRANSACTION 'TOKEN';
ERROR HY000: Resumable transactions across shutdown do not support this operation
SELECT COUNT(*) AS preserved_count_after_read_only
FROM performance_schema.preserved_transactions;
preserved_count_after_read_only
1
SET GLOBAL read_only=OFF;
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_resume_read_only_guard ORDER BY id;
id	v
1	10
DROP TABLE t_resume_read_only_guard;
SET GLOBAL preserve_trx_enable=ON;

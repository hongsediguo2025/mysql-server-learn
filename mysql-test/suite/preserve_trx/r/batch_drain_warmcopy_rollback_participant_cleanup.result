DROP TABLE IF EXISTS t_warmcopy_rollback;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1;
CREATE TABLE t_warmcopy_rollback(id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t_warmcopy_rollback VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_warmcopy_rollback SET v=11 WHERE id=1;
START TRANSACTION;
UPDATE t_warmcopy_rollback SET v=21 WHERE id=2;
SET DEBUG_SYNC =
'preserve_trx_warmcopy_after_descriptor_hwm SIGNAL warmcopy_rollback_hwm WAIT_FOR warmcopy_rollback_continue';
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SET DEBUG_SYNC = 'now WAIT_FOR warmcopy_rollback_hwm TIMEOUT 10';
ROLLBACK;
SET DEBUG_SYNC = 'now SIGNAL warmcopy_rollback_continue';
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
1
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT * FROM t_warmcopy_rollback ORDER BY id;
id	v
1	11
2	20
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
DROP TABLE t_warmcopy_rollback;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_warmcopy_min_open_ms=1000;
SET GLOBAL preserve_trx_warmcopy_enable=ON;
SET DEBUG_SYNC = 'RESET';

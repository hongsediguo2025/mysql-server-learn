DROP TABLE IF EXISTS t_last_insert_id;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_last_insert_id(
id INT AUTO_INCREMENT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t_last_insert_id(v) VALUES(10);
SELECT LAST_INSERT_ID() AS last_insert_id_before_preserve;
last_insert_id_before_preserve
1
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
SELECT LAST_INSERT_ID() AS last_insert_id_after_resume;
last_insert_id_after_resume
1
COMMIT;
SELECT * FROM t_last_insert_id ORDER BY id;
id	v
1	10
DROP TABLE t_last_insert_id;
SET GLOBAL preserve_trx_enable=ON;

SET GLOBAL rds_preserve_trx_enable=ON;
SELECT COUNT(*) AS session_count
FROM t_batch_long_control;
session_count
100
SELECT MIN(TIMESTAMPDIFF(MICROSECOND, started_at, NOW(6))) >= 5000000
AS all_sessions_older_than_five_seconds
FROM t_batch_long_control;
all_sessions_older_than_five_seconds
1
DRAIN TRANSACTIONS PRESERVE WITH USER VARS;
SELECT COUNT(*) AS preserved_count
FROM performance_schema.preserved_transactions;
preserved_count
100
SELECT COUNT(*) AS preserved_state_count
FROM performance_schema.preserved_transactions
WHERE STATE = 'PRESERVED';
preserved_state_count
100
SELECT COUNT(*) AS mapped_token_count
FROM t_batch_long_tokens;
mapped_token_count
100
SELECT COUNT(*) AS preserved_count_after_resume
FROM performance_schema.preserved_transactions;
preserved_count_after_resume
0
SELECT COUNT(*) AS resume_success_count
FROM t_batch_long_audit
WHERE resumed_ok = 1;
resume_success_count
100
SELECT COUNT(DISTINCT sid) AS resumed_distinct_sessions
FROM t_batch_long_audit;
resumed_distinct_sessions
100
SELECT MIN(lifecycle_age_us) >= 5000000 AS all_resumed_lifecycles_were_long
FROM t_batch_long_audit;
all_resumed_lifecycles_were_long
1
SELECT MIN(sql_count) >= 8 AS every_session_ran_enough_sql
FROM t_batch_long_audit;
every_session_ran_enough_sql
1
SELECT MAX(max_stmt_us) < 1000000 AS every_statement_under_one_second
FROM t_batch_long_audit;
every_statement_under_one_second
1
SELECT COUNT(*) AS audit_rows
FROM t_batch_long_audit;
audit_rows
100
SELECT COUNT(*) AS audit_control_case_mismatch_count
FROM t_batch_long_audit a
JOIN t_batch_long_control c USING(sid)
WHERE a.case_id <> c.case_id;
audit_control_case_mismatch_count
0
SELECT COUNT(DISTINCT detail) AS json_cases_ok
FROM t_batch_long_audit WHERE resumed_ok = 1;
json_cases_ok
20
SELECT detail, COUNT(*) = 5 AS ok
FROM t_batch_long_audit GROUP BY detail ORDER BY detail;
detail	ok
generated-range	1
generated-stored-lookup	1
generated-virtual-lookup	1
json-array-append	1
json-contains	1
json-extract-predicate	1
json-insert-path	1
json-noop-set	1
json-null-literal	1
json-remove	1
json-replace	1
json-savepoint-light	1
json-secondary-update	1
json-set-number	1
json-set-string	1
mixed-json-paths	1
nested-object	1
own-write-json-read	1
resume-gc-lookup	1
resume-json-set	1
SELECT COUNT(*) = 0 AS small_json_guard_ok
FROM t_json_base
WHERE JSON_STORAGE_SIZE(doc) > 512;
small_json_guard_ok
1
SELECT 1 AS case_id,
COUNT(*) = 5 AS ok
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 1 AND b.k = 1
AND b.gc_stored = b.sid + 1001
UNION ALL SELECT 2, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 2 AND b.k = 2
AND b.gc_virtual = CONCAT('tag-', b.sid, '-post')
UNION ALL SELECT 3, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 3 AND b.k = 3
AND JSON_CONTAINS_PATH(b.doc, 'all', '$.newPath', '$.newAfter')
UNION ALL SELECT 4, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 4 AND b.k = 4
AND b.gc_virtual = CONCAT('replace-post-', b.sid)
UNION ALL SELECT 5, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 5 AND b.k = 5
AND JSON_CONTAINS_PATH(b.doc, 'one', '$.keep') = 0
AND JSON_CONTAINS_PATH(b.doc, 'one', '$.a.b') = 0
UNION ALL SELECT 6, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 6 AND b.k = 6
AND b.note = 'extract-post'
   AND JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.hit')) = 'hit'
UNION ALL SELECT 7, COUNT(*) = 5
FROM t_json_base b FORCE INDEX(idx_sid_stored)
JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 7 AND b.k = 7
AND b.gc_stored = b.sid + 7001
UNION ALL SELECT 8, COUNT(*) = 5
FROM t_json_base b FORCE INDEX(idx_sid_virtual)
JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 8 AND b.k = 8
AND b.note = 'virtual-lookup-post'
   AND b.gc_virtual = CONCAT('lookup-', b.sid)
UNION ALL SELECT 9, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 9 AND b.k = 9
AND JSON_LENGTH(JSON_EXTRACT(b.doc, '$.arr')) = 3
UNION ALL SELECT 10, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 10 AND b.k = 10
AND JSON_CONTAINS(b.doc, JSON_QUOTE(CONCAT('post-', b.sid)), '$.tags')
UNION ALL SELECT 11, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 11 AND b.k = 11
AND CAST(JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.a.b')) AS SIGNED) =
b.sid * 11
AND CAST(JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.a.c')) AS SIGNED) =
b.sid * 12
UNION ALL SELECT 12, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 12 AND b.k = 12
AND b.note = CONCAT('own-', b.sid + 1200)
UNION ALL SELECT 13, COUNT(*) = 5
FROM t_json_base b FORCE INDEX(idx_sid_stored)
JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 13 AND b.k = 13
AND b.note = 'gc-secondary-post'
   AND b.gc_stored = b.sid + 1300
UNION ALL SELECT 14, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 14 AND b.k = 14
AND b.note = 'noop-post'
   AND b.gc_virtual = 'seed-14'
UNION ALL SELECT 15, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 15 AND b.k = 15
AND JSON_TYPE(JSON_EXTRACT(b.doc, '$.json_null')) = 'NULL'
   AND JSON_EXTRACT(b.doc, '$.sql_absent') IS NULL
UNION ALL SELECT 16, COUNT(*) = 5
FROM t_json_base b FORCE INDEX(idx_sid_stored)
JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 16 AND b.k = 16
AND b.gc_stored BETWEEN b.sid + 16000 AND b.sid + 16002
AND b.gc_stored = b.sid + 16001
UNION ALL SELECT 17, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 17 AND b.k = 17
AND CAST(JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.before_resume')) AS SIGNED) =
b.sid
AND CAST(JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.after_resume')) AS SIGNED) =
b.sid + 17
UNION ALL SELECT 18, COUNT(*) = 5
FROM t_json_base b FORCE INDEX(idx_sid_virtual)
JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 18 AND b.k = 18
AND b.gc_stored = b.sid + 1801
AND b.gc_virtual = CONCAT('gc-pre-', b.sid)
UNION ALL SELECT 19, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
JOIN t_json_side s ON s.sid = b.sid AND s.case_id = 19
WHERE c.case_id = 19 AND b.k = 19
AND s.path_value = CONCAT('lookup-', b.sid, ':', b.sid + 1900)
AND CAST(JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.mixed.from_lookup'))
AS SIGNED) = b.sid
AND CAST(JSON_UNQUOTE(JSON_EXTRACT(b.doc, '$.mixed.post'))
AS SIGNED) = b.sid + 19
UNION ALL SELECT 20, COUNT(*) = 5
FROM t_json_base b JOIN t_batch_long_control c USING(sid)
WHERE c.case_id = 20 AND b.k = 20
AND b.gc_stored = b.sid + 2000
AND b.gc_virtual = CONCAT('savepoint-', b.sid)
ORDER BY case_id;
case_id	ok
1	1
2	1
3	1
4	1
5	1
6	1
7	1
8	1
9	1
10	1
11	1
12	1
13	1
14	1
15	1
16	1
17	1
18	1
19	1
20	1
SET GLOBAL rds_preserve_trx_enable=ON;

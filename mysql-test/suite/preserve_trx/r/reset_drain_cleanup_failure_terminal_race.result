CALL mtr.add_suppression("Attempting backtrace");
CALL mtr.add_suppression("You can use the following information to find out");
CALL mtr.add_suppression("PRESERVE: RESET DRAIN invariant failure");
CALL mtr.add_suppression("Preserved transaction batch cleanup failed after debug injected target error");
CALL mtr.add_suppression("Preserved transaction .* recovery cleanup failed: failed to delete snapshot files");
CALL mtr.add_suppression("Preserved transaction '.*' expired-token reaper forced rollback: recovery timeout expired");
SET GLOBAL rds_preserve_trx_enable=ON;
SET GLOBAL rds_preserve_trx_transfer_prewarm_paused=ON;
SET GLOBAL rds_preserve_trx_token_retention_timeout_ms=1000;
CREATE TABLE reset_terminal_accounts(
id INT PRIMARY KEY,
balance INT NOT NULL,
version INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE reset_terminal_ledger(
id INT AUTO_INCREMENT PRIMARY KEY,
account_id INT NOT NULL,
delta INT NOT NULL
) ENGINE=InnoDB;

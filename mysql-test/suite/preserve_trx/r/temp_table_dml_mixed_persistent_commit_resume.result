SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;
CREATE TEMPORARY TABLE tmp_preserve_mixed(
id INT PRIMARY KEY,
v INT NOT NULL,
KEY(v)
) ENGINE=InnoDB;
CREATE TABLE t_preserve_mixed(
id INT PRIMARY KEY,
v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO tmp_preserve_mixed VALUES(1, 10);
START TRANSACTION;
UPDATE tmp_preserve_mixed SET v = 11 WHERE id = 1;
INSERT INTO t_preserve_mixed VALUES(1, 100);
DRAIN TRANSACTIONS PRESERVE;
RESUME PRESERVED TRANSACTION 'TOKEN';
UPDATE t_preserve_mixed SET v = 101 WHERE id = 1;
INSERT INTO t_preserve_mixed VALUES(2, 200);
COMMIT;
SELECT * FROM tmp_preserve_mixed ORDER BY id;
id	v
1	11
SELECT * FROM t_preserve_mixed ORDER BY id;
id	v
1	101
2	200
DROP TABLE t_preserve_mixed;
DROP TEMPORARY TABLE tmp_preserve_mixed;
SET GLOBAL preserve_trx_enable=ON;
SET GLOBAL preserve_trx_temp_table_enable=ON;

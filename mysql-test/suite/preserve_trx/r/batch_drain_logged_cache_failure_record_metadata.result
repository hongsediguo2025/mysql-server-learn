BINLOG_CACHE_SIZE > 0 AS BINLOG_CACHE_SIZE_POSITIVE,
SESSION_SQL_LOG_BIN, GLOBAL_LOG_BIN
FROM performance_schema.preserved_transactions;
TOKEN	BINLOG_STATE	WROTE_TO_CACHE	BINLOG_CACHE_SIZE_POSITIVE	SESSION_SQL_LOG_BIN	GLOBAL_LOG_BIN
TOKEN	LOGGED_WITH_CACHE	YES	1	ON	ON
SELECT 1;
ERROR HY000: This session's transaction has been preserved by DRAIN TRANSACTIONS PRESERVE
RESUME PRESERVED TRANSACTION 'TOKEN';
COMMIT;
SELECT * FROM t_batch_logged_cache_failure_record ORDER BY id;
id	v

DROP TABLE IF EXISTS t_p_s_locks_count_table_lock;
SET GLOBAL preserve_trx_enable=ON;
CREATE TABLE t_p_s_locks_count_table_lock(
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO t_p_s_locks_count_table_lock VALUES(1,10),(2,20);
START TRANSACTION;
UPDATE t_p_s_locks_count_table_lock SET v=21 WHERE id=2;
DRAIN TRANSACTIONS PRESERVE WITH TIMEOUT 300;
SELECT LOCKS_COUNT >= 2 AS locks_count_includes_table_payload
FROM performance_schema.preserved_transactions;
locks_count_includes_table_payload
1
SELECT COUNT(*) > 0 AS recovered_ix_table_locks
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
    AND OBJECT_NAME='t_p_s_locks_count_table_lock'
    AND LOCK_TYPE='TABLE'
    AND LOCK_MODE='IX'
    AND LOCK_STATUS='GRANTED';
recovered_ix_table_locks
1
RESUME PRESERVED TRANSACTION 'TOKEN';
ROLLBACK;
SELECT * FROM t_p_s_locks_count_table_lock ORDER BY id;
id	v
1	10
2	20
DROP TABLE t_p_s_locks_count_table_lock;
SET GLOBAL preserve_trx_enable=ON;

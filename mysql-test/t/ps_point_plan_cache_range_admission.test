--echo #
--echo # Phase 7 test: ps_point_plan_cache simple_ranges admission
--echo # Verifies COLD -> HOT transitions for PK BETWEEN predicates and
--echo # rejection/recovery behavior for non-target range shapes.
--echo #

--echo # -------------------------------------------------------
--echo # Setup
--echo # -------------------------------------------------------

CREATE TABLE t_range_adm (
  id INT PRIMARY KEY,
  uk INT NOT NULL,
  k INT NOT NULL,
  c VARCHAR(64),
  UNIQUE KEY idx_uk (uk),
  KEY idx_k (k)
);
INSERT INTO t_range_adm VALUES
  (1, 101, 11, 'alpha'),
  (2, 102, 22, 'beta'),
  (3, 103, 33, 'gamma'),
  (4, 104, 44, 'delta');

CREATE TABLE t_range_comp (
  pk1 INT NOT NULL,
  pk2 INT NOT NULL,
  val VARCHAR(32),
  PRIMARY KEY (pk1, pk2)
);
INSERT INTO t_range_comp VALUES
  (1, 10, 'a'),
  (2, 20, 'b'),
  (3, 30, 'c');

FLUSH STATUS;

--echo # -------------------------------------------------------
--echo # 1. PK BETWEEN — admission SUCCESS
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra1 FROM 'SELECT * FROM t_range_adm WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = 3;
EXECUTE stmt_ra1 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after PK BETWEEN first execute: $adm_delta

--echo # Second execute should not re-admit
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
SET @l = 2;
SET @h = 4;
EXECUTE stmt_ra1 USING @l, @h;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo admissions delta after PK BETWEEN second execute: $adm_delta2
DEALLOCATE PREPARE stmt_ra1;

--echo # -------------------------------------------------------
--echo # 2. Valid empty PK range — admission SUCCESS
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra2 FROM 'SELECT * FROM t_range_adm WHERE id BETWEEN ? AND ?';
SET @l = 90;
SET @h = 99;
EXECUTE stmt_ra2 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after empty PK range execute: $adm_delta
DEALLOCATE PREPARE stmt_ra2;

--echo # -------------------------------------------------------
--echo # 3. Non-unique secondary range — admission FAILURE
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra3 FROM 'SELECT * FROM t_range_adm WHERE k BETWEEN ? AND ?';
SET @l = 10;
SET @h = 40;
EXECUTE stmt_ra3 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after secondary range execute: $adm_delta
DEALLOCATE PREPARE stmt_ra3;

--echo # -------------------------------------------------------
--echo # 4. Unique but non-PK range — admission FAILURE
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra4 FROM 'SELECT * FROM t_range_adm WHERE uk BETWEEN ? AND ?';
SET @l = 101;
SET @h = 104;
EXECUTE stmt_ra4 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after unique non-PK range execute: $adm_delta
DEALLOCATE PREPARE stmt_ra4;

--echo # -------------------------------------------------------
--echo # 5. Composite PK prefix range — admission FAILURE
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra5 FROM 'SELECT * FROM t_range_comp WHERE pk1 BETWEEN ? AND ?';
SET @l = 1;
SET @h = 3;
EXECUTE stmt_ra5 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after composite PK prefix range execute: $adm_delta
DEALLOCATE PREPARE stmt_ra5;

--echo # -------------------------------------------------------
--echo # 6. NULL low bound on first execute — no admission, stays COLD
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra6 FROM 'SELECT * FROM t_range_adm WHERE id BETWEEN ? AND ?';
SET @l = NULL;
SET @h = 3;
EXECUTE stmt_ra6 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after NULL low bound: $adm_delta

--echo # Recovery execute with valid bounds should now admit
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
SET @l = 1;
SET @h = 2;
EXECUTE stmt_ra6 USING @l, @h;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo admissions delta after NULL low recovery: $adm_delta2
DEALLOCATE PREPARE stmt_ra6;

--echo # -------------------------------------------------------
--echo # 7. NULL high bound on first execute — no admission, stays COLD
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra7 FROM 'SELECT * FROM t_range_adm WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = NULL;
EXECUTE stmt_ra7 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after NULL high bound: $adm_delta

--echo # Recovery execute with valid bounds should now admit
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
SET @l = 2;
SET @h = 4;
EXECUTE stmt_ra7 USING @l, @h;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo admissions delta after NULL high recovery: $adm_delta2
DEALLOCATE PREPARE stmt_ra7;

--echo # -------------------------------------------------------
--echo # 8. low > high on first execute — no admission, stays COLD
--echo # -------------------------------------------------------
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_ra8 FROM 'SELECT * FROM t_range_adm WHERE id BETWEEN ? AND ?';
SET @l = 4;
SET @h = 2;
EXECUTE stmt_ra8 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after inverted bounds: $adm_delta

--echo # Recovery execute with valid bounds should now admit
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
SET @l = 1;
SET @h = 4;
EXECUTE stmt_ra8 USING @l, @h;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo admissions delta after inverted bounds recovery: $adm_delta2
DEALLOCATE PREPARE stmt_ra8;

--echo # -------------------------------------------------------
--echo # 9. Final counter summary
--echo # -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';

--echo # -------------------------------------------------------
--echo # Cleanup
--echo # -------------------------------------------------------
DROP TABLE t_range_comp;
DROP TABLE t_range_adm;

--echo #
--echo # End of Phase 7 range admission test
--echo #

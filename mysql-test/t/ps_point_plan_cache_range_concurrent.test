--echo #
--echo # Phase 7 test: ps_point_plan_cache simple_ranges concurrent PS
--echo # Verifies that multiple range PS can coexist with independent
--echo # arena caches, and that fallback on one doesn't affect others.
--echo #
--echo # Run: mtr --ps-protocol ps_point_plan_cache_range_concurrent
--echo #

--echo # -------------------------------------------------------
--echo # Setup
--echo # -------------------------------------------------------

CREATE TABLE t_range_conc1 (
  id INT PRIMARY KEY,
  c1 VARCHAR(32)
);
INSERT INTO t_range_conc1 VALUES
  (1, 'a1'), (2, 'b1'), (3, 'c1'), (4, 'd1'),
  (10, 'e1'), (20, 'f1'), (30, 'g1'), (40, 'h1');

CREATE TABLE t_range_conc2 (
  id INT PRIMARY KEY,
  c2 VARCHAR(32)
);
INSERT INTO t_range_conc2 VALUES
  (1, 'a2'), (2, 'b2'), (3, 'c2'), (4, 'd2'),
  (10, 'e2'), (20, 'f2'), (30, 'g2'), (40, 'h2');

CREATE TABLE t_range_conc3 (
  id INT PRIMARY KEY,
  c3 VARCHAR(32)
);
INSERT INTO t_range_conc3 VALUES
  (1, 'a3'), (2, 'b3'), (3, 'c3'), (4, 'd3'),
  (10, 'e3'), (20, 'f3'), (30, 'g3'), (40, 'h3');

FLUSH STATUS;

--echo # =======================================================
--echo # Test 1: Three concurrent PS with independent arena caches
--echo # =======================================================

--echo # 1.1. Prepare all three statements
--let $cold_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
PREPARE stmt_conc1 FROM 'SELECT c1 FROM t_range_conc1 WHERE id BETWEEN ? AND ?';
PREPARE stmt_conc2 FROM 'SELECT c2 FROM t_range_conc2 WHERE id BETWEEN ? AND ?';
PREPARE stmt_conc3 FROM 'SELECT c3 FROM t_range_conc3 WHERE id BETWEEN ? AND ?';
--let $cold_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $cold_delta = `SELECT $cold_after - $cold_before`
--echo cold_delta after 3 PREPAREs: $cold_delta
--echo Expected: 3 (all COLD)

--echo # 1.2. Admit all three
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
SET @l = 1;
SET @h = 3;
EXECUTE stmt_conc1 USING @l, @h;

SET @l = 1;
SET @h = 3;
EXECUTE stmt_conc2 USING @l, @h;

SET @l = 1;
SET @h = 3;
EXECUTE stmt_conc3 USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta after all admit: $adm_delta
--echo Expected: 3

--echo # 1.3. Hot execute all three
--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @l = 2;
SET @h = 4;
EXECUTE stmt_conc1 USING @l, @h;

SET @l = 5;
SET @h = 7;
EXECUTE stmt_conc2 USING @l, @h;

SET @l = 10;
SET @h = 20;
EXECUTE stmt_conc3 USING @l, @h;
--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits_after - $hits_before`
--echo hits delta after all hot executes: $hits_delta
--echo Expected: 3

DEALLOCATE PREPARE stmt_conc1;
DEALLOCATE PREPARE stmt_conc2;
DEALLOCATE PREPARE stmt_conc3;

--echo # =======================================================
--echo # Test 2: Fallback on one PS doesn't affect others
--echo # =======================================================

FLUSH STATUS;

--echo # 2.1. Prepare and admit two statements
PREPARE stmt_fallback1 FROM 'SELECT c1 FROM t_range_conc1 WHERE id BETWEEN ? AND ?';
PREPARE stmt_fallback2 FROM 'SELECT c2 FROM t_range_conc2 WHERE id BETWEEN ? AND ?';

SET @l = 1;
SET @h = 4;
EXECUTE stmt_fallback1 USING @l, @h;

SET @l = 1;
SET @h = 4;
EXECUTE stmt_fallback2 USING @l, @h;

--echo # 2.2. Trigger fallback on stmt_fallback1 (NULL param)
--let $fb_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

SET @l = NULL;
SET @h = 2;
EXECUTE stmt_fallback1 USING @l, @h;

--let $fb_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--let $fb_delta = `SELECT $fb_after - $fb_before`
--echo fallback_runtime delta (stmt_fallback1): $fb_delta

--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits_after - $hits_before`
--echo hits delta (stmt_fallback1 with NULL): $hits_delta
--echo Expected: 0 (fallback occurred)

--echo # 2.3. stmt_fallback2 should still work normally
--let $hits_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @l = 2;
SET @h = 5;
EXECUTE stmt_fallback2 USING @l, @h;
--let $hits_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta2 = `SELECT $hits_after2 - $hits_before2`
--echo hits delta (stmt_fallback2 unaffected): $hits_delta2
--echo Expected: 1 (other PS unaffected)

--echo # 2.4. Recover stmt_fallback1 with valid params
SET @l = 1;
SET @h = 3;
EXECUTE stmt_fallback1 USING @l, @h;
--let $hits_after3 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta3 = `SELECT $hits_after3 - $hits_after2`
--echo hits delta (stmt_fallback1 recovered): $hits_delta3
--echo Expected: 1 (recovered to HOT)

DEALLOCATE PREPARE stmt_fallback1;
DEALLOCATE PREPARE stmt_fallback2;

--echo # =======================================================
--echo # Test 3: DEALLOCATE one PS doesn't affect others
--echo # =======================================================

FLUSH STATUS;

--echo # 3.1. Prepare and admit two statements
PREPARE stmt_dealloc1 FROM 'SELECT c1 FROM t_range_conc1 WHERE id BETWEEN ? AND ?';
PREPARE stmt_dealloc2 FROM 'SELECT c2 FROM t_range_conc2 WHERE id BETWEEN ? AND ?';

SET @l = 1;
SET @h = 3;
EXECUTE stmt_dealloc1 USING @l, @h;

SET @l = 1;
SET @h = 3;
EXECUTE stmt_dealloc2 USING @l, @h;

--echo # 3.2. DEALLOCATE stmt_dealloc1
DEALLOCATE PREPARE stmt_dealloc1;

--echo # 3.3. stmt_dealloc2 should still work
--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @l = 2;
SET @h = 4;
EXECUTE stmt_dealloc2 USING @l, @h;
--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits_after - $hits_before`
--echo hits delta (after DEALLOCATE of other PS): $hits_delta
--echo Expected: 1 (independent arena caches)

DEALLOCATE PREPARE stmt_dealloc2;

--echo # =======================================================
--echo # Test 4: Arena cache independence - re-prepare same query
--echo # =======================================================

FLUSH STATUS;

--echo # 4.1. Prepare and admit
PREPARE stmt_reprepare FROM 'SELECT c1 FROM t_range_conc1 WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = 3;
EXECUTE stmt_reprepare USING @l, @h;

--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @l = 2;
SET @h = 4;
EXECUTE stmt_reprepare USING @l, @h;
--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits_after - $hits_before`
--echo hits delta (first arena): $hits_delta
DEALLOCATE PREPARE stmt_reprepare;

--echo # 4.2. Prepare again (new arena cache)
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_reprepare FROM 'SELECT c1 FROM t_range_conc1 WHERE id BETWEEN ? AND ?';
SET @l = 5;
SET @h = 8;
EXECUTE stmt_reprepare USING @l, @h;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo admissions delta (re-prepare): $adm_delta

--let $hits_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @l = 6;
SET @h = 7;
EXECUTE stmt_reprepare USING @l, @h;
--let $hits_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta2 = `SELECT $hits_after2 - $hits_before2`
--echo hits delta (new arena cache): $hits_delta2
DEALLOCATE PREPARE stmt_reprepare;

--echo # -------------------------------------------------------
--echo # Final counter summary
--echo # -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';

--echo # -------------------------------------------------------
--echo # Cleanup
--echo # -------------------------------------------------------
DROP TABLE t_range_conc1;
DROP TABLE t_range_conc2;
DROP TABLE t_range_conc3;

--echo #
--echo # End of Phase 7 range concurrent PS test
--echo #

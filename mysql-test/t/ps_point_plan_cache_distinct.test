# -----------------------------------------------------------------------
# Test B8: DISTINCT with window function — rejected by Gate 4
# -----------------------------------------------------------------------
--echo # === Test B8: DISTINCT + window function should not be classified ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT c, ROW_NUMBER() OVER () AS rn FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0): $delta

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B9: DISTINCT on PK column — classify COLD but admission fails
#   PK is unique, so DISTINCT is redundant. Optimizer skips Filesort
#   (PK provides order). Root AccessPath is INDEX_RANGE_SCAN, not SORT.
#   can_admit expects SORT root → fails → NEVER.
# -----------------------------------------------------------------------
--echo # === Test B9: DISTINCT on PK column (admission failure) ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT id FROM t1 WHERE id BETWEEN ? AND ? ORDER BY id';
--echo # PREPARE: classify passes all gates → COLD
--let $classifications = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--echo Cold classifications after PREPARE (should be 1): $classifications

--echo # 1st execute: can_admit fails (no SORT root, PK provides order) → NEVER
EXECUTE stmt USING @lo, @hi;
--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions (should be 0): $admissions

--echo # 2nd execute: state=NEVER, normal optimizer path
EXECUTE stmt USING @lo, @hi;
--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits (should be 0): $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B10: Multi-table JOIN + DISTINCT — rejected by Gate 3
# -----------------------------------------------------------------------
--echo # === Test B10: Multi-table JOIN + DISTINCT ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT ''
);
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  val INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');
INSERT INTO t2 VALUES (1, 10), (2, 20), (3, 30);

FLUSH STATUS;
SET @lo = 1, @hi = 3;

PREPARE stmt FROM 'SELECT DISTINCT t1.c FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.id BETWEEN ? AND ? ORDER BY t1.c';
EXECUTE stmt USING @lo, @hi;
--let $classifications = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--echo Classifications for JOIN query (should be 0): $classifications

DEALLOCATE PREPARE stmt;
DROP TABLE t2;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B11: Subquery in WHERE + DISTINCT — rejected by Gate 3
# -----------------------------------------------------------------------
--echo # === Test B11: Subquery in WHERE + DISTINCT ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'), (5, 'b');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? AND c IN (SELECT c FROM t1) ORDER BY c';
EXECUTE stmt USING @lo, @hi;
--let $classifications = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--echo Classifications for subquery (should be 0): $classifications

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B12: DISTINCT col ≠ ORDER BY col — Gate 4e rejection
#   Disable ONLY_FULL_GROUP_BY so MySQL accepts the SQL,
#   then verify plan cache rejects via validate_simple_distinct.
# -----------------------------------------------------------------------
--echo # === Test B12: DISTINCT col != ORDER BY col (Gate 4e) ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT '',
  k INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20), (3, 'a', 30);

SET @saved_sql_mode = @@session.sql_mode;
SET SESSION sql_mode = '';

FLUSH STATUS;
SET @lo = 1, @hi = 3;

--echo # DISTINCT k ORDER BY c — SQL is valid without ONLY_FULL_GROUP_BY
PREPARE stmt FROM 'SELECT DISTINCT k FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
--let $classifications = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--echo Classifications (should be 0 — NEVER via Gate 4e): $classifications

DEALLOCATE PREPARE stmt;
SET SESSION sql_mode = @saved_sql_mode;
DROP TABLE t1;

# ========================================================================
# Section C: Runtime exception / fallback scenarios
# ========================================================================

# -----------------------------------------------------------------------
# Test C1: NULL parameter — runtime fallback
# -----------------------------------------------------------------------
--echo # === Test C1: NULL parameter fallback ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'), (5, 'b');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo # Execute with NULL low parameter — should fallback
SET @lo = NULL;
EXECUTE stmt USING @lo, @hi;

--let $fallback = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo Runtime fallbacks after NULL param: $fallback

--echo # Execute with valid params again — should still HIT (template stays HOT)
SET @lo = 1;
EXECUTE stmt USING @lo, @hi;

--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $new_hits = `SELECT $hits_after - $hits_before`
--echo New hits after recovery from NULL: $new_hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test C2: Inverted range (low > high) — runtime fallback
# -----------------------------------------------------------------------
--echo # === Test C2: Inverted range fallback ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');

FLUSH STATUS;
SET @lo = 1, @hi = 3;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--echo # Execute with low > high — should return empty set (fallback)
SET @lo = 10, @hi = 1;
EXECUTE stmt USING @lo, @hi;

--echo # Recover with valid range
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Total hits: $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test C3: Parameter type drift — demotion to COLD
# -----------------------------------------------------------------------
--echo # === Test C3: Parameter type drift ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');

FLUSH STATUS;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Execute with INT parameters
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits with INT params: $hits1

--echo # Execute with DECIMAL parameters — type drift
SET @lo = 1.0, @hi = 3.0;
EXECUTE stmt USING @lo, @hi;

--echo # Execute again — should re-admit after demotion
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test C4: sysvar disabled at runtime
# -----------------------------------------------------------------------
--echo # === Test C4: Runtime sysvar disable/enable ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');

SET SESSION ps_point_plan_cache = TRUE;
FLUSH STATUS;
SET @lo = 1, @hi = 3;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits with sysvar ON: $hit1

--echo # Disable sysvar — should fallback
SET SESSION ps_point_plan_cache = FALSE;
EXECUTE stmt USING @lo, @hi;

--echo # Re-enable — should resume hitting
SET SESSION ps_point_plan_cache = TRUE;
EXECUTE stmt USING @lo, @hi;
--let $hit2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits after re-enable: $hit2

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test C5: NULL high parameter — runtime fallback
# -----------------------------------------------------------------------
--echo # === Test C5: NULL high parameter fallback ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');

FLUSH STATUS;
SET @lo = 1, @hi = 3;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo # Execute with NULL high parameter — should fallback
SET @hi = NULL;
EXECUTE stmt USING @lo, @hi;
--let $fallback = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo Runtime fallbacks after NULL high: $fallback

--echo # Both parameters NULL — should also fallback
SET @lo = NULL;
EXECUTE stmt USING @lo, @hi;
--let $fallback2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo Runtime fallbacks after both NULL: $fallback2

--echo # Recover with valid parameters
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;
--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $new_hits = `SELECT $hits_after - $hits_before`
--echo Hits after recovery: $new_hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# ========================================================================
# Section D: DDL invalidation scenarios
# ========================================================================

# -----------------------------------------------------------------------
# Test D1: ALTER COLUMN type change — G13 hard invalidation
# -----------------------------------------------------------------------
--echo # === Test D1: ALTER COLUMN type change invalidation ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'), (5, 'b');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits before ALTER: $hit1

--echo # Change column type from VARCHAR(50) to TEXT
ALTER TABLE t1 MODIFY c TEXT NOT NULL;

--echo # Execute after ALTER — should trigger invalidation
EXECUTE stmt USING @lo, @hi;
--let $invalidations = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--echo Invalidations after type change: $invalidations

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test D2: ALTER collation change — G13 hard invalidation
# -----------------------------------------------------------------------
--echo # === Test D2: ALTER collation change invalidation ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'), (5, 'b');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits before collation change: $hit1

--echo # Change collation — affects sort/dedup semantics
ALTER TABLE t1 MODIFY c VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '';

--echo # Execute after collation change — should invalidate
EXECUTE stmt USING @lo, @hi;
--let $invalidations = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--echo Invalidations after collation change: $invalidations

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test D3: DROP COLUMN — reprepare error
# -----------------------------------------------------------------------
--echo # === Test D3: DROP COLUMN invalidation ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50) NOT NULL DEFAULT '',
  extra INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a', 1), (2, 'b', 2), (3, 'a', 3);

FLUSH STATUS;
SET @lo = 1, @hi = 3;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--echo # Drop the DISTINCT/ORDER BY column
ALTER TABLE t1 DROP COLUMN c;

--echo # Execute after DROP COLUMN — should error
--error ER_BAD_FIELD_ERROR
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;


EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test F5: sysbench-exact schema — distinct_ranges query pattern
#   Uses the exact sbtest1 schema from sysbench oltp_read_only.
# -----------------------------------------------------------------------
--echo # === Test F5: sysbench-exact schema ===
CREATE TABLE sbtest1 (
  id INT NOT NULL AUTO_INCREMENT,
  k INT NOT NULL DEFAULT 0,
  c CHAR(120) NOT NULL DEFAULT '',
  pad CHAR(60) NOT NULL DEFAULT '',
  PRIMARY KEY (id),
  KEY k_1 (k)
) ENGINE=InnoDB;

--disable_query_log
--let $i = 1
while ($i <= 100) {
  --eval INSERT INTO sbtest1 (k, c, pad) VALUES ($i, CONCAT('val-', $i % 15), CONCAT('pad-', $i))
  --inc $i
}
--enable_query_log

--echo # Expected result from normal optimizer
SET SESSION ps_point_plan_cache = FALSE;
SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN 1 AND 100 ORDER BY c;
SET SESSION ps_point_plan_cache = TRUE;

FLUSH STATUS;
SET @lo = 1, @hi = 100;

--echo # sysbench distinct_ranges: SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c
PREPARE stmt FROM 'SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;

--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions: $admissions

--echo # Second execute — cache HIT, verify result matches expected
EXECUTE stmt USING @lo, @hi;
--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $hits

--echo # Different range
SET @lo = 20, @hi = 60;
EXECUTE stmt USING @lo, @hi;

--echo # DESC variant
PREPARE stmt_desc FROM 'SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c DESC';
SET @lo = 1, @hi = 50;
EXECUTE stmt_desc USING @lo, @hi;
EXECUTE stmt_desc USING @lo, @hi;

--let $hits2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Total hits (both stmts): $hits2

--echo # Verify row count <= 15 (c = 'val-' || i%15, at most 15 distinct)
--let $cnt = `SELECT COUNT(*) FROM (SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN 1 AND 100 ORDER BY c) AS sub`
--echo Distinct c count: $cnt

DEALLOCATE PREPARE stmt;
DEALLOCATE PREPARE stmt_desc;
DROP TABLE sbtest1;

# ========================================================================
# Final summary
# ========================================================================
--echo # === Final Status Summary ===
SHOW STATUS LIKE 'Ps_point_plan_cache%';

SET SESSION ps_point_plan_cache = DEFAULT;

--echo # === End of Phase 10 DISTINCT test suite ===

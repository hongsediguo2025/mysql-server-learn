DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B6: DISTINCT on expression — rejected by Gate 4d (ORDER BY expression fails)
# -----------------------------------------------------------------------
--echo # === Test B6: DISTINCT on expression should be NEVER ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  k INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 10);

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT k+1 FROM t1 WHERE id BETWEEN ? AND ? ORDER BY k+1';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0): $delta


PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with single row: $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E2: All rows have same value — DISTINCT reduces to 1 row
# -----------------------------------------------------------------------
--echo # === Test E2: All duplicate values ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'same'), (2, 'same'), (3, 'same'), (4, 'same'), (5, 'same');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Should return exactly 1 row
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with all duplicates: $hits

EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E3: Empty result set (range beyond data)
# -----------------------------------------------------------------------
--echo # === Test E3: Empty result set ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');

FLUSH STATUS;
SET @lo = 100, @hi = 200;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Empty result — should still work
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--echo # Now with valid range
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E4: Large dataset with many duplicates
# -----------------------------------------------------------------------
--echo # === Test E4: Large dataset with duplicates ===
CREATE TABLE t1 (
  id INT PRIMARY KEY AUTO_INCREMENT,
  c CHAR(120) NOT NULL DEFAULT ''
);

--disable_query_log
--let $i = 1
while ($i <= 200) {
  --eval INSERT INTO t1 (c) VALUES (CONCAT('val-', $i % 20))
  --inc $i
}
--enable_query_log

FLUSH STATUS;
SET @lo = 1, @hi = 200;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # First execute — admit
EXECUTE stmt USING @lo, @hi;

--echo # Second execute — HIT
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with large dataset: $hits

--echo # Verify at most 20 distinct values
--let $row_count = `SELECT COUNT(*) FROM (SELECT DISTINCT c FROM t1 WHERE id BETWEEN 1 AND 200 ORDER BY c) AS sub`
--echo Distinct value count: $row_count

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E5: DISTINCT with unsigned INT column at boundary values
# -----------------------------------------------------------------------
--echo # === Test E5: Unsigned boundary values ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val INT UNSIGNED NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 0), (2, 4294967295), (3, 0), (4, 2147483648), (5, 4294967295);

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT val FROM t1 WHERE id BETWEEN ? AND ? ORDER BY val';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with unsigned boundaries: $hits

--echo # Should have 3 distinct values: 0, 2147483648, 4294967295
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E6: Re-PREPARE after DEALLOCATE — fresh lifecycle
# -----------------------------------------------------------------------
--echo # === Test E6: DEALLOCATE and re-PREPARE ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a');

FLUSH STATUS;
SET @lo = 1, @hi = 3;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits before DEALLOCATE: $hit1

--echo # DEALLOCATE and re-PREPARE — fresh classify+admit cycle
DEALLOCATE PREPARE stmt;
PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hit2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits after re-PREPARE: $hit2

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E7: Non-PK BETWEEN — DISTINCT on secondary key range
#   WHERE uses BETWEEN on a secondary key column, not PK.
#   classify() passes (extract_between_field_params is loose) → COLD.
#   can_admit() fails because used_index != primary_key → NEVER.
#   This tests the classify-loose / admit-strict design.
# -----------------------------------------------------------------------
--echo # === Test E7: Non-PK BETWEEN range ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  k INT NOT NULL DEFAULT 0,
  c CHAR(120) NOT NULL DEFAULT '',
  KEY idx_k (k)
);
INSERT INTO t1 VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'a'), (4, 40, 'c'), (5, 50, 'b');

FLUSH STATUS;
SET @lo = 10, @hi = 40;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE k BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
--let $classifications = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--echo Classifications (should be 1 — classify is loose): $classifications

--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions (should be 0 — non-PK scan rejected by can_admit): $admissions

--echo # Verify the query still returns correct results
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test E8: NULLable DISTINCT column — NULL values deduplicated correctly
#   The DISTINCT column allows NULL. Multiple NULLs must collapse to one.
#   Verifies Filesort dedup handles NULL comparison correctly.
# -----------------------------------------------------------------------
--echo # === Test E8: NULLable DISTINCT column with NULLs ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) DEFAULT NULL
);
INSERT INTO t1 VALUES (1, 'a'), (2, NULL), (3, 'a'), (4, NULL), (5, 'b');

--echo # Expected result (normal path): NULL, a, b  (NULLs sort first in ASC)
SET SESSION ps_point_plan_cache = FALSE;
SELECT DISTINCT c FROM t1 WHERE id BETWEEN 1 AND 5 ORDER BY c;
SET SESSION ps_point_plan_cache = TRUE;

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;

--echo # Second execute — fast path result must match:
EXECUTE stmt USING @lo, @hi;
--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# ========================================================================
# Section F: Data correctness verification
# ========================================================================

# -----------------------------------------------------------------------
# Test F1: Verify dedup correctness — compare fast path vs normal path
# -----------------------------------------------------------------------
--echo # === Test F1: Correctness — fast path vs normal optimizer ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES
  (1, 'cherry'), (2, 'apple'), (3, 'banana'),
  (4, 'apple'), (5, 'cherry'), (6, 'date'),
  (7, 'banana'), (8, 'elderberry'), (9, 'apple'), (10, 'fig');

--echo # Get expected result from normal SQL (no plan cache)
SET SESSION ps_point_plan_cache = FALSE;
SELECT DISTINCT c FROM t1 WHERE id BETWEEN 1 AND 10 ORDER BY c;
SET SESSION ps_point_plan_cache = TRUE;

FLUSH STATUS;
SET @lo = 1, @hi = 10;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
--echo # First execute — admit
EXECUTE stmt USING @lo, @hi;
--echo # Second execute — fast path HIT, results must match
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test F2: Verify DESC dedup correctness
# -----------------------------------------------------------------------
--echo # === Test F2: Correctness — DESC order dedup ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES
  (1, 'z'), (2, 'a'), (3, 'm'), (4, 'z'), (5, 'a'),
  (6, 'b'), (7, 'm'), (8, 'y'), (9, 'b'), (10, 'y');

SET SESSION ps_point_plan_cache = FALSE;
--echo # Expected DESC result:
SELECT DISTINCT c FROM t1 WHERE id BETWEEN 1 AND 10 ORDER BY c DESC;
SET SESSION ps_point_plan_cache = TRUE;

FLUSH STATUS;
SET @lo = 1, @hi = 10;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c DESC';
EXECUTE stmt USING @lo, @hi;
--echo # Fast path result:
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test F3: Verify different ranges produce correct distinct results
# -----------------------------------------------------------------------
--echo # === Test F3: Correctness — varying ranges ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES
  (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'),
  (5, 'b'), (6, 'a'), (7, 'd'), (8, 'c');

FLUSH STATUS;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Range 1-4: should return a, b, c
SET @lo = 1, @hi = 4;
EXECUTE stmt USING @lo, @hi;

--echo # Range 5-8: should return a, b, c, d
SET @lo = 5, @hi = 8;
EXECUTE stmt USING @lo, @hi;

--echo # Range 3-6: should return a, b, c
SET @lo = 3, @hi = 6;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Total cache hits: $hits

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------

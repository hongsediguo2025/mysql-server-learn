DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B7: DISTINCT with GROUP BY — rejected
# -----------------------------------------------------------------------
--echo # === Test B7: DISTINCT + GROUP BY should not be classified ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT '',
  k INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20), (3, 'a', 30);

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? GROUP BY c ORDER BY c';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0): $delta


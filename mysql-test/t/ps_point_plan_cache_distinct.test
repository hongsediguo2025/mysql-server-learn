# ========================================================================
# Section E: Edge cases and boundary conditions
# ========================================================================

# -----------------------------------------------------------------------
# Test E1: Single row result
# -----------------------------------------------------------------------
--echo # === Test E1: Single row result ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'only_one'), (2, 'two'), (3, 'three');

FLUSH STATUS;

#
# Phase 10 DISTINCT + ORDER BY Test Suite for ps_point_plan_cache
#
# Comprehensive test coverage for RANGE_PK_BETWEEN_SORT_DISTINCT functionality:
#   Section A: Normal branch scenarios (happy paths)
#   Section B: Classification rejection scenarios (NEVER / not classified)
#   Section C: Runtime exception / fallback scenarios
#   Section D: DDL invalidation scenarios
#   Section E: Edge cases and boundary conditions
#   Section F: Data correctness verification
#

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

SET SESSION ps_point_plan_cache = ON;

# ========================================================================
# Section A: Normal branch scenarios
# ========================================================================

# -----------------------------------------------------------------------
# Test A1: Basic DISTINCT + ORDER BY ASC — classify, admit, hit
# -----------------------------------------------------------------------
--echo # === Test A1: Basic DISTINCT + ORDER BY ASC ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES
  (1, 'cherry'), (2, 'apple'), (3, 'cherry'),
  (4, 'banana'), (5, 'apple');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # First execute — COLD -> classify + first optimizer run -> admit to HOT
EXECUTE stmt USING @lo, @hi;
--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions after first execute: $admissions

--echo # Second execute — should be cache HIT via fast path
EXECUTE stmt USING @lo, @hi;
--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $hits

--echo # Third execute with different range — should also HIT
SET @lo = 2, @hi = 4;
EXECUTE stmt USING @lo, @hi;
--let $hits2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits after different range: $hits2

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test A2: DISTINCT + ORDER BY DESC
# -----------------------------------------------------------------------
--echo # === Test A2: DISTINCT + ORDER BY DESC ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(120) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'), (5, 'b');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c DESC';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits for DESC: $hits

--echo # Verify results are descending and deduplicated
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test A3: DISTINCT with INT column
# -----------------------------------------------------------------------
--echo # === Test A3: DISTINCT on INT column ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val INT NOT NULL
);
INSERT INTO t1 VALUES (1, 50), (2, 10), (3, 50), (4, 30), (5, 10);

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT val FROM t1 WHERE id BETWEEN ? AND ? ORDER BY val';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with INT DISTINCT: $hits

--echo # Verify 3 distinct values: 10, 30, 50
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test A4: DISTINCT with VARCHAR column (collation-sensitive)
# -----------------------------------------------------------------------
--echo # === Test A4: DISTINCT with VARCHAR column ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES
  (1, 'Apple'), (2, 'apple'), (3, 'BANANA'), (4, 'banana'), (5, 'Cherry');

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with VARCHAR: $hits

--echo # With case-insensitive collation, 'Apple'='apple' and 'BANANA'='banana'
EXECUTE stmt USING @lo, @hi;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test A5: Multiple prepared statements with DISTINCT
# -----------------------------------------------------------------------
--echo # === Test A5: Multiple concurrent DISTINCT statements ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c1 CHAR(20) NOT NULL DEFAULT '',
  c2 INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES
  (1, 'x', 100), (2, 'y', 100), (3, 'x', 200),
  (4, 'z', 300), (5, 'y', 200);

FLUSH STATUS;
SET @lo = 1, @hi = 5;

PREPARE stmt_a FROM 'SELECT DISTINCT c1 FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c1';
PREPARE stmt_b FROM 'SELECT DISTINCT c2 FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c2';

EXECUTE stmt_a USING @lo, @hi;
EXECUTE stmt_b USING @lo, @hi;

--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions (should be 2): $admissions

EXECUTE stmt_a USING @lo, @hi;
EXECUTE stmt_b USING @lo, @hi;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits (should be 2): $hits

DEALLOCATE PREPARE stmt_a;
DEALLOCATE PREPARE stmt_b;
DROP TABLE t1;

# ========================================================================
# Section B: Classification rejection scenarios
# ========================================================================

# -----------------------------------------------------------------------
# Test B1: Multi-column DISTINCT — rejected by Gate 4e
# -----------------------------------------------------------------------
--echo # === Test B1: Multi-column DISTINCT should be NEVER ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT '',
  k INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20);

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT c, k FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @lo = 1, @hi = 2;
EXECUTE stmt USING @lo, @hi;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0 — NEVER): $delta

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B2: DISTINCT column != ORDER BY column
#   MySQL with ONLY_FULL_GROUP_BY (default) rejects ORDER BY on a column
#   not in the SELECT list when DISTINCT is used (error 3065).
#   So this is caught at the SQL level, not by plan cache gates.
#   We test both: valid same-column and invalid different-column.
# -----------------------------------------------------------------------
--echo # === Test B2: DISTINCT column vs ORDER BY column ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT '',
  k INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20);

FLUSH STATUS;
SET @lo = 1, @hi = 2;

--echo # B2a: DISTINCT k ORDER BY k — same column, should be admitted
PREPARE stmt FROM 'SELECT DISTINCT k FROM t1 WHERE id BETWEEN ? AND ? ORDER BY k';
EXECUTE stmt USING @lo, @hi;
--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions for DISTINCT k ORDER BY k: $admissions
DEALLOCATE PREPARE stmt;

--echo # B2b: DISTINCT c ORDER BY k — different columns
--echo #   MySQL rejects this with ONLY_FULL_GROUP_BY (error 3065)
--error 3065
PREPARE stmt2 FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY k';

DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B3: DISTINCT without ORDER BY — rejected by Gate 4-pre
# -----------------------------------------------------------------------
--echo # === Test B3: DISTINCT without ORDER BY should be NEVER ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'a'), (3, 'b');

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ?';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @lo = 1, @hi = 3;
EXECUTE stmt USING @lo, @hi;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0 — NEVER): $delta

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B4: DISTINCT + aggregate — rejected by Gate 4-pre
# -----------------------------------------------------------------------
--echo # === Test B4: DISTINCT + aggregate should be NEVER ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT '',
  k INT NOT NULL DEFAULT 0
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20), (3, 'a', 30);

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? ORDER BY SUM(k)';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @lo = 1, @hi = 3;
--error 0
EXECUTE stmt USING @lo, @hi;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0): $delta

DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test B5: DISTINCT + LIMIT — rejected by Gate 4
# -----------------------------------------------------------------------
--echo # === Test B5: DISTINCT + LIMIT should not be classified ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c CHAR(20) NOT NULL DEFAULT ''
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'a'), (3, 'b');

FLUSH STATUS;
PREPARE stmt FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c LIMIT 1';

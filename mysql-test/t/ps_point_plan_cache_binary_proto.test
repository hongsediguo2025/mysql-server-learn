--echo #
--echo # Phase 0 test: ps_point_plan_cache under COM_STMT_PREPARE/COM_STMT_EXECUTE.
--echo #
--echo # This test MUST be run with --ps-protocol so that regular SELECTs
--echo # are sent via the binary prepared-statement protocol, which is the
--echo # actual target path for this feature (sysbench model).
--echo #

--source include/have_ps_protocol.inc

--echo # -------------------------------------------------------
--echo # Setup
--echo # -------------------------------------------------------

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val VARCHAR(100),
  uk INT NOT NULL,
  UNIQUE KEY idx_uk (uk)
);
INSERT INTO t1 VALUES (1, 'alpha', 100), (2, 'beta', 200), (3, 'gamma', 300);

CREATE TABLE t2 (
  id INT PRIMARY KEY,
  t1_id INT,
  memo TEXT
);
INSERT INTO t2 VALUES (1, 1, 'join-a'), (2, 2, 'join-b');

FLUSH STATUS;

--echo # -------------------------------------------------------
--echo # 0. Self-verification: prove we are running under binary PS protocol.
--echo #    Com_stmt_execute must increase when SELECTs go through
--echo #    COM_STMT_PREPARE/COM_STMT_EXECUTE.  If this test is accidentally
--echo #    run without --ps-protocol, the counter stays 0 and the
--echo #    assertion below will fail, catching the misconfiguration.
--echo # -------------------------------------------------------
--let $stmt_exec_before = query_get_value(SHOW STATUS LIKE 'Com_stmt_execute', Value, 1)
SELECT 1;
--let $stmt_exec_after = query_get_value(SHOW STATUS LIKE 'Com_stmt_execute', Value, 1)
--let $delta = `SELECT $stmt_exec_after - $stmt_exec_before`
if ($delta == 0) {
  --die Test NOT running under --ps-protocol. Com_stmt_execute did not increase. Re-run with: mtr --ps-protocol ps_point_plan_cache_binary_proto
}
--echo # Confirmed: running under binary PS protocol (Com_stmt_execute incremented by $delta)

FLUSH STATUS;

--echo # -------------------------------------------------------
--echo # 1. Point select on PK (candidate shape) via binary protocol
--echo # -------------------------------------------------------
SELECT * FROM t1 WHERE id = 1;
SELECT * FROM t1 WHERE id = 2;
SELECT * FROM t1 WHERE id = 3;

--echo # -------------------------------------------------------
--echo # 2. Point select on unique key via binary protocol
--echo # -------------------------------------------------------
SELECT * FROM t1 WHERE uk = 100;
SELECT * FROM t1 WHERE uk = 300;

--echo # -------------------------------------------------------
--echo # 3. Non-candidate shapes via binary protocol
--echo # -------------------------------------------------------
SELECT * FROM t1 WHERE id > 1 ORDER BY id;
SELECT t1.val, t2.memo FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.id = 1;
SELECT COUNT(*), MAX(val) FROM t1;

--echo # -------------------------------------------------------
--echo # 4. Counters must be 0 — Phase 0 is fully inert even
--echo #    under the real binary protocol path.
--echo # -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';

--echo # -------------------------------------------------------
--echo # 5. DDL-triggered reprepare under binary protocol
--echo #    (ps-protocol implicitly prepares each SELECT, so ALTER
--echo #    in between forces COM_STMT_EXECUTE to see version mismatch
--echo #    and trigger server-side reprepare.)
--echo # -------------------------------------------------------
SELECT * FROM t1 WHERE id = 1;
ALTER TABLE t1 ADD COLUMN extra INT DEFAULT 0;
SELECT * FROM t1 WHERE id = 2;
ALTER TABLE t1 DROP COLUMN extra;
SELECT * FROM t1 WHERE id = 3;

--echo # -------------------------------------------------------
--echo # 6. Toggle sysvar between binary-protocol executions
--echo # -------------------------------------------------------
SET SESSION ps_point_plan_cache = FALSE;
SELECT * FROM t1 WHERE id = 1;
SET SESSION ps_point_plan_cache = TRUE;
SELECT * FROM t1 WHERE id = 2;

--echo # -------------------------------------------------------
--echo # 7. Final counter check — still 0
--echo # -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';

--echo # -------------------------------------------------------
--echo # Cleanup
--echo # -------------------------------------------------------
DROP TABLE t2;
DROP TABLE t1;

--echo #
--echo # End of binary protocol Phase 0 test
--echo #

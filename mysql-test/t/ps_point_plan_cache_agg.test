# ==============================================================================
# Test Suite: ps_point_plan_cache_agg
# Purpose:     Test RANGE_PK_BETWEEN_AGG plan cache functionality
# Coverage:    Aggregate functions with primary key range scans
# ==============================================================================

--disable_warnings
DROP TABLE IF EXISTS t1, t2, t3;
--enable_warnings

# ==============================================================================
# Test 1: Basic functionality - Supported aggregate functions
# ==============================================================================

--echo # ========== Test 1: Basic aggregate functions ==========
CREATE TABLE t1 (id INT PRIMARY KEY, k INT, c CHAR(10));
INSERT INTO t1 VALUES (1, 100, 'a'), (2, 200, 'b'), (3, 300, 'c'), (4, 400, 'd'), (5, 500, 'e');

SET SESSION ps_point_plan_cache = ON;

--echo # Test 1.1: SUM(field)
PREPARE stmt_sum FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 3;
EXECUTE stmt_sum USING @low, @high;
EXECUTE stmt_sum USING @low, @high;
DEALLOCATE PREPARE stmt_sum;
SHOW STATUS LIKE 'ps_point_plan_cache_admissions';
SHOW STATUS LIKE 'ps_point_plan_cache_hits';

--echo # Test 1.2: COUNT(*)
PREPARE stmt_cnt_star FROM 'SELECT COUNT(*) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_cnt_star USING @low, @high;
EXECUTE stmt_cnt_star USING @low, @high;
DEALLOCATE PREPARE stmt_cnt_star;

--echo # Test 1.3: COUNT(field)
PREPARE stmt_cnt_field FROM 'SELECT COUNT(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_cnt_field USING @low, @high;
EXECUTE stmt_cnt_field USING @low, @high;
DEALLOCATE PREPARE stmt_cnt_field;

--echo # Test 1.4: MIN(field)
PREPARE stmt_min FROM 'SELECT MIN(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_min USING @low, @high;
EXECUTE stmt_min USING @low, @high;
DEALLOCATE PREPARE stmt_min;

--echo # Test 1.5: MAX(field)
PREPARE stmt_max FROM 'SELECT MAX(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_max USING @low, @high;
EXECUTE stmt_max USING @low, @high;
DEALLOCATE PREPARE stmt_max;

--echo # Test 1.6: Aggregate primary key field
PREPARE stmt_sum_pk FROM 'SELECT SUM(id) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_sum_pk USING @low, @high;
EXECUTE stmt_sum_pk USING @low, @high;
DEALLOCATE PREPARE stmt_sum_pk;

# ==============================================================================
# Test 2: Boundary condition tests
# ==============================================================================

--echo # ========== Test 2: Boundary conditions ==========

--echo # Test 2.1: Single point range (low = high)
PREPARE stmt_single FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @val = 3;
EXECUTE stmt_single USING @val, @val;
EXECUTE stmt_single USING @val, @val;
DEALLOCATE PREPARE stmt_single;

--echo # Test 2.2: Empty result set (range beyond data)
SET @low = 100, @high = 200;
PREPARE stmt_empty FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_empty USING @low, @high;
EXECUTE stmt_empty USING @low, @high;
DEALLOCATE PREPARE stmt_empty;

--echo # Test 2.3: Full table range
SET @low = 1, @high = 999999;
PREPARE stmt_full FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_full USING @low, @high;
EXECUTE stmt_full USING @low, @high;
DEALLOCATE PREPARE stmt_full;

--echo # Test 2.4: Reverse range (low > high, empty result)
SET @low = 5, @high = 1;
PREPARE stmt_reverse FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_reverse USING @low, @high;
EXECUTE stmt_reverse USING @low, @high;
DEALLOCATE PREPARE stmt_reverse;

--echo # Test 2.5: NULL parameter boundary (MySQL returns NULL, no error)
PREPARE stmt_null FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @low = NULL, @high = 3;
EXECUTE stmt_null USING @low, @high;
EXECUTE stmt_null USING @low, @high;
DEALLOCATE PREPARE stmt_null;

# ==============================================================================
# Test 3: Unsupported aggregate functions (should be rejected)
# ==============================================================================

--echo # ========== Test 3: Unsupported aggregate functions ==========

--echo # Test 3.1: AVG function
PREPARE stmt_avg FROM 'SELECT AVG(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 3;
EXECUTE stmt_avg USING @low, @high;
EXECUTE stmt_avg USING @low, @high;
DEALLOCATE PREPARE stmt_avg;
SHOW STATUS LIKE 'ps_point_plan_cache_admissions';

--echo # Test 3.2: STDDEV
PREPARE stmt_stddev FROM 'SELECT STDDEV(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_stddev USING @low, @high;
DEALLOCATE PREPARE stmt_stddev;

--echo # Test 3.3: GROUP_CONCAT
PREPARE stmt_group_concat FROM 'SELECT GROUP_CONCAT(c) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_group_concat USING @low, @high;
DEALLOCATE PREPARE stmt_group_concat;

--echo # Test 3.4: BIT_AND
PREPARE stmt_bit_and FROM 'SELECT BIT_AND(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_bit_and USING @low, @high;
DEALLOCATE PREPARE stmt_bit_and;

--echo # Test 3.5: BIT_OR
PREPARE stmt_bit_or FROM 'SELECT BIT_OR(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_bit_or USING @low, @high;
DEALLOCATE PREPARE stmt_bit_or;

--echo # Test 3.6: BIT_XOR
PREPARE stmt_bit_xor FROM 'SELECT BIT_XOR(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_bit_xor USING @low, @high;
DEALLOCATE PREPARE stmt_bit_xor;

# ==============================================================================
# Test 4: Unsupported query structures (should be rejected)
# ==============================================================================

--echo # ========== Test 4: Unsupported query structures ==========

--echo # Test 4.1: Multiple aggregate functions
PREPARE stmt_multi_agg FROM 'SELECT SUM(k), COUNT(*) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_multi_agg USING @low, @high;
EXECUTE stmt_multi_agg USING @low, @high;
DEALLOCATE PREPARE stmt_multi_agg;

--echo # Test 4.2: HAVING clause
PREPARE stmt_having FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? HAVING SUM(k) > 100';
EXECUTE stmt_having USING @low, @high;
EXECUTE stmt_having USING @low, @high;
DEALLOCATE PREPARE stmt_having;

--echo # Test 4.3: GROUP BY clause
PREPARE stmt_group_by FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? GROUP BY k';
EXECUTE stmt_group_by USING @low, @high;
DEALLOCATE PREPARE stmt_group_by;

--echo # Test 4.4: ORDER BY clause
PREPARE stmt_order_by FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? ORDER BY SUM(k)';
EXECUTE stmt_order_by USING @low, @high;
DEALLOCATE PREPARE stmt_order_by;

--echo # Test 4.5: DISTINCT clause
PREPARE stmt_distinct FROM 'SELECT COUNT(DISTINCT k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_distinct USING @low, @high;
DEALLOCATE PREPARE stmt_distinct;

--echo # Test 4.6: DISTINCT with SUM
PREPARE stmt_distinct_sum FROM 'SELECT SUM(DISTINCT k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_distinct_sum USING @low, @high;
DEALLOCATE PREPARE stmt_distinct_sum;

--echo # Test 4.7: Non-PK WHERE condition
PREPARE stmt_non_pk FROM 'SELECT SUM(k) FROM t1 WHERE k BETWEEN ? AND ?';
SET @k1 = 100, @k2 = 300;
EXECUTE stmt_non_pk USING @k1, @k2;
DEALLOCATE PREPARE stmt_non_pk;

--echo # Test 4.8: Compound WHERE condition
PREPARE stmt_compound FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? AND k > 0';
SET @low = 1, @high = 3;
EXECUTE stmt_compound USING @low, @high;
DEALLOCATE PREPARE stmt_compound;

--echo # Test 4.9: OR condition
PREPARE stmt_or FROM 'SELECT SUM(k) FROM t1 WHERE id = 1 OR id = 2';
EXECUTE stmt_or;
EXECUTE stmt_or;
DEALLOCATE PREPARE stmt_or;

--echo # Test 4.10: IN condition
PREPARE stmt_in FROM 'SELECT SUM(k) FROM t1 WHERE id IN (1, 2, 3)';
EXECUTE stmt_in;
DEALLOCATE PREPARE stmt_in;

--echo # Test 4.11: No WHERE clause
PREPARE stmt_no_where FROM 'SELECT SUM(k) FROM t1';
EXECUTE stmt_no_where;
EXECUTE stmt_no_where;
DEALLOCATE PREPARE stmt_no_where;

# ==============================================================================
# Test 5: Multi-table scenarios (should be rejected)
# ==============================================================================

--echo # ========== Test 5: Multi-table scenarios ==========

CREATE TABLE t2 (id INT PRIMARY KEY, val INT);
INSERT INTO t2 VALUES (1, 10), (2, 20), (3, 30);

--echo # Test 5.1: JOIN query
PREPARE stmt_join FROM 'SELECT SUM(t1.k) FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_join USING @low, @high;
DEALLOCATE PREPARE stmt_join;

--echo # Test 5.2: Subquery
PREPARE stmt_subq FROM 'SELECT SUM(k) FROM t1 WHERE id IN (SELECT id FROM t2 WHERE id BETWEEN ? AND ?)';
EXECUTE stmt_subq USING @low, @high;
DEALLOCATE PREPARE stmt_subq;

--echo # Test 5.3: UNION query
PREPARE stmt_union FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? UNION ALL SELECT COUNT(*) FROM t2';
EXECUTE stmt_union USING @low, @high;
DEALLOCATE PREPARE stmt_union;

# ==============================================================================
# Test 6: Data type coverage
# ==============================================================================

--echo # ========== Test 6: Data type coverage ==========

--echo # Test 6.1: Aggregate BIGINT column
CREATE TABLE t3 (id INT PRIMARY KEY, big_col BIGINT);
INSERT INTO t3 VALUES (1, 9223372036854775800), (2, 100), (3, 200);
PREPARE stmt_bigint FROM 'SELECT SUM(big_col) FROM t3 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 3;
EXECUTE stmt_bigint USING @low, @high;
EXECUTE stmt_bigint USING @low, @high;
DEALLOCATE PREPARE stmt_bigint;

--echo # Test 6.2: Aggregate DECIMAL column
CREATE TABLE t4 (id INT PRIMARY KEY, dec_col DECIMAL(10,2));
INSERT INTO t4 VALUES (1, 10.5), (2, 20.3), (3, 30.7);
PREPARE stmt_decimal FROM 'SELECT SUM(dec_col) FROM t4 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_decimal USING @low, @high;
EXECUTE stmt_decimal USING @low, @high;
DEALLOCATE PREPARE stmt_decimal;

--echo # Test 6.3: Aggregate DOUBLE column
CREATE TABLE t5 (id INT PRIMARY KEY, dbl_col DOUBLE);
INSERT INTO t5 VALUES (1, 1.5), (2, 2.5), (3, 3.5);
PREPARE stmt_double FROM 'SELECT SUM(dbl_col) FROM t5 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_double USING @low, @high;
EXECUTE stmt_double USING @low, @high;
DEALLOCATE PREPARE stmt_double;

--echo # Test 6.4: Aggregate SIGNED/UNSIGNED INT
CREATE TABLE t6 (id INT PRIMARY KEY, signed_col INT, unsigned_col INT UNSIGNED);
INSERT INTO t6 VALUES (1, -100, 100), (2, -200, 200), (3, 1000, 300);
PREPARE stmt_signed FROM 'SELECT SUM(signed_col) FROM t6 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_signed USING @low, @high;
EXECUTE stmt_signed USING @low, @high;
DEALLOCATE PREPARE stmt_signed;
PREPARE stmt_unsigned FROM 'SELECT SUM(unsigned_col) FROM t6 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_unsigned USING @low, @high;
EXECUTE stmt_unsigned USING @low, @high;
DEALLOCATE PREPARE stmt_unsigned;

# ==============================================================================
# Test 7: Parameter type change detection
# ==============================================================================

--echo # ========== Test 7: Parameter type changes ==========

--echo # Test 7.1: Stable parameter types - should stay HOT
PREPARE stmt_type_stable FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_type_stable USING @low, @high;
EXECUTE stmt_type_stable USING @low, @high;
EXECUTE stmt_type_stable USING @low, @high;
SHOW STATUS LIKE 'ps_point_plan_cache_hits';
DEALLOCATE PREPARE stmt_type_stable;

--echo # Test 7.2: INT parameter changed to BIGINT
CREATE TABLE t7 (id BIGINT PRIMARY KEY, k INT);
INSERT INTO t7 VALUES (1, 100), (2, 200), (3, 300);
PREPARE stmt_bigint_param FROM 'SELECT SUM(k) FROM t7 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_bigint_param USING @low, @high;
# Trigger type change check
SET @low = CAST(1 AS UNSIGNED), @high = CAST(2 AS UNSIGNED);
# Should fallback
EXECUTE stmt_bigint_param USING @low, @high;
DEALLOCATE PREPARE stmt_bigint_param;
SHOW STATUS LIKE 'ps_point_plan_cache_fallback_runtime';

--echo # Test 7.3: String parameters
PREPARE stmt_str_param FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @low = '1', @high = '3';
EXECUTE stmt_str_param USING @low, @high;
EXECUTE stmt_str_param USING @low, @high;
DEALLOCATE PREPARE stmt_str_param;

# ==============================================================================
# Test 8: Status variable verification
# ==============================================================================

--echo # ========== Test 8: Status variable verification ==========

--echo # Reset by restarting
--echo # Test 8.1: cold_classifications counter
SHOW STATUS LIKE 'ps_point_plan_cache_cold_classifications';

--echo # Test 8.2: admissions counter
SHOW STATUS LIKE 'ps_point_plan_cache_admissions';

--echo # Test 8.3: hits counter
SHOW STATUS LIKE 'ps_point_plan_cache_hits';

--echo # Test 8.4: fallback_runtime counter
SHOW STATUS LIKE 'ps_point_plan_cache_fallback_runtime';

--echo # Test 8.5: invalidations counter
SHOW STATUS LIKE 'ps_point_plan_cache_invalidations';

# ==============================================================================
# Test 9: Concurrent scenarios (requires multi-client testing, MTR limit)
# ==============================================================================

--echo # ========== Test 9: Concurrent preparation ==========
--echo # Note: Real concurrent testing requires --mysqld=--thread-handling=one-thread-per-connection
--echo # and multiple connection blocks

# ==============================================================================
# Test 10: Composite primary key scenarios
# ==============================================================================

--echo # ========== Test 10: Composite primary key ==========

CREATE TABLE t8 (
  id1 INT NOT NULL,
  id2 INT NOT NULL,
  k INT,
  PRIMARY KEY (id1, id2)
);
INSERT INTO t8 VALUES
  (1, 1, 100),
  (1, 2, 200),
  (2, 1, 300),
  (2, 2, 400);

--echo # Test 10.1: Composite PK using only first column (rejected - not single-column PK)
# Current implementation requires user_defined_key_parts == 1
PREPARE stmt_compound_pk FROM 'SELECT SUM(k) FROM t8 WHERE id1 BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_compound_pk USING @low, @high;
DEALLOCATE PREPARE stmt_compound_pk;

# ==============================================================================
# Test 11: Index change scenarios
# ==============================================================================

--echo # ========== Test 11: DDL 导致的 invalidation ==========

CREATE TABLE t9 (id INT PRIMARY KEY, k INT);
INSERT INTO t9 VALUES (1, 100), (2, 200), (3, 300);

--echo # Test 11.1: Establish HOT state
PREPARE stmt_ddl FROM 'SELECT SUM(k) FROM t9 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_ddl USING @low, @high;
EXECUTE stmt_ddl USING @low, @high;
SHOW STATUS LIKE 'ps_point_plan_cache_hits';

--echo # Test 11.2: Add index (should trigger invalidation)
ALTER TABLE t9 ADD INDEX idx_k (k);
EXECUTE stmt_ddl USING @low, @high;
SHOW STATUS LIKE 'ps_point_plan_cache_invalidations';
SHOW STATUS LIKE 'ps_point_plan_cache_fallback_runtime';

--echo # Test 11.3: DROP and reprepare
DROP PREPARE stmt_ddl;
PREPARE stmt_ddl FROM 'SELECT SUM(k) FROM t9 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_ddl USING @low, @high;
EXECUTE stmt_ddl USING @low, @high;
SHOW STATUS LIKE 'ps_point_plan_cache_hits';

# ==============================================================================
# Test 12: Sysbench compatibility
# ==============================================================================

--echo # ========== Test 12: Sysbench compatibility ==========

--echo # Create sbtest-like table
CREATE TABLE sbtest (
  id INT PRIMARY KEY,
  k INT,
  c CHAR(120) DEFAULT '' NOT NULL,
  pad CHAR(60) DEFAULT '' NOT NULL
);
INSERT INTO sbtest VALUES
  (1, 100, 'aaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'),
  (2, 200, 'bbbbbbbbbb', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'),
  (3, 300, 'cccccccccc', 'cccccccccccccccccccccccccccccccccccccccccccccccccc'),
  (4, 400, 'dddddddddd', 'dddddddddddddddddddddddddddddddddddddddddddddddddd'),
  (5, 500, 'eeeeeeeeee', 'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee');

--echo # Test 12.1: sum_ranges (sysbench)
PREPARE sb_sum FROM 'SELECT SUM(k) FROM sbtest WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 3;
EXECUTE sb_sum USING @low, @high;
EXECUTE sb_sum USING @low, @high;
EXECUTE sb_sum USING @low, @high;
SHOW STATUS LIKE 'ps_point_plan_cache_hits';
DEALLOCATE PREPARE sb_sum;

--echo # Test 12.2: COUNT(*) aggregate
PREPARE sb_cnt FROM 'SELECT COUNT(*) FROM sbtest WHERE id BETWEEN ? AND ?';
EXECUTE sb_cnt USING @low, @high;
EXECUTE sb_cnt USING @low, @high;
DEALLOCATE PREPARE sb_cnt;

--echo # Test 12.3: Aggregate long string column
PREPARE sb_str FROM 'SELECT SUM(LENGTH(c)) FROM sbtest WHERE id BETWEEN ? AND ?';
EXECUTE sb_str USING @low, @high;
EXECUTE sb_str USING @low, @high;
DEALLOCATE PREPARE sb_str;

# ==============================================================================
# Test 13: Non-Prepared Statement (should not be cached)
# ==============================================================================

--echo # ========== Test 13: Non-PS statements ==========

--echo # Test 13.1: Direct SQL execution
SET @start_hits = (SELECT VARIABLE_VALUE FROM PERFORMANCE_SCHEMA.session_status WHERE VARIABLE_NAME = 'Ps_point_plan_cache_hits');
SELECT SUM(k) FROM t1 WHERE id BETWEEN 1 AND 3;
SELECT SUM(k) FROM t1 WHERE id BETWEEN 1 AND 3;
SET @end_hits = (SELECT VARIABLE_VALUE FROM PERFORMANCE_SCHEMA.session_status WHERE VARIABLE_NAME = 'Ps_point_plan_cache_hits');
SELECT @end_hits - @start_hits AS hits_increased;

# ==============================================================================
# Test 14: Transaction scenarios
# ==============================================================================

--echo # ========== Test 14: Transaction scenarios ==========

START TRANSACTION;
PREPARE stmt_txn FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_txn USING @low, @high;
EXECUTE stmt_txn USING @low, @high;
COMMIT;
DEALLOCATE PREPARE stmt_txn;

--echo # Test 14.2: ROLLBACK scenario
START TRANSACTION;
PREPARE stmt_txn2 FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_txn2 USING @low, @high;
ROLLBACK;
# PREPARE is not affected by ROLLBACK
EXECUTE stmt_txn2 USING @low, @high;
DEALLOCATE PREPARE stmt_txn2;

# ==============================================================================
# Test 15: Cursor scenarios (should be skipped)
# ==============================================================================

--echo # ========== Test 15: Cursor scenarios ==========
--echo # Note: Requires cursor support, current implementation should skip cursor execution
--echo # This is a design constraint, checked in fast path guard

# ==============================================================================
# Test 16: Error recovery
# ==============================================================================

--echo # ========== Test 16: Error recovery ==========

--echo # Test 16.1: Division by zero (should not affect caching)
CREATE TABLE t10 (id INT PRIMARY KEY, val INT);
INSERT INTO t10 VALUES (1, 10), (2, 0), (3, 30);
PREPARE stmt_div FROM 'SELECT SUM(val) / SUM(id) FROM t10 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
# Should produce division by zero warning
EXECUTE stmt_div USING @low, @high;
EXECUTE stmt_div USING @low, @high;
DEALLOCATE PREPARE stmt_div;

--echo # Test 16.2: Overflow scenario
CREATE TABLE t11 (id INT PRIMARY KEY, big_val BIGINT);
INSERT INTO t11 VALUES (1, 9223372036854775800), (2, 100);
PREPARE stmt_overflow FROM 'SELECT SUM(big_val) FROM t11 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_overflow USING @low, @high;
EXECUTE stmt_overflow USING @low, @high;
DEALLOCATE PREPARE stmt_overflow;

# ==============================================================================
# Cleanup
# ==============================================================================

--echo # ========== Cleanup ==========
DROP TABLE IF EXISTS t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, sbtest;

SET SESSION ps_point_plan_cache = DEFAULT;

--echo # Final status check
SHOW STATUS LIKE 'ps_point_plan%';

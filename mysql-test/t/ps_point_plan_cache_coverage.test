--echo #
--echo # Supplementary coverage tests for ps_point_plan_cache.
--echo # Targets gaps identified in code review:
--echo #   A. Gate 6 — extra params outside WHERE
--echo #   B. Composite key param reordering correctness
--echo #   C. Multiple DDL/reprepare cycles (arena stability)
--echo #   D. ANALYZE TABLE — deterministic G1d demotion + re-admission
--echo #   E. ALTER PRIMARY KEY structure change
--echo #   F. DROP UK → reprepare → NEVER permanence
--echo #   G. Partitioned table exclusion (Gate 4b)
--echo #   H. G8 type drift: INT → STRING → re-admission
--echo #   I. NULL param fallback preserves HOT
--echo #   J. Multiple consecutive HOT hits (placement-new fix)
--echo #   K. Guard failure recovery (INVALID dead-end fix)
--echo #   L. Composite key — QEP_TAB reuse
--echo #   M. PS_PC_MAX_PARAMS boundary (5-column PK rejected)
--echo #   N. Repeated type drift cycles (G8 stress)
--echo #   O. optimizer_switch drift (G1c guard, use_invisible_indexes)
--echo #   P. sql_mode drift (G11 guard, PAD_CHAR_TO_FULL_LENGTH)
--echo #   Q. Composite key with type drift (G8 + reordering)
--echo #

--echo # -------------------------------------------------------
--echo # Setup
--echo # -------------------------------------------------------

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'one'), (2, 'two'), (3, 'three');

CREATE TABLE t_comp (
  pk1 INT NOT NULL,
  pk2 INT NOT NULL,
  val VARCHAR(50),
  PRIMARY KEY (pk1, pk2)
);
INSERT INTO t_comp VALUES (1, 10, 'a'), (1, 20, 'b'), (2, 10, 'c'), (2, 20, 'd');

CREATE TABLE t_uk (
  id INT PRIMARY KEY,
  uk_col INT NOT NULL,
  val VARCHAR(50),
  UNIQUE KEY idx_uk (uk_col)
);
INSERT INTO t_uk VALUES (1, 100, 'x'), (2, 200, 'y'), (3, 300, 'z');

CREATE TABLE t_alt (
  id INT PRIMARY KEY,
  val VARCHAR(50)
);
INSERT INTO t_alt VALUES (1, 'aa'), (2, 'bb'), (3, 'cc');

--echo # =======================================================
--echo # A. Gate 6 — extra parameter outside WHERE equalities
--echo #    param_count (1 in WHERE) != m_param_count (2 total)
--echo #    → NEVER at classify time.
--echo # =======================================================

FLUSH STATUS;

--let $cold_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
PREPARE stmt_a FROM 'SELECT ?, id, val FROM t1 WHERE id = ?';
--let $cold_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $cold_delta = `SELECT $cold_after - $cold_before`
--echo cold_delta (extra param in SELECT): $cold_delta

--echo # Execute to confirm correct results and no admission
SET @extra = 'hello';
SET @p = 1;
EXECUTE stmt_a USING @extra, @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after A (expect 0): $adm

DEALLOCATE PREPARE stmt_a;

--echo # A2: param in LIMIT position also counts
--let $cold_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
PREPARE stmt_a2 FROM 'SELECT * FROM t1 WHERE id = ? LIMIT ?';
--let $cold_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $cold_delta = `SELECT $cold_after - $cold_before`
--echo cold_delta (param in LIMIT — has_limit gate): $cold_delta

DEALLOCATE PREPARE stmt_a2;

--echo # =======================================================
--echo # B. Composite key — param reordering correctness
--echo #    WHERE pk2 = ? AND pk1 = ? — reversed from key order.
--echo #    Phase 2 admission reorders params to (pk1, pk2).
--echo #    Verify correct results across multiple executes.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_b FROM 'SELECT * FROM t_comp WHERE pk2 = ? AND pk1 = ?';

--echo # B1: first execute — admission (params reordered to key order)
SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_b USING @pk2, @pk1;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after B1 (expect 1): $adm

--echo # B2: second execute — fast path hit with different values
SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_b USING @pk2, @pk1;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after B2 (expect 1): $hits

--echo # B3: verify all four combinations return correct data
SET @pk2 = 10;
SET @pk1 = 2;
EXECUTE stmt_b USING @pk2, @pk1;

SET @pk2 = 20;
SET @pk1 = 1;
EXECUTE stmt_b USING @pk2, @pk1;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after B3 (expect 3): $hits

--echo # B4: non-existent composite key — empty result, still a hit
SET @pk2 = 99;
SET @pk1 = 99;
EXECUTE stmt_b USING @pk2, @pk1;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after B4 (expect 4): $hits

DEALLOCATE PREPARE stmt_b;

--echo # =======================================================
--echo # C. Multiple DDL/reprepare cycles — arena stability
--echo #    5 consecutive ALTER → EXECUTE cycles on the same PS.
--echo #    Each cycle: HOT → reprepare → re-classify → re-admit → HOT.
--echo #    Verifies arena-cached ref components survive across cycles.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_c FROM 'SELECT * FROM t_alt WHERE id = ?';

--echo # C-admit: initial admission → HOT
SET @p = 1;
EXECUTE stmt_c USING @p;

--let $adm_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions baseline: $adm_base

--echo # C-hit: verify HOT
SET @p = 2;
EXECUTE stmt_c USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits baseline: $hits_base

--echo # Cycle 1
ALTER TABLE t_alt ADD COLUMN c1 INT DEFAULT 0;
SET @p = 1;
EXECUTE stmt_c USING @p;
SET @p = 2;
EXECUTE stmt_c USING @p;

--echo # Cycle 2
ALTER TABLE t_alt DROP COLUMN c1;
SET @p = 1;
EXECUTE stmt_c USING @p;
SET @p = 3;
EXECUTE stmt_c USING @p;

--echo # Cycle 3
ALTER TABLE t_alt ADD COLUMN c2 INT DEFAULT 0;
SET @p = 2;
EXECUTE stmt_c USING @p;
SET @p = 3;
EXECUTE stmt_c USING @p;

--echo # Cycle 4
ALTER TABLE t_alt DROP COLUMN c2;
SET @p = 1;
EXECUTE stmt_c USING @p;
SET @p = 2;
EXECUTE stmt_c USING @p;

--echo # Cycle 5
ALTER TABLE t_alt ADD COLUMN c3 VARCHAR(10) DEFAULT 'x';
SET @p = 3;
EXECUTE stmt_c USING @p;
SET @p = 1;
EXECUTE stmt_c USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm - $adm_base`
--echo admissions delta after 5 cycles (expect 5): $adm_delta

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after 5 cycles (expect 5): $hits_delta

--echo # Final result correctness check
SET @p = 1;
EXECUTE stmt_c USING @p;

ALTER TABLE t_alt DROP COLUMN c3;
DEALLOCATE PREPARE stmt_c;

--echo # =======================================================
--echo # D. ANALYZE TABLE — deterministic G1d demotion
--echo #    Insert bulk data to force stats change, then ANALYZE.
--echo #    Verify demotion to COLD and re-admission.
--echo # =======================================================

FLUSH STATUS;

CREATE TABLE t_az (
  id INT PRIMARY KEY,
  val INT
);
INSERT INTO t_az VALUES (1, 10), (2, 20);

PREPARE stmt_d FROM 'SELECT * FROM t_az WHERE id = ?';

--echo # D1: admission
SET @p = 1;
EXECUTE stmt_d USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after D1 (expect 1): $adm

--echo # D2: fast path hit (confirms HOT)
SET @p = 2;
EXECUTE stmt_d USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after D2 (expect 1): $hits_base

--echo # D3: insert bulk data to force stats change + ANALYZE
--disable_query_log
--let $i = 100
while ($i < 1100)
{
  eval INSERT INTO t_az VALUES ($i, $i * 10);
  --inc $i
}
--enable_query_log

ANALYZE TABLE t_az;

--echo # D4: execute after ANALYZE — if version changed, demotion + re-admit
SET @p = 1;
EXECUTE stmt_d USING @p;

--echo # D5: next execute — fast path hit (re-admitted or was still HOT)
SET @p = 500;
EXECUTE stmt_d USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after D5 (expect >= 1): $hits_delta

--echo # Result correctness
SET @p = 2;
EXECUTE stmt_d USING @p;

DEALLOCATE PREPARE stmt_d;
DROP TABLE t_az;

--echo # =======================================================
--echo # E. ALTER PRIMARY KEY structure — verify re-admission
--echo #    with a different key layout after reprepare.
--echo # =======================================================

FLUSH STATUS;

CREATE TABLE t_pk_change (
  a INT NOT NULL,
  b INT NOT NULL,
  val VARCHAR(50),
  PRIMARY KEY (a)
);
INSERT INTO t_pk_change VALUES (1, 10, 'r1'), (2, 20, 'r2'), (3, 30, 'r3');

PREPARE stmt_e FROM 'SELECT * FROM t_pk_change WHERE a = ?';

--echo # E1: admission on PK(a)
SET @p = 1;
EXECUTE stmt_e USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after E1 (expect 1): $adm

--echo # E2: fast path hit
SET @p = 2;
EXECUTE stmt_e USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after E2 (expect 1): $hits

--echo # E3: change PK structure — reprepare → re-classify → re-admit
ALTER TABLE t_pk_change DROP PRIMARY KEY, ADD PRIMARY KEY (a, b);

SET @p = 1;
EXECUTE stmt_e USING @p;

--echo # After PK change from (a) to (a,b): query WHERE a = ? has
--echo # only 1 param but key now has 2 parts. Admission will fail
--echo # (ref.key_parts != tpl.param_count) → NEVER.
--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after E3 (expect 1, no new): $adm

--echo # E4: result is still correct via normal optimizer
SET @p = 2;
EXECUTE stmt_e USING @p;

SET @p = 3;
EXECUTE stmt_e USING @p;

DEALLOCATE PREPARE stmt_e;
DROP TABLE t_pk_change;

--echo # =======================================================
--echo # F. DROP UNIQUE KEY → reprepare → NEVER permanence
--echo #    After the UK is dropped, admission fails.
--echo #    Verify NEVER persists across many subsequent executes.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_f FROM 'SELECT * FROM t_uk WHERE uk_col = ?';

--echo # F1: admission on UNIQUE KEY
SET @p = 100;
EXECUTE stmt_f USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after F1 (expect 1): $adm

--echo # F2: fast path hit
SET @p = 200;
EXECUTE stmt_f USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after F2 (expect 1): $hits_base

--echo # F3: DROP the unique index → reprepare → NEVER
ALTER TABLE t_uk DROP INDEX idx_uk;

SET @p = 100;
EXECUTE stmt_f USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after F3 (still 1, no new): $adm

--echo # F4: multiple executes in NEVER state — no counters change
SET @p = 200;
EXECUTE stmt_f USING @p;
SET @p = 300;
EXECUTE stmt_f USING @p;
SET @p = 100;
EXECUTE stmt_f USING @p;
SET @p = 200;
EXECUTE stmt_f USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after F4 (still 1): $adm

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after F4 (expect 0): $hits_delta

--echo # Restore index for cleanup
ALTER TABLE t_uk ADD UNIQUE KEY idx_uk (uk_col);
DEALLOCATE PREPARE stmt_f;

--echo # =======================================================
--echo # G. Partitioned table exclusion (Gate 4b)
--echo #    Partitioned table must be rejected at classify time.
--echo #    PK point select on partitioned table → no cold.
--echo # =======================================================

FLUSH STATUS;

CREATE TABLE t_part (
  id INT PRIMARY KEY,
  val VARCHAR(50)
) PARTITION BY HASH(id) PARTITIONS 4;
INSERT INTO t_part VALUES (1, 'p1'), (2, 'p2'), (3, 'p3'), (4, 'p4');

--let $cold_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
PREPARE stmt_g FROM 'SELECT * FROM t_part WHERE id = ?';
--let $cold_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $cold_delta = `SELECT $cold_after - $cold_before`
--echo cold_delta (partitioned table): $cold_delta

--echo # Execute to confirm correct results but no admission
SET @p = 1;
EXECUTE stmt_g USING @p;

SET @p = 3;
EXECUTE stmt_g USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after G (expect 0): $adm

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after G (expect 0): $hits

DEALLOCATE PREPARE stmt_g;
DROP TABLE t_part;

--echo # =======================================================
--echo # H. G8 type drift: INT → STRING → COLD → INT re-admit
--echo #    Uses non-numeric string to trigger type drift.
--echo #    'abc' converts to 0 for INT comparison; no row found
--echo #    so optimizer short-circuits before admission hook.
--echo #    PS stays COLD until a valid INT param triggers admission.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_h FROM 'SELECT * FROM t1 WHERE id = ?';

--echo # H1: INT admission → HOT
SET @p = 1;
EXECUTE stmt_h USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after H1 (expect 1): $adm

--echo # H2: non-numeric STRING → G8 runtime guard triggers demotion HOT→COLD.
--echo #     'abc'→0 finds no row, optimizer zero-results before admission hook.
--echo #     PS stays COLD (not re-admitted yet).
SET @p = 'abc';
EXECUTE stmt_h USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback_runtime after H2 (expect 1): $fb

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after H2 (expect 1, no re-admit yet): $adm

--echo # H3: another STRING while COLD — zero result again, stays COLD
SET @p = 'xyz';
EXECUTE stmt_h USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after H3 (expect 0): $hits

--echo # H4: INT param with valid row → COLD → normal optimize → re-admission
SET @p = 1;
EXECUTE stmt_h USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after H4 (expect 2): $adm

--echo # H5: INT hit confirms re-admission succeeded
SET @p = 2;
EXECUTE stmt_h USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after H5 (expect 1): $hits

DEALLOCATE PREPARE stmt_h;

--echo # =======================================================
--echo # I. NULL param on HOT → fallback preserves HOT
--echo #    After fallback, next non-NULL execute is a hit.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_i FROM 'SELECT * FROM t1 WHERE id = ?';

--echo # I1: admission → HOT
SET @p = 1;
EXECUTE stmt_i USING @p;

--echo # I2: hit confirms HOT
SET @p = 2;
EXECUTE stmt_i USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo # I3: NULL param → G7 fallback, stays HOT
SET @p = NULL;
EXECUTE stmt_i USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback_runtime after I3 (expect 1): $fb

--echo # I4: non-NULL → should be a hit (HOT preserved)
SET @p = 3;
EXECUTE stmt_i USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after I4 (expect 1): $hits_delta

--echo # I5: multiple NULL → multiple fallbacks, still HOT after
SET @p = NULL;
EXECUTE stmt_i USING @p;
EXECUTE stmt_i USING @p;
EXECUTE stmt_i USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback_runtime after I5 (expect 4): $fb

SET @p = 1;
EXECUTE stmt_i USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after I5 recovery (expect 2): $hits_delta

DEALLOCATE PREPARE stmt_i;

--echo # =======================================================
--echo # J. Multiple consecutive HOT hits — QEP_TAB/QEP_shared
--echo #    reuse across executions.  Before the placement-new
--echo #    fix, set_qs()/set_idx() would assert on the second
--echo #    hit in debug builds (one-shot initialization).
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_j FROM 'SELECT * FROM t1 WHERE id = ?';

--echo # J1: admission → HOT
SET @p = 1;
EXECUTE stmt_j USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after J1 (expect 1): $adm

--echo # J2-J11: 10 consecutive HOT hits — exercises cached QEP reuse
SET @p = 2;
EXECUTE stmt_j USING @p;
SET @p = 3;
EXECUTE stmt_j USING @p;
SET @p = 1;
EXECUTE stmt_j USING @p;
SET @p = 2;
EXECUTE stmt_j USING @p;
SET @p = 3;
EXECUTE stmt_j USING @p;
SET @p = 1;
EXECUTE stmt_j USING @p;
SET @p = 2;
EXECUTE stmt_j USING @p;
SET @p = 3;
EXECUTE stmt_j USING @p;
SET @p = 1;
EXECUTE stmt_j USING @p;
SET @p = 2;
EXECUTE stmt_j USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after J (expect 10): $hits

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after J (still 1): $adm

DEALLOCATE PREPARE stmt_j;

--echo # =======================================================
--echo # K. Guard failure recovery — invalidation demotes to COLD,
--echo #    next execution re-admits with fresh cached components.
--echo #    Covers the former INVALID dead-end fix.
--echo #
--echo #    Scenario: HOT → DDL drops extra column → reprepare →
--echo #    COLD (classify) → normal optimize → re-admit → HOT.
--echo #    Then another DDL + 10 hits to verify fresh arena cache.
--echo # =======================================================

FLUSH STATUS;

CREATE TABLE t_guard (
  id INT PRIMARY KEY,
  val VARCHAR(50),
  extra INT DEFAULT 0
);
INSERT INTO t_guard VALUES (1, 'g1', 10), (2, 'g2', 20), (3, 'g3', 30);

PREPARE stmt_k FROM 'SELECT * FROM t_guard WHERE id = ?';

--echo # K1: admission → HOT
SET @p = 1;
EXECUTE stmt_k USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after K1 (expect 1): $adm

--echo # K2: HOT hit
SET @p = 2;
EXECUTE stmt_k USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after K2 (expect 1): $hits_base

--echo # K3: DDL → reprepare → re-classify → COLD → re-admit → HOT
ALTER TABLE t_guard DROP COLUMN extra;

SET @p = 1;
EXECUTE stmt_k USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after K3 (expect 2): $adm

--echo # K4: 10 consecutive HOT hits after re-admission (fresh cache)
SET @p = 2;
EXECUTE stmt_k USING @p;
SET @p = 3;
EXECUTE stmt_k USING @p;
SET @p = 1;
EXECUTE stmt_k USING @p;
SET @p = 2;
EXECUTE stmt_k USING @p;
SET @p = 3;
EXECUTE stmt_k USING @p;
SET @p = 1;
EXECUTE stmt_k USING @p;
SET @p = 2;
EXECUTE stmt_k USING @p;
SET @p = 3;
EXECUTE stmt_k USING @p;
SET @p = 1;
EXECUTE stmt_k USING @p;
SET @p = 2;
EXECUTE stmt_k USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after K4 (expect 10): $hits_delta

--echo # K5: another DDL cycle to verify repeated recovery
ALTER TABLE t_guard ADD COLUMN extra2 INT DEFAULT 0;

SET @p = 3;
EXECUTE stmt_k USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after K5 (expect 3): $adm

SET @p = 1;
EXECUTE stmt_k USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta2 = `SELECT $hits - $hits_base`
--echo hits delta after K5 final hit (expect 11): $hits_delta2

ALTER TABLE t_guard DROP COLUMN extra2;
DEALLOCATE PREPARE stmt_k;
DROP TABLE t_guard;

--echo # =======================================================
--echo # L. Composite key — multiple HOT hits after admission
--echo #    Verifies that cached QEP_TAB reuse works correctly
--echo #    for composite-key lookups with param reordering.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_l FROM 'SELECT * FROM t_comp WHERE pk2 = ? AND pk1 = ?';

--echo # L1: admission
SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_l USING @pk2, @pk1;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after L1 (expect 1): $adm

--echo # L2-L6: 5 consecutive HOT hits with different values
SET @pk2 = 20;
SET @pk1 = 1;
EXECUTE stmt_l USING @pk2, @pk1;

SET @pk2 = 10;
SET @pk1 = 2;
EXECUTE stmt_l USING @pk2, @pk1;

SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_l USING @pk2, @pk1;

SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_l USING @pk2, @pk1;

SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_l USING @pk2, @pk1;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after L (expect 5): $hits

DEALLOCATE PREPARE stmt_l;

--echo # =======================================================
--echo # M. PS_PC_MAX_PARAMS boundary — 5-column composite PK
--echo #    param_count (5) > PS_PC_MAX_PARAMS (4) → NEVER.
--echo #    Queries on wide composite keys gracefully fall back
--echo #    to the standard optimizer with correct results.
--echo # =======================================================

FLUSH STATUS;

CREATE TABLE t_wide (
  c1 INT NOT NULL,
  c2 INT NOT NULL,
  c3 INT NOT NULL,
  c4 INT NOT NULL,
  c5 INT NOT NULL,
  val VARCHAR(50),
  PRIMARY KEY (c1, c2, c3, c4, c5)
);
INSERT INTO t_wide VALUES (1, 2, 3, 4, 5, 'row1'), (10, 20, 30, 40, 50, 'row2');

--echo # M1: 5 params exceeds PS_PC_MAX_PARAMS=4, classify rejects → NEVER
--let $cold_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
PREPARE stmt_m FROM 'SELECT * FROM t_wide WHERE c1 = ? AND c2 = ? AND c3 = ? AND c4 = ? AND c5 = ?';
--let $cold_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $cold_delta = `SELECT $cold_after - $cold_before`
--echo cold_delta (5 params): $cold_delta

--echo # M2: execute — correct results via normal optimizer, no admission
SET @a=1, @b=2, @c=3, @d=4, @e=5;
EXECUTE stmt_m USING @a, @b, @c, @d, @e;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after M2 (expect 0): $adm

--echo # M3: second execute — still no hits
SET @a=10, @b=20, @c=30, @d=40, @e=50;
EXECUTE stmt_m USING @a, @b, @c, @d, @e;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after M3 (expect 0): $hits

--echo # M4: 4 params is within limit — verify classify succeeds
--let $cold_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
CREATE TABLE t_four (
  c1 INT NOT NULL,
  c2 INT NOT NULL,
  c3 INT NOT NULL,
  c4 INT NOT NULL,
  val VARCHAR(50),
  PRIMARY KEY (c1, c2, c3, c4)
);
INSERT INTO t_four VALUES (1, 2, 3, 4, 'f1'), (5, 6, 7, 8, 'f2');

PREPARE stmt_m4 FROM 'SELECT * FROM t_four WHERE c1 = ? AND c2 = ? AND c3 = ? AND c4 = ?';
--let $cold_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $cold_delta = `SELECT $cold_after - $cold_before`
--echo cold_delta (4 params — at limit): $cold_delta

SET @a=1, @b=2, @c=3, @d=4;
EXECUTE stmt_m4 USING @a, @b, @c, @d;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after M4 (expect 1): $adm

SET @a=5, @b=6, @c=7, @d=8;
EXECUTE stmt_m4 USING @a, @b, @c, @d;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after M4 hit (expect 1): $hits

DEALLOCATE PREPARE stmt_m;
DEALLOCATE PREPARE stmt_m4;
DROP TABLE t_wide;
DROP TABLE t_four;

--echo # =======================================================
--echo # N. Repeated type drift cycles — G8 stress test
--echo #    3 full INT → STRING → INT cycles on the same PS.
--echo #    Each cycle: HOT → type drift demotion → COLD →
--echo #    (STRING exec stays COLD) → INT re-admit → HOT.
--echo #    Verifies demotion/re-admission is repeatable.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_n FROM 'SELECT * FROM t1 WHERE id = ?';

--echo # N-cycle1: INT admit → HOT, STRING demote → COLD, INT re-admit → HOT
SET @p = 1;
EXECUTE stmt_n USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after cycle1 admit (expect 1): $adm

SET @p = 2;
EXECUTE stmt_n USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after cycle1 HOT hit (expect 1): $hits

SET @p = 'drift1';
EXECUTE stmt_n USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after cycle1 drift (expect 1): $fb

SET @p = 1;
EXECUTE stmt_n USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after cycle1 re-admit (expect 2): $adm

--echo # N-cycle2: repeat
SET @p = 3;
EXECUTE stmt_n USING @p;

SET @p = 'drift2';
EXECUTE stmt_n USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after cycle2 drift (expect 2): $fb

SET @p = 2;
EXECUTE stmt_n USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after cycle2 re-admit (expect 3): $adm

--echo # N-cycle3: repeat once more
SET @p = 1;
EXECUTE stmt_n USING @p;

SET @p = 'drift3';
EXECUTE stmt_n USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after cycle3 drift (expect 3): $fb

SET @p = 3;
EXECUTE stmt_n USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after cycle3 re-admit (expect 4): $adm

--echo # N-final: 5 HOT hits to confirm stable after 3 cycles
SET @p = 1;
EXECUTE stmt_n USING @p;
SET @p = 2;
EXECUTE stmt_n USING @p;
SET @p = 3;
EXECUTE stmt_n USING @p;
SET @p = 1;
EXECUTE stmt_n USING @p;
SET @p = 2;
EXECUTE stmt_n USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after N-final (expect 8): $hits

DEALLOCATE PREPARE stmt_n;

--echo # =======================================================
--echo # O. optimizer_switch drift — G1c guard
--echo #    use_invisible_indexes is the only switch tracked by
--echo #    the plan cache mask.  Toggling it triggers soft
--echo #    demotion (HOT → COLD retryable), then re-admission.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_o FROM 'SELECT * FROM t1 WHERE id = ?';

--echo # O1: admission → HOT
SET @p = 1;
EXECUTE stmt_o USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after O1 (expect 1): $adm

--echo # O2: confirm HOT
SET @p = 2;
EXECUTE stmt_o USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after O2 (expect 1): $hits_base

--echo # O3: toggle use_invisible_indexes → G1c demotion
SET @optimizer_switch_save = @@optimizer_switch;
SET optimizer_switch = 'use_invisible_indexes=on';

SET @p = 1;
EXECUTE stmt_o USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after O3 switch change (expect 1): $fb

--echo # O4: COLD → re-admission with new switch value
SET @p = 2;
EXECUTE stmt_o USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after O4 (expect 2): $adm

--echo # O5: HOT hits with new switch value
--echo #     Note: O3 fallback also re-admitted (same execution),
--echo #     so O4 was already a hit, not an admission.
SET @p = 3;
EXECUTE stmt_o USING @p;
SET @p = 1;
EXECUTE stmt_o USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after O5 (expect 3): $hits_delta

--echo # O6: restore switch → another drift + re-admission (same exec)
SET optimizer_switch = @optimizer_switch_save;

SET @p = 2;
EXECUTE stmt_o USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after O6 restore (expect 2): $fb

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after O6 re-admit (expect 3): $adm

--echo # O7: 2 HOT hits after O6 re-admission
SET @p = 1;
EXECUTE stmt_o USING @p;
SET @p = 3;
EXECUTE stmt_o USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after O7 (expect 5): $hits_delta

DEALLOCATE PREPARE stmt_o;

--echo # =======================================================
--echo # P. sql_mode drift — G11 guard
--echo #    PAD_CHAR_TO_FULL_LENGTH is tracked by the plan cache
--echo #    sql_mode mask.  Toggling it triggers soft demotion
--echo #    (HOT → COLD retryable) + re-admission in same exec.
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_p FROM 'SELECT * FROM t1 WHERE id = ?';

--echo # P1: admission → HOT
SET @p = 1;
EXECUTE stmt_p USING @p;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after P1 (expect 1): $adm

--echo # P2: confirm HOT
SET @p = 2;
EXECUTE stmt_p USING @p;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after P2 (expect 1): $hits_base

--echo # P3: set PAD_CHAR_TO_FULL_LENGTH → G11 drift + re-admission
SET @sql_mode_save = @@sql_mode;
SET sql_mode = 'PAD_CHAR_TO_FULL_LENGTH';

SET @p = 1;
EXECUTE stmt_p USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after P3 sql_mode change (expect 1): $fb

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after P3 (expect 2, re-admit in same exec): $adm

--echo # P4: HOT hit with new sql_mode
SET @p = 2;
EXECUTE stmt_p USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after P4 (expect 1): $hits_delta

--echo # P5: restore sql_mode → another drift + re-admission
SET sql_mode = @sql_mode_save;

SET @p = 3;
EXECUTE stmt_p USING @p;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after P5 restore (expect 2): $fb

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after P5 (expect 3): $adm

--echo # P6: stable HOT hits after restore
SET @p = 1;
EXECUTE stmt_p USING @p;
SET @p = 2;
EXECUTE stmt_p USING @p;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after P6 (expect 3): $hits_delta

DEALLOCATE PREPARE stmt_p;

--echo # =======================================================
--echo # Q. Composite key with type drift — G8 + reordering
--echo #    Verifies type drift detection works correctly with
--echo #    composite key param reordering (Phase 2 reorders
--echo #    params to key-part order).
--echo # =======================================================

FLUSH STATUS;

PREPARE stmt_q FROM 'SELECT * FROM t_comp WHERE pk2 = ? AND pk1 = ?';

--echo # Q1: INT admission → HOT (params reordered to pk1, pk2)
SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after Q1 (expect 1): $adm

--echo # Q2: HOT hits
SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_q USING @pk2, @pk1;

--let $hits_base = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo hits after Q2 (expect 1): $hits_base

--echo # Q3: STRING drift on one param → G8 demotion
SET @pk2 = 'abc';
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;

--let $fb = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo fallback after Q3 STRING drift (expect 1): $fb

--echo # Q4: INT params → re-admission
SET @pk2 = 10;
SET @pk1 = 2;
EXECUTE stmt_q USING @pk2, @pk1;

--let $adm = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo admissions after Q4 re-admit (expect 2): $adm

--echo # Q5: 3 HOT hits — verify reordering still correct after drift
SET @pk2 = 20;
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;

SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;

SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_q USING @pk2, @pk1;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits - $hits_base`
--echo hits delta after Q5 (expect 3): $hits_delta

DEALLOCATE PREPARE stmt_q;

--echo # -------------------------------------------------------
--echo # Teardown
--echo # -------------------------------------------------------

DROP TABLE t1;
DROP TABLE t_comp;
DROP TABLE t_uk;
DROP TABLE t_alt;

--echo # Supplementary coverage tests complete.

--echo #
--echo # Phase Multi-Connection test: ps_point_plan_cache behavior
--echo # across multiple connections.
--echo # Verifies global quota enforcement, connection-local eviction,
--echo # and status variable visibility.
--echo #
--echo # Run: mtr --ps-protocol ps_point_plan_cache_multi_connection
--echo #

--source include/count_sessions.inc

--echo # -------------------------------------------------------
--echo # Setup
--echo # -------------------------------------------------------

CREATE TABLE t_mc1 (
  id INT PRIMARY KEY,
  val VARCHAR(50)
);
INSERT INTO t_mc1 VALUES
  (1, 'a1'), (2, 'b1'), (3, 'c1'), (4, 'd1'),
  (10, 'e1'), (20, 'f1'), (30, 'g1');

CREATE TABLE t_mc2 (
  id INT PRIMARY KEY,
  val VARCHAR(50)
);
INSERT INTO t_mc2 VALUES
  (1, 'a2'), (2, 'b2'), (3, 'c2'), (4, 'd2'),
  (10, 'e2'), (20, 'f2'), (30, 'g2');

FLUSH STATUS;

--echo # =======================================================
--echo # Test 1: Global counter visibility across connections
--echo # =======================================================

--echo # 1.1. Connection default: Create and admit a PS
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_conn1 FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_conn1 USING @p;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo Connection default - Admissions delta: $adm_delta

--echo # 1.2. Connection con1: Verify global status shows same value
connect (con1, localhost, root,,);
--let $adm_con1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Connection con1 - Global admissions counter: $adm_con1
--echo Expected: Same as connection default ($adm_after)

--echo # 1.3. Connection con1: Create and admit another PS
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_conn2 FROM 'SELECT * FROM t_mc2 WHERE id = ?';
SET @p = 2;
EXECUTE stmt_conn2 USING @p;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo Connection con1 - Admissions delta: $adm_delta2

--echo # 1.4. Connection default: Verify counter includes con1's admission
--connection default
--let $adm_default = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Connection default - Global admissions counter: $adm_default
--echo Expected: 2 (one from each connection)

DEALLOCATE PREPARE stmt_conn1;

--echo # 1.5. Connection con1: Cleanup
--connection con1
DEALLOCATE PREPARE stmt_conn2;

--echo # =======================================================
--echo # Test 2: Each connection maintains separate PS namespace
--echo # =======================================================

FLUSH STATUS;
--connection default

--echo # 2.1. Connection default: Prepare stmt_a
PREPARE stmt_a FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_a USING @p;

--echo # 2.2. Connection con2: Can prepare its own stmt_a (different namespace)
connect (con2, localhost, root,,);
PREPARE stmt_a FROM 'SELECT * FROM t_mc2 WHERE id = ?';
SET @p = 2;
EXECUTE stmt_a USING @p;

--echo # 2.3. Connection default: stmt_a still exists and works
--connection default
--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @p = 3;
EXECUTE stmt_a USING @p;
--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta = `SELECT $hits_after - $hits_before`
--echo Connection default - stmt_a HOT hit: $hits_delta

--echo # 2.4. Connection con2: Its own stmt_a also works
--connection con2
--let $hits_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
SET @p = 4;
EXECUTE stmt_a USING @p;
--let $hits_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $hits_delta2 = `SELECT $hits_after2 - $hits_before2`
--echo Connection con2 - stmt_a HOT hit: $hits_delta2

DEALLOCATE PREPARE stmt_a;
--connection default
DEALLOCATE PREPARE stmt_a;

--echo # =======================================================
--echo # Test 3: Connection-local eviction (does not affect other connections)
--echo # =======================================================

FLUSH STATUS;
--connection default

--echo # 3.1. Set short idle timeout and low quota with high eviction_pct
SET @orig_idle = @@global.ps_point_plan_cache_eviction_idle_seconds;
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = 2;
SET GLOBAL ps_point_plan_cache_max_cached_plans = 2;
SET GLOBAL ps_point_plan_cache_eviction_pct = 100;

--echo # 3.2. Connection default: Create and admit PS (quota: 1/2)
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_local1 FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_local1 USING @p;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo Connection default - Initial admission: $adm_delta

--echo # 3.3. Connection con3: Create and admit different PS (quota: 2/2 full)
connect (con3, localhost, root,,);
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_local2 FROM 'SELECT * FROM t_mc2 WHERE id = ?';
SET @p = 2;
EXECUTE stmt_local2 USING @p;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo Connection con3 - Initial admission: $adm_delta2

--echo # 3.4. Keep connection default active, let con3 go idle
--connection default
SELECT SLEEP(1);
SET @p = 3;
EXECUTE stmt_local1 USING @p;
SELECT SLEEP(1);
SET @p = 4;
EXECUTE stmt_local1 USING @p;

--echo # 3.5. Wait for timeout (con3's PS should be evicted)
SELECT SLEEP(3);

--echo # 3.6. Connection default: Still HOT (no re-admission needed)
--let $hits_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $adm_before3 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
SET @p = 10;
EXECUTE stmt_local1 USING @p;
--let $hits_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--let $adm_after3 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $hits_delta = `SELECT $hits_after - $hits_before`
--let $adm_delta3 = `SELECT $adm_after3 - $adm_before3`

--echo Connection default - HOT hit after timeout: $hits_delta
--echo Connection default - Re-admissions needed: $adm_delta3
--echo Expected: hit=1, re-admit=0 (kept alive)

--echo # 3.7. Connection con3: Create new PS to trigger eviction, then verify old PS evicted
--connection con3
--let $ev_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_evictions', Value, 1)
PREPARE stmt_local3 FROM 'SELECT * FROM t_mc2 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_local3 USING @p;
--let $ev_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_evictions', Value, 1)
--let $ev_delta = `SELECT $ev_after - $ev_before`

--echo Connection con3 - Evictions occurred: $ev_delta
--echo Expected: evict>=1 (stmt_local2 evicted)

DEALLOCATE PREPARE stmt_local2;
DEALLOCATE PREPARE stmt_local3;
--connection default
DEALLOCATE PREPARE stmt_local1;

SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = @orig_idle;
SET GLOBAL ps_point_plan_cache_max_cached_plans = DEFAULT;
SET GLOBAL ps_point_plan_cache_eviction_pct = DEFAULT;

--echo # =======================================================
--echo # Test 4: Multiple connections - sysvar isolation
--echo # =======================================================

--echo # 4.1. Connection default: Set session-level OFF
--connection default
SET SESSION ps_point_plan_cache = FALSE;
SELECT @@session.ps_point_plan_cache AS 'default session: OFF';

--echo # 4.2. Connection con4: Should inherit global ON
connect (con4, localhost, root,,);
SELECT @@session.ps_point_plan_cache AS 'con4 session: ON (inherited global)';

--echo # 4.3. Connection con4: Execute PS - should use cache
--let $adm_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_sysvar FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_sysvar USING @p;
--let $adm_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta = `SELECT $adm_after - $adm_before`
--echo Connection con4 - Admissions with cache ON: $adm_delta
--echo Expected: 1

DEALLOCATE PREPARE stmt_sysvar;

--echo # 4.4. Connection default: Execute PS - should NOT use cache
--let $adm_before2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
PREPARE stmt_sysvar2 FROM 'SELECT * FROM t_mc2 WHERE id = ?';
SET @p = 2;
EXECUTE stmt_sysvar2 USING @p;
--let $adm_after2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $adm_delta2 = `SELECT $adm_after2 - $adm_before2`
--echo Connection default - Admissions with cache OFF: $adm_delta2
--echo Expected: 0 (cache disabled for this session)

DEALLOCATE PREPARE stmt_sysvar2;
SET SESSION ps_point_plan_cache = DEFAULT;

--connection default

--echo # =======================================================
--echo # Test 5: DDL invalidation affects all connections
--echo # =======================================================

FLUSH STATUS;
--connection default

--echo # 5.1. Connection default: Create and admit PS
--let $inv_before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
PREPARE stmt_ddl1 FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_ddl1 USING @p;

--echo # 5.2. Connection con5: Create and admit PS on same table
connect (con5, localhost, root,,);
PREPARE stmt_ddl2 FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 2;
EXECUTE stmt_ddl2 USING @p;

--echo # 5.3. Connection default: Trigger DDL invalidation
--connection default
ALTER TABLE t_mc1 ADD COLUMN extra INT DEFAULT 0;

--let $inv_after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--let $inv_delta = `SELECT $inv_after - $inv_before`
--echo Invalidations after ALTER TABLE: $inv_delta
--echo Expected: >= 1 (all entries for t_mc1 invalidated)

--echo # 5.4. Both connections should re-prepare (cache invalidated)
--echo Connection default - execute after DDL:
SET @p = 3;
EXECUTE stmt_ddl1 USING @p;

--connection con5
--echo Connection con5 - execute after DDL:
SET @p = 4;
EXECUTE stmt_ddl2 USING @p;

--echo # 5.5. Clean up DDL changes
--connection default
ALTER TABLE t_mc1 DROP COLUMN extra;

DEALLOCATE PREPARE stmt_ddl1;
--connection con5
DEALLOCATE PREPARE stmt_ddl2;
--connection default

--echo # =======================================================
--echo # Test 6: Cross-connection status consistency
--echo # =======================================================

FLUSH STATUS;
--connection default

--echo # 6.1. Connection default: Perform multiple operations
PREPARE stmt_stat1 FROM 'SELECT * FROM t_mc1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_stat1 USING @p;
SET @p = 2;
EXECUTE stmt_stat1 USING @p;

--let $cold1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $adm1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $hits1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo Connection default counters:
--echo   cold_classifications: $cold1
--echo   admissions: $adm1
--echo   hits: $hits1

--echo # 6.2. Connection con6: Verify same global counters
connect (con6, localhost, root,,);
--let $cold2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $adm2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $hits2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo Connection con6 global counters (should match):
--echo   cold_classifications: $cold2
--echo   admissions: $adm2
--echo   hits: $hits2

--echo # 6.3. Connection con6: Add more operations
PREPARE stmt_stat2 FROM 'SELECT * FROM t_mc2 WHERE id = ?';
SET @p = 10;
EXECUTE stmt_stat2 USING @p;

--echo # 6.4. Connection default: See updated counters
--connection default
--let $cold3 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $adm3 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--let $hits3 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo Connection default counters after con6 activity:
--echo   cold_classifications: $cold3 (should be > $cold1)
--echo   admissions: $adm3 (should be > $adm1)
--echo   hits: $hits3

DEALLOCATE PREPARE stmt_stat1;
--connection con6
DEALLOCATE PREPARE stmt_stat2;
--connection default

--echo # -------------------------------------------------------
--echo # Final counter summary
--echo # -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';

--echo # -------------------------------------------------------
--echo # Cleanup
--echo # -------------------------------------------------------
DROP TABLE t_mc1;
DROP TABLE t_mc2;

--echo #
--echo # End of Multi-Connection test
--echo #

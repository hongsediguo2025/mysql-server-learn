# -----------------------------------------------------------------------
# Test 16: Table TRUNCATE invalidation
# -----------------------------------------------------------------------
--echo # === Test 16: Table TRUNCATE invalidation ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');

FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 3;

PREPARE stmt16 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Admit to HOT
EXECUTE stmt16 USING @p_low, @p_high;
EXECUTE stmt16 USING @p_low, @p_high;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo # TRUNCATE table
TRUNCATE TABLE t1;
INSERT INTO t1 VALUES (10, 'x'), (20, 'y'), (30, 'z');

--echo # Execute after TRUNCATE - should invalidate
SET @p_low = 10;
SET @p_high = 30;
EXECUTE stmt16 USING @p_low, @p_high;
--let $invalidations = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--echo Invalidation after TRUNCATE: $invalidations

DEALLOCATE PREPARE stmt16;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 17: Parameter type drift detection
# -----------------------------------------------------------------------
--echo # === Test 17: Parameter type drift ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');

FLUSH STATUS;

PREPARE stmt17 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Execute with INT parameters
SET @p_low = 1;
SET @p_high = 3;
EXECUTE stmt17 USING @p_low, @p_high;
EXECUTE stmt17 USING @p_low, @p_high;

--echo # Execute with different numeric types - should still work
SET @p_low = 1.0;
SET @p_high = 3.0;
EXECUTE stmt17 USING @p_low, @p_high;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits with type variations: $hits

DEALLOCATE PREPARE stmt17;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 18: sysvar off at runtime
# -----------------------------------------------------------------------
--echo # === Test 18: Runtime sysvar disable ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');

SET SESSION ps_point_plan_cache = TRUE;
FLUSH STATUS;

PREPARE stmt18 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

SET @p_low = 1;
SET @p_high = 3;

--echo # Admit with sysvar ON
EXECUTE stmt18 USING @p_low, @p_high;
EXECUTE stmt18 USING @p_low, @p_high;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo # Turn off sysvar - should fallback to normal path
SET SESSION ps_point_plan_cache = FALSE;
EXECUTE stmt18 USING @p_low, @p_high;
--let $fallback = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo Runtime fallbacks with sysvar OFF: $fallback

--echo # Turn back on - should recover
SET SESSION ps_point_plan_cache = TRUE;
EXECUTE stmt18 USING @p_low, @p_high;
--let $hit2 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits after re-enable: $hit2

DEALLOCATE PREPARE stmt18;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 19: Very large range with ORDER BY
# -----------------------------------------------------------------------
--echo # === Test 19: Large range scan with ORDER BY ===

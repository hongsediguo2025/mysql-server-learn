  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES
  (1, 'val1'), (2, 'val2'), (3, 'val3'), (4, 'val4'), (5, 'val5'),
  (6, 'val6'), (7, 'val7'), (8, 'val8'), (9, 'val9'), (10, 'val10'),
  (11, 'val11'), (12, 'val12'), (13, 'val13'), (14, 'val14'), (15, 'val15'),
  (16, 'val16'), (17, 'val17'), (18, 'val18'), (19, 'val19'), (20, 'val20'),
  (21, 'val21'), (22, 'val22'), (23, 'val23'), (24, 'val24'), (25, 'val25'),
  (26, 'val26'), (27, 'val27'), (28, 'val28'), (29, 'val29'), (30, 'val30'),
  (31, 'val31'), (32, 'val32'), (33, 'val33'), (34, 'val34'), (35, 'val35'),
  (36, 'val36'), (37, 'val37'), (38, 'val38'), (39, 'val39'), (40, 'val40'),
  (41, 'val41'), (42, 'val42'), (43, 'val43'), (44, 'val44'), (45, 'val45'),
  (46, 'val46'), (47, 'val47'), (48, 'val48'), (49, 'val49'), (50, 'val50');

FLUSH STATUS;


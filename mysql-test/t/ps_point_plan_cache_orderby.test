--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0): $delta

DEALLOCATE PREPARE stmt5;
DROP TABLE t1;


#
# Phase 9 ORDER BY Test Suite for ps_point_plan_cache
#
# Comprehensive test coverage for RANGE_PK_BETWEEN_SORT functionality:
# - Branch scenarios (normal paths)
# - Exception handling
# - Invalidation scenarios
# - Cache misses
# - Table change invalidations
#

# -----------------------------------------------------------------------
# Test 1: Basic ORDER BY ASC - classification and admission
# -----------------------------------------------------------------------
--echo # === Test 1: Basic ORDER BY ASC ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50),
  k INT
);
INSERT INTO t1 VALUES
  (1, 'z', 100), (2, 'y', 200), (3, 'x', 300),
  (4, 'w', 400), (5, 'v', 500);

FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 5;

PREPARE stmt1 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c ASC';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $after_classify = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta_classify = `SELECT $after_classify - $before`
--echo Classification result (should be 1 for COLD): $delta_classify

--echo # First execute - should admit to HOT
EXECUTE stmt1 USING @p_low, @p_high;
--let $after_admit = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions after first execute: $after_admit

--echo # Second execute - should be cache HIT
EXECUTE stmt1 USING @p_low, @p_high;
--let $after_hit = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $after_hit

--echo # Verify results are correct (ordered by c)
EXECUTE stmt1 USING @p_low, @p_high;

DEALLOCATE PREPARE stmt1;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 2: Basic ORDER BY DESC
# -----------------------------------------------------------------------
--echo # === Test 2: Basic ORDER BY DESC ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 4;

PREPARE stmt2 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c DESC';
EXECUTE stmt2 USING @p_low, @p_high;
EXECUTE stmt2 USING @p_low, @p_high;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits for DESC order: $hits

DEALLOCATE PREPARE stmt2;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 3: ORDER BY with different data types (INT)
# -----------------------------------------------------------------------
--echo # === Test 3: ORDER BY with INT column ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val INT
);
INSERT INTO t1 VALUES (1, 50), (2, 10), (3, 90), (4, 30), (5, 70);

SET @p_low = 1;
SET @p_high = 5;

PREPARE stmt3 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY val';
EXECUTE stmt3 USING @p_low, @p_high;
EXECUTE stmt3 USING @p_low, @p_high;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Cache hits: $hits

DEALLOCATE PREPARE stmt3;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 4: ORDER BY should be rejected with aggregate (NEVER)
# -----------------------------------------------------------------------
--echo # === Test 4: ORDER BY + aggregate should be NEVER ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50),
  k INT
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);

FLUSH STATUS;
--echo # This query has both aggregate and ORDER BY - should be NEVER
PREPARE stmt4 FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @a = 1;
SET @b = 3;
EXECUTE stmt4 USING @a, @b;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Classification delta (should be 0 - NEVER): $delta

DEALLOCATE PREPARE stmt4;
DROP TABLE t1;


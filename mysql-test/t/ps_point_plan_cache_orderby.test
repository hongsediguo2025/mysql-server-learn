# -----------------------------------------------------------------------
# Test 9: Invalidation - ORDER BY field type change
# -----------------------------------------------------------------------
--echo # === Test 9: Invalidation on ORDER BY field type change ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 3;

PREPARE stmt9 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # First execute - should admit
EXECUTE stmt9 USING @p_low, @p_high;
--let $admit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Admissions: $admit1

--echo # Second execute - cache hit
EXECUTE stmt9 USING @p_low, @p_high;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits before ALTER: $hit1

--echo # ALTER TABLE to change column type
ALTER TABLE t1 MODIFY c TEXT;

--echo # Execute after ALTER - should invalidate and fallback
EXECUTE stmt9 USING @p_low, @p_high;
--let $invalidations = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--echo Invalidation after ALTER: $invalidations
--let $fallback = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_fallback_runtime', Value, 1)
--echo Runtime fallbacks: $fallback

DEALLOCATE PREPARE stmt9;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 10: Invalidation - ORDER BY field dropped
# -----------------------------------------------------------------------
--echo # === Test 10: Invalidation when ORDER BY column is dropped ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50),
  extra INT
);
INSERT INTO t1 VALUES (1, 'a', 100), (2, 'b', 200);

FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 2;

PREPARE stmt10 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Admit and hit
EXECUTE stmt10 USING @p_low, @p_high;
EXECUTE stmt10 USING @p_low, @p_high;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)

--echo # Drop the ORDER BY column
ALTER TABLE t1 DROP COLUMN c;

--echo # Execute after DROP - should invalidate
--error ER_BAD_FIELD_ERROR
EXECUTE stmt10 USING @p_low, @p_high;

--let $invalidations = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--echo Invalidation after DROP COLUMN: $invalidations

DEALLOCATE PREPARE stmt10;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 11: Multiple concurrent statements with ORDER BY
# -----------------------------------------------------------------------
--echo # === Test 11: Multiple concurrent ORDER BY statements ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c1 VARCHAR(50),
  c2 INT,
  c3 DATE
);
INSERT INTO t1 VALUES
  (1, 'z', 300, '2023-03-01'),
  (2, 'y', 200, '2023-02-01'),
  (3, 'x', 100, '2023-01-01');

FLUSH STATUS;

--echo # Prepare multiple statements with different ORDER BY columns
SET @p_low = 1;
SET @p_high = 3;

PREPARE stmt11a FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c1';
PREPARE stmt11b FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c2 DESC';
PREPARE stmt11c FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c3';

--echo # Execute all - each should be admitted separately
EXECUTE stmt11a USING @p_low, @p_high;
EXECUTE stmt11b USING @p_low, @p_high;
EXECUTE stmt11c USING @p_low, @p_high;

--let $admissions = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_admissions', Value, 1)
--echo Total admissions: $admissions

--echo # Execute again - all should hit
EXECUTE stmt11a USING @p_low, @p_high;
EXECUTE stmt11b USING @p_low, @p_high;
EXECUTE stmt11c USING @p_low, @p_high;

--let $hits = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Total hits: $hits

DEALLOCATE PREPARE stmt11a;
DEALLOCATE PREPARE stmt11b;
DEALLOCATE PREPARE stmt11c;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 12: Empty result set with ORDER BY
# -----------------------------------------------------------------------
--echo # === Test 12: Empty result set with ORDER BY ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');

FLUSH STATUS;

PREPARE stmt12 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
SET @p_low = 10;
SET @p_high = 20;

EXECUTE stmt12 USING @p_low, @p_high;
--echo Should return empty set but still work

SET @p_low = 1;
SET @p_high = 3;
EXECUTE stmt12 USING @p_low, @p_high;
--echo Should return results after parameter change

DEALLOCATE PREPARE stmt12;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 13: ORDER BY with composite PK
# -----------------------------------------------------------------------
--echo # === Test 13: ORDER BY with composite primary key ===
CREATE TABLE t1 (
  pk1 INT NOT NULL,
  pk2 INT NOT NULL,
  c VARCHAR(50),
  PRIMARY KEY (pk1, pk2)
);
INSERT INTO t1 VALUES
  (1, 1, 'c'), (1, 2, 'b'), (1, 3, 'a'),
  (2, 1, 'f'), (2, 2, 'e'), (2, 3, 'd');

FLUSH STATUS;

--echo # Composite PK with ORDER BY - both params on same composite PK
PREPARE stmt13 FROM 'SELECT * FROM t1 WHERE pk1 BETWEEN ? AND ? AND pk2 BETWEEN ? AND ? ORDER BY c';

SET @p1_low = 1;
SET @p1_high = 2;
SET @p2_low = 1;
SET @p2_high = 3;

--echo # Note: This won't be classified as BETWEEN pattern due to AND between two BETWEEN
EXECUTE stmt13 USING @p1_low, @p1_high, @p2_low, @p2_high;

--echo # Simple composite PK BETWEEN (only first part)
PREPARE stmt13b FROM 'SELECT * FROM t1 WHERE pk1 = ? AND pk2 = ?';
--let $before = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
SET @a = 1;
SET @b = 1;
EXECUTE stmt13b USING @a, @b;
--let $after = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_cold_classifications', Value, 1)
--let $delta = `SELECT $after - $before`
--echo Composite equality classification: $delta

DEALLOCATE PREPARE stmt13;
DEALLOCATE PREPARE stmt13b;
DROP TABLE t1;

# -----------------------------------------------------------------------
# Test 14: ORDER BY collation change invalidation
# -----------------------------------------------------------------------
--echo # === Test 14: ORDER BY collation drift invalidation ===
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  c VARCHAR(50) CHARACTER SET latin1 COLLATE latin1_swedish_ci
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'å'), (5, 'z');

FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 5;

PREPARE stmt14 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # Admit and hit
EXECUTE stmt14 USING @p_low, @p_high;
EXECUTE stmt14 USING @p_low, @p_high;
--let $hit1 = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_hits', Value, 1)
--echo Hits before collation change: $hit1

--echo # Change column collation
ALTER TABLE t1 MODIFY c VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

--echo # Execute after collation change - should invalidate
EXECUTE stmt14 USING @p_low, @p_high;
--let $invalidations = query_get_value(SHOW STATUS LIKE 'Ps_point_plan_cache_invalidations', Value, 1)
--echo Invalidation after collation change: $invalidations

DEALLOCATE PREPARE stmt14;
DROP TABLE t1;


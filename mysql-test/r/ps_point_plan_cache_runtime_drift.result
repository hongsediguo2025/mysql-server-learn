#
# Phase 4 test: ps_point_plan_cache runtime drift
# Covers retryable HOT -> COLD demotion on optimizer-switch
# and character-set / collation changes.
#
# -------------------------------------------------------
# Setup
# -------------------------------------------------------
CREATE TABLE t_inv (
id INT PRIMARY KEY,
uk INT NOT NULL,
val VARCHAR(20),
UNIQUE KEY idx_uk (uk) INVISIBLE
);
CREATE TABLE t_bin (
id VARBINARY(10) PRIMARY KEY,
val INT
);
INSERT INTO t_inv VALUES (1, 10, 'ten'), (2, 20, 'twenty');
INSERT INTO t_bin VALUES ('a', 1), ('b', 2);
# =======================================================
# A. use_invisible_indexes drift — retryable HOT -> COLD
# =======================================================
FLUSH STATUS;
SET SESSION optimizer_switch='use_invisible_indexes=on';
PREPARE stmt_inv FROM 'SELECT * FROM t_inv WHERE uk = ?';
# A1: admission with invisible unique index enabled
SET @p = 10;
EXECUTE stmt_inv USING @p;
id	uk	val
1	10	ten
admissions after A1 (expect 1): 1
# A2: disable use_invisible_indexes → fast path demotes to COLD
SET SESSION optimizer_switch='use_invisible_indexes=off';
SET @p = 20;
EXECUTE stmt_inv USING @p;
id	uk	val
2	20	twenty
fallback_runtime after A2 (expect 1): 1
admissions after A2 (expect 1): 2
hits after A2 (expect 0): 0
# A3: re-enable use_invisible_indexes → normal optimize re-admits
SET SESSION optimizer_switch='use_invisible_indexes=on';
SET @p = 20;
EXECUTE stmt_inv USING @p;
id	uk	val
2	20	twenty
admissions after A3 (expect 2): 3
hits after A3 (expect 0): 0
# A4: next EXECUTE hits fast path again
SET @p = 10;
EXECUTE stmt_inv USING @p;
id	uk	val
1	10	ten
hits after A4 (expect 1): 1
DEALLOCATE PREPARE stmt_inv;
SET SESSION optimizer_switch='use_invisible_indexes=default';
# =======================================================
# B. Charset / collation drift on binary key parameter
# =======================================================
FLUSH STATUS;
PREPARE stmt_bin FROM 'SELECT * FROM t_bin WHERE id = ?';
# B1: admit with utf8mb4 connection collation
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SET @p = 'a';
EXECUTE stmt_bin USING @p;
id	val
a	1
admissions after B1 (expect 1): 1
# B2: switch connection collation → HOT demotes to COLD
SET NAMES latin1 COLLATE latin1_swedish_ci;
SET @p = 'b';
EXECUTE stmt_bin USING @p;
id	val
b	2
fallback_runtime after B2 (expect 1): 1
admissions after B2 (expect 2): 2
hits after B2 (expect 0): 0
# B3: same collation again → fast path hit
SET @p = 'a';
EXECUTE stmt_bin USING @p;
id	val
a	1
hits after B3 (expect 1): 1
DEALLOCATE PREPARE stmt_bin;
SET character_set_client = DEFAULT;
SET character_set_results = DEFAULT;
SET collation_connection = DEFAULT;
DROP TABLE t_bin;
DROP TABLE t_inv;

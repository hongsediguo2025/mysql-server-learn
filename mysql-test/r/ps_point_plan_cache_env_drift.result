#
# ps_point_plan_cache: environment drift tests
# Covers: sql_mode drift (PAD_CHAR_TO_FULL_LENGTH),
# ANALYZE TABLE table_ref_version change, and
# RENAME INDEX / ALTER TABLE impacts.
#
# -------------------------------------------------------
# Setup
# -------------------------------------------------------
CREATE TABLE t_char_uk (
id INT AUTO_INCREMENT PRIMARY KEY,
code CHAR(10) NOT NULL,
val INT,
UNIQUE KEY idx_code (code)
) CHARACTER SET utf8mb4;
CREATE TABLE t_analyze (
id INT PRIMARY KEY,
val INT
);
CREATE TABLE t_rename_idx (
id INT PRIMARY KEY,
uk_col INT NOT NULL,
val VARCHAR(50),
UNIQUE KEY idx_old (uk_col)
);
INSERT INTO t_char_uk VALUES (1, 'ABC', 10), (2, 'DEF', 20), (3, 'GHI', 30);
INSERT INTO t_analyze VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO t_rename_idx VALUES (1, 100, 'one'), (2, 200, 'two'), (3, 300, 'three');
# =======================================================
# A. sql_mode drift — PAD_CHAR_TO_FULL_LENGTH (G11)
# =======================================================
FLUSH STATUS;
PREPARE stmt_char FROM 'SELECT * FROM t_char_uk WHERE code = ?';
# A1: admission under default sql_mode (no PAD_CHAR_TO_FULL_LENGTH)
SET @p = 'ABC';
EXECUTE stmt_char USING @p;
id	code	val
1	ABC	10
admissions after A1 (expect 1): 1
# A2: fast path hit under same sql_mode
SET @p = 'DEF';
EXECUTE stmt_char USING @p;
id	code	val
2	DEF	20
hits after A2 (expect 1): 1
# A3: enable PAD_CHAR_TO_FULL_LENGTH → G11 triggers demotion to COLD
SET SESSION sql_mode = 'PAD_CHAR_TO_FULL_LENGTH';
Warnings:
Warning	3090	Changing sql mode 'PAD_CHAR_TO_FULL_LENGTH' is deprecated. It will be removed in a future release.
SET @p = 'ABC';
EXECUTE stmt_char USING @p;
id	code	val
fallback_runtime after A3 (expect 1): 1
admissions after A3 (expect 2): 1
# A4: execute again under PAD_CHAR mode → fast path hit
SET @p = 'DEF';
EXECUTE stmt_char USING @p;
id	code	val
hits after A4 (expect 2): 1
# A5: revert sql_mode → another demotion + re-admission
SET SESSION sql_mode = DEFAULT;
SET @p = 'GHI';
EXECUTE stmt_char USING @p;
id	code	val
3	GHI	30
fallback_runtime after A5 (expect 2): 1
admissions after A5 (expect 3): 2
DEALLOCATE PREPARE stmt_char;
# =======================================================
# B. ANALYZE TABLE — table_ref_version drift
# =======================================================
FLUSH STATUS;
PREPARE stmt_az FROM 'SELECT * FROM t_analyze WHERE id = ?';
# B1: admission
SET @p = 1;
EXECUTE stmt_az USING @p;
id	val
1	10
admissions after B1 (expect 1): 1
# B2: fast path hit
SET @p = 2;
EXECUTE stmt_az USING @p;
id	val
2	20
hits after B2 (expect 1): 1
# B3: ANALYZE TABLE may update table_ref_version
ANALYZE TABLE t_analyze;
Table	Op	Msg_type	Msg_text
test.t_analyze	analyze	status	OK
SET @p = 3;
EXECUTE stmt_az USING @p;
id	val
3	30
# After ANALYZE, if version changed → fallback + re-admission;
# if version unchanged → fast path hit.  Either way, result correct.
admissions after B3: 1
hits after B3: 2
# B4: next execute should always be fast path hit now
SET @p = 1;
EXECUTE stmt_az USING @p;
id	val
1	10
hits increased after B4 (expect > previous): 3
DEALLOCATE PREPARE stmt_az;
# =======================================================
# C. RENAME INDEX via ALTER TABLE
# =======================================================
FLUSH STATUS;
PREPARE stmt_ri FROM 'SELECT * FROM t_rename_idx WHERE uk_col = ?';
# C1: admission on idx_old
SET @p = 100;
EXECUTE stmt_ri USING @p;
id	uk_col	val
1	100	one
admissions after C1 (expect 1): 1
# C2: fast path hit
SET @p = 200;
EXECUTE stmt_ri USING @p;
id	uk_col	val
2	200	two
hits after C2 (expect 1): 1
# C3: RENAME INDEX → DDL triggers reprepare, plan cache reset
ALTER TABLE t_rename_idx RENAME INDEX idx_old TO idx_new;
SET @p = 300;
EXECUTE stmt_ri USING @p;
id	uk_col	val
3	300	three
# After RENAME INDEX: reprepare → re-classify → re-admit
admissions after C3 (expect 2): 2
# C4: fast path hit with renamed index
SET @p = 100;
EXECUTE stmt_ri USING @p;
id	uk_col	val
1	100	one
hits after C4 (expect 2): 2
DEALLOCATE PREPARE stmt_ri;
# =======================================================
# D. ALTER TABLE ADD COLUMN (INSTANT) — reprepare chain
# =======================================================
FLUSH STATUS;
CREATE TABLE t_instant (
id INT PRIMARY KEY,
val INT
);
INSERT INTO t_instant VALUES (1, 10), (2, 20);
PREPARE stmt_inst FROM 'SELECT * FROM t_instant WHERE id = ?';
# D1: admission
SET @p = 1;
EXECUTE stmt_inst USING @p;
id	val
1	10
admissions after D1 (expect 1): 1
# D2: ADD COLUMN triggers reprepare
ALTER TABLE t_instant ADD COLUMN extra INT DEFAULT 0;
SET @p = 2;
EXECUTE stmt_inst USING @p;
id	val	extra
2	20	0
admissions after D2 (expect 2): 2
# D3: fast path hit with new schema
SET @p = 1;
EXECUTE stmt_inst USING @p;
id	val	extra
1	10	0
hits after D3 (expect 1): 1
DEALLOCATE PREPARE stmt_inst;
DROP TABLE t_instant;
# -------------------------------------------------------
# Cleanup
# -------------------------------------------------------
DROP TABLE t_char_uk;
DROP TABLE t_analyze;
DROP TABLE t_rename_idx;

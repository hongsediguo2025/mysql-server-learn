#
# Phase 1 extended test: comprehensive classification branch coverage
# with background DML operations and reprepare scenarios.
#
# Covers code branches in ps_point_plan_classify() and
# ps_point_plan_extract_where_shape() not exercised by
# ps_point_plan_cache_classify.test.
#
# -------------------------------------------------------
# Setup
# -------------------------------------------------------
CREATE TABLE t1 (
id INT PRIMARY KEY,
val VARCHAR(100),
uk INT NOT NULL,
UNIQUE KEY idx_uk (uk)
);
INSERT INTO t1 VALUES (1, 'alpha', 100), (2, 'beta', 200), (3, 'gamma', 300);
CREATE TABLE t2 (
id INT PRIMARY KEY,
t1_id INT,
memo TEXT
);
INSERT INTO t2 VALUES (1, 1, 'join-a'), (2, 2, 'join-b');
CREATE TABLE t_comp3 (
a INT NOT NULL, b INT NOT NULL, c INT NOT NULL,
val VARCHAR(50),
PRIMARY KEY (a, b, c)
);
INSERT INTO t_comp3 VALUES (1,1,1,'x'), (1,2,3,'y'), (2,1,1,'z');
CREATE TABLE t_comp4 (
a INT NOT NULL, b INT NOT NULL, c INT NOT NULL, d INT NOT NULL,
val VARCHAR(50),
PRIMARY KEY (a, b, c, d)
);
INSERT INTO t_comp4 VALUES (1,1,1,1,'w'), (2,2,2,2,'v');
CREATE TABLE t_wide (
c1 INT NOT NULL, c2 INT NOT NULL, c3 INT NOT NULL,
c4 INT NOT NULL, c5 INT NOT NULL,
val VARCHAR(50),
PRIMARY KEY (c1, c2, c3, c4, c5)
);
INSERT INTO t_wide VALUES (1,1,1,1,1,'five');
CREATE TABLE t_nouk (
id INT,
val VARCHAR(100),
KEY idx_id (id)
);
INSERT INTO t_nouk VALUES (1, 'one'), (2, 'two');
CREATE TABLE t_ft (
id INT PRIMARY KEY,
content TEXT,
FULLTEXT KEY ft_content (content)
) ENGINE=InnoDB;
INSERT INTO t_ft VALUES (1, 'hello world'), (2, 'foo bar baz');
CREATE TABLE t_dml (
id INT PRIMARY KEY,
val VARCHAR(100)
);
INSERT INTO t_dml VALUES (1, 'one'), (2, 'two'), (3, 'three');
CREATE TABLE t_ddl (
id INT PRIMARY KEY,
val VARCHAR(100)
);
INSERT INTO t_ddl VALUES (1, 'aaa'), (2, 'bbb');
CREATE ALGORITHM=TEMPTABLE VIEW v_temp AS SELECT id, val, uk FROM t1;
FLUSH STATUS;
# ===========================================================
# Section A: NEVER classification branches
# ===========================================================
# -------------------------------------------------------
# A1. > PS_PC_MAX_PARAMS (5 params in composite AND) — NEVER
# -------------------------------------------------------
PREPARE stmt_a1 FROM 'SELECT * FROM t_wide WHERE c1=? AND c2=? AND c3=? AND c4=? AND c5=?';
cold_delta (>4 params): 0
DEALLOCATE PREPARE stmt_a1;
# -------------------------------------------------------
# A2. UNION query — NEVER (!is_simple)
# -------------------------------------------------------
PREPARE stmt_a2 FROM 'SELECT * FROM t1 WHERE id = ? UNION SELECT * FROM t1 WHERE id = ?';
cold_delta (UNION): 0
DEALLOCATE PREPARE stmt_a2;
# -------------------------------------------------------
# A3. LEFT JOIN — NEVER (outer_join != 0)
# -------------------------------------------------------
PREPARE stmt_a3 FROM 'SELECT t1.val FROM t1 LEFT JOIN t2 ON t1.id = t2.t1_id WHERE t1.id = ?';
cold_delta (LEFT JOIN): 0
DEALLOCATE PREPARE stmt_a3;
# -------------------------------------------------------
# A4. RIGHT JOIN — NEVER (outer_join != 0)
# -------------------------------------------------------
PREPARE stmt_a4 FROM 'SELECT t2.memo FROM t1 RIGHT JOIN t2 ON t1.id = t2.t1_id WHERE t2.id = ?';
cold_delta (RIGHT JOIN): 0
DEALLOCATE PREPARE stmt_a4;
# -------------------------------------------------------
# A5. Window function — NEVER (has_windows)
# -------------------------------------------------------
PREPARE stmt_a5 FROM 'SELECT *, ROW_NUMBER() OVER() AS rn FROM t1 WHERE id = ?';
cold_delta (window function): 0
DEALLOCATE PREPARE stmt_a5;
# -------------------------------------------------------
# A6. TEMPTABLE view — NEVER (!is_base_table or leaf_table_count)
# -------------------------------------------------------
PREPARE stmt_a6 FROM 'SELECT * FROM v_temp WHERE id = ?';
cold_delta (TEMPTABLE view): 0
DEALLOCATE PREPARE stmt_a6;
# -------------------------------------------------------
# A7. OR predicate — NEVER (COND_OR_FUNC)
# -------------------------------------------------------
PREPARE stmt_a7 FROM 'SELECT * FROM t1 WHERE id = ? OR uk = ?';
cold_delta (OR predicate): 0
DEALLOCATE PREPARE stmt_a7;
# -------------------------------------------------------
# A8. Mixed AND: equality + range — NEVER (non-EQ in AND child)
# -------------------------------------------------------
PREPARE stmt_a8 FROM 'SELECT * FROM t1 WHERE id = ? AND uk > ?';
cold_delta (mixed AND eq+range): 0
DEALLOCATE PREPARE stmt_a8;
# -------------------------------------------------------
# A9. Literal in AND: field=literal AND field=? — NEVER
# -------------------------------------------------------
PREPARE stmt_a9 FROM 'SELECT * FROM t1 WHERE id = 1 AND uk = ?';
cold_delta (literal in AND): 0
DEALLOCATE PREPARE stmt_a9;
# -------------------------------------------------------
# A10. IN predicate — NEVER (not EQ_FUNC, not AND)
# -------------------------------------------------------
PREPARE stmt_a10 FROM 'SELECT * FROM t1 WHERE id IN (?, ?)';
cold_delta (IN predicate): 0
DEALLOCATE PREPARE stmt_a10;
# -------------------------------------------------------
# A11. LIKE predicate — NEVER (LIKE_FUNC, not EQ_FUNC)
# -------------------------------------------------------
PREPARE stmt_a11 FROM 'SELECT * FROM t1 WHERE val LIKE ?';
cold_delta (LIKE): 0
DEALLOCATE PREPARE stmt_a11;
# -------------------------------------------------------
# A12. BETWEEN predicate — COLD (simple range candidate)
# -------------------------------------------------------
PREPARE stmt_a12 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ?';
cold_delta (BETWEEN): 1
DEALLOCATE PREPARE stmt_a12;
# -------------------------------------------------------
# A13. NULL-safe equal <=> — NEVER (EQUAL_FUNC, not EQ_FUNC)
# -------------------------------------------------------
PREPARE stmt_a13 FROM 'SELECT * FROM t1 WHERE id <=> ?';
cold_delta (NULL-safe equal): 0
DEALLOCATE PREPARE stmt_a13;
# -------------------------------------------------------
# A14. Arithmetic expression in WHERE: (id+0)=? — NEVER
#      LHS is Item_func_plus, not Item_field
# -------------------------------------------------------
PREPARE stmt_a14 FROM 'SELECT * FROM t1 WHERE id + 0 = ?';
cold_delta (expression WHERE): 0
DEALLOCATE PREPARE stmt_a14;
# -------------------------------------------------------
# A15. UPDATE — NEVER (sql_command != SQLCOM_SELECT)
# -------------------------------------------------------
PREPARE stmt_a15 FROM 'UPDATE t1 SET val = ? WHERE id = ?';
cold_delta (UPDATE): 0
DEALLOCATE PREPARE stmt_a15;
# -------------------------------------------------------
# A16. DELETE — NEVER (sql_command != SQLCOM_SELECT)
# -------------------------------------------------------
PREPARE stmt_a16 FROM 'DELETE FROM t1 WHERE id = ?';
cold_delta (DELETE): 0
DEALLOCATE PREPARE stmt_a16;
# -------------------------------------------------------
# A17. Param in SELECT list, no WHERE — NEVER (where == nullptr)
# -------------------------------------------------------
PREPARE stmt_a17 FROM 'SELECT ? AS x FROM t1';
cold_delta (param in SELECT, no WHERE): 0
DEALLOCATE PREPARE stmt_a17;
# -------------------------------------------------------
# A18. FULLTEXT MATCH in SELECT list + eq WHERE — NEVER (has_ft_funcs)
# -------------------------------------------------------
PREPARE stmt_a18 FROM 'SELECT id, MATCH(content) AGAINST (''hello'') AS score FROM t_ft WHERE id = ?';
cold_delta (FULLTEXT MATCH): 0
DEALLOCATE PREPARE stmt_a18;
# ===========================================================
# Section B: Additional COLD classification edge cases
# ===========================================================
# -------------------------------------------------------
# B1. 3-column composite equality — COLD
# -------------------------------------------------------
PREPARE stmt_b1 FROM 'SELECT * FROM t_comp3 WHERE a = ? AND b = ? AND c = ?';
cold_delta (3-col composite): 1
DEALLOCATE PREPARE stmt_b1;
# -------------------------------------------------------
# B2. 4-column composite equality (PS_PC_MAX_PARAMS boundary) — COLD
# -------------------------------------------------------
PREPARE stmt_b2 FROM 'SELECT * FROM t_comp4 WHERE a = ? AND b = ? AND c = ? AND d = ?';
cold_delta (4-col composite max): 1
DEALLOCATE PREPARE stmt_b2;
# -------------------------------------------------------
# B3. Table with no unique key — COLD (Phase 1 shape-only)
# -------------------------------------------------------
PREPARE stmt_b3 FROM 'SELECT * FROM t_nouk WHERE id = ?';
cold_delta (no unique key table): 1
DEALLOCATE PREPARE stmt_b3;
# -------------------------------------------------------
# B4. Non-star SELECT columns — COLD
# -------------------------------------------------------
PREPARE stmt_b4 FROM 'SELECT id, val FROM t1 WHERE id = ?';
cold_delta (specific columns): 1
DEALLOCATE PREPARE stmt_b4;
# -------------------------------------------------------
# B5. SELECT ... FOR UPDATE — COLD (lock mode not checked in Phase 1)
# -------------------------------------------------------
PREPARE stmt_b5 FROM 'SELECT * FROM t1 WHERE id = ? FOR UPDATE';
cold_delta (FOR UPDATE): 1
DEALLOCATE PREPARE stmt_b5;
# -------------------------------------------------------
# B6. Reversed argument order: ? = id — COLD
#     Tests extract_eq_field_param (PARAM, FIELD) branch
# -------------------------------------------------------
PREPARE stmt_b6 FROM 'SELECT * FROM t1 WHERE ? = id';
cold_delta (reversed ? = field): 1
DEALLOCATE PREPARE stmt_b6;
# -------------------------------------------------------
# B7. Reversed composite key order: pk2 = ? AND pk1 = ? — COLD
#     Phase 1 does not check key coverage or column order
# -------------------------------------------------------
PREPARE stmt_b7 FROM 'SELECT * FROM t_comp3 WHERE c = ? AND a = ?';
cold_delta (reversed composite order): 1
DEALLOCATE PREPARE stmt_b7;
# ===========================================================
# Section C: Execution correctness with background DML
# Verifies that COLD classification does not interfere with
# normal execution when data is modified between EXECUTEs.
# ===========================================================
PREPARE stmt_dml FROM 'SELECT val FROM t_dml WHERE id = ?';
cold_delta (DML test PREPARE): 1
# -------------------------------------------------------
# C1. Initial execute — should find existing row
# -------------------------------------------------------
SET @p = 1;
EXECUTE stmt_dml USING @p;
val
one
# -------------------------------------------------------
# C2. INSERT new row, execute with new key
# -------------------------------------------------------
INSERT INTO t_dml VALUES (4, 'four');
SET @p = 4;
EXECUTE stmt_dml USING @p;
val
four
# -------------------------------------------------------
# C3. UPDATE the row, execute again — should see new value
# -------------------------------------------------------
UPDATE t_dml SET val = 'FOUR' WHERE id = 4;
EXECUTE stmt_dml USING @p;
val
FOUR
# -------------------------------------------------------
# C4. DELETE the row, execute — should return empty
# -------------------------------------------------------
DELETE FROM t_dml WHERE id = 4;
EXECUTE stmt_dml USING @p;
val
# -------------------------------------------------------
# C5. Re-insert different value and verify
# -------------------------------------------------------
INSERT INTO t_dml VALUES (4, 'four_v2');
EXECUTE stmt_dml USING @p;
val
four_v2
# -------------------------------------------------------
# C6. Bulk DML: insert, update multiple, then query
# -------------------------------------------------------
INSERT INTO t_dml VALUES (5, 'five'), (6, 'six');
UPDATE t_dml SET val = UPPER(val) WHERE id IN (5, 6);
SET @p = 5;
EXECUTE stmt_dml USING @p;
val
FIVE
SET @p = 6;
EXECUTE stmt_dml USING @p;
val
SIX
# -------------------------------------------------------
# C7. Delete all test rows, restore original data
# -------------------------------------------------------
DELETE FROM t_dml WHERE id >= 4;
SET @p = 1;
EXECUTE stmt_dml USING @p;
val
one
SET @p = 999;
EXECUTE stmt_dml USING @p;
val
DEALLOCATE PREPARE stmt_dml;
# -------------------------------------------------------
# C8. Multi-PS interleaved with DML on same table
# -------------------------------------------------------
PREPARE stmt_pk FROM 'SELECT val FROM t_dml WHERE id = ?';
PREPARE stmt_all FROM 'SELECT id, val FROM t_dml ORDER BY id';
SET @p = 2;
EXECUTE stmt_pk USING @p;
val
two
EXECUTE stmt_all;
id	val
1	one
2	two
3	three
INSERT INTO t_dml VALUES (10, 'ten');
SET @p = 10;
EXECUTE stmt_pk USING @p;
val
ten
EXECUTE stmt_all;
id	val
1	one
2	two
3	three
10	ten
DELETE FROM t_dml WHERE id = 10;
EXECUTE stmt_all;
id	val
1	one
2	two
3	three
DEALLOCATE PREPARE stmt_pk;
DEALLOCATE PREPARE stmt_all;
# ===========================================================
# Section D: DDL-triggered reprepare and counter behaviour
# ===========================================================
# -------------------------------------------------------
# D1. ALTER TABLE ADD COLUMN → reprepare → counter +1
# -------------------------------------------------------
PREPARE stmt_d1 FROM 'SELECT * FROM t_ddl WHERE id = ?';
ALTER TABLE t_ddl ADD COLUMN extra INT DEFAULT 0;
SET @p = 1;
EXECUTE stmt_d1 USING @p;
id	val	extra
1	aaa	0
cold_delta after ALTER+reprepare: 1
ALTER TABLE t_ddl DROP COLUMN extra;
DEALLOCATE PREPARE stmt_d1;
# -------------------------------------------------------
# D2. TRUNCATE TABLE → reprepare → counter +1
# -------------------------------------------------------
INSERT INTO t_ddl VALUES (10, 'temp');
PREPARE stmt_d2 FROM 'SELECT * FROM t_ddl WHERE id = ?';
SET @p = 10;
EXECUTE stmt_d2 USING @p;
id	val
10	temp
TRUNCATE TABLE t_ddl;
SET @p = 1;
EXECUTE stmt_d2 USING @p;
id	val
cold_delta after TRUNCATE+reprepare: 1
DEALLOCATE PREPARE stmt_d2;
# -------------------------------------------------------
# D3. Plain EXECUTE does NOT increment cold_classifications
# -------------------------------------------------------
INSERT INTO t_ddl VALUES (1, 'aaa'), (2, 'bbb');
PREPARE stmt_d3 FROM 'SELECT * FROM t_ddl WHERE id = ?';
SET @p = 1;
EXECUTE stmt_d3 USING @p;
id	val
1	aaa
SET @p = 2;
EXECUTE stmt_d3 USING @p;
id	val
2	bbb
SET @p = 1;
EXECUTE stmt_d3 USING @p;
id	val
1	aaa
cold_delta after 3 EXECUTEs (no reprepare): 0
DEALLOCATE PREPARE stmt_d3;
# -------------------------------------------------------
# D4. Sysvar toggle: ON → PREPARE (COLD) → OFF → PREPARE (NEVER)
# -------------------------------------------------------
PREPARE stmt_d4a FROM 'SELECT * FROM t1 WHERE id = ?';
cold_delta PREPARE with sysvar ON: 1
SET SESSION ps_point_plan_cache = FALSE;
PREPARE stmt_d4b FROM 'SELECT * FROM t1 WHERE uk = ?';
cold_delta PREPARE with sysvar OFF: 0
SET SESSION ps_point_plan_cache = TRUE;
DEALLOCATE PREPARE stmt_d4a;
DEALLOCATE PREPARE stmt_d4b;
# ===========================================================
# Section F: Abnormal / edge-case scenarios
# ===========================================================
# -------------------------------------------------------
# F1. Multiple sequential reprepares — counter +1 each time
# -------------------------------------------------------
CREATE TABLE t_repr (id INT PRIMARY KEY, val VARCHAR(100));
INSERT INTO t_repr VALUES (1, 'a'), (2, 'b');
PREPARE stmt_f1 FROM 'SELECT * FROM t_repr WHERE id = ?';
ALTER TABLE t_repr ADD COLUMN c1 INT DEFAULT 0;
SET @p = 1;
EXECUTE stmt_f1 USING @p;
id	val	c1
1	a	0
ALTER TABLE t_repr ADD COLUMN c2 INT DEFAULT 0;
SET @p = 1;
EXECUTE stmt_f1 USING @p;
id	val	c1	c2
1	a	0	0
cold_delta after 2 sequential reprepares: 2
ALTER TABLE t_repr DROP COLUMN c2;
ALTER TABLE t_repr DROP COLUMN c1;
DEALLOCATE PREPARE stmt_f1;
DROP TABLE t_repr;
# -------------------------------------------------------
# F2. Sysvar OFF during reprepare — classify returns false
#     Stmt was COLD at PREPARE; sysvar toggled OFF before DDL
#     triggers reprepare — reclassification sees sysvar OFF.
# -------------------------------------------------------
CREATE TABLE t_soff (id INT PRIMARY KEY, val VARCHAR(100));
INSERT INTO t_soff VALUES (1, 'a');
PREPARE stmt_f2 FROM 'SELECT * FROM t_soff WHERE id = ?';
SET SESSION ps_point_plan_cache = FALSE;
ALTER TABLE t_soff ADD COLUMN extra INT DEFAULT 0;
SET @p = 1;
EXECUTE stmt_f2 USING @p;
id	val	extra
1	a	0
cold_delta reprepare with sysvar OFF: 0
SET SESSION ps_point_plan_cache = TRUE;
ALTER TABLE t_soff DROP COLUMN extra;
DEALLOCATE PREPARE stmt_f2;
DROP TABLE t_soff;
# -------------------------------------------------------
# F3. Sysvar OFF at PREPARE, ON at reprepare
#     Stmt was NEVER (sysvar OFF); sysvar toggled ON before
#     DDL triggers reprepare — reclassification sees sysvar ON.
# -------------------------------------------------------
CREATE TABLE t_son (id INT PRIMARY KEY, val VARCHAR(100));
INSERT INTO t_son VALUES (1, 'a');
SET SESSION ps_point_plan_cache = FALSE;
PREPARE stmt_f3 FROM 'SELECT * FROM t_son WHERE id = ?';
SET SESSION ps_point_plan_cache = TRUE;
ALTER TABLE t_son ADD COLUMN extra INT DEFAULT 0;
SET @p = 1;
EXECUTE stmt_f3 USING @p;
id	val	extra
1	a	0
cold_delta reprepare with sysvar ON (was OFF): 1
ALTER TABLE t_son DROP COLUMN extra;
DEALLOCATE PREPARE stmt_f3;
DROP TABLE t_son;
# -------------------------------------------------------
# F4. Re-PREPARE same name: candidate → non-candidate
#     Old PS (COLD) is implicitly deallocated; new PS classified.
# -------------------------------------------------------
PREPARE stmt_reuse FROM 'SELECT * FROM t1 WHERE id = ?';
PREPARE stmt_reuse FROM 'SELECT * FROM t1 WHERE id > ?';
cold_delta re-PREPARE candidate->non-candidate: 0
DEALLOCATE PREPARE stmt_reuse;
# -------------------------------------------------------
# F5. Re-PREPARE same name: non-candidate → candidate
# -------------------------------------------------------
PREPARE stmt_reuse FROM 'SELECT * FROM t1 WHERE id > ?';
PREPARE stmt_reuse FROM 'SELECT * FROM t1 WHERE id = ?';
cold_delta re-PREPARE non-candidate->candidate: 1
DEALLOCATE PREPARE stmt_reuse;
# -------------------------------------------------------
# F6. Temporary table — should be COLD (is_base_table() = true)
# -------------------------------------------------------
CREATE TEMPORARY TABLE t_temp (id INT PRIMARY KEY, val VARCHAR(100));
INSERT INTO t_temp VALUES (1, 'tmp_a'), (2, 'tmp_b');
PREPARE stmt_f6 FROM 'SELECT * FROM t_temp WHERE id = ?';
cold_delta (temporary table): 1
SET @p = 1;
EXECUTE stmt_f6 USING @p;
id	val
1	tmp_a
DEALLOCATE PREPARE stmt_f6;
DROP TEMPORARY TABLE t_temp;
# -------------------------------------------------------
# F7. Table alias: SELECT * FROM t1 AS a WHERE a.id = ?
#     Alias does not affect table_ref matching.
# -------------------------------------------------------
PREPARE stmt_f7 FROM 'SELECT * FROM t1 AS a WHERE a.id = ?';
cold_delta (table alias): 1
DEALLOCATE PREPARE stmt_f7;
# -------------------------------------------------------
# F8. Duplicate field in AND: WHERE id = ? AND id = ?
#     Degenerate input — both equalities on same column.
#     Shape B: 2 EQ_FUNC(field, param), both succeed. → COLD
# -------------------------------------------------------
PREPARE stmt_f8 FROM 'SELECT * FROM t1 WHERE id = ? AND id = ?';
cold_delta (duplicate field in AND): 1
DEALLOCATE PREPARE stmt_f8;
# -------------------------------------------------------
# F9. NOT wrapping equality: WHERE NOT (id = ?)
#     WHERE type = FUNC_ITEM, functype = NOT_FUNC → NEVER
# -------------------------------------------------------
PREPARE stmt_f9 FROM 'SELECT * FROM t1 WHERE NOT (id = ?)';
cold_delta (NOT wrapping equality): 0
DEALLOCATE PREPARE stmt_f9;
# -------------------------------------------------------
# F10. Aggregate without GROUP BY: SELECT COUNT(*) WHERE id = ?
#      is_grouped() returns true because m_agg_func_used is set
#      by COUNT(*), even without explicit GROUP BY. → NEVER.
# -------------------------------------------------------
PREPARE stmt_f10 FROM 'SELECT COUNT(*) FROM t1 WHERE id = ?';
cold_delta (aggregate no GROUP BY): 1
DEALLOCATE PREPARE stmt_f10;
# -------------------------------------------------------
# F11. Tautological AND: WHERE id = ? AND 1=1
#      MySQL resolver may simplify to just WHERE id = ?.
#      If simplified: Shape A → COLD.
#      If not simplified: Shape B, second child 1=1 has
#      non-PARAM arg → NEVER.
# -------------------------------------------------------
PREPARE stmt_f11 FROM 'SELECT * FROM t1 WHERE id = ? AND 1=1';
cold_delta (tautological AND 1=1): 1
DEALLOCATE PREPARE stmt_f11;
# -------------------------------------------------------
# F12. Multi-session counter isolation
#      A separate connection's classification should not
#      affect the current session's counter.
# -------------------------------------------------------
PREPARE stmt_con1 FROM 'SELECT * FROM t1 WHERE id = ?';
con1 cold_delta (isolated session): 1
DEALLOCATE PREPARE stmt_con1;
# Verify default session still classifies correctly after switch-back
PREPARE stmt_f12 FROM 'SELECT * FROM t1 WHERE uk = ?';
default session cold_delta after switch-back: 1
DEALLOCATE PREPARE stmt_f12;
# ===========================================================
# Section E: Final counter snapshot
# ===========================================================
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admissions	9
Ps_point_plan_cache_cold_classifications	29
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	11
Ps_point_plan_cache_invalidations	0
# -------------------------------------------------------
# Cleanup
# -------------------------------------------------------
DROP VIEW v_temp;
DROP TABLE t_ft;
DROP TABLE t_nouk;
DROP TABLE t_wide;
DROP TABLE t_comp4;
DROP TABLE t_comp3;
DROP TABLE t_ddl;
DROP TABLE t_dml;
DROP TABLE t2;
DROP TABLE t1;
#
# End of Phase 1 extended classification test
#

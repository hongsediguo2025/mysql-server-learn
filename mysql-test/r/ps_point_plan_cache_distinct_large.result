# === Test 3: Very small sort_buffer_size (16KB) ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c CHAR(50) NOT NULL DEFAULT '',
k INT NOT NULL
);
# Insert 500 rows
INSERT INTO t1
SELECT
seq AS id,
CONCAT('item-', (seq % 25)) AS c,
(seq % 25) AS k
FROM (
WITH RECURSIVE cte(seq) AS (
SELECT 1 UNION ALL SELECT seq + 1 FROM cte WHERE seq < 500
)
SELECT seq FROM cte
) AS seq_table;
# Very small sort_buffer_size - forces immediate external merge
SET SESSION sort_buffer_size = 16384;

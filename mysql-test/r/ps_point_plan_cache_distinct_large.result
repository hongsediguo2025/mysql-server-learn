# === Test 5: Boundary case - data near sort_buffer_size limit ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c CHAR(100) NOT NULL DEFAULT ''
);
# Insert rows that will be close to sort_buffer_size boundary
INSERT INTO t1
SELECT
seq AS id,
CONCAT('boundary-', (seq % 20)) AS c
FROM (
WITH RECURSIVE cte(seq) AS (
SELECT 1 UNION ALL SELECT seq + 1 FROM cte WHERE seq < 200
)
SELECT seq FROM cte
) AS seq_table;
# Use sort_buffer_size that might cause edge cases
SET SESSION sort_buffer_size = 49152;
FLUSH STATUS;
SET @lo = 1, @hi = 200;
PREPARE stmt_boundary FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt_boundary USING @lo, @hi;
c

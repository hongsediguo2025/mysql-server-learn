# === Test 6: Large data - ensure DISTINCT still preferred over aggregation ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c CHAR(80) NOT NULL DEFAULT '',
padding CHAR(180) NOT NULL DEFAULT ''
);
INSERT INTO t1
SELECT
seq AS id,
CONCAT('unique-', LPAD(seq % 60, 3, '0')) AS c,
REPEAT('w', 180) AS padding
FROM (
WITH RECURSIVE cte(seq) AS (
SELECT 1 UNION ALL SELECT seq + 1 FROM cte WHERE seq < 1200
)
SELECT seq FROM cte
) AS seq_table;
SET SESSION sort_buffer_size = 28672;
Warnings:
Warning	1292	Truncated incorrect sort_buffer_size value: '28672'
FLUSH STATUS;
SET @lo = 1, @hi = 1200;
# DISTINCT with external sort should still be admitted
PREPARE stmt_dedup FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt_dedup USING @lo, @hi;
c

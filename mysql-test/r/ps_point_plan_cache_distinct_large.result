SET SESSION cte_max_recursion_depth = 2000;
DROP TABLE IF EXISTS t1;
SET SESSION ps_point_plan_cache = ON;
# === Test 1: Large data - external merge sort dedup ===
# This test exercises the external merge sort path when data
# exceeds sort_buffer_size. The plan cache should still work
# correctly even when Filesort needs to spill to disk.
CREATE TABLE t1 (
id INT PRIMARY KEY,
c CHAR(100) NOT NULL DEFAULT '',
padding CHAR(200) NOT NULL DEFAULT ''
);
# Insert many rows with repeating values to force dedup work
# Using ~1000 rows with small sort_buffer_size will trigger external sort
INSERT INTO t1
SELECT
seq AS id,
CONCAT('value-', (seq % 50)) AS c,
REPEAT('x', 200) AS padding
FROM (
WITH RECURSIVE cte(seq) AS (
SELECT 1 UNION ALL SELECT seq + 1 FROM cte WHERE seq < 1000
)
SELECT seq FROM cte
) AS seq_table;
# Set a small sort_buffer_size to force external merge sort
SET SESSION sort_buffer_size = 32768;
sort_buffer_size set to 32KB
FLUSH STATUS;
SET @lo = 1, @hi = 1000;
# First execute - should be admitted to HOT even with external sort
PREPARE stmt_large FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt_large USING @lo, @hi;
c

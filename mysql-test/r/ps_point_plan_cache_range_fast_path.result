#
# Phase 7 test: ps_point_plan_cache simple_ranges fast path
# Verifies HOT RANGE_PK_BETWEEN statements hit the fast path and
# still return correct range results across normal and edge cases.
#
# -------------------------------------------------------
# Setup
# -------------------------------------------------------
CREATE TABLE t_range_fp (
id INT PRIMARY KEY,
c VARCHAR(64)
);
INSERT INTO t_range_fp VALUES
(1, 'a'),
(2, 'b'),
(3, 'c'),
(4, 'd'),
(5, 'e');
FLUSH STATUS;
# -------------------------------------------------------
# 1. PK BETWEEN — second EXECUTE hits fast path
# -------------------------------------------------------
PREPARE stmt_rf1 FROM 'SELECT c FROM t_range_fp WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = 3;
EXECUTE stmt_rf1 USING @l, @h;
c
a
b
c
SET @l = 2;
SET @h = 4;
EXECUTE stmt_rf1 USING @l, @h;
c
b
c
d
admissions delta after second execute: 0
hits delta after second execute: 1
DEALLOCATE PREPARE stmt_rf1;
# -------------------------------------------------------
# 2. Single-row range — hot execute returns one row
# -------------------------------------------------------
PREPARE stmt_rf2 FROM 'SELECT c FROM t_range_fp WHERE id BETWEEN ? AND ?';
SET @l = 3;
SET @h = 3;
EXECUTE stmt_rf2 USING @l, @h;
c
c
SET @l = 4;
SET @h = 4;
EXECUTE stmt_rf2 USING @l, @h;
c
d
hits delta after single-row hot execute: 1
DEALLOCATE PREPARE stmt_rf2;
# -------------------------------------------------------
# 3. Empty result on hot path
# -------------------------------------------------------
PREPARE stmt_rf3 FROM 'SELECT c FROM t_range_fp WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = 2;
EXECUTE stmt_rf3 USING @l, @h;
c
a
b
SET @l = 8;
SET @h = 9;
EXECUTE stmt_rf3 USING @l, @h;
c
hits delta after empty hot execute: 1
DEALLOCATE PREPARE stmt_rf3;
# -------------------------------------------------------
# 4. Consecutive hot executes accumulate hits
# -------------------------------------------------------
PREPARE stmt_rf4 FROM 'SELECT c FROM t_range_fp WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = 5;
EXECUTE stmt_rf4 USING @l, @h;
c
a
b
c
d
e
SET @l = 1;
SET @h = 1;
EXECUTE stmt_rf4 USING @l, @h;
c
a
SET @l = 2;
SET @h = 3;
EXECUTE stmt_rf4 USING @l, @h;
c
b
c
SET @l = 4;
SET @h = 5;
EXECUTE stmt_rf4 USING @l, @h;
c
d
e
hits delta after 3 consecutive hot executes: 3
DEALLOCATE PREPARE stmt_rf4;
# -------------------------------------------------------
# 5. DML visibility — hot path sees latest rows
# -------------------------------------------------------
PREPARE stmt_rf5 FROM 'SELECT id, c FROM t_range_fp WHERE id BETWEEN ? AND ?';
SET @l = 1;
SET @h = 3;
EXECUTE stmt_rf5 USING @l, @h;
id	c
1	a
2	b
3	c
UPDATE t_range_fp SET c = 'bb' WHERE id = 2;
DELETE FROM t_range_fp WHERE id = 3;
INSERT INTO t_range_fp VALUES (6, 'f');
SET @l = 2;
SET @h = 6;
EXECUTE stmt_rf5 USING @l, @h;
id	c
2	bb
4	d
5	e
6	f
hits delta after DML-visible hot execute: 1
DEALLOCATE PREPARE stmt_rf5;
# -------------------------------------------------------
# Final counter summary
# -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admission_refused	0
Ps_point_plan_cache_admissions	5
Ps_point_plan_cache_cached_plans	0
Ps_point_plan_cache_cold_classifications	5
Ps_point_plan_cache_evictions	0
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	7
Ps_point_plan_cache_invalidations	0
Ps_point_plan_cache_mem_used	0
# -------------------------------------------------------
# Cleanup
# -------------------------------------------------------
DROP TABLE t_range_fp;
#
# End of Phase 7 range fast-path test
#

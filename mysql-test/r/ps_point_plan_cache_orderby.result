# === Test 1: Basic ORDER BY ASC ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50),
k INT
);
INSERT INTO t1 VALUES
(1, 'z', 100), (2, 'y', 200), (3, 'x', 300),
(4, 'w', 400), (5, 'v', 500);
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 5;
PREPARE stmt1 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c ASC';
Classification result (should be 1 for COLD): 0
# First execute - should admit to HOT
EXECUTE stmt1 USING @p_low, @p_high;
id	c	k
5	v	500
4	w	400
3	x	300
2	y	200
1	z	100
Admissions after first execute: 1
# Second execute - should be cache HIT
EXECUTE stmt1 USING @p_low, @p_high;
id	c	k
5	v	500
4	w	400
3	x	300
2	y	200
1	z	100
Cache hits: 1
# Verify results are correct (ordered by c)
EXECUTE stmt1 USING @p_low, @p_high;
id	c	k
5	v	500
4	w	400
3	x	300
2	y	200
1	z	100
DEALLOCATE PREPARE stmt1;
DROP TABLE t1;
# === Test 2: Basic ORDER BY DESC ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 4;
PREPARE stmt2 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c DESC';
EXECUTE stmt2 USING @p_low, @p_high;
id	c
4	d
3	c
2	b
1	a
EXECUTE stmt2 USING @p_low, @p_high;
id	c
4	d
3	c
2	b
1	a
Cache hits for DESC order: 1
DEALLOCATE PREPARE stmt2;
DROP TABLE t1;
# === Test 3: ORDER BY with INT column ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
val INT
);
INSERT INTO t1 VALUES (1, 50), (2, 10), (3, 90), (4, 30), (5, 70);
SET @p_low = 1;
SET @p_high = 5;
PREPARE stmt3 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY val';
EXECUTE stmt3 USING @p_low, @p_high;
id	val
2	10
4	30
1	50
5	70
3	90
EXECUTE stmt3 USING @p_low, @p_high;
id	val
2	10
4	30
1	50
5	70
3	90
Cache hits: 2
DEALLOCATE PREPARE stmt3;
DROP TABLE t1;
# === Test 4: ORDER BY + aggregate should be NEVER ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50),
k INT
);
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);
FLUSH STATUS;
# This query has both aggregate and ORDER BY - should be NEVER
PREPARE stmt4 FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
SET @a = 1;
SET @b = 3;
EXECUTE stmt4 USING @a, @b;
SUM(k)
60
Classification delta (should be 0 - NEVER): 0
DEALLOCATE PREPARE stmt4;
DROP TABLE t1;
# === Test 5: Multi-column ORDER BY should be NEVER ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c1 VARCHAR(50),
c2 VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a', 'x'), (2, 'b', 'y');
FLUSH STATUS;
PREPARE stmt5 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c1, c2';
SET @a = 1;
SET @b = 2;
EXECUTE stmt5 USING @a, @b;
id	c1	c2
1	a	x
2	b	y
Classification delta (should be 0): 0
DEALLOCATE PREPARE stmt5;
DROP TABLE t1;
# === Test 6: ORDER BY expression should be NEVER ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
val INT
);
INSERT INTO t1 VALUES (1, 10), (2, 20);
FLUSH STATUS;
PREPARE stmt6 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY val + 1';
SET @a = 1;
SET @b = 2;
EXECUTE stmt6 USING @a, @b;
id	val
1	10
2	20
Classification delta (should be 0): 0
DEALLOCATE PREPARE stmt6;
DROP TABLE t1;
# === Test 7: ORDER BY + LIMIT should be NEVER ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
FLUSH STATUS;
PREPARE stmt7 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c LIMIT 2';
SET @a = 1;
SET @b = 3;
EXECUTE stmt7 USING @a, @b;
id	c
1	a
2	b
Classification delta (should be 0): 0
DEALLOCATE PREPARE stmt7;
DROP TABLE t1;
# === Test 8: ORDER BY + DISTINCT (Phase 10 support) ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'a'), (3, 'b');
FLUSH STATUS;
SET @a = 1;
SET @b = 3;
# Single-column DISTINCT matching ORDER BY — should be classified and admitted
PREPARE stmt8 FROM 'SELECT DISTINCT c FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt8 USING @a, @b;
c
a
b
Admissions (should be >= 1): 1
EXECUTE stmt8 USING @a, @b;
c
a
b
Cache hits (should be >= 1): 1
# Multi-column DISTINCT — should still be NEVER
PREPARE stmt8b FROM 'SELECT DISTINCT c, id FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
EXECUTE stmt8b USING @a, @b;
c	id
a	1
a	2
b	3
Multi-column DISTINCT classification delta (should be 0): 0
DEALLOCATE PREPARE stmt8;
DEALLOCATE PREPARE stmt8b;
DROP TABLE t1;
# === Test 9: Invalidation on ORDER BY field type change ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 3;
PREPARE stmt9 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
# First execute - should admit
EXECUTE stmt9 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Admissions: 1
# Second execute - cache hit
EXECUTE stmt9 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Hits before ALTER: 1
# ALTER TABLE to change column type
ALTER TABLE t1 MODIFY c TEXT;
# Execute after ALTER - should invalidate and fallback
EXECUTE stmt9 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Invalidation after ALTER: 0
Runtime fallbacks: 0
DEALLOCATE PREPARE stmt9;
DROP TABLE t1;
# === Test 10: Invalidation when ORDER BY column is dropped ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50),
extra INT
);
INSERT INTO t1 VALUES (1, 'a', 100), (2, 'b', 200);
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 2;
PREPARE stmt10 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
# Admit and hit
EXECUTE stmt10 USING @p_low, @p_high;
id	c	extra
1	a	100
2	b	200
EXECUTE stmt10 USING @p_low, @p_high;
id	c	extra
1	a	100
2	b	200
# Drop the ORDER BY column
ALTER TABLE t1 DROP COLUMN c;
# Execute after DROP - should invalidate
EXECUTE stmt10 USING @p_low, @p_high;
ERROR 42S22: Unknown column 'c' in 'order clause'
Invalidation after DROP COLUMN: 0
DEALLOCATE PREPARE stmt10;
DROP TABLE t1;
# === Test 11: Multiple concurrent ORDER BY statements ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c1 VARCHAR(50),
c2 INT,
c3 DATE
);
INSERT INTO t1 VALUES
(1, 'z', 300, '2023-03-01'),
(2, 'y', 200, '2023-02-01'),
(3, 'x', 100, '2023-01-01');
FLUSH STATUS;
# Prepare multiple statements with different ORDER BY columns
SET @p_low = 1;
SET @p_high = 3;
PREPARE stmt11a FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c1';
PREPARE stmt11b FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c2 DESC';
PREPARE stmt11c FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c3';
# Execute all - each should be admitted separately
EXECUTE stmt11a USING @p_low, @p_high;
id	c1	c2	c3
3	x	100	2023-01-01
2	y	200	2023-02-01
1	z	300	2023-03-01
EXECUTE stmt11b USING @p_low, @p_high;
id	c1	c2	c3
1	z	300	2023-03-01
2	y	200	2023-02-01
3	x	100	2023-01-01
EXECUTE stmt11c USING @p_low, @p_high;
id	c1	c2	c3
3	x	100	2023-01-01
2	y	200	2023-02-01
1	z	300	2023-03-01
Total admissions: 3
# Execute again - all should hit
EXECUTE stmt11a USING @p_low, @p_high;
id	c1	c2	c3
3	x	100	2023-01-01
2	y	200	2023-02-01
1	z	300	2023-03-01
EXECUTE stmt11b USING @p_low, @p_high;
id	c1	c2	c3
1	z	300	2023-03-01
2	y	200	2023-02-01
3	x	100	2023-01-01
EXECUTE stmt11c USING @p_low, @p_high;
id	c1	c2	c3
3	x	100	2023-01-01
2	y	200	2023-02-01
1	z	300	2023-03-01
Total hits: 3
DEALLOCATE PREPARE stmt11a;
DEALLOCATE PREPARE stmt11b;
DEALLOCATE PREPARE stmt11c;
DROP TABLE t1;
# === Test 12: Empty result set with ORDER BY ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
FLUSH STATUS;
PREPARE stmt12 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
SET @p_low = 10;
SET @p_high = 20;
EXECUTE stmt12 USING @p_low, @p_high;
id	c
Should return empty set but still work
SET @p_low = 1;
SET @p_high = 3;
EXECUTE stmt12 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Should return results after parameter change
DEALLOCATE PREPARE stmt12;
DROP TABLE t1;
# === Test 13: ORDER BY with composite primary key ===
CREATE TABLE t1 (
pk1 INT NOT NULL,
pk2 INT NOT NULL,
c VARCHAR(50),
PRIMARY KEY (pk1, pk2)
);
INSERT INTO t1 VALUES
(1, 1, 'c'), (1, 2, 'b'), (1, 3, 'a'),
(2, 1, 'f'), (2, 2, 'e'), (2, 3, 'd');
FLUSH STATUS;
# Composite PK with ORDER BY - both params on same composite PK
PREPARE stmt13 FROM 'SELECT * FROM t1 WHERE pk1 BETWEEN ? AND ? AND pk2 BETWEEN ? AND ? ORDER BY c';
SET @p1_low = 1;
SET @p1_high = 2;
SET @p2_low = 1;
SET @p2_high = 3;
# Note: This won't be classified as BETWEEN pattern due to AND between two BETWEEN
EXECUTE stmt13 USING @p1_low, @p1_high, @p2_low, @p2_high;
pk1	pk2	c
1	3	a
1	2	b
1	1	c
2	3	d
2	2	e
2	1	f
# Simple composite PK BETWEEN (only first part)
PREPARE stmt13b FROM 'SELECT * FROM t1 WHERE pk1 = ? AND pk2 = ?';
SET @a = 1;
SET @b = 1;
EXECUTE stmt13b USING @a, @b;
pk1	pk2	c
1	1	c
Composite equality classification: 0
DEALLOCATE PREPARE stmt13;
DEALLOCATE PREPARE stmt13b;
DROP TABLE t1;
# === Test 14: ORDER BY collation drift invalidation ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50) CHARACTER SET latin1 COLLATE latin1_swedish_ci
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'å'), (5, 'z');
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 5;
PREPARE stmt14 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
# Admit and hit
EXECUTE stmt14 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
5	z
4	å
EXECUTE stmt14 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
5	z
4	å
Hits before collation change: 1
# Change column collation
ALTER TABLE t1 MODIFY c VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Execute after collation change - should invalidate
EXECUTE stmt14 USING @p_low, @p_high;
id	c
1	a
4	å
2	b
3	c
5	z
Invalidation after collation change: 0
DEALLOCATE PREPARE stmt14;
DROP TABLE t1;
# === Test 15: ORDER BY with unsigned column ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
val INT UNSIGNED
);
INSERT INTO t1 VALUES (1, 4294967295), (2, 0), (3, 2147483648);
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 3;
PREPARE stmt15 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY val';
EXECUTE stmt15 USING @p_low, @p_high;
id	val
2	0
3	2147483648
1	4294967295
EXECUTE stmt15 USING @p_low, @p_high;
id	val
2	0
3	2147483648
1	4294967295
Cache hits with unsigned column: 1
DEALLOCATE PREPARE stmt15;
DROP TABLE t1;
# === Test 16: Table TRUNCATE invalidation ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
FLUSH STATUS;
SET @p_low = 1;
SET @p_high = 3;
PREPARE stmt16 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
# Admit to HOT
EXECUTE stmt16 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
EXECUTE stmt16 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
# TRUNCATE table
TRUNCATE TABLE t1;
INSERT INTO t1 VALUES (10, 'x'), (20, 'y'), (30, 'z');
# Execute after TRUNCATE - should invalidate
SET @p_low = 10;
SET @p_high = 30;
EXECUTE stmt16 USING @p_low, @p_high;
id	c
10	x
20	y
30	z
Invalidation after TRUNCATE: 0
DEALLOCATE PREPARE stmt16;
DROP TABLE t1;
# === Test 17: Parameter type drift ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
FLUSH STATUS;
PREPARE stmt17 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
# Execute with INT parameters
SET @p_low = 1;
SET @p_high = 3;
EXECUTE stmt17 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
EXECUTE stmt17 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
# Execute with different numeric types - should still work
SET @p_low = 1.0;
SET @p_high = 3.0;
EXECUTE stmt17 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Cache hits with type variations: 1
DEALLOCATE PREPARE stmt17;
DROP TABLE t1;
# === Test 18: Runtime sysvar disable ===
CREATE TABLE t1 (
id INT PRIMARY KEY,
c VARCHAR(50)
);
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');
SET SESSION ps_point_plan_cache = TRUE;
FLUSH STATUS;
PREPARE stmt18 FROM 'SELECT * FROM t1 WHERE id BETWEEN ? AND ? ORDER BY c';
SET @p_low = 1;
SET @p_high = 3;
# Admit with sysvar ON
EXECUTE stmt18 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
EXECUTE stmt18 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
# Turn off sysvar - should fallback to normal path
SET SESSION ps_point_plan_cache = FALSE;
EXECUTE stmt18 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Runtime fallbacks with sysvar OFF: 0
# Turn back on - should recover
SET SESSION ps_point_plan_cache = TRUE;
EXECUTE stmt18 USING @p_low, @p_high;
id	c
1	a
2	b
3	c
Hits after re-enable: 2
DEALLOCATE PREPARE stmt18;
DROP TABLE t1;

admissions after cycle2 re-admit (expect 3): 3
# N-cycle3: repeat once more
SET @p = 1;
EXECUTE stmt_n USING @p;
id	val
1	one
SET @p = 'drift3';
EXECUTE stmt_n USING @p;
id	val
Warnings:
Warning	1292	Truncated incorrect INTEGER value: 'drift3'
fallback after cycle3 drift (expect 3): 3
SET @p = 3;
EXECUTE stmt_n USING @p;
id	val
3	three
admissions after cycle3 re-admit (expect 4): 4
# N-final: 5 HOT hits to confirm stable after 3 cycles
SET @p = 1;
EXECUTE stmt_n USING @p;
id	val
1	one
SET @p = 2;
EXECUTE stmt_n USING @p;
id	val
2	two
SET @p = 3;
EXECUTE stmt_n USING @p;
id	val
3	three
SET @p = 1;
EXECUTE stmt_n USING @p;

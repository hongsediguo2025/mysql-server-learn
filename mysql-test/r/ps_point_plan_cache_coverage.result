2	two
hits after N-final (expect 8): 8
DEALLOCATE PREPARE stmt_n;
# =======================================================
# O. optimizer_switch drift — G1c guard
#    use_invisible_indexes is the only switch tracked by
#    the plan cache mask.  Toggling it triggers soft
#    demotion (HOT → COLD retryable), then re-admission.
# =======================================================
FLUSH STATUS;
PREPARE stmt_o FROM 'SELECT * FROM t1 WHERE id = ?';
# O1: admission → HOT
SET @p = 1;
EXECUTE stmt_o USING @p;
id	val
1	one
admissions after O1 (expect 1): 1
# O2: confirm HOT
SET @p = 2;
EXECUTE stmt_o USING @p;
id	val
2	two
hits after O2 (expect 1): 1
# O3: toggle use_invisible_indexes → G1c demotion
SET @optimizer_switch_save = @@optimizer_switch;
SET optimizer_switch = 'use_invisible_indexes=on';
SET @p = 1;
EXECUTE stmt_o USING @p;
id	val
1	one
fallback after O3 switch change (expect 1): 1
# O4: COLD → re-admission with new switch value
SET @p = 2;
EXECUTE stmt_o USING @p;
id	val
2	two
admissions after O4 (expect 2): 2
# O5: HOT hits with new switch value
#     Note: O3 fallback also re-admitted (same execution),
#     so O4 was already a hit, not an admission.
SET @p = 3;
EXECUTE stmt_o USING @p;
id	val
3	three
SET @p = 1;
EXECUTE stmt_o USING @p;
id	val
1	one
hits delta after O5 (expect 3): 3
# O6: restore switch → another drift + re-admission (same exec)
SET optimizer_switch = @optimizer_switch_save;
SET @p = 2;
EXECUTE stmt_o USING @p;
id	val
2	two
fallback after O6 restore (expect 2): 2
admissions after O6 re-admit (expect 3): 3
# O7: 2 HOT hits after O6 re-admission
SET @p = 1;
EXECUTE stmt_o USING @p;
id	val
1	one
SET @p = 3;
EXECUTE stmt_o USING @p;
id	val
3	three
hits delta after O7 (expect 5): 5
DEALLOCATE PREPARE stmt_o;
# =======================================================
# P. sql_mode drift — G11 guard
#    PAD_CHAR_TO_FULL_LENGTH is tracked by the plan cache
#    sql_mode mask.  Toggling it triggers soft demotion
#    (HOT → COLD retryable) + re-admission in same exec.
# =======================================================
FLUSH STATUS;
PREPARE stmt_p FROM 'SELECT * FROM t1 WHERE id = ?';
# P1: admission → HOT
SET @p = 1;
EXECUTE stmt_p USING @p;
id	val
1	one
admissions after P1 (expect 1): 1
# P2: confirm HOT
SET @p = 2;
EXECUTE stmt_p USING @p;
id	val
2	two
hits after P2 (expect 1): 1
# P3: set PAD_CHAR_TO_FULL_LENGTH → G11 drift + re-admission
SET @sql_mode_save = @@sql_mode;
SET sql_mode = 'PAD_CHAR_TO_FULL_LENGTH';
Warnings:
Warning	3090	Changing sql mode 'PAD_CHAR_TO_FULL_LENGTH' is deprecated. It will be removed in a future release.
SET @p = 1;
EXECUTE stmt_p USING @p;
id	val
1	one
fallback after P3 sql_mode change (expect 1): 1
admissions after P3 (expect 2, re-admit in same exec): 2
# P4: HOT hit with new sql_mode
SET @p = 2;
EXECUTE stmt_p USING @p;
id	val
2	two
hits delta after P4 (expect 1): 1
# P5: restore sql_mode → another drift + re-admission
SET sql_mode = @sql_mode_save;
SET @p = 3;
EXECUTE stmt_p USING @p;
id	val
3	three
fallback after P5 restore (expect 2): 2
admissions after P5 (expect 3): 3
# P6: stable HOT hits after restore
SET @p = 1;
EXECUTE stmt_p USING @p;
id	val
1	one
SET @p = 2;
EXECUTE stmt_p USING @p;
id	val
2	two
hits delta after P6 (expect 3): 3
DEALLOCATE PREPARE stmt_p;
# =======================================================
# Q. Composite key with type drift — G8 + reordering
#    Verifies type drift detection works correctly with
#    composite key param reordering (Phase 2 reorders
#    params to key-part order).
# =======================================================
FLUSH STATUS;
PREPARE stmt_q FROM 'SELECT * FROM t_comp WHERE pk2 = ? AND pk1 = ?';
# Q1: INT admission → HOT (params reordered to pk1, pk2)
SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
1	10	a
admissions after Q1 (expect 1): 1
# Q2: HOT hits
SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
2	20	d
hits after Q2 (expect 1): 1
# Q3: STRING drift on one param → G8 demotion
SET @pk2 = 'abc';
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
Warnings:
Warning	1292	Truncated incorrect INTEGER value: 'abc'
Warning	1292	Truncated incorrect INTEGER value: 'abc'
fallback after Q3 STRING drift (expect 1): 1
# Q4: INT params → re-admission
SET @pk2 = 10;
SET @pk1 = 2;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
2	10	c
admissions after Q4 re-admit (expect 2): 2
# Q5: 3 HOT hits — verify reordering still correct after drift
SET @pk2 = 20;
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
1	20	b
SET @pk2 = 10;
SET @pk1 = 1;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
1	10	a
SET @pk2 = 20;
SET @pk1 = 2;
EXECUTE stmt_q USING @pk2, @pk1;
pk1	pk2	val
2	20	d
hits delta after Q5 (expect 3): 3
DEALLOCATE PREPARE stmt_q;

#
# Phase 0 test: ps_point_plan_cache sysvar, status variables,
# and background data operations to verify no regression.
#
# -------------------------------------------------------
# 1. Verify sysvar visibility and default value
# -------------------------------------------------------
SELECT @@global.ps_point_plan_cache;
@@global.ps_point_plan_cache
1
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
1
# Default should be ON (1)
SHOW VARIABLES LIKE 'ps_point_plan_cache';
Variable_name	Value
ps_point_plan_cache	ON
# -------------------------------------------------------
# 2. Verify sysvar can be toggled at SESSION level
# -------------------------------------------------------
SET SESSION ps_point_plan_cache = FALSE;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
0
SET SESSION ps_point_plan_cache = TRUE;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
1
SET SESSION ps_point_plan_cache = 0;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
0
SET SESSION ps_point_plan_cache = 1;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
1
SET SESSION ps_point_plan_cache = ON;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
1
SET SESSION ps_point_plan_cache = OFF;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
0
# Restore session to default
SET SESSION ps_point_plan_cache = DEFAULT;
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
1
# -------------------------------------------------------
# 3. Verify sysvar can be toggled at GLOBAL level
# -------------------------------------------------------
SET @orig_global = @@global.ps_point_plan_cache;
SET GLOBAL ps_point_plan_cache = FALSE;
SELECT @@global.ps_point_plan_cache;
@@global.ps_point_plan_cache
0
SET GLOBAL ps_point_plan_cache = TRUE;
SELECT @@global.ps_point_plan_cache;
@@global.ps_point_plan_cache
1
# Restore global
SET GLOBAL ps_point_plan_cache = @orig_global;
# -------------------------------------------------------
# 4. Error cases: invalid values must be rejected
# -------------------------------------------------------
SET SESSION ps_point_plan_cache = 12.34;
Got one of the listed errors
SET SESSION ps_point_plan_cache = 'foobar';
Got one of the listed errors
SET SESSION ps_point_plan_cache = 5;
Got one of the listed errors
SET GLOBAL ps_point_plan_cache = -1;
Got one of the listed errors
# Confirm value unchanged after invalid SET attempts
SELECT @@session.ps_point_plan_cache;
@@session.ps_point_plan_cache
1
# -------------------------------------------------------
# 5. Session scope isolation
# -------------------------------------------------------
SET SESSION ps_point_plan_cache = FALSE;
SELECT @@session.ps_point_plan_cache AS 'main_session_after_set_false';
main_session_after_set_false
0
# New connection should inherit GLOBAL default, not the other session's value
SELECT @@session.ps_point_plan_cache AS 'con1_session_value';
con1_session_value
1
# Restore
SET SESSION ps_point_plan_cache = DEFAULT;
# -------------------------------------------------------
# 6. Verify all 4 status counters are visible and start at 0
# -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admissions	0
Ps_point_plan_cache_cold_classifications	0
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	0
Ps_point_plan_cache_invalidations	0
SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.session_status
WHERE VARIABLE_NAME LIKE 'Ps_point_plan_cache%'
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
Ps_point_plan_cache_admissions	0
Ps_point_plan_cache_cold_classifications	0
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	0
Ps_point_plan_cache_invalidations	0
SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'Ps_point_plan_cache%'
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
Ps_point_plan_cache_admissions	#
Ps_point_plan_cache_cold_classifications	#
Ps_point_plan_cache_fallback_runtime	#
Ps_point_plan_cache_hits	#
Ps_point_plan_cache_invalidations	#
# -------------------------------------------------------
# 7. Background data operations: single-table point select PS
#    Verifies new Prepared_statement members don't break
#    basic PS lifecycle (prepare → multi-execute → deallocate).
# -------------------------------------------------------
CREATE TABLE t1 (
id INT PRIMARY KEY,
val VARCHAR(100),
uk INT NOT NULL,
UNIQUE KEY idx_uk (uk)
);
INSERT INTO t1 VALUES (1, 'alpha', 100), (2, 'beta', 200), (3, 'gamma', 300);
# 7a. Point select on PK — candidate shape for future phases
PREPARE ps_pk FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE ps_pk USING @p;
id	val	uk
1	alpha	100
SET @p = 2;
EXECUTE ps_pk USING @p;
id	val	uk
2	beta	200
SET @p = 3;
EXECUTE ps_pk USING @p;
id	val	uk
3	gamma	300
# 7b. Point select on unique key
PREPARE ps_uk FROM 'SELECT * FROM t1 WHERE uk = ?';
SET @p = 100;
EXECUTE ps_uk USING @p;
id	val	uk
1	alpha	100
SET @p = 300;
EXECUTE ps_uk USING @p;
id	val	uk
3	gamma	300
# 7c. Multiple executes of same PS with NULL param
SET @p = NULL;
EXECUTE ps_pk USING @p;
id	val	uk
DEALLOCATE PREPARE ps_pk;
DEALLOCATE PREPARE ps_uk;
# -------------------------------------------------------
# 8. Background data operations: non-candidate query shapes
#    These must remain completely unaffected.
# -------------------------------------------------------
CREATE TABLE t2 (
id INT PRIMARY KEY,
t1_id INT,
memo TEXT
);
INSERT INTO t2 VALUES (1, 1, 'join-a'), (2, 2, 'join-b'), (3, 3, 'join-c');
# 8a. JOIN query
PREPARE ps_join FROM 'SELECT t1.val, t2.memo FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.id = ?';
SET @p = 1;
EXECUTE ps_join USING @p;
val	memo
alpha	join-a
EXECUTE ps_join USING @p;
val	memo
alpha	join-a
DEALLOCATE PREPARE ps_join;
# 8b. Range query
PREPARE ps_range FROM 'SELECT * FROM t1 WHERE id > ? ORDER BY id';
SET @p = 1;
EXECUTE ps_range USING @p;
id	val	uk
2	beta	200
3	gamma	300
EXECUTE ps_range USING @p;
id	val	uk
2	beta	200
3	gamma	300
DEALLOCATE PREPARE ps_range;
# 8c. Aggregation query
PREPARE ps_agg FROM 'SELECT COUNT(*), MAX(val) FROM t1 WHERE id >= ?';
SET @p = 1;
EXECUTE ps_agg USING @p;
COUNT(*)	MAX(val)
3	gamma
EXECUTE ps_agg USING @p;
COUNT(*)	MAX(val)
3	gamma
DEALLOCATE PREPARE ps_agg;
# 8d. Subquery
PREPARE ps_sub FROM 'SELECT * FROM t1 WHERE id IN (SELECT t1_id FROM t2 WHERE t2.id = ?)';
SET @p = 2;
EXECUTE ps_sub USING @p;
id	val	uk
2	beta	200
EXECUTE ps_sub USING @p;
id	val	uk
2	beta	200
DEALLOCATE PREPARE ps_sub;
# 8e. Multi-param composite equality (classified COLD since Phase 1)
PREPARE ps_multi FROM 'SELECT * FROM t1 WHERE id = ? AND val = ?';
SET @p1 = 1;
SET @p2 = 'alpha';
EXECUTE ps_multi USING @p1, @p2;
id	val	uk
1	alpha	100
EXECUTE ps_multi USING @p1, @p2;
id	val	uk
1	alpha	100
DEALLOCATE PREPARE ps_multi;
# 8f. INSERT/UPDATE/DELETE via PS (non-SELECT)
PREPARE ps_ins FROM 'INSERT INTO t1 VALUES (?, ?, ?)';
SET @a = 4;
SET @b = 'delta';
SET @c = 400;
EXECUTE ps_ins USING @a, @b, @c;
DEALLOCATE PREPARE ps_ins;
PREPARE ps_upd FROM 'UPDATE t1 SET val = ? WHERE id = ?';
SET @a = 'DELTA';
SET @b = 4;
EXECUTE ps_upd USING @a, @b;
DEALLOCATE PREPARE ps_upd;
PREPARE ps_del FROM 'DELETE FROM t1 WHERE id = ?';
SET @a = 4;
EXECUTE ps_del USING @a;
DEALLOCATE PREPARE ps_del;
SELECT * FROM t1 ORDER BY id;
id	val	uk
1	alpha	100
2	beta	200
3	gamma	300
# -------------------------------------------------------
# 9. DDL-triggered reprepare
#    This exercises swap_prepared_statement() which must
#    correctly swap the 3 new fields we added.
# -------------------------------------------------------
PREPARE ps_repr FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE ps_repr USING @p;
id	val	uk
1	alpha	100
# ALTER TABLE invalidates the PS → next execute does reprepare
ALTER TABLE t1 ADD COLUMN extra INT DEFAULT 0;
SET @p = 2;
EXECUTE ps_repr USING @p;
id	val	uk	extra
2	beta	200	0
# Another DDL cycle
ALTER TABLE t1 DROP COLUMN extra;
SET @p = 3;
EXECUTE ps_repr USING @p;
id	val	uk
3	gamma	300
DEALLOCATE PREPARE ps_repr;
# -------------------------------------------------------
# 10. SQL-syntax PREPARE/EXECUTE (not COM_STMT_* protocol)
#     These should also be unaffected.
# -------------------------------------------------------
PREPARE ps_sql FROM 'SELECT val FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE ps_sql USING @p;
val
alpha
SET @p = 2;
EXECUTE ps_sql USING @p;
val
beta
DEALLOCATE PREPARE ps_sql;
# -------------------------------------------------------
# 11. Multiple PS alive simultaneously
#     Verifies per-statement state independence.
# -------------------------------------------------------
PREPARE ps_a FROM 'SELECT id FROM t1 WHERE id = ?';
PREPARE ps_b FROM 'SELECT val FROM t1 WHERE uk = ?';
PREPARE ps_c FROM 'SELECT COUNT(*) FROM t1';
SET @p = 1;
EXECUTE ps_a USING @p;
id
1
SET @p = 200;
EXECUTE ps_b USING @p;
val
beta
EXECUTE ps_c;
COUNT(*)
3
SET @p = 3;
EXECUTE ps_a USING @p;
id
3
SET @p = 100;
EXECUTE ps_b USING @p;
val
alpha
EXECUTE ps_c;
COUNT(*)
3
DEALLOCATE PREPARE ps_a;
DEALLOCATE PREPARE ps_b;
DEALLOCATE PREPARE ps_c;
# -------------------------------------------------------
# 12. Toggle sysvar mid-session between PS executions
# -------------------------------------------------------
PREPARE ps_toggle FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE ps_toggle USING @p;
id	val	uk
1	alpha	100
SET SESSION ps_point_plan_cache = FALSE;
EXECUTE ps_toggle USING @p;
id	val	uk
1	alpha	100
SET SESSION ps_point_plan_cache = TRUE;
SET @p = 2;
EXECUTE ps_toggle USING @p;
id	val	uk
2	beta	200
DEALLOCATE PREPARE ps_toggle;
# -------------------------------------------------------
# 13. Counter verification after all operations
#     cold_classifications = 10 (COLD candidates from PREPARE).
#     admissions = 9 (COLD statements that passed admission on
#     first EXECUTE and transitioned to HOT).
#     hits = 7 (Phase 3 fast path hits on subsequent EXECUTEs).
#     fallback_runtime = 1 (NULL param in Section 7c).
# -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admissions	9
Ps_point_plan_cache_cold_classifications	10
Ps_point_plan_cache_fallback_runtime	1
Ps_point_plan_cache_hits	7
Ps_point_plan_cache_invalidations	0
# Also verify via FLUSH STATUS (additional, not primary assertion)
FLUSH STATUS;
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admissions	0
Ps_point_plan_cache_cold_classifications	0
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	0
Ps_point_plan_cache_invalidations	0
# -------------------------------------------------------
# 14. Verify sysvar appears in expected P_S tables
# -------------------------------------------------------
Variable found in session_variables: 1
Variable found in global_variables: 1
# -------------------------------------------------------
# Cleanup
# -------------------------------------------------------
DROP TABLE t2;
DROP TABLE t1;
#
# End of Phase 0 tests
#

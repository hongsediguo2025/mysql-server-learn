#
# Phase 3 test: ps_point_plan_cache fast path
# Verifies HOT statements bypass make_join_plan() and produce
# correct results via the minimal EQ_REF execution plan.
#
# -------------------------------------------------------
# Setup
# -------------------------------------------------------
CREATE TABLE t1 (
id INT PRIMARY KEY,
val VARCHAR(50),
uk INT NOT NULL,
UNIQUE KEY idx_uk (uk)
);
CREATE TABLE t_comp (
pk1 INT,
pk2 INT,
val INT,
PRIMARY KEY (pk1, pk2)
);
INSERT INTO t1 VALUES (1, 'one', 10), (2, 'two', 20), (3, 'three', 30);
INSERT INTO t_comp VALUES (1, 1, 100), (1, 2, 200), (2, 1, 300);
FLUSH STATUS;
# -------------------------------------------------------
# 1. PK point select — fast path hit + correct result
# -------------------------------------------------------
PREPARE stmt_pk FROM 'SELECT * FROM t1 WHERE id = ?';
# First EXECUTE: admission (COLD → HOT, normal path)
SET @p = 1;
EXECUTE stmt_pk USING @p;
id	val	uk
1	one	10
# Second EXECUTE: should hit fast path
SET @p = 2;
EXECUTE stmt_pk USING @p;
id	val	uk
2	two	20
hits delta after PK second execute: 1
DEALLOCATE PREPARE stmt_pk;
# -------------------------------------------------------
# 2. UK point select — fast path hit + correct result
# -------------------------------------------------------
PREPARE stmt_uk FROM 'SELECT * FROM t1 WHERE uk = ?';
# First EXECUTE: admission
SET @p = 10;
EXECUTE stmt_uk USING @p;
id	val	uk
1	one	10
# Second EXECUTE: fast path
SET @p = 20;
EXECUTE stmt_uk USING @p;
id	val	uk
2	two	20
hits delta after UK second execute: 1
DEALLOCATE PREPARE stmt_uk;
# -------------------------------------------------------
# 3. Composite PK — fast path hit + correct result
# -------------------------------------------------------
PREPARE stmt_cpk FROM 'SELECT * FROM t_comp WHERE pk1 = ? AND pk2 = ?';
SET @p1 = 1;
SET @p2 = 1;
EXECUTE stmt_cpk USING @p1, @p2;
pk1	pk2	val
1	1	100
SET @p1 = 2;
SET @p2 = 1;
EXECUTE stmt_cpk USING @p1, @p2;
pk1	pk2	val
2	1	300
hits delta after composite PK second execute: 1
DEALLOCATE PREPARE stmt_cpk;
# -------------------------------------------------------
# 4. Composite PK reversed WHERE order — fast path hit
#    (params reordered to key-part order in Phase 2)
# -------------------------------------------------------
PREPARE stmt_rev FROM 'SELECT * FROM t_comp WHERE pk2 = ? AND pk1 = ?';
SET @p1 = 2;
SET @p2 = 1;
EXECUTE stmt_rev USING @p1, @p2;
pk1	pk2	val
1	2	200
SET @p1 = 1;
SET @p2 = 2;
EXECUTE stmt_rev USING @p1, @p2;
pk1	pk2	val
2	1	300
hits delta after reversed PK second execute: 1
DEALLOCATE PREPARE stmt_rev;
# -------------------------------------------------------
# 5. Non-existent PK value — fast path returns empty set
# -------------------------------------------------------
PREPARE stmt_norow FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_norow USING @p;
id	val	uk
1	one	10
# Fast path with non-existent value
SET @p = 999;
EXECUTE stmt_norow USING @p;
id	val	uk
DEALLOCATE PREPARE stmt_norow;
# -------------------------------------------------------
# 6. NULL parameter — runtime fallback (G7)
# -------------------------------------------------------
PREPARE stmt_null FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_null USING @p;
id	val	uk
1	one	10
# EXECUTE with NULL — should fallback, not hit
SET @p = NULL;
EXECUTE stmt_null USING @p;
id	val	uk
fallback_runtime delta after NULL execute: 1
hits delta after NULL execute: 0
# Next EXECUTE with non-NULL should hit again (still HOT)
SET @p = 3;
EXECUTE stmt_null USING @p;
id	val	uk
3	three	30
hits delta after non-NULL execute following NULL: 1
DEALLOCATE PREPARE stmt_null;
# -------------------------------------------------------
# 7. Sysvar OFF — bypass fast path
# -------------------------------------------------------
PREPARE stmt_sysvar FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_sysvar USING @p;
id	val	uk
1	one	10
SET SESSION ps_point_plan_cache = OFF;
SET @p = 2;
EXECUTE stmt_sysvar USING @p;
id	val	uk
2	two	20
hits delta with sysvar OFF: 0
# Re-enable — should hit again
SET SESSION ps_point_plan_cache = ON;
SET @p = 3;
EXECUTE stmt_sysvar USING @p;
id	val	uk
3	three	30
hits delta with sysvar re-enabled: 1
DEALLOCATE PREPARE stmt_sysvar;
# -------------------------------------------------------
# 8. Multiple consecutive EXECUTEs — hits accumulate
# -------------------------------------------------------
PREPARE stmt_multi FROM 'SELECT * FROM t1 WHERE id = ?';
# Admission
SET @p = 1;
EXECUTE stmt_multi USING @p;
id	val	uk
1	one	10
SET @p = 1;
EXECUTE stmt_multi USING @p;
id	val	uk
1	one	10
SET @p = 2;
EXECUTE stmt_multi USING @p;
id	val	uk
2	two	20
SET @p = 3;
EXECUTE stmt_multi USING @p;
id	val	uk
3	three	30
SET @p = 1;
EXECUTE stmt_multi USING @p;
id	val	uk
1	one	10
SET @p = 2;
EXECUTE stmt_multi USING @p;
id	val	uk
2	two	20
hits delta after 5 consecutive executes: 5
DEALLOCATE PREPARE stmt_multi;
# -------------------------------------------------------
# 9. Different param values — each returns correct row
# -------------------------------------------------------
PREPARE stmt_vals FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_vals USING @p;
id	val	uk
1	one	10
# Fast path with various values
SET @p = 1;
EXECUTE stmt_vals USING @p;
id	val	uk
1	one	10
SET @p = 2;
EXECUTE stmt_vals USING @p;
id	val	uk
2	two	20
SET @p = 3;
EXECUTE stmt_vals USING @p;
id	val	uk
3	three	30
DEALLOCATE PREPARE stmt_vals;
# -------------------------------------------------------
# 10. DDL → reprepare → re-classify → re-admit → fast path
# -------------------------------------------------------
PREPARE stmt_ddl FROM 'SELECT * FROM t1 WHERE id = ?';
# Admission
SET @p = 1;
EXECUTE stmt_ddl USING @p;
id	val	uk
1	one	10
# Fast path hit
SET @p = 2;
EXECUTE stmt_ddl USING @p;
id	val	uk
2	two	20
# DDL triggers reprepare on next EXECUTE
ALTER TABLE t1 ADD COLUMN extra INT DEFAULT 0;
# Re-admission after reprepare
SET @p = 1;
EXECUTE stmt_ddl USING @p;
id	val	uk	extra
1	one	10	0
admissions delta after DDL reprepare: 1
# Fast path should work again after re-admission
SET @p = 2;
EXECUTE stmt_ddl USING @p;
id	val	uk	extra
2	two	20	0
hits delta after re-admission: 1
DEALLOCATE PREPARE stmt_ddl;
# Restore table
ALTER TABLE t1 DROP COLUMN extra;
# -------------------------------------------------------
# 11. DML between fast-path EXECUTEs — data freshness
#     EQRefIterator must read current data, not stale.
# -------------------------------------------------------
PREPARE stmt_dml FROM 'SELECT * FROM t1 WHERE id = ?';
# Admission
SET @p = 1;
EXECUTE stmt_dml USING @p;
id	val	uk
1	one	10
# INSERT new row, fast path should see it
INSERT INTO t1 VALUES (4, 'four', 40);
SET @p = 4;
EXECUTE stmt_dml USING @p;
id	val	uk
4	four	40
hits delta after INSERT: 1
# UPDATE existing row, fast path should see updated value
UPDATE t1 SET val = 'UPDATED' WHERE id = 1;
SET @p = 1;
EXECUTE stmt_dml USING @p;
id	val	uk
1	UPDATED	10
# DELETE the inserted row, fast path should return empty
DELETE FROM t1 WHERE id = 4;
SET @p = 4;
EXECUTE stmt_dml USING @p;
id	val	uk
# Restore original data
UPDATE t1 SET val = 'one' WHERE id = 1;
DEALLOCATE PREPARE stmt_dml;
# -------------------------------------------------------
# 12. Nullable unique key — fast path hit
#     Tests init_ref_part with key_part->null_bit != 0
# -------------------------------------------------------
CREATE TABLE t_nuk (
id INT PRIMARY KEY,
nuk INT,
val VARCHAR(50),
UNIQUE KEY idx_nuk (nuk)
);
INSERT INTO t_nuk VALUES (1, 100, 'a'), (2, 200, 'b'), (3, NULL, 'c');
PREPARE stmt_nuk FROM 'SELECT * FROM t_nuk WHERE nuk = ?';
# Admission
SET @p = 100;
EXECUTE stmt_nuk USING @p;
id	nuk	val
1	100	a
# Fast path with nullable UK
SET @p = 200;
EXECUTE stmt_nuk USING @p;
id	nuk	val
2	200	b
hits delta after nullable UK fast path: 1
DEALLOCATE PREPARE stmt_nuk;
DROP TABLE t_nuk;
# -------------------------------------------------------
# 13. VARCHAR primary key — fast path with string key
# -------------------------------------------------------
CREATE TABLE t_vpk (
name VARCHAR(50) PRIMARY KEY,
val INT
);
INSERT INTO t_vpk VALUES ('alice', 1), ('bob', 2), ('charlie', 3);
PREPARE stmt_vpk FROM 'SELECT * FROM t_vpk WHERE name = ?';
# Admission
SET @p = 'alice';
EXECUTE stmt_vpk USING @p;
name	val
alice	1
# Fast path with string key
SET @p = 'bob';
EXECUTE stmt_vpk USING @p;
name	val
bob	2
hits delta after VARCHAR PK fast path: 1
DEALLOCATE PREPARE stmt_vpk;
DROP TABLE t_vpk;
# -------------------------------------------------------
# 14. Composite PK — NULL in second param triggers G7
#     Verifies G7 checks ALL params, not just the first.
# -------------------------------------------------------
PREPARE stmt_cnull FROM 'SELECT * FROM t_comp WHERE pk1 = ? AND pk2 = ?';
# Admission
SET @p1 = 1;
SET @p2 = 1;
EXECUTE stmt_cnull USING @p1, @p2;
pk1	pk2	val
1	1	100
# Second param NULL — should fallback (G7)
SET @p1 = 1;
SET @p2 = NULL;
EXECUTE stmt_cnull USING @p1, @p2;
pk1	pk2	val
fallback delta after NULL in second param: 1
hits delta after NULL in second param: 0
# Non-NULL params — should hit (state stays HOT)
SET @p1 = 1;
SET @p2 = 2;
EXECUTE stmt_cnull USING @p1, @p2;
pk1	pk2	val
1	2	200
hits delta after recovery from NULL: 1
DEALLOCATE PREPARE stmt_cnull;
# -------------------------------------------------------
# 15. Multiple PS on same table — independent fast paths
# -------------------------------------------------------
PREPARE stmt_m1 FROM 'SELECT * FROM t1 WHERE id = ?';
PREPARE stmt_m2 FROM 'SELECT * FROM t1 WHERE uk = ?';
# Admission for both
SET @p = 1;
EXECUTE stmt_m1 USING @p;
id	val	uk
1	one	10
SET @p = 10;
EXECUTE stmt_m2 USING @p;
id	val	uk
1	one	10
# Both should independently hit fast path
SET @p = 2;
EXECUTE stmt_m1 USING @p;
id	val	uk
2	two	20
SET @p = 20;
EXECUTE stmt_m2 USING @p;
id	val	uk
2	two	20
hits delta after both PS fast paths: 2
DEALLOCATE PREPARE stmt_m1;
DEALLOCATE PREPARE stmt_m2;
# -------------------------------------------------------
# 16. SELECT specific columns — output correctness
# -------------------------------------------------------
PREPARE stmt_cols FROM 'SELECT val, uk FROM t1 WHERE id = ?';
# Admission
SET @p = 1;
EXECUTE stmt_cols USING @p;
val	uk
one	10
# Fast path with specific columns
SET @p = 2;
EXECUTE stmt_cols USING @p;
val	uk
two	20
hits delta after SELECT specific columns: 1
DEALLOCATE PREPARE stmt_cols;
# -------------------------------------------------------
# 17. Transaction rollback — fast path sees current snapshot
# -------------------------------------------------------
PREPARE stmt_tx FROM 'SELECT * FROM t1 WHERE id = ?';
# Admission
SET @p = 1;
EXECUTE stmt_tx USING @p;
id	val	uk
1	one	10
START TRANSACTION;
INSERT INTO t1 VALUES (5, 'temp', 50);
# Fast path within transaction — should see inserted row
SET @p = 5;
EXECUTE stmt_tx USING @p;
id	val	uk
5	temp	50
ROLLBACK;
# Fast path after rollback — should see empty (row gone)
SET @p = 5;
EXECUTE stmt_tx USING @p;
id	val	uk
# Verify normal row still visible after rollback
SET @p = 1;
EXECUTE stmt_tx USING @p;
id	val	uk
1	one	10
DEALLOCATE PREPARE stmt_tx;
# -------------------------------------------------------
# 18. Final counter summary
# -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admissions	19
Ps_point_plan_cache_cold_classifications	19
Ps_point_plan_cache_fallback_runtime	2
Ps_point_plan_cache_hits	29
Ps_point_plan_cache_invalidations	0
# -------------------------------------------------------
# Cleanup
# -------------------------------------------------------
DROP TABLE t_comp;
DROP TABLE t1;
#
# End of Phase 3 fast path tests
#

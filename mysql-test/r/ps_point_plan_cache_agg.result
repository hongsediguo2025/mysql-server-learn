# ========== Test 4: Unsupported query structures ==========
# Test 4.1: Multiple aggregate functions
PREPARE stmt_multi_agg FROM 'SELECT SUM(k), COUNT(*) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_multi_agg USING @low, @high;
SUM(k)	COUNT(*)
600	3
EXECUTE stmt_multi_agg USING @low, @high;
SUM(k)	COUNT(*)
600	3
DEALLOCATE PREPARE stmt_multi_agg;
# Test 4.2: HAVING clause
PREPARE stmt_having FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? HAVING SUM(k) > 100';
EXECUTE stmt_having USING @low, @high;
SUM(k)
600
EXECUTE stmt_having USING @low, @high;
SUM(k)
600
DEALLOCATE PREPARE stmt_having;
# Test 4.3: GROUP BY clause
PREPARE stmt_group_by FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? GROUP BY k';
EXECUTE stmt_group_by USING @low, @high;
SUM(k)
100
200
300
DEALLOCATE PREPARE stmt_group_by;
# Test 4.4: ORDER BY clause
PREPARE stmt_order_by FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? ORDER BY SUM(k)';
EXECUTE stmt_order_by USING @low, @high;
SUM(k)
600
DEALLOCATE PREPARE stmt_order_by;
# Test 4.5: DISTINCT clause
PREPARE stmt_distinct FROM 'SELECT COUNT(DISTINCT k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_distinct USING @low, @high;
COUNT(DISTINCT k)
3
DEALLOCATE PREPARE stmt_distinct;
# Test 4.6: DISTINCT with SUM
PREPARE stmt_distinct_sum FROM 'SELECT SUM(DISTINCT k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_distinct_sum USING @low, @high;
SUM(DISTINCT k)
600
DEALLOCATE PREPARE stmt_distinct_sum;
# Test 4.7: Non-PK WHERE condition
PREPARE stmt_non_pk FROM 'SELECT SUM(k) FROM t1 WHERE k BETWEEN ? AND ?';
SET @k1 = 100, @k2 = 300;
EXECUTE stmt_non_pk USING @k1, @k2;
SUM(k)
600
DEALLOCATE PREPARE stmt_non_pk;
# Test 4.8: Compound WHERE condition
PREPARE stmt_compound FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? AND k > 0';
SET @low = 1, @high = 3;
EXECUTE stmt_compound USING @low, @high;
SUM(k)
600
DEALLOCATE PREPARE stmt_compound;
# Test 4.9: OR condition
PREPARE stmt_or FROM 'SELECT SUM(k) FROM t1 WHERE id = 1 OR id = 2';
EXECUTE stmt_or;
SUM(k)
300
EXECUTE stmt_or;
SUM(k)
300
DEALLOCATE PREPARE stmt_or;
# Test 4.10: IN condition
PREPARE stmt_in FROM 'SELECT SUM(k) FROM t1 WHERE id IN (1, 2, 3)';
EXECUTE stmt_in;
SUM(k)
600
DEALLOCATE PREPARE stmt_in;
# Test 4.11: No WHERE clause
PREPARE stmt_no_where FROM 'SELECT SUM(k) FROM t1';
EXECUTE stmt_no_where;
SUM(k)
1500
EXECUTE stmt_no_where;
SUM(k)
1500
DEALLOCATE PREPARE stmt_no_where;
# ========== Test 5: Multi-table scenarios ==========
CREATE TABLE t2 (id INT PRIMARY KEY, val INT);
INSERT INTO t2 VALUES (1, 10), (2, 20), (3, 30);
# Test 5.1: JOIN query
PREPARE stmt_join FROM 'SELECT SUM(t1.k) FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_join USING @low, @high;
SUM(t1.k)
300
DEALLOCATE PREPARE stmt_join;
# Test 5.2: Subquery
PREPARE stmt_subq FROM 'SELECT SUM(k) FROM t1 WHERE id IN (SELECT id FROM t2 WHERE id BETWEEN ? AND ?)';
EXECUTE stmt_subq USING @low, @high;
SUM(k)
300
DEALLOCATE PREPARE stmt_subq;
# Test 5.3: UNION query
PREPARE stmt_union FROM 'SELECT SUM(k) FROM t1 WHERE id BETWEEN ? AND ? UNION ALL SELECT COUNT(*) FROM t2';
EXECUTE stmt_union USING @low, @high;
SUM(k)
300
3
DEALLOCATE PREPARE stmt_union;

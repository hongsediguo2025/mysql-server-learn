PREPARE stmt_group_concat FROM 'SELECT GROUP_CONCAT(c) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_group_concat USING @low, @high;
GROUP_CONCAT(c)
a,b,c
DEALLOCATE PREPARE stmt_group_concat;

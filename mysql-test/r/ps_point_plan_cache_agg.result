PREPARE stmt_bit_and FROM 'SELECT BIT_AND(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_bit_and USING @low, @high;
BIT_AND(k)
0
DEALLOCATE PREPARE stmt_bit_and;
# Test 3.5: BIT_OR
PREPARE stmt_bit_or FROM 'SELECT BIT_OR(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_bit_or USING @low, @high;
BIT_OR(k)
492
DEALLOCATE PREPARE stmt_bit_or;
# Test 3.6: BIT_XOR
PREPARE stmt_bit_xor FROM 'SELECT BIT_XOR(k) FROM t1 WHERE id BETWEEN ? AND ?';
EXECUTE stmt_bit_xor USING @low, @high;

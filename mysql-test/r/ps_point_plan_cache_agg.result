# Test 7.2: INT parameter changed to BIGINT
CREATE TABLE t7 (id BIGINT PRIMARY KEY, k INT);
INSERT INTO t7 VALUES (1, 100), (2, 200), (3, 300);
PREPARE stmt_bigint_param FROM 'SELECT SUM(k) FROM t7 WHERE id BETWEEN ? AND ?';
SET @low = 1, @high = 2;
EXECUTE stmt_bigint_param USING @low, @high;
SUM(k)
300
SET @low = CAST(1 AS UNSIGNED), @high = CAST(2 AS UNSIGNED);
EXECUTE stmt_bigint_param USING @low, @high;
SUM(k)
300
DEALLOCATE PREPARE stmt_bigint_param;

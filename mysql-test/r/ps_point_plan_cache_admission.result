#
# Phase 2 test: ps_point_plan_cache admission logic
# Verifies COLD -> HOT / COLD -> NEVER transitions after
# first normal optimization.
#
# -------------------------------------------------------
# Setup: schema for admission testing
# -------------------------------------------------------
CREATE TABLE t1 (
id INT PRIMARY KEY,
val VARCHAR(50),
uk INT NOT NULL,
name VARCHAR(50),
UNIQUE KEY idx_uk (uk),
KEY idx_name (name)
);
INSERT INTO t1 VALUES (1, 'alpha', 100, 'Alice'),
(2, 'beta', 200, 'Bob'),
(3, 'gamma', 300, 'Charlie');
CREATE TABLE t_comp (
pk1 INT,
pk2 INT,
val INT,
PRIMARY KEY (pk1, pk2)
);
INSERT INTO t_comp VALUES (1, 10, 100), (2, 20, 200), (3, 30, 300);
CREATE TABLE t_comp_uk (
id INT PRIMARY KEY,
uk1 INT NOT NULL,
uk2 INT NOT NULL,
val INT,
UNIQUE KEY idx_uk12 (uk1, uk2)
);
INSERT INTO t_comp_uk VALUES (1, 10, 100, 1000), (2, 20, 200, 2000), (3, 30, 300, 3000);
FLUSH STATUS;
# -------------------------------------------------------
# 1. PK point select — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_pk FROM 'SELECT * FROM t1 WHERE id = ?';
SET @p = 1;
EXECUTE stmt_pk USING @p;
id	val	uk	name
1	alpha	100	Alice
admissions delta after PK first execute: 1
# Second execute should NOT re-admit
SET @p = 2;
EXECUTE stmt_pk USING @p;
id	val	uk	name
2	beta	200	Bob
admissions delta after PK second execute: 0
# Third execute — verify results are still correct
SET @p = 3;
EXECUTE stmt_pk USING @p;
id	val	uk	name
3	gamma	300	Charlie
DEALLOCATE PREPARE stmt_pk;
# -------------------------------------------------------
# 2. UK point select — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_uk FROM 'SELECT * FROM t1 WHERE uk = ?';
SET @p = 200;
EXECUTE stmt_uk USING @p;
id	val	uk	name
2	beta	200	Bob
admissions delta after UK first execute: 1
DEALLOCATE PREPARE stmt_uk;
# -------------------------------------------------------
# 3. Composite PK — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_cpk FROM 'SELECT * FROM t_comp WHERE pk1 = ? AND pk2 = ?';
SET @p1 = 1;
SET @p2 = 10;
EXECUTE stmt_cpk USING @p1, @p2;
pk1	pk2	val
1	10	100
admissions delta after composite PK first execute: 1
DEALLOCATE PREPARE stmt_cpk;
# -------------------------------------------------------
# 4. Composite UK — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_cuk FROM 'SELECT * FROM t_comp_uk WHERE uk1 = ? AND uk2 = ?';
SET @p1 = 20;
SET @p2 = 200;
EXECUTE stmt_cuk USING @p1, @p2;
id	uk1	uk2	val
2	20	200	2000
admissions delta after composite UK first execute: 1
DEALLOCATE PREPARE stmt_cuk;
# -------------------------------------------------------
# 5. Composite PK reversed WHERE order — admission SUCCESS
#    Tests parameter reordering in ps_point_plan_admit().
# -------------------------------------------------------
PREPARE stmt_cpk_rev FROM 'SELECT * FROM t_comp WHERE pk2 = ? AND pk1 = ?';
SET @p1 = 10;
SET @p2 = 1;
EXECUTE stmt_cpk_rev USING @p1, @p2;
pk1	pk2	val
1	10	100
admissions delta after reversed PK first execute: 1
DEALLOCATE PREPARE stmt_cpk_rev;
# -------------------------------------------------------
# 6. Composite UK reversed WHERE order — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_cuk_rev FROM 'SELECT * FROM t_comp_uk WHERE uk2 = ? AND uk1 = ?';
SET @p1 = 200;
SET @p2 = 20;
EXECUTE stmt_cuk_rev USING @p1, @p2;
id	uk1	uk2	val
2	20	200	2000
admissions delta after reversed UK first execute: 1
DEALLOCATE PREPARE stmt_cuk_rev;
# -------------------------------------------------------
# 7. Table alias — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_alias FROM 'SELECT * FROM t1 AS a WHERE a.id = ?';
SET @p = 1;
EXECUTE stmt_alias USING @p;
id	val	uk	name
1	alpha	100	Alice
admissions delta after alias first execute: 1
DEALLOCATE PREPARE stmt_alias;
# -------------------------------------------------------
# 8. Non-SELECT * (partial column list) — admission SUCCESS
# -------------------------------------------------------
PREPARE stmt_partial FROM 'SELECT id, val FROM t1 WHERE uk = ?';
SET @p = 100;
EXECUTE stmt_partial USING @p;
id	val
1	alpha
admissions delta after partial columns first execute: 1
DEALLOCATE PREPARE stmt_partial;
# -------------------------------------------------------
# 9. Non-unique index — admission FAILURE (not JT_CONST)
# -------------------------------------------------------
PREPARE stmt_nonuk FROM 'SELECT * FROM t1 WHERE name = ?';
SET @p = 'Alice';
EXECUTE stmt_nonuk USING @p;
id	val	uk	name
1	alpha	100	Alice
admissions delta after non-unique index execute: 0
DEALLOCATE PREPARE stmt_nonuk;
# -------------------------------------------------------
# 10. No index column — admission FAILURE (full table scan)
# -------------------------------------------------------
PREPARE stmt_noindex FROM 'SELECT * FROM t1 WHERE val = ?';
SET @p = 'alpha';
EXECUTE stmt_noindex USING @p;
id	val	uk	name
1	alpha	100	Alice
admissions delta after no-index execute: 0
DEALLOCATE PREPARE stmt_noindex;
# -------------------------------------------------------
# 11. Partial composite key — admission FAILURE
#     (key_parts != param_count)
# -------------------------------------------------------
PREPARE stmt_partial_cpk FROM 'SELECT * FROM t_comp WHERE pk1 = ?';
SET @p = 1;
EXECUTE stmt_partial_cpk USING @p;
pk1	pk2	val
1	10	100
admissions delta after partial composite key execute: 0
DEALLOCATE PREPARE stmt_partial_cpk;
# -------------------------------------------------------
# 12. PK + extra non-indexed column — admission FAILURE
#     (residual condition or key_parts != param_count)
# -------------------------------------------------------
PREPARE stmt_pk_extra FROM 'SELECT * FROM t1 WHERE id = ? AND val = ?';
SET @p1 = 1;
SET @p2 = 'alpha';
EXECUTE stmt_pk_extra USING @p1, @p2;
id	val	uk	name
1	alpha	100	Alice
admissions delta after PK+extra execute: 0
DEALLOCATE PREPARE stmt_pk_extra;
# -------------------------------------------------------
# 13. Final counter summary
# -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admissions	8
Ps_point_plan_cache_cold_classifications	12
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	2
Ps_point_plan_cache_invalidations	0
# -------------------------------------------------------
# Cleanup
# -------------------------------------------------------
DROP TABLE t_comp_uk;
DROP TABLE t_comp;
DROP TABLE t1;
#
# End of Phase 2 admission tests
#

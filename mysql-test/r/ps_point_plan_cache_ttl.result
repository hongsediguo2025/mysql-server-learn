#
# Phase TTL test: ps_point_plan_cache idle timeout eviction
# Verifies TTL-based eviction of cached plans when idle.
#
# Run: mtr --ps-protocol ps_point_plan_cache_ttl
#
# -------------------------------------------------------
# Setup
# -------------------------------------------------------
CREATE TABLE t_ttl (
id INT PRIMARY KEY,
val VARCHAR(50)
);
INSERT INTO t_ttl VALUES
(1, 'alpha'), (2, 'beta'), (3, 'gamma'), (4, 'delta'), (5, 'epsilon'),
(6, 'zeta'), (7, 'eta'), (8, 'theta'), (9, 'iota'),
(10, 'kappa'), (20, 'lambda'), (30, 'mu');
FLUSH STATUS;
# =======================================================
# Test 1: Idle timeout eviction
# =======================================================
# 1.1. Set short idle timeout (3 seconds)
SET @orig_idle = @@global.ps_point_plan_cache_eviction_idle_seconds;
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = 3;
SELECT @@global.ps_point_plan_cache_eviction_idle_seconds AS 'Idle timeout set to 3 seconds';
Idle timeout set to 3 seconds
3
# 1.2. Prepare and admit a PS
PREPARE stmt_ttl1 FROM 'SELECT * FROM t_ttl WHERE id = ?';
SET @p = 1;
EXECUTE stmt_ttl1 USING @p;
id	val
1	alpha
# 1.3. HOT hit to confirm cache is working
SET @p = 2;
EXECUTE stmt_ttl1 USING @p;
id	val
2	beta
# 1.4. Wait for idle timeout (4 seconds, > 3 second threshold)
SELECT SLEEP(4) AS 'Waited 4 seconds for idle timeout';
Waited 4 seconds for idle timeout
0
# 1.5. Execute after idle - should trigger re-admission (eviction occurred)
SET @p = 3;
EXECUTE stmt_ttl1 USING @p;
id	val
3	gamma
DEALLOCATE PREPARE stmt_ttl1;
# =======================================================
# Test 2: last_hit_time update on each HOT hit
# =======================================================
FLUSH STATUS;
# 2.1. Prepare and admit a PS
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = 2;
PREPARE stmt_hit_time FROM 'SELECT * FROM t_ttl WHERE id = ?';
SET @p = 10;
EXECUTE stmt_hit_time USING @p;
id	val
10	kappa
# 2.2. Execute at 1 second intervals - should keep cache alive
Each HOT hit updates last_hit_time, preventing eviction
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 20;
EXECUTE stmt_hit_time USING @p;
id	val
20	lambda
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 30;
EXECUTE stmt_hit_time USING @p;
id	val
30	mu
# 2.3. Verify no eviction occurred during the keep-alive period
SHOW STATUS LIKE 'Ps_point_plan_cache_admissions';
Variable_name	Value
Ps_point_plan_cache_admissions	1
DEALLOCATE PREPARE stmt_hit_time;
# =======================================================
# Test 3: Disable TTL with eviction_idle_seconds=0
# =======================================================
FLUSH STATUS;
# 3.1. Disable TTL
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = 0;
SELECT @@global.ps_point_plan_cache_eviction_idle_seconds AS 'TTL disabled (0)';
TTL disabled (0)
0
# 3.2. Prepare and admit a PS
PREPARE stmt_no_ttl FROM 'SELECT * FROM t_ttl WHERE id = ?';
SET @p = 1;
EXECUTE stmt_no_ttl USING @p;
id	val
1	alpha
# 3.3. Wait extended time (5 seconds)
SELECT SLEEP(5) AS 'Waited 5 seconds with TTL disabled';
Waited 5 seconds with TTL disabled
0
# 3.4. Execute - should still be HOT (no eviction possible)
SET @p = 2;
EXECUTE stmt_no_ttl USING @p;
id	val
2	beta
DEALLOCATE PREPARE stmt_no_ttl;
# =======================================================
# Test 4: Frequent hit keeps alive, then eventual eviction
# =======================================================
FLUSH STATUS;
# 4.1. Re-enable TTL with short timeout
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = 2;
# 4.2. Prepare and admit
PREPARE stmt_keep_alive FROM 'SELECT * FROM t_ttl WHERE id = ?';
SET @p = 1;
EXECUTE stmt_keep_alive USING @p;
id	val
1	alpha
# 4.3. Keep alive with frequent hits (every 1.5 seconds < 2s timeout)
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 2;
EXECUTE stmt_keep_alive USING @p;
id	val
2	beta
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 3;
EXECUTE stmt_keep_alive USING @p;
id	val
3	gamma
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 10;
EXECUTE stmt_keep_alive USING @p;
id	val
10	kappa
# 4.4. Stop hitting, wait for timeout (3 seconds > 2s threshold)
SELECT SLEEP(3) AS 'Waited 3 seconds without hits';
Waited 3 seconds without hits
0
# 4.5. Now execute - should trigger eviction and re-admission
SET @p = 20;
EXECUTE stmt_keep_alive USING @p;
id	val
20	lambda
DEALLOCATE PREPARE stmt_keep_alive;
# =======================================================
# Test 5: Multiple PS - eviction is per-entry
# =======================================================
FLUSH STATUS;
# 5.1. Set short timeout
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = 2;
# 5.2. Prepare and admit two PS
PREPARE stmt_multi1 FROM 'SELECT * FROM t_ttl WHERE id = ?';
PREPARE stmt_multi2 FROM 'SELECT * FROM t_ttl WHERE id = ?';
Admit both
SET @p = 1;
EXECUTE stmt_multi1 USING @p;
id	val
1	alpha
SET @p = 2;
EXECUTE stmt_multi2 USING @p;
id	val
2	beta
# 5.3. Keep hitting stmt_multi1, let stmt_multi2 go idle
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 3;
EXECUTE stmt_multi1 USING @p;
id	val
3	gamma
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 4;
EXECUTE stmt_multi1 USING @p;
id	val
4	delta
SELECT SLEEP(1);
SLEEP(1)
0
SET @p = 5;
EXECUTE stmt_multi1 USING @p;
id	val
5	epsilon
# 5.4. Wait for timeout (stmt_multi2 should be evicted)
SELECT SLEEP(3);
SLEEP(3)
0
# 5.5. Execute both - only stmt_multi2 should need re-admission
SET @p = 10;
EXECUTE stmt_multi1 USING @p;
id	val
10	kappa
SET @p = 20;
EXECUTE stmt_multi2 USING @p;
id	val
20	lambda
DEALLOCATE PREPARE stmt_multi1;
DEALLOCATE PREPARE stmt_multi2;
# -------------------------------------------------------
# Final counter summary
# -------------------------------------------------------
SHOW STATUS LIKE 'Ps_point_plan_cache%';
Variable_name	Value
Ps_point_plan_cache_admission_refused	0
Ps_point_plan_cache_admissions	2
Ps_point_plan_cache_cold_classifications	2
Ps_point_plan_cache_evictions	0
Ps_point_plan_cache_fallback_runtime	0
Ps_point_plan_cache_hits	5
Ps_point_plan_cache_invalidations	0
# -------------------------------------------------------
# Restore original setting and cleanup
# -------------------------------------------------------
SET GLOBAL ps_point_plan_cache_eviction_idle_seconds = @orig_idle;
DROP TABLE t_ttl;
#
# End of TTL test
#
